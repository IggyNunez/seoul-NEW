        { "value": "wifi", "label": "WiFi" },
        { "value": "bluetooth", "label": "Bluetooth" },
        { "value": "zap", "label": "Lightning / Power" },
        { "value": "clock", "label": "Clock / Timer" },
        { "value": "sun", "label": "Sun / Light" },
        { "value": "moon", "label": "Moon" },
        { "value": "shield", "label": "Shield / Warranty" },
        { "value": "truck", "label": "Truck / Shipping" },
        { "value": "refresh", "label": "Refresh / Returns" },
        { "value": "star", "label": "Star" },
        { "value": "heart", "label": "Heart" },
        { "value": "eye", "label": "Eye / View" },
        { "value": "mic", "label": "Microphone / Voice" },
        { "value": "remote", "label": "Remote" },
        { "value": "globe", "label": "Globe" },
        { "value": "gift", "label": "Gift" },
        { "value": "none", "label": "No icon" }
      ],
      "default": "check"
    },
    {
      "type": "image_picker",
      "id": "custom_icon_2",
      "label": "Custom icon 2",
      "info": "Upload SVG/PNG. Overrides icon select."
    },
    {
      "type": "text",
      "id": "feature_3",
      "label": "Feature 3",
      "default": "Music Sync"
    },
    {
      "type": "select",
      "id": "icon_3",
      "label": "Icon 3",
      "options": [
        { "value": "check", "label": "Checkmark (default)" },
        { "value": "palette", "label": "Palette / Colors" },
        { "value": "smartphone", "label": "Smartphone / App" },
