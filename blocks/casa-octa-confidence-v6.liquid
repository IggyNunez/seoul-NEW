{% doc %}
  Renders OctaMirror V6 guarantees, quick answers, and review excerpts below the buy buttons.
{% enddoc %}

{% liquid
  assign shipping_url = shop.shipping_policy.url
  assign returns_url = shop.refund_policy.url
  assign guarantee_url = pages['faq'].url
  assign contact_url = pages['contact-us'].url | default: pages['contact'].url

  if shipping_url == blank
    assign shipping_url = '/policies/shipping-policy'
  endif

  if returns_url == blank
    assign returns_url = '/policies/refund-policy'
  endif

  if guarantee_url == blank
    assign guarantee_url = '/pages/faq'
  endif

  if contact_url == blank
    assign contact_url = '/pages/contact-us'
  endif
%}

<section class="casa-v6-confidence" aria-label="{{ block.settings.section_label | escape }}" {{ block.shopify_attributes }}>
  <div class="casa-v6-confidence__cards">
    <a href="{{ shipping_url }}" class="casa-v6-confidence__card">
      <span class="casa-v6-confidence__icon" aria-hidden="true">
        <svg viewBox="0 0 32 32"><path d="M3.5 8.5h16v14h-16zM19.5 13h5l4 4.5v5h-9z"/><circle cx="9" cy="24" r="2.5"/><circle cx="24.5" cy="24" r="2.5"/><path d="M8 5h8M5 12H1.5"/></svg>
      </span>
      <span><strong>{{ block.settings.shipping_value }}</strong><b>{{ block.settings.shipping_title }}</b><small>{{ block.settings.shipping_body }}</small></span>
    </a>
    <a href="{{ guarantee_url }}#warranty" class="casa-v6-confidence__card">
      <span class="casa-v6-confidence__icon" aria-hidden="true">
        <svg viewBox="0 0 32 32"><path d="M16 3.5 26 7v7.5c0 6.4-4.1 11.6-10 14-5.9-2.4-10-7.6-10-14V7l10-3.5Z"/><path d="m11.3 15.7 3.1 3 6.4-6.5"/></svg>
      </span>
      <span><strong>{{ block.settings.guarantee_value }}</strong><b>{{ block.settings.guarantee_title }}</b><small>{{ block.settings.guarantee_body }}</small></span>
    </a>
    <a href="{{ returns_url }}" class="casa-v6-confidence__card">
      <span class="casa-v6-confidence__icon" aria-hidden="true">
        <svg viewBox="0 0 32 32"><path d="M7 10.5A11 11 0 1 1 5.2 21"/><path d="M3 9h7v7"/><path d="M16 9.5v7l4.5 2.5"/></svg>
      </span>
      <span><strong>{{ block.settings.returns_value }}</strong><b>{{ block.settings.returns_title }}</b><small>{{ block.settings.returns_body }}</small></span>
    </a>
  </div>

  <div class="casa-v6-confidence__reviews" aria-label="{{ block.settings.reviews_label | escape }}">
    <article class="casa-v6-confidence__review">
      {% if block.settings.review_1_image != blank %}
        <a class="casa-v6-confidence__review-thumb" href="{{ block.settings.review_1_image | image_url: width: 1400 }}" target="_blank" rel="noopener" aria-label="Open Markus Mandele’s customer photo">
          {{ block.settings.review_1_image | image_url: width: 180 | image_tag: widths: '90, 120, 180', sizes: '72px', loading: 'lazy', class: 'casa-v6-confidence__review-image', alt: block.settings.review_1_image_alt }}
        </a>
      {% else %}
        <a class="casa-v6-confidence__review-thumb" href="{{ 'octamirror-review-markus-retouched.jpg' | asset_url }}" target="_blank" rel="noopener" aria-label="Open Markus Mandele’s customer photo">
          <img class="casa-v6-confidence__review-image" src="{{ 'octamirror-review-markus-retouched.jpg' | asset_url }}" width="180" height="180" loading="lazy" alt="{{ block.settings.review_1_image_alt | escape }}">
        </a>
      {% endif %}
      <blockquote>
        <div class="casa-v6-confidence__stars" aria-label="5 out of 5 stars">★★★★★</div>
        <p>“{{ block.settings.review_1_quote }}”</p>
        <cite><span aria-hidden="true">✓</span> {{ block.settings.review_1_author }}</cite>
      </blockquote>
    </article>

    <article class="casa-v6-confidence__review">
      {% if block.settings.review_2_image != blank %}
        <a class="casa-v6-confidence__review-thumb" href="{{ block.settings.review_2_image | image_url: width: 1400 }}" target="_blank" rel="noopener" aria-label="Open Paulina Jackson’s customer photo">
          {{ block.settings.review_2_image | image_url: width: 180 | image_tag: widths: '90, 120, 180', sizes: '72px', loading: 'lazy', class: 'casa-v6-confidence__review-image', alt: block.settings.review_2_image_alt }}
        </a>
      {% else %}
        <a class="casa-v6-confidence__review-thumb" href="{{ 'octamirror-review-paulina-retouched.jpg' | asset_url }}" target="_blank" rel="noopener" aria-label="Open Paulina Jackson’s customer photo">
          <img class="casa-v6-confidence__review-image" src="{{ 'octamirror-review-paulina-retouched.jpg' | asset_url }}" width="180" height="180" loading="lazy" alt="{{ block.settings.review_2_image_alt | escape }}">
        </a>
      {% endif %}
      <blockquote>
        <div class="casa-v6-confidence__stars" aria-label="5 out of 5 stars">★★★★★</div>
        <p>“{{ block.settings.review_2_quote }}”</p>
        <cite><span aria-hidden="true">✓</span> {{ block.settings.review_2_author }}</cite>
      </blockquote>
    </article>
  </div>

  <casa-confidence-accordion-v6 class="casa-v6-confidence__faq" data-build="20260922-line-icons-1">

    <details name="casa-confidence-{{ block.id }}">
      <summary>
        {% render 'casa-octa-faq-icon', name: 'mirror' %}
        <span class="casa-v6-confidence__faq-title"><strong>{{ block.settings.faq_2_question }}</strong><small>Reflective when off. An infinity effect when lit.</small></span>
        <span class="casa-v6-confidence__plus" aria-hidden="true"></span>
      </summary>
      <div class="casa-v6-confidence__answer">
        {{ 'casa_octa.answers.mirror_html' | t }}
        <div class="casa-v6-confidence__visual-tool casa-v6-confidence__mirror-tool" aria-label="Compare the OctaMirror with its lights off and on">
          <div class="casa-v6-confidence__visual-head"><strong>One mirror. Two states.</strong></div>
          <div class="casa-v6-confidence__mirror-states">
            <div class="casa-v6-confidence__mirror-state casa-v6-confidence__mirror-state--off">
              <span class="casa-v6-confidence__mirror-graphic" aria-hidden="true">
                <svg viewBox="0 0 100 100" focusable="false">
                  <defs><linearGradient id="casa-mirror-off-{{ block.id }}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f4f5f7"/><stop offset=".46" stop-color="#bfc3ca"/><stop offset=".52" stop-color="#ffffff"/><stop offset="1" stop-color="#9297a0"/></linearGradient></defs>
                  <polygon points="29.3,2 70.7,2 98,29.3 98,70.7 70.7,98 29.3,98 2,70.7 2,29.3" fill="url(#casa-mirror-off-{{ block.id }})"/>
                  <path d="M23 65 65 23M36 78 78 36"/>
                </svg>
              </span>
              <span><b>Lights off</b><small>Usable reflective wall mirror</small></span>
            </div>
            <div class="casa-v6-confidence__mirror-state casa-v6-confidence__mirror-state--on">
              <span class="casa-v6-confidence__mirror-graphic" aria-hidden="true">
                <svg viewBox="0 0 100 100" focusable="false">
                  <polygon class="casa-v6-confidence__mirror-dark" points="29.3,2 70.7,2 98,29.3 98,70.7 70.7,98 29.3,98 2,70.7 2,29.3"/>
                  <polygon points="32,9 68,9 91,32 91,68 68,91 32,91 9,68 9,32"/>
                  <polygon points="36,19 64,19 81,36 81,64 64,81 36,81 19,64 19,36"/>
                  <polygon points="41,30 59,30 70,41 70,59 59,70 41,70 30,59 30,41"/>
                </svg>
              </span>
              <span><b>Lights on</b><small>Repeated illuminated depth</small></span>
            </div>
          </div>
          <div class="casa-v6-confidence__formula" aria-label="How the infinity effect works">
            <span>Two reflective surfaces</span><b aria-hidden="true">+</b><span>One LED perimeter</span><b aria-hidden="true">=</b><strong>Infinity tunnel</strong>
          </div>
        </div>
      </div>
    </details>
    <details name="casa-confidence-{{ block.id }}">
      <summary>
        {% render 'casa-octa-faq-icon', name: 'setup' %}
        <span class="casa-v6-confidence__faq-title"><strong>{{ block.settings.faq_3_question }}</strong><small>Wall-mounted, plug-in, with a remote included.</small></span>
        <span class="casa-v6-confidence__plus" aria-hidden="true"></span>
      </summary>
      <div class="casa-v6-confidence__answer">
        <p>Mount the bracket, hang your mirror and connect power. The included remote works without a phone or Wi-Fi.</p>
        <div class="casa-v6-confidence__visual-tool casa-v6-confidence__setup-tool" aria-label="OctaMirror setup and control overview">
          <div class="casa-v6-confidence__visual-head">
            <strong>Three steps to set up</strong>
            <span>Two people recommended</span>
          </div>
          <ol class="casa-v6-confidence__setup-steps">
            <li>
              <span aria-hidden="true"><svg viewBox="0 0 28 28"><path d="M5 22h18M8 22V11h12v11M11 11l3-6 3 6"/><path d="M14 5v12"/></svg></span>
              <b>Mount</b><small>Secure the bracket with wall-appropriate fixings</small>
            </li>
            <li>
              <span aria-hidden="true"><svg viewBox="0 0 28 28"><path d="M14 4v15M9 14l5 5 5-5"/><path d="M7 23h14M10 23l4-4 4 4"/></svg></span>
              <b>Hang</b><small>Lower the rear hook onto the bracket</small>
            </li>
            <li>
              <span aria-hidden="true"><svg viewBox="0 0 28 28"><path d="M10 4v7M18 4v7M8 11h12v3a6 6 0 0 1-6 6v4"/><path d="M11 24h6"/></svg></span>
              <b>Plug in</b><small>Universal 100–240V power, then switch on</small>
            </li>
          </ol>
          <div class="casa-v6-confidence__setup-choice" aria-label="OctaMirror control options">
            <span><b>Remote included</b><small>Works without Wi-Fi</small></span>
            <span><b>App + voice optional</b><small>Tuya · Alexa · Google · Siri</small></span>
          </div>
        </div>
        {{ 'casa_octa.answers.setup_html' | t }}
      </div>
    </details>
    <details name="casa-confidence-{{ block.id }}">
      <summary>
        {% render 'casa-octa-faq-icon', name: 'support' %}
        <span class="casa-v6-confidence__faq-title"><strong>{{ block.settings.faq_4_question }}</strong><small>Two-year coverage, with a real team to help.</small></span>
        <span class="casa-v6-confidence__plus" aria-hidden="true"></span>
      </summary>
      <div class="casa-v6-confidence__answer">
        {{ 'casa_octa.answers.support_html' | t }}
        <div class="casa-v6-confidence__help-grid">
          <div><b>Before you order</b><p>Ask about size, your wall or installation.</p></div>
          <div><b>Once it arrives</b><p>Get help with the remote, app pairing or troubleshooting.</p></div>
        </div>
        <div class="casa-v6-confidence__answer-actions">
          <a class="casa-v6-confidence__answer-link" href="{{ guarantee_url }}#warranty">Read the Casa Guarantee</a>
          <a class="casa-v6-confidence__contact-cta" href="{{ contact_url }}">Ask the Casa team <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </details>
    <details name="casa-confidence-{{ block.id }}">
      <summary>
        {% render 'casa-octa-faq-icon', name: 'ownership' %}
        <span class="casa-v6-confidence__faq-title"><strong>{{ block.settings.faq_5_question }}</strong><small>Protected in a fitted wooden crate.</small></span>
        <span class="casa-v6-confidence__plus" aria-hidden="true"></span>
      </summary>
      <div class="casa-v6-confidence__answer">
        {{ 'casa_octa.answers.delivery_html' | t }}
        <div class="casa-v6-confidence__crate-pair" aria-label="OctaMirror packaging">
          <figure><img src="{{ 'octa-crate-closed-detail-v7-preview.jpg' | asset_url }}" width="768" height="576" loading="lazy" decoding="async" alt="AI-edited view of the actual OctaMirror wooden shipping crate"><figcaption>Wooden outer crate</figcaption></figure>
          <figure><img src="{{ 'octa-crate-open-repaired-v7-preview.jpg' | asset_url }}" width="768" height="576" loading="lazy" decoding="async" alt="AI-edited view of the OctaMirror protected inside its wooden crate"><figcaption>Fitted protection inside</figcaption></figure>
        </div>
        <p class="casa-v6-confidence__image-note">AI-edited views based on our actual unboxing footage.</p>
        <p>For an undamaged return, you cover the return shipping. Contact us first for approval and instructions.</p>
        <a class="casa-v6-confidence__answer-link" href="#casa-v7-assurance">A closer look at the packaging <span aria-hidden="true">→</span></a>
        <div class="casa-v6-confidence__answer-actions">
          <a class="casa-v6-confidence__answer-link" href="{{ shipping_url }}">Shipping policy</a>
          <a class="casa-v6-confidence__answer-link" href="{{ returns_url }}">Returns policy</a>
        </div>
      </div>
    </details>
  </casa-confidence-accordion-v6>
</section>

{% stylesheet %}
  .casa-v6-confidence {
    display: grid;
    gap: 16px;
    width: 100%;
  }

  .casa-v6-confidence__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid #e5e3de;
    border-radius: 14px;
    background: #fafaf7;
  }

  .casa-v6-confidence__card {
    display: grid;
    gap: 8px;
    min-width: 0;
    padding: 14px 10px;
    color: #0a0a0f;
    text-align: center;
    text-decoration: none;
  }

  .casa-v6-confidence__card + .casa-v6-confidence__card {
    border-left: 1px solid #e5e3de;
  }

  .casa-v6-confidence__card:hover {
    background: #fff;
  }

  .casa-v6-confidence__card:focus-visible {
    position: relative;
    z-index: 2;
    outline: 2px solid #B0C3FA;
    outline-offset: -3px;
  }

  .casa-v6-confidence__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    margin-inline: auto;
    border-radius: 12px;
    color: #B0C3FA;
    background: linear-gradient(145deg, #f4e8ff, #fff 62%, #e7fbfe);
  }

  .casa-v6-confidence__icon svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .casa-v6-confidence__card > span:last-child {
    display: grid;
    gap: 3px;
  }

  .casa-v6-confidence__card strong {
    color: #B0C3FA;
    font: 760 14px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.035em;
  }

  .casa-v6-confidence__card b {
    font-size: 11.5px;
    line-height: 1.2;
  }

  .casa-v6-confidence__card small {
    color: #6b6b76;
    font-size: 9.5px;
    line-height: 1.25;
  }

  .casa-v6-confidence__reviews {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .casa-v6-confidence__review {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    min-width: 0;
    padding: 13px;
    border: 1px solid #e5e3de;
    border-radius: 14px;
    background: linear-gradient(145deg, #fff 0%, #fbf8fc 65%, #f5fbfc 100%);
    box-shadow: 0 8px 22px rgba(30, 24, 18, 0.055);
  }

  .casa-v6-confidence__review-thumb {
    position: relative;
    display: block;
    width: 72px;
    height: 72px;
    overflow: hidden;
    border: 2px solid #ddd6e5;
    border-radius: 12px;
    background: #eee8f3;
    box-shadow: 0 5px 14px rgba(53, 34, 65, 0.14);
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .casa-v6-confidence__review-thumb:hover,
  .casa-v6-confidence__review-thumb:focus-visible {
    z-index: 1;
    border-color: #b04ee9;
    box-shadow: 0 7px 18px rgba(176, 195, 250, 0.22);
    transform: translateY(-2px) scale(1.03);
  }

  .casa-v6-confidence__review-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .casa-v6-confidence__reviews blockquote {
    min-width: 0;
    margin: 0;
    padding: 0;
  }

  .casa-v6-confidence__stars {
    color: #5E0A02;
    font-size: 10px;
    letter-spacing: 0.1em;
  }

  .casa-v6-confidence__reviews p {
    margin: 6px 0 10px;
    color: #18151d;
    font-family: var(--font-heading--family, ui-serif, Georgia, serif);
    font-size: clamp(12px, 1.05vw, 14px);
    font-weight: 520;
    line-height: 1.36;
    letter-spacing: -0.01em;
  }

  .casa-v6-confidence__reviews cite {
    display: flex;
    gap: 7px;
    align-items: center;
    color: #67616b;
    font: normal 690 7.5px/1.35 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .casa-v6-confidence__reviews cite span {
    display: grid;
    place-items: center;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(135deg, #B0C3FA, #5E0A02, #F2FFA0);
  }

  .casa-v6-confidence__faq {
    display: block;
    border-top: 1px solid #e5e3de;
  }

  .casa-v6-confidence__faq details {
    position: relative;
    border-bottom: 1px solid #e5e3de;
    transition: background 180ms ease, border-color 180ms ease;
  }


  .casa-v6-confidence__faq details[open] {
    border-color: #ddd2ea;
    background: #faf8fc;
  }


  .casa-v6-confidence__faq summary {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) 24px;
    gap: 11px;
    align-items: center;
    min-height: 88px;
    padding: 22px 12px;
    color: #0a0a0f;
    list-style: none;
    cursor: pointer;
  }

  .casa-v6-confidence__faq summary > .casa-octa-faq-icon {
    display: block;
    width: 24px;
    height: 24px;
    color: #514a5b;
  }

  .casa-v6-confidence__faq details[open] summary > .casa-octa-faq-icon {
    color: #7435a1;
  }

  .casa-v6-confidence__faq summary::-webkit-details-marker {
    display: none;
  }

  .casa-v6-confidence__faq summary:focus-visible {
    outline: 2px solid #B0C3FA;
    outline-offset: -2px;
  }

  .casa-v6-confidence__faq-title {
    display: grid;
    gap: 5px;
    min-width: 0;
  }

  .casa-v6-confidence__faq-title strong {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.25;
  }

  .casa-v6-confidence__faq-title small {
    display: block; color: #625b6c; font: 400 14px/1.5 var(--font-body--family, sans-serif);
  }

  .casa-v6-confidence__faq-title small b {
    color: inherit;
    font: inherit;
  }

  .casa-v6-confidence__faq-title small span {
    color: #6b6b76;
    font-size: 0.82em;
    font-weight: 550;
    letter-spacing: 0.03em;
  }

  .casa-v6-confidence__visual-tool {
    container-type: inline-size; margin: 18px 0; padding: 18px; border: 1px solid #e7e1ec;
    border-radius: 12px; background: #fff; color: #24212a;
  }

  .casa-v6-confidence__visual-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
    margin-bottom: 11px;
  }

  .casa-v6-confidence__visual-head strong, .casa-v6-confidence__visual-head span {
    font: 500 14px/1.5 var(--font-body--family, sans-serif); letter-spacing: normal; text-transform: none;
  }

  .casa-v6-confidence__visual-head strong {
    color: #29252f;
  }

  .casa-v6-confidence__visual-head span {
    color: #7e22ce;
    text-align: right;
  }

  .casa-v6-confidence__mirror-states {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .casa-v6-confidence__mirror-state {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 11px;
    align-items: center;
    min-width: 0;
    min-height: 96px;
    padding: 10px;
    border: 1px solid #e2dee5;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.76);
  }

  .casa-v6-confidence__mirror-state--on {
    border-color: rgba(176, 195, 250, 0.28);
    background: linear-gradient(135deg, rgba(176, 195, 250, 0.09), rgba(94, 10, 2, 0.04) 56%, rgba(242, 255, 160, 0.07));
  }

  .casa-v6-confidence__mirror-graphic {
    display: block;
    width: 72px;
    aspect-ratio: 1;
    filter: drop-shadow(0 7px 9px rgba(30, 22, 35, 0.16));
  }

  .casa-v6-confidence__mirror-graphic svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .casa-v6-confidence__mirror-state--off path {
    fill: none;
    stroke: rgba(255, 255, 255, 0.78);
    stroke-width: 4;
  }

  .casa-v6-confidence__mirror-state--on polygon {
    fill: none;
    stroke: #B0C3FA;
    stroke-width: 2;
  }

  .casa-v6-confidence__mirror-state--on polygon:nth-child(3) {
    stroke: #5E0A02;
  }

  .casa-v6-confidence__mirror-state--on polygon:nth-child(4) {
    stroke: #F2FFA0;
  }

  .casa-v6-confidence__mirror-state--on .casa-v6-confidence__mirror-dark {
    fill: #141219;
    stroke-width: 3;
  }

  .casa-v6-confidence__mirror-state > span:last-child {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .casa-v6-confidence__mirror-state b,
  .casa-v6-confidence__setup-steps b,
  .casa-v6-confidence__support-path b,
  .casa-v6-confidence__delivery-journey b,
  .casa-v6-confidence__setup-choice b {
    color: #17141b;
    font-size: 15px;
    line-height: 1.3;
  }

  .casa-v6-confidence__mirror-state small,
  .casa-v6-confidence__setup-steps small,
  .casa-v6-confidence__support-path small,
  .casa-v6-confidence__delivery-journey small,
  .casa-v6-confidence__setup-choice small {
    display: block;
    color: #56505d;
    font-size: 14px;
    line-height: 1.45;
  }

  .casa-v6-confidence__formula {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 7px;
    align-items: center;
    margin-top: 8px;
    color: #706a75;
    text-align: center;
  }

  .casa-v6-confidence__formula span,
  .casa-v6-confidence__formula strong {
    padding: 7px 6px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.82);
    font: 680 11px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .casa-v6-confidence__formula strong {
    color: #7e22ce;
    background: rgba(176, 195, 250, 0.09);
  }

  .casa-v6-confidence__formula > b {
    color: #b33ee7;
    font-size: 14px;
  }

  .casa-v6-confidence__setup-steps,
  .casa-v6-confidence__support-path,
  .casa-v6-confidence__delivery-journey {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .casa-v6-confidence__setup-steps li,
  .casa-v6-confidence__delivery-journey li {
    position: relative;
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    gap: 2px 9px;
    align-content: center;
    min-width: 0;
    min-height: 78px;
    padding: 9px;
    border: 1px solid #e2dee5;
    border-radius: 11px;
    background: rgba(255, 255, 255, 0.76);
  }

  .casa-v6-confidence__setup-steps li > span,
  .casa-v6-confidence__delivery-journey li > span {
    display: grid;
    grid-row: 1 / span 2;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    color: #B0C3FA;
    background: linear-gradient(145deg, #f0e1ff, #fff 62%, #ddf8fb);
  }

  .casa-v6-confidence__setup-steps svg,
  .casa-v6-confidence__delivery-journey svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .casa-v6-confidence__setup-choice {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 8px;
    overflow: hidden;
    border: 1px solid #e2dee5;
    border-radius: 11px;
    background: #e2dee5;
  }

  .casa-v6-confidence__setup-choice > span {
    display: grid;
    gap: 3px;
    min-width: 0;
    padding: 9px 10px;
    background: rgba(255, 255, 255, 0.92);
  }

  .casa-v6-confidence__support-path li {
    display: grid;
    gap: 4px;
    min-width: 0;
    padding: 11px;
    border: 1px solid rgba(176, 195, 250, 0.15);
    border-radius: 11px;
    background: rgba(255, 255, 255, 0.78);
  }

  .casa-v6-confidence__support-path li > span {
    width: fit-content;
    padding: 3px 6px;
    border-radius: 999px;
    color: #7e22ce;
    background: rgba(176, 195, 250, 0.09);
    font: 760 10px/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.07em;
  }

  .casa-v6-confidence__delivery-journey li:nth-child(2) > span {
    color: #be185d;
    background: linear-gradient(145deg, #fde5f2, #fff 62%, #f0e5ff);
  }

  .casa-v6-confidence__delivery-journey li:nth-child(3) > span {
    color: #07849b;
    background: linear-gradient(145deg, #ddf8fb, #fff 62%, #e7edff);
  }

  .casa-v6-confidence__policy-note {
    margin: 9px 0 0 !important;
    padding: 8px 10px;
    border-radius: 9px;
    color: #5f5964 !important;
    background: rgba(176, 195, 250, 0.055);
    font-size: 14px;
    line-height: 1.45;
  }

  .casa-v6-confidence__faq-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(176, 195, 250, 0.1);
    border-radius: 12px;
    color: #B0C3FA;
    background: linear-gradient(145deg, #f4e8ff, #fff 62%, #e7fbfe);
  }

  .casa-v6-confidence__faq-icon svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .casa-v6-confidence__plus {
    position: relative;
    width: 18px;
    height: 18px;
  }

  .casa-v6-confidence__plus::before,
  .casa-v6-confidence__plus::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 1.5px;
    content: '';
    background: #6b6b76;
    transform: translate(-50%, -50%);
    transition: transform 180ms ease;
  }

  .casa-v6-confidence__plus::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .casa-v6-confidence__faq details[open] .casa-v6-confidence__plus::after {
    transform: translate(-50%, -50%) rotate(0);
  }

  .casa-v6-confidence__answer {
    padding: 0 16px 24px 12px;
    color: #554e5e;
    font-size: 15px;
    line-height: 1.65;
  }

  .casa-v6-confidence__answer p {
    margin: 0 0 10px;
  }

  .casa-v6-confidence__answer > p:first-of-type {
    color: #24242b;
  }

  .casa-v6-confidence__answer > p:first-of-type strong {
    color: #0a0a0f;
    font-weight: 760;
  }

  .casa-v6-confidence__answer ul {
    display: grid;
    gap: 7px;
    margin: 12px 0 14px;
    padding: 0;
    list-style: none;
  }

  .casa-v6-confidence__answer li {
    position: relative;
    padding-left: 21px;
  }

  .casa-v6-confidence__answer li::before {
    position: absolute;
    top: 0.1em;
    left: 0;
    display: grid;
    place-items: center;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    color: #fff;
    content: '✓';
    background: linear-gradient(135deg, #B0C3FA, #5E0A02 58%, #F2FFA0);
    font-size: 9px;
    font-weight: 800;
  }

  .casa-v6-confidence__answer .casa-v6-confidence__setup-steps li,
  .casa-v6-confidence__answer .casa-v6-confidence__delivery-journey li {
    padding-left: 9px;
  }

  .casa-v6-confidence__answer .casa-v6-confidence__support-path li {
    padding-left: 11px;
  }

  .casa-v6-confidence__answer .casa-v6-confidence__setup-steps li::before,
  .casa-v6-confidence__answer .casa-v6-confidence__support-path li::before,
  .casa-v6-confidence__answer .casa-v6-confidence__delivery-journey li::before {
    display: none;
  }

  .casa-v6-confidence__answer strong {
    color: #24242b;
  }

  .casa-v6-confidence__answer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 13px;
  }

  .casa-v6-confidence__answer-link {
    display: inline-flex;
    gap: 5px;
    align-items: center;
    width: fit-content;
    color: #7e22ce;
    font-size: 14px;
    font-weight: 760;
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-color: rgba(176, 195, 250, 0.36);
    text-underline-offset: 4px;
  }

  .casa-v6-confidence__answer-link:hover {
    color: #be185d;
    text-decoration-color: currentColor;
  }

  .casa-v6-confidence__answer-link:focus-visible {
    outline: 2px solid #B0C3FA;
    outline-offset: 3px;
  }

  @media (max-width: 390px) {
    .casa-v6-confidence__card {
      padding-inline: 6px;
    }

    .casa-v6-confidence__card b { font-size: 10px; }
    .casa-v6-confidence__card small { font-size: 8.5px; }

    .casa-v6-confidence__faq summary {
      grid-template-columns: 24px minmax(0, 1fr) 24px;
      gap: 9px;
    }

    .casa-v6-confidence__faq-icon {
      width: 34px;
      height: 34px;
    }

    .casa-v6-confidence__faq-title strong {
      font-size: 16px;
    }
  }

  @media (max-width: 520px) {
    .casa-v6-confidence__answer {
      padding: 2px 4px 20px;
    }

    .casa-v6-confidence__reviews {
      grid-template-columns: 1fr;
    }

    .casa-v6-confidence__reviews p {
      font-size: 13px;
    }

    .casa-v6-confidence__visual-tool {
      padding: 12px;
    }
  }

  /* Reflow useful instructions instead of shrinking them to fit narrow cards. */
  @container (max-width: 520px) {
    .casa-v6-confidence__visual-head {
      align-items: flex-start;
    }

    .casa-v6-confidence__visual-head span {
      max-width: 16ch;
    }

    .casa-v6-confidence__mirror-state {
      grid-template-columns: 1fr;
      gap: 7px;
      text-align: center;
    }

    .casa-v6-confidence__mirror-graphic {
      width: 62px;
      margin-inline: auto;
    }

    .casa-v6-confidence__formula {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: 5px;
    }

    .casa-v6-confidence__formula > b:last-of-type {
      display: none;
    }

    .casa-v6-confidence__formula strong {
      grid-column: 1 / -1;
    }

    .casa-v6-confidence__formula strong::before {
      content: '= ';
    }
    .casa-v6-confidence__setup-steps,
    .casa-v6-confidence__delivery-journey,
    .casa-v6-confidence__support-path {
      grid-template-columns: 1fr;
    }

    .casa-v6-confidence__answer .casa-v6-confidence__support-path li {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 8px;
      align-items: center;
      padding: 9px;
    }

    .casa-v6-confidence__support-path li > span {
      grid-row: 1 / span 2;
    }
  }

  .casa-v6-confidence__faq summary:hover { background: #faf8fc; }
  .casa-v6-confidence__faq details[open] summary strong { color: #7435a1; }
  .casa-v6-confidence__answer-link { min-height: 44px; color: #7435a1; font-weight: 500; }
  .casa-v6-confidence__help-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20px; margin: 20px 0; }
  .casa-v6-confidence__help-grid > div { padding-top: 14px; border-top: 1px solid #ded6e6; }
  .casa-v6-confidence__help-grid b { color: #211c27; font-weight: 600; }
  .casa-v6-confidence__help-grid p { margin-top: 6px; font-size: 14px; }
  .casa-v6-confidence__contact-cta { display: inline-flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 46px; padding: 10px 16px; border-radius: 7px; background: #211c27; color: #fff; font-size: 14px; text-decoration: none; }
  .casa-v6-confidence__contact-cta:focus-visible { outline: 2px solid #7435a1; outline-offset: 3px; }
  .casa-v6-confidence__crate-pair { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; margin-top: 20px; }
  .casa-v6-confidence__crate-pair figure { margin: 0; min-width: 0; }
  .casa-v6-confidence__crate-pair img { display: block; width: 100%; height: auto; aspect-ratio: 4/3; object-fit: cover; border-radius: 8px; }
  .casa-v6-confidence__crate-pair figcaption { margin-top: 7px; font-size: 13px; line-height: 1.5; }
  .casa-v6-confidence__answer .casa-v6-confidence__image-note { color: #625b6c; font-size: 12px; line-height: 1.5; margin: 10px 0 18px; }
  @media (max-width:699px) {
    .casa-v6-confidence__faq summary { padding: 20px 4px; gap: 14px; }
    .casa-v6-confidence__faq-title strong { font-size: 16px; }
    .casa-v6-confidence__answer { padding: 0 8px 22px 4px; font-size: 16px; }
  }
  @media (max-width:359px) { .casa-v6-confidence__help-grid { grid-template-columns: 1fr; gap: 8px; } }
{% endstylesheet %}

{% javascript %}
  class CasaConfidenceAccordionV6 extends HTMLElement {
    connectedCallback() {
      if (this.initialized) return;
      this.initialized = true;
      this.items = Array.from(this.querySelectorAll(':scope > details'));
      this.onToggle = (event) => {
        const openedItem = event.currentTarget;
        if (!openedItem.open) return;
        this.items.forEach((item) => {
          if (item !== openedItem) item.open = false;
        });
      };
      this.items.forEach((item) => item.addEventListener('toggle', this.onToggle));
    }

    disconnectedCallback() {
      this.items?.forEach((item) => item.removeEventListener('toggle', this.onToggle));
    }
  }

  if (!customElements.get('casa-confidence-accordion-v6')) {
    customElements.define('casa-confidence-accordion-v6', CasaConfidenceAccordionV6);
  }

{% endjavascript %}

