

{%- liquid
  assign block_settings = block.settings
  assign product_resource = closest.product
  assign selected_variant = product_resource.selected_or_first_available_variant
-%}

{% liquid
  if block_settings.type_preset == 'rte' or block_settings.type_preset == 'paragraph'
    assign is_rte = true
  endif

  capture text_block_classes
    if block_settings.width == '100%'
      echo 'text-block--align-' | append: block_settings.alignment
      if block_settings.max_width == 'none'
        echo ' text-block--full-width'
      endif
    endif
    if block_settings.type_preset == 'custom'
      echo ' custom-typography'
      if block_settings.font_size != ''
        echo ' custom-font-size'
      endif
      if block_settings.color != ''
        echo ' custom-color'
      endif
    endif
    if block_settings.background
      echo ' text-block--background'
    endif
    if is_rte
      echo ' rte'
    endif
  endcapture
%}

<product-price
  class="text-block {{ text_block_classes }} text-{{ block_settings.alignment }} {{ block_settings.type_preset | default: 'paragraph' }} spacing-style"
  data-block-id="{{ block.id }}"
  data-product-id="{{ product_resource.id }}"
  style="
    {% render 'typography-style', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
    --width: {{ block_settings.width }};
  "
  {{ block.shopify_attributes }}
>
  {% render 'price',
    show_unit_price: true,
    product_resource: product_resource,
    show_sale_price_first: block_settings.show_sale_price_first
  %}

  {% if block_settings.show_tax_info %}
    <div class="tax-note">
      {%- if cart.duties_included and cart.taxes_included -%}
        {{ 'content.duties_and_taxes_included' | t }}
      {%- elsif cart.taxes_included -%}
        {{ 'content.taxes_included' | t }}
      {%- elsif cart.duties_included -%}
        {{ 'content.duties_included' | t }}
      {%- endif -%}

      {%- if shop.shipping_policy.body != blank -%}
        {{ 'content.shipping_policy' | t }}
      {%- endif -%}
    </div>
  {% endif %}

  {%- comment -%}
    Real Shop Pay Installments badge — uses Shopify's payment_terms
    filter inside a product form (id is required for the
    shopify-payment-terms web component to bind). Same pattern as
    Horizon's native blocks/price.liquid.
  {%- endcomment -%}
  {%- comment -%}
    Installments render ONLY on the PDP buy-box price block — the
    one place a shopper has committed to a variant and the BNPL
    eligibility signal is accurate. Every product-card surface
    (collection grids, search results, megamenu features, PDP
    "you may also like" rails, predictive-search) is OFF, regardless
    of the per-block setting or the global card_show_installment
    toggle. Casa's snippets/casa-product-card.liquid is locked
    likewise. The cart-summary path renders installments above the
    checkout button via its own snippet and is unaffected.

    Discriminator: on the PDP buy-box, the block's product_resource
    is the same product as the page's `product` global. Inside a
    Horizon `_product-card` block (used for related products on a
    PDP, or for any grid surface), product_resource is the card's
    product, not the page's — those cases fail the equality check.
  {%- endcomment -%}
  {%- if block_settings.show_installments and settings.card_show_installment and selected_variant != blank and selected_variant.price > 0 and template.name == 'product' and product.id != blank and product_resource.id == product.id -%}
    {%- assign casa_installment_form_id = 'casa-price-installment-' | append: block.id -%}
    <div class="casa-installments">
      {%- form 'product', product_resource, id: casa_installment_form_id, class: 'casa-installments__form' -%}
        <input type="hidden" name="id" value="{{ selected_variant.id }}">
        {{ form | payment_terms }}
      {%- endform -%}
    </div>
  {%- endif -%}
</product-price>

{% # theme-check-disable %}
{% stylesheet %}
  .tax-note:empty {
    display: none;
  }

  product-price .casa-installments,
  .casa-installments {
    display: block;
    margin-top: 6px;
    font-size: 13px;
    font-weight: 400;
    color: #6b7280;
    line-height: 1.5;
    font-family: var(--font-body--family);
  }
  .casa-installments__form {
    margin: 0;
  }
  .casa-installments shopify-payment-terms {
    --shopify-payment-terms-color: #6b7280;
    font-size: 13px;
    line-height: 1.5;
    display: block;
  }
  /* Collapse when the variant isn't eligible (no shopify-payment-terms
     element rendered by Shopify) */
  .casa-installments:not(:has(shopify-payment-terms)) {
    display: none;
  }

  /* Volume pricing note should match unit-price styling (small, grey text) */
  product-price .volume-pricing-note,
  product-price.text-block:is(.h1, .h2, .h3, .h4, .h5, .h6) .volume-pricing-note {
    display: block;
    font-family: var(--font-body--family);
    font-weight: normal;
    font-size: var(--font-size--xs);
    line-height: normal;
    letter-spacing: normal;
    text-transform: none;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }
{% endstylesheet %}

