{%- doc -%}
  Mini Reviews Block
  Displays 1-3 customer testimonial cards with star ratings and verified badges.
{%- enddoc -%}

{%- assign block_settings = block.settings -%}

<div
  class="casa-mini-reviews spacing-style"
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  {%- if block_settings.heading != blank -%}
    <h3 class="casa-mini-reviews__heading">{{ block_settings.heading }}</h3>
  {%- endif -%}

  <div class="casa-mini-reviews__carousel">
    <button type="button" class="casa-mini-reviews__arrow casa-mini-reviews__arrow--prev" aria-label="Previous review">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <div class="casa-mini-reviews__cards">
    {%- if block_settings.review_1_text != blank -%}
      <div class="casa-mini-reviews__card{% if block_settings.review_1_image != blank %} casa-mini-reviews__card--has-img{% endif %}">
        {%- if block_settings.review_1_image != blank -%}
          <button type="button" class="casa-mini-reviews__img-btn" data-casa-review-img="{{ block_settings.review_1_image | image_url: width: 1200 }}" aria-label="Enlarge review image">
            <img src="{{ block_settings.review_1_image | image_url: width: 120 }}" width="{{ block_settings.review_1_image.width }}" height="{{ block_settings.review_1_image.height }}" alt="Review by {{ block_settings.review_1_name | escape }}" loading="lazy" class="casa-mini-reviews__img">
          </button>
        {%- endif -%}
        <div class="casa-mini-reviews__card-content">
        <div class="casa-mini-reviews__stars" role="img" aria-label="{{ block_settings.review_1_rating }} out of 5 stars">
          {%- for i in (1..5) -%}
            <svg class="casa-mini-reviews__star{% if i <= block_settings.review_1_rating %} casa-mini-reviews__star--filled{% endif %}" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M7 1L8.854 4.756L13 5.362L10 8.284L10.708 12.412L7 10.462L3.292 12.412L4 8.284L1 5.362L5.146 4.756L7 1Z" fill="currentColor"/>
            </svg>
          {%- endfor -%}
        </div>
        <p class="casa-mini-reviews__text">"{{ block_settings.review_1_text }}"</p>
        <div class="casa-mini-reviews__author">
          <span class="casa-mini-reviews__name">{{ block_settings.review_1_name }}</span>
          {%- if block_settings.review_1_verified -%}
