  </div>
    <button type="button" class="casa-mini-reviews__arrow casa-mini-reviews__arrow--next" aria-label="Next review">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>
</div>

<script>
  (function() {
    function initMiniReviewsArrows() {
      document.querySelectorAll('.casa-mini-reviews__carousel').forEach(function(carousel) {
        var track = carousel.querySelector('.casa-mini-reviews__cards');
        var prev = carousel.querySelector('.casa-mini-reviews__arrow--prev');
        var next = carousel.querySelector('.casa-mini-reviews__arrow--next');
        if (!track || !prev || !next) return;

        function update() {
          prev.classList.toggle('is-hidden', track.scrollLeft <= 2);
          next.classList.toggle('is-hidden', track.scrollLeft + track.offsetWidth >= track.scrollWidth - 2);
        }

        // Scroll one card per click. Each card fills the track width on
        // mobile, so a page step (clientWidth) lands on the next review;
        // scroll-snap corrects any sub-pixel drift.
        function step() {
          return track.clientWidth || 280;
        }

        prev.addEventListener('click', function() {
          track.scrollBy({ left: -step(), behavior: 'smooth' });
        });
        next.addEventListener('click', function() {
          track.scrollBy({ left: step(), behavior: 'smooth' });
        });

        track.addEventListener('scroll', update, { passive: true });
        update();
      });
    }

    if (document.readyState !== 'loading') initMiniReviewsArrows();
    else document.addEventListener('DOMContentLoaded', initMiniReviewsArrows);

    // Review image lightbox — click thumbnail to enlarge
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-casa-review-img]');
      if (!btn) return;
      e.preventDefault();
      var src = btn.getAttribute('data-casa-review-img');
      if (!src) return;

      var overlay = document.createElement('div');
      overlay.className = 'casa-review-lightbox';
      overlay.innerHTML = '<img src="' + src + '" alt="Review photo"><button class="casa-review-lightbox__close" aria-label="Close">&times;</button>';
      document.body.appendChild(overlay);
      document.body.style.overflow = 'hidden';

      function closeLB() {
        overlay.remove();
        document.body.style.overflow = '';
      }
      overlay.addEventListener('click', function(ev) { if (ev.target === overlay || ev.target.closest('.casa-review-lightbox__close')) closeLB(); });
      document.addEventListener('keydown', function esc(ev) { if (ev.key === 'Escape') { closeLB(); document.removeEventListener('keydown', esc); } });
    });
  })();
</script>

{% # theme-check-disable %}
{% stylesheet %}
  /* Card with image — side-by-side layout */
  .casa-mini-reviews__card--has-img {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .casa-mini-reviews__card-content {
    flex: 1;
    min-width: 0;
  }

  /* Small thumbnail on the left */
  .casa-mini-reviews__img-btn {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    border-radius: 8px;
    overflow: hidden;
  }
  .casa-mini-reviews__img {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 8px;
    display: block;
    transition: opacity 0.2s ease;
  }
  .casa-mini-reviews__img-btn:hover .casa-mini-reviews__img {
    opacity: 0.8;
  }

  /* Lightbox overlay */
  .casa-review-lightbox {
    position: fixed;
    inset: 0;
    z-index: 10001;
    background: rgba(0, 0, 0, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    cursor: pointer;
  }
  .casa-review-lightbox img {
    max-width: 90vw;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    cursor: default;
  }
  .casa-review-lightbox__close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 24px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .casa-mini-reviews__carousel {
    position: relative;
  }

  .casa-mini-reviews__arrow {
    display: none;
  }

  @media (max-width: 749px) {
    .casa-mini-reviews__arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 2;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.92);
      border: 1px solid rgba(0, 0, 0, 0.08);
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
      color: #374151;
      cursor: pointer;
      padding: 0;
      transition: opacity 0.2s ease;
    }

    .casa-mini-reviews__arrow.is-hidden {
      opacity: 0;
      pointer-events: none;
      /* Drop from the tab order too, so a keyboard user can't focus an
         invisible arrow at the start/end of the carousel. */
      visibility: hidden;
    }

    /* Sit inside the card's 40px inline padding gutter (see casa-pdp.css)
       so the arrows overlay the card background, never the quote text. */
    .casa-mini-reviews__arrow--prev {
      left: 2px;
    }

    .casa-mini-reviews__arrow--next {
      right: 2px;
    }

    /* Grow the tap target to ~38x44px (mobile guideline ≥44px in the free
       axis) without moving the 28px visual. The hit area expands
       vertically (no overflow axis) and INWARD toward the card centre —
       never past the arrow's outer edge, which would re-introduce the
       carousel-edge overhang the left/right:2px positioning just removed. */
    .casa-mini-reviews__arrow::after {
      content: '';
      position: absolute;
      top: -8px;
      bottom: -8px;
    }
    .casa-mini-reviews__arrow--prev::after {
      left: 0;
      right: -10px;
    }
    .casa-mini-reviews__arrow--next::after {
      left: -10px;
      right: 0;
    }

    .casa-mini-reviews__arrow:active {
      background: rgba(0, 0, 0, 0.04);
    }
  }
{% endstylesheet %}
{% # theme-check-enable %}

