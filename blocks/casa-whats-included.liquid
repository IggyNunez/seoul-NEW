{%- comment -%} Casa What's Included — standalone block for Horizon product-information {%- endcomment -%}

{%- if block.settings.items != blank -%}
  {% render 'casa-pdp-whats-included', block: block %}
{%- endif -%}

{% schema %}
{
  "name": "Casa What's Included",
  "tag": null,
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "What's Included" },
    {
      "type": "textarea", "id": "items", "label": "Items (one per line)",
      "info": "Product-specific — enter per template. Pre-2026-05-17 defaulted to OctaMirror box contents which bled onto every product using this block. Leave blank to hide."
    }
  ],
  "presets": [
    {
      "name": "Casa What's Included",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
