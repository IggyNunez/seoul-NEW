{% doc %}
  Renders OctaMirror benefits as visual purchase cards.
{% enddoc %}

<div class="casa-v6-benefits" role="list" aria-label="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>
  <article class="casa-v6-benefit" role="listitem">
    <span class="casa-v6-benefit__icon" aria-hidden="true">
      <svg viewBox="0 0 28 28"><path d="M14 3.2 21.6 6l3.2 8-3.2 8-7.6 2.8L6.4 22l-3.2-8 3.2-8L14 3.2Z"/><path d="M9 9.5h10v9H9z"/></svg>
    </span>
    <div><h3>{{ block.settings.mirror_title }}</h3><p>{{ block.settings.mirror_body }}</p></div>
  </article>
  <article class="casa-v6-benefit" role="listitem">
    <span class="casa-v6-benefit__icon" aria-hidden="true">
      <svg viewBox="0 0 28 28"><path d="M14 3.5 21.2 6l3.3 8-3.3 8-7.2 2.5L6.8 22l-3.3-8 3.3-8L14 3.5Z"/><path d="M14 7.5 18.8 9l2.2 5-2.2 5-4.8 1.5L9.2 19 7 14l2.2-5L14 7.5Z"/><path d="M14 11.2 16.5 12l1.1 2-1.1 2-2.5.8-2.5-.8-1.1-2 1.1-2 2.5-.8Z"/></svg>
    </span>
    <div><h3>{{ block.settings.scenes_title }}</h3><p>{{ block.settings.scenes_body }}</p></div>
  </article>
  <article class="casa-v6-benefit" role="listitem">
    <span class="casa-v6-benefit__icon" aria-hidden="true">
      <svg viewBox="0 0 28 28"><rect x="5" y="4" width="8" height="20" rx="2"/><path d="M8.2 8h1.6M17 10.5c2.5 2 2.5 5 0 7M20.5 7.5c4.5 4 4.5 9 0 13"/></svg>
    </span>
    <div><h3>{{ block.settings.control_title }}</h3><p>{{ block.settings.control_body }}</p></div>
  </article>
  <article class="casa-v6-benefit" role="listitem">
    <span class="casa-v6-benefit__icon" aria-hidden="true">
      <svg viewBox="0 0 28 28"><path d="M5 7h13v14H5zM18 7l5 3v11l-5-3V7Z"/><path d="M8 24h12M8 4h12"/></svg>
    </span>
    <div><h3>{{ block.settings.depth_title }}</h3><p>{{ block.settings.depth_body }}</p></div>
  </article>
</div>

{% stylesheet %}
  .casa-v6-benefits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    width: 100%;
  }

  .casa-v6-benefit {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 8px;
    align-items: start;
    min-width: 0;
    padding: 10px;
    border: 1px solid #e5e3de;
    border-radius: 12px;
    background: #fafaf7;
  }

  .casa-v6-benefit__icon {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 10px;
    color: #B0C3FA;
    background: linear-gradient(145deg, #f8eeff, #fff 55%, #e9fbfe);
  }

  .casa-v6-benefit__icon svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .casa-v6-benefit h3 {
    margin: 0;
    color: #0a0a0f;
    font-size: 14px;
    font-weight: 730;
    line-height: 1.25;
  }

  .casa-v6-benefit p {
    margin: 4px 0 0;
    color: #54545c;
    font-size: 14px;
    line-height: 1.35;
  }

  @media (max-width: 359px) {
    .casa-v6-benefit {
      grid-template-columns: 20px minmax(0, 1fr);
      gap: 6px;
      padding: 10px 8px;
    }

    .casa-v6-benefit__icon {
      width: 20px;
      height: 20px;
    }

  }
{% endstylesheet %}

{% schema %}
{
  "name": "OctaMirror V6 benefits",
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible label", "default": "Why customers choose the Infinity OctaMirror" },
    { "type": "text", "id": "mirror_title", "label": "Mirror title", "default": "A real mirror" },
    { "type": "text", "id": "mirror_body", "label": "Mirror text", "default": "Reflective with LEDs off." },
    { "type": "text", "id": "scenes_title", "label": "Scenes title", "default": "360+ effects" },
    { "type": "text", "id": "scenes_body", "label": "Scenes text", "default": "1M+ colors. Music mode." },
    { "type": "text", "id": "control_title", "label": "Control title", "default": "Remote included" },
    { "type": "text", "id": "control_body", "label": "Control text", "default": "App & voice optional." },
    { "type": "text", "id": "depth_title", "label": "Depth title", "default": "Approx. 5 in deep" },
    { "type": "text", "id": "depth_body", "label": "Depth text", "default": "12.7 cm, front to back." }
  ],
  "presets": [{ "name": "OctaMirror V6 benefits" }]
}
{% endschema %}
