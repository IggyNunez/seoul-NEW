{%- doc -%}
  Doorway block — used by casa-search-results.
  A "discover" tile shown in the idle (no-query) search state and in
  the no-results state, rendered by `{% content_for 'blocks' %}` in
  the parent section.

  Image resolution (first non-blank wins):
    1. block.settings.image       — merchant-uploaded image_picker
    2. block.settings.product     — falls back to product's featured media
    3. brand gradient placeholder
{%- enddoc -%}

{%- liquid
  assign s = block.settings
  assign q = s.query | strip

  if q == blank and s.link != blank
    assign target_url = s.link
  elsif q != blank
    assign target_url = routes.search_url | append: '?q=' | append: q | replace: ' ', '+'
  else
    assign target_url = ''
  endif

  # Resolve image
  assign d_image = s.image
  assign d_alt = ''
  assign d_width = 600
  assign d_height = 600

  if d_image != blank
    assign d_alt = d_image.alt | default: s.label
    assign d_width = d_image.width
    assign d_height = d_image.height
  elsif s.product != blank and s.product.featured_media != blank
    assign d_image = s.product.featured_media.preview_image
    assign d_alt = s.product.title
    assign d_width = d_image.width
    assign d_height = d_image.height
  endif
-%}

{%- if target_url != '' -%}
  <a href="{{ target_url }}" class="casa-search-results__doorway" {{ block.shopify_attributes }}>
    <span class="casa-search-results__doorway-media">
      {%- if d_image != blank -%}
        <img
          src="{{ d_image | image_url: width: 600 }}"
          srcset="{{ d_image | image_url: width: 400 }} 400w, {{ d_image | image_url: width: 600 }} 600w, {{ d_image | image_url: width: 900 }} 900w"
          sizes="(max-width: 749px) 45vw, 240px"
          alt="{{ d_alt | escape }}"
          width="{{ d_width }}"
          height="{{ d_height }}"
          loading="lazy"
          decoding="async"
        />
      {%- else -%}
        <span class="casa-search-results__doorway-placeholder" aria-hidden="true"></span>
      {%- endif -%}
    </span>
    <span class="casa-search-results__doorway-label">
      <span class="casa-search-results__doorway-title">{{ s.label }}</span>
      {%- if s.caption != blank -%}
        <span class="casa-search-results__doorway-caption">{{ s.caption }}</span>
      {%- endif -%}
    </span>
    <svg class="casa-search-results__doorway-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
    </svg>
  </a>
{%- endif -%}

{% schema %}
{
  "name": "Doorway tile",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Floor lamps"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "Sculptural · 9 styles"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional. Falls back to the referenced product's featured photo."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Fallback product",
      "info": "If no image is set, this product's featured photo is used."
    },
    {
      "type": "text",
      "id": "query",
      "label": "Search query",
      "info": "Submits this term when clicked. Leave blank to use the link instead.",
      "default": "floor lamp"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Or link",
      "info": "Used only when the search query above is blank."
    }
  ]
}
{% endschema %}
