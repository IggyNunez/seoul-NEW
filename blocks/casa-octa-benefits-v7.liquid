{% doc %}
  Concise V7 product benefits using the established product facts.
{% enddoc %}
<ul class="casa-v7-benefits" aria-label="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>
  <li><strong>{{ block.settings.mirror_title }}</strong><span>{{ block.settings.mirror_body }}</span></li>
  <li><strong>{{ block.settings.scenes_title }}</strong><span>{{ block.settings.scenes_body }}</span></li>
  <li><strong>{{ block.settings.control_title }}</strong><span>{{ block.settings.control_body }}</span></li>
  <li><strong>{{ block.settings.depth_title }}</strong><span>{{ block.settings.depth_body }}</span></li>
</ul>
{% schema %}
{
  "name": "OctaMirror V7 benefits",
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible label", "default": "Why customers choose the Infinity OctaMirror" },
    { "type": "text", "id": "mirror_title", "label": "Mirror title", "default": "A real mirror" },
    { "type": "text", "id": "mirror_body", "label": "Mirror text", "default": "Reflective with LEDs off." },
    { "type": "text", "id": "scenes_title", "label": "Scenes title", "default": "360+ effects" },
    { "type": "text", "id": "scenes_body", "label": "Scenes text", "default": "1M+ colors. Music mode." },
    { "type": "text", "id": "control_title", "label": "Control title", "default": "Remote included" },
    { "type": "text", "id": "control_body", "label": "Control text", "default": "App & voice optional." },
    { "type": "text", "id": "depth_title", "label": "Depth title", "default": "Approx. 5 in deep" },
    { "type": "text", "id": "depth_body", "label": "Depth text", "default": "12.7 cm, front to back." }
  ],
  "presets": [{ "name": "OctaMirror V7 benefits" }]
}
{% endschema %}
