

{%- doc -%}
  Renders product recommendations.
  {section.id} - identifies the parent section for the Section Rendering API

  https://shopify.dev/docs/api/section-rendering-api
{%- enddoc -%}

<script
  src="{{ 'product-recommendations.js' | asset_url }}"
  type="module"
></script>

{% liquid
  assign block_settings = block.settings
  case block_settings.layout_type
    when 'grid'
      assign classes = 'resource-list--grid'
    when 'carousel'
      assign classes = 'resource-list--carousel'
  endcase
%}

{% comment %}
  [data-section-id] {section.id} - used to fetch the product recommendations from the Section Rendering API
{% endcomment %}

{%- comment -%} Casa overrides for product recommendation cards {%- endcomment -%}
<style>
  {%- if block.settings.hide_sale_badge -%}
  #product-recommendations-{{ block.id }} .price-save-badge,
  #product-recommendations-{{ block.id }} .badge--sale,
  #product-recommendations-{{ block.id }} [class*="badge"][class*="sale"] {
    display: none !important;
  }
  {%- endif -%}
  {%- if block.settings.hide_save_amount -%}
  #product-recommendations-{{ block.id }} .price__save,
  #product-recommendations-{{ block.id }} .price-save-badge,
  #product-recommendations-{{ block.id }} [class*="save"] {
    display: none !important;
  }
  {%- endif -%}
  {%- if block.settings.center_text -%}
  #product-recommendations-{{ block.id }} .product-card__info,
  #product-recommendations-{{ block.id }} .product-card__title,
  #product-recommendations-{{ block.id }} .price,
  #product-recommendations-{{ block.id }} [class*="product-card"] [class*="title"],
  #product-recommendations-{{ block.id }} [class*="product-card"] [class*="price"] {
    text-align: center !important;
    justify-content: center !important;
  }
  {%- endif -%}
  {%- if block.settings.price_color != blank -%}
  #product-recommendations-{{ block.id }} .price .price__current,
  #product-recommendations-{{ block.id }} .price .money,
  #product-recommendations-{{ block.id }} .price__sale {
    color: {{ block.settings.price_color }} !important;
  }
  {%- endif -%}
  {%- if block.settings.compare_price_color != blank -%}
  #product-recommendations-{{ block.id }} .price .price__was,
  #product-recommendations-{{ block.id }} .price s,
  #product-recommendations-{{ block.id }} .price del,
  #product-recommendations-{{ block.id }} .price__compare {
    color: {{ block.settings.compare_price_color }} !important;
  }
  {%- endif -%}
  {%- if block.settings.save_color != blank -%}
  #product-recommendations-{{ block.id }} .price-save-badge,
  #product-recommendations-{{ block.id }} .price__save {
    color: {{ block.settings.save_color }} !important;
  }
  {%- endif -%}
  {%- if block.settings.title_color != blank -%}
  #product-recommendations-{{ block.id }} .product-card__title,
  #product-recommendations-{{ block.id }} [class*="product-card"] [class*="title"] a,
  #product-recommendations-{{ block.id }} [class*="product-card"] [class*="title"] {
    color: {{ block.settings.title_color }} !important;
  }
  {%- endif -%}
  {%- if block.settings.reviews_color != blank -%}
  #product-recommendations-{{ block.id }} [class*="review"],
  #product-recommendations-{{ block.id }} [class*="rating"] {
    color: {{ block.settings.reviews_color }} !important;
  }
  {%- endif -%}
</style>

<product-recommendations
  id="product-recommendations-{{ block.id }}"
  class="product-recommendations"
  data-url="{{ routes.product_recommendations_url }}?limit={{ block_settings.max_products }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ closest.product.id }}"
  data-intent="{{ block_settings.recommendation_type }}"
  data-recommendations-performed="{{ recommendations.performed }}"
  {% if request.visual_preview_mode %}
    data-shopify-editor-preview
  {% endif %}
  data-testid="product-recommendations-block"
  {{ block.shopify_attributes }}
>
  <div
    class="
      {% if block_settings.inherit_color_scheme == false %}color-{{ block_settings.color_scheme }}{% endif %}
      block-resource-list
      spacing-style
      gap-style
    "
    style="
      {%  render 'spacing-style', settings: block_settings %}
      {%  render 'gap-style', value: block_settings.gap %}
      --resource-list-column-gap-desktop: {{ block_settings.columns_gap }}px;
      --resource-list-row-gap-desktop: {{ block_settings.rows_gap }}px;
      --resource-list-columns-mobile: repeat(auto-fill, minmax(9.25rem, 1fr));
      --border-radius: {{ block_settings.border_radius }}px;
    "
  >
    <div class="section-resource-list__content">
      {% content_for 'blocks' %}
    </div>

    {%- if recommendations.performed or closest.product == blank -%}
      {% liquid
        assign products = recommendations.products

        if closest.product == blank
          # Onboarding mode: Show placeholder products
          for i in (1..block_settings.max_products)
            assign products = products | append: ', '
            assign products = products | split: ','
          endfor
        elsif recommendations.performed and recommendations.products_count == 0
          # No recommendations found, pull from catalog
          if block_settings.recommendation_type == 'related'
            assign products = collections.all.products | reject: 'id', closest.product.id
          elsif block_settings.recommendation_type == 'complementary'
            # Do not recommend the All collection as complementary products
            assign products = null
          endif
        else
          assign products = recommendations.products
        endif
      %}
      {% capture list_items %}
        {% for product in products limit: block_settings.max_products %}
          <div class="resource-list__item">
            {%- comment -%}
              Use Casa product card — same as sections/product-recommendations.liquid.
              Inherits hover video, swatches, badges, ratings, and all
              theme-level toggles automatically.
            {%- endcomment -%}
            {%- comment -%}
              Compact in-buy-box widget: force-disable swatches, quick-add,
              quick-view, savings-highlight, and installments. These extras
              are designed for the full-page collection card; in a 200px-
              wide carousel slide they're either illegible (swatches at
              28px tap-target) or push some cards 50px taller than their
              siblings — and the carousel forces equal slide height, so
              shorter cards get a "massive gap" of empty space below their
              content. Locking these to false here equalizes every card.
            {%- endcomment -%}
            {% render 'casa-product-card',
              product: product,
              variant: 'default',
              index: forloop.index0,
              show_rating: settings.card_show_rating,
              show_hover_video: settings.card_show_hover_video,
              show_badge: settings.card_show_badges,
              show_sale_badge: settings.card_show_sale_badge,
              show_variant_swatches: false,
              show_quick_add: false,
              show_quick_view: false,
              show_wishlist: false,
              show_stock_urgency: settings.card_show_stock_urgency,
              show_savings_highlight: false,
              show_installment: false
            %}
          </div>
          {% if block_settings.layout_type == 'carousel' or block_settings.carousel_on_mobile %}
            {% unless forloop.last %}
              <!--@list/split-->
            {% endunless %}
          {% endif %}
        {% endfor %}
      {% endcapture %}

      {% liquid
        # Create an array from the list items to be used in the carousel
        assign slide_content = list_items | strip
        assign slides = slide_content | split: '<!--@list/split-->'

        if products != blank and products.size > 0
          assign has_recommendations = 'true'
        else
          assign has_recommendations = 'false'
        endif
      %}

      <div
        class="
          resource-list
          {% if block_settings.carousel_on_mobile and block_settings.layout_type != 'carousel' %}
            hidden--mobile
          {% endif %}
          {{ classes }}
        "
        {% if block_settings.layout_type == 'grid' %}
          data-testid="resource-list-grid"
        {% endif %}
        data-has-recommendations="{{ has_recommendations }}"
      >
        {% case block_settings.layout_type %}
          {% when 'grid' %}
            {{ list_items }}
          {% when 'carousel' %}
            {% comment %}
              Pass a smaller slide_width_max so the in-buy-box widget shows
              ~2 cards + a peek of the third inside the cramped buy-box
              column. Default in resource-list-carousel is 300px which only
              fits 1.5 cards in a ~390px column. 200px fits 2 + peek.
            {% endcomment %}
            {% render 'resource-list-carousel',
              ref: 'resourceListCarousel',
              slides: slides,
              slide_count: recommendations.products.size,
              settings: block_settings,
              slide_width_max: '200px'
            %}
        {% endcase %}
      </div>

      {% if block_settings.carousel_on_mobile and block_settings.layout_type != 'carousel' %}
        {% liquid
          assign mobile_carousel_gap = block_settings.columns_gap
        %}
        <div
          class="
            resource-list
            hidden--desktop
            force-full-width
          "
          style="--resource-list-gap: {{ mobile_carousel_gap }}px;"
        >
          {% render 'resource-list-carousel',
            ref: 'resourceListCarouselMobile',
            slides: slides,
            slide_count: recommendations.products.size,
            settings: block_settings,
            slide_width_max: '200px'
          %}
        </div>
      {% endif %}
    {%- else -%}
      <div class="resource-list resource-list--grid">
        {% for i in (1..block_settings.max_products) %}
          <div
            class="resource-list__item product-recommendations__skeleton-item"
            aria-label="{{ 'accessibility.loading_product_recommendations' | t }}"
          ></div>
        {% endfor %}
      </div>
    {%- endif -%}
  </div>
</product-recommendations>

<style>
  /* Mobile: card info flush to card edge across recommendation cards */
  @media (max-width: 600px) {
    .product-recommendations .product-card__info,
    .product-recommendations [class*="product-card"] [class*="info"],
    .product-recommendations .resource-list__slide product-card {
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
  }

  /* ── Compact mode for the in-buy-box "You may also like" widget ──
     Scoped to data-testid="product-recommendations-block" so this only
     touches the embedded buy-box widget, NOT the standalone post-PDP
     "More to love" section (which uses data-testid="product-recommendations-section"
     and intentionally renders cards at full marketing scale).

     The buy-box column on PDPs renders at ~360–500px wide on tablet and
     small-laptop viewports. At default casa-product-card sizing, only
     1.5 cards were visible and price/rating dominated the card. Tighten
     everything one notch so two cards + a peek fit comfortably and the
     hierarchy is title → price → rating instead of price → everything-else. */
  product-recommendations[data-testid="product-recommendations-block"] {
    /* Compact price scale — desktop default is 17px/600, knock it down
       to the title's tier so price stops out-shouting the product name. */
    --casa-price-size: 14px;
    --casa-compare-size: 12px;
    --casa-savings-size: 11px;
    --casa-installment-size: 11px;
    /* Carousel slide width — base.css uses
         clamp(150px, var(--mobile-card-size, 60cqw), var(--slide-width-max))
       at <750px container. Default 60cqw on a 353px PDP buy-box column
       caps to ~200px, giving 1.5 cards. Drop to 44cqw so two ~155px
       cards fit + a peek of the third. */
    --mobile-card-size: 44cqw;
  }
  product-recommendations[data-testid="product-recommendations-block"] .casa-product-card__info {
    /* Tighter padding — buy-box column is narrow, default 24px L/R inside
       a 235px card eats too much real estate. */
    padding: 12px 0;
    gap: 4px;
  }
  product-recommendations[data-testid="product-recommendations-block"] .casa-product-card__title {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.25;
  }
  product-recommendations[data-testid="product-recommendations-block"] .casa-product-card__price {
    gap: 6px;
  }
  product-recommendations[data-testid="product-recommendations-block"] .casa-product-card__price-current {
    font-weight: 600;
  }
  /* Judge.me badge in compact card — match the size hierarchy to title.
     The metafield-rendered badge has its own font-size that bleeds in via
     .jdgm-prev-badge defaults (typically 14–16px). Force compact so the
     "★ 55 reviews" row stays under the price, not equal to it. */
  product-recommendations[data-testid="product-recommendations-block"] .casa-product-card__rating,
  product-recommendations[data-testid="product-recommendations-block"] .jdgm-widget,
  product-recommendations[data-testid="product-recommendations-block"] .jdgm-prev-badge {
    font-size: 12px !important;
    line-height: 1.3;
  }
  /* Stars at the 12px legibility floor; review-count text one notch
     smaller so it reads as supporting metadata. */
  product-recommendations[data-testid="product-recommendations-block"] .jdgm-prev-badge__stars {
    font-size: 12px !important;
  }
  product-recommendations[data-testid="product-recommendations-block"] .jdgm-prev-badge__text {
    font-size: 11px !important;
  }
  product-recommendations[data-testid="product-recommendations-block"] .jdgm-prev-badge {
    display: inline-flex !important;
    align-items: center;
    gap: 4px;
  }
  product-recommendations[data-testid="product-recommendations-block"] .jdgm-prev-badge__text {
    color: var(--card-reviews-color, #6b7280);
  }
</style>

{% stylesheet %}
  /* iOS Safari repaint fix — Horizon's base.css sets
       slideshow-slide { content-visibility: auto; contain-intrinsic-size: auto none; }
     for perf, then re-asserts c-v:auto on peeking slides inside
     .resource-list__carousel via a high-specificity rule (~line 4108).
     The visible override only wins when slideshow-component has [actioned]
     (set on pointerenter, line 816 of slideshow.js) OR the slide is
     [aria-hidden="false"] — but the latter is defeated by the carousel
     reset's higher specificity. The :hover/[dragging]/[transitioning]
     fallback (~line 4119) doesn't fire during ordinary page scroll on
     touch devices, where :hover never triggers.

     Result on iOS Safari: a fresh page render shows the rec widget
     correctly (slides paint on first measure), but scrolling past the
     section and back leaves the inner cards blank — the placeholder box
     keeps its height (via contain-intrinsic-size) so layout doesn't
     collapse, but the cards never repaint (known WebKit content-visibility
     bug). Merchant reproduced on iPhone 2026-05-19.

     For these product-card carousels the perf gain from c-v:auto is
     marginal (4–10 cards at ~155×270 each, images already loading="lazy"),
     so force-paint to eliminate the blank-on-scroll-back bug.
     `!important` is required: the carousel reset selector at base.css
     ~4108 has specificity (0,2,2), one notch above anything that fits
     in a normal scope chain here. */
  .resource-list__carousel slideshow-slide {
    content-visibility: visible !important;
  }

  .block-resource-list {
    display: flex;
    flex-direction: column;
    row-gap: var(--gap);
    min-width: 0;
    min-height: 0;
    container-type: inline-size;
    container-name: resource-list;
    border-radius: var(--border-radius, 0);
  }

  .product-recommendations-wrapper {
    width: 100%;
  }

  .product-recommendations-wrapper:has(product-recommendations[data-shopify-editor-preview]) {
    width: 100vw;
  }

  /* ── Casa carousel arrows — match Recently Viewed / Categories / Products Grid ──
     Horizon defaults slideshow-arrows to mix-blend-mode:difference, which is
     what was producing the green/inverted halo around our arrows. Force
     normal blend mode inside this block. */
  .product-recommendations slideshow-arrows {
    mix-blend-mode: normal !important;
  }

  .product-recommendations .slideshow-control {
    width: 48px !important;
    height: 48px !important;
    border-radius: 50% !important;
    border: 1px solid rgba(255, 255, 255, 0.18) !important;
    background: rgba(10, 10, 15, 0.78) !important;
    color: #fff !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: opacity 0.2s ease, transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    z-index: 20;
    cursor: pointer;
  }

  .product-recommendations .slideshow-control:hover:not(:disabled) {
    background: #fff !important;
    border-color: rgba(255, 255, 255, 0.6) !important;
    color: #0a0a0a !important;
    transform: scale(1.05);
    box-shadow:
      0 6px 20px rgba(0, 0, 0, 0.25),
      0 0 0 4px rgba(176, 195, 250, 0.18),
      0 0 22px rgba(94, 10, 2, 0.35);
  }

  .product-recommendations .slideshow-control:disabled,
  .product-recommendations .slideshow-control[disabled] {
    display: none !important;
  }

  .product-recommendations .slideshow-control .svg-wrapper,
  .product-recommendations .slideshow-control svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 900px) {
    .product-recommendations .slideshow-control {
      /* 44×44 minimum tap target — Apple HIG / Google MWG spec. Was 40×40,
         which the brand mobile pre-flight flags as below floor. */
      width: 44px !important;
      height: 44px !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_recommendations",
  "class": "product-recommendations-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_recommendations"
    },
    {
      "type": "select",
      "id": "recommendation_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "related",
          "label": "t:options.related"
        },
        {
          "value": "complementary",
          "label": "t:options.complementary"
        }
      ],
      "default": "related"
    },
    {
      "type": "paragraph",
      "content": "t:content.complementary_products"
    },
    {
      "type": "header",
      "content": "t:content.cards_layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_style",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": true,
      "visible_if": "{{ block.settings.layout_type == 'grid' }}"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.layout_type == 'grid' or block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.layout_type == 'grid' }}"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation",
      "visible_if": "{{ block.settings.layout_type == 'carousel' or block.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "chevron",
      "visible_if": "{{ block.settings.layout_type == 'carousel' or block.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.icons_style != 'none' and block.settings.layout_type == 'carousel' or block.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Card display overrides"
    },
    {
      "type": "checkbox",
      "id": "hide_sale_badge",
      "label": "Hide sale badge",
      "info": "Hides the discount % badge on product images",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_save_amount",
      "label": "Hide save amount",
      "info": "Hides the 'Save $XX' text",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "center_text",
      "label": "Center text",
      "info": "Center align title, price, and reviews",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show reviews",
      "info": "Display star ratings on cards",
      "default": true
