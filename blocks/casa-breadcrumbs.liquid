{%- comment -%} Casa Breadcrumbs — standalone block for Horizon product-information {%- endcomment -%}

{%- assign product = closest.product -%}
<nav class="cpm__breadcrumbs" {{ block.shopify_attributes }}>
  <a href="/">Home</a>
  <span>&rsaquo;</span>
  {%- capture casa_bc_handle -%}{%- render 'casa-breadcrumb-collection', product: product -%}{%- endcapture -%}
  {%- assign casa_bc_handle = casa_bc_handle | strip -%}
  {%- assign casa_bc_col = collections[casa_bc_handle] -%}
  {%- if casa_bc_col != blank and casa_bc_col.title != blank -%}
    <a href="{{ casa_bc_col.url }}">{{ casa_bc_col.title }}</a>
    <span>&rsaquo;</span>
  {%- endif -%}
  <span>{{ product.title }}</span>
</nav>

{% stylesheet %}
.cpm__breadcrumbs {
  font-size: 13px;
  color: var(--cpm-text-muted, #6b7280);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
}
.cpm__breadcrumbs a {
  color: inherit;
  text-decoration: none;
}
.cpm__breadcrumbs a:hover {
  color: var(--cpm-accent-1, #B0C3FA);
}
.cpm__breadcrumbs span {
  color: var(--cpm-text-muted, #6b7280);
}
{% endstylesheet %}

{% schema %}
{
  "name": "Casa Breadcrumbs",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "Casa Breadcrumbs",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
