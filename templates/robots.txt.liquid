{% comment %}
  Customized robots.txt — extends Shopify's default rules with
  explicit allow rules for AI crawlers (ChatGPT, Claude, Perplexity,
  Gemini, etc.). Toggle via Casa SEO > "Allow AI crawlers" theme
  setting.

  Shopify's default robots.txt content is preserved via the
  `robots.default_groups` Liquid object — we just append our
  additions.
{% endcomment %}{% for group in robots.default_groups %}
{{- group.user_agent }}
{%- for rule in group.rules %}
{{ rule }}
{%- endfor %}

{%- if group.sitemap != blank %}
{{ group.sitemap }}
{%- endif %}

{% endfor %}

