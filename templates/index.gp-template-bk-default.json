        "button_label": "Partner with SGL",
        "button_link": "",
        "button_text": "#F8EBDA",
        "eyebrow": "For brands + retailers",
        "heading": "Good Korean beauty deserves the right introduction.",
        "padding_bottom": 72,
        "padding_top": 72,
        "text_color": "#5E0A02"
      },
      "type": "sgl-b2b-partner"
    },
