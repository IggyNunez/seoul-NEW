  };
  window.addEventListener('scroll', onScroll, { passive: true });

  // Toggle auto
  toggle.addEventListener('click', function () {
    auto = !auto;
    userOverride = false;
    toggle.classList.toggle('is-on', auto);
    toggleLbl.textContent = auto ? 'Pause' : 'Auto';
    if (auto) startAuto(); else stopAuto();
  });

  // Manual scrub
  scrub.addEventListener('input', function () {
    userOverride = true;
    if (auto) {
      auto = false;
      toggle.classList.remove('is-on');
      toggleLbl.textContent = 'Auto';
      stopAuto();
    }
    setT(parseInt(scrub.value, 10) / 1000);
  });

  // Reset
  resetBtn.addEventListener('click', function () {
    userOverride = false;
    auto = false;
    toggle.classList.remove('is-on');
    toggleLbl.textContent = 'Auto';
    stopAuto();
    setT(0);
  });

  // First paint
  render();

  // Pause the rAF loop when the section scrolls offscreen. The
  // 32-ring tunnel + LED rotation is GPU-cheap but rAF still wakes
  // the main thread every frame; on phones that's measurable
  // battery + scroll-jank cost.
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting && auto && !rafId) {
          startAuto();
        } else if (!entry.isIntersecting && rafId) {
          stopAuto();
        }
      });
    }, { threshold: 0.01 });
    io.observe(stage);
  } else if (auto) {
    startAuto();
  }
}

function casaDnInitAll(scope) {
  (scope || document).querySelectorAll('.casa-dn').forEach(casaDnInit);
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', function () { casaDnInitAll(); });
} else {
  casaDnInitAll();
}
document.addEventListener('shopify:section:load', function (e) {
  if (e.target) casaDnInitAll(e.target);
});
