  function setT(v) {
    t = clamp(v, 0, 1);
    if (videoEl) seekVideo(t);
    render();
  }

  // Auto loop
  function startAuto() {
    if (rafId) cancelAnimationFrame(rafId);

    if (videoEl) {
      var p = videoEl.play();
      if (p && p.catch) p.catch(function () { /* autoplay refused; scrub still works */ });
      // The video is now the clock — read from it rather than integrating
      // our own elapsed time, so the scrubber can never drift from what is
      // actually on screen.
      var vtick = function () {
        var d = videoDuration();
        if (d) { t = clamp(videoEl.currentTime / d, 0, 1); render(); }
        rafId = requestAnimationFrame(vtick);
      };
      rafId = requestAnimationFrame(vtick);
      return;
    }

    var last = performance.now();
    function tick(now) {
      var dt = (now - last) / 1000;
      last = now;
      var next = t + dt / cycleSeconds;
      if (next > 1) next = 0;
      t = next;
      render();
      rafId = requestAnimationFrame(tick);
    }
    rafId = requestAnimationFrame(tick);
  }
  function stopAuto() {
    if (rafId) cancelAnimationFrame(rafId);
    rafId = null;
    if (videoEl) videoEl.pause();
