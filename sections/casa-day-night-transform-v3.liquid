  // Scroll progress (only when user not overriding AND auto off).
  // rAF ticking pattern (see casa-pdp-features): WebKit delivers several
  // scroll events per frame during momentum scroll — coalesce them so the
  // getBoundingClientRect read + render() writes run at most once per frame.
  // Scroll-linked motion is still motion: bail under prefers-reduced-motion
  // (the CSS kill-switch doesn't cover JS-driven writes).
  var scrollTicking = false;
  var onScroll = function () {
    // Self-clean: theme-editor re-renders replace the section but the old
    // window listener survives — first scroll after removal unhooks it.
    if (!stage.isConnected) { window.removeEventListener('scroll', onScroll); return; }
    if (auto || userOverride || prefersReduce) return;
    if (scrollTicking) return;
    scrollTicking = true;
    requestAnimationFrame(function () {
      scrollTicking = false;
      if (auto || userOverride) return;
      var rect = stage.getBoundingClientRect();
      var vh = window.innerHeight;
      var raw = (vh - rect.top) / (vh - vh * 0.25);
      setT(clamp(raw, 0, 1));
