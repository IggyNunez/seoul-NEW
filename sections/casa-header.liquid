  assign header_border = section.settings.header_border_color | default: '#FAFAF7'
  assign header_border_opacity = section.settings.header_border_opacity | default: 8 | divided_by: 100.0
  assign header_text = section.settings.header_text_color | default: '#FAFAF7'
  assign header_text_opacity = section.settings.header_text_opacity | default: 85 | divided_by: 100.0
  assign mega_bg = section.settings.mega_bg_color | default: '#0A0A0F'
  assign mega_bg_opacity = section.settings.mega_bg_opacity | default: 95 | divided_by: 100.0
  assign mega_border = section.settings.mega_border_color | default: '#FAFAF7'
  assign glow_primary = section.settings.glow_accent_primary | default: '#B0C3FA'
