{%- comment -%}
  Seoul Glow Lab - Main Header Section
  Sticky dark glassmorphism header with desktop mega menu and mobile drawer.
{%- endcomment -%}

{%- comment -%} ── Pre-render quick link blocks BEFORE header (render isolates scope) ── {%- endcomment -%}
{%- capture glow_quick_links_html -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'quick_link' and block.settings.variant == 'glow' -%}
      <a href="{{ block.settings.url }}" class="casa-mega-quick-link" {{ block.shopify_attributes }}>
        {%- render 'casa-icon', icon: block.settings.icon, size: 16 -%} {{ block.settings.text }}
      </a>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture lifestyle_quick_links_html -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'quick_link' and block.settings.variant == 'lifestyle' -%}
      <a href="{{ block.settings.url }}" class="casa-mega-quick-link" {{ block.shopify_attributes }}>
        {%- render 'casa-icon', icon: block.settings.icon, size: 16 -%} {{ block.settings.text }}
      </a>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture support_quick_links_html -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'quick_link' and block.settings.variant == 'support' -%}
      <a href="{{ block.settings.url }}" class="casa-mega-quick-link" {{ block.shopify_attributes }}>
        {%- render 'casa-icon', icon: block.settings.icon, size: 16 -%} {{ block.settings.text }}
      </a>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture mobile_quick_links_html -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'quick_link' and block.settings.variant == 'mobile' -%}
      <a href="{{ block.settings.url }}" class="casa-drawer__secondary-link" {{ block.shopify_attributes }}>
        {%- render 'casa-icon', icon: block.settings.icon, size: 14 -%} {{ block.settings.text }}
      </a>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<header class="casa-header{% if section.settings.enable_sticky %} casa-header--sticky{% endif %}{% if section.settings.header_border_style == 'static' %} casa-header--border-static{% elsif section.settings.header_border_style == 'animated' %} casa-header--border-animated{% endif %}{% if section.settings.header_layout == 'widescreen' %} casa-header--widescreen{% endif %}{% if section.settings.nav_uppercase %} casa-header--nav-uppercase{% endif %}"
  {%- comment -%}
    CSS vars inlined on the <header> so they're available at parse time.
    The {% style %} block ~1200 lines below also sets these on :root, but
    by then the browser has already rendered the <header> with the CSS
    fallback (36px logo), then re-laid-out to the actual height — a 15.6px
    CLS shift visible on every cold load.
  {%- endcomment -%}
  style="--casa-header-height: {{ section.settings.header_height | default: 80 }}px; --casa-logo-height: {{ section.settings.logo_height | default: 36 }}px;"
  {{ section.shopify_attributes }}>
  {%- if section.settings.header_border_style == 'animated' -%}
    <span class="casa-header__border-anim" aria-hidden="true"></span>
  {%- endif -%}
  <div class="casa-header__inner">

    {%- comment -%} ── Left: Logo + Desktop Nav ── {%- endcomment -%}
    <div class="casa-header__left">
      <a href="{{ routes.root_url }}" class="casa-header__logo" aria-label="{{ shop.name }}">
        {%- if section.settings.logo_image != blank -%}
          {%- liquid
            # sizes is load-bearing: CSS pins the logo to --casa-logo-height
            # (width: auto), so the slot is height × aspect ratio. Mobile
            # breakpoints scale the height down; ultrawide scales it UP
            # (×1.15 ≥1920px, ×1.3 ≥2560px), hence the tiers. A sizes-less
            # w-descriptor srcset defaults the slot to 100vw — over-fetch +
            # the Safari 26 inflated-intrinsic trap (mechanism:
            # snippets/casa-cart-items.liquid cart image).
            # alt is precomputed: a piped fallback inside the arg list
            # (alt: x | default: y) TERMINATES image_tag's args — default
            # swallows every argument after it.
            assign _logo_alt = section.settings.logo_text | default: shop.name
            assign _logo_h = section.settings.logo_height | default: 36
            assign _logo_slot = _logo_h | times: section.settings.logo_image.aspect_ratio | ceil
            if _logo_slot < 1
              # aspect_ratio unavailable → fall back to the src width so we
              # never emit sizes="0px" (smallest-rendition trap)
              assign _logo_slot = 200
            endif
            assign _logo_uw = _logo_slot | times: 1.3 | ceil
            assign _logo_xw = _logo_slot | times: 1.15 | ceil
            assign _logo_sizes = '(min-width: 2560px) ' | append: _logo_uw | append: 'px, (min-width: 1920px) ' | append: _logo_xw | append: 'px, ' | append: _logo_slot | append: 'px'
          -%}
          {{ section.settings.logo_image | image_url: width: 600 | image_tag: class: 'casa-header__logo-img', alt: _logo_alt, widths: '160, 320, 480, 600', sizes: _logo_sizes }}
        {%- else -%}
          {{ section.settings.logo_text | default: 'SEOUL GLOW LAB' }}
        {%- endif -%}
      </a>

      <nav class="casa-header__nav casa-desktop-only" aria-label="Main navigation">
        {%- for link in linklists[section.settings.menu].links -%}
          {%- if link.links.size > 0 -%}
            {%- comment -%} Nav item with mega menu {%- endcomment -%}
            {%- liquid
              assign _link_handle = link.title | downcase | handle
              assign custom_accent_primary = nil
              assign custom_accent_secondary = nil
              assign custom_accent_tertiary = nil
              assign custom_menu_theme = nil
              assign custom_collection = nil
              assign custom_product_limit = nil
              for block in section.blocks
                if block.type == 'menu_color' and block.settings.menu_handle == _link_handle
                  assign custom_accent_primary = block.settings.accent_primary
                  assign custom_accent_secondary = block.settings.accent_secondary
                  assign custom_accent_tertiary = block.settings.accent_tertiary
                endif
                if block.type == 'menu_theme' and block.settings.menu_handle == _link_handle
                  assign custom_menu_theme = block.settings.theme
                endif
                if block.type == 'menu_collection'
                  assign _block_handle = block.settings.menu_handle | downcase | handle
                  if _block_handle == _link_handle or _block_handle == link.handle
                    assign custom_collection = block.settings.collection
                    assign custom_product_limit = block.settings.product_limit
                    assign custom_products_title = block.settings.products_title
                  endif
                endif
              endfor
            -%}
            <div class="casa-nav-item">
              <a href="{{ link.url }}" class="casa-header__nav-link">
                {{ link.title }}
                {%- render 'casa-icon', icon: 'chevron-down', size: 14 -%}
              </a>
              {%- render 'casa-mega-menu',
                link: link,
                collection_glow: section.settings.collection_glow,
                collection_lifestyle: section.settings.collection_lifestyle,
                video_url: section.settings.video_url,
                promo_title: section.settings.promo_title,
                promo_subtitle: section.settings.promo_subtitle,
                promo_link: section.settings.promo_link,
                promo_image: section.settings.promo_image,
                promo_btn_primary: section.settings.promo_btn_primary,
                promo_btn_secondary: section.settings.promo_btn_secondary,
                promo_btn_secondary_link: section.settings.promo_btn_secondary_link,
                featured_label_glow: section.settings.featured_label_glow,
                featured_label_lifestyle: section.settings.featured_label_lifestyle,
                featured_label_support: section.settings.featured_label_support,
                lifestyle_title: section.settings.lifestyle_title,
                lifestyle_subtitle: section.settings.lifestyle_subtitle,
                lifestyle_link: section.settings.lifestyle_link,
                lifestyle_image: section.settings.lifestyle_image,
                lifestyle_video_url: section.settings.lifestyle_video_url,
                lifestyle_btn_primary: section.settings.lifestyle_btn_primary,
                lifestyle_btn_secondary: section.settings.lifestyle_btn_secondary,
                lifestyle_btn_secondary_link: section.settings.lifestyle_btn_secondary_link,
                support_email: section.settings.support_email,
                support_phone: section.settings.support_phone,
                support_title: section.settings.support_title,
                support_description: section.settings.support_description,
                support_chat_label: section.settings.support_chat_label,
                support_chat_link: section.settings.support_chat_link,
                support_btn_text: section.settings.support_btn_text,
                support_btn_link: section.settings.support_btn_link,
                support_fallback_description: section.settings.support_fallback_description,
                categories_title_glow: section.settings.categories_title_glow,
                categories_title_lifestyle: section.settings.categories_title_lifestyle,
                categories_title_support: section.settings.categories_title_support,
                products_title_glow: section.settings.products_title_glow,
                products_title_lifestyle: section.settings.products_title_lifestyle,
                quick_help_title: section.settings.quick_help_title,
                product_limit_glow: section.settings.product_limit_glow,
                product_limit_lifestyle: section.settings.product_limit_lifestyle,
                products_per_row: section.settings.products_per_row,
                glow_quick_links_html: glow_quick_links_html,
                lifestyle_quick_links_html: lifestyle_quick_links_html,
                support_quick_links_html: support_quick_links_html,
                custom_accent_primary: custom_accent_primary,
                custom_accent_secondary: custom_accent_secondary,
                custom_accent_tertiary: custom_accent_tertiary,
                custom_menu_theme: custom_menu_theme,
                custom_collection: custom_collection,
                custom_product_limit: custom_product_limit,
                custom_products_title: custom_products_title,
                show_category_icons: section.settings.show_category_icons
              -%}
            </div>
          {%- else -%}
            <a href="{{ link.url }}" class="casa-header__nav-link">{{ link.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    </div>

    {%- comment -%} ── Right: Actions ── {%- endcomment -%}
    <div class="casa-header__actions">
      {%- comment -%} Country/Currency Selector (desktop) {%- endcomment -%}
      {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
        <button class="casa-header__btn casa-header__locale-btn casa-desktop-only" aria-label="Country and language">
          {%- render 'casa-icon', icon: 'globe', size: 18 -%}
          <span class="casa-header__locale-text">{{ localization.country.currency.iso_code }}</span>
        </button>
      {%- endif -%}

      {%- comment -%} Search (desktop) — triggers Horizon's search modal {%- endcomment -%}
      <button class="casa-header__btn casa-header__search-btn casa-desktop-only" aria-label="Search" onclick="document.querySelector('#search-modal')?.showDialog?.()">
        {%- render 'casa-icon', icon: 'search', size: 22 -%}
      </button>

      {%- comment -%} Search (mobile) {%- endcomment -%}
      <button class="casa-header__btn casa-header__search-btn casa-mobile-only" aria-label="Search" onclick="document.querySelector('#search-modal')?.showDialog?.()">
        {%- render 'casa-icon', icon: 'search', size: 22 -%}
      </button>

      {%- comment -%} Account (desktop) — links to account page or login {%- endcomment -%}
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="casa-header__btn casa-header__account-btn casa-desktop-only" aria-label="{{ 'accessibility.account' | t }}">
          {%- if customer -%}
            {%- comment -%} Logged in: show initial or avatar {%- endcomment -%}
            <span class="casa-header__account-avatar">
              {%- assign _initial = customer.email | slice: 0 -%}
              {%- if customer.first_name != blank -%}
                {%- assign _initial = customer.first_name | slice: 0 -%}
              {%- endif -%}
              {{ _initial | upcase }}
            </span>
          {%- else -%}
            {%- comment -%} Guest: show user icon {%- endcomment -%}
            {%- render 'casa-icon', icon: 'user', size: 22 -%}
          {%- endif -%}
        </a>
      {%- endif -%}

      {%- comment -%} Cart — integrates with Horizon's cart drawer setting {%- endcomment -%}
      <script src="{{ 'cart-icon.js' | asset_url }}" type="module" fetchpriority="low"></script>
      {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
        <cart-icon class="casa-header__cart-icon casa-header__cart-icon--border-{{ section.settings.cart_bubble_border_style | default: 'none' }}">
          <button class="casa-header__btn casa-header__cart-btn" aria-label="{{ 'accessibility.cart' | t }}" aria-haspopup="dialog" aria-describedby="cart-bubble-text" onclick="document.querySelector('cart-drawer-component')?.open?.()">
            {%- render 'casa-icon', icon: 'cart', size: 22 -%}
            {%- render 'cart-bubble', limit: 100, live_region: true -%}
          </button>
        </cart-icon>
      {%- else -%}
        <cart-icon class="casa-header__cart-icon casa-header__cart-icon--border-{{ section.settings.cart_bubble_border_style | default: 'none' }}">
          <a href="{{ routes.cart_url }}" class="casa-header__btn casa-header__cart-btn" aria-label="{{ 'accessibility.cart' | t }}" aria-describedby="cart-bubble-text">
            {%- render 'casa-icon', icon: 'cart', size: 22 -%}
            {%- render 'cart-bubble', limit: 100, live_region: true -%}
          </a>
        </cart-icon>
      {%- endif -%}

      {%- comment -%} Mobile menu toggle {%- endcomment -%}
      <button class="casa-header__btn casa-menu-toggle casa-mobile-only" data-casa-drawer-toggle aria-label="Open menu" aria-expanded="false">
        {%- render 'casa-icon', icon: 'menu', size: 22 -%}
      </button>
    </div>

  </div>
</header>

{%- comment -%} ── Mobile Drawer (rendered outside header for z-index stacking) ── {%- endcomment -%}
{%- render 'casa-mobile-drawer',
  menu: section.settings.menu,
  logo_text: section.settings.logo_text,
  logo_image: section.settings.logo_image,
  drawer_logo_image: section.settings.drawer_logo_image,
  drawer_logo_height: section.settings.drawer_logo_height,
  promo_title: section.settings.promo_title,
  promo_subtitle: section.settings.promo_subtitle,
  promo_link: section.settings.promo_link,
  promo_image: section.settings.promo_image,
  video_url: section.settings.video_url,
  mobile_promo_btn_text: section.settings.mobile_promo_btn_text,
  mobile_quick_links_title: section.settings.mobile_quick_links_title,
  submenu_product_limit: section.settings.submenu_product_limit,
  submenu_show_badges_override: section.settings.submenu_show_badges_override,
  submenu_show_badges: section.settings.submenu_show_badges,
  submenu_show_featured: section.settings.submenu_show_featured,
  submenu_show_products: section.settings.submenu_show_products,
  drawer_show_icons: section.settings.drawer_show_icons,
  submenu_show_icons: section.settings.submenu_show_icons,
  mobile_quick_links_html: mobile_quick_links_html,
  drawer_glassmorphic: section.settings.drawer_glassmorphic,
  drawer_secondary_menu: section.settings.drawer_secondary_menu,
  drawer_secondary_title: section.settings.drawer_secondary_title,
  featured_label_support: section.settings.featured_label_support,
  support_title: section.settings.support_title,
  support_description: section.settings.support_description,
  support_email: section.settings.support_email,
  support_phone: section.settings.support_phone,
  support_chat_label: section.settings.support_chat_label,
  support_chat_link: section.settings.support_chat_link,
  support_btn_text: section.settings.support_btn_text,
  support_btn_link: section.settings.support_btn_link
-%}

{%- comment -%} Casa quick-view modal — bound globally so cart drawer upsells can open it {%- endcomment -%}
{% render 'casa-quickview-modal' %}

{%- comment -%} ── Cart Drawer (Horizon's cart-drawer-component for settings.cart_type == 'drawer') ── {%- endcomment -%}
{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  <script src="{{ 'cart-drawer.js' | asset_url }}" type="module" fetchpriority="low"></script>

  {% capture empty_cart_drawer_content %}
    <div class="cart-drawer__header">
      <button
        ref="closeButton"
        on:click="cart-drawer-component/close"
        class="button close-button cart-drawer__close-button button-unstyled"
        aria-label="{{ 'actions.close_dialog' | t }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </button>
    </div>

    <div class="cart-drawer__content" aria-label="{{ 'accessibility.cart' | t }}">
      <div class="sgl-cart-empty-icon" style="margin-bottom: 12px;">
        <svg class="sgl-cart-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.25;">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>
        </svg>
      </div>
      <h2 class="cart-drawer__heading h4 cart-drawer__heading--empty" id="cart-drawer-heading-empty">
        {{ 'content.your_cart_is_empty' | t }}
      </h2>

      <div class="cart-drawer__items">
        {% render 'cart-products', force_empty: true %}
      </div>
    </div>
  {% endcapture %}

  <style>
    /* Hide ALL default empty cart illustrations/circles/placeholders */
    .cart-drawer--empty .cart-drawer__heading--empty::before,
    .cart-drawer--empty .cart-drawer__heading--empty::after,
    .cart-drawer--empty .cart-drawer__content > svg:not(.sgl-cart-icon),
    .cart-drawer--empty .cart-drawer__content > img,
    .cart-drawer--empty .cart-drawer__content > .icon,
    .cart-drawer--empty .cart-drawer__content > div:empty,
    .cart-drawer--empty placeholder-svg,
    .cart-drawer--empty .placeholder-svg,
    .cart-drawer--empty .icon-cart-empty,
    .cart-drawer--empty .cart-drawer__empty-icon,
    .cart-drawer--empty [class*="placeholder"],
    .cart-drawer--empty [class*="empty-icon"],
    .cart-drawer--empty [class*="empty-state"] > svg,
    .cart-drawer--empty [class*="empty-state"] > img {
      display: none !important;
    }
    /* Also hide the grey circle if it's an inline element */
    .cart-drawer--empty .cart-drawer__content::before {
      display: none !important;
    }
    .cart-drawer--empty .cart-drawer__inner::before {
      display: none !important;
    }
  </style>

  <cart-drawer-component
    class="cart-drawer"
    {% if settings.auto_open_cart_drawer %}auto-open{% endif %}
  >
    <template id="empty-cart-template">
      {{ empty_cart_drawer_content }}
    </template>

    <dialog
      ref="dialog"
      class="cart-drawer__dialog dialog-modal dialog-drawer color-{{ settings.drawer_color_scheme }}{% if cart.empty? %} cart-drawer--empty{% endif %}"
      aria-labelledby="{% if cart.empty? %}cart-drawer-heading-empty{% else %}cart-drawer-heading{% endif %}"
      scroll-lock
      cart-summary-sticky="true"
    >
      <div class="cart-drawer__inner" data-hydration-key="cart-drawer-inner">
        {%- comment -%} ═══ Prepare upsell data ═══ {%- endcomment -%}
        {%- assign show_upsells = false -%}
        {%- assign upsell_position = settings.cart_upsell_position | default: 'inside' -%}
        {%- if settings.cart_show_upsell and settings.cart_upsell_collection != blank -%}
          {%- assign upsell_collection = collections[settings.cart_upsell_collection] -%}
          {%- assign upsell_limit = settings.cart_upsell_limit | default: 3 -%}
          {%- comment -%}
            The drawer upsell renders as a vertical list, so cap it at 3 — more
            than that fills the whole drawer (a 6-item list runs ~647px). The
            merchant's cart_upsell_limit setting is left intact; lower values
            (1–2) are still honoured, only higher ones are clamped.
          {%- endcomment -%}
          {%- if upsell_limit > 3 -%}{%- assign upsell_limit = 3 -%}{%- endif -%}
          {%- if upsell_collection and upsell_collection.products.size > 0 -%}
            {%- assign show_upsells = true -%}
          {%- endif -%}
        {%- endif -%}

        {%- comment -%} ═══ Upsell markup capture (reused in either position) ═══ {%- endcomment -%}
        {%- if show_upsells -%}
          {%- capture upsell_html -%}
            <div class="cart-upsell">
              <div class="cart-upsell__header">
                <p class="cart-upsell__title">{{ settings.cart_upsell_title | default: 'You may also like' }}</p>
              </div>
              <div class="cart-upsell__track">
                {%- assign cart_product_ids = cart.items | map: 'product_id' -%}
                {%- assign shown = 0 -%}
                {%- for product in upsell_collection.products -%}
                  {%- if cart_product_ids contains product.id -%}{%- continue -%}{%- endif -%}
                  {%- if shown >= upsell_limit -%}{%- break -%}{%- endif -%}
                  <div class="cart-upsell__item">
                    <a href="{{ product.url }}" class="cart-upsell__image">
                      {%- if product.featured_image != blank -%}
                        <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" loading="lazy" width="60" height="60">
                      {%- endif -%}
                    </a>
                    <div class="cart-upsell__info">
                      <a href="{{ product.url }}" class="cart-upsell__name">{{ product.title | truncate: 28 }}</a>
                      <div class="cart-upsell__buy">
                        <span class="cart-upsell__price">{{ product.price | money_with_currency }}</span>
                        <button
                          type="button"
                          class="cart-upsell__add"
                          aria-label="Add {{ product.title | escape }} to cart"
                          data-upsell-add
                          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                          data-product-url="{{ product.url }}"
                          data-has-variants="{{ product.has_only_default_variant | json }}"
                        >
                          Add
                        </button>
                      </div>
                    </div>
                  </div>
                  {%- assign shown = shown | plus: 1 -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endcapture -%}
        {%- endif -%}

        <cart-items-component class="cart-items-component" data-drawer data-section-id="{{ section.id }}">
          {%- if cart.empty? -%}
            {{ empty_cart_drawer_content }}
          {%- else -%}
            {%- liquid
              assign free_shipping_threshold = settings.free_shipping_threshold | default: 0
              assign always_free_shipping = settings.cart_always_free_shipping
              if free_shipping_threshold > 0 and always_free_shipping == false
                assign cart_total_cents = cart.total_price
                assign threshold_cents = free_shipping_threshold | times: 100
                assign remaining_cents = threshold_cents | minus: cart_total_cents
                assign progress_percent = cart_total_cents | times: 100 | divided_by: threshold_cents
                if progress_percent > 100
                  assign progress_percent = 100
                endif
                assign remaining_amount = remaining_cents | money_without_trailing_zeros
              endif
            -%}
            <div class="cart-drawer__header" id="cart-drawer-header">
              <div class="cart-drawer__header-left">
                <h2 class="cart-drawer__heading h4" id="cart-drawer-heading">
                  {{ 'content.cart_title' | t }}
                  <span class="cart-drawer__count">({{ cart.item_count }})</span>
                </h2>
                {%- if always_free_shipping -%}
                  <div class="cart-drawer__shipping-inline">
                    <span class="cart-drawer__shipping-text cart-drawer__shipping-text--success">
                      ✓ Free shipping on all orders
                    </span>
                  </div>
                {%- elsif free_shipping_threshold > 0 -%}
                  <div class="cart-drawer__shipping-inline">
                    {%- if remaining_cents > 0 -%}
                      <span class="cart-drawer__shipping-text">
                        <strong>{{ remaining_amount }}</strong> to free shipping
                      </span>
                    {%- else -%}
                      <span class="cart-drawer__shipping-text cart-drawer__shipping-text--success">
                        ✓ Free shipping
                      </span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
              <button
                ref="closeButton"
                on:click="cart-drawer-component/close"
                class="button close-button cart-drawer__close-button button-unstyled"
                aria-label="{{ 'actions.close_dialog' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
            {%- if free_shipping_threshold > 0 and always_free_shipping == false -%}
              <div class="cart-drawer__shipping-bar">
                <div class="cart-drawer__shipping-track">
                  <div class="cart-drawer__shipping-progress" style="--progress: {{ progress_percent }}%;"></div>
                </div>
              </div>
            {%- endif -%}

            <scroll-hint class="cart-drawer__content" aria-label="{{ 'accessibility.cart' | t }}" style="--header-height: 60px;">
              <div class="cart-drawer__items">
                {% render 'cart-products' %}

                {%- comment -%} ═══ Upsells - Inside items (when position = inside) ═══ {%- endcomment -%}
                {%- if show_upsells and upsell_position == 'inside' -%}
                  {{ upsell_html }}
                {%- endif -%}
              </div>

              {%- comment -%} ═══ Upsells - Below items (when position = below) ═══ {%- endcomment -%}
              {%- if show_upsells and upsell_position == 'below' -%}
                {{ upsell_html }}
              {%- endif -%}

              <div class="cart-drawer__summary">
                {% render 'cart-summary', section_id: section.id %}

                {%- comment -%}
                  ═══ Minimal Trust Line — below checkout ═══
                  Lives INSIDE the sticky .cart-drawer__summary so it is
                  always on screen with the CHECKOUT button — placed after
                  it in the scroll flow it only surfaced at full scroll,
                  hidden behind the sticky block the rest of the time.
                  The trailing `-%}` on the inner if-tags would eat the
                  space before the literal `·` separator (Liquid trim
                  tags trim INTO the rendered text). Keeping the leading
                  `{%-` to swallow indentation, dropping the trailing
                  `-%}` so " · " survives intact.
                {%- endcomment -%}
                {%- if settings.cart_show_trust_badges -%}
                  <p class="cart-cro__trust">
                    {%- if settings.cart_trust_badge_1 != blank %}{{ settings.cart_trust_badge_1 }}{% endif -%}
                    {%- if settings.cart_trust_badge_2 != blank %} · {{ settings.cart_trust_badge_2 }}{% endif -%}
                    {%- if settings.cart_trust_badge_3 != blank %} · {{ settings.cart_trust_badge_3 }}{% endif -%}
                  </p>
                {%- endif -%}
              </div>
            </scroll-hint>
          {%- endif -%}
        </cart-items-component>
      </div>
    </dialog>
  </cart-drawer-component>
{%- endif -%}

{%- comment -%} ── Localization Drawer (Country/Language selector) ── {%- endcomment -%}
{%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
  {%- liquid
    assign popular_countries = localization.available_countries | where: 'popular?' | sort: 'name'
    assign show_popular = false
    if popular_countries.size > 1 and localization.available_countries.size > 10
      assign show_popular = true
    endif
  -%}
  <div id="casa-localization-drawer" class="casa-locale-drawer">
    <div class="casa-locale-drawer__inner">
      <div class="casa-locale-drawer__header">
        <h2 class="casa-locale-drawer__title">
          {%- render 'casa-icon', icon: 'globe', size: 20 -%}
          Select Your Region
        </h2>
        <button class="casa-locale-drawer__close" type="button" onclick="if(typeof closeLocaleDrawer==='function')closeLocaleDrawer();" aria-label="Close">
          {%- render 'casa-icon', icon: 'close', size: 20 -%}
        </button>
      </div>

      <div class="casa-locale-drawer__content">
        {%- form 'localization', id: 'CasaLocalizationForm', class: 'casa-locale-form', return_to: request.path -%}
          {%- comment -%} Search input for many countries {%- endcomment -%}
          {%- if localization.available_countries.size > 10 -%}
            <div class="casa-locale-search">
              <span class="casa-locale-search__icon">{%- render 'casa-icon', icon: 'search', size: 16 -%}</span>
              <input
                type="text"
                class="casa-locale-search__input"
                placeholder="Search countries..."
                id="casa-country-search"
                autocomplete="off"
              >
            </div>
          {%- endif -%}

          {%- comment -%} Country List {%- endcomment -%}
          <div class="casa-locale-countries" id="casa-country-list">
            {%- if show_popular -%}
              <div class="casa-locale-section">
                <span class="casa-locale-section__label">Popular</span>
                <div class="casa-locale-grid">
                  {%- for country in popular_countries -%}
                    <button
                      type="button"
                      class="casa-locale-country{% if country.iso_code == localization.country.iso_code %} is-selected{% endif %}"
                      data-country-code="{{ country.iso_code }}"
                      data-country-name="{{ country.name | downcase }}"
                    >
                      <span class="casa-locale-country__check">
                        {%- render 'casa-icon', icon: 'check', size: 14 -%}
                      </span>
                      <span class="casa-locale-country__name">{{ country.name }}</span>
                      <span class="casa-locale-country__currency">{{ country.currency.iso_code }} {{ country.currency.symbol }}</span>
                    </button>
                  {%- endfor -%}
                </div>
              </div>
              <div class="casa-locale-section">
                <span class="casa-locale-section__label">All Countries</span>
              </div>
            {%- endif -%}

            <div class="casa-locale-grid" id="casa-all-countries">
              {%- for country in localization.available_countries -%}
                <button
                  type="button"
                  class="casa-locale-country{% if country.iso_code == localization.country.iso_code %} is-selected{% endif %}"
                  data-country-code="{{ country.iso_code }}"
                  data-country-name="{{ country.name | downcase }}"
                >
                  <span class="casa-locale-country__check">
                    {%- render 'casa-icon', icon: 'check', size: 14 -%}
                  </span>
                  <span class="casa-locale-country__name">{{ country.name }}</span>
                  <span class="casa-locale-country__currency">{{ country.currency.iso_code }} {{ country.currency.symbol }}</span>
                </button>
              {%- endfor -%}
            </div>

            <p class="casa-locale-no-results" id="casa-no-results" hidden>No countries found</p>
          </div>

          <input type="hidden" name="country_code" id="casa-country-input" value="{{ localization.country.iso_code }}">

          {%- comment -%} Language Selector {%- endcomment -%}
          {%- if localization.available_languages.size > 1 -%}
            <div class="casa-locale-language">
              <label class="casa-locale-language__label" for="casa-language-select">Language</label>
              <div class="casa-locale-language__select-wrapper">
                <select name="language_code" id="casa-language-select" class="casa-locale-language__select">
                  {%- for language in localization.available_languages -%}
                    <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                      {{ language.endonym_name | capitalize }}
                    </option>
                  {%- endfor -%}
                </select>
                <span class="casa-locale-language__caret">{%- render 'casa-icon', icon: 'chevron-down', size: 16 -%}</span>
              </div>
            </div>
          {%- endif -%}

          {%- comment -%} Submit Button — canonical brand CTA on Ink (Paper bg, Ink text, UPPERCASE Inter 600) {%- endcomment -%}
          <button type="submit" class="btn btn-primary-on-dark casa-locale-submit">
            Update Region
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
  <script>
    (function() {
      const dialog = document.getElementById('casa-localization-drawer');
      const form = document.getElementById('CasaLocalizationForm');
      const countryInput = document.getElementById('casa-country-input');
      const searchInput = document.getElementById('casa-country-search');
      const allCountries = document.getElementById('casa-all-countries');
      const noResults = document.getElementById('casa-no-results');
      const submitBtn = dialog?.querySelector('.casa-locale-submit');

      // ── Manual open/close — bypasses showModal() (broken on iOS) and
      //    moves both dialog + backdrop to <body> so they escape all
      //    stacking contexts from .shopify-section wrappers ──
      var backdrop = null;
      var dialogMovedToBody = false;

      function openLocaleDrawer() {
        if (!dialog) return;
        if (!dialogMovedToBody) {
          document.body.appendChild(dialog);
          dialogMovedToBody = true;
        }
        if (!backdrop) {
          backdrop = document.createElement('div');
          backdrop.className = 'casa-locale-backdrop';
          backdrop.addEventListener('click', closeLocaleDrawer);
        }
        document.body.appendChild(backdrop);
        dialog.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }
      window.closeLocaleDrawer = function() {
        if (!dialog) return;
        dialog.classList.remove('is-open');
        document.body.style.overflow = '';
        if (backdrop && backdrop.parentElement) {
          backdrop.parentElement.removeChild(backdrop);
        }
      };

      // Wire up the locale buttons to open the drawer
      document.querySelectorAll('[aria-label="Country and language"]').forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          const mobileDrawer = document.querySelector('.casa-drawer');
          const overlay = document.querySelector('.casa-drawer-overlay');
          if (mobileDrawer && mobileDrawer.classList.contains('active')) {
            // Use the canonical drawer-close path if available — it
            // removes ALL the state (drawer class, overlay class,
            // body.casa-drawer-active, body.style.overflow). Without
            // removing body.casa-drawer-active the overlay-priority
            // CSS rule keeps the locale drawer visibility: hidden
            // even after is-open is added.
            if (window.CasaNav && typeof window.CasaNav.closeDrawer === 'function') {
              window.CasaNav.closeDrawer();
            } else {
              mobileDrawer.classList.remove('active');
              overlay?.classList.remove('active');
              document.body.classList.remove('casa-drawer-active');
              document.body.style.overflow = '';
            }
            setTimeout(openLocaleDrawer, 350);
          } else {
            openLocaleDrawer();
          }
        });
      });

      // Escape key closes
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && dialog && dialog.classList.contains('is-open')) {
          closeLocaleDrawer();
        }
      });

      // Country selection - auto-submit on click
      dialog?.querySelectorAll('.casa-locale-country').forEach(btn => {
        btn.addEventListener('click', function() {
          const code = this.dataset.countryCode;
          // Update hidden input
          if (countryInput) countryInput.value = code;
          // Update visual selection
          dialog.querySelectorAll('.casa-locale-country').forEach(b => b.classList.remove('is-selected'));
          this.classList.add('is-selected');
          // Show loading state
          if (submitBtn) {
            submitBtn.textContent = 'Updating...';
            submitBtn.disabled = true;
          }
          // Submit the form after brief delay for visual feedback
          setTimeout(() => {
            if (form) form.submit();
          }, 300);
        });
      });

      // Search filtering
      if (searchInput && allCountries) {
        searchInput.addEventListener('input', function() {
          const query = this.value.toLowerCase().trim();
          const buttons = allCountries.querySelectorAll('.casa-locale-country');
          let visibleCount = 0;

          buttons.forEach(btn => {
            const name = btn.dataset.countryName || '';
            const matches = !query || name.includes(query);
            btn.style.display = matches ? '' : 'none';
            if (matches) visibleCount++;
          });

          if (noResults) {
            noResults.hidden = visibleCount > 0;
          }
        });
      }
    })();
  </script>
{%- endif -%}

{%- comment -%} ── Navigation JS ── {%- endcomment -%}
<script defer src="{{ 'casa-navigation.js' | asset_url }}"></script>

{%- comment -%} Store current collection in sessionStorage for breadcrumb tracking {%- endcomment -%}
<script>
(function() {
  var path = window.location.pathname;
  if (!path.match(/^\/collections\/[^/]+/)) return;
  if (path.indexOf('/products/') !== -1) return;
  var KEY = 'casa_last_collection';
  function store() {
    try {
      var handle = path.split('/collections/')[1].replace(/\/$/, '').split('/')[0].split('?')[0];
      var titleEl = document.querySelector('h1, .collection-hero__title, .casa-col-main__title, [data-collection-title]');
      var title = titleEl ? titleEl.textContent.trim() : handle.replace(/-/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); });
      sessionStorage.setItem(KEY, JSON.stringify({ handle: handle, title: title, url: '/collections/' + handle }));
    } catch(e) {}
  }
  if (document.readyState !== 'loading') store();
  else document.addEventListener('DOMContentLoaded', store);
})();
</script>

{%- comment -%} ── Sticky Header + Height CSS Variables ── {%- endcomment -%}
<script>
  (function() {
    var header = document.querySelector('.casa-header');
    if (!header) return;

    // Find the header group container (Shopify wraps header sections in a group)
    // Try multiple selector patterns for compatibility
    var headerGroup = header.closest('[id*="header-group"]') ||
                      header.closest('[id*="section-group"]') ||
                      header.closest('.header-group') ||
                      header.closest('.shopify-section-group-header') ||
                      document.querySelector('#shopify-section-group-header');

    // Fallback: find the outermost shopify-section wrapper
    var sectionWrapper = header.closest('.shopify-section');

    // Set CSS variables for header height (on both body and :root for maximum compatibility)
    // Writes to body/:root invalidate style for the entire document —
    // only touch the properties when the measured value actually changed.
    var lastHeaderH = -1;
    var lastGroupH = -1;
    function updateHeaderHeight() {
      var targetEl = headerGroup || sectionWrapper || header;
      var headerH = header.offsetHeight;
      var groupH = targetEl.offsetHeight;
      if (headerH === lastHeaderH && groupH === lastGroupH) return;
      lastHeaderH = headerH;
      lastGroupH = groupH;

      // Set on body
      document.body.style.setProperty('--header-height', headerH + 'px');
      document.body.style.setProperty('--header-group-height', groupH + 'px');

      // Also set on :root for mega menu access
      document.documentElement.style.setProperty('--header-height', headerH + 'px');
      document.documentElement.style.setProperty('--header-group-height', groupH + 'px');
    }

    // Run immediately
    updateHeaderHeight();

    // Run again after a frame to ensure CSS has been applied
    requestAnimationFrame(function() {
      updateHeaderHeight();
    });

    // Run on window load to ensure all styles are applied
    window.addEventListener('load', updateHeaderHeight);

    // Use ResizeObserver to detect header size changes (e.g., from theme editor)
    // The sticky-pin var must follow too: --casa-chrome-top is what the PDP's
    // sticky columns pin against, and until 2026-09-01 it was only re-synced on
    // window resize — a header group that changed height after load (unequal
    // announcement slides, editor edits, font swap) left the pin stale and
    // opened a white band between the header and the pinned gallery.
    var chromeTopSync = null;
    if (typeof ResizeObserver !== 'undefined') {
      var resizeObserver = new ResizeObserver(function() {
        updateHeaderHeight();
        if (chromeTopSync) chromeTopSync();
      });
      resizeObserver.observe(header);
      if (headerGroup && headerGroup !== header) {
        resizeObserver.observe(headerGroup);
      }
    }

    // Make the header group sticky if enabled
    if (header.classList.contains('casa-header--sticky')) {
      // Apply sticky to the header group if found
      if (headerGroup) {
        headerGroup.style.position = 'sticky';
        headerGroup.style.top = '0';
        headerGroup.style.zIndex = '1000';
      }
      // Also apply to section wrapper for single-section setups
      if (sectionWrapper && sectionWrapper !== headerGroup) {
        sectionWrapper.style.position = 'sticky';
        sectionWrapper.style.top = '0';
        sectionWrapper.style.zIndex = '1000';
      }
      // Ultimate fallback: apply directly to header
      if (!headerGroup && !sectionWrapper) {
        header.style.position = 'sticky';
        header.style.top = '0';
        header.style.zIndex = '1000';
      }

      // No scroll listener for HEIGHT here on purpose: header height never
      // changes from scrolling, and each tick forced two layout reads plus
      // four body/:root custom-property writes mid-scroll. Real size changes
      // (resize, theme editor, announcement edits) are covered by the
      // ResizeObserver above and the resize listener below. (The auto-hide
      // listener added below reads scrollY only — no layout reads, no
      // custom-property writes.)
      window.addEventListener('resize', updateHeaderHeight, { passive: true });

      /* ── Nav auto-hide ────────────────────────────────────────────────
         Merchant 2026-08-13: the promo strip stays pinned, but the nav row
         slides away while reading and returns the moment they scroll up.
         Reclaims 72px of the 100px sticky chrome while browsing.

         CRITICAL — hide with `transform`, NEVER by collapsing height or
         display. `--header-group-height` is measured from offsetHeight and
         feeds `--casa-vh-fit`, which every viewport-fit section sizes
         against; a transform leaves offsetHeight untouched, so nothing
         re-flows. Collapsing the height would resize every one of those
         sections continuously while the page scrolls.

         The nav is deliberately NOT promoted (no will-change / translateZ):
         this repo has a documented fast-scroll bleed from compositing the
         header group. Transform alone, let the browser decide.

         Only runs when the nav is a distinct child of a header GROUP: the
         group owns z-index 1000 against the page, so re-stacking the nav
         (1) under the strip (2) is safe inside that context. Without a
         group the nav IS the stacking root and must not be demoted, so
         auto-hide is skipped and the header behaves exactly as before. */
      var navEl = (sectionWrapper && sectionWrapper !== headerGroup) ? sectionWrapper : header;
      var stripEl = null;
      if (headerGroup) {
        for (var ci = 0; ci < headerGroup.children.length; ci++) {
          if (!headerGroup.children[ci].contains(header)) { stripEl = headerGroup.children[ci]; break; }
        }
      }

      if (headerGroup && navEl !== headerGroup && stripEl) {
        // The nav slides up behind the strip, so the strip must paint over it.
        if (getComputedStyle(stripEl).position === 'static') stripEl.style.position = 'relative';
        stripEl.style.zIndex = '2';
        navEl.style.zIndex = '1';

        var reduceMotionMql = window.matchMedia('(prefers-reduced-motion: reduce)');
        var applyNavTransition = function() {
          navEl.style.transition = reduceMotionMql.matches
            ? 'none'
            : 'transform .28s cubic-bezier(.22, .61, .36, 1)';
        };
        applyNavTransition();
        if (reduceMotionMql.addEventListener) {
          reduceMotionMql.addEventListener('change', applyNavTransition);
        }

        var navHidden = false;
        var lastNavY = window.pageYOffset || 0;
        var navTicking = false;
        var NAV_HIDE_AFTER = 240; // never hide within the first screenful
        var NAV_DELTA = 8;        // hysteresis: trackpad jitter can't flicker it

        // Anything that pins the header's geometry or traps focus must keep
        // the nav on screen: the mega menu is position:fixed anchored to
        // --header-group-height, and the drawers lock the body.
        /* Only a KEYBOARD focus should pin the nav open. Closing the mobile
           drawer correctly returns focus to the burger button - which lives
           inside the nav - so a plain contains(activeElement) test latched
           true and the auto-hide never fired again for the rest of the page
           (measured 2026-08-18: hidden stayed "false" through a full scroll;
           blur that button and hiding resumes immediately). :focus-visible is
           exactly the "focus that deserves a visible ring" signal - true when
           tabbed to, false after a tap - so keyboard users keep the guard and
           a returned focus no longer kills the feature. */
        var focusPinsNav = function() {
          var a = document.activeElement;
          if (!a || !navEl.contains(a)) return false;
          try { return a.matches(':focus-visible'); }
          catch (e) { return true; } // no :focus-visible support -> old behaviour
        };

        var navBlocked = function() {
          return document.body.classList.contains('casa-mega-open') ||
            document.body.classList.contains('casa-drawer-active') ||
            document.body.style.overflow === 'hidden' ||
            focusPinsNav();
        };

        /* --casa-chrome-top = the chrome that is actually ON SCREEN right
           now: the whole group normally, just the promo strip once the nav
           has slid away. Sticky page columns (PDP gallery / details, see
           assets/casa-pdp.css) pin against THIS, so when the nav goes they
           rise to sit under the strip instead of leaving a 72px band of
           empty background where the nav used to be (merchant, 2026-08-13).

           Deliberately a SEPARATE variable from --header-group-height:
           that one stays constant and keeps feeding --casa-vh-fit, so
           section heights never re-flow mid-scroll. Only the pin offset
           moves. */
        var setChromeTop = function(px) {
          document.documentElement.style.setProperty('--casa-chrome-top', px + 'px');
          document.body.style.setProperty('--casa-chrome-top', px + 'px');
        };
        var syncChromeTop = function() {
          setChromeTop(navHidden ? stripEl.offsetHeight : headerGroup.offsetHeight);
        };
        chromeTopSync = syncChromeTop; // ResizeObserver above re-syncs the pin on any real chrome resize
        syncChromeTop();
        window.addEventListener('resize', syncChromeTop, { passive: true });

        /* The nav hides with a TRANSFORM, so the group's box never shrinks -
           that is the whole point (offsetHeight feeds --casa-vh-fit and must
           stay constant). But a box that still exists still HIT-TESTS: with
           the nav slid away the group kept swallowing every tap in the 72px
           desktop / 54px phone band it had vacated, and anything scrolling
           through that band looked tappable while being dead. Measured on
           WebKit 2026-08-18: 18/18 sample points across home, collection, PDP
           and cart returned #header-group, burying the PDP gallery arrow, the
           collection sort select and the mobile Filters button.

           Fix without touching layout: stop the GROUP from hit-testing while
           the nav is hidden and hand hit-testing back to its children, so the
           promo strip stays fully clickable and the off-screen nav (whose box
           has moved out of the band) captures nothing. Restored verbatim on
           reveal by clearing the inline values. */
        var setGroupHitTesting = function(hide) {
          headerGroup.style.pointerEvents = hide ? 'none' : '';
          for (var gi = 0; gi < headerGroup.children.length; gi++) {
            headerGroup.children[gi].style.pointerEvents = hide ? 'auto' : '';
          }
        };

        var setNavHidden = function(hide) {
          if (hide === navHidden) return;
          navHidden = hide;
          navEl.style.transform = hide ? 'translateY(-100%)' : '';
          navEl.setAttribute('data-nav-hidden', hide ? 'true' : 'false');
          setGroupHitTesting(hide);
          syncChromeTop();
        };

        /* The mobile drawer, search and localization panels are all rendered
           INSIDE this section, so they sit inside the stacking context the
           z-index above creates - the drawer asks for 99999 and it can never
           escape. With the nav demoted to 1 they painted UNDER the promo
           strip: the announcement covered the drawer's logo and close button
           on 30/30 hit-test samples (merchant recording, 2026-08-18).

           Only the auto-hide needs the nav below the strip, and the auto-hide
           is suppressed for as long as a drawer is open - so lift the nav back
           over the strip for exactly that window and drop it again on close.
           Reveal explicitly too, rather than leaning on the focusin handler
           happening to fire first. */
        var syncDrawerStacking = function() {
          var drawerOpen = document.body.classList.contains('casa-drawer-active');
          navEl.style.zIndex = drawerOpen ? '3' : '1';
          if (drawerOpen) setNavHidden(false);
        };
        if (typeof MutationObserver !== 'undefined') {
          new MutationObserver(syncDrawerStacking)
            .observe(document.body, { attributes: true, attributeFilter: ['class'] });
        }
        syncDrawerStacking();

        var onNavScroll = function() {
          var y = window.pageYOffset || 0;
          var dy = y - lastNavY;
          // Below the threshold we keep lastNavY so small moves accumulate
          // rather than being discarded — that's what makes it hysteresis
          // and not just a dead zone.
          if (Math.abs(dy) < NAV_DELTA) return;
          lastNavY = y;
          if (navBlocked() || y <= NAV_HIDE_AFTER) { setNavHidden(false); return; }
          setNavHidden(dy > 0);
        };

        window.addEventListener('scroll', function() {
          if (navTicking) return;
          navTicking = true;
          requestAnimationFrame(function() { onNavScroll(); navTicking = false; });
        }, { passive: true });

        // A keyboard user must never tab into an off-screen nav.
        document.addEventListener('focusin', function(e) {
          if (navEl.contains(e.target)) setNavHidden(false);
        });
      }
    }
  })();

  // ── Desktop Mega Menu: Click-toggle with click-outside-to-close ──
  (function() {
    var navItems = document.querySelectorAll('.casa-nav-item');
    if (!navItems.length) return;

    function closeAll() {
      navItems.forEach(function(item) {
        item.classList.remove('is-open');
        var link = item.querySelector('.casa-header__nav-link');
        if (link) link.setAttribute('aria-expanded', 'false');
      });
      // Videos beneath the frost re-blur the panel on every video frame;
      // casa-offscreen-pause gates on body.casa-mega-open (same pattern as
      // the mobile drawer's casa-drawer-active). Refresh on close resumes.
      document.body.classList.remove('casa-mega-open');
      if (window.casa && window.casa.offscreenPauseRefresh) window.casa.offscreenPauseRefresh();
    }

    navItems.forEach(function(item) {
      var link = item.querySelector('.casa-header__nav-link');
      if (!link) return;

      // Prevent navigation — only toggle the mega menu
      link.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var wasOpen = item.classList.contains('is-open');
        // Switching straight from another open panel is NOT the same gesture
        // as opening from closed. Every panel is fixed in the same box, so
        // letting the outgoing fade-out and incoming fade-in run together
        // stacks two translucent Ink surfaces — the composite dips to 69%
        // and the page shows through both mid-swap (the "it minimizes and
        // shows the background" report). body.casa-mega-switching drops the
        // transition for exactly the frame the swap commits in; see the rule
        // in casa-mega-menu.liquid.
        var switching = !wasOpen && !!document.querySelector('.casa-nav-item.is-open');
        if (switching) document.body.classList.add('casa-mega-switching');
        closeAll();
        if (!wasOpen) {
          item.classList.add('is-open');
          link.setAttribute('aria-expanded', 'true');
          document.body.classList.add('casa-mega-open');
          if (window.casa && window.casa.offscreenPauseRefresh) window.casa.offscreenPauseRefresh();
        }
        if (switching) {
          // Commit the transition-less swap in THIS frame before handing
          // transitions back. Without the forced layout read the class
          // removal coalesces into the same style recalc, the panels never
          // see transition:none, and both crossfade exactly as before —
          // same trap as the drawer paint-stall fix (ce5bfc7).
          void item.offsetWidth;
          document.body.classList.remove('casa-mega-switching');
        }
      });
    });

    // Click outside closes any open mega menu
    document.addEventListener('click', function(e) {
      var openItem = document.querySelector('.casa-nav-item.is-open');
      if (!openItem) return;
      // If click is outside the open nav-item (link + mega menu), close it
      if (!openItem.contains(e.target)) {
        closeAll();
      }
    });

    // Scroll closes the menu. The open panel carries a 16px
    // backdrop-filter (was 48px until 2026-07-15 — at 48px the panel
    // layer dropped whole frames even on a STATIC page at 240Hz);
    // page content scrolling beneath it forces a full re-blur of the
    // panel every frame — the 2026-07-09 recording shows the backdrop
    // rendering WHITE behind the panel mid-scroll on a 240Hz display.
    // backdrop-filter isn't in the panel's transition list, so closing
    // drops the blur instantly and the fade-out is cheap opacity only.
    window.addEventListener('scroll', function() {
      if (document.querySelector('.casa-nav-item.is-open')) closeAll();
    }, { passive: true });

    // Escape key closes. Guarded: closeAll() now also clears the video-pause
    // body class and re-gates all governed videos — skip when nothing is open.
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && document.querySelector('.casa-nav-item.is-open')) closeAll();
    });
  })();

  // Upsell Add to Cart / Quick-Buy Handler
  (function() {
    function cartSectionIds() {
      var ids = Array.prototype.map.call(
        document.querySelectorAll('cart-items-component[data-section-id]'),
        function(el) { return el.getAttribute('data-section-id'); }
      ).filter(Boolean);
      return ids.filter(function(id, i) { return ids.indexOf(id) === i; });
    }

    function cartCountFromSections(sections) {
      if (!sections) return null;
      for (var id in sections) {
        if (!Object.prototype.hasOwnProperty.call(sections, id)) continue;
        var doc = new DOMParser().parseFromString(sections[id] || '', 'text/html');
        var count = parseInt((doc.querySelector('[ref="cartItemCount"]') || {}).textContent || '', 10);
        if (!Number.isNaN(count)) return count;
      }
      return null;
    }

    function waitForCartItemsToSettle() {
      return Promise.all(Array.prototype.map.call(document.querySelectorAll('cart-items-component'), function(component) {
        if (component && typeof component.flushPendingCartUpdates === 'function') {
          return component.flushPendingCartUpdates();
        }
      }));
    }

    function directAddToCart(btn, variantId) {
      btn.classList.add('is-loading');
      btn.disabled = true;

      waitForCartItemsToSettle().then(function() {
        var sections = cartSectionIds();
        return fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({
            items: [{ id: parseInt(variantId), quantity: 1 }],
            sections: sections.join(','),
            sections_url: window.location.pathname
          })
        });
      })
      .then(function(response) {
        if (!response.ok) throw new Error('Add to cart failed');
        return response.json();
      })
      .then(function(data) {
        btn.classList.remove('is-loading');
        btn.classList.add('is-success');
        document.dispatchEvent(new CustomEvent('cart:update', {
          bubbles: true,
          detail: {
            resource: data,
            sourceId: 'casa-header-upsell',
            data: {
              source: 'quick-add',
              itemCount: cartCountFromSections(data.sections),
              variantId: variantId,
              sections: data.sections || {}
            }
          }
        }));
        var cartDrawer = document.querySelector('cart-drawer-component');
        if (cartDrawer && typeof cartDrawer.open === 'function') {
          cartDrawer.open();
        }
        setTimeout(function() { btn.classList.remove('is-success'); btn.disabled = false; }, 1200);
      })
      .catch(function(err) {
        console.error('Upsell add error:', err);
        btn.classList.remove('is-loading');
        btn.disabled = false;
      });
    }

    function getOrCreateQuickAdd() {
      // Try to find an existing quick-add-component first
      var qa = document.querySelector('quick-add-component');
      if (qa && typeof qa.fetchProductPage === 'function') return qa;

      // None found or not upgraded — create a temporary hidden one
      // so the browser upgrades it and we can use its methods
      qa = document.createElement('quick-add-component');
      qa.style.display = 'none';
      document.body.appendChild(qa);

      // Wait a tick for custom element upgrade
      return new Promise(function(resolve) {
        requestAnimationFrame(function() {
          if (typeof qa.fetchProductPage === 'function') {
            resolve(qa);
          } else {
            // Custom element not registered — give up
            qa.remove();
            resolve(null);
          }
        });
      });
    }

    function closeCartDrawer() {
      var cartDrawer = document.querySelector('cart-drawer-component');
      if (cartDrawer && typeof cartDrawer.close === 'function') {
        cartDrawer.close();
      }
    }

    function initVariantCarousel() {
      var dialog = document.getElementById('quick-add-dialog');
      if (!dialog) return;
      dialog.querySelectorAll('.variant-option--buttons').forEach(function(fieldset) {
        // Skip if already initialized
        if (fieldset.querySelector('.qa-variant-nav')) return;

        // Create nav wrapper
        var nav = document.createElement('div');
        nav.className = 'qa-variant-nav';
        nav.innerHTML =
          '<button type="button" class="qa-variant-arrow qa-variant-arrow--prev" aria-label="Previous" disabled>' +
            '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>' +
          '</button>' +
          '<button type="button" class="qa-variant-arrow qa-variant-arrow--next" aria-label="Next">' +
            '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 6 15 12 9 18"></polyline></svg>' +
          '</button>';

        // Insert nav into legend (next to the option name)
        var legend = fieldset.querySelector('legend');
        if (legend) {
          legend.style.display = 'flex';
          legend.style.justifyContent = 'space-between';
          legend.style.alignItems = 'center';
          legend.appendChild(nav);
        } else {
          fieldset.insertBefore(nav, fieldset.firstChild);
        }

        var prevBtn = nav.querySelector('.qa-variant-arrow--prev');
        var nextBtn = nav.querySelector('.qa-variant-arrow--next');

        function updateArrows() {
          prevBtn.disabled = fieldset.scrollLeft <= 2;
          nextBtn.disabled = fieldset.scrollLeft + fieldset.offsetWidth >= fieldset.scrollWidth - 2;
        }

        prevBtn.addEventListener('click', function(e) {
          e.preventDefault();
          var card = fieldset.querySelector('.variant-option__button-label');
          if (card) fieldset.scrollBy({ left: -(card.offsetWidth + 8), behavior: 'smooth' });
        });

        nextBtn.addEventListener('click', function(e) {
          e.preventDefault();
          var card = fieldset.querySelector('.variant-option__button-label');
          if (card) fieldset.scrollBy({ left: card.offsetWidth + 8, behavior: 'smooth' });
        });

        fieldset.addEventListener('scroll', updateArrows, { passive: true });
        // Delay initial check to let flex layout settle
        setTimeout(updateArrows, 100);
      });
    }

    function openQuickBuy(btn, productUrl) {
      btn.classList.add('is-loading');
      btn.disabled = true;

      // Close the cart drawer so the Casa quick-view modal can take focus on mobile
      closeCartDrawer();

      // Fire the Casa quick-view modal (lightweight — renders option pickers inline,
      // fetches product.js not the full product page, dispatches cart:update so the
      // drawer re-renders after Add).
      if (window.__casaQuickViewBound) {
        window.dispatchEvent(new CustomEvent('quickview:open', {
          detail: { productUrl: productUrl }
        }));
      } else {
        // Shouldn't happen — the modal snippet is rendered from casa-header — but
        // if the JS somehow hasn't bound yet, fall back to the product page.
        window.location.href = productUrl;
      }

      setTimeout(function() {
        btn.classList.remove('is-loading');
        btn.disabled = false;
      }, 300);
    }

    function manualQuickBuy(btn, productUrl) {
      // Fallback: fetch product page HTML and inject into modal manually
      return fetch(productUrl)
        .then(function(r) { return r.text(); })
        .then(function(html) {
          var parser = new DOMParser();
          var doc = parser.parseFromString(html, 'text/html');
          var productGrid = doc.querySelector('[data-product-grid-content]');

          if (!productGrid) {
            window.location.href = productUrl;
            return;
          }

          var modalContent = document.getElementById('quick-add-modal-content');
          if (modalContent) {
            modalContent.innerHTML = productGrid.outerHTML;

            // Fix slideshow: set first slide visible
            modalContent.querySelectorAll('slideshow-slide').forEach(function(slide, i) {
              slide.setAttribute('aria-hidden', i === 0 ? 'false' : 'true');
            });
            // Force images to load
            modalContent.querySelectorAll('img').forEach(function(img) {
              img.loading = 'eager';
            });
            // Upgrade custom elements
            if (customElements.upgrade) customElements.upgrade(modalContent);
          }

          var dialogComponent = document.getElementById('quick-add-dialog');
          if (dialogComponent && typeof dialogComponent.showDialog === 'function') {
            dialogComponent.showDialog();
          } else {
            var dialog = dialogComponent ? dialogComponent.querySelector('dialog') : null;
            if (dialog && !dialog.open) dialog.showModal();
          }

          setTimeout(initVariantCarousel, 200);
          btn.classList.remove('is-loading');
          btn.disabled = false;
        })
        .catch(function() {
          window.location.href = productUrl;
        });
    }

    document.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-upsell-add]');
      if (!btn) return;

      e.preventDefault();
      e.stopPropagation();

      var hasOnlyDefault = btn.dataset.hasVariants === 'true'; // data-has-variants stores has_only_default_variant
      var productUrl = btn.dataset.productUrl;
      var variantId = btn.dataset.variantId;

      if (hasOnlyDefault || !productUrl) {
        // Single-variant product: add directly to cart
        if (!variantId) return;
        directAddToCart(btn, variantId);
      } else {
        // Multi-variant product: open quick-buy modal
        openQuickBuy(btn, productUrl);
      }
    });
  })();

  // (Upsell carousel-navigation JS removed — the drawer upsell is now a static
  // vertical list; no scroll arrows, so no carousel JS is needed. The
  // add-to-cart handler for [data-upsell-add] lives above and is unaffected.)
</script>

<script>
  /* ─────────────────────────────────────────────────────────────────
     MEGA MENU video lazy-load — saves ~15 MB on cold homepage load.

     casa-mega-menu.liquid renders one or two .casa-mega-featured-video
     elements per top-level nav link configured with a promo or
     lifestyle video URL. The menus are hidden via opacity:0 +
     visibility:hidden until the user hovers the parent nav link.
     Without lazy-load, every <video src> auto-fetched its MP4 on page
     load regardless of menu visibility — costing 15 MB on the trace.

     Strategy: emit videos with preload="none" and data-src instead of
     src. First pointerover (hover or touch-with-mouse) on the header
     nav swaps data-src → src across all data-casa-mega-lazy-video
     elements, then calls .load() so they're ready when the menu opens.
     Mobile users without a hover-capable pointer never trigger the
     load — videos stay unfetched forever (mobile drawer doesn't
     contain video anyway).

     Save-Data / 2G / prefers-reduced-motion: bail out entirely and
     remove the <video> elements; the menu still renders the featured
     card with its image or text placeholder, no degradation.
     ───────────────────────────────────────────────────────────────── */
  (function() {
    if (window.__casaMegaVideoLazyInit) return;
    window.__casaMegaVideoLazyInit = true;

    var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var saveData = (navigator.connection && navigator.connection.saveData) === true;
    var slowNet = navigator.connection && /2g|slow-2g/.test(navigator.connection.effectiveType || '');

    function getVideos() {
      return document.querySelectorAll('video[data-casa-mega-lazy-video]');
    }

    if (reducedMotion || saveData || slowNet) {
      getVideos().forEach(function(v) { v.remove(); });
      return;
    }

    /* iOS Safari rejects programmatic muted autoplay unless the muted/inline
       PROPERTIES (not just the HTML attributes) are set before play() is
       called on a JS-assigned src. The mega-menu featured videos are
       decorative loop+muted previews (no controls, no sound) revealed on
       menu hover/focus, so this is the same bug as casa-hero — without it the
       video stays paused and iOS paints its native centre play button.
       Re-assert at play time too; some iOS builds drop the muted flag. */
    function tryPlay(v) {
      v.muted = true;
      v.playsInline = true;
      var p = v.play();
      if (p && p.catch) p.catch(function() {});
    }

    function loadAllMegaVideos() {
      getVideos().forEach(function(v) {
        if (v.dataset.casaMegaLoaded) return;
        v.dataset.casaMegaLoaded = '1';
        v.muted = true;
        v.defaultMuted = true;
        v.playsInline = true;
        v.setAttribute('muted', '');
        v.setAttribute('playsinline', '');
        v.setAttribute('webkit-playsinline', '');
        v.querySelectorAll('source[data-src]').forEach(function(s) {
          if (!s.src) s.src = s.dataset.src;
        });
        /* metadata only — dimensions + first frame get ready, but the MP4
           body isn't fetched (and the video is NOT played) until its menu
           actually opens. The old code played every mega video here on the
           first cursor pass over the nav: the menus are opacity:0 +
           visibility:hidden, but a hidden playing video still DECODES — N
           looping 1080p decoders for the rest of the session, feeding the
           scroll jitter. */
        v.preload = 'metadata';
        v.load();
      });
      syncMenuPlayback();
    }

    /* Playback follows the menu's is-open class — the same signal the CSS
       uses to reveal .casa-mega-menu (its ONLY reveal rule), so play/pause
       exactly tracks what the user can see. These are interaction-driven
       videos: per the casa-offscreen-pause contract they must NOT carry
       data-casa-pause — geometry can't see menu visibility (a closed menu's
       rect still sits inside the viewport). */
    function syncMenuPlayback() {
      getVideos().forEach(function(v) {
        var item = v.closest('.casa-nav-item');
        var open = item && item.classList.contains('is-open') && !document.hidden;
        if (open) {
          /* Restart from the top whenever playback (re)starts. Safari can
             refuse a gesture-less resume play() (per-site "Never Auto-Play",
             Low Power Mode, background-tab return) and would otherwise park
             the video on whatever mid-reel frame it paused at — the reel
             spends ~half its loop with the mirror composed off-centre. The
             asset's frame 0 is the centered head-on beat, so first paint
             (preload=metadata), every menu open, and any refused-play
             resting state all show the hero composition. */
          if (v.paused && v.currentTime > 0 && v.readyState >= 1) v.currentTime = 0;
          tryPlay(v);
        }
        else if (!v.paused) v.pause();
      });
    }

    var nav = document.querySelector('.casa-header__nav');
    if (!nav) return;

    /* Watch is-open on the nav items that own a mega video. attributeFilter
       keeps this observer silent except on actual menu open/close. */
    if ('MutationObserver' in window) {
      var itemObserver = new MutationObserver(syncMenuPlayback);
      nav.querySelectorAll('.casa-nav-item').forEach(function(item) {
        if (item.querySelector('video[data-casa-mega-lazy-video]')) {
          itemObserver.observe(item, { attributes: true, attributeFilter: ['class'] });
        }
      });
    }
    /* Tab hidden with a menu open: mouseout never fires — pause explicitly. */
    document.addEventListener('visibilitychange', syncMenuPlayback);

    /* pointerover bubbles, fires once on first cursor entry, then
       removes itself. Covers mouse, pen, and stylus on touch devices
       that emit pointer events (iPad with trackpad, etc). Pure-touch
       mobile users emit pointerdown/pointerup but not pointerover —
       which is what we want: those users never hover the menu open,
       so they never need the videos. */
    nav.addEventListener('pointerover', loadAllMegaVideos, { once: true });

    /* Keyboard accessibility: also load on first focus inside the nav.
       A keyboard user tabbing through the nav links would otherwise
       never trigger the videos. */
    nav.addEventListener('focusin', loadAllMegaVideos, { once: true });
  })();
</script>

{%- comment -%} ── CSS Custom Properties from Settings ── {%- endcomment -%}
{%- liquid
  assign header_bg = section.settings.header_bg_color | default: '#0A0A0F'
