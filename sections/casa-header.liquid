{% style %}
  /* Global sizing variables - accessible to mega menu & drawer */
  :root {
    --casa-header-height: {{ header_height }}px;
    --casa-logo-height: {{ logo_height }}px;

    /* Anchor-offset fallbacks read by html { scroll-padding-top } in base.css.
       Emitted here with the merchant's real configured header_height so a cold
       deep-link (e.g. /policies/shipping-policy#returns) lands correctly BEFORE
       the header JS runs. The JS overrides both on :root once it measures the
       live pinned height (which also folds in the announcement bar). */
    --header-height: {{ header_height }}px;
    --header-group-height: {{ header_height }}px;

    /* Glassmorphic Drawer Controls (on :root so drawer/submenu can inherit) */
    --casa-glass-tint: {{ glass_tint }};
    --casa-glass-tint-rgb: {{ glass_tint | color_extract: 'red' }}, {{ glass_tint | color_extract: 'green' }}, {{ glass_tint | color_extract: 'blue' }};
    --casa-glass-opacity: {{ glass_opacity_decimal }};
    --casa-glass-blur: {{ glass_blur }}px;
    --casa-glass-text: {{ glass_text }};
    --casa-glass-text-rgb: {{ glass_text | color_extract: 'red' }}, {{ glass_text | color_extract: 'green' }}, {{ glass_text | color_extract: 'blue' }};
    --casa-glass-text-muted: {{ glass_text_muted }};
    --casa-glass-text-muted-rgb: {{ glass_text_muted | color_extract: 'red' }}, {{ glass_text_muted | color_extract: 'green' }}, {{ glass_text_muted | color_extract: 'blue' }};
    --casa-glass-icon-bg: {{ glass_icon_bg }};
    --casa-glass-icon-bg-rgb: {{ glass_icon_bg | color_extract: 'red' }}, {{ glass_icon_bg | color_extract: 'green' }}, {{ glass_icon_bg | color_extract: 'blue' }};
    --casa-glass-icon-active: {{ glass_icon_active }};
    --casa-glass-icon-active-rgb: {{ glass_icon_active | color_extract: 'red' }}, {{ glass_icon_active | color_extract: 'green' }}, {{ glass_icon_active | color_extract: 'blue' }};
    --casa-glass-border: {{ glass_border }};
    --casa-glass-border-rgb: {{ glass_border | color_extract: 'red' }}, {{ glass_border | color_extract: 'green' }}, {{ glass_border | color_extract: 'blue' }};
    --casa-glass-card-bg: {{ glass_card_bg }};
    --casa-glass-card-bg-rgb: {{ glass_card_bg | color_extract: 'red' }}, {{ glass_card_bg | color_extract: 'green' }}, {{ glass_card_bg | color_extract: 'blue' }};
    --casa-glass-btn-bg: {{ glass_btn_bg }};
    --casa-glass-btn-text: {{ glass_btn_text }};

    /* Submenu price typography (used in casa-submenu-panel "Popular in X" list).
       Lives on :root because the submenu panel renders OUTSIDE the .casa-header
       element, so .casa-header-scoped variables don't reach it. */
    --casa-submenu-price-size: {{ section.settings.submenu_price_size | default: 13 }}px;
    --casa-submenu-compare-price-size: {{ section.settings.submenu_compare_price_size | default: 11 }}px;
    --casa-submenu-price-weight: {{ section.settings.submenu_price_weight | default: 600 }};
  }

  .casa-header {
    /* Typography */
    --casa-logo-weight: {{ logo_weight }};
    --casa-logo-spacing: {{ logo_spacing }}px;
    --casa-nav-weight: {{ nav_weight }};
    --casa-nav-size: {{ nav_size }}px;

    /* Header Colors */
    --casa-header-bg: {{ header_bg | color_modify: 'alpha', header_bg_opacity }};
    --casa-header-border: {{ header_border | color_modify: 'alpha', header_border_opacity }};
    --casa-header-text: {{ header_text }};
    --casa-header-text-muted: {{ header_text | color_modify: 'alpha', header_text_opacity }};
    --casa-cart-bubble-bg: {{ section.settings.cart_bubble_bg | default: '#B0C3FA' }};
    --casa-cart-bubble-text: {{ section.settings.cart_bubble_text | default: '#FAFAF7' }};
    --casa-cart-bubble-border: {{ section.settings.cart_bubble_border_color | default: '#B0C3FA' }};

    /* Mega Menu Colors */
    --casa-mega-bg: {{ mega_bg | color_modify: 'alpha', mega_bg_opacity }};
    --casa-mega-border: {{ mega_border | color_modify: 'alpha', 0.1 }};

    /* Glow Variant Accents */
    --casa-glow-primary: {{ glow_primary }};
    --casa-glow-secondary: {{ glow_secondary }};
    --casa-glow-primary-rgb: {{ glow_primary | color_extract: 'red' }}, {{ glow_primary | color_extract: 'green' }}, {{ glow_primary | color_extract: 'blue' }};
    --casa-glow-secondary-rgb: {{ glow_secondary | color_extract: 'red' }}, {{ glow_secondary | color_extract: 'green' }}, {{ glow_secondary | color_extract: 'blue' }};

    /* Lifestyle Variant Accents */
    --casa-lifestyle-primary: {{ lifestyle_primary }};
    --casa-lifestyle-secondary: {{ lifestyle_secondary }};
    --casa-lifestyle-primary-rgb: {{ lifestyle_primary | color_extract: 'red' }}, {{ lifestyle_primary | color_extract: 'green' }}, {{ lifestyle_primary | color_extract: 'blue' }};
    --casa-lifestyle-secondary-rgb: {{ lifestyle_secondary | color_extract: 'red' }}, {{ lifestyle_secondary | color_extract: 'green' }}, {{ lifestyle_secondary | color_extract: 'blue' }};

    /* Support Variant Accents */
    --casa-support-primary: {{ support_primary }};
    --casa-support-secondary: {{ support_secondary }};
    --casa-support-primary-rgb: {{ support_primary | color_extract: 'red' }}, {{ support_primary | color_extract: 'green' }}, {{ support_primary | color_extract: 'blue' }};
    --casa-support-secondary-rgb: {{ support_secondary | color_extract: 'red' }}, {{ support_secondary | color_extract: 'green' }}, {{ support_secondary | color_extract: 'blue' }};

    /* Drawer Colors */
    --casa-drawer-bg: {{ drawer_bg }};
    --casa-drawer-accent: {{ drawer_accent }};
    --casa-drawer-accent-rgb: {{ drawer_accent | color_extract: 'red' }}, {{ drawer_accent | color_extract: 'green' }}, {{ drawer_accent | color_extract: 'blue' }};

    /* Primary accent (used for cart badge, etc) */
    --casa-accent-primary: {{ glow_primary }};
  }

  /* ── Cart Drawer CSS Variables (must be in <style> for Liquid processing) ── */
  {%- liquid
    assign cart_accent = section.settings.cart_accent_primary | default: '#B0C3FA'
    assign cart_accent_secondary = section.settings.cart_accent_secondary | default: '#B0C3FA'
    assign cart_bg = section.settings.cart_bg_color | default: '#FAFAF7'
    assign cart_text = section.settings.cart_text_color | default: '#1f2937'
    assign cart_border = section.settings.cart_border_color | default: '#e5e7eb'
    assign cart_accent_rgb = cart_accent | color_to_rgb | remove: 'rgb(' | remove: ')'
  -%}
  :root {
    --cart-drawer-accent: {{ cart_accent }};
    --cart-drawer-accent-secondary: {{ cart_accent_secondary }};
    --cart-drawer-accent-rgb: {{ cart_accent_rgb }};
    --cart-drawer-bg: {{ cart_bg }};
    --cart-drawer-border: {{ cart_border }};
    --cart-drawer-text: {{ cart_text }};
  }
{% endstyle %}

{% stylesheet %}
  /* ── Section Group & Wrapper ── */
  /* Sticky is applied via JavaScript when enable_sticky is true */
  .casa-header-section {
    position: relative;
    z-index: 1000;
  }

  /* NOTE: do NOT promote #header-group with will-change / transform / contain
     / isolation to "fix" scroll jank. Any of those makes the group a
     BACKDROP-ROOT, and the nested position:fixed mega-menu's backdrop-filter
     (blur 48px) then has nothing to sample and renders SEE-THROUGH — regressed
     the frosted dropdown 2026-07-05, reverted. The fast-scroll header
     bleed-through was fixed by cutting compositor load (backdrop-filter off
     hidden UI chrome, assets/casa-base.css), NOT by promoting this group. */

  /* ── Header Container ── */
  .casa-header {
    padding: 0 clamp(20px, 4vw, 60px);
    height: var(--casa-header-height, 80px);
    display: flex;
    align-items: center;
    z-index: 1000;
    position: relative;
  }

  /* Border - static */
  .casa-header--border-static {
    border-bottom: 1px solid var(--casa-header-border, rgba(255, 255, 255, 0.08));
  }

  /* Border — animated gradient.
     GPU-composited via transform, NOT background-position — Ignacio's
     2026-05-18 flicker fix (matches casa-announcement's casa-an-shimmer).
     Animating background-position forces a full repaint every frame (the
     browser can't promote it to a GPU layer); the gradient stutters as it
     slides = the visible flicker. transform: translateX on an oversized
     child layer is compositor-only (zero paint) — same shimmer, no flicker.
     The .casa-header__border-anim wrapper supplies the overflow clip so the
     sticky <header> itself is never clipped (clipping it would trap the
     position:fixed mega-menu and the sticky header group). */
  .casa-header__border-anim {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }
  .casa-header__border-anim::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 300%;
    background: linear-gradient(90deg,
      var(--casa-glow-primary, #B0C3FA),
      var(--casa-glow-secondary, #5E0A02),
      var(--casa-support-primary, #F2FFA0),
      var(--casa-glow-secondary, #5E0A02),
      var(--casa-glow-primary, #B0C3FA));
    will-change: transform;
    /* perf-justified: transform is compositor-only (zero per-frame paint);
       always-visible header chrome, no closed state to gate a play-state on. */
    animation: casa-border-shimmer 4s linear infinite;
  }

  @keyframes casa-border-shimmer {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-66.6667%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .casa-header__border-anim::before { animation: none; }
  }

  /* Header background layer (kept on ::before so it does not create a
     containing block for the position:fixed mega menu).

     NO backdrop-filter — deliberately removed 2026-07-05. Two reasons:
     (1) The header bg resolves fully OPAQUE (--casa-header-bg =
         rgb(10,10,15) at every scroll position), so a blur sitting behind
         an opaque layer is invisible — it rendered nothing.
     (2) `will-change: backdrop-filter` promoted this pseudo to its own
         compositor layer, which intermittently DROPPED its paint over the
         page's constantly-repainting content (bg videos + header shimmers)
         — flashing the header see-through on real GPUs (Chrome / high-
         refresh): the merchant's "header shows what's below, then not"
         report. Supersedes the 2026-05-17 blur-20→10 + will-change
         mitigation, which only REDUCED that flicker (Ignacio's Class 1).
     Removing the filter is zero visual change on an opaque bar and makes
     the see-through flicker physically impossible. A translucent frosted
     header would reintroduce backdrop-filter, which is inherently flicker-
     prone over the animated content behind THIS header — use a near-opaque
     bg, not a blurred pseudo, if that look is ever wanted. */
  .casa-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--casa-header-bg, rgb(10, 10, 15));
    z-index: -1;
  }
  .casa-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
  }

  /* Widescreen layout - full width, no max-width constraint */
  .casa-header--widescreen .casa-header__inner {
    max-width: none;
  }

  /* Uppercase nav links */
  .casa-header--nav-uppercase .casa-header__nav-link {
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* ── Left: Logo + Nav ── */
  .casa-header__left {
    display: flex;
    align-items: center;
    align-self: stretch;
    gap: clamp(12px, 2vw, 60px);
    min-width: 0;
  }

  .casa-header__logo {
    font-size: 22px;
    font-weight: var(--casa-logo-weight, 300);
    letter-spacing: var(--casa-logo-spacing, 4px);
    text-decoration: none;
    color: var(--casa-header-text, white);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .casa-header__logo-img {
    height: var(--casa-logo-height, 36px);
    width: auto;
    min-height: 24px;
    flex-shrink: 0;
  }

  /* ── Desktop Navigation ── */
  .casa-header__nav {
    display: flex;
    gap: clamp(6px, 1.5vw, 40px);
    align-items: center;
    align-self: stretch;
    white-space: nowrap;
  }

  .casa-nav-item {
    /* position:relative for the hover bridge — mega menu uses position:fixed so unaffected */
    position: relative;
    display: flex;
    align-items: center;
    align-self: stretch;
  }
  /* Invisible bridge below the nav item — keeps hover alive as mouse
     moves from nav link down to the mega menu panel.
     Extended to provide generous buffer zone. */
  .casa-nav-item::after {
    content: '';
    position: absolute;
    left: -50px;
    right: -50px;
    top: 100%;
    height: 80px;
    pointer-events: none;
  }
  .casa-nav-item.is-open::after {
    pointer-events: auto;
  }

  .casa-header__nav-link {
    text-decoration: none;
    color: var(--casa-header-text-muted, rgba(255, 255, 255, 0.85));
    font-size: clamp(11px, 1vw, var(--casa-nav-size, 14px));
    font-weight: var(--casa-nav-weight, 500);
    transition: color 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 8px 0;
    white-space: nowrap;
  }
  .casa-header__nav-link:hover {
    color: var(--casa-header-text, white);
  }
  .casa-header__nav-link svg {
    opacity: 0.5;
    transition: transform 0.2s;
  }
  .casa-nav-item.is-open .casa-header__nav-link {
    color: var(--casa-header-text, white);
  }
  .casa-nav-item.is-open .casa-header__nav-link svg {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* ── Right: Actions ── */
  .casa-header__actions {
    display: flex;
    gap: clamp(4px, 1vw, 20px);
    align-items: center;
    flex-shrink: 0;
    margin-left: clamp(8px, 1.5vw, 24px);
  }

  .casa-header__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--casa-header-text-muted, rgba(255, 255, 255, 0.7));
    cursor: pointer;
    transition: color 0.2s;
    /* 44x44 minimum hit area (Apple HIG / Google MWG mobile tap target).
       The icon SVG size is unchanged — only the tappable box grows via
       padding + min dimensions, so the header looks identical but the
       search/account/cart icons are no longer a 28px fat-finger target. */
    padding: 10px;
    position: relative;
    min-width: 44px;
    min-height: 44px;
    flex-shrink: 0;
  }

  /* Casa-styled cart count bubble */
  .casa-header__cart-icon .cart-bubble__background {
    background: var(--casa-cart-bubble-bg, #B0C3FA);
  }
  .casa-header__cart-icon .cart-bubble__text {
    color: var(--casa-cart-bubble-text, #ffffff);
  }

  /* Hide bubble decoration when there's no count */
  .casa-header__cart-icon:has(.cart-bubble__text-count:empty) .cart-bubble::before,
  .casa-header__cart-icon:has(.cart-bubble.visually-hidden) .cart-bubble::before,
  .casa-header__cart-icon--border-none .cart-bubble::before {
    display: none;
  }

  /* Static ring */
  .casa-header__cart-icon--border-static .cart-bubble {
    box-shadow: 0 0 0 2px var(--casa-cart-bubble-border, #B0C3FA);
  }

  /* Pulse ring — soft expanding halo */
  .casa-header__cart-icon--border-pulse .cart-bubble::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 2px solid var(--casa-cart-bubble-border, #B0C3FA);
    /* perf-justified: the empty-cart block above display:none's this
       ::before, so the keyframes only tick while the badge is visible. */
    animation: casa-bubble-pulse 1.6s ease-out infinite;
    pointer-events: none;
  }
  @keyframes casa-bubble-pulse {
    0%   { transform: scale(1);   opacity: 0.85; }
    70%  { transform: scale(1.6); opacity: 0;    }
    100% { transform: scale(1.6); opacity: 0;    }
  }

  /* Rotating gradient — conic spin */
  .casa-header__cart-icon--border-rotate .cart-bubble::before {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      var(--casa-cart-bubble-border, #B0C3FA),
      #5E0A02,
      #F2FFA0,
      var(--casa-cart-bubble-border, #B0C3FA)
    );
    /* perf-justified: the empty-cart block above display:none's this
       ::before, so the keyframes only tick while the badge is visible. */
    animation: casa-bubble-rotate 3s linear infinite;
    z-index: -1;
    pointer-events: none;
  }
  .casa-header__cart-icon--border-rotate .cart-bubble {
    isolation: isolate;
  }
  @keyframes casa-bubble-rotate {
    to { transform: rotate(360deg); }
  }

  /* Glow halo — slow breathing shadow */
  .casa-header__cart-icon--border-glow .cart-bubble {
    /* perf-justified: gated by the empty-cart rule below — the box-shadow
       keyframes only tick while the badge is actually visible. */
    animation: casa-bubble-glow 2.4s ease-in-out infinite;
  }
  /* Glow animates the bubble itself, not ::before, so the empty-cart
     display:none block above doesn't cover it — without this gate the
     box-shadow keyframes tick forever on the clipped .visually-hidden
     bubble. Mirrors the :has() pattern used for pulse/rotate above. */
  .casa-header__cart-icon--border-glow:has(.cart-bubble.visually-hidden) .cart-bubble {
    animation: none;
  }
  @keyframes casa-bubble-glow {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--casa-cart-bubble-border, #B0C3FA) 60%, transparent); }
    50%      { box-shadow: 0 0 0 6px color-mix(in srgb, var(--casa-cart-bubble-border, #B0C3FA) 0%,  transparent); }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .casa-header__cart-icon--border-pulse .cart-bubble::before,
    .casa-header__cart-icon--border-rotate .cart-bubble::before,
    .casa-header__cart-icon--border-glow .cart-bubble {
      animation: none;
    }
  }
  .casa-header__btn svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }
  .casa-header__btn:hover {
    color: var(--casa-header-text, white);
  }

  /* Cart count badge */
  .casa-header__cart-count {
    position: absolute;
    top: -4px;
    right: -8px;
    min-width: 18px;
    height: 18px;
    background: var(--casa-accent-primary, #B0C3FA);
    color: white;
    font-size: 10px;
    font-weight: 600;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
  }
  .casa-header__cart-count:empty,
  .casa-header__cart-count[data-cart-count="0"] {
    display: none;
  }

  /* Account avatar (logged-in user initial) */
  .casa-header__account-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--casa-glow-primary, #B0C3FA), var(--casa-glow-secondary, #5E0A02));
    color: white;
    font-size: 12px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    text-transform: uppercase;
  }
  .casa-header__account-btn:hover .casa-header__account-avatar {
    box-shadow: 0 0 12px rgba(var(--casa-glow-primary-rgb, 176, 195, 250), 0.5);
  }

  /* Locale/Currency selector button */
  .casa-header__locale-btn {
    gap: 4px;
    padding: 5px 10px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    font-size: 11px;
    font-weight: 500;
    transition: all 0.2s;
  }
  .casa-header__locale-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }
  .casa-header__locale-text {
    letter-spacing: 0.5px;
  }

  /* ── Responsive Utilities ── */
  .casa-desktop-only { display: flex; }
  .casa-mobile-only { display: none; }

  /* ── Mobile/Tablet: Switch to hamburger menu under 1100px ──
     Threshold tuned in-browser (preview 152924782746, EUR): with the
     current 7-item nav the last link ("Rewards") collides with the
     currency selector at ~1073px and the layout settles to a stable
     ~17px clearance from ~1100px up. Switching to the burger at
     ≤1099px clears the overlap band (1000–1073px) with real breathing
     room. If the menu gains/loses items or labels change length,
     re-measure (see git history for this comment). ── */
  @media (max-width: 1099px) {
    .casa-header {
      padding: 0 20px;
      height: calc(var(--casa-header-height, 80px) * 0.85);
    }

    .casa-header__inner {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: flex-end;
    }

    /* Hamburger pinned to the left edge */
    .casa-menu-toggle {
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
    }

    /* Logo centered — constrained so it can't overlap side elements */
    .casa-header__left {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      justify-content: center;
      gap: 0;
      max-width: calc(100% - 180px);
    }

    .casa-header__logo {
      font-size: 18px;
      letter-spacing: calc(var(--casa-logo-spacing, 4px) * 0.85);
    }
    .casa-header__logo-img {
      height: calc(var(--casa-logo-height, 36px) * 0.89);
      min-height: 28px;
    }

    /* Action icons pushed to the right */
    .casa-header__actions {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .casa-desktop-only { display: none !important; }
    .casa-mobile-only { display: flex !important; }
  }

  /* ── Small mobile (under 480px) ── */
  @media (max-width: 479px) {
    .casa-header {
      padding: 0 14px;
      height: calc(var(--casa-header-height, 80px) * 0.75);
    }

    .casa-header__left {
      max-width: calc(100% - 140px);
    }

    .casa-header__logo {
      font-size: 16px;
      letter-spacing: calc(var(--casa-logo-spacing, 4px) * 0.75);
    }
    .casa-header__logo-img {
      height: calc(var(--casa-logo-height, 36px) * 0.78);
      min-height: 24px;
    }

    .casa-header__actions { gap: 10px; }

    .casa-header__btn svg {
      width: 20px;
      height: 20px;
    }
  }

  /* ── Tight Desktop (1100–1399px) — compact logo (locale stays visible) ── */
  @media (min-width: 1100px) and (max-width: 1399px) {
    .casa-header__logo {
      font-size: 18px;
      letter-spacing: calc(var(--casa-logo-spacing, 4px) * 0.75);
    }
    .casa-header__logo-img {
      height: calc(var(--casa-logo-height, 36px) * 0.85);
    }
  }

  /* ── Mid Desktop (1200px+) — restore icon sizing ── */
  @media (min-width: 1200px) {
    .casa-header__btn svg {
      width: 22px;
      height: 22px;
    }
  }

  /* ── Large Desktop (1600px+) — generous spacing ── */
  @media (min-width: 1600px) {
    .casa-header {
      padding: 0 80px;
    }

    .casa-header__nav {
      gap: 48px;
    }

    .casa-header__actions {
      gap: 20px;
    }

    .casa-header__locale-btn {
      font-size: 12px;
      padding: 6px 12px;
      gap: 6px;
    }
  }

  /* ══════════════════════════════════════════════════════════════════════════
     CART DRAWER STYLES - SUPERCHARGED CASA EDITION
     Premium glassmorphism drawer with enhanced UX features
     ══════════════════════════════════════════════════════════════════════════ */
  .cart-drawer {
    --cart-drawer-padding: 20px 24px;
    --cart-drawer-padding-desktop: 24px 32px;
    --cart-drawer-text-secondary: #6b7280;
    --cart-drawer-text-muted: #9ca3af;
    /* --cart-drawer-success removed 2026-08-25 — its only consumer was the
       shipping-progress gradient end, now brand purple ("colors should be
       consistent": no green in cart chrome). */
  }

  /* ── Main Dialog Container ── */
  .cart-drawer__dialog {
    position: fixed;
    overflow: hidden;
    border-radius: 20px 0 0 20px;
    width: var(--sidebar-width, 440px);
    max-width: 95vw;
    height: 100%;
    margin: 0 0 0 auto;
    padding: 0;
    border: none;
    border-left: 1px solid rgba(var(--cart-drawer-accent-rgb), 0.15);
    box-shadow:
      -12px 0 40px rgba(0, 0, 0, 0.15),
      -4px 0 20px rgba(var(--cart-drawer-accent-rgb), 0.08);
    background: var(--cart-drawer-bg);
  }

  .cart-drawer__dialog::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .cart-drawer__dialog:modal {
    max-height: 100dvh;
    overflow-y: hidden;
  }

  /* Premium accent line at top */
  .cart-drawer__dialog::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--cart-drawer-accent), var(--cart-drawer-accent-secondary), var(--cart-drawer-accent));
    background-size: 200% 100%;
    /* A closed dialog element is display:none so this doesn't tick when
       shut; the [open] play-state gate below keeps that true if the drawer
       ever migrates to the house div+.is-open pattern (ios-dialog lint).
       perf-justified: paused by default, runs only while [open]. */
    animation: cart-shimmer 3s ease-in-out infinite;
    animation-play-state: paused;
    z-index: 10;
  }

  .cart-drawer__dialog[open]::before {
    animation-play-state: running;
  }

  @keyframes cart-shimmer {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .cart-drawer__inner {
    height: 100%;
    overflow: hidden;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  /* ═══ CART ITEMS (Drawer-specific) ═══ */
  /* ── DEFAULT = 3-col card: thumbnail | title | price (top-right). This is the
     side-by-side card the drawer has always used, and what desktop + 360/375px+
     phones keep. Only at genuinely cramped widths (container ≤280px ≈ ≤320px
     phones) does it switch to the compact 2-col stack in the @container block
     below — that's the one width where the 3-col starved the title to a sliver. ── */
  .cart-drawer .cart-items__table-row {
    grid-template-columns: 56px minmax(0, 1fr) auto;
    grid-template-areas:
      'media details price'
      'media edd     edd'
      'media qty     qty';
    column-gap: 10px;
    padding-bottom: 12px;
    margin-bottom: 12px;
  }

  /* Full-width rows under the title/price: the delivery estimate, then the compact stepper.
     grid-area re-places the cells the base grid put at 1/-1 so each spans the content columns
     and left-aligns with the title. margin-top owns the vertical rhythm (no row-gap, so a gift
     card's hidden --empty edd cell adds no phantom gap above the stepper). */
  .cart-drawer .cart-items__edd-cell { grid-area: edd; margin-top: 4px; }
  .cart-drawer .cart-items__inline-qty-cell { grid-area: qty; margin-top: 4px; }

  .cart-drawer .cart-items__media-container {
    width: 56px;
  }

  .cart-drawer .cart-items__title {
    font-size: 13px;
    font-weight: 700;
    line-height: 1.3;
    /* Cap product names at 2 lines + ellipsis at ALL widths (merchant preference).
       The 3-col title column is only ~135px, so without this a long name wraps to
       ~6 lines and makes a tall card. Applies to both the 3-col and compact layouts,
       so the compact override no longer needs its own clamp. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cart-drawer .cart-items__inline-price {
    display: none;
  }

  /* DEFAULT: price top-right, stacked (current over compare-at) — the 3-col card.
     The narrow @container override above flips it to a left-aligned inline row. */
  .cart-drawer .cart-items__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    font-size: 12px;
    font-weight: 600;
  }

  .cart-drawer .cart-items__compare-price {
    font-size: 10px;
    color: var(--compare-price-color, #6b7280);
  }

  /* Compact 2-col stack — ONLY when the drawer is genuinely cramped (small phones,
     ≤320px viewport ≈ ≤280px container). Placed AFTER the default title/price rules
     so these overrides win by source order (equal specificity). Title takes the full
     width so a long name can't wrap to 10+ lines / blow the card to ~400px; price,
     delivery estimate and stepper each drop to their own row. 375px+ phones and
     desktop keep the 3-col card. */
  @container cart-items (max-width: 280px) {
    .cart-drawer .cart-items__table-row {
      grid-template-columns: 56px minmax(0, 1fr);
      grid-template-areas:
        'media details'
        'media price'
        'media edd'
        'media qty';
      column-gap: 11px;
    }

    .cart-drawer .cart-items__price {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: flex-start;
      gap: 2px 6px;
      margin-top: 3px;
    }
  }

  .cart-drawer .cart-items__details > * + * {
    margin-block-start: 2px;
  }

  .cart-drawer .cart-items__details * {
    font-size: 11px;
  }

  .cart-drawer .cart-items__variant,
  .cart-drawer .cart-items__variants {
    font-size: 11px;
    color: #6b7280;
  }

  /* Hide original quantity row — use compact inline qty in details instead */
  .cart-drawer .cart-items__quantity { display: none; }

  /* Compact qty controls — now live in their own full-width .cart-items__inline-qty-cell
     grid row (vertical spacing is on that cell), not inside the details cell. */
  .cart-drawer .cart-items__inline-qty {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .cart-drawer .cart-items__quantity-controls {
    gap: 4px;
    margin-bottom: 8px;
  }

  .cart-drawer .quantity-selector {
    height: 28px;
    min-width: auto;
    border-radius: 6px;
    flex: 0 0 auto;
  }

  .cart-drawer .quantity-selector__button {
    width: 28px;
    height: 28px;
    padding: 0;
  }

  /* The stepper's +/- controls render as .quantity-minus / .quantity-plus
     (NOT .quantity-selector__button), so the rule above never reached them and
     they defaulted to 44px each — making the whole pill ~126px and crowding the
     remove button against the card edge. Size the real buttons directly: 32px
     drops the stepper to ~96px (still clears WCAG 2.5.8's 24px min tap target,
     though below the 44px mobile ideal). */
  .cart-drawer .cart-items__inline-qty .quantity-selector button {
    width: 32px;
    min-width: 32px;
    padding: 0;
  }

  .cart-drawer .quantity-selector__input,
  .cart-drawer .quantity-selector input[type='number'] {
    width: 28px;
    height: 28px;
    /* Compact density on desktop — 12px digit in a 28×28 cell. */
    font-size: 12px !important;
    padding: 0;
    min-width: 24px !important;
    max-width: 28px !important;
  }
  /* Mobile: bump to 16px to suppress iOS Safari focus auto-zoom
     (which never zooms back out, leaving the drawer wider than
     viewport). 16px digit needs a slightly wider cell to fit
     two-digit quantities — bumping width 28 → 36px on mobile. */
  @media screen and (max-width: 749px) {
    .cart-drawer .quantity-selector__input,
    .cart-drawer .quantity-selector input[type='number'] {
      width: 30px;
      font-size: 16px !important;
      min-width: 30px !important;
      max-width: 30px !important;
    }
  }

  .cart-drawer .cart-items__remove {
    width: 24px;
    height: 24px;
  }

  .cart-drawer .cart-items__remove svg {
    width: 14px;
    height: 14px;
  }

  /* Hide Shop Pay / PayPal / Google Pay / Apple Pay accelerated checkout
     buttons inside the cart drawer at all viewports. Only the single
     CHECKOUT button should appear in the drawer; accelerated checkout
     stays on the main /cart page where there's real estate for it. */
  .cart-drawer .additional-checkout-buttons,
  .cart-drawer .dynamic-checkout__content,
  .cart-drawer #dynamic-checkout-cart,
  .cart-drawer shopify-accelerated-checkout-cart {
    display: none !important;
  }

  /* ═══ Quick-Buy Modal — Variant List (vertical compact layout) ═══ */

  /* ═══ UPSELLS - Horizontal Carousel ═══ */
  .cart-upsell {
    padding: 12px 16px 16px;
    border-top: 1px solid var(--cart-drawer-border);
    margin-bottom: 4px;
  }

  .cart-upsell__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .cart-upsell__title {
    font-size: 11px;
    font-weight: 600;
    color: var(--cart-drawer-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0;
  }

  /* Vertical list (was a horizontal carousel + nav arrows). A cart drawer is
     only ~356px wide even on desktop, so it never had room for two cards side
     by side — the carousel only ever showed one card plus tiny arrows. A
     stacked list shows every upsell at once, needs no arrows, and structurally
     can't overflow or let one card occlude another. Capped by the merchant's
     cart_upsell_limit (default 3), so it stays short. */
  .cart-upsell__track {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cart-upsell__item {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    padding: 10px;
    background: rgba(0, 0, 0, 0.02);
    border: 1px solid var(--cart-drawer-border);
    border-radius: 8px;
    min-width: 0;
  }

  /* Price ⟷ ADD on one row; ADD wraps under the price only when the row is
     genuinely too narrow for both (a wide currency like VND at ≤~360px). */
  .cart-upsell__buy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 4px 8px;
    margin-top: 4px;
  }

  /* keep ADD right-aligned when it wraps onto its own line */
  .cart-upsell__add {
    margin-inline-start: auto;
  }

  .cart-upsell__image {
    width: 52px;
    height: 52px;
    border-radius: 6px;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--casa-border-on-paper);
  }

  .cart-upsell__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-upsell__info {
    flex: 1;
    min-width: 0;
  }

  .cart-upsell__name {
    display: block;
    font-size: 12px;
    font-weight: 500;
    color: var(--cart-drawer-text);
    text-decoration: none;
    line-height: 1.3;
    margin-bottom: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cart-upsell__name:hover {
    text-decoration: underline;
  }

  .cart-upsell__price {
    font-size: 12px;
    font-weight: 600;
    color: var(--cart-drawer-text);
  }

  button.cart-upsell__add,
  .cart-upsell__add {
    padding: 7px 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--cart-drawer-accent, #B0C3FA);
    background-color: var(--cart-drawer-accent, #B0C3FA);
    color: #fff;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    /* Brand-book home-decor CTA convention: UPPERCASE Inter 600 with
       generous tracking ("ADD", not "Add"). Keeps the drawer CTA
       language consistent with the PDP "ADD TO CART" pattern and the
       sticky CHECKOUT button below. */
    font-family: var(--font-body--family, 'Inter', system-ui, sans-serif);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: all 0.15s ease;
    flex-shrink: 0;
    white-space: nowrap;
    -webkit-appearance: none;
    appearance: none;
  }

  .cart-upsell__add:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .cart-upsell__add:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .cart-upsell__add.is-loading {
    pointer-events: none;
  }

  .cart-upsell__add.is-success {
    /* Was green #10b981 — brand purple per the one-accent rule
       (merchant 2026-08-25). White label on #B0C3FA = 5.4:1. */
    background: var(--casa-purple, #B0C3FA);
  }

  /* ═══ Trust Line - Minimal — sits below checkout button ═══
     Flex child of the sticky .cart-drawer__summary. The gap that
     actually applies there is NOT this file's 20px — the dead stock
     header's snippet (header-actions.liquid:643) still ships its
     .cart-drawer__summary block in the compiled bundle and wins the
     same-specificity cascade, so the live gap is var(--gap-sm)
     (0.7rem = 11.2px; browser-verified 2026-07-20). Subtracting the
     same token nets a deterministic 8px under the CHECKOUT button
     regardless of root font-size. If the dead header cluster is ever
     deleted, this file's gap: 20px activates — retune this calc.
     Color matches the cart muted token: #9ca3af was 2.31:1 on Paper
     (AA fail at 10px). */
  .cart-cro__trust {
    font-size: 10px;
    line-height: 1.5;
    color: var(--cart-text-muted, #525252);
    text-align: center;
    padding: 0;
    margin: 0;
    margin-block-start: calc(8px - var(--gap-sm, 0.7rem));
  }

  /* ── Compact Header ── */
  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 14px 20px;
    border-bottom: none;
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--cart-drawer-bg, #ffffff);
  }

  .cart-drawer__header-left {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
  }

  .cart-drawer__heading {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 0;
    font-size: 16px;
    font-weight: 700;
    color: var(--cart-drawer-text);
    white-space: nowrap;
  }

  .cart-drawer__heading .cart-bubble {
    display: none;
  }

  .cart-drawer__count {
    font-weight: 400;
    color: var(--cart-drawer-text-secondary);
    font-size: 15px;
  }

  .cart-drawer__shipping-inline {
    display: flex;
    align-items: center;
  }

  .cart-drawer__shipping-inline .cart-drawer__shipping-text {
    font-size: 11px;
    color: var(--cart-drawer-text-muted);
    margin: 0;
    white-space: nowrap;
  }
  .cart-drawer__shipping-inline .cart-drawer__shipping-text strong {
    color: var(--cart-drawer-text);
    font-weight: 600;
  }
  .cart-drawer__shipping-inline .cart-drawer__shipping-text--success {
    /* Brand purple, not green (merchant 2026-08-25: "colors should be
       consistent" — one accent across cart chrome; the earlier
       purple-applied/green-achieved split lasted one commit). #B0C3FA on
       the white header = 5.4:1, AA at 11px/600. */
    color: var(--casa-purple, #B0C3FA);
    font-weight: 600;
  }

  .cart-drawer__close-button {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--cart-drawer-border);
    border-radius: 50%;
    cursor: pointer;
    color: var(--cart-drawer-text-secondary);
    transition: all 0.2s;
    flex-shrink: 0;
  }
  .cart-drawer__close-button:hover {
    background: #f3f4f6;
    color: var(--cart-drawer-text);
    border-color: #d1d5db;
  }
  .cart-drawer__close-button svg {
    width: 14px;
    height: 14px;
  }

  /* ── Shipping Progress Bar (thin line below header) ── */
  .cart-drawer__shipping-bar {
    padding: 0 20px 0;
    background: transparent;
  }

  .cart-drawer__shipping-text {
    font-size: 11px;
    color: var(--cart-drawer-text-muted);
    margin: 0;
  }
  .cart-drawer__shipping-text strong {
    color: var(--cart-drawer-text);
    font-weight: 600;
  }
  .cart-drawer__shipping-text--success {
    /* Brand purple — see the .cart-drawer__shipping-inline rule above. */
    color: var(--casa-purple, #B0C3FA);
  }

  .cart-drawer__shipping-track {
    height: 3px;
    background: #e5e7eb;
    border-radius: 2px;
    overflow: hidden;
  }

  .cart-drawer__shipping-progress {
    height: 100%;
    width: var(--progress, 0%);
    /* Ink → brand purple (was → green #10b981; merchant 2026-08-25:
       "colors should be consistent" — no green in cart chrome). */
    background: linear-gradient(90deg, var(--cart-drawer-accent), var(--casa-purple, #B0C3FA));
    border-radius: 3px;
    /* perf-justified: --progress is a Liquid-set percentage, so scaleX
       needs a unitless fraction (calc can't divide by %) and would distort
       the 3px end-cap radius + ::after shimmer. Fires only on discrete
       cart mutations while the drawer is open — 3px-tall bar, negligible. */
    transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }
  .cart-drawer__shipping-progress::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    /* perf-justified: paused by default, runs only while the owning
       drawer is [open] (rule below); the closed dialog is display:none. */
    animation: shimmer 2s infinite;
    animation-play-state: paused;
  }
  .cart-drawer__dialog[open] .cart-drawer__shipping-progress::after {
    animation-play-state: running;
  }

  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  /* ── Content Area ── */
  .cart-drawer__content {
    display: flex;
    flex-direction: column;
    padding: 0;
    background: transparent;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding: var(--cart-drawer-padding);
  }

  @media screen and (min-width: 750px) {
    .cart-drawer__items {
      padding: var(--cart-drawer-padding-desktop);
    }
  }

  /* ── Product Cards in Drawer ── */
  .cart-drawer__items .cart-items__table-row {
    padding: 16px;
    margin-bottom: 16px;
    background: var(--casa-paper);
    border: 1px solid var(--cart-drawer-border);
    border-radius: 12px;
    transition: all 0.2s;
  }
  .cart-drawer__items .cart-items__table-row:hover {
    border-color: #d1d5db;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    margin-bottom: 0;
    border-bottom: none;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__media-container {
    border-radius: 8px;
    overflow: hidden;
    background: var(--casa-border-on-paper);
  }

  .cart-drawer__items .cart-items__title {
    color: var(--cart-drawer-text);
    font-weight: 700;
    font-size: 13px;
  }
  .cart-drawer__items .cart-items__title:hover {
    color: var(--cart-drawer-accent);
  }

  .cart-drawer__items .cart-items__details {
    color: var(--cart-drawer-text-secondary);
    font-size: 12px;
  }

  .cart-drawer__items .cart-items__inline-current {
    color: var(--cart-drawer-text);
    font-size: 13px;
  }
  .cart-drawer__items .cart-items__inline-current--sale {
    color: #dc2626;
  }
  .cart-drawer__items .cart-items__inline-compare {
    color: var(--cart-drawer-text-muted);
  }

  /* Quantity selector styling.
     Brand-strict: Paper #FAFAF7 (matches the line-item card it sits
     inside, zero color drift) + hairline #E5E5E5 border so only the
     border distinguishes it as interactive. Was rendering on the
     stock --casa-border-on-paper token (~#E5E3DC warm grey-beige)
     which read as off-brand input chrome. */
  .cart-drawer__items .quantity-selector {
    background: #FAFAF7;
    border: 1px solid #E5E5E5;
    border-radius: 6px;
  }

  .cart-drawer__items .cart-items__remove {
    color: var(--cart-drawer-text-muted);
    transition: color 0.2s;
    min-width: 28px;
    min-height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0.6;
  }
  .cart-drawer__items .cart-items__remove:hover {
    color: #ef4444;
    opacity: 1;
  }

  /* Horizon's <scroll-hint> (assets/scrolling.js ScrollHint#update) writes a
     scroll-aware mask-image as an INLINE style that fades the top and bottom
     10% of the scroll container to hint overflow. Casa's drawer keeps the
     sticky .cart-drawer__summary INSIDE the scroll-hint, so the bottom fade
     erases the summary's own pixels — the CHECKOUT button rendered with a
     white wash over its lower half (only when the cart overflows, which is
     why 1-item carts looked fine; worst on phones where the 10% zone is
     ~80px). The fade can never do its real job here — the opaque sticky
     summary permanently covers the container's bottom edge — so disable the
     mask for the cart drawer only. !important is required to beat the JS
     inline style. Other scroll-hint instances keep stock behavior. */
  scroll-hint.cart-drawer__content {
    mask-image: none !important;
    -webkit-mask-image: none !important;
  }

  /* ── Summary Section ── */
  .cart-drawer__summary {
    --cart-drawer-summary-padding: 24px;
    position: sticky;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 20px;
    padding: var(--cart-drawer-summary-padding);
    background: var(--casa-paper);
    border-top: 1px solid var(--cart-drawer-border);
  }

  @media screen and (min-width: 750px) {
    .cart-drawer__summary {
      --cart-drawer-summary-padding: 32px;
    }
  }

  /* Force summary always sticky — never let theme JS override */
  .cart-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__summary {
    position: sticky;
    bottom: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, #ffffff 20%);
    border-top: 1px solid var(--cart-drawer-border);
  }

  /* Summary totals */
  .cart-drawer__summary .cart__summary-totals {
    gap: 12px;
  }

  .cart-drawer__summary .cart__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    width: 100%;
  }

  .cart-drawer__summary .cart__total-label {
    color: var(--cart-drawer-text-secondary);
    font-size: 14px;
  }

  /* Keep the compare-at strike inline beside the amount, wrapping to a 2nd line
     only when the drawer is genuinely too narrow for the currency. Self-contained
     (mirrors the base rule in cart-summary.liquid) so this 0,2,0 drawer override
     doesn't silently depend on the base for flex-direction/wrap. column-gap 8px =
     inline spacing; row-gap 1px = tight stack matching the /cart page. */
  .cart-drawer__summary .cart__total-prices {
    display: flex;
    flex-flow: row wrap;
    justify-content: flex-end;
    align-items: baseline;
    column-gap: 8px;
    row-gap: 1px;
    min-width: 0;
  }

  .cart-drawer__summary .cart__total-value {
    color: var(--cart-drawer-text);
    font-size: 18px;
    font-weight: 700;
  }

  /* Drawer subtotal was-price. Bumped 14px → 16px so it reads as a real
     secondary price under the 18px subtotal instead of a tiny afterthought
     (the merchant flagged the size mismatch). This .cart-drawer__summary rule
     (0,2,0) is what actually wins in the drawer — the .cart__total-compare rule
     in cart-summary.liquid is a lower-specificity base fallback. */
  .cart-drawer__summary .cart__total-compare {
    color: var(--compare-price-color, #6b7280);
    font-size: 16px;
    font-weight: 400;
    text-decoration: line-through;
  }

  /* Checkout button — Ink brand primary (mirrors assets/casa-buttons.css .btn-primary).
     Was a "premium gradient CTA"; with the merchant's cart accent set to #000000
     the gradient + gloss rendered as a grey wash, off the brand's quiet-chrome
     Ink-CTA rule. Solid Ink is correct. Uses brand tokens so it tracks the button
     system + the merchant's Ink setting (casa_surface_ink), not the ad-hoc accent.
     `!important` on the fill is retained ON PURPOSE: it must beat the legacy
     `.cart-drawer .cart__checkout-button` --cro-accent purple gradient in
     snippets/header-actions.liquid (specificity 0,2,0, no !important) which would
     otherwise out-specify .btn-primary and resurface purple. */
  .cart-drawer__summary .cart__checkout-button,
  .cart-drawer .cart__checkout-button,
  .cart-drawer-component .cart__checkout-button,
  .cart__checkout-button.button {
    background: var(--bg-dark, #0A0A0F) !important;
    border: none !important;
    border-radius: var(--r-lg, 12px);
    color: var(--t-on-dark, #ffffff) !important;
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: var(--button-text-case-primary, uppercase);
    padding: 16px 32px;
    cursor: pointer;
    transition: transform var(--d-base) var(--ease-out), box-shadow var(--d-base) var(--ease-out), background var(--d-base) var(--ease-out);
  }
  .cart-drawer__summary .cart__checkout-button:hover,
  .cart-drawer .cart__checkout-button:hover {
    background: #1f1f25 !important;
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(10, 10, 15, 0.18);
  }
  .cart-drawer__summary .cart__checkout-button:active {
    transform: scale(0.98);
  }
  .cart-drawer__summary .cart__checkout-button:focus-visible {
    outline: 2px solid var(--c-purple, #B0C3FA);
    outline-offset: 2px;
  }
  .cart-drawer__summary .cart__checkout-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  /* Discount input styling.
     Brand-strict: Paper #FAFAF7 + hairline #E5E5E5. Matches the
     quantity selector pattern above so both inputs in the drawer
     speak the same surface language.
     Sized as secondary (40px tall, .btn-sm proportions) — discount
     code is opt-in, must not compete with the CHECKOUT primary CTA. */
  .cart-drawer__summary .cart-discount__input {
    background: #FAFAF7;
    border: 1px solid #E5E5E5;
    border-radius: 8px;
    color: var(--cart-drawer-text);
    height: 40px;
    padding: 8px 14px;
  }
  .cart-drawer__summary .cart-discount__input:focus {
    border-color: var(--cart-drawer-accent);
    outline: none;
    box-shadow: 0 0 0 3px rgba(var(--cart-drawer-accent-rgb), 0.1);
  }

  /* Apply button: .btn-sm proportions so it reads as secondary to
     CHECKOUT. Was sized only 1px smaller than CHECKOUT (14px vs 15px
     font, same uppercase weight) which made the eye treat them as
     equal-priority CTAs. */
  .cart-drawer__summary .cart-discount__button {
    background: var(--cart-drawer-accent);
    border: none;
    border-radius: 8px;
    color: white;
    font-family: var(--font-body--family, 'Inter', system-ui, sans-serif);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    height: 40px;
    padding: 0 18px;
    transition: opacity 0.15s ease;
  }
  .cart-drawer__summary .cart-discount__button:hover {
    opacity: 0.9;
  }

  /* Note accordion */
  .cart-drawer__summary .cart-note__summary,
  .cart-drawer__summary .cart-discount__summary {
    color: var(--cart-drawer-text-secondary);
  }
  .cart-drawer__summary .cart-note__summary:hover,
  .cart-drawer__summary .cart-discount__summary:hover {
    color: var(--cart-drawer-text);
  }

  .cart-drawer__summary .cart-note__instructions {
    background: var(--casa-border-on-paper);
    border: 1px solid var(--cart-drawer-border);
    border-radius: 8px;
    color: var(--cart-drawer-text);
  }
  .cart-drawer__summary .cart-note__instructions:focus {
    border-color: var(--cart-drawer-accent);
    outline: none;
    box-shadow: 0 0 0 3px rgba(var(--cart-drawer-accent-rgb), 0.1);
  }

  /* ── Empty Cart State ── */
  .cart-drawer--empty .cart-drawer__header {
    justify-content: flex-end;
    border-bottom: none;
    background: transparent;
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: center;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100dvh;
    margin-top: 0;
  }

  .cart-drawer--empty .cart-drawer__heading {
    margin-bottom: 24px;
    font-size: 22px;
    color: var(--cart-drawer-text-secondary);
  }

  .cart-drawer__heading--empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }

  .cart-drawer__empty-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
    opacity: 0.85;
  }
  .cart-drawer__empty-logo-img {
    max-width: 140px;
    height: auto;
    display: block;
  }
  .cart-drawer__empty-logo-text {
    font-family: var(--font-heading--family);
    font-size: 18px;
    font-weight: 300;
    letter-spacing: 0.22em;
    color: var(--cart-drawer-text, var(--casa-ink));
  }

  .cart-drawer:not(:has(.cart-form)) .cart-drawer__content {
    justify-content: center;
  }

  .cart-drawer:not(:has(.cart-form)) .cart-items__empty-button {
    background: linear-gradient(135deg, var(--cart-drawer-accent), var(--cart-drawer-accent-secondary));
    border: none;
    border-radius: 12px;
    color: white;
    font-weight: 600;
    padding: 14px 32px;
    transition: all 0.2s;
  }
  .cart-drawer:not(:has(.cart-form)) .cart-items__empty-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(var(--cart-drawer-accent-rgb), 0.35);
  }

  /* ── Scrollbar Styling ── */
  .cart-drawer__items::-webkit-scrollbar,
  .cart-drawer__content::-webkit-scrollbar {
    width: 6px;
  }
  .cart-drawer__items::-webkit-scrollbar-track,
  .cart-drawer__content::-webkit-scrollbar-track {
    background: transparent;
  }
  .cart-drawer__items::-webkit-scrollbar-thumb,
  .cart-drawer__content::-webkit-scrollbar-thumb {
    background: #d1d5db;
    border-radius: 3px;
  }
  .cart-drawer__items::-webkit-scrollbar-thumb:hover,
  .cart-drawer__content::-webkit-scrollbar-thumb:hover {
    background: #9ca3af;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     LOCALIZATION DRAWER STYLES
     Country/language selector modal matching Casa dark theme
     ══════════════════════════════════════════════════════════════════════════ */
  .casa-locale-drawer {
    position: fixed;
    inset: 0;
    margin: auto;
    z-index: 10001;
    border: none;
    border-radius: 16px;
    /* Flat Ink per brand book — surfaces are Paper or Ink only, no gradient on chrome. */
    background: var(--bg-dark, var(--casa-ink));
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 20px 60px rgba(0, 0, 0, 0.5),
      0 0 80px rgba(var(--casa-glow-primary-rgb, 176, 195, 250), 0.1);
    color: white;
    max-width: 420px;
    width: 90vw;
    max-height: 80vh;
    max-height: 80dvh;
    padding: 0;
    overflow: hidden;
    display: none;
  }

  .casa-locale-drawer.is-open {
    display: flex;
  }

  .casa-locale-backdrop {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: rgba(0, 0, 0, 0.75);
  }

  .casa-locale-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    box-sizing: border-box;
    max-height: min(80vh, 80dvh);
  }

  .casa-locale-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
  }

  .casa-locale-drawer__title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--font-h5--size, 16px);
    font-weight: 500;
    margin: 0;
    color: white;
  }
  .casa-locale-drawer__title svg {
    opacity: 0.7;
  }

  .casa-locale-drawer__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    transition: all 0.2s;
  }
  .casa-locale-drawer__close:hover {
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }

  .casa-locale-drawer__content {
    padding: 0;
    overflow-y: auto;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  /* Custom Locale Form */
  .casa-locale-form {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* Search Input */
  .casa-locale-search {
    padding: 16px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    position: relative;
    flex-shrink: 0;
  }
  .casa-locale-search__icon {
    position: absolute;
    left: 32px;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.4);
    pointer-events: none;
  }
  .casa-locale-drawer .casa-locale-search__input,
  .casa-locale-drawer input.casa-locale-search__input {
    width: 100%;
    padding: 12px 16px 12px 40px;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    color: white;
    font-size: 14px;
    transition: all 0.2s;
  }
  .casa-locale-drawer .casa-locale-search__input::placeholder,
  .casa-locale-drawer input.casa-locale-search__input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }
  .casa-locale-drawer .casa-locale-search__input:focus,
  .casa-locale-drawer input.casa-locale-search__input:focus {
    outline: none;
    border-color: var(--casa-glow-primary, #B0C3FA);
    background-color: rgba(255, 255, 255, 0.08);
    color: white;
  }

  /* Country List */
  .casa-locale-countries {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 12px 20px;
    min-height: 200px;
    /* No max-height — list fills available drawer space and scrolls
       internally so the submit button stays pinned to the bottom edge
       instead of leaving dead space. */
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.28) transparent;
  }
  .casa-locale-countries::-webkit-scrollbar {
    width: 8px;
  }
  .casa-locale-countries::-webkit-scrollbar-track {
    background: transparent;
  }
  .casa-locale-countries::-webkit-scrollbar-thumb {
    background: rgba(94, 10, 2, 0.28);
    border-radius: 4px;
  }
  .casa-locale-countries::-webkit-scrollbar-thumb:hover {
    background: rgba(94, 10, 2, 0.45);
  }

  /* Section Labels */
  .casa-locale-section {
    margin-bottom: 12px;
  }
  .casa-locale-section__label {
    display: block;
    /* 12px / 0.12em letter-spacing — brand-book hairline-uppercase pattern.
       Was 10px / 1.5px which was below the readable floor on Retina. */
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 10px;
    padding-left: 4px;
  }

  /* Country Grid */
  .casa-locale-grid {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* Individual Country Button */
  .casa-locale-country {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 12px 14px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.8);
    font-size: 14px;
    text-align: left;
    cursor: pointer;
    transition: all 0.15s;
  }
  .casa-locale-country:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.08);
  }
  .casa-locale-country.is-selected {
    background: rgba(var(--casa-glow-primary-rgb, 176, 195, 250), 0.15);
    border-color: rgba(var(--casa-glow-primary-rgb, 176, 195, 250), 0.3);
    color: white;
  }
  .casa-locale-country__check {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: transparent;
    transition: all 0.15s;
  }
  .casa-locale-country.is-selected .casa-locale-country__check {
    background: var(--casa-glow-primary, #B0C3FA);
    border-color: var(--casa-glow-primary, #B0C3FA);
    color: white;
  }
  .casa-locale-country__name {
    flex: 1;
    font-weight: 500;
  }
  .casa-locale-country__currency {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 400;
  }
  .casa-locale-country.is-selected .casa-locale-country__currency {
    color: rgba(255, 255, 255, 0.7);
  }

  /* No Results */
  .casa-locale-no-results {
    text-align: center;
    color: rgba(255, 255, 255, 0.4);
    font-size: 14px;
    padding: 24px;
  }

  /* Language Selector */
  .casa-locale-language {
    padding: 16px 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-shrink: 0;
  }
  .casa-locale-language__label {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
    font-weight: 500;
  }
  .casa-locale-language__select-wrapper {
    position: relative;
    flex: 1;
    max-width: 200px;
  }
  .casa-locale-language__select {
    width: 100%;
    padding: 10px 36px 10px 14px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: white;
    font-size: 13px;
    cursor: pointer;
    appearance: none;
    transition: all 0.2s;
  }
  .casa-locale-language__select:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
  }
  .casa-locale-language__select:focus {
    outline: none;
    border-color: var(--casa-glow-primary, #B0C3FA);
  }
  .casa-locale-language__select option {
    background: #1a1a20;
    color: white;
  }
  .casa-locale-language__caret {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.4);
    pointer-events: none;
  }

  /* Submit Button — visual styles inherit from .btn .btn-primary-on-dark
     (assets/casa-buttons.css). This rule only contributes drawer-specific
     layout: margin and flex-shrink so it pins to the drawer's bottom edge. */
  .casa-locale-submit {
    margin: 16px 20px 20px;
    flex-shrink: 0;
    width: calc(100% - 40px);
  }

  /* Noscript fallback selects */
  .casa-locale-drawer noscript select {
    margin-bottom: 12px;
  }

  /* ═══════════════════════════════════════════════════════
     RESPONSIVE: VERY SMALL MOBILE (375px and below)
     Optimized for iPhone SE and similar small devices
     ═══════════════════════════════════════════════════════ */
  @media (max-width: 375px) {
    .casa-header {
      padding: 0 12px;
      height: calc(var(--casa-header-height, 80px) * 0.7);
    }

    .casa-header__logo {
      font-size: 14px;
      letter-spacing: calc(var(--casa-logo-spacing, 4px) * 0.6);
    }
    .casa-header__logo-img {
      height: calc(var(--casa-logo-height, 36px) * 0.7);
    }

    .casa-header__actions {
      gap: 12px;
    }

    .casa-header__btn {
      padding: 2px;
    }

    .casa-header__btn svg {
      width: 20px;
      height: 20px;
    }

    .casa-menu-toggle svg {
      width: 20px;
      height: 20px;
    }
  }

  /* ═══════════════════════════════════════════════════════
     RESPONSIVE: EXTRA LARGE DESKTOP (1920px+)
     More breathing room for larger monitors
     ═══════════════════════════════════════════════════════ */
  @media (min-width: 1920px) {
    .casa-header {
      padding: 0 100px;
    }

    .casa-header__inner {
      max-width: 1800px;
    }

    /* Widescreen layout stops tracking the viewport past 1920px: uncapped,
       logo and cart end up ~3000px apart on a 34" ultrawide and the header
       ignores the ~1920px band the page content sits in (merchant-approved
       cap 2026-07-12). Only binds above ~2400px viewports at this tier. */
    .casa-header--widescreen .casa-header__inner {
      max-width: 2200px;
    }

    .casa-header__left {
      gap: 80px;
    }

    .casa-header__nav {
      gap: 56px;
    }

    .casa-header__logo {
      font-size: 24px;
    }
    .casa-header__logo-img {
      height: calc(var(--casa-logo-height, 36px) * 1.15);
    }

    .casa-header__nav-link {
      font-size: calc(var(--casa-nav-size, 14px) + 1px);
    }
  }

  /* ═══════════════════════════════════════════════════════
     RESPONSIVE: ULTRAWIDE (2560px+ / QHD & 4K)
     ═══════════════════════════════════════════════════════ */
  @media (min-width: 2560px) {
    .casa-header {
      padding: 0 140px;
      height: calc(var(--casa-header-height, 80px) * 1.1);
    }

    .casa-header__inner {
      max-width: 2200px;
    }

    /* Widescreen stays at the 2200px ceiling. Kept as belt-and-braces: the
       ≥1920 widescreen rule already persists upward, but if that rule were
       ever reverted, the base max-width: none (same specificity, earlier in
       source) would win here without this duplicate. */
    .casa-header--widescreen .casa-header__inner {
      max-width: 2200px;
    }

    .casa-header__left {
      gap: 100px;
    }

    .casa-header__nav {
      gap: 64px;
    }

    .casa-header__logo {
      font-size: 28px;
      letter-spacing: calc(var(--casa-logo-spacing, 4px) * 1.2);
    }
    .casa-header__logo-img {
      height: calc(var(--casa-logo-height, 36px) * 1.3);
    }

    .casa-header__nav-link {
      font-size: calc(var(--casa-nav-size, 14px) + 2px);
    }

    .casa-header__btn svg {
      width: 26px;
      height: 26px;
    }

    .casa-header__actions {
      gap: 28px;
    }
  }

  /* ═══════════════════════════════════════════════════════
     RESPONSIVE: SUPER ULTRAWIDE (3440px+ / 34" Ultrawide)
     ═══════════════════════════════════════════════════════ */
  @media (min-width: 3440px) {
    .casa-header {
      padding: 0 200px;
      height: calc(var(--casa-header-height, 80px) * 1.2);
    }

    /* Ladder stops at 2200px — the old 2800px rung put the logo and cart
       ~3000px apart on 34" ultrawides (merchant-approved cap 2026-07-12). */
    .casa-header__inner {
      max-width: 2200px;
    }

    .casa-header__left {
      gap: 120px;
    }

    .casa-header__nav {
      gap: 72px;
    }

    .casa-header__logo {
      font-size: 32px;
    }
    .casa-header__logo-img {
      height: calc(var(--casa-logo-height, 36px) * 1.5);
    }

    .casa-header__nav-link {
      font-size: calc(var(--casa-nav-size, 14px) + 3px);
    }

    .casa-header__btn svg {
      width: 30px;
      height: 30px;
    }

    .casa-header__actions {
      gap: 36px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Casa Header",
  "tag": "section",
  "class": "casa-header-section",
  "settings": [
    { "type": "header", "content": "Logo" },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "SEOUL GLOW LAB"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image (optional)"
    },

    { "type": "header", "content": "Navigation" },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "select",
      "id": "header_layout",
      "label": "Header layout",
      "options": [
        { "value": "boxed", "label": "Boxed (1600px, up to 2200px ultrawide)" },
        { "value": "widescreen", "label": "Widescreen (caps at 2200px on ultrawide)" }
      ],
      "default": "boxed"
    },
    {
      "type": "checkbox",
      "id": "nav_uppercase",
      "label": "Uppercase menu items",
      "default": false
    },

    { "type": "header", "content": "Sizing" },
    {
      "type": "range",
      "id": "header_height",
      "label": "Header height (desktop)",
      "min": 60,
      "max": 120,
      "step": 4,
      "default": 80,
      "unit": "px",
      "info": "Mobile height adjusts automatically (80% on tablet, 75% on small mobile)"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo image height",
      "min": 20,
      "max": 60,
      "step": 2,
      "default": 36,
      "unit": "px",
      "info": "Only applies when using an image logo"
    },

    { "type": "header", "content": "Typography" },
    {
      "type": "select",
      "id": "logo_font_weight",
      "label": "Logo font weight",
      "options": [
        { "value": "200", "label": "Extra Light (200)" },
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "300"
    },
