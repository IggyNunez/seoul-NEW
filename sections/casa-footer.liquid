    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Footer background",
      "default": "#0a0a0f"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text / links",
      "default": "#9ca3af"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Column headings"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border / divider color",
      "default": "#1f1f2e"
    },
    {
      "type": "header",
      "content": "Newsletter Colors"
    },
    {
      "type": "color",
      "id": "newsletter_btn_bg",
      "label": "Subscribe button background"
