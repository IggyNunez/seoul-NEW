}

/* Menu Columns */
.casa-footer__col h4 {
  font-size: 12px;
  font-weight: 600;
  margin: 0 0 20px 0;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--footer-heading, rgba(255, 255, 255, 0.9));
}

.casa-footer__col a {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: var(--footer-muted, rgba(255, 255, 255, 0.5));
  text-decoration: none;
  margin-bottom: 12px;
  transition: all 0.2s ease;
}

.casa-footer__col a:hover {
  color: var(--footer-link-hover, #ffffff);
  transform: translateX(4px);
}

.casa-footer__col a svg {
