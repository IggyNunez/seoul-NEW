{% stylesheet %}
.casa-footer-section {
  padding: 0 !important;
  margin: 0;
}

.casa-footer {
  background: var(--footer-bg, linear-gradient(180deg, #0a0a0f 0%, #0f0f18 100%));
  color: var(--footer-text, #ffffff);
  position: relative;
  overflow: hidden;
}

.casa-footer::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 800px;
  height: 400px;
  background: radial-gradient(ellipse, rgba(176, 195, 250, 0.12) 0%, transparent 70%);
  pointer-events: none;
}

/* CTA Section */
.casa-footer__cta {
  position: relative;
  padding: 56px 40px;
  text-align: center;
  border-bottom: 1px solid var(--footer-border, rgba(255, 255, 255, 0.08));
  background: var(--footer-cta-bg, transparent);
}

.casa-footer__cta-content {
  max-width: 600px;
  margin: 0 auto;
}

.casa-footer__cta h3 {
  font-size: 32px;
  font-weight: 300;
  margin: 0 0 10px 0;
  line-height: 1.3;
}

.casa-footer__cta h3 span {
  background: linear-gradient(90deg, var(--footer-cta-accent, #B0C3FA), #5E0A02);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.casa-footer__cta p {
  color: var(--footer-cta-text, rgba(255, 255, 255, 0.6));
  margin: 0 0 20px 0;
  font-size: 15px;
}

.casa-footer__cta-buttons {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
}

.casa-footer__btn {
  padding: 12px 28px;
  font-size: 14px;
  border-radius: 10px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s ease;
  display: inline-block;
}

.casa-footer__btn--primary {
  background: var(--footer-cta-btn-bg, linear-gradient(135deg, #B0C3FA, #5E0A02));
  color: var(--footer-cta-btn-text, #ffffff);
}

.casa-footer__btn--primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 24px -6px rgba(176, 195, 250, 0.5);
}

.casa-footer__btn--secondary {
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.15);
}

.casa-footer__btn--secondary:hover {
  background: rgba(255, 255, 255, 0.12);
}

/* Main Footer Grid */
.casa-footer__main {
  display: flex;
  flex-wrap: wrap;
  gap: 32px;
  padding: 48px 60px;
  position: relative;
  max-width: 1440px;
  margin: 0 auto;
}

/* Column sizing — brand is wider, menu cols share the rest equally */
.casa-footer__brand {
  flex: 1.5;
  min-width: 200px;
}

/* Base layout for the footer brand title. The four visual treatments
   live in modifier classes (--current, --text, --solid, --shimmer)
   so they don't share the `background` shorthand with `background-clip`
   on the same selector — see casa-brand-tokens skill, Bug 1. */
.casa-footer__brand-title {
  font-size: 18px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin: 12px 0 8px;
  line-height: 1.3;
}
/* Defensive: hide if the element has no glyphs to clip to (gradient
   styles would otherwise paint a solid rectangle). */
.casa-footer__brand-title:empty { display: none; }

/* Current style: bespoke animated 3-stop tagline tuned by the merchant
   (commits 962db0e, 356370b, 6a76d3c, 7bc973c). Preserved verbatim
   so existing footers don't visually change. background-image (not
   the shorthand) per casa-brand-tokens skill Bug 1 — same end visual. */
.casa-footer__brand-title--current {
  background-image: linear-gradient(90deg, #ce08d4 0%, #4100ff 50%, #ce08d4 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
  position: relative;
  /* Own stacking context so the z-index:-1 glow layers below sit
     behind the glyphs but never behind the footer background. */
  isolation: isolate;
}

/* Text style: brand-book static gradient (purple to pink to cyan). */
.casa-footer__brand-title--text {
  background-image: var(--grad-text);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}

/* Solid style: plain white text on the dark footer surface. */
.casa-footer__brand-title--solid {
  color: var(--t-on-dark, var(--footer-heading, var(--footer-text, #ffffff)));
}

/* Shimmer style: applied via the .text-grad-shimmer brand utility from
   casa-buttons.css (background-image, background-clip, color, animation
   all provided there). No section-level overrides needed. */

/* "Live in your own light" — gradient stays static (purple→blue
   across all letters always). The pulse used to interpolate stacked
   drop-shadow FILTERS on the text itself — a per-frame CPU re-raster
   on every page whenever the footer was visible. Now the two glow
   states are pre-rendered as STATIC filters on two text-duplicate
   pseudo-elements (fed the tagline via data-casa-glow / attr()),
   layered exactly behind the real glyphs, and only the peak layer's
   OPACITY animates — compositor-only, same 5s timing, same purple +
   blue halo growing and receding. Rest state (::before) matches the
   old 0% frame; mid-cycle (::after at opacity 1) matches the old 50%
   frame. Used by .casa-footer__brand-title--current. */
.casa-footer__brand-title--current::before,
.casa-footer__brand-title--current::after {
  content: attr(data-casa-glow);
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  /* Same gradient-clipped glyphs as the real text, so the duplicate
     letterforms hide exactly underneath and only the halo shows. */
  background-image: inherit;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}
/* Resting halo — static filter, rasterized once. */
.casa-footer__brand-title--current::before {
  filter: drop-shadow(0 0 3px rgba(206, 8, 212, 0.35))
          drop-shadow(0 0 6px rgba(65, 0, 255, 0.25));
}
/* Peak halo — static filter; only its opacity animates. */
.casa-footer__brand-title--current::after {
  filter: drop-shadow(0 0 10px rgba(206, 8, 212, 0.7))
          drop-shadow(0 0 18px rgba(65, 0, 255, 0.5));
  opacity: 0;
  /* perf-justified: compositor-only opacity fade between two statically
     rasterized glow layers — no per-frame filter re-raster off-screen. */
  animation: casa-tagline-glow 5s ease-in-out infinite;
  will-change: opacity;
}
@keyframes casa-tagline-glow {
  0%, 100% { opacity: 0; }
  50% { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .casa-footer__brand-title--current,
  .casa-footer__brand-title--current::after,
  .casa-footer__brand-title--shimmer {
    animation: none;
  }
}

.casa-footer__follow-shop {
  margin: 12px 0 8px;
  /* The Shop "Follow on Shop" web component (shop-follow-button) lives in a
     shadow root with no ::part or theming attribute. It picks its label
     colour from the CSS color-scheme of its context. The footer is always
     dark (#0a0a0f), but the visitor's DEVICE may be in light mode — in which
     case the "Following on Shop" state renders near-black label text that
     vanishes against the dark footer. Forcing color-scheme: dark pins the
     component to its dark-surface treatment (light label) regardless of the
     device theme. The color fallback covers any inner node that uses
     currentColor. This does NOT alter the purple "Follow" CTA pill.
     NOTE: this is coupled to the footer staying dark (footer_bg default
     #0a0a0f, brand surfaces are Ink). If a merchant ever sets a light
     footer background, revisit — color-scheme: dark would then put a light
     label on a light surface. */
  color-scheme: dark;
}
.casa-footer__follow-shop shop-follow-button,
.casa-footer__follow-shop shop-login-button {
  color-scheme: dark;
  color: #ffffff;
}

