  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Casa PDP Save Bundle",
      "category": "Product",
      "blocks": [
        { "type": "pair", "settings": { "names": "Ava + Lily" } },
        { "type": "pair", "settings": { "names": "Ava + Daisy" } },
        { "type": "pair", "settings": { "names": "Daisy + Mia" } },
        { "type": "pair", "settings": { "names": "Daisy + Lily" } }
      ]
    }
  ]
