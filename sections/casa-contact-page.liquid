{%- comment -%}
  Preload the weight-600 Inter this page uses. The global theme only
  preloads Inter 400 / 500 / 700, so weight 600 (the eyebrow labels +
  bolded values) would otherwise lose the cold-load race and flicker while
  400/700 text is already settled. High-priority preload puts 600 on the
  same footing so font-display:optional resolves it in the first-paint
  window. Scoped to the contact page; no global change.
{%- endcomment -%}
{%- assign _ci_pre600 = settings.type_body_font | font_modify: 'weight', '600' -%}
{%- if _ci_pre600 -%}
  <link rel="preload" as="font" type="font/woff2" href="{{ _ci_pre600 | font_url }}" crossorigin fetchpriority="high">
{%- endif -%}

<style>
  /* ============================================
     Seoul Glow Lab — Contact Page
     Prefix: casa-contactp
     ============================================ */

  {%- comment -%}
    Contact-scoped no-flash font (2026-06-28). The global Inter faces use
    font-display:block, which produces the cold-load size flash reported on
    desktop. Rather than fight the swap, declare a CONTACT-ONLY Inter family
    with font-display:OPTIONAL: on a cold first paint the browser keeps the
    (well-matched Arial) fallback for that view and does NOT swap mid-view —
    so there is zero layout/size shift. Inter is fetched in the background
    and shows on the next load (and immediately on warm cache, which is the
    normal returning-visitor case). Scoped to this section only; the global
    font system in snippets/fonts.liquid is untouched. Uses Shopify's signed
    font_url server-side, so it shares the same cached CDN file as the rest
    of the site (no extra download).
  {%- endcomment -%}
  {%- assign _ci_400 = settings.type_body_font | font_modify: 'weight', '400' -%}
  {%- assign _ci_600 = settings.type_body_font | font_modify: 'weight', '600' -%}
  {%- assign _ci_700 = settings.type_body_font | font_modify: 'weight', '700' -%}
  {%- if _ci_400 -%}
    @font-face { font-family: 'CasaContactInter'; font-style: normal; font-weight: 400; font-display: optional; src: url({{ _ci_400 | font_url }}) format('woff2'); }
  {%- endif -%}
  {%- if _ci_600 -%}
    @font-face { font-family: 'CasaContactInter'; font-style: normal; font-weight: 600; font-display: optional; src: url({{ _ci_600 | font_url }}) format('woff2'); }
  {%- endif -%}
  {%- if _ci_700 -%}
    @font-face { font-family: 'CasaContactInter'; font-style: normal; font-weight: 700; font-display: optional; src: url({{ _ci_700 | font_url }}) format('woff2'); }
  {%- endif -%}

  .casa-contactp {
    --cp-accent-purple: {{ section.settings.accent_purple | default: '#B0C3FA' }};
    --cp-accent-pink: {{ section.settings.accent_pink | default: '#5E0A02' }};
    --cp-bg: {{ section.settings.bg_color | default: '#FAFAF7' }};
    --cp-card-bg: #FFFFFF;
    --cp-card-border: rgba(10, 10, 15, 0.08);
    --cp-card-shadow: 0 1px 2px rgba(10, 10, 15, 0.04), 0 8px 24px rgba(10, 10, 15, 0.05);
    --cp-card-shadow-hover: 0 2px 4px rgba(10, 10, 15, 0.05), 0 16px 36px rgba(176, 195, 250, 0.10);
    --cp-text: #0A0A0F;
    --cp-text-muted: #525252;
    --cp-radius: 16px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--cp-bg);
    color: var(--cp-text);
    {%- comment -%}
      Contact-scoped FOUT fix (2026-06-28). The global --font-body--family
      stack is `Inter, 'Inter Fallback', sans-serif`, and 'Inter Fallback'
      (Arial @ size-adjust:107%) measures ~10.5% TALLER than Inter at the
      H1 size (measured in Chrome on this page) — so the pre-Inter fallback
      paints oversized and the heading visibly shrinks when Inter swaps in.
      Plain Arial matches Inter within ~1-2%, so use it as the fallback
      here. Scoped to this section deliberately, to verify before touching
      the site-wide font system in snippets/fonts.liquid.
    {%- endcomment -%}
    font-family: 'CasaContactInter', Arial, sans-serif;
    position: relative;
    overflow: hidden;
    {%- comment -%}
      Heading-scale dropdown: merchant picks H1-H6 from Theme Settings -> Typography.
      Title pulls size/weight/lh/ls/case via these vars. Form + text-block headings
      pulled from h2/h3 brand scales (independent dropdowns).
    {%- endcomment -%}
    {%- assign _cp_title_h    = section.settings.cp_heading_level       | default: 'h1' -%}
    {%- assign _cp_form_h     = section.settings.cp_form_heading_level  | default: 'h3' -%}
    {%- assign _cp_text_h     = section.settings.cp_text_heading_level  | default: 'h4' -%}
    --cp-title-fs:   var(--font-{{ _cp_title_h }}--size);
    --cp-title-fw:   var(--font-{{ _cp_title_h }}--weight);
    --cp-title-lh:   var(--font-{{ _cp_title_h }}--line-height);
    --cp-title-ls:   var(--font-{{ _cp_title_h }}--letter-spacing);
    --cp-title-case: var(--font-{{ _cp_title_h }}--case);
    --cp-form-fs:    var(--font-{{ _cp_form_h }}--size);
    --cp-form-fw:    var(--font-{{ _cp_form_h }}--weight);
    --cp-text-fs:    var(--font-{{ _cp_text_h }}--size);
    --cp-text-fw:    var(--font-{{ _cp_text_h }}--weight);
  }

  .casa-contactp *,
  .casa-contactp *::before,
  .casa-contactp *::after {
    box-sizing: border-box;
  }

  {%- comment -%}
    Headings are directly targeted by base.css `h1/h2/h3 { font-family:
    var(--font-hN--family) }`, and a directly-applied rule beats the
    section font-family above (which only reaches them via inheritance).
    So the FOUT fix must be re-asserted on the headings themselves —
    otherwise the H1 (the element that visibly jumps) keeps the
    miscalibrated 'Inter Fallback'. Same plain-Arial fallback as the
    section rule. Scoped to this section.
  {%- endcomment -%}
  .casa-contactp h1,
  .casa-contactp h2,
  .casa-contactp h3,
  .casa-contactp h4,
  .casa-contactp h5,
  .casa-contactp h6 {
    font-family: 'CasaContactInter', Arial, sans-serif;
  }

  /* ---- Container ---- */
  .casa-contactp__container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ---- Hero ---- */
  .casa-contactp__hero {
    text-align: center;
    margin-bottom: 64px;
  }

  .casa-contactp__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cp-accent-purple);
    border: 1px solid rgba(176, 195, 250, 0.25);
    background: rgba(176, 195, 250, 0.08);
    margin-bottom: 24px;
  }

  /* Title — base layout. Color/gradient applied by --current /
     --text / --shimmer modifier classes (see below). Heading scale
     pulled from Theme Settings -> Typography via the dropdown. */
  .casa-contactp__title {
    font-size:      var(--cp-title-fs, clamp(32px, 5vw, 56px));
    font-weight:    var(--cp-title-fw, 700);
    line-height:    var(--cp-title-lh, 1.1);
    letter-spacing: var(--cp-title-ls, -0.02em);
    text-transform: var(--cp-title-case, none);
    margin: 0 0 16px;
  }

  /* Legacy "current" mode — bespoke white-to-muted gradient, kept
     for back-compat. background-image (not the shorthand) so
     background-clip:text holds. See casa-brand-tokens skill Bug 1. */
  .casa-contactp__title--current {
    background-image: linear-gradient(135deg, #0A0A0F 0%, #525252 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  /* --text and --shimmer modifiers add no color of their own —
     the parallel .text-grad-text / .text-grad-shimmer brand
     classes (assets/casa-buttons.css) paint via brand tokens. */

  .casa-contactp__subtitle {
    font-size: clamp(16px, 2vw, 20px);
    color: var(--cp-text-muted);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ---- Card Grid ---- */
  .casa-contactp__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 64px;
  }

  @media (max-width: 768px) {
    /* These overrides are intentionally section-prefixed (.casa-contactp …)
       so they out-specify the base .casa-contactp__card* rules defined later
       in this stylesheet — equal specificity + later source order would
       otherwise let the desktop sizes win on mobile. */

    /* Tighter page gutters — match FAQ page rhythm */
    .casa-contactp .casa-contactp__container { padding: 0 16px; }

    /* 2-up cards: Email + Phone side by side, Address spans full width */
    .casa-contactp .casa-contactp__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 36px;
    }
    .casa-contactp .casa-contactp__card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    /* Compact card: icon + title on one row, content below */
    .casa-contactp .casa-contactp__card {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      column-gap: 12px;
      row-gap: 8px;
      padding: 16px 14px;
    }
    .casa-contactp .casa-contactp__card-icon {
      width: 36px;
      height: 36px;
      margin-bottom: 0;
    }
    .casa-contactp .casa-contactp__card-icon svg { width: 18px; height: 18px; }
    /* Keep the eyebrow smaller than the value on mobile too (11px all-caps
       label) — a 15px eyebrow would out-size the value and re-invert the
       hierarchy we just flipped on desktop. */
    .casa-contactp .casa-contactp__card-title { font-size: 11px; margin: 0; }
    .casa-contactp .casa-contactp__card-content {
      grid-column: 1 / -1;
      font-size: 13px;
      line-height: 1.55;
      overflow-wrap: anywhere;
    }
    /* Email + Phone in the narrow 2-up cards: WRAP, never nowrap. The card
       now has overflow:hidden (for the gradient hairline corners), so a
       nowrap email would clip mid-character ("support@casadilum…") at
       280–320px instead of overflowing — a clipped value reads as broken.
       12px + break-anywhere wraps the email cleanly at the "@". */
    .casa-contactp .casa-contactp__card:not(:last-child) .casa-contactp__card-content {
      font-size: 12px;
      overflow-wrap: anywhere;
    }

    /* Tighten vertical rhythm so the section isn't so tall on phones */
    .casa-contactp .casa-contactp__hero { margin-bottom: 32px; }
    .casa-contactp .casa-contactp__divider { margin-bottom: 36px; }
    .casa-contactp .casa-contactp__form-section { margin-bottom: 36px; }
  }

  /* ---- Contact Card ---- */
  .casa-contactp__card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--cp-card-bg);
    border: 1px solid var(--cp-card-border);
    border-radius: var(--cp-radius);
    padding: 30px 26px;
    overflow: hidden;
    box-shadow: var(--cp-card-shadow);
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  /* Brand gradient top hairline — revealed on hover. Quiet chrome:
     surface stays white, brand color appears only on interaction. */
  .casa-contactp__card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #B0C3FA, #5E0A02, #F2FFA0);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .casa-contactp__card:hover {
    border-color: rgba(176, 195, 250, 0.2);
    transform: translateY(-3px);
    box-shadow: var(--cp-card-shadow-hover);
  }
  .casa-contactp__card:hover::before { opacity: 1; }

  .casa-contactp__card-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    background: linear-gradient(135deg, rgba(176, 195, 250, 0.15), rgba(94, 10, 2, 0.1));
    border: 1px solid rgba(176, 195, 250, 0.15);
  }

  .casa-contactp__card-icon svg {
    width: 22px;
    height: 22px;
    stroke: var(--cp-accent-purple);
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Eyebrow — the category label (Email / Phone / Address). Small,
     quiet, uppercase; the value below is now the focal line. */
  .casa-contactp__card-title {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cp-text-muted);
    margin: 0 0 8px;
  }

  /* Value — the actual contact info, promoted to ink (was muted grey)
     so the thing a visitor wants reads first. */
  /* Supporting lines (hours, street address) — regular weight + muted.
     The FOCAL value is emphasized two ways the merchant controls:
     (1) wrapping it in the rich-text Bold button (<strong>), or
     (2) it being a link (email / phone). Both render bold ink below. */
  .casa-contactp__card-content {
    font-size: 15px;
    font-weight: 400;
    line-height: 1.65;
    color: var(--cp-text-muted);
  }

  .casa-contactp__card-content strong {
    font-weight: 600;
    color: var(--cp-text);
  }

  /* Email / phone are links — show a PERSISTENT purple underline (not just
     on hover) so they read as tappable without any interaction, and so the
     link isn't identified by colour alone (WCAG 1.4.1). Ink text keeps the
     value as the focal line; the underline signals "interactive". Hover /
     keyboard focus deepens the text to the brand purple. Works for mouse,
     touch, and keyboard with no hover-only state. */
  /* Link text is brand purple + a persistent underline, so email / phone
     read as tappable at rest — no hover needed, and not colour-alone
     (WCAG 1.4.1). base.css forces `p a { text-decoration-color:
     currentcolor !important }`, so we colour the TEXT purple and let the
     underline inherit that via currentColor (no !important fight). The
     static ink address stays plain, so underlined-purple = tap it, plain
     ink = read it. Hover / keyboard focus thickens the underline (avoids
     the pink-on-white contrast fail for 16px text). */
  .casa-contactp__card-content a {
    font-weight: 600;
    color: var(--cp-accent-purple);
    text-decoration-line: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    transition: text-decoration-thickness 0.15s ease;
  }

  /* base.css styles `:is(p a:hover)` (link hover) with a high-specificity
     :is() selector that flips the colour to ink and drops the underline —
     making the link look like plain text on hover. That base rule isn't
     !important, so a targeted !important here wins without a specificity
     war. Keep the link purple + underlined on hover; thicken the underline
     as the hover cue. */
  .casa-contactp__card-content a:hover,
  .casa-contactp__card:hover .casa-contactp__card-content a,
  .casa-contactp__card-content a:focus-visible {
    color: var(--cp-accent-purple) !important;
    text-decoration-line: underline !important;
    text-decoration-color: var(--cp-accent-purple) !important;
    text-decoration-thickness: 2px;
  }

  .casa-contactp__card-content p {
    margin: 0 0 8px;
  }
  .casa-contactp__card-content p:last-child {
    margin-bottom: 0;
  }

  /* ---- Form Embed ---- */
  .casa-contactp__form-section {
    margin-bottom: 64px;
    max-width: 680px;
    margin-inline: auto;
  }

  .casa-contactp__form-wrapper {
    position: relative;
    background: var(--cp-card-bg);
    border: 1px solid var(--cp-card-border);
    border-radius: var(--cp-radius);
    padding: 48px 40px;
    box-shadow: var(--cp-card-shadow);
  }

  /* Gorgias contact-form iframe defaults to display:inline + 300px.
     Force it to fill the wrapper so the form isn't squeezed on mobile. */
  .casa-contactp [data-gorgias-contact-form-uid] {
    width: 100%;
  }
  .casa-contactp [data-gorgias-contact-form-uid] iframe {
    display: block;
    width: 100% !important;
    min-width: 100%;
    border: 0;
  }

  .casa-contactp__form-heading {
    font-size:   var(--cp-form-fs, clamp(22px, 3vw, 28px));
    font-weight: var(--cp-form-fw, 600);
    color: var(--cp-text);
    margin: 0 0 8px;
    text-align: center;
  }

  .casa-contactp__form-sub {
    font-size: 15px;
    color: var(--cp-text-muted);
    margin: 0 0 32px;
    text-align: center;
  }

  @media (max-width: 768px) {
    .casa-contactp__form-wrapper {
      padding: 24px 14px;
    }
    .casa-contactp__text-block {
      padding: 28px 20px;
      margin-bottom: 32px;
    }
  }

  /* ---- Text Block (SMS notice etc) ---- */
  .casa-contactp__text-block {
    position: relative;
    background: var(--cp-card-bg);
    border: 1px solid var(--cp-card-border);
    border-radius: var(--cp-radius);
    padding: 40px 36px;
    box-shadow: var(--cp-card-shadow);
    margin-bottom: 48px;
    text-align: center;
  }

  .casa-contactp__text-block-heading {
    font-size:   var(--cp-text-fs, clamp(20px, 2.5vw, 24px));
    font-weight: var(--cp-text-fw, 600);
    color: var(--cp-text);
    margin: 0 0 16px;
  }

  .casa-contactp__text-block-content {
    font-size: 15px;
    line-height: 1.7;
    color: var(--cp-text-muted);
    max-width: 640px;
    margin: 0 auto;
  }

  .casa-contactp__text-block-content a {
    color: var(--cp-accent-purple);
    text-decoration: none;
  }

  .casa-contactp__text-block-content a:hover {
    color: var(--cp-accent-pink);
  }

  .casa-contactp__text-block-content p {
    margin: 0 0 8px;
  }
  .casa-contactp__text-block-content p:last-child {
    margin-bottom: 0;
  }

  /* ---- Glow accents ---- */
  .casa-contactp__glow {
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.05;
    pointer-events: none;
    z-index: 0;
  }
  /* Decorative glow blobs use brand --c-purple / --c-pink tokens
     (rebrand-friendly). The accent_purple / accent_pink section
     settings remain in scope for: badge color, card hover border,
     card-icon stroke, link/hover colors. */
  .casa-contactp__glow--purple {
    background: var(--c-purple, #B0C3FA);
    top: -100px;
    left: -50px;
  }
  .casa-contactp__glow--pink {
    background: var(--c-pink, #5E0A02);
    bottom: -100px;
    right: -50px;
  }

  .casa-contactp__hero,
  .casa-contactp__grid,
  .casa-contactp__form-section,
  .casa-contactp__text-block {
    position: relative;
    z-index: 1;
  }

  /* ---- Divider ---- */
  .casa-contactp__divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(176, 195, 250, 0.2), rgba(94, 10, 2, 0.15), transparent);
    margin: 0 0 64px;
    border: none;
  }

  /* Respect reduced-motion: no card lift / hairline fade. */
  @media (prefers-reduced-motion: reduce) {
    .casa-contactp__card,
    .casa-contactp__card::before,
    .casa-contactp__card-content a {
      transition: none;
    }
    .casa-contactp__card:hover {
      transform: none;
    }
  }
</style>

<section class="casa-contactp" data-section-id="{{ section.id }}">
  {%- comment -%} Ambient glow orbs {%- endcomment -%}
  <div class="casa-contactp__glow casa-contactp__glow--purple"></div>
  <div class="casa-contactp__glow casa-contactp__glow--pink"></div>

  <div class="casa-contactp__container">

    {%- comment -%} ===== HERO ===== {%- endcomment -%}
    <div class="casa-contactp__hero">
      {%- if section.settings.badge_text != blank -%}
        <span class="casa-contactp__badge">{{ section.settings.badge_text }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        {%- assign cp_title_style = section.settings.cp_title_style | default: 'current' -%}
        <h1 class="casa-contactp__title casa-contactp__title--{{ cp_title_style }}{% if cp_title_style == 'shimmer' %} text-grad-shimmer{% elsif cp_title_style == 'text' %} text-grad-text{% endif %}">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="casa-contactp__subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} ===== CONTACT CARDS ===== {%- endcomment -%}
    {%- assign cards = section.blocks | where: 'type', 'contact_card' -%}
    {%- if cards.size > 0 -%}
      <div class="casa-contactp__grid">
        {%- for block in cards -%}
          <div class="casa-contactp__card" {{ block.shopify_attributes }}>
            <div class="casa-contactp__card-icon">
              {%- case block.settings.icon -%}
                {%- when 'email', 'mail' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                {%- when 'phone' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                {%- when 'location' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                {%- when 'clock' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {%- when 'message' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg>
                {%- when 'heart' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                {%- else -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              {%- endcase -%}
            </div>
            {%- if block.settings.title != blank -%}
              <h3 class="casa-contactp__card-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.content != blank -%}
              <div class="casa-contactp__card-content">{{ block.settings.content }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <hr class="casa-contactp__divider">

    {%- comment -%} ===== FORM EMBEDS ===== {%- endcomment -%}
    {%- assign forms = section.blocks | where: 'type', 'form_embed' -%}
    {%- for block in forms -%}
      <div class="casa-contactp__form-section" {{ block.shopify_attributes }}>
        <div class="casa-contactp__form-wrapper">
          {%- if block.settings.heading != blank -%}
            <h2 class="casa-contactp__form-heading">{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.subheading != blank -%}
            <p class="casa-contactp__form-sub">{{ block.settings.subheading }}</p>
          {%- endif -%}
          {{ block.settings.custom_liquid }}
        </div>
      </div>
    {%- endfor -%}

    {%- comment -%} ===== TEXT BLOCKS ===== {%- endcomment -%}
    {%- assign texts = section.blocks | where: 'type', 'text_block' -%}
    {%- for block in texts -%}
      <div class="casa-contactp__text-block" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}
          <h2 class="casa-contactp__text-block-heading">{{ block.settings.heading }}</h2>
        {%- endif -%}
        {%- if block.settings.content != blank -%}
          <div class="casa-contactp__text-block-content">{{ block.settings.content }}</div>
        {%- endif -%}
      </div>
    {%- endfor -%}

  </div>

  {%- comment -%} App blocks {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}
      <div class="casa-app-block" {{ block.shopify_attributes }}>
        {% render block %}
      </div>
    {%- endif -%}
  {%- endfor -%}
</section>

