      "default": "#FAFAF7"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#FAFAF7"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title font size",
      "min": 16,
      "max": 48,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title font weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "300"
    },
    {
      "type": "header",
      "content": "Glass Card Style"
    },
    {
      "type": "color",
      "id": "glass_bg",
      "label": "Glass background color",
      "info": "Base color for the glassmorphic card"
