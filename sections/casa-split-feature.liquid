      "type": "range",
      "id": "glass_radius",
      "label": "Glass card radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 12,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Casa Split Feature"
    }
  ]
}
