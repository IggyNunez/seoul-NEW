{% stylesheet %}
/* ══════════════════════════════════════════════════════════════════════════
   CDL SPLIT FEATURE — Full-bleed day/night cards with glassmorphic overlay
   ══════════════════════════════════════════════════════════════════════════ */

.cdl-split-section,
.cdl-split {
  background: var(--cdl-split-bg, transparent);
}
.cdl-split-section {
  padding: 0 !important;
  margin: 0;
}

.cdl-split {
  display: flex;
  gap: var(--cdl-split-gap, 0px);
  padding: var(--cdl-split-padding, 0px);
  min-height: var(--cdl-split-h, 600px);
}

/* Wide-desktop cap: at >= 1600px viewport, an aspect-ratio: 1/1 card would
   become 800px+ tall AND make the section taller than a typical viewport,
   while also forcing object-fit: cover to severely crop portrait product
   imagery (e.g. the mirror by-day photo). Cap the inner row so each card
   stays at a manageable size. The outer .cdl-split-section keeps the same
   background so the gutters blend with the Ink surface. */
@media (min-width: 1600px) {
  .cdl-split {
    max-width: 1600px;
    margin-left: auto;
    margin-right: auto;
  }
}

/* Short-viewport cap — the same mechanism as the wide-desktop cap above,
   driven by height instead of width: narrow the row so an
   aspect-ratio: 1/1 card can't outgrow the window under the sticky
   header (--casa-vh-fit, casa-base.css). The vertical allowance is the
   section's OWN padding var — --cdl-split-padding pads all four sides
   and is a live merchant slider, so a hardcoded allowance would drift
   the moment the slider moves. Measured before the fix: 720px cards vs
   a 720px window at 1512×820 and 540px at 1280×640 — the day/night pair
   could never sit fully in frame. Gutters land on the section
   background, exactly like the ≥1600px cap. min-height re-clamps the
   merchant's floor only when the window is smaller than it. */
@media (min-width: 750px) {
  .cdl-split {
    max-width: min(100%, calc((var(--casa-vh-fit, 100svh) - 2 * var(--cdl-split-padding, 0px)) * 2 + var(--cdl-split-gap, 0px) + 2 * var(--cdl-split-padding, 0px)));
    margin-left: auto;
    margin-right: auto;
    min-height: min(var(--cdl-split-h, 600px), calc(var(--casa-vh-fit, 100svh) - 2 * var(--cdl-split-padding, 0px)));
  }
}

/* ── Card base ── */
.cdl-split__card {
  flex: 1;
  position: relative;
  overflow: hidden;
  cursor: pointer;
  border-radius: var(--cdl-split-radius, 0px);
}

/* ── Desktop aspect ratio (when not "auto") ── */
.cdl-split__card {
  aspect-ratio: var(--cdl-split-desktop-ratio);
}
/* When auto, min-height drives sizing instead of aspect-ratio */
.cdl-split[style*="--cdl-split-desktop-ratio: auto"] .cdl-split__card {
  aspect-ratio: unset;
}

/* ── Media — fills entire card ── */
.cdl-split__media {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
  transition: transform 0.6s ease;
}

/* Belt-and-suspenders: if a device blocks muted autoplay (Low Power Mode,
   reduced-data) the video stays paused and iOS would paint its native centre
   play button on this decorative day/night media. Suppress the WebKit media-
   control pseudo-elements so the poster image is the clean fallback, never a
   stray button. ONE RULE PER PSEUDO-ELEMENT — a comma-grouped list is dropped
   in its entirety by any selector the engine doesn't recognise, and
   `-overlay-play-button` (Chromium-only) would otherwise poison the iOS-only
   `-start-playback-button` rule. */
.cdl-split__media::-webkit-media-controls {
  display: none !important;
  -webkit-appearance: none;
  appearance: none;
}
.cdl-split__media::-webkit-media-controls-enclosure { display: none !important; }
.cdl-split__media::-webkit-media-controls-panel { display: none !important; }
.cdl-split__media::-webkit-media-controls-play-button { display: none !important; }
.cdl-split__media::-webkit-media-controls-start-playback-button {
  display: none !important;
  -webkit-appearance: none;
  appearance: none;
}
.cdl-split__media::-webkit-media-controls-overlay-play-button { display: none !important; }

.cdl-split__card:hover .cdl-split__media {
  transform: scale(1.05);
}

/* Poster image fades out when video plays (JS sets opacity:0) */
.cdl-split__media--poster {
  z-index: 1;
  transition: opacity 0.6s ease, transform 0.6s ease;
}

/* ── Fallback gradients when no image/video ── */
.cdl-split__fallback {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.cdl-split__fallback--day {
  background: linear-gradient(135deg, #f5f5f5 0%, #e0e0e0 50%, #d4d4d8 100%);
}

.cdl-split__fallback--night {
  background: linear-gradient(135deg, #0a0a14 0%, #1a1a2e 50%, #2d1b4e 100%);
}

/* ── Dark overlay — subtle gradient from bottom for text legibility ── */
.cdl-split__overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, var(--cdl-split-overlay, 0.3)) 0%,
    rgba(0, 0, 0, calc(var(--cdl-split-overlay, 0.3) * 0.4)) 40%,
    rgba(0, 0, 0, calc(var(--cdl-split-overlay, 0.3) * 0.1)) 100%
  );
  transition: background 0.4s ease;
  pointer-events: none;
}

.cdl-split__card:hover .cdl-split__overlay {
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.7) 0%,
    rgba(0, 0, 0, 0.25) 50%,
    rgba(0, 0, 0, 0.1) 100%
  );
}

/* ── No-overlay modifier ── */
.cdl-split--no-overlay .cdl-split__overlay {
  display: none;
}

/* ── Content — positioned bottom-left, snug to card edge so the
   pill is a small badge sitting low in the frame, not a billboard
   floating mid-card. The pill itself uses align-items: flex-start
   so it shrinks to its text width (no full-row span). */
.cdl-split__content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 3;
  padding: 16px 20px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

/* ── Glassmorphic pill — compact: padding hugs the text so the
   pill is sized to its contents, not to a generous card layout.
   Compact pill rule (memory: overlay-ui-must-be-compact-glass-pills).
   ── */
.cdl-split__glass {
  background: var(--cdl-split-glass-bg, rgba(255, 255, 255, 0.12));
  backdrop-filter: blur(var(--cdl-split-glass-blur, 12px));
  -webkit-backdrop-filter: blur(var(--cdl-split-glass-blur, 12px));
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: var(--cdl-split-glass-radius, 12px);
  padding: 8px 14px;
  /* Hard-lock the pill width to its visible content. fit-content
     forces the box to be exactly as wide as the widest currently-
     rendered child (title only in default state, title-or-subtitle
     whichever is wider on hover). Without this, even with the
     subtitle at display:none, residual flex sizing or external CSS
     could allow the pill to extend past the text — what the
     merchant kept seeing in their screenshots. */
  width: fit-content;
  max-width: 100%;
  transition: background 0.35s ease, transform 0.35s ease;
}

.cdl-split__card:hover .cdl-split__glass,
.cdl-split__card:focus-within .cdl-split__glass,
.cdl-split__card.is-tap-expanded .cdl-split__glass {
  /* Darken on hover so the revealed white subtitle text reads
     cleanly against bright product photos (the marble day photo
     drowned out white text on a whitened glass before).
     .is-tap-expanded covers the mobile tap-toggle path. */
  background: rgba(0, 0, 0, 0.55);
  transform: translateY(-4px);
}

/* ── Title ── */
.cdl-split__title {
  font-size: var(--cdl-split-title-size, 28px);
  font-weight: var(--cdl-split-title-weight, 700);
  color: var(--cdl-split-title-color, #ffffff);
  margin: 0;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

/* Italic-gradient <em> accent — LARGER (1.15em) per merchant brand
   directive. Italic 600 weight + brand gradient. line-height: 1
   prevents the bigger em from inflating the pill's height. */
.cdl-split__title em {
  font-size: 1.15em;
  font-style: italic;
  font-weight: 600;
  line-height: 1;
  background-image: var(--grad-text, linear-gradient(90deg, #B0C3FA, #5E0A02, #F2FFA0));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}

/* ── Subtitle — hidden by default, revealed on hover ──
   Default: display:none so the pill sizes only to the title.
   Hover: display:block so the pill expands to fit subtitle width.
   The :hover glass-background rule below darkens the pill so the
   subtitle text stays readable against bright product photos
   (white-on-marble was invisible before). */
.cdl-split__sub {
  display: none;
  font-size: 13px;
  color: rgba(255, 255, 255, 0.92);
  margin: 6px 0 0 0;
  line-height: 1.4;
  /* Subtle drop shadow keeps the text legible even when the glass
     pill is over a bright photo and the merchant's glass_bg setting
     is fully transparent. Compositor-only; no layout impact. */
  text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
}

.cdl-split__card:hover .cdl-split__sub,
.cdl-split__card:focus-within .cdl-split__sub,
.cdl-split__card.is-tap-expanded .cdl-split__sub {
  /* One-line reveal — subtitle expands to a single line with ellipsis
     truncation if it exceeds the available width. The pill grows
     horizontally to fit the subtitle (via fit-content), capped at
     max-width: 100% so it never overflows the card.
     .is-tap-expanded mirrors :hover for touch devices (JS-toggled
     on first tap; second tap navigates). */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ── Full-card clickable link ── */
.cdl-split__link {
  position: absolute;
  inset: 0;
  z-index: 5;
}

/* ══════════════════════════════════════════════════════════════════════════
   RESPONSIVE
   ══════════════════════════════════════════════════════════════════════════ */

@media (max-width: 900px) {
  .cdl-split {
    flex-direction: column;
    min-height: auto;
  }

  /* Two-column mobile: keep side-by-side */
  .cdl-split--two-col-mobile {
    flex-direction: row;
  }

  .cdl-split__card {
    min-height: 280px;
    aspect-ratio: var(--cdl-split-mobile-ratio, 16/9);
  }

  /* Two-col mobile: each card takes half width */
  .cdl-split--two-col-mobile .cdl-split__card {
    flex: 1;
    min-height: 240px;
  }

  /* Tablet / landscape phone (601-900px) single-col mobile: match
     desktop's subtle frosted glass aesthetic — backdrop-blur + thin
     white border, NO heavy dark background. Image is the hero;
     the glass is a refined frosted caption strip. */
  .cdl-split__content {
    padding: 16px;
  }

  .cdl-split__glass {
    padding: 10px 14px;
    border-radius: 10px;
  }

  .cdl-split__title {
    font-size: 18px;
    line-height: 1.15;
    margin: 0 0 2px 0;
  }

  /* Subtitle on single-col mobile (one wide card per row): kept
     visible but clamped to 2 lines + smaller font so the glass
     doesn't grow tall. */
  .cdl-split__sub {
    font-size: 12px;
    line-height: 1.35;
    opacity: 1;
    margin-top: 2px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-height: calc(1.35em * 2);
  }

  /* TWO-COL MOBILE specifically (tablet / landscape phone, 601-900px):
     when the cards are side-by-side, each card is roughly 400-450px
     wide. The shared glass styles above (12/16 padding, 20px title,
     13px 2-line subtitle, dark glass) made the glass cover ~40% of
     the card height — the merchant reported the photos were getting
     swallowed.

     Tighten everything for the half-width context:
       - content padding: 20 → 5/10 (asymmetric — minimal top/bottom
         to slam the glass against the card's bottom edge so it stops
         eating into the mirror image area; modest horizontal so the
         pill has a small inset from the card sides)
       - glass padding: 12/16 → 7/12 (smaller pill)
       - glass border-radius: 12 → 8 (matches smaller pill)
       - title: 20 → 14 (fits the narrower card)
       - subtitle: 13 / 2-line → 11 / 1-line (single tight caption)
       - glass background forced to rgba(0,0,0,0.4) for legibility
         over both the bright day-image and the dark portal-image
       - max-width: 80% so the glass can't span the whole card width
         (leaves visible image to the right of the pill, prevents the
         "billboard sitting on top of the photo" feel)
     Result: glass at ~15% of card height pinned to the bottom edge,
     photo as the visual hero. */
  .cdl-split--two-col-mobile .cdl-split__content {
    padding: 5px 10px;
  }
  /* Glass matches DESKTOP aesthetic across every device size — no
     forced dark background. The merchant explicitly asked for the
     desktop subtle frosted-glass look to be used on phones and
     tablets too, instead of the heavy rgba(0,0,0,0.4) tint I'd
     introduced for "legibility". Pure backdrop-filter blur + the
     existing 1px white border carries the readability on its own
     because the title sits over the BLURRED underlying photo (the
     blur softens contrast so white text reads cleanly on either
     the bright day photo OR the teal/dark portal photo).

     Compact pill size:
       - padding: 6/12 (was 7/12) — shaves another 2px of height
       - border-radius: 8 (matches the pill scale)
       - max-width: 65% (was 80%) — pill is now a tight badge, not
         a billboard; image is the visual hero
       - NO `background` override — inherits the merchant's JSON
         `glass_bg: "rgba(0,0,0,0)"` (transparent) so it matches
         desktop's subtle treatment exactly */
  /* IDENTICAL-LOOKING GLASS PILLS for both day and night cards.
     The merchant's day_title is plain "Mirror by day." but
     night_title is HTML <em>Portal by night.</em> — that em tag
     gets italic + 800 weight (gradient text-grad-text class),
     which has wider glyph metrics per character. At the same
     font-size the night title is ~25% wider than the day title,
     so it was wrapping to two lines while the day title fit one.

     Fix: lock both pills to:
       - FIXED width (70% of card) → both pills are visually
         identical width on the same row regardless of title
       - SMALLER font (12px) → both titles fit one line at the
         narrowest target viewport (320px Android)
       - white-space: nowrap → no chance of wrapping ever
       - text-overflow: ellipsis → defensive truncation if a
         future merchant title is too long
     Tested mentally:
       320px Android: card ~145px, glass 70%=101px, padding 24=
         text area 77px. "Portal by night." italic 800 at 12px
         ≈ 80px text, overflows by ~3px → ellipsis truncates.
       375px iPhone SE: card 171px, glass 120px, text area 96px.
         All titles fit.
       768px iPad: card 360px, glass 252px — plenty of room. */
  /* Match the desktop "compact pill" look on mobile two-col:
       - width: fit-content inherited from base (no 70% lock)
       - title scales fluidly via clamp so 22px is achievable on
         ≥420px viewports and shrinks to 15px on tight 320px Android
       - no white-space: nowrap; let the title wrap if a future
         merchant title is too long (better than ellipsis cut)
       - title margin / line-height match desktop's compact spec */
  .cdl-split--two-col-mobile .cdl-split__glass {
    padding: 6px 12px;
    border-radius: 8px;
    box-sizing: border-box;
  }
  .cdl-split--two-col-mobile .cdl-split__title {
    font-size: clamp(14px, 4vw, 20px);
    line-height: 1.15;
    margin: 0;
  }
  /* Make sure the <em> styling inside the night title doesn't
     introduce a different line-height or padding that would
     make the night pill look taller. */
  .cdl-split--two-col-mobile .cdl-split__title em {
    line-height: inherit;
  }
  /* CRITICAL: display:none on two-col-mobile subtitle default state.
     The single-col mobile rule above sets display: -webkit-box on
     .cdl-split__sub which would otherwise apply here too — and even
     with max-height:0 / opacity:0 the rendered subtitle's natural
     inline width was driving the pill's width: fit-content sizing.
     The merchant kept seeing the pill extend past the title text on
     mobile; this is the actual root cause (the invisible subtitle
     was dictating fit-content). display:none truly removes the
     subtitle from layout so the pill hugs the title only. Hover /
     focus rule below re-enables display: block. */
  .cdl-split--two-col-mobile .cdl-split__sub {
    display: none;
    max-height: 0;
    opacity: 0;
    margin-top: 0;
    overflow: hidden;
  }
  .cdl-split--two-col-mobile .cdl-split__card:hover .cdl-split__sub,
  .cdl-split--two-col-mobile .cdl-split__card:focus-within .cdl-split__sub,
  .cdl-split--two-col-mobile .cdl-split__card.is-tap-expanded .cdl-split__sub {
    /* Mobile reveal: subtitle expands to ONE LINE with ellipsis
       truncation if it overflows. Restores both display AND
       max-height (base mobile rule sets both to hidden/0). The
       night subtitle has been shortened in the merchant JSON to
       fit at this width, so the truncation is rarely triggered;
       it's defensive for future longer titles. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: normal;
    font-size: 12px;
    line-height: 1.35;
    max-height: 1.5em;
    margin-top: 4px;
    opacity: 1;
  }
}

@media (max-width: 600px) {
  /* Cards reach closer to viewport edges on mobile so the imagery dominates.
     Cap horizontal section padding + card gap to small values; merchant's
     smaller values pass through untouched, larger ones clamp. */
  .cdl-split {
    padding-left: min(var(--cdl-split-padding, 0px), 10px);
    padding-right: min(var(--cdl-split-padding, 0px), 10px);
  }

  .cdl-split--two-col-mobile {
    gap: min(var(--cdl-split-gap, 0px), 8px);
  }

  .cdl-split__card {
    min-height: 220px;
  }

  .cdl-split--two-col-mobile .cdl-split__card {
    min-height: 200px;
  }

  /* Glass overlay shrunk so the underlying image (mirror photo /
     RGB portal animation) stays visible behind it. The merchant
     reported the previous 14/18px padding + 20px font-size + 13px
     subtitle (with a 2-3 line wrapping subtitle) made the glass
     cover ~35% of the card height, hiding too much of the photo.
     New values land the glass at ~22% of card height with a 2-line
     subtitle clamp. */
  .cdl-split__content {
    padding: 16px;
  }

  /* Two-col mobile: minimal padding pins the glass to the card's
     bottom edge so it stops cutting into the mirror image area. */
  .cdl-split--two-col-mobile .cdl-split__content {
    padding: 4px 8px;
  }

  .cdl-split__glass {
    padding: 10px 14px;
    border-radius: 10px;
  }

  /* Two-col mobile glass — subtle dark tint for readability over
     bright/varied imagery (the merchant's day card has a light photo,
     the night card has a teal/dark photo, so a single neutral dark
     glass reads consistently on both). The default `glass_bg` from
     the merchant's JSON is rgba(0,0,0,0) (fully transparent), which
     relies on backdrop-filter alone — on the day-image's bright wall
     the title becomes hard to read. !important overrides the var. */
  /* ≤600px two-col-mobile: same compact-pill treatment as the
     parent ≤900px rule. width: fit-content inherited from base,
     no 70% lock. Pill hugs title text just like the desktop
     version the merchant signed off on. */
  .cdl-split--two-col-mobile .cdl-split__glass {
    padding: 5px 10px;
    border-radius: 8px;
    box-sizing: border-box;
  }

  /* Two-col mobile: tighter card gap so the pair reads as a deliberate
     side-by-side, not two cards stranded on a wide row. */
  .cdl-split--two-col-mobile {
    gap: 10px !important;
  }

  .cdl-split__title {
    font-size: 18px;
    line-height: 1.1;
    margin: 0 0 2px 0;
  }

  .cdl-split--two-col-mobile .cdl-split__title {
    /* ≤600px: scale fluidly between 14-18px so "Mirror by day." and
       "Portal by night." both fit comfortably in the half-width card
       at 320-600px viewports. No nowrap — wrap is preferable to
       ellipsis truncation if a future title is too long. */
    font-size: clamp(14px, 4vw, 18px);
    line-height: 1.15;
    margin: 0;
  }
  .cdl-split--two-col-mobile .cdl-split__title em {
    line-height: inherit;
  }

  .cdl-split__sub {
    font-size: 12px;
    line-height: 1.35;
    /* Clamp subtitle to two lines so the glass can't grow tall on
       longer descriptions ("Sixteen million colours. Music-reactive…").
       Excess wraps to ellipsis. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-height: calc(1.35em * 2);
  }

  /* ≤600px two-col-mobile: subtitle stays hidden by default; on
     hover (irrelevant — no hover on touch), focus, or tap-expand
     (JS) reveals as ONE LINE with ellipsis truncation. Smaller
     font here for the narrower cards. */
  .cdl-split--two-col-mobile .cdl-split__card:hover .cdl-split__sub,
  .cdl-split--two-col-mobile .cdl-split__card:focus-within .cdl-split__sub,
  .cdl-split--two-col-mobile .cdl-split__card.is-tap-expanded .cdl-split__sub {
    font-size: 11px;
    line-height: 1.35;
    max-height: 1.5em;
  }
}

@media (prefers-reduced-motion: reduce) {
  .cdl-split__media,
  .cdl-split__glass,
  .cdl-split__overlay,
  .cdl-split__sub {
    transition: none !important;
  }
}
{% endstylesheet %}
