{%- comment -%}
  Seoul Glow Lab — Split Feature Section
  Two full-bleed cards side-by-side: image/video fills entire card,
  glassmorphic title overlay revealed on hover.
  Day/Night concept for mirror by day / portal by night.
{%- endcomment -%}

{%- comment -%} Auto-hide when no images or videos exist {%- endcomment -%}
{%- if section.settings.day_image == blank and section.settings.night_image == blank and section.settings.day_video == blank and section.settings.night_video == blank and request.design_mode == false -%}
  <style>#shopify-section-{{ section.id }} { display: none !important; }</style>
{%- endif -%}

{%- liquid
  assign s = section.settings
  assign min_h = s.min_height | default: 600

  # Pre-2026-05-17 defaulted to "Mirror by Day / Portal by Night" + smart-mirror
  # subtitle — bled onto non-mirror products that adopt this section.
  assign day_title    = s.day_title
  assign day_sub      = s.day_subtitle
  assign night_title  = s.night_title
  assign night_sub    = s.night_subtitle

  assign desktop_ratio = s.desktop_ratio | default: ''
  assign mobile_ratio  = s.mobile_ratio | default: ''
  assign show_overlay  = s.show_overlay
  assign mobile_cols   = s.mobile_columns | default: ''

  assign day_has_video = false
  assign day_has_ext   = false
  if s.day_video != blank
    assign day_has_video = true
  endif
  if s.day_video_url != blank
    assign day_has_ext = true
  endif

  assign night_has_video = false
  assign night_has_ext   = false
  if s.night_video != blank
    assign night_has_video = true
  endif
  if s.night_video_url != blank
    assign night_has_ext = true
  endif
-%}

<section
  class="cdl-split{% if mobile_cols == '2' %} cdl-split--two-col-mobile{% endif %}{% unless show_overlay %} cdl-split--no-overlay{% endunless %}"
  id="cdl-split-{{ section.id }}"
  style="
    --cdl-split-h: {{ min_h }}px;
    --cdl-split-desktop-ratio: {{ desktop_ratio }};
    --cdl-split-mobile-ratio: {{ mobile_ratio }};
    --cdl-split-padding: {{ s.section_padding | default: 0 }}px;
    --cdl-split-gap: {{ s.card_gap | default: 0 }}px;
    --cdl-split-radius: {{ s.card_radius | default: 0 }}px;
    --cdl-split-bg: {{ s.section_bg | default: '#0A0A0F' }};
    --cdl-split-overlay: {{ s.overlay_opacity | default: 30 | divided_by: 100.0 }};
    --cdl-split-title-color: {{ s.title_color | default: '#FAFAF7' }};
    --cdl-split-sub-color: {{ s.subtitle_color | default: '#FAFAF7' }};
    --cdl-split-title-size: {{ s.title_size | default: 28 }}px;
    --cdl-split-title-weight: {{ s.title_weight | default: '300' }};
    --cdl-split-glass-blur: {{ s.glass_blur | default: 12 }}px;
    --cdl-split-glass-radius: {{ s.glass_radius | default: 12 }}px;
    {%- if s.glass_bg != blank %}--cdl-split-glass-bg: {{ s.glass_bg }};{% endif -%}
  "
>
  {%- comment -%} ── DAY SIDE ── {%- endcomment -%}
  <div class="cdl-split__card cdl-split__card--day">
    {%- comment -%} Video background {%- endcomment -%}
    {%- if day_has_video -%}
      <video class="cdl-split__media" data-casa-pause loop muted playsinline preload="none">
        {%- comment -%} MP4 only — never the .m3u8: Safari would pick the HLS
          stream and pay its adaptive-decode pipeline for a looping bg video
          (the homepage scroll jitter). Same fix as casa-video-demo.liquid. {%- endcomment -%}
        {%- for source in s.day_video.sources -%}
          {%- if source.mime_type == 'video/mp4' -%}
            <source data-src="{{ source.url }}" type="video/mp4">
          {%- endif -%}
        {%- endfor -%}
      </video>
    {%- elsif day_has_ext -%}
      <video class="cdl-split__media" data-casa-pause data-src="{{ s.day_video_url | escape }}" loop muted playsinline preload="none"></video>
    {%- endif -%}

    {%- comment -%} Image background {%- endcomment -%}
    {%- if s.day_image != blank -%}
      <img
        src="{{ s.day_image | image_url: width: 1400 }}"
        srcset="
          {{ s.day_image | image_url: width: 600 }} 600w,
          {{ s.day_image | image_url: width: 900 }} 900w,
          {{ s.day_image | image_url: width: 1400 }} 1400w
        "
        sizes="(max-width: 900px) 100vw, 50vw"
        width="{{ s.day_image.width | default: 1400 }}"
        height="{{ s.day_image.height | default: 1400 }}"
        alt="{{ day_title | escape }}"
        class="cdl-split__media cdl-split__media--img{% if day_has_video or day_has_ext %} cdl-split__media--poster{% endif %}"
        loading="lazy"
      >
    {%- endif -%}

    {%- comment -%} Fallback gradient when no image/video {%- endcomment -%}
    {%- if s.day_image == blank and day_has_video == false and day_has_ext == false -%}
      <div class="cdl-split__fallback cdl-split__fallback--day"></div>
    {%- endif -%}

    <div class="cdl-split__overlay"></div>

    <div class="cdl-split__content">
      <div class="cdl-split__glass">
        <h3 class="cdl-split__title">{{ day_title }}</h3>
        <p class="cdl-split__sub">{{ day_sub }}</p>
      </div>
    </div>

    {%- if s.day_link != blank -%}
      <a href="{{ s.day_link }}" class="cdl-split__link" aria-label="{{ day_title | escape }}"></a>
    {%- endif -%}
  </div>

  {%- comment -%} ── NIGHT SIDE ── {%- endcomment -%}
  <div class="cdl-split__card cdl-split__card--night">
    {%- if night_has_video -%}
      <video class="cdl-split__media" data-casa-pause loop muted playsinline preload="none">
        {%- comment -%} MP4 only — see day-side note. {%- endcomment -%}
        {%- for source in s.night_video.sources -%}
          {%- if source.mime_type == 'video/mp4' -%}
            <source data-src="{{ source.url }}" type="video/mp4">
          {%- endif -%}
        {%- endfor -%}
      </video>
    {%- elsif night_has_ext -%}
      <video class="cdl-split__media" data-casa-pause data-src="{{ s.night_video_url | escape }}" loop muted playsinline preload="none"></video>
    {%- endif -%}

    {%- if s.night_image != blank -%}
      <img
        src="{{ s.night_image | image_url: width: 1400 }}"
        srcset="
          {{ s.night_image | image_url: width: 600 }} 600w,
          {{ s.night_image | image_url: width: 900 }} 900w,
          {{ s.night_image | image_url: width: 1400 }} 1400w
        "
        sizes="(max-width: 900px) 100vw, 50vw"
        width="{{ s.night_image.width | default: 1400 }}"
        height="{{ s.night_image.height | default: 1400 }}"
        alt="{{ night_title | escape }}"
        class="cdl-split__media cdl-split__media--img{% if night_has_video or night_has_ext %} cdl-split__media--poster{% endif %}"
        loading="lazy"
      >
    {%- endif -%}

    {%- if s.night_image == blank and night_has_video == false and night_has_ext == false -%}
      <div class="cdl-split__fallback cdl-split__fallback--night"></div>
    {%- endif -%}

    <div class="cdl-split__overlay"></div>

    <div class="cdl-split__content">
      <div class="cdl-split__glass">
        <h3 class="cdl-split__title">{{ night_title }}</h3>
        <p class="cdl-split__sub">{{ night_sub }}</p>
      </div>
    </div>

    {%- if s.night_link != blank -%}
      <a href="{{ s.night_link }}" class="cdl-split__link" aria-label="{{ night_title | escape }}"></a>
    {%- endif -%}
  </div>
</section>

<script>
(function() {
  var root = document.getElementById('cdl-split-{{ section.id }}');
  if (!root) return;

  /* Save-Data / slow-network / reduced-motion: drop videos entirely.
     The static poster image stays as the fallback — same visual content,
     no degradation. Matches the casa-hero data-casa-lazy-video pattern. */
  var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var saveData = (navigator.connection && navigator.connection.saveData) === true;
  var slowNet = navigator.connection && /2g|slow-2g/.test(navigator.connection.effectiveType || '');
  if (reducedMotion || saveData || slowNet) {
    root.querySelectorAll('video.cdl-split__media').forEach(function(v) { v.remove(); });
    return;
  }

  /* Fade poster once video plays */
  root.querySelectorAll('.cdl-split__card').forEach(function(card) {
    var video = card.querySelector('video.cdl-split__media');
    var poster = card.querySelector('.cdl-split__media--poster');
    if (!video || !poster) return;
    video.addEventListener('playing', function() {
      poster.style.opacity = '0';
    }, { once: true });
  });

  /* Lazy-load: defer the actual video download until the section is
     within 200px of the viewport. Cuts ~3.7 MB from the homepage payload
     for visitors who don't scroll past the bestseller carousel above.
     The <video> ships with preload="none" and no src — only data-src.
     On first intersection we copy data-src → src on the video (or its
     <source> children) and call .load() to kick the fetch. */
  /* PLAYBACK OWNER: assets/casa-offscreen-pause.js (data-casa-pause on the
     <video>) — plays in view / pauses off-screen from real geometry. This
     script only LAZY-LOADS the bytes: copy data-src → src 200px before the
     section enters view so the buffer gets a head start. The old inline owner
     here had an unguarded deferred retry ('canplay' → play(), {once:true})
     that restarted the video AFTER the off-screen pause when buffering
     finished late — the "keeps playing after you scroll past it" bug. */
  function loadVideo(video) {
    if (video.dataset.casaSplitLoaded) return;
    video.dataset.casaSplitLoaded = '1';
    video.muted = true;
    video.defaultMuted = true;
    video.playsInline = true;
    video.setAttribute('muted', '');
    video.setAttribute('playsinline', '');
    video.setAttribute('webkit-playsinline', '');
    if (video.dataset.src && !video.src) {
      video.src = video.dataset.src;
    }
    video.querySelectorAll('source[data-src]').forEach(function(source) {
      if (!source.src) source.src = source.dataset.src;
    });
    /* preload=none would defer the fetch until play(); with the src now
       assigned, auto lets the browser buffer ahead — the point of the
       200px head start. */
    video.preload = 'auto';
    video.load();
    /* The global owner's initial pass ran while this video had no src (its
       play() no-opped); re-gate now that it is loadable. */
    if (window.casa && window.casa.offscreenPauseRefresh) window.casa.offscreenPauseRefresh();
  }

  var obs = null;
  if ('IntersectionObserver' in window) {
    obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          loadVideo(e.target);
          obs.unobserve(e.target); /* load once; playback is the global owner's job */
        }
      });
    }, { rootMargin: '200px' });
    root.querySelectorAll('video.cdl-split__media').forEach(function(v) { obs.observe(v); });
  } else {
    /* No IntersectionObserver support — fall back to eager load so the
       section still works on ancient browsers. */
    root.querySelectorAll('video.cdl-split__media').forEach(function(v) {
      loadVideo(v);
    });
  }

  /* MOBILE TAP-TO-EXPAND
     ──────────────────────────────────────────────────────────────
     On touch devices :hover doesn't exist and :focus-within fires
     for ~1 frame before the tap's link navigation kicks in, so the
     subtitle never visibly expands. Implement a two-tap pattern:

       1st tap → preventDefault, add .is-tap-expanded class, pill
                 grows to show one-line subtitle. (Other cards in
                 the same section collapse.)
       2nd tap → navigate normally (link's default behavior).

     Detection: matchMedia('(hover: none)') is the canonical "this
     device has no hover capability" check — picks up touch phones,
     touch tablets, but skips desktops with touchscreens-that-also-
     have-a-mouse (those keep the laptop hover behavior). */
  if (window.matchMedia && window.matchMedia('(hover: none)').matches) {
    var cards = root.querySelectorAll('.cdl-split__card');
    cards.forEach(function(card) {
      var link = card.querySelector('.cdl-split__link');
      if (!link) return;
      link.addEventListener('click', function(e) {
        if (!card.classList.contains('is-tap-expanded')) {
          e.preventDefault();
          /* Collapse any other expanded card in this section so only
             one is open at a time. */
          cards.forEach(function(other) {
            if (other !== card) other.classList.remove('is-tap-expanded');
          });
          card.classList.add('is-tap-expanded');
        }
        /* Second tap: class is already on, default navigation proceeds. */
      });
    });
    /* Tap outside any card in this section → collapse. */
    var outsideHandler = function(e) {
      if (!e.target.closest('#shopify-section-{{ section.id }} .cdl-split__card')) {
        cards.forEach(function(c) { c.classList.remove('is-tap-expanded'); });
      }
    };
    document.addEventListener('click', outsideHandler);
  }

  /* Theme-editor cleanup: when the merchant removes/replaces this section
     in the editor, disconnect the observer so it stops referencing
     orphaned <video> nodes. Production traffic never hits this path. */
  document.addEventListener('shopify:section:unload', function(e) {
    if (e.target && e.target.id === 'shopify-section-{{ section.id }}' && obs) {
      obs.disconnect();
    }
  });
})();
</script>

