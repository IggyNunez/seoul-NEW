{% javascript %}
  class CasaOctaSizeV7 extends HTMLElement {
    connectedCallback() {
      if (this.initialized) return;
      this.initialized = true;
      this.options = Array.from(this.querySelectorAll('[data-v7-size-option]'));
      this.hotspots = Array.from(this.querySelectorAll('[data-v7-size-hotspot]'));
      this.labels = Array.from(this.querySelectorAll('[data-v7-size-label]'));
      this.statusPrimary = this.querySelector('[data-v7-size-status-primary]');
      this.statusSecondary = this.querySelector('[data-v7-size-status-secondary]');
      this.selectedRole = this.querySelector('[data-v7-size-selected-role]');
      this.selectedPrimary = this.querySelector('[data-v7-size-selected-primary]');
      this.selectedSecondary = this.querySelector('[data-v7-size-selected-secondary]');
      this.selectedPrice = this.querySelector('[data-v7-size-selected-price]');
      this.selectedCompare = this.querySelector('[data-v7-size-selected-compare]');
      this.selectedPlacement = this.querySelector('[data-v7-size-selected-placement]');
      this.selectedSaving = this.querySelector('[data-v7-size-selected-saving]');
      this.selectedBestseller = this.querySelector('[data-v7-size-selected-bestseller]');
      this.gift = this.querySelector('[data-v7-size-gift]');
      this.formVariant = this.querySelector('[data-v7-size-form-variant]');
      this.atc = this.querySelector('.casa-v7-size__atc');
      this.rail = this.querySelector('[data-v7-size-rail]');
      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      this.options.forEach((option) => option.addEventListener('click', () => this.select(option)));
      this.hotspots.forEach((hotspot) => hotspot.addEventListener('click', () => {
        const option = this.options.find((item) => item.dataset.v7SizeKey === hotspot.dataset.v7SizeHotspot);
        if (option) this.select(option);
      }));

      this.onVariantUpdate = (event) => {
        const variant = event.detail?.resource;
        if (!variant?.id) return;
        const option = this.options.find((item) => item.dataset.variantId === String(variant.id));
        if (option) this.activate(option);
      };
      document.addEventListener('variant:update', this.onVariantUpdate);

      const initialOption = this.options.find((item) => item.classList.contains('is-selected'));
      if (initialOption) this.updateState(initialOption);

      if ('ResizeObserver' in window) {
        this.resizeObserver = new ResizeObserver(() => {
          const activeOption = this.options.find((item) => item.classList.contains('is-selected'));
          if (activeOption) this.positionRail(activeOption);
        });
        this.resizeObserver.observe(this);
      }

      if ('IntersectionObserver' in window && !this.reducedMotion) {
        this.entranceObserver = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          window.setTimeout(() => this.classList.add('is-entered'), 180);
          this.entranceObserver.disconnect();
        }, { rootMargin: '120px 0px' });
        this.entranceObserver.observe(this);
      } else {
        this.classList.add('is-entered');
      }
    }

    disconnectedCallback() {
      document.removeEventListener('variant:update', this.onVariantUpdate);
      this.entranceObserver?.disconnect();
      this.resizeObserver?.disconnect();
      window.clearTimeout(this.switchTimer);
    }

    select(option) {
      this.activate(option);
      const title = option.dataset.variantTitle;
      const id = option.dataset.variantId;
      const purchase = document.querySelector(this.dataset.purchaseTarget || '#casa-octa-purchase');
      const radio = Array.from(purchase?.querySelectorAll('input[type="radio"]') || []).find((input) => input.value === title);
      const selectOption = Array.from(purchase?.querySelectorAll('select[name="id"] option') || []).find((item) => item.value === id);

      if (radio && !radio.checked) {
        radio.checked = true;
        radio.dispatchEvent(new Event('change', { bubbles: true }));
      } else if (!radio && selectOption) {
        selectOption.parentElement.value = id;
        selectOption.parentElement.dispatchEvent(new Event('change', { bubbles: true }));
      }

      this.dispatchEvent(new CustomEvent('casa:size-guide-select', { bubbles: true, detail: { variantId: id, title } }));
    }

    activate(option) {
      const key = option.dataset.v7SizeKey;
      if (this.pendingKey === key) return;
      if (this.dataset.selectedSize === key) {
        this.updateState(option);
        return;
      }

      window.clearTimeout(this.switchTimer);
      this.pendingKey = key;

      if (this.reducedMotion || !this.classList.contains('is-entered')) {
        this.updateState(option);
        this.pendingKey = '';
        return;
      }

      this.classList.add('is-switching');
      this.switchTimer = window.setTimeout(() => {
        this.updateState(option);
        requestAnimationFrame(() => this.classList.remove('is-switching'));
        this.pendingKey = '';
      }, 170);
    }

    updateState(option) {
      const key = option.dataset.v7SizeKey;
      this.dataset.selectedSize = key;

      this.options.forEach((item) => {
        const active = item === option;
        item.classList.toggle('is-selected', active);
        item.setAttribute('aria-pressed', String(active));
      });
      this.labels.forEach((item) => item.classList.toggle('is-selected', item.dataset.v7SizeLabel === key));
      this.hotspots.forEach((item) => item.setAttribute('aria-pressed', String(item.dataset.v7SizeHotspot === key)));

      if (this.statusPrimary) this.statusPrimary.textContent = option.dataset.variantSizePrimary || option.dataset.variantTitle;
      if (this.statusSecondary) this.statusSecondary.textContent = option.dataset.variantSizeSecondary || '';
      if (this.selectedRole) this.selectedRole.textContent = option.dataset.variantRole || '';
      if (this.selectedPrimary) this.selectedPrimary.textContent = option.dataset.variantSizePrimary || option.dataset.variantTitle;
      if (this.selectedSecondary) this.selectedSecondary.textContent = option.dataset.variantSizeSecondary || '';
      if (this.selectedPrice) this.selectedPrice.textContent = option.dataset.variantPrice || '';
      if (this.selectedPlacement) this.selectedPlacement.textContent = option.dataset.variantPlacement || '';

      this.toggleContent(this.selectedCompare, option.dataset.variantCompare);
      this.toggleContent(this.selectedSaving, option.dataset.variantSaving);
      if (this.selectedBestseller) this.selectedBestseller.hidden = option.dataset.variantShowBestseller !== 'true';
      if (this.gift) this.gift.hidden = option.dataset.variantShowGift !== 'true';

      if (this.formVariant) this.formVariant.value = option.dataset.variantId;
      if (this.atc) {
        const available = option.dataset.variantAvailable === 'true';
        this.atc.disabled = !available;
        const price = this.atc.querySelector('.add-to-cart-price .atc-price-num');
        if (price) price.textContent = option.dataset.variantPrice || '';
        const label = this.atc.querySelector('.add-to-cart-text__content > span > span:first-child');
        if (label) label.textContent = available ? option.dataset.variantAtcLabel : this.dataset.soldOutLabel;
        this.atc.setAttribute('aria-label', available ? `${option.dataset.variantAtcLabel} for ${option.dataset.variantPrice}` : `${option.dataset.variantSizePrimary} is sold out`);
      }

      this.positionRail(option);
    }

    toggleContent(element, content) {
      if (!element) return;
      element.textContent = content || '';
      element.hidden = !content;
    }

    positionRail(option) {
      if (!this.rail || !option) return;
      this.rail.style.height = `${option.offsetHeight}px`;
      this.rail.style.transform = `translateY(${option.offsetTop}px)`;
    }
  }

  if (!customElements.get('casa-octa-size-v7')) {
    customElements.define('casa-octa-size-v7', CasaOctaSizeV7);
  }
{% endjavascript %}

