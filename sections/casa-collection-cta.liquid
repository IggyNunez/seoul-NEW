{%- liquid
  assign title = section.settings.title | default: "Can't decide? <em>We'll help.</em>"
  assign subtitle = section.settings.subtitle | default: 'Tell us what room you are lighting and we will recommend the right pieces.'
  assign button_text = section.settings.button_text | default: 'Talk to Us →'
  assign button_link = section.settings.button_link | default: '/pages/contact-us'
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80

  # Color settings
  assign bg_color = section.settings.bg_color | default: '#0A0A0F'
  assign text_primary = section.settings.text_primary | default: '#FAFAF7'
  assign accent_primary = section.settings.accent_primary | default: '#B0C3FA'
  assign accent_secondary = section.settings.accent_secondary | default: '#5E0A02'
-%}

{%- comment -%}
  Heading-scale dropdown: merchant picks H1-H6 from Theme Settings -> Typography.
{%- endcomment -%}
{%- assign _colcta_title_h = section.settings.colcta_heading_level | default: 'h1' -%}
<section
  class="casa-col-cta"
  style="
    --cccta-pt: {{ padding_top }}px;
    --cccta-pb: {{ padding_bottom }}px;
    --cccta-bg: {{ bg_color }};
    --cccta-text: {{ text_primary }};
    --cccta-accent-1: {{ accent_primary }};
    --cccta-accent-2: {{ accent_secondary }};
    --cccta-title-fs:   var(--font-{{ _colcta_title_h }}--size);
    --cccta-title-fw:   var(--font-{{ _colcta_title_h }}--weight);
    --cccta-title-lh:   var(--font-{{ _colcta_title_h }}--line-height);
    --cccta-title-ls:   var(--font-{{ _colcta_title_h }}--letter-spacing);
    --cccta-title-case: var(--font-{{ _colcta_title_h }}--case);
  "
>
  <div class="casa-col-cta__glow"></div>

  <div class="casa-col-cta__container">
    <h2 class="casa-col-cta__title">{{ title }}</h2>
    {%- if subtitle != blank -%}
      <p class="casa-col-cta__subtitle">{{ subtitle }}</p>
    {%- endif -%}
    {%- if button_text != blank -%}
      {%- assign colcta_btn_treatment = section.settings.colcta_btn_treatment | default: 'featured' -%}
      <a href="{{ button_link }}" class="btn btn-{{ colcta_btn_treatment }} casa-col-cta__btn">
        {{ button_text }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Casa Collection CTA",
  "tag": "section",
  "class": "casa-collection-cta-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title (use <em>word</em> for italic gradient accent)",
      "default": "Can't decide? <em>We'll help.</em>"
    },
    {
      "type": "select",
      "id": "colcta_heading_level",
      "label": "Title heading scale",
      "info": "Pulls size, weight, line-height, letter-spacing, and case from Theme Settings → Typography.",
      "options": [
        { "value": "h1", "label": "Heading 1" },
        { "value": "h2", "label": "Heading 2" },
        { "value": "h3", "label": "Heading 3" },
        { "value": "h4", "label": "Heading 4" },
        { "value": "h5", "label": "Heading 5" },
        { "value": "h6", "label": "Heading 6" }
      ],
      "default": "h1"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Tell us what room you are lighting and we will recommend the right pieces."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "TALK TO US →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "colcta_btn_treatment",
      "label": "Button treatment",
      "info": "Brand-book button style. Featured (gradient) is rare per brand book — reserved for hero/launch CTAs.",
      "options": [
        { "value": "primary",            "label": "Primary — solid ink (light surface)" },
        { "value": "primary-on-dark",    "label": "Primary — solid white (dark surface)" },
        { "value": "secondary",          "label": "Secondary — outline (light surface)" },
        { "value": "secondary-on-dark",  "label": "Secondary — outline (dark surface)" },
        { "value": "tertiary",           "label": "Tertiary — underlined link" },
        { "value": "featured",           "label": "Featured — purple→pink gradient" }
      ],
      "default": "featured"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0A0A0F"
    },
    {
      "type": "color",
      "id": "text_primary",
      "label": "Text color",
      "default": "#FAFAF7"
    },
    {
      "type": "color",
      "id": "accent_primary",
      "label": "Primary accent",
      "default": "#B0C3FA"
    },
    {
      "type": "color",
      "id": "accent_secondary",
      "label": "Secondary accent",
      "default": "#5E0A02"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 80,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Casa Collection CTA"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.casa-col-cta {
  position: relative;
  background: var(--cccta-bg);
  padding: var(--cccta-pt) 60px var(--cccta-pb);
  text-align: center;
  overflow: hidden;
}

.casa-col-cta__glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 800px;
  height: 400px;
  background: radial-gradient(ellipse, rgba(176, 195, 250, 0.15) 0%, rgba(94, 10, 2, 0.08) 40%, transparent 70%);
  pointer-events: none;
}

.casa-col-cta__container {
  position: relative;
  z-index: 1;
  max-width: 600px;
  margin: 0 auto;
}

.casa-col-cta__title {
  /* Heading scale comes from Theme Settings -> Typography via the
     colcta_heading_level dropdown; fallbacks preserve old behavior. */
  font-size: var(--cccta-title-fs, var(--font-h2--size, 42px));
  font-weight: var(--cccta-title-fw, 300);
  line-height: var(--cccta-title-lh, 1.2);
  letter-spacing: var(--cccta-title-ls, -0.5px);
  text-transform: var(--cccta-title-case, none);
  color: var(--cccta-text);
  margin: 0 0 16px 0;
}

.casa-col-cta__title em {
  font-style: normal;
  /* background-image (not shorthand) — shorthand resets background-clip
     and breaks text-clipping. See casa-brand-tokens skill Bug 1. */
  background-image: linear-gradient(135deg, var(--cccta-accent-1), var(--cccta-accent-2));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-weight: 400;
}

.casa-col-cta__subtitle {
  font-size: 16px;
  line-height: 1.6;
  color: var(--cccta-text);
  opacity: 0.6;
  margin: 0 0 32px 0;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
}

/* Brand class .btn .btn-[treatment] provides display, padding, font,
   transition, text-transform, letter-spacing, hover. Section-specific
   override: deeper hover shadow + 2px lift, matches Collection CTA's
   visual emphasis. casa-col-cta__btn class kept as override hook. */
.casa-col-cta__btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 40px rgba(176, 195, 250, 0.4);
}

/* Responsive */
@media (max-width: 900px) {
  .casa-col-cta {
    padding-left: 24px;
    padding-right: 24px;
  }

  /* Title font-size driven by Horizon heading tokens (auto-swap on mobile). */
}

@media (max-width: 480px) {
  .casa-col-cta {
    padding-left: 16px;
    padding-right: 16px;
  }

  /* Title font-size handled by Horizon heading tokens. */

  .casa-col-cta__subtitle {
    font-size: 14px;
  }

  .casa-col-cta__btn {
    padding: 14px 28px;
    font-size: 14px;
  }

  .casa-col-cta__glow {
    width: 400px;
    height: 200px;
  }
}
{% endstylesheet %}
