{%- comment -%}
  Casa Product Comparison Table
  Side-by-side product comparison with specs, pricing, images.
  Supports manual product selection (blocks) or auto-populate from collection.
{%- endcomment -%}

{%- liquid
  assign mode = section.settings.mode | default: 'manual'
  assign cta_text = section.settings.cta_text | default: 'View Product'
  assign bg_style = section.settings.background_style | default: 'light'

  comment
    Build products_list from blocks (manual) or collection (auto)
  endcomment

  if mode == 'manual'
    assign col_count = 0
    for block in section.blocks
      if block.type == 'product_column' and block.settings.product != blank
        assign col_count = col_count | plus: 1
      endif
    endfor
  else
    assign coll = collections[section.settings.collection]
    assign plimit = section.settings.product_limit | default: 3
    assign col_count = 0
    if coll != blank
      for p in coll.products limit: plimit
        assign col_count = col_count | plus: 1
      endfor
    endif
  endif
-%}

{%- if col_count == 0 and request.design_mode == false -%}
  <style>#shopify-section-{{ section.id }} { display: none !important; }</style>
{%- endif -%}

<section
  class="casa-compare casa-compare--{{ bg_style }}"
  id="casa-compare-{{ section.id }}"
  style="
    --ccomp-accent: {{ section.settings.accent_color | default: '#B0C3FA' }};
    --ccomp-padding-top: {{ section.settings.padding_top | default: 100 }}px;
    --ccomp-padding-bottom: {{ section.settings.padding_bottom | default: 100 }}px;
    --ccomp-padding-mobile-top: {{ section.settings.padding_mobile_top | default: 60 }}px;
    --ccomp-padding-mobile-bottom: {{ section.settings.padding_mobile_bottom | default: 60 }}px;
    --ccomp-cols: {{ col_count | default: 3 }};
    {%- if section.settings.bg_color != blank %}--ccomp-bg: {{ section.settings.bg_color }};{% endif %}
    {%- if section.settings.text_color != blank %}--ccomp-text: {{ section.settings.text_color }};{% endif %}
    {%- if section.settings.title_color != blank %}--ccomp-title-color: {{ section.settings.title_color }};{% endif %}
    {%- comment -%}
      Heading-scale dropdown: merchant picks H1-H6 from Theme Settings -> Typography.
    {%- endcomment -%}
    {%- assign _ccomp_title_h = section.settings.ccomp_heading_level | default: 'h1' -%}
    --ccomp-title-fs:   var(--font-{{ _ccomp_title_h }}--size);
    --ccomp-title-fw:   var(--font-{{ _ccomp_title_h }}--weight);
    --ccomp-title-lh:   var(--font-{{ _ccomp_title_h }}--line-height);
    --ccomp-title-ls:   var(--font-{{ _ccomp_title_h }}--letter-spacing);
    --ccomp-title-case: var(--font-{{ _ccomp_title_h }}--case);
  "
>
  <div class="casa-compare__container">

    {%- comment -%} ── Header ── {%- endcomment -%}
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="casa-compare__header">
      {%- if section.settings.tag_text != blank -%}
        <span class="casa-compare__tag">{{ section.settings.tag_text }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="casa-compare__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="casa-compare__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
    {%- endif -%}

    {%- comment -%} ── Customer Product Picker ── {%- endcomment -%}
    {%- if section.settings.show_picker -%}
    <div class="casa-compare__picker" id="casa-compare-picker-{{ section.id }}">
      <div class="casa-compare__picker-slots" id="casa-compare-slots-{{ section.id }}"></div>
      <div class="casa-compare__picker-search">
        <input
          type="text"
          class="casa-compare__search-input"
          id="casa-compare-search-{{ section.id }}"
          placeholder="{{ section.settings.picker_placeholder | default: 'Search products to compare...' }}"
          autocomplete="off"
        >
        <div class="casa-compare__search-results" id="casa-compare-results-{{ section.id }}"></div>
      </div>
    </div>
    {%- endif -%}

    {%- if col_count > 0 and section.settings.show_picker != true -%}
    {%- comment -%} ── Scroll Wrapper ── {%- endcomment -%}
    <div class="casa-compare__scroll-wrap">
      <div class="casa-compare__grid">

        {%- comment -%} ── HEADER ROW: product cards ── {%- endcomment -%}
        <div class="casa-compare__cell casa-compare__cell--label casa-compare__cell--head"></div>

        {%- if mode == 'manual' -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'product_column' and block.settings.product != blank -%}
              {%- assign p = block.settings.product -%}
              {%- assign is_rec = block.settings.recommended -%}
              <div class="casa-compare__cell casa-compare__cell--head{% if is_rec %} casa-compare__cell--rec{% endif %}" {{ block.shopify_attributes }}>
                {%- if block.settings.badge != blank -%}
                  <span class="casa-compare__badge">{{ block.settings.badge }}</span>
                {%- endif -%}
                {%- if section.settings.show_image -%}
                  <div class="casa-compare__img">
                    {%- if p.featured_image != blank -%}
                      <img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ p.title | escape }}" loading="lazy" width="400" height="400">
                    {%- endif -%}
                  </div>
                {%- endif -%}
                <h3 class="casa-compare__product-title">{{ p.title }}</h3>
                {%- if section.settings.show_price -%}
                  <div class="casa-compare__price">
                    {%- if p.price_varies -%}
                      From {{ p.price_min | money }}
                    {%- else -%}
                      {{ p.price | money }}
                    {%- endif -%}
                    {%- if p.compare_at_price > p.price -%}
                      <span class="casa-compare__price--was">{{ p.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
                {%- if section.settings.show_rating -%}
                  <div class="casa-compare__rating">
                    {% render 'casa-judgeme-rating', product: p %}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for p in coll.products limit: plimit -%}
            <div class="casa-compare__cell casa-compare__cell--head">
              {%- if section.settings.show_image -%}
                <div class="casa-compare__img">
                  {%- if p.featured_image != blank -%}
                    <img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ p.title | escape }}" loading="lazy" width="400" height="400">
                  {%- endif -%}
                </div>
              {%- endif -%}
              <h3 class="casa-compare__product-title">{{ p.title }}</h3>
              {%- if section.settings.show_price -%}
                <div class="casa-compare__price">
                  {%- if p.price_varies -%}
                    From {{ p.price_min | money }}
                  {%- else -%}
                    {{ p.price | money }}
                  {%- endif -%}
                  {%- if p.compare_at_price > p.price -%}
                    <span class="casa-compare__price--was">{{ p.compare_at_price | money }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if section.settings.show_rating -%}
                <div class="casa-compare__rating">
                  {% render 'casa-judgeme-rating', product: p %}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endif -%}

        {%- comment -%} ── AUTO-PARSED SPEC ROWS (injected by JS) ── {%- endcomment -%}
        <div class="casa-compare__auto-specs" id="casa-compare-specs-{{ section.id }}"></div>

        {%- comment -%} ── CTA ROW ── {%- endcomment -%}
        {%- if section.settings.show_cta -%}
          <div class="casa-compare__cell casa-compare__cell--label"></div>
          {%- if mode == 'manual' -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'product_column' and block.settings.product != blank -%}
                {%- assign p = block.settings.product -%}
                {%- assign btn_text = block.settings.cta_text_override | default: cta_text -%}
                {%- assign ccomp_btn_treatment = section.settings.ccomp_btn_treatment | default: 'primary' -%}
                <div class="casa-compare__cell casa-compare__cell--cta{% if block.settings.recommended %} casa-compare__cell--rec{% endif %}">
                  <a href="{{ p.url }}" class="btn btn-{{ ccomp_btn_treatment }} casa-compare__btn{% if block.settings.recommended %} casa-compare__btn--rec{% endif %}">
                    {{ btn_text }}
                  </a>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- assign ccomp_btn_treatment = section.settings.ccomp_btn_treatment | default: 'primary' -%}
            {%- for p in coll.products limit: plimit -%}
              <div class="casa-compare__cell casa-compare__cell--cta">
                <a href="{{ p.url }}" class="btn btn-{{ ccomp_btn_treatment }} casa-compare__btn">{{ cta_text }}</a>
              </div>
            {%- endfor -%}
          {%- endif -%}
        {%- endif -%}

      </div>
    </div>

    {%- comment -%} Hidden spec data — JS parses this to build table rows ── {%- endcomment -%}
    <div class="casa-compare__spec-data" style="display:none" id="casa-compare-data-{{ section.id }}">
      {%- if mode == 'manual' -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'product_column' and block.settings.product != blank -%}
            {%- assign p = block.settings.product -%}
            {%- assign meta_specs = p.metafields.custom.product_page_specifications -%}
            <div class="casa-compare__spec-product" data-rec="{{ block.settings.recommended }}">
              {%- if meta_specs != blank -%}{{ meta_specs | metafield_tag }}{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for p in coll.products limit: plimit -%}
          {%- assign meta_specs = p.metafields.custom.product_page_specifications -%}
          <div class="casa-compare__spec-product" data-rec="false">
            {%- if meta_specs != blank -%}{{ meta_specs | metafield_tag }}{%- endif -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- else -%}
      {%- if request.design_mode -%}
        <p style="text-align:center;padding:40px;color:#999;">Add product blocks or select a collection to populate the comparison table.</p>
      {%- endif -%}
    {%- endif -%}

  </div>
</section>

<script>
(function(){
  var ROOT = document.getElementById('casa-compare-{{ section.id }}');
  if (!ROOT || ROOT.dataset.init) return;
  ROOT.dataset.init = '1';
  var sectionId = '{{ section.id }}';
  var MAX_COMPARE = {{ section.settings.max_compare | default: 3 }};

  /* ── Spec parser (shared) ── */
  function parseSpecsFromHtml(html) {
    var tmp = document.createElement('div');
    tmp.innerHTML = html || '';
    var specs = {};
    var items = tmp.querySelectorAll('li');
    if (items.length === 0) items = tmp.querySelectorAll('p');
    items.forEach(function(item) {
      var strong = item.querySelector('strong, b');
      var label = '', value = '';
      if (strong) {
        label = strong.textContent.replace(/:\s*$/, '').trim();
        value = item.textContent.replace(strong.textContent, '').replace(/^\s*:\s*/, '').trim();
      } else {
        var text = item.textContent, ci = text.indexOf(':');
        if (ci > 0 && ci < 40) { label = text.substring(0, ci).trim(); value = text.substring(ci + 1).trim(); }
      }
      if (label && value) specs[label] = value;
    });
    return specs;
  }

  /* ── Scroll indicator ── */
  var wrap = ROOT.querySelector('.casa-compare__scroll-wrap');
  if (wrap) {
    wrap.addEventListener('scroll', function() {
      var atEnd = wrap.scrollLeft + wrap.clientWidth >= wrap.scrollWidth - 10;
      wrap.classList.toggle('casa-compare__scroll-wrap--end', atEnd);
    });
  }

  /* ── Auto-parse spec metafields into table rows (only when merchant grid exists) ── */
  var dataEl = document.getElementById('casa-compare-data-' + sectionId);
  var specsEl = document.getElementById('casa-compare-specs-' + sectionId);

  var productDivs = dataEl ? dataEl.querySelectorAll('.casa-compare__spec-product') : [];
  /* (no return here — picker code must still run below) */

  /* Parse each product's specs — only when merchant grid is present */
  var allProducts = [];
  var allLabels = [];

  if (productDivs.length > 0) productDivs.forEach(function(div) {
    var specs = {};
    var isRec = div.getAttribute('data-rec') === 'true';

    /* Try <li> items first (most common for rich text metafields + descriptions) */
    var items = div.querySelectorAll('li');
    if (items.length === 0) {
      /* Fallback: try <p> tags */
      items = div.querySelectorAll('p');
    }

    items.forEach(function(item) {
      var strong = item.querySelector('strong, b');
      var label = '';
      var value = '';

      if (strong) {
        label = strong.textContent.replace(/:\s*$/, '').trim();
        var full = item.textContent;
        var labelInFull = strong.textContent;
        value = full.replace(labelInFull, '').replace(/^\s*:\s*/, '').trim();
      } else {
        var text = item.textContent;
        var colonIdx = text.indexOf(':');
        if (colonIdx > 0 && colonIdx < 40) {
          label = text.substring(0, colonIdx).trim();
          value = text.substring(colonIdx + 1).trim();
        }
      }

      if (label && value) {
        specs[label] = value;
        if (allLabels.indexOf(label) === -1) {
          allLabels.push(label);
        }
      }
    });

    allProducts.push({ specs: specs, rec: isRec });
  });

  /* Build grid rows (only when merchant grid present and has data) */
  if (allLabels.length > 0 && specsEl) {
  var colCount = allProducts.length;
  var grid = specsEl.closest('.casa-compare__grid');

  if (grid) {
  /* Insert rows before the CTA row (or at end of grid) */
  var ctaCells = grid.querySelectorAll('.casa-compare__cell--cta');
  var insertBefore = ctaCells.length > 0 ? ctaCells[0].previousElementSibling : null;
  /* Actually find the label cell before the first CTA */
  if (ctaCells.length > 0) {
    var prev = ctaCells[0];
    while (prev.previousElementSibling && !prev.previousElementSibling.classList.contains('casa-compare__cell--head')) {
      prev = prev.previousElementSibling;
    }
    insertBefore = prev;
  }

  allLabels.forEach(function(label, idx) {
    var alt = idx % 2 === 1;

    /* Label cell */
    var labelCell = document.createElement('div');
    labelCell.className = 'casa-compare__cell casa-compare__cell--label' + (alt ? ' casa-compare__cell--alt' : '');
    labelCell.textContent = label;

    if (insertBefore) {
      grid.insertBefore(labelCell, insertBefore);
    } else {
      grid.appendChild(labelCell);
    }

    /* Value cells per product */
    allProducts.forEach(function(prod) {
      var valCell = document.createElement('div');
      valCell.className = 'casa-compare__cell casa-compare__cell--val' +
        (prod.rec ? ' casa-compare__cell--rec' : '') +
        (alt ? ' casa-compare__cell--alt' : '');
      valCell.textContent = prod.specs[label] || '—';

      if (insertBefore) {
        grid.insertBefore(valCell, insertBefore);
      } else {
        grid.appendChild(valCell);
      }
    });
  });

  /* Remove the placeholder auto-specs div */
  specsEl.remove();
  } /* end if grid */
  } /* end if allLabels */

  /* ══════════════════════════════════════════════════════════════
     INTERACTIVE PICKER — customer searches & adds products
     ══════════════════════════════════════════════════════════════ */
  var searchInput = document.getElementById('casa-compare-search-' + sectionId);
  var resultsEl = document.getElementById('casa-compare-results-' + sectionId);
  var slotsEl = document.getElementById('casa-compare-slots-' + sectionId);

  if (searchInput && resultsEl && slotsEl) {
    var pickedProducts = [];
    var searchTimer = null;
    var abortCtrl = null;

    /* ── Search ── */
    searchInput.addEventListener('input', function() {
      var q = searchInput.value.trim();
      if (q.length < 2) { resultsEl.innerHTML = ''; resultsEl.classList.remove('is-open'); return; }
      clearTimeout(searchTimer);
      searchTimer = setTimeout(function() {
        if (abortCtrl) abortCtrl.abort();
        abortCtrl = new AbortController();
        fetch('/search/suggest.json?q=' + encodeURIComponent(q) +
          '&resources[type]=product&resources[limit]=6', { signal: abortCtrl.signal })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            var products = (data.resources && data.resources.results && data.resources.results.products) || [];
            if (products.length === 0) {
              resultsEl.innerHTML = '<div class="casa-compare__search-empty">No products found</div>';
            } else {
              resultsEl.innerHTML = products.map(function(p) {
                var picked = pickedProducts.some(function(pp) { return pp.handle === p.handle; });
                return '<button class="casa-compare__search-item' + (picked ? ' is-picked' : '') +
                  '" data-handle="' + p.handle + '" data-title="' + (p.title || '').replace(/"/g, '&quot;') +
                  '" data-image="' + (p.image || '') + '" data-price="' + (p.price || '') +
                  '"' + (picked ? ' disabled' : '') + '>' +
                  (p.image ? '<img src="' + p.image + '" alt="" width="40" height="40">' : '') +
                  '<span class="casa-compare__search-name">' + p.title + '</span>' +
                  '<span class="casa-compare__search-price">' + p.price + '</span>' +
                  (picked ? '<span class="casa-compare__search-check">✓</span>' : '') +
                  '</button>';
              }).join('');
            }
            resultsEl.classList.add('is-open');
          })
          .catch(function(e) { if (e.name !== 'AbortError') console.warn(e); });
      }, 250);
    });

    document.addEventListener('click', function(e) {
      if (!e.target.closest('.casa-compare__picker-search')) resultsEl.classList.remove('is-open');
    });

    /* ── Select product ── */
    resultsEl.addEventListener('click', function(e) {
      var btn = e.target.closest('.casa-compare__search-item');
      if (!btn || btn.disabled) return;
      if (pickedProducts.length >= MAX_COMPARE) { alert('Max ' + MAX_COMPARE + ' products. Remove one first.'); return; }

      var product = { handle: btn.dataset.handle, title: btn.dataset.title, image: btn.dataset.image,
        price_formatted: btn.dataset.price, specs: {}, rec: false, url: '/products/' + btn.dataset.handle };
      pickedProducts.push(product);
      searchInput.value = '';
      resultsEl.innerHTML = '';
      resultsEl.classList.remove('is-open');
      renderSlots();
      rebuildPickerGrid();

      /* Fetch specs via Section Rendering API */
      fetch('/products/' + product.handle + '?sections=casa-compare-fetch')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var html = data['casa-compare-fetch'] || '';
          var tmp = document.createElement('div');
          tmp.innerHTML = html;
          var script = tmp.querySelector('[data-casa-compare-product]');
          if (script) {
            try {
              var pd = JSON.parse(script.textContent);
              var idx = pickedProducts.findIndex(function(pp) { return pp.handle === product.handle; });
              if (idx > -1) {
                pickedProducts[idx].title = pd.title;
                pickedProducts[idx].image = pd.image;
                pickedProducts[idx].price_formatted = pd.price_varies ? 'From ' + pd.price_min_formatted : pd.price_formatted;
                pickedProducts[idx].compare_at = pd.compare_at_price > 0 ? pd.compare_at_price_formatted : '';
                pickedProducts[idx].rating = pd.rating;
                pickedProducts[idx].rating_count = pd.rating_count;
                pickedProducts[idx].url = pd.url;
                pickedProducts[idx].specs = parseSpecsFromHtml(pd.specs_html);
                rebuildPickerGrid();
              }
            } catch(err) { console.warn('Compare parse error:', err); }
          }
        }).catch(function(err) { console.warn('Compare fetch error:', err); });
    });

    /* ── Slots ── */
    function renderSlots() {
      slotsEl.innerHTML = pickedProducts.map(function(p, i) {
        return '<div class="casa-compare__slot">' +
          (p.image ? '<img src="' + p.image + '" alt="" width="24" height="24">' : '') +
          '<span>' + p.title + '</span>' +
          '<button class="casa-compare__slot-x" data-idx="' + i + '">&times;</button></div>';
      }).join('') + (pickedProducts.length < MAX_COMPARE ?
        '<div class="casa-compare__slot casa-compare__slot--add">+ Add (' + pickedProducts.length + '/' + MAX_COMPARE + ')</div>' : '');
    }

    slotsEl.addEventListener('click', function(e) {
      var btn = e.target.closest('.casa-compare__slot-x');
      if (!btn) return;
      pickedProducts.splice(parseInt(btn.dataset.idx, 10), 1);
      renderSlots();
      rebuildPickerGrid();
    });

    /* ── Rebuild grid from picked products ── */
    function rebuildPickerGrid() {
      var existingWrap = ROOT.querySelector('.casa-compare__scroll-wrap--picker');
      if (existingWrap) existingWrap.remove();

      if (pickedProducts.length === 0) return;

      var scrollWrap = document.createElement('div');
      scrollWrap.className = 'casa-compare__scroll-wrap casa-compare__scroll-wrap--picker';
      var grid = document.createElement('div');
      grid.className = 'casa-compare__grid';
      grid.style.setProperty('--ccomp-cols', pickedProducts.length);
      scrollWrap.appendChild(grid);

      var h = '';
      /* Header */
      h += '<div class="casa-compare__cell casa-compare__cell--label casa-compare__cell--head"></div>';
      pickedProducts.forEach(function(p) {
        h += '<div class="casa-compare__cell casa-compare__cell--head">' +
          '<div class="casa-compare__img"><img src="' + (p.image || '') + '" alt="" width="400" height="400"></div>' +
          '<h3 class="casa-compare__product-title">' + (p.title || '') + '</h3>' +
          '<div class="casa-compare__price">' + (p.price_formatted || '') +
            (p.compare_at ? ' <span class="casa-compare__price--was">' + p.compare_at + '</span>' : '') + '</div>' +
          (p.rating > 0 ? '<div class="casa-compare__rating"><span class="casa-compare__stars">★ ' + Math.round(p.rating) +
            '</span><span class="casa-compare__count">(' + (p.rating_count || 0) + ')</span></div>' : '') +
          '</div>';
      });

      /* Spec rows */
      var labels = [];
      pickedProducts.forEach(function(p) { Object.keys(p.specs || {}).forEach(function(k) { if (labels.indexOf(k) === -1) labels.push(k); }); });
      labels.forEach(function(label, idx) {
        var alt = idx % 2 === 1;
        h += '<div class="casa-compare__cell casa-compare__cell--label' + (alt ? ' casa-compare__cell--alt' : '') + '">' + label + '</div>';
        pickedProducts.forEach(function(p) {
          h += '<div class="casa-compare__cell casa-compare__cell--val' + (alt ? ' casa-compare__cell--alt' : '') + '">' + ((p.specs && p.specs[label]) || '—') + '</div>';
        });
      });

      /* CTA */
      h += '<div class="casa-compare__cell casa-compare__cell--label"></div>';
      pickedProducts.forEach(function(p) {
        h += '<div class="casa-compare__cell casa-compare__cell--cta"><a href="' + (p.url || '/products/' + p.handle) +
          '" class="btn btn-primary casa-compare__btn">View Product</a></div>';
      });

      grid.innerHTML = h;

      /* Insert after picker, before any existing merchant grid */
      var picker = ROOT.querySelector('.casa-compare__picker');
      var existingGrid = ROOT.querySelector('.casa-compare__scroll-wrap:not(.casa-compare__scroll-wrap--picker)');
      if (existingGrid) existingGrid.parentNode.insertBefore(scrollWrap, existingGrid);
      else if (picker) picker.parentNode.insertBefore(scrollWrap, picker.nextSibling);
      else ROOT.querySelector('.casa-compare__container').appendChild(scrollWrap);
    }

    renderSlots();
  }
})();
</script>

{% schema %}
{
  "name": "Casa Product Comparison",
  "tag": "section",
  "class": "casa-compare-section",
  "settings": [
    { "type": "header", "content": "Content" },
