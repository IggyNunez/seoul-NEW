{% stylesheet %}
/* ══════════════════════════════════════════════════════════════
   CASA PRODUCT COMPARISON TABLE
   ══════════════════════════════════════════════════════════════ */

.casa-compare {
  padding: var(--ccomp-padding-top, 80px) 0 var(--ccomp-padding-bottom, 80px);
  color: var(--ccomp-text);
}
.casa-compare--white { background: var(--ccomp-bg, #fff); color: var(--ccomp-text, var(--casa-border-on-ink)); }
.casa-compare--light { background: var(--ccomp-bg, var(--casa-paper)); color: var(--ccomp-text, var(--casa-ink)); }
.casa-compare--dark  { background: var(--ccomp-bg, var(--casa-ink)); color: var(--ccomp-text, #f0f0f0); }

.casa-compare__container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ── Header ── */
.casa-compare__header {
  text-align: center;
  margin-bottom: 40px;
}
.casa-compare__tag {
  display: inline-block;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--ccomp-accent, #B0C3FA);
  margin-bottom: 12px;
}
.casa-compare__title {
  /* Heading scale comes from Theme Settings -> Typography via the
     ccomp_heading_level dropdown; legacy clamp/weight preserved as fallback. */
  font-size: var(--ccomp-title-fs, clamp(24px, 4vw, 36px));
  font-weight: var(--ccomp-title-fw, 600);
  line-height: var(--ccomp-title-lh, 1.2);
  letter-spacing: var(--ccomp-title-ls, normal);
  text-transform: var(--ccomp-title-case, none);
  color: var(--ccomp-title-color, inherit);
  margin: 0 0 8px;
}
.casa-compare__subtitle {
  font-size: 15px;
  color: inherit;
  opacity: 0.6;
  margin: 0;
}

/* ── Scroll Wrapper ── */
.casa-compare__scroll-wrap {
  position: relative;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.casa-compare__scroll-wrap::-webkit-scrollbar { display: none; }

/* Scroll fade hint */
.casa-compare__scroll-wrap::after {
  content: '';
  position: sticky;
  right: 0;
  top: 0;
  bottom: 0;
  width: 40px;
  pointer-events: none;
  display: none;
}

/* ── Grid ── */
.casa-compare__grid {
  display: grid;
  grid-template-columns: 140px repeat(var(--ccomp-cols, 3), 1fr);
  gap: 0;
  min-width: 100%;
}

/* ── Cells ── */
.casa-compare__cell {
  padding: 14px 16px;
  display: flex;
  align-items: center;
  border-bottom: 1px solid rgba(0,0,0,0.06);
  font-size: 14px;
}
.casa-compare--dark .casa-compare__cell {
  border-bottom-color: rgba(255,255,255,0.08);
}

/* Label column */
.casa-compare__cell--label {
  font-size: 13px;
  font-weight: 500;
  opacity: 0.55;
  position: sticky;
  left: 0;
  z-index: 2;
}
.casa-compare--white .casa-compare__cell--label { background: var(--casa-paper); }
.casa-compare--light .casa-compare__cell--label { background: var(--casa-paper); }
.casa-compare--dark .casa-compare__cell--label  { background: var(--casa-ink); }

/* Alt rows */
.casa-compare__cell--alt {
  background: rgba(0,0,0,0.02);
}
.casa-compare--dark .casa-compare__cell--alt {
  background: rgba(255,255,255,0.03);
}
.casa-compare__cell--alt.casa-compare__cell--label {
  /* Override with section bg + tint */
}
.casa-compare--white .casa-compare__cell--alt.casa-compare__cell--label { background: var(--casa-paper); }
.casa-compare--light .casa-compare__cell--alt.casa-compare__cell--label { background: #f2f2f4; }
.casa-compare--dark .casa-compare__cell--alt.casa-compare__cell--label  { background: #0e0e14; }

/* Value cells */
.casa-compare__cell--val {
  font-weight: 600;
  font-size: 13px;
  justify-content: center;
  text-align: center;
}

/* Recommended column highlight */
.casa-compare__cell--rec {
  background: rgba(176, 195, 250, 0.04);
}
.casa-compare--dark .casa-compare__cell--rec {
  background: rgba(176, 195, 250, 0.1);
}

/* ── Header Cells (product cards) ── */
.casa-compare__cell--head {
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 20px 12px 16px;
  gap: 8px;
  border-bottom: 2px solid rgba(0,0,0,0.08);
  position: relative;
}
.casa-compare--dark .casa-compare__cell--head {
  border-bottom-color: rgba(255,255,255,0.1);
}
.casa-compare__cell--head.casa-compare__cell--rec {
  border-top: 3px solid var(--ccomp-accent, #B0C3FA);
  border-radius: 12px 12px 0 0;
}

/* Badge */
.casa-compare__badge {
  position: absolute;
  top: 8px;
  right: 8px;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  padding: 3px 8px;
  border-radius: 4px;
  background: var(--ccomp-accent, #B0C3FA);
  color: #fff;
}

/* Product image */
.casa-compare__img {
  width: 100%;
  max-width: 160px;
  aspect-ratio: 1 / 1;
  border-radius: 10px;
  overflow: hidden;
}
.casa-compare__img img {
  /* height: auto + aspect-ratio instead of height: 100% — the wrapper's
     height comes from its own aspect-ratio, and Safari 26 can fail to
     resolve a %-height against that (the /cart flat-thumbnail class;
     immune pattern from .cart-items__media-image in snippets/cart-products.liquid). */
  width: 100%;
  height: auto;
  aspect-ratio: 1 / 1;
  object-fit: cover;
}

/* Product title */
.casa-compare__product-title {
  font-size: var(--font-h5--size, 14px);
  font-weight: 600;
  margin: 0;
  line-height: 1.3;
}

/* Price */
.casa-compare__price {
  font-size: 15px;
  font-weight: 700;
}
.casa-compare__price--was {
  font-size: 12px;
  font-weight: 400;
  text-decoration: line-through;
  opacity: 0.5;
  margin-left: 6px;
}

/* Rating */
.casa-compare__rating {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 13px;
}
.casa-compare__stars {
  color: #fbbf24;
  font-weight: 600;
}
.casa-compare__count {
  opacity: 0.5;
  font-size: 12px;
}

/* ── CTA ── */
.casa-compare__cell--cta {
  padding: 16px;
  justify-content: center;
  border-bottom: none;
}
/* Brand class .btn .btn-[treatment] provides display, padding,
   border, radius, font, transition, text-transform, letter-spacing,
   hover. casa-compare__btn class kept as a hook for the --rec
   "recommended" variant + accent-color hover. */
.casa-compare__btn--rec {
  background: var(--ccomp-accent, #B0C3FA);
  border-color: var(--ccomp-accent, #B0C3FA);
  color: #fff;
}
.casa-compare__btn--rec:hover {
  opacity: 0.9;
}

/* ── Auto-specs placeholder (removed by JS after parsing) ── */
.casa-compare__auto-specs {
  display: contents;
}

/* ══════════════════════════════════════════════════════════════
   CUSTOMER PICKER
   ══════════════════════════════════════════════════════════════ */
.casa-compare__picker {
  margin-bottom: 24px;
}
.casa-compare__picker-slots {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
}
.casa-compare__slot {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px;
  background: rgba(0,0,0,0.05);
  border-radius: 20px;
  font-size: 13px;
  font-weight: 500;
}
.casa-compare--dark .casa-compare__slot { background: rgba(255,255,255,0.1); }
.casa-compare__slot img { width: 24px; height: 24px; border-radius: 4px; object-fit: cover; }
.casa-compare__slot-x {
  background: none; border: none; cursor: pointer; font-size: 16px;
  color: inherit; opacity: 0.5; padding: 0 2px; line-height: 1;
}
.casa-compare__slot-x:hover { opacity: 1; }
.casa-compare__slot--add {
  border: 1.5px dashed rgba(0,0,0,0.2);
  background: transparent;
  color: inherit;
  opacity: 0.5;
  font-size: 12px;
  cursor: default;
}
.casa-compare--dark .casa-compare__slot--add { border-color: rgba(255,255,255,0.2); }

/* Search input */
.casa-compare__picker-search { position: relative; max-width: 400px; }
.casa-compare__search-input {
  width: 100%;
  padding: 12px 16px;
  border: 1.5px solid rgba(0,0,0,0.12);
  border-radius: 10px;
  font-size: 14px;
  background: transparent;
  color: inherit;
  outline: none;
  transition: border-color 0.2s;
}
.casa-compare__search-input:focus { border-color: var(--ccomp-accent, #B0C3FA); }
.casa-compare--dark .casa-compare__search-input { border-color: rgba(255,255,255,0.15); }

/* Search results dropdown */
.casa-compare__search-results {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: var(--casa-paper);
  border: 1px solid rgba(0,0,0,0.1);
  border-radius: 10px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.12);
  z-index: 100;
  max-height: 320px;
  overflow-y: auto;
  display: none;
  margin-top: 4px;
}
.casa-compare--dark .casa-compare__search-results { background: #1a1a1f; border-color: rgba(255,255,255,0.1); }
.casa-compare__search-results.is-open { display: block; }

.casa-compare__search-item {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 10px 14px;
  border: none;
  background: transparent;
  cursor: pointer;
  text-align: left;
  font-size: 13px;
  color: inherit;
  transition: background 0.15s;
}
.casa-compare__search-item:hover { background: rgba(0,0,0,0.04); }
.casa-compare--dark .casa-compare__search-item:hover { background: rgba(255,255,255,0.06); }
.casa-compare__search-item.is-picked { opacity: 0.4; cursor: default; }
.casa-compare__search-item img { width: 40px; height: 40px; border-radius: 6px; object-fit: cover; flex-shrink: 0; }
.casa-compare__search-name { flex: 1; font-weight: 500; }
.casa-compare__search-price { font-size: 12px; opacity: 0.6; }
.casa-compare__search-check { color: var(--ccomp-accent, #B0C3FA); font-weight: 700; }
.casa-compare__search-empty { padding: 20px; text-align: center; font-size: 13px; opacity: 0.5; }

/* ══════════════════════════════════════════════════════════════
   RESPONSIVE
   ══════════════════════════════════════════════════════════════ */

@media (max-width: 749px) {
  .casa-compare {
    padding: var(--ccomp-padding-mobile-top, 48px) 0 var(--ccomp-padding-mobile-bottom, 48px);
  }
  .casa-compare__container { padding: 0 16px; }
  .casa-compare__header { margin-bottom: 24px; }

  .casa-compare__grid {
    min-width: calc(120px + (var(--ccomp-cols, 3) * 170px));
    grid-template-columns: 120px repeat(var(--ccomp-cols, 3), minmax(150px, 1fr));
  }
  .casa-compare__cell { padding: 10px 12px; font-size: 13px; }
  .casa-compare__cell--val { font-size: 12px; }
  .casa-compare__img { max-width: 120px; }
  .casa-compare__product-title { font-size: var(--font-h6--size, 13px); }
  .casa-compare__btn { padding: 8px 16px; font-size: 12px; }
}

@media (max-width: 480px) {
  .casa-compare__grid {
    grid-template-columns: 100px repeat(var(--ccomp-cols, 3), minmax(130px, 1fr));
    min-width: calc(100px + (var(--ccomp-cols, 3) * 140px));
  }
  .casa-compare__cell { padding: 8px 8px; }
  .casa-compare__cell--label { font-size: 11px; }
  .casa-compare__img { max-width: 100px; }
}
{% endstylesheet %}
