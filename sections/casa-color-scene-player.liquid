  "class": "casa-color-scene-player-section",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "layout_style", "label": "Layout style",
      "options": [
        { "value": "default",    "label": "Default — vertical stack" },
        { "value": "split-rail", "label": "Split-rail — left rail + photo stage" }
      ],
      "default": "default",
      "info": "Split-rail mirrors the AuraSphere scene player layout. Only takes effect at ≥1100px; smaller widths fall back to a horizontal chip row."
    },
    { "type": "header", "content": "Heading" },
    { "type": "text",  "id": "kicker",  "label": "Kicker (mono)", "default": "02 · THE THESIS" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading (use <em>word</em> for italic gradient accent)", "default": "One lamp. <em>One thousand moods.</em>" },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "1,000,000+ colors. 360+ animated effects. Drag the scrubber, hit auto, or jump to a scene — the photo crossfades, the room follows." },

    { "type": "header", "content": "Player behavior" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay on load", "default": true },
    { "type": "range",    "id": "scene_seconds", "label": "Seconds per scene", "min": 1.5, "max": 8, "step": 0.5, "default": 4, "unit": "s" },

    { "type": "header", "content": "Bottom-right counter" },
    { "type": "text", "id": "count_value", "label": "Big number", "default": "360+" },
    { "type": "text", "id": "count_label", "label": "Label",      "default": "animated effects on-board" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_paper",  "label": "Paper",         "default": "#FAFAF7" },
    { "type": "color", "id": "color_ink",    "label": "Ink",           "default": "#0A0A0F" },
    { "type": "color", "id": "color_purple", "label": "Accent purple", "default": "#B0C3FA" },
    { "type": "color", "id": "color_pink",   "label": "Accent pink",   "default": "#5E0A02" },
    { "type": "color", "id": "color_cyan",   "label": "Accent cyan",   "default": "#F2FFA0" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 160, "step": 4, "default": 24, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "default": 24, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "scene",
      "name": "Scene",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "scene_image", "label": "Scene photo (preferred)" },
        { "type": "url",          "id": "scene_image_url", "label": "External photo URL (fallback)" },
        { "type": "text",         "id": "scene_name",  "label": "Name", "default": "Cyan" },
        { "type": "select",       "id": "scene_kind",  "label": "Kind",
          "options": [
            { "value": "STATIC", "label": "STATIC — solid color" },
            { "value": "SCENE",  "label": "SCENE — saved preset"  },
            { "value": "EFFECT", "label": "EFFECT — animation"     }
          ],
          "default": "STATIC"
        },
        { "type": "color",        "id": "scene_hex",   "label": "Color hex", "default": "#F2FFA0" },
        { "type": "text",         "id": "scene_palette", "label": "Palette (comma-separated hex)",
          "info": "Optional. For multi-color scenes only — e.g. '#DC2626, #16A34A' for two-tone, '#FF0000, #FF7F00, #FFFF00, #00FF00, #0000FF, #9400D3' for rainbow. Overrides the bar/dot/HUD swatch with a gradient. Leave blank for single-color scenes." },
        { "type": "textarea",     "id": "scene_blurb", "label": "Blurb",     "default": "Solid color, locked. Dimmable on the remote dial." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Apollo · 6 verified scenes",
      "blocks": [
        { "type": "scene", "settings": { "scene_image_url": "https://casadilumo.com/cdn/shop/files/Apollo_Floor_Lamp_Scene_10_cyan.webp?width=2000", "scene_name": "Cyan",     "scene_kind": "STATIC", "scene_hex": "#06B6D4", "scene_blurb": "Solid color, locked. The full pole holds one cyan hue — dimmable on the remote dial." } },
        { "type": "scene", "settings": { "scene_image_url": "https://casadilumo.com/cdn/shop/files/Apollo_Floor_Lamp_Scene_17_orange.webp?width=2000", "scene_name": "Amber",    "scene_kind": "STATIC", "scene_hex": "#F97316", "scene_blurb": "Solid color. Warm cast across the wall — soft, cozy light for slow evenings and movie nights." } },
        { "type": "scene", "settings": { "scene_image_url": "https://casadilumo.com/cdn/shop/files/Apollo_Floor_Lamp_Scene_18_yellow.webp?width=2000", "scene_name": "Warm",     "scene_kind": "STATIC", "scene_hex": "#EAB308", "scene_blurb": "Solid color, dimmed yellow. Reading-nook warmth — pull the brightness down for a candlelight feel." } },
        { "type": "scene", "settings": { "scene_image_url": "https://casadilumo.com/cdn/shop/files/Apollo_Floor_Lamp_Scene_20_red-green.webp?width=2000", "scene_name": "Holiday", "scene_kind": "SCENE",  "scene_hex": "#DC2626", "scene_palette": "#DC2626, #16A34A", "scene_blurb": "Saved two-color preset. Red and green held in fixed bands. One of five user-saveable slots on the remote." } },
        { "type": "scene", "settings": { "scene_image_url": "https://casadilumo.com/cdn/shop/files/Apollo_Floor_Lamp_Scene_20_rgb.webp?width=2000", "scene_name": "Spectrum", "scene_kind": "SCENE",  "scene_hex": "#9333EA", "scene_palette": "#DC2626, #F97316, #EAB308, #16A34A, #06B6D4, #9333EA, #EC4899", "scene_blurb": "Static rainbow. Every band of the visible spectrum on the pole at once — no animation, just color." } },
        { "type": "scene", "settings": { "scene_image_url": "https://casadilumo.com/cdn/shop/files/Apollo_Floor_Lamp_Scene_08_multicolor_9_copy_60ad6f47-961a-4e02-8c04-c481fdd7c56a.webp?width=2000", "scene_name": "Color Flow", "scene_kind": "EFFECT", "scene_hex": "#A855F7", "scene_palette": "#06B6D4, #9333EA, #EC4899, #F97316, #EAB308", "scene_blurb": "Dynamic effect, slow speed. One of 360+ on-board animations — wave, ripple, fade, breathe, strobe, more." } }
      ]
    }
  ]
}
