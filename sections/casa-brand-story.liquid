{%- comment -%}
  Seoul Glow Lab Brand Story Section
  2-column layout with image and text content
{%- endcomment -%}

{%- comment -%} Auto-hide when no image or title exists {%- endcomment -%}
{%- if section.settings.image == blank and section.settings.title == blank and section.settings.video == blank and request.design_mode == false -%}
  <style>#shopify-section-{{ section.id }} { display: none !important; }</style>
{%- endif -%}

{%- liquid
  assign img_ratio = section.settings.image_ratio | default: 'auto'
  assign img_fit = section.settings.image_fit | default: 'cover'
  assign img_height = section.settings.image_height | default: 500
  assign img_pos = section.settings.image_position | default: 'left'

  # Poster = the still shown before the lazy-loaded video starts, and the
  # ONLY visual for reduced-motion / Save-Data visitors (the inline script
  # removes the <video> outright for them). The merchant Image still wins
  # when set; left blank it falls back to the Shopify video's own first
  # frame, so the pre-play still always matches the footage instead of
  # drifting to an unrelated photo. The external Video URL fallback has no
  # Shopify-side preview frame, so it keeps relying on the Image setting.
  assign poster_image = section.settings.image
  if poster_image == blank and section.settings.video != blank
    assign poster_image = section.settings.video.preview_image
  endif
-%}
<section
  class="casa-brand-story{% if img_pos == 'right' %} casa-brand-story--img-right{% endif %}"
  style="
    --cbs-ratio: {{ img_ratio }};
    --cbs-fit: {{ img_fit }};
    --cbs-height: {{ img_height }}px;
    --cbs-bg: {{ section.settings.bg_color | default: '#FAFAF7' }};
    --cbs-tag: {{ section.settings.tag_color | default: '#B0C3FA' }};
    --cbs-title: {{ section.settings.title_color | default: '#0A0A0F' }};
    --cbs-text: {{ section.settings.text_color | default: '#6b7280' }};
    --cbs-grad1: {{ section.settings.image_gradient_1 | default: '#B0C3FA' }};
    --cbs-grad2: {{ section.settings.image_gradient_2 | default: '#5E0A02' }};
    --cbs-gap: {{ section.settings.gap | default: 80 }}px;
    --cbs-img-radius: {{ section.settings.image_radius | default: 24 }}px;
    {%- if section.settings.override_spacing -%}
      --cbs-pt: {{ section.settings.padding_top | default: 120 }}px;
      --cbs-pb: {{ section.settings.padding_bottom | default: 120 }}px;
      {%- if section.settings.padding_top_mobile %}--cbs-pt-m: {{ section.settings.padding_top_mobile }}px;{% endif -%}
      {%- if section.settings.padding_bottom_mobile %}--cbs-pb-m: {{ section.settings.padding_bottom_mobile }}px;{% endif -%}
    {%- endif -%}
    {%- if section.settings.text_size_desktop %}--cbs-text-size: {{ section.settings.text_size_desktop }}px;{% endif -%}
    {%- if section.settings.text_size_mobile %}--cbs-text-size-m: {{ section.settings.text_size_mobile }}px;{% endif -%}
    --cbs-max-w: {% case section.settings.section_width %}{% when 'full' %}100%{% when 'wide' %}1600px{% when 'narrow' %}1200px{% else %}1400px{% endcase %};
  "
>
  <div class="casa-brand-story__inner">
    <div class="casa-brand-story__visual"
      style="{% if img_ratio != 'auto' %}aspect-ratio: {{ img_ratio }};{% else %}height: var(--cbs-height);{% endif %}"
    >
      {%- comment -%}
        Lazy-loaded video: ships with preload="none" + data-src instead of
        src. IntersectionObserver triggers loadVideo() + .play() at first
        intersection (rootMargin 200px). Cuts ~2.4 MB from cold homepage
        loads for users who bounce before reaching this section.

        Poster attribute KEPT here — unlike casa-split-feature and
        casa-styled-spaces (which have their poster image stacked ABOVE
        the video element via z-index), this section has the video at
        z-index:1 and the .casa-brand-story__poster image at z-index:0.
        Without the poster= attribute, the user would see a transparent
        video element until buffering completes. Restoring poster= adds
        one image fetch but ensures the visual stays coherent during
        the IntersectionObserver-triggered load window. Both the attribute
        and the stacked <img> read the same resolved poster_image, so the
        pre-play frame can never disagree with itself.
      {%- endcomment -%}
      {%- if section.settings.video != blank -%}
        <video class="casa-brand-story__video" data-casa-pause loop muted playsinline preload="none"
          {%- if poster_image != blank %} poster="{{ poster_image | image_url: width: 1200 }}"{% endif %}>
          {%- comment -%} MP4 only — never the .m3u8. Safari picks the first
            supported <source>, and the HLS stream costs its adaptive-decode
            pipeline for a looping bg video (the homepage scroll jitter).
            Chrome/Firefox can't play HLS in <video> at all. Same fix as
            casa-video-demo.liquid. {%- endcomment -%}
          {%- for source in section.settings.video.sources -%}
            {%- if source.mime_type == 'video/mp4' -%}
              <source data-src="{{ source.url }}" type="video/mp4">
            {%- endif -%}
          {%- endfor -%}
        </video>
      {%- elsif section.settings.video_url != blank -%}
        <video class="casa-brand-story__video" data-casa-pause data-src="{{ section.settings.video_url | escape }}" loop muted playsinline preload="none"
          {%- if poster_image != blank %} poster="{{ poster_image | image_url: width: 1200 }}"{% endif %}></video>
      {%- endif -%}
      {%- if poster_image != blank -%}
        <img
          src="{{ poster_image | image_url: width: 1200 }}"
          width="{{ poster_image.width }}"
          height="{{ poster_image.height }}"
          alt="{{ section.settings.title | strip_html | escape }}"
          class="{% if section.settings.video != blank or section.settings.video_url != blank %}casa-brand-story__poster{% endif %}"
          loading="lazy"
          decoding="async"
        >
      {%- endif -%}
    </div>

    <div class="casa-brand-story__content">
      {%- if section.settings.tag != blank -%}
        <span class="casa-brand-story__tag">{{ section.settings.tag }}</span>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="casa-brand-story__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="casa-brand-story__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_text != blank -%}
        {%- assign btn_treatment = section.settings.button_treatment | default: 'featured' -%}
        <a href="{{ section.settings.button_link }}" class="btn btn-{{ btn_treatment }} casa-brand-story__btn">
          {{ section.settings.button_text }}
          {%- render 'casa-icon', icon: 'arrow-right', size: 16 -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
(function() {
  /* Scope to THIS instance. document.querySelector handed every copy of this
     script the FIRST .casa-brand-story__visual in the document, so a second
     instance of the section never got its own data-src promoted — its video
     stayed at preload="none" with no src and sat on the poster forever. */
  var root = document.getElementById('shopify-section-{{ section.id }}');
  var visual = root && root.querySelector('.casa-brand-story__visual');
  if (!visual) return;
  var video = visual.querySelector('.casa-brand-story__video');
  if (!video) return;

  /* Save-Data / slow-network / reduced-motion: drop video entirely.
     Static poster image remains. Matches casa-hero / casa-split-feature
     / casa-styled-spaces pattern. */
  var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var saveData = (navigator.connection && navigator.connection.saveData) === true;
  var slowNet = navigator.connection && /2g|slow-2g/.test(navigator.connection.effectiveType || '');
  if (reducedMotion || saveData || slowNet) {
    video.remove();
    return;
  }

  var poster = visual.querySelector('.casa-brand-story__poster');
  if (poster) {
    video.addEventListener('playing', function() { poster.style.opacity = '0'; }, { once: true });
  }

  /* iOS Safari rejects programmatic muted autoplay unless the muted/inline
     PROPERTIES (not just the HTML attributes) are set before play() is called
     on a JS-assigned src. Without this the brand-story video stays paused
     until the visitor taps. Re-assert at play time too — some iOS builds drop
     the muted flag across load(). */
  /* PLAYBACK OWNER: assets/casa-offscreen-pause.js (data-casa-pause on the
     <video>) — plays in view / pauses off-screen from real geometry. This
     script only LAZY-LOADS the bytes: copy data-src → src 200px before the
     section enters view so the buffer gets a head start. The old inline owner
     here had an unguarded deferred retry ('canplay' → play(), {once:true})
     that restarted the video AFTER the off-screen pause when buffering
     finished late — the "keeps playing after you scroll past it" bug. */
  function loadVideo(v) {
    if (v.dataset.casaBrandStoryLoaded) return;
    v.dataset.casaBrandStoryLoaded = '1';
    v.muted = true;
    v.defaultMuted = true;
    v.playsInline = true;
    v.setAttribute('muted', '');
    v.setAttribute('playsinline', '');
    v.setAttribute('webkit-playsinline', '');
    if (v.dataset.src && !v.src) v.src = v.dataset.src;
    v.querySelectorAll('source[data-src]').forEach(function(s) {
      if (!s.src) s.src = s.dataset.src;
    });
    /* preload=none would defer the fetch until play(); with the src now
       assigned, auto lets the browser buffer ahead — the point of the
       200px head start. */
    v.preload = 'auto';
    v.load();
    /* The global owner's initial pass ran while this video had no src (its
       play() no-opped); re-gate now that it is loadable. */
    if (window.casa && window.casa.offscreenPauseRefresh) window.casa.offscreenPauseRefresh();
  }

  var observer = null;
  if ('IntersectionObserver' in window) {
    observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          loadVideo(e.target);
          observer.unobserve(e.target); /* load once; playback is the global owner's job */
        }
      });
    }, { rootMargin: '200px' });
    observer.observe(video);
  } else {
    loadVideo(video);
  }

  /* Theme-editor cleanup */
  document.addEventListener('shopify:section:unload', function(e) {
    if (e.target && e.target.id === 'shopify-section-{{ section.id }}' && observer) {
      observer.disconnect();
    }
  });
})();
</script>

