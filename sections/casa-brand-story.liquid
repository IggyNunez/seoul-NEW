{% stylesheet %}
.casa-brand-story {
  /* Brand v1 surface lock fallback: Paper #FAFAF7 if merchant hasn't set bg_color. */
  background: var(--cbs-bg, var(--bg-paper, var(--casa-paper)));
  padding: var(--cbs-pt, var(--casa-section-pt, 120px)) 80px var(--cbs-pb, var(--casa-section-pb, 120px));
}

.casa-brand-story__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--cbs-gap, 80px);
  align-items: center;
  max-width: var(--cbs-max-w, 100%);
  margin: 0 auto;
}

/* Ultrawide guardrail: the 1fr 1fr split over a full-width inner puts body
   copy at ~180 characters per line on a 3440px screen. Capping past 1920px
   holds the ≤1920 measure; min() lets narrower presets keep winning. */
@media screen and (min-width: 1920px) {
  .casa-brand-story__inner {
    max-width: min(var(--cbs-max-w, 100%), var(--casa-content-max-w, 1920px));
  }
}

.casa-brand-story--img-right .casa-brand-story__visual { order: 2; }
.casa-brand-story--img-right .casa-brand-story__content { order: 1; }

.casa-brand-story__visual {
  position: relative;
  border-radius: var(--cbs-img-radius, 24px);
  overflow: hidden;
  background: linear-gradient(135deg, var(--cbs-grad1, #B0C3FA), var(--cbs-grad2, #5E0A02));
}

.casa-brand-story__visual img,
.casa-brand-story__video {
  width: 100%;
  height: 100%;
  object-fit: var(--cbs-fit, cover);
}

.casa-brand-story__video {
  position: absolute;
  inset: 0;
  z-index: 1;
}

/* Belt-and-suspenders: if a device blocks muted autoplay (Low Power Mode,
   reduced-data) the video stays paused and iOS would paint its native centre
   play button on this decorative media. Suppress the WebKit media-control
   pseudo-elements so the poster image is the clean fallback, never a stray
   button. ONE RULE PER PSEUDO-ELEMENT — a comma-grouped list is dropped in
   its entirety by any selector the engine doesn't recognise, and
   `-overlay-play-button` (Chromium-only) would otherwise poison the iOS-only
   `-start-playback-button` rule. */
.casa-brand-story__video::-webkit-media-controls {
  display: none !important;
  -webkit-appearance: none;
  appearance: none;
}
.casa-brand-story__video::-webkit-media-controls-enclosure { display: none !important; }
.casa-brand-story__video::-webkit-media-controls-panel { display: none !important; }
.casa-brand-story__video::-webkit-media-controls-play-button { display: none !important; }
.casa-brand-story__video::-webkit-media-controls-start-playback-button {
  display: none !important;
  -webkit-appearance: none;
  appearance: none;
}
.casa-brand-story__video::-webkit-media-controls-overlay-play-button { display: none !important; }

.casa-brand-story__poster {
  position: relative;
  z-index: 0;
  transition: opacity 0.6s ease;
}

.casa-brand-story__tag {
  display: inline-block;
  font-size: 12px;
  font-weight: 600;
  color: var(--cbs-tag, #B0C3FA);
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 12px;
}

.casa-brand-story__title {
  /* Brand book v1 §03 locked H2 spec — Inter 500 / -0.015em / 1.10 LH.
     white-space: nowrap forces single-line per merchant.
     Deliberately NOT driven by the Horizon --font-hN-- tokens: h1 resolves to
     clamp(3rem, 5.6vw, 3.5rem) @700, which overflows the single-line lock. */
  font-size: clamp(22px, 4vw, 40px);
  font-weight: 500;
  line-height: 1.10;
  letter-spacing: -0.015em;
  text-transform: none;
  margin: 0 0 24px 0;
  color: var(--cbs-title, var(--casa-ink));
  white-space: nowrap;
}

/* Italic accent inside title — LARGER (1.15em) per merchant. Italic
   600 weight + brand gradient. line-height: 1 prevents inflation. */
.casa-brand-story__title em {
  font-size: 1.15em;
  font-style: italic;
  font-weight: 600;
  line-height: 1;
  background-image: var(--grad-text, linear-gradient(90deg, #B0C3FA, #5E0A02, #F2FFA0));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}

.casa-brand-story__text {
  font-size: var(--cbs-text-size, 18px);
  color: var(--cbs-text, #6b7280);
  line-height: 1.8;
  margin-bottom: 32px;
  /* Readability cap: the content column reaches ~920px at 1920px+
     viewports (~105 characters per line; comfortable is 50-75).
     ch-based so it only binds where lines actually run long —
     mobile/tablet columns are narrower than 72ch and don't move. */
  max-width: var(--casa-measure-max, 72ch);
}

.casa-brand-story__text p {
  margin: 0 0 16px 0;
}

.casa-brand-story__text p:last-child {
  margin-bottom: 0;
}

/* Brand Story CTA: brand class (.btn .btn-[treatment]) provides
   baseline (display, padding, font, radius, transition, transform,
   uppercase, letter-spacing, hover lift). Override below applies
   the section's deeper hover shadow that diverges from the brand
   .btn-featured baseline -- same pattern as hero primary CTA. */
.casa-brand-story__btn:hover {
  filter: brightness(1.1);
  box-shadow: 0 20px 40px -10px rgba(176, 195, 250, 0.5);
}

@media (max-width: 1200px) {
  .casa-brand-story {
    padding-left: 40px;
    padding-right: 40px;
  }

  .casa-brand-story__inner {
    gap: 48px;
  }
}

@media (max-width: 900px) {
  .casa-brand-story__inner {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .casa-brand-story__visual[style*="height"] {
    height: 350px !important;
  }
}

@media (max-width: 600px) {
  .casa-brand-story {
    padding-left: 20px;
    padding-right: 20px;
    padding-top: var(--cbs-pt-m, var(--casa-section-pt-m, 60px));
    padding-bottom: var(--cbs-pb-m, var(--casa-section-pb-m, 60px));
  }

  .casa-brand-story__visual[style*="height"] {
    height: 280px !important;
  }

  /* Mobile cap for the section title — locked to fit on one line.
     "Light that earns its place." has 27 chars with the italic-bold
     <em> on "earns its place." which renders ~15.7× the font size
     in width. To fit in the 335px content area at 375px viewport
     (and 240px at 320px viewport), font must be ≤ ~21px max.
     Using clamp(16px, 5vw, 22px) and text-wrap: nowrap defensively
     so the heading stays on one line at every mobile width the
     merchant tests. */
  .casa-brand-story__title {
    font-size: clamp(14px, 4.5vw, 22px);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .casa-brand-story__title em {
    font-size: 1.15em;
  }

  .casa-brand-story__text {
    font-size: var(--cbs-text-size-m, 16px);
  }

  /* Mobile: keep CTA compact (auto-width) and centered in its
     column to match the brand-book button visual rhythm
     (e.g. SHOP BUBBLE GIRLS style — pill, not full-bleed bar).
     .btn baseline is inline-flex; using display:flex + width:fit-content
     + margin:auto centers without forcing full-width. */
  .casa-brand-story__btn {
    display: flex;
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
  }
}
{% endstylesheet %}
