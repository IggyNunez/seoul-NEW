{%- comment -%}
  Seoul Glow Lab Stats Section
  4-column grid with gradient numbers + countup animation
{%- endcomment -%}

{%- comment -%} Auto-hide when no stat blocks have values {%- endcomment -%}
{%- assign _has_content = false -%}
{%- for block in section.blocks -%}
  {%- if block.settings.value != blank or block.settings.number != blank or block.settings.title != blank -%}
    {%- assign _has_content = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if _has_content == false and request.design_mode == false -%}
  <style>#shopify-section-{{ section.id }} { display: none !important; }</style>
{%- endif -%}

{%- liquid
  assign bg_color = section.settings.bg_color | default: '#FAFAF7'
  assign number_color_1 = section.settings.number_color_1 | default: '#B0C3FA'
  assign number_color_2 = section.settings.number_color_2 | default: '#5E0A02'
  assign label_color = section.settings.label_color | default: '#6b7280'
  assign padding_top = section.settings.padding_top | default: 120
  assign padding_bottom = section.settings.padding_bottom | default: 120
  assign enable_countup = section.settings.enable_countup
  assign countup_duration = section.settings.countup_duration | default: 2000
-%}

{%- comment -%}
  Heading-scale dropdown: merchant picks H1-H6 from Theme Settings -> Typography.
{%- endcomment -%}
{%- assign _cs_title_h = section.settings.cs_heading_level | default: 'h1' -%}
<section
  class="casa-stats"
  style="
    --cs-bg: {{ bg_color }};
    --cs-num-1: {{ number_color_1 }};
    --cs-num-2: {{ number_color_2 }};
    --cs-label: {{ label_color }};
    --cs-pt: {{ padding_top }}px;
    --cs-pb: {{ padding_bottom }}px;
    --cs-title-fs:   var(--font-{{ _cs_title_h }}--size);
    --cs-title-fw:   var(--font-{{ _cs_title_h }}--weight);
    --cs-title-lh:   var(--font-{{ _cs_title_h }}--line-height);
    --cs-title-ls:   var(--font-{{ _cs_title_h }}--letter-spacing);
    --cs-title-case: var(--font-{{ _cs_title_h }}--case);
  "
>
  {%- if section.settings.title != blank -%}
    <div class="casa-stats__header">
      {%- if section.settings.subtitle != blank -%}
        <div class="casa-stats__subtitle">{{ section.settings.subtitle }}</div>
      {%- endif -%}
      <h2 class="casa-stats__title">{{ section.settings.title }}</h2>
    </div>
  {%- endif -%}
  <div class="casa-stats__grid">
    {%- for block in section.blocks -%}
      <div class="casa-stats__item" {{ block.shopify_attributes }}>
        <div
          class="casa-stats__number"
          {% if enable_countup %}
            data-countup
            data-countup-value="{{ block.settings.number }}"
            data-countup-duration="{{ countup_duration }}"
          {% endif %}
        >
          {{ block.settings.number }}
        </div>
        <div class="casa-stats__label">{{ block.settings.label }}</div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% if enable_countup %}
<script>
(function() {
  function parseNumber(str) {
    /* Extract numeric value, prefix, and suffix from strings like "50K+", "$4.9M", "100%", "2-Year" */
    var match = str.match(/^([^0-9]*?)([\d,.]+)(.*?)$/);
    if (!match) return null;
    var prefix = match[1];
    var numStr = match[2].replace(/,/g, '');
    var suffix = match[3];
    var num = parseFloat(numStr);
    if (isNaN(num)) return null;
    var decimals = numStr.includes('.') ? numStr.split('.')[1].length : 0;
    /* Handle K/M/B in suffix */
    var multiplier = 1;
    var multiplierChar = '';
    if (suffix.charAt(0) === 'K' || suffix.charAt(0) === 'k') { multiplier = 1000; multiplierChar = suffix.charAt(0); suffix = suffix.substring(1); }
    else if (suffix.charAt(0) === 'M' || suffix.charAt(0) === 'm') { multiplier = 1000000; multiplierChar = suffix.charAt(0); suffix = suffix.substring(1); }
    else if (suffix.charAt(0) === 'B' || suffix.charAt(0) === 'b') { multiplier = 1000000000; multiplierChar = suffix.charAt(0); suffix = suffix.substring(1); }
    return { prefix: prefix, num: num, suffix: suffix, decimals: decimals, multiplier: multiplier, multiplierChar: multiplierChar, original: str };
  }

  function formatNumber(val, decimals) {
    if (decimals > 0) return val.toFixed(decimals);
    return Math.round(val).toLocaleString('en-US');
  }

  function easeOutQuart(t) {
    return 1 - Math.pow(1 - t, 4);
  }

  function animateCountup(el) {
    var raw = el.getAttribute('data-countup-value');
    var duration = parseInt(el.getAttribute('data-countup-duration')) || 2000;
    var parsed = parseNumber(raw);
    if (!parsed) return;

    var startTime = null;

    /* Reset to "0" is now done INSIDE the first rAF tick (was set
       synchronously above), so the SSR value stays painted until the
       browser is genuinely about to animate. Eliminates the visible
       "flash to 0" the user reported on slow main-thread frames. */
    function step(timestamp) {
      if (!startTime) startTime = timestamp;
      var progress = Math.min((timestamp - startTime) / duration, 1);
      var eased = easeOutQuart(progress);
      var current = eased * parsed.num;
      el.textContent = parsed.prefix + formatNumber(current, parsed.decimals) + parsed.multiplierChar + parsed.suffix;
      if (progress < 1) requestAnimationFrame(step);
      else el.textContent = raw; /* Ensure exact original string at end */
    }

    requestAnimationFrame(step);
  }

  /* Reduced-motion users keep the SSR value — no countup, no flash. */
  var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reducedMotion) return;

  /* IntersectionObserver — only animate when visible.
     rootMargin '200px' starts the countup slightly before the user
     reaches the section so the animation can complete before they
     read the numbers, instead of starting on entry and finishing
     800-2000ms later. */
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        animateCountup(entry.target);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0, rootMargin: '0px 0px 200px 0px' });

  document.querySelectorAll('[data-countup]').forEach(function(el) {
    observer.observe(el);
  });
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Casa Stats",
  "tag": "section",
  "class": "casa-stats-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "info": "Use <em>...</em> on the keyword for the brand italic-gradient accent."
    },
    {
      "type": "select",
      "id": "cs_heading_level",
      "label": "Title heading scale",
      "info": "Pulls size, weight, line-height, letter-spacing, and case from Theme Settings → Typography.",
      "options": [
        { "value": "h1", "label": "Heading 1" },
        { "value": "h2", "label": "Heading 2" },
        { "value": "h3", "label": "Heading 3" },
        { "value": "h4", "label": "Heading 4" },
        { "value": "h5", "label": "Heading 5" },
        { "value": "h6", "label": "Heading 6" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "enable_countup",
      "label": "Enable count-up animation",
      "info": "Numbers animate from 0 when scrolled into view",
      "default": true
    },
    {
      "type": "range",
      "id": "countup_duration",
      "label": "Animation duration",
      "min": 500,
      "max": 4000,
      "step": 250,
      "default": 2000,
      "unit": "ms"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FAFAF7"
    },
    {
      "type": "color",
      "id": "number_color_1",
      "label": "Number gradient start",
      "default": "#B0C3FA"
    },
    {
      "type": "color",
      "id": "number_color_2",
      "label": "Number gradient end",
      "default": "#5E0A02"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#525252"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 120,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 120,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "info": "Supports formats: 50K+, 4.9, $100M, 87%, 2-Year. Product / store-level — enter per template."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Casa Stats",
      "settings": {
        "enable_countup": true
      },
      "blocks": []
    }
  ]
}
{% endschema %}

{% stylesheet %}
.casa-stats {
  background: var(--cs-bg, var(--casa-paper));
  padding: var(--cs-pt, 120px) 80px var(--cs-pb, 120px);
}

.casa-stats__header {
  text-align: center;
  max-width: 600px;
  margin: 0 auto 48px;
}

.casa-stats__subtitle {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--cs-num-1, #B0C3FA);
  margin-bottom: 8px;
}

.casa-stats__title {
  /* Heading scale comes from Theme Settings -> Typography via the
     cs_heading_level dropdown; legacy font-h2 token preserved as fallback. */
  font-size: var(--cs-title-fs, var(--font-h2--size, 32px));
  font-weight: var(--cs-title-fw, 300);
  line-height: var(--cs-title-lh, normal);
  letter-spacing: var(--cs-title-ls, normal);
  text-transform: var(--cs-title-case, none);
  color: var(--color-foreground, var(--casa-ink));
  margin: 0;
}

.casa-stats__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 48px;
  max-width: 1200px;
  margin: 0 auto;
  text-align: center;
}

.casa-stats__number {
  font-size: 64px;
  font-weight: 300;
  /* Brand-book canonical: stats numbers use --grad-primary. Tight
     -0.035em tracking matches the v2 PDP feature-stat treatment
     (casa-pdp-features.liquid:631) so the homepage and PDPs share
     the same stat-number register. Merchant tokens --cs-num-1/-2
     still allowed for per-instance palette overrides. */
  letter-spacing: -0.035em;
  background-image: linear-gradient(135deg, var(--cs-num-1, var(--c-purple, #B0C3FA)), var(--cs-num-2, var(--c-pink, #5E0A02)));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 12px;
  line-height: 1;
}

.casa-stats__label {
  /* Brand "spec register": JetBrains Mono UPPERCASE, 0.08–0.12em
     tracking, brand --t-on-dark-muted color so labels read as factual
     spec text rather than competing with the gradient numbers. See
     locked typography memory: "Mono labels stay distinct: UPPERCASE
     JetBrains Mono · 0.08–0.12em letter-spacing." */
  font-family: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--cs-label, var(--t-on-dark-muted, rgba(255,255,255,0.65)));
}

@media (max-width: 900px) {
  .casa-stats {
    padding-left: 40px;
    padding-right: 40px;
  }
  .casa-stats__grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }
  .casa-stats__number {
    font-size: 48px;
  }
}

@media (max-width: 600px) {
  .casa-stats {
    padding-left: 20px;
    padding-right: 20px;
  }
  .casa-stats__grid {
    gap: 32px;
  }
  .casa-stats__number {
    font-size: 40px;
  }
  .casa-stats__label {
    font-size: 14px;
  }
  /* Title font-size handled by Horizon heading tokens. */
}
{% endstylesheet %}
