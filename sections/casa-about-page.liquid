{%- comment -%}
  Seoul Glow Lab — About Page (editorial archetype)
  Paper surface · Ink type · Inter only · mono kickers ·
  italic-gradient <em> accent on every section heading ·
  ink CTAs (.btn-primary).

  Block types: hero · manifesto · pillars · image_text · stats_row ·
  pull_quote · featured_collection · @app.

  Title fields are inline_richtext so merchant <em> survives save
  (text type strips <em>). One shimmer accent per page max (hero
  only); section H2s use the static --grad-text.
{%- endcomment -%}

{%- liquid
  assign bg          = section.settings.bg_color          | default: '#FAFAF7'
  assign text        = section.settings.text_color        | default: '#0A0A0F'
  assign muted       = section.settings.muted_color       | default: '#525252'
  assign rule        = section.settings.rule_color        | default: '#E5E3DC'
  assign pt          = section.settings.padding_top       | default: 80
  assign pb          = section.settings.padding_bottom    | default: 80
  assign gap         = section.settings.section_gap       | default: 80

  assign accent1     = section.settings.accent_primary    | default: '#B0C3FA'
  assign accent2     = section.settings.accent_secondary  | default: '#5E0A02'
  assign accent3     = section.settings.accent_tertiary   | default: '#F2FFA0'
-%}

<section
  class="casa-aboutp"
  data-casa-anim-gate
  style="
    --cap-bg: {{ bg }};
    --cap-text: {{ text }};
    --cap-muted: {{ muted }};
    --cap-rule: {{ rule }};
    --cap-a1: {{ accent1 }};
    --cap-a2: {{ accent2 }};
    --cap-a3: {{ accent3 }};
    --cap-grad-text: linear-gradient(90deg, {{ accent1 }} 0%, {{ accent2 }} 50%, {{ accent3 }} 100%);
    --cap-grad-shimmer: linear-gradient(90deg, {{ accent1 }} 0%, {{ accent2 }} 25%, {{ accent3 }} 50%, {{ accent2 }} 75%, {{ accent1 }} 100%);
    {%- if section.settings.override_spacing -%}
      --cap-pt: {{ pt }}px;
      --cap-pb: {{ pb }}px;
      {%- if section.settings.padding_top_mobile %}--cap-pt-m: {{ section.settings.padding_top_mobile }}px;{% endif -%}
      {%- if section.settings.padding_bottom_mobile %}--cap-pb-m: {{ section.settings.padding_bottom_mobile }}px;{% endif -%}
    {%- endif -%}
    --cap-gap: {{ gap }}px;
  "
>
  {%- for block in section.blocks -%}
    {%- case block.type -%}

      {%- comment -%} ────────────── HERO ────────────── {%- endcomment -%}
      {%- when 'hero' -%}
        {%- liquid
          assign hero_align = block.settings.text_align | default: 'left'
          assign has_image  = false
          if block.settings.image != blank
            assign has_image = true
          endif
        -%}
        <div
          class="casa-aboutp__hero casa-aboutp__hero--align-{{ hero_align }}{% if has_image %} casa-aboutp__hero--has-image{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="casa-aboutp__hero-inner">
            <div class="casa-aboutp__hero-copy casa-aboutp__reveal">
              {%- if block.settings.kicker != blank -%}
                <span class="casa-aboutp__kicker">{{ block.settings.kicker }}</span>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h1 class="casa-aboutp__hero-h">{{ block.settings.heading }}</h1>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <div class="casa-aboutp__hero-p">{{ block.settings.description }}</div>
              {%- endif -%}
              {%- if block.settings.button_text != blank -%}
                <div class="casa-aboutp__hero-cta">
                  <a href="{{ block.settings.button_url | default: '/collections/all' }}" class="btn btn-primary">
                    {{ block.settings.button_text }}
                  </a>
                  {%- if block.settings.button_text_secondary != blank -%}
                    <a href="{{ block.settings.button_url_secondary | default: '#manifesto' }}" class="btn btn-tertiary">
                      {{ block.settings.button_text_secondary }}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
            {%- if has_image -%}
              <div
                class="casa-aboutp__hero-image casa-aboutp__reveal"
                style="--cap-hero-img-pos: {{ block.settings.image_focus | default: 'center' }};"
              >
                <img
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 600 }} 600w,
                    {{ block.settings.image | image_url: width: 900 }} 900w,
                    {{ block.settings.image | image_url: width: 1200 }} 1200w,
                    {{ block.settings.image | image_url: width: 1600 }} 1600w
                  "
                  sizes="(max-width: 749px) 100vw, 48vw"
                  alt="{{ block.settings.image.alt | default: 'Seoul Glow Lab · House of Light' | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                >
              </div>
            {%- endif -%}
          </div>
        </div>

      {%- comment -%} ────────────── MANIFESTO ────────────── {%- endcomment -%}
      {%- when 'manifesto' -%}
        <div
          class="casa-aboutp__manifesto"
          id="manifesto"
          {{ block.shopify_attributes }}
        >
          <div class="casa-aboutp__manifesto-inner casa-aboutp__reveal">
            {%- if block.settings.kicker != blank -%}
              <span class="casa-aboutp__kicker">{{ block.settings.kicker }}</span>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="casa-aboutp__manifesto-h">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="casa-aboutp__manifesto-body">{{ block.settings.body }}</div>
            {%- endif -%}
            {%- if block.settings.signature != blank -%}
              <span class="casa-aboutp__signature">{{ block.settings.signature }}</span>
            {%- endif -%}
          </div>
        </div>

      {%- comment -%} ────────────── PILLARS (3-col triptych) ────────────── {%- endcomment -%}
      {%- when 'pillars' -%}
        <div class="casa-aboutp__pillars" {{ block.shopify_attributes }}>
          <div class="casa-aboutp__pillars-head casa-aboutp__reveal">
            {%- if block.settings.kicker != blank -%}
              <span class="casa-aboutp__kicker">{{ block.settings.kicker }}</span>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="casa-aboutp__pillars-h">{{ block.settings.heading }}</h2>
            {%- endif -%}
          </div>
          <div class="casa-aboutp__pillars-grid">
            {%- for i in (1..3) -%}
              {%- liquid
                assign num   = i | prepend: '0' | append: ''
                assign label_key = 'pillar_' | append: i | append: '_label'
                assign head_key  = 'pillar_' | append: i | append: '_heading'
                assign body_key  = 'pillar_' | append: i | append: '_body'
                assign image_key = 'pillar_' | append: i | append: '_image'
                assign label_val = block.settings[label_key]
                assign head_val  = block.settings[head_key]
                assign body_val  = block.settings[body_key]
                assign image_val = block.settings[image_key]
              -%}
              {%- if head_val != blank -%}
                <div class="casa-aboutp__pillar casa-aboutp__reveal">
                  {%- if image_val != blank -%}
                    {%- liquid
                      assign focus_key = 'pillar_' | append: i | append: '_image_focus'
                      assign focus_val = block.settings[focus_key] | default: 'center bottom'
                    -%}
                    <div class="casa-aboutp__pillar-img" style="--cap-pillar-img-pos: {{ focus_val }};">
                      <img
                        src="{{ image_val | image_url: width: 600 }}"
                        srcset="
                          {{ image_val | image_url: width: 400 }} 400w,
                          {{ image_val | image_url: width: 600 }} 600w,
                          {{ image_val | image_url: width: 900 }} 900w
                        "
                        sizes="(max-width: 749px) 100vw, 33vw"
                        alt="{{ image_val.alt | default: head_val | escape }}"
                        width="{{ image_val.width }}"
                        height="{{ image_val.height }}"
                        loading="lazy"
                        decoding="async"
                      >
                    </div>
                  {%- endif -%}
                  <div class="casa-aboutp__pillar-meta">
                    <span class="casa-aboutp__pillar-num">{{ num }}</span>
                    {%- if label_val != blank -%}
                      <span class="casa-aboutp__pillar-label">{{ label_val }}</span>
                    {%- endif -%}
                  </div>
                  <h3 class="casa-aboutp__pillar-h">{{ head_val }}</h3>
                  {%- if body_val != blank -%}
                    <div class="casa-aboutp__pillar-body">{{ body_val }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

      {%- comment -%} ────────────── IMAGE + TEXT ────────────── {%- endcomment -%}
      {%- when 'image_text' -%}
        {%- liquid
          assign pos = block.settings.image_position | default: 'start'
        -%}
        <div
          class="casa-aboutp__it casa-aboutp__it--{{ pos }}"
          {{ block.shopify_attributes }}
        >
          <div class="casa-aboutp__it-inner">
            {%- if block.settings.image != blank -%}
              <div
                class="casa-aboutp__it-img casa-aboutp__reveal"
                style="--cap-it-img-pos: {{ block.settings.image_focus | default: 'center bottom' }};"
              >
                <img
                  src="{{ block.settings.image | image_url: width: 1000 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 500 }} 500w,
                    {{ block.settings.image | image_url: width: 800 }} 800w,
                    {{ block.settings.image | image_url: width: 1000 }} 1000w,
                    {{ block.settings.image | image_url: width: 1400 }} 1400w
                  "
                  sizes="(max-width: 749px) 100vw, 50vw"
                  alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                  decoding="async"
                >
              </div>
            {%- endif -%}
            <div class="casa-aboutp__it-body casa-aboutp__reveal">
              {%- if block.settings.kicker != blank -%}
                <span class="casa-aboutp__kicker">{{ block.settings.kicker }}</span>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="casa-aboutp__it-h">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.content != blank -%}
                <div class="casa-aboutp__it-rt">{{ block.settings.content }}</div>
              {%- endif -%}
              {%- if block.settings.button_text != blank -%}
                <div class="casa-aboutp__it-cta">
                  <a href="{{ block.settings.button_url | default: '#' }}" class="btn btn-primary">
                    {{ block.settings.button_text }}
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>

      {%- comment -%} ────────────── STATS ROW ────────────── {%- endcomment -%}
      {%- when 'stats_row' -%}
        {%- liquid
          assign _stats_any = ''
          for i in (1..4)
            assign _key = 'stat_number_' | append: i
            assign _v = block.settings[_key]
            if _v != blank
              assign _stats_any = 'yes'
            endif
          endfor
        -%}
        {%- if _stats_any == 'yes' -%}
        <div class="casa-aboutp__stats" {{ block.shopify_attributes }}>
          <div class="casa-aboutp__stats-inner">
            {%- for i in (1..4) -%}
              {%- liquid
                assign num_key   = 'stat_number_' | append: i
                assign label_key = 'stat_label_' | append: i
                assign num_val   = block.settings[num_key]
                assign label_val = block.settings[label_key]
              -%}
              {%- if num_val != blank -%}
                <div class="casa-aboutp__stat casa-aboutp__reveal">
                  <span class="casa-aboutp__stat-num">{{ num_val }}</span>
                  {%- if label_val != blank -%}
                    <span class="casa-aboutp__stat-lbl">{{ label_val }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}

      {%- comment -%} ────────────── PULL QUOTE ────────────── {%- endcomment -%}
      {%- when 'pull_quote' -%}
        <div class="casa-aboutp__quote" {{ block.shopify_attributes }}>
          <figure class="casa-aboutp__quote-inner casa-aboutp__reveal">
            {%- if block.settings.quote != blank -%}
              <blockquote class="casa-aboutp__quote-q">
                <span class="casa-aboutp__quote-mark" aria-hidden="true">“</span>{{ block.settings.quote }}<span class="casa-aboutp__quote-mark casa-aboutp__quote-mark--end" aria-hidden="true">”</span>
              </blockquote>
            {%- endif -%}
            {%- if block.settings.attribution != blank -%}
              <figcaption class="casa-aboutp__quote-attr">{{ block.settings.attribution }}</figcaption>
            {%- endif -%}
          </figure>
        </div>

      {%- comment -%} ────────────── FEATURED COLLECTION ────────────── {%- endcomment -%}
      {%- when 'featured_collection' -%}
        {%- liquid
          assign fc       = block.settings.collection
          assign fc_limit = block.settings.products_to_show | default: 4
        -%}
        <div class="casa-aboutp__fc" {{ block.shopify_attributes }}>
          <div class="casa-aboutp__fc-head casa-aboutp__reveal">
            {%- if block.settings.kicker != blank -%}
              <span class="casa-aboutp__kicker">{{ block.settings.kicker }}</span>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="casa-aboutp__fc-h">{{ block.settings.heading }}</h2>
            {%- endif -%}
          </div>
          {%- if fc != blank and fc.products.size > 0 -%}
            <div class="casa-aboutp__fc-grid">
              {%- for product in fc.products limit: fc_limit -%}
                <a href="{{ product.url }}" class="casa-aboutp__fc-card casa-aboutp__reveal">
                  {%- if product.featured_image != blank -%}
                    <div class="casa-aboutp__fc-img">
                      <img
                        src="{{ product.featured_image | image_url: width: 600 }}"
                        srcset="
                          {{ product.featured_image | image_url: width: 400 }} 400w,
                          {{ product.featured_image | image_url: width: 600 }} 600w,
                          {{ product.featured_image | image_url: width: 800 }} 800w
                        "
                        sizes="(max-width: 749px) 50vw, 25vw"
                        alt="{{ product.featured_image.alt | default: product.title | escape }}"
                        width="{{ product.featured_image.width }}"
                        height="{{ product.featured_image.height }}"
                        loading="lazy"
                        decoding="async"
                      >
                    </div>
                  {%- endif -%}
                  <div class="casa-aboutp__fc-info">
                    <span class="casa-aboutp__fc-title">{{ product.title }}</span>
                    <span class="casa-aboutp__fc-price">{{ product.price | money }}</span>
                  </div>
                </a>
              {%- endfor -%}
            </div>
            {%- if block.settings.button_text != blank -%}
              <div class="casa-aboutp__fc-cta casa-aboutp__reveal">
                <a href="{{ block.settings.button_url | default: '/collections/all' }}" class="btn btn-primary">
                  {{ block.settings.button_text }}
                </a>
              </div>
            {%- endif -%}
          {%- else -%}
            <p class="casa-aboutp__fc-empty">Pick a collection in the theme editor.</p>
          {%- endif -%}
        </div>

    {%- endcase -%}
  {%- endfor -%}

  {%- comment -%} App blocks (Judge.me, Klaviyo, etc.) {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}
      <div class="casa-app-block" {{ block.shopify_attributes }}>
        {% render block %}
      </div>
    {%- endif -%}
  {%- endfor -%}
</section>

{% stylesheet %}
  /* ═══════════════ BASE ═══════════════ */
  .casa-aboutp {
    --_bg: var(--cap-bg, #FAFAF7);
    --_text: var(--cap-text, #0A0A0F);
    --_muted: var(--cap-muted, #525252);
    --_rule: var(--cap-rule, #E5E3DC);
    --_a1: var(--cap-a1, #B0C3FA);
    --_a2: var(--cap-a2, #5E0A02);
    --_a3: var(--cap-a3, #F2FFA0);
    --_grad-text: var(--cap-grad-text, linear-gradient(90deg, #B0C3FA, #5E0A02, #F2FFA0));
    --_grad-shimmer: var(--cap-grad-shimmer, linear-gradient(90deg, #B0C3FA, #5E0A02, #F2FFA0, #5E0A02, #B0C3FA));

    background: var(--_bg);
    color: var(--_text);
    padding-top: var(--cap-pt, var(--casa-section-pt, 80px));
    padding-bottom: var(--cap-pb, var(--casa-section-pb, 80px));
    font-family: var(--font-body--family, 'Inter', -apple-system, BlinkMacSystemFont, sans-serif);
    display: flex;
    flex-direction: column;
    gap: var(--cap-gap, 80px);
    overflow: hidden;
  }
  .casa-aboutp *,
  .casa-aboutp *::before,
  .casa-aboutp *::after { box-sizing: border-box; }

  /* ═══════════════ SHARED — mono kicker ═══════════════ */
  .casa-aboutp__kicker {
    display: inline-block;
    font-family: var(--font-mono--family, 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--_muted);
    margin-bottom: 1.5rem;
  }

  /* ═══════════════ SHARED — section heading em accent ═══════════════ */
  /* Section H2s carry the static --grad-text accent.
     The hero H1 gets its own shimmer (defined below in HERO block). */
  .casa-aboutp__manifesto-h em,
  .casa-aboutp__pillars-h em,
  .casa-aboutp__it-h em,
  .casa-aboutp__fc-h em,
  .casa-aboutp__pillar-h em {
    font-style: italic;
    font-weight: 800;
    background-image: var(--_grad-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }

  /* ═══════════════════════════════════════════════════ */
  /* ═══════════════════ HERO ═════════════════════════ */
  /* ═══════════════════════════════════════════════════ */
  .casa-aboutp__hero {
    padding: 4rem 1.5rem 0;
  }
  .casa-aboutp__hero-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .casa-aboutp__hero { padding: 6rem 2.5rem 0; }
    .casa-aboutp__hero--has-image .casa-aboutp__hero-inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 5rem;
    }
  }
  .casa-aboutp__hero--align-center .casa-aboutp__hero-copy { text-align: center; margin: 0 auto; }
  .casa-aboutp__hero--align-center .casa-aboutp__hero-p { margin-left: auto; margin-right: auto; }
  .casa-aboutp__hero--align-center .casa-aboutp__hero-cta { justify-content: center; }

  .casa-aboutp__hero-copy {
    max-width: 640px;
  }
  .casa-aboutp__hero-h {
    font-family: var(--font-heading--family, var(--font-body--family, 'Inter', sans-serif));
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--_text);
    margin: 0 0 1.5rem;
    text-wrap: balance;
  }
  /* Hero gets the shimmer treatment — one per page. */
  .casa-aboutp__hero-h em {
    font-style: italic;
    font-weight: 800;
    background-image: var(--_grad-shimmer);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    /* perf-justified: above-the-fold (hero is first viewport), animates
       a single short <em>, brand-locked one-per-page accent, and
       prefers-reduced-motion disables it below. */
    animation: casa-aboutp-shimmer 8s linear infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .casa-aboutp__hero-h em {
      animation: none;
      background-image: var(--_grad-text);
    }
  }
  @keyframes casa-aboutp-shimmer {
    0%   { background-position: 0% 50%; }
    100% { background-position: -200% 50%; }
  }

  .casa-aboutp__hero-p {
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.65;
    color: var(--_muted);
    max-width: 560px;
    margin: 0 0 2.25rem;
  }
  .casa-aboutp__hero-p p { margin: 0 0 1rem; }
  .casa-aboutp__hero-p p:last-child { margin-bottom: 0; }

  .casa-aboutp__hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
  }

  .casa-aboutp__hero-image {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 4px;
    overflow: hidden;
    background: rgba(10, 10, 15, 0.04);
  }
  .casa-aboutp__hero-image img {
    /* height: auto + aspect-ratio instead of height: 100% — the parent's
       height comes from its own aspect-ratio, and Safari 26 can fail to
       resolve a %-height against that, falling back to the img's intrinsic
       height (the /cart flat-thumbnail class; immune pattern from
       .cart-items__media-image in snippets/cart-products.liquid). */
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    /* products are the standout shot of the frame — merchant picks
       which portion of the source photo stays in the cropped 4:5 */
    object-position: var(--cap-hero-img-pos, center);
    display: block;
  }

  /* ═══════════════════════════════════════════════════ */
  /* ═══════════════════ MANIFESTO ════════════════════ */
  /* ═══════════════════════════════════════════════════ */
  .casa-aboutp__manifesto {
    padding: 2rem 1.5rem;
  }
  @media (min-width: 900px) {
    .casa-aboutp__manifesto { padding: 4rem 2.5rem; }
  }
  .casa-aboutp__manifesto-inner {
    max-width: 760px;
    margin: 0 auto;
  }
  .casa-aboutp__manifesto-h {
    font-family: var(--font-heading--family, var(--font-body--family, 'Inter', sans-serif));
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--_text);
    margin: 0 0 2rem;
    text-wrap: balance;
  }
  .casa-aboutp__manifesto-body {
    font-size: clamp(16px, 1.2vw, 19px);
    line-height: 1.8;
    color: var(--_text);
  }
  .casa-aboutp__manifesto-body p {
    margin: 0 0 1.5rem;
  }
  .casa-aboutp__manifesto-body p:last-child { margin-bottom: 0; }
  .casa-aboutp__signature {
    display: block;
    margin-top: 2.5rem;
    font-family: var(--font-mono--family, 'JetBrains Mono', monospace);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--_muted);
    border-top: 1px solid var(--_rule);
    padding-top: 1.5rem;
  }

  /* ═══════════════════════════════════════════════════ */
  /* ═══════════════════ PILLARS ══════════════════════ */
  /* ═══════════════════════════════════════════════════ */
  .casa-aboutp__pillars {
    padding: 2rem 1.5rem;
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
  }
  @media (min-width: 900px) {
    .casa-aboutp__pillars { padding: 2rem 2.5rem; }
  }
  .casa-aboutp__pillars-head {
    max-width: 760px;
    margin: 0 0 3rem;
  }
  .casa-aboutp__pillars-h {
    font-family: var(--font-heading--family, var(--font-body--family, 'Inter', sans-serif));
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--_text);
    margin: 0;
    text-wrap: balance;
  }
  .casa-aboutp__pillars-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem 2rem;
  }
  @media (min-width: 750px) {
    .casa-aboutp__pillars-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .casa-aboutp__pillar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .casa-aboutp__pillar-img {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 4px;
    background: rgba(10, 10, 15, 0.04);
    margin-bottom: 0.5rem;
  }
  .casa-aboutp__pillar-img img {
    /* height: auto + aspect-ratio instead of height: 100% — the parent's
       height comes from its own aspect-ratio, and Safari 26 can fail to
       resolve a %-height against that (the /cart flat-thumbnail class;
       immune pattern from .cart-items__media-image in snippets/cart-products.liquid). */
    width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; display: block;
    /* products are the standout — default to bottom for floor lamps */
    object-position: var(--cap-pillar-img-pos, center bottom);
    transition: transform .6s cubic-bezier(.22,1,.36,1);
  }
  .casa-aboutp__pillar:hover .casa-aboutp__pillar-img img { transform: scale(1.03); }
  .casa-aboutp__pillar-meta {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-mono--family, 'JetBrains Mono', monospace);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--_muted);
  }
  .casa-aboutp__pillar-num {
    color: var(--_text);
  }
  .casa-aboutp__pillar-label {
    color: var(--_muted);
  }
  .casa-aboutp__pillar-h {
    font-family: var(--font-heading--family, var(--font-body--family, 'Inter', sans-serif));
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--_text);
    margin: 0;
    text-wrap: balance;
  }
  .casa-aboutp__pillar-body {
    font-size: 15px;
    line-height: 1.65;
    color: var(--_muted);
  }
  .casa-aboutp__pillar-body p { margin: 0 0 1rem; }
  .casa-aboutp__pillar-body p:last-child { margin-bottom: 0; }

  /* ═══════════════════════════════════════════════════ */
  /* ═══════════════ IMAGE + TEXT ═════════════════════ */
  /* ═══════════════════════════════════════════════════ */
  .casa-aboutp__it { padding: 2rem 1.5rem; }
  @media (min-width: 900px) {
    .casa-aboutp__it { padding: 2rem 2.5rem; }
  }
  .casa-aboutp__it-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .casa-aboutp__it-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 5rem;
    }
    .casa-aboutp__it--end .casa-aboutp__it-img { order: 2; }
    .casa-aboutp__it--end .casa-aboutp__it-body { order: 1; }
  }
  .casa-aboutp__it-img {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 4px;
    background: rgba(10, 10, 15, 0.04);
  }
  .casa-aboutp__it-img img {
    /* height: auto + aspect-ratio instead of height: 100% — the parent's
       height comes from its own aspect-ratio, and Safari 26 can fail to
       resolve a %-height against that (the /cart flat-thumbnail class;
       immune pattern from .cart-items__media-image in snippets/cart-products.liquid). */
    width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; display: block;
    /* products are the standout — default to bottom for floor-standing
       products; merchant can switch to "center" or "top" per image */
    object-position: var(--cap-it-img-pos, center bottom);
  }
  .casa-aboutp__it-body { max-width: 560px; }
  .casa-aboutp__it--end .casa-aboutp__it-body { margin-left: 0; }
  .casa-aboutp__it-h {
    font-family: var(--font-heading--family, var(--font-body--family, 'Inter', sans-serif));
    font-size: clamp(28px, 3.6vw, 42px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--_text);
    margin: 0 0 1.5rem;
    text-wrap: balance;
  }
  .casa-aboutp__it-rt {
    font-size: 16px;
    line-height: 1.75;
    color: var(--_muted);
  }
  .casa-aboutp__it-rt p { margin: 0 0 1.25rem; }
  .casa-aboutp__it-rt p:last-child { margin-bottom: 0; }
  .casa-aboutp__it-cta { margin-top: 2rem; }

  /* ═══════════════════════════════════════════════════ */
  /* ═══════════════════ STATS ════════════════════════ */
  /* ═══════════════════════════════════════════════════ */
  .casa-aboutp__stats {
    padding: 3rem 1.5rem;
    border-top: 1px solid var(--_rule);
    border-bottom: 1px solid var(--_rule);
  }
  @media (min-width: 900px) {
    .casa-aboutp__stats { padding: 4rem 2.5rem; }
  }
  .casa-aboutp__stats-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.5rem;
  }
  @media (min-width: 750px) {
    .casa-aboutp__stats-inner { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; }
  }
  .casa-aboutp__stat {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  /* Brand Book v1 canonical stat-number register (matches
     casa-stats.liquid + casa-pdp-features.liquid:635):
     · Inter weight 300 (light), -0.035em tracking, line-height 1
     · 135deg 2-stop --grad-primary (purple→pink), NOT the 3-stop
       --grad-text that section H2 <em> accents use. Brand book
       reserves the 3-stop+cyan shimmer/text gradients for hero
       and section H2 accents only; stats numbers stay primary. */
  .casa-aboutp__stat-num {
    display: block;
    font-family: var(--font-heading--family, var(--font-body--family, 'Inter', sans-serif));
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.035em;
    background-image: var(--grad-primary, linear-gradient(135deg, var(--_a1, #B0C3FA), var(--_a2, #5E0A02)));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }
  /* Spec-register label: JetBrains Mono UPPERCASE, 12px / 0.12em
     — matches casa-stats.liquid label tokens so the about-page
     stats row reads in the same spec register as the homepage. */
  .casa-aboutp__stat-lbl {
    display: block;
    font-family: var(--font-mono--family, 'JetBrains Mono', monospace);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--_muted);
  }

  /* ═══════════════════════════════════════════════════ */
  /* ═══════════════════ PULL QUOTE ═══════════════════ */
  /* ═══════════════════════════════════════════════════ */
  .casa-aboutp__quote {
    padding: 3rem 1.5rem;
  }
  @media (min-width: 900px) {
    .casa-aboutp__quote { padding: 4rem 2.5rem; }
  }
  .casa-aboutp__quote-inner {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
  }
  .casa-aboutp__quote-q {
    font-family: var(--font-heading--family, var(--font-body--family, 'Inter', sans-serif));
    font-size: clamp(26px, 3.4vw, 42px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--_text);
    margin: 0;
    font-style: normal;
    text-wrap: balance;
    position: relative;
  }
  .casa-aboutp__quote-q em {
    font-style: italic;
    font-weight: 700;
    background-image: var(--_grad-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }
  .casa-aboutp__quote-mark {
    color: var(--_a1);
    opacity: 0.5;
    font-weight: 400;
    margin: 0 0.05em;
  }
  .casa-aboutp__quote-mark--end {
    color: var(--_a3);
  }
  .casa-aboutp__quote-attr {
    display: block;
    margin-top: 2rem;
    font-family: var(--font-mono--family, 'JetBrains Mono', monospace);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--_muted);
  }

  /* ═══════════════════════════════════════════════════ */
  /* ═══════════════ FEATURED COLLECTION ══════════════ */
  /* ═══════════════════════════════════════════════════ */
  .casa-aboutp__fc {
    padding: 2rem 1.5rem 4rem;
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
  }
  @media (min-width: 900px) {
    .casa-aboutp__fc { padding: 2rem 2.5rem 4rem; }
  }
  .casa-aboutp__fc-head {
    max-width: 760px;
    margin: 0 0 3rem;
  }
  .casa-aboutp__fc-h {
    font-family: var(--font-heading--family, var(--font-body--family, 'Inter', sans-serif));
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--_text);
    margin: 0;
    text-wrap: balance;
  }
  .casa-aboutp__fc-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  @media (min-width: 750px) {
    .casa-aboutp__fc-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.75rem; }
  }
  .casa-aboutp__fc-card {
    text-decoration: none;
    color: var(--_text);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform .35s cubic-bezier(.22,1,.36,1);
  }
  .casa-aboutp__fc-card:hover { transform: translateY(-4px); }
  .casa-aboutp__fc-img {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 4px;
    background: rgba(10, 10, 15, 0.04);
  }
  .casa-aboutp__fc-img img {
    /* height: auto + aspect-ratio instead of height: 100% — the parent's
       height comes from its own aspect-ratio, and Safari 26 can fail to
       resolve a %-height against that (the /cart flat-thumbnail class;
       immune pattern from .cart-items__media-image in snippets/cart-products.liquid). */
    width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; display: block;
    transition: transform .6s cubic-bezier(.22,1,.36,1);
  }
  .casa-aboutp__fc-card:hover .casa-aboutp__fc-img img { transform: scale(1.04); }
  .casa-aboutp__fc-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .casa-aboutp__fc-title {
    font-size: 14px;
    font-weight: 500;
    color: var(--_text);
    line-height: 1.4;
  }
  .casa-aboutp__fc-price {
    font-family: var(--font-mono--family, 'JetBrains Mono', monospace);
    font-size: 12px;
    color: var(--_muted);
    letter-spacing: 0.04em;
  }
  .casa-aboutp__fc-empty { color: var(--_muted); font-size: 14px; }
  .casa-aboutp__fc-cta {
    margin-top: 3rem;
    text-align: center;
  }

  /* ═══════════════════════════════════════════════════ */
  /* ═══════════════════ MOBILE ═══════════════════════ */
  /* ═══════════════════════════════════════════════════ */
  @media (max-width: 749px) {
    .casa-aboutp {
      padding-top: var(--cap-pt-m, var(--casa-section-pt-m, 60px));
      padding-bottom: var(--cap-pb-m, var(--casa-section-pb-m, 60px));
      gap: 60px;
    }
    .casa-aboutp__hero { padding: 2rem 1.25rem 0; }
    .casa-aboutp__hero-h { font-size: clamp(36px, 9vw, 56px); letter-spacing: -0.02em; }
    .casa-aboutp__hero-p { font-size: 16px; }
    .casa-aboutp__manifesto-h,
    .casa-aboutp__pillars-h,
    .casa-aboutp__fc-h { font-size: clamp(26px, 7vw, 36px); }
    .casa-aboutp__it-h { font-size: clamp(24px, 6.5vw, 32px); }
    .casa-aboutp__quote-q { font-size: clamp(22px, 5.5vw, 30px); line-height: 1.35; }
    .casa-aboutp__manifesto-body,
    .casa-aboutp__it-rt { font-size: 15.5px; line-height: 1.75; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About Page",
  "tag": "section",
  "class": "casa-about-page-section",
  "settings": [
    { "type": "header", "content": "Surface" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FAFAF7" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#0A0A0F" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "info": "Kickers, descriptions, secondary text", "default": "#525252" },
    { "type": "color", "id": "rule_color", "label": "Rule / divider line", "default": "#E5E3DC" },
    { "type": "header", "content": "Accents (gradient)" },
    { "type": "paragraph", "content": "Used in the italic-em accent on section headings, the stats numbers, and the pull-quote highlight. Default is the brand purple → pink → cyan." },
    { "type": "color", "id": "accent_primary",   "label": "Accent 1", "default": "#B0C3FA" },
    { "type": "color", "id": "accent_secondary", "label": "Accent 2", "default": "#5E0A02" },
    { "type": "color", "id": "accent_tertiary",  "label": "Accent 3", "default": "#F2FFA0" },
    { "type": "header", "content": "Spacing" },
    { "type": "paragraph", "content": "Follows Theme settings → Casa Section Spacing by default. Toggle to override." },
    { "type": "checkbox", "id": "override_spacing", "label": "Override theme spacing", "default": false },
    { "type": "range", "id": "padding_top", "label": "Padding top (desktop)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (desktop)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "section_gap", "label": "Gap between blocks", "min": 20, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "hero",
      "name": "Hero",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "text_align",
          "label": "Text alignment",
          "options": [
            { "value": "left",   "label": "Left" },
            { "value": "center", "label": "Center" }
          ],
          "default": "left"
        },
        { "type": "text", "id": "kicker", "label": "Mono kicker", "default": "EST. 2020 · HOUSE OF LIGHT" },
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Use <em>...</em> on one word/phrase for the brand italic-shimmer accent. One shimmer per page max.", "default": "We make light worth <em>living in.</em>" },
        { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Seoul Glow Lab is a House of Light — a curated catalog of sculptural lamps, portal mirrors, character figurines, and smart-light accents, chosen one piece at a time. Each one finds its way in for the same reason: anchor a room, not blend into its corner.</p>" },
        { "type": "image_picker", "id": "image", "label": "Companion image", "info": "Optional. Shown right of the copy on desktop. Use a portrait crop (4:5)." },
        {
          "type": "select",
          "id": "image_focus",
          "label": "Keep in frame",
          "info": "Which part of the photo stays visible when the 4:5 frame crops the source. Pick where the product sits.",
          "options": [
            { "value": "center top",    "label": "Top of photo" },
            { "value": "center",        "label": "Center of photo" },
            { "value": "center bottom", "label": "Bottom of photo" }
          ],
          "default": "center"
        },
        { "type": "header", "content": "Call to action" },
        { "type": "text", "id": "button_text", "label": "Primary button", "default": "SHOP EVERYTHING" },
        { "type": "url",  "id": "button_url",  "label": "Primary link" },
        { "type": "text", "id": "button_text_secondary", "label": "Secondary button (text link)", "default": "READ OUR STORY" },
        { "type": "url",  "id": "button_url_secondary",  "label": "Secondary link" }
      ]
    },
    {
      "type": "manifesto",
      "name": "Manifesto",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "kicker", "label": "Mono kicker", "default": "OUR THESIS" },
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Use <em>...</em> for the italic-gradient accent.", "default": "Light isn't a finish. It's <em>the room.</em>" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Most lighting fades into the background — that's the design brief. Disappear. Cast a beam. Do its job and stop. We work to the opposite brief: find the piece that catches your eye the second you walk in, and earns a second look every hour after that.</p><p>We're not a fixture company, and we're not a studio. We're a house — a curator with a roster. We hunt the pieces, photograph them against real walls and real evenings, and only carry the ones we'd live with ourselves. We do.</p><p>Some of what we carry plugs in. Some of it glows. Some of it just sits on a console table and changes the room's center of gravity. All of it is here to be looked at.</p>" },
        { "type": "text", "id": "signature", "label": "Signature line", "info": "Mono caption beneath the body — CSS uppercases the display. Optional.", "default": "Seoul Glow Lab · House of Light" }
      ]
    },
    {
      "type": "pillars",
      "name": "Pillars (3-column)",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "kicker", "label": "Mono kicker", "default": "WHAT WE MAKE" },
        { "type": "inline_richtext", "id": "heading", "label": "Section heading", "info": "Use <em>...</em> for the italic-gradient accent.", "default": "Three things. <em>Done right.</em>" },
        { "type": "header", "content": "Pillar 1" },
        { "type": "text", "id": "pillar_1_label", "label": "Label", "default": "DAYLIT OBJECTS" },
        { "type": "inline_richtext", "id": "pillar_1_heading", "label": "Heading", "default": "Sculptural lamps with a <em>day job.</em>" },
        { "type": "richtext", "id": "pillar_1_body", "label": "Body", "default": "<p>Mushroom lamps, fluted glass, character figurines, hand-finished metals. Pieces that hold a room when the sun's still up — and quietly change it after dark.</p>" },
        { "type": "image_picker", "id": "pillar_1_image", "label": "Image (4:5 portrait)" },
        {
          "type": "select", "id": "pillar_1_image_focus", "label": "Pillar 1 — Keep in frame",
          "options": [
            { "value": "center top",    "label": "Top of photo" },
            { "value": "center",        "label": "Center of photo" },
            { "value": "center bottom", "label": "Bottom of photo" }
          ],
          "default": "center bottom"
        },
        { "type": "header", "content": "Pillar 2" },
        { "type": "text", "id": "pillar_2_label", "label": "Label", "default": "PORTALS" },
        { "type": "inline_richtext", "id": "pillar_2_heading", "label": "Heading", "default": "Mirrors that turn into <em>something else.</em>" },
        { "type": "richtext", "id": "pillar_2_body", "label": "Body", "default": "<p>Real mirrors by day. At night, they open into corridors of RGB light — wall-mounted, in seven shapes, controlled from your phone.</p>" },
        { "type": "image_picker", "id": "pillar_2_image", "label": "Image (4:5 portrait)" },
        {
          "type": "select", "id": "pillar_2_image_focus", "label": "Pillar 2 — Keep in frame",
          "options": [
            { "value": "center top",    "label": "Top of photo" },
            { "value": "center",        "label": "Center of photo" },
            { "value": "center bottom", "label": "Bottom of photo" }
          ],
          "default": "center"
        },
        { "type": "header", "content": "Pillar 3" },
        { "type": "text", "id": "pillar_3_label", "label": "Label", "default": "SMART LIGHT" },
        { "type": "inline_richtext", "id": "pillar_3_heading", "label": "Heading", "default": "Color you can <em>script.</em>" },
        { "type": "richtext", "id": "pillar_3_body", "label": "Body", "default": "<p>AuraPanels, Nexus floor lamps, smart bulbs. Light that responds to a scene, a song, or a Tuesday night — app-controlled, voice-friendly, color-matched to your own palette.</p>" },
        { "type": "image_picker", "id": "pillar_3_image", "label": "Image (4:5 portrait)" },
        {
          "type": "select", "id": "pillar_3_image_focus", "label": "Pillar 3 — Keep in frame",
          "options": [
