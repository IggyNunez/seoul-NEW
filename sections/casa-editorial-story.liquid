{%- comment -%}
  Seoul Glow Lab — Editorial Story Section
  Premium magazine-style editorial layout with large hero image,
  elegant text overlay, character/product name row, and CTA.
  Supports overlay, split, and stacked layout modes.
{%- endcomment -%}

{%- comment -%} Auto-hide when no content exists {%- endcomment -%}
{%- if section.settings.heading == blank and section.settings.image == blank and section.settings.body_text == blank and request.design_mode == false -%}
  <style>#shopify-section-{{ section.id }} { display: none !important; }</style>
{%- endif -%}

{%- liquid
  assign layout        = section.settings.layout_style | default: 'overlay'
  assign image_pos     = section.settings.image_position | default: 'left'
  assign overlay_op    = section.settings.overlay_opacity | default: 40
  assign min_h         = section.settings.min_height | default: 500
  assign names_raw     = section.settings.character_names | default: ''
  assign names_fs      = section.settings.names_font_size | default: 14
  assign names_ls      = section.settings.names_letter_spacing | default: 8
  assign names_color   = section.settings.names_color | default: ''
  assign heading       = section.settings.heading | default: ''
  assign heading_size  = section.settings.heading_size | default: 'large'
  assign custom_heading_desktop = section.settings.heading_font_size_desktop | default: 48
  assign custom_heading_mobile = section.settings.heading_font_size_mobile | default: 28
  assign body_text     = section.settings.body_text
  assign align         = section.settings.content_alignment | default: 'center'
  assign max_w         = section.settings.content_max_width | default: 680
  assign glass         = section.settings.show_glassmorphic_card
  assign divider       = section.settings.show_divider
  assign btn_text      = section.settings.button_text | default: ''
  assign btn_url       = section.settings.button_url | default: ''
  assign btn_style     = section.settings.button_style | default: 'gradient'
  assign btn_treatment = section.settings.button_treatment | default: 'featured'
  assign bg_color      = section.settings.bg_color | default: '#0A0A0F'
  assign text_color    = section.settings.text_color | default: '#E5E3DC'
  assign heading_color = section.settings.heading_color | default: '#FAFAF7'
  assign body_color    = section.settings.body_color | default: '#d4d4d4'
  assign accent_color  = section.settings.accent_color | default: '#c8956c'
  assign pad_top       = section.settings.padding_top | default: 80
  assign pad_bottom    = section.settings.padding_bottom | default: 80
  assign image_pct     = section.settings.split_image_pct | default: 55

  assign overlay_dec = overlay_op | times: 1.0 | divided_by: 100.0

  assign flex_dir = 'row'
  if image_pos == 'right'
    assign flex_dir = 'row-reverse'
  endif

  assign names_arr = names_raw | split: ','
-%}

<section
  id="casa-edit-{{ section.id }}"
  class="casa-edit casa-edit--{{ layout }}{% if image_pos == 'right' %} casa-edit--img-right{% endif %}"
  style="
    --ce-bg: {{ bg_color }};
    --ce-text: {{ text_color }};
    --ce-heading: {{ heading_color }};
    --ce-body: {{ body_color }};
    --ce-accent: {{ accent_color }};
    --ce-names-color: {{ names_color | default: accent_color }};
    --ce-overlay: {{ overlay_dec }};
    --ce-min-h: {{ min_h }}px;
    --ce-names-fs: {{ names_fs }}px;
    --ce-names-ls: {{ names_ls }}px;
    --ce-max-w: {{ max_w }}px;
    --ce-align: {{ align }};
    --ce-pad-top: {{ pad_top }}px;
    --ce-pad-bottom: {{ pad_bottom }}px;
    --ce-flex-dir: {{ flex_dir }};
    --ce-image-col: {{ image_pct }}%;
    {%- comment -%}
      Heading-scale dropdown: merchant picks H1-H6 from Theme Settings -> Typography.
    {%- endcomment -%}
    {%- assign _ces_title_h = section.settings.ces_heading_level | default: 'h1' -%}
    --ce-heading-fs:   var(--font-{{ _ces_title_h }}--size);
    --ce-heading-fw:   var(--font-{{ _ces_title_h }}--weight);
    --ce-heading-lh:   var(--font-{{ _ces_title_h }}--line-height);
    --ce-heading-ls:   var(--font-{{ _ces_title_h }}--letter-spacing);
    --ce-heading-case: var(--font-{{ _ces_title_h }}--case);
  "
>

  {%- comment -%} ── OVERLAY LAYOUT ── {%- endcomment -%}
  {%- if layout == 'overlay' -%}
    <div class="casa-edit__overlay-wrap">
      {%- if section.settings.image != blank -%}
        <picture class="casa-edit__picture">
          {%- if section.settings.mobile_image != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="{{ section.settings.mobile_image | image_url: width: 900 }} 900w,
                      {{ section.settings.mobile_image | image_url: width: 600 }} 600w"
              sizes="100vw"
            >
          {%- endif -%}
          <img
            src="{{ section.settings.image | image_url: width: 1920 }}"
            srcset="{{ section.settings.image | image_url: width: 1920 }} 1920w,
                    {{ section.settings.image | image_url: width: 1400 }} 1400w,
                    {{ section.settings.image | image_url: width: 1000 }} 1000w"
            sizes="100vw"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            class="casa-edit__bg-img"
          >
        </picture>
      {%- endif -%}
      <div class="casa-edit__overlay-dim"></div>
      <div class="casa-edit__overlay-content casa-edit__content-zone" data-ce-animate>
        {%- if glass -%}<div class="casa-edit__glass">{%- endif -%}
          {%- render 'casa-edit-content',
            names_arr: names_arr,
            heading: heading,
            heading_size: heading_size,
            body_text: body_text,
            divider: divider,
            btn_text: btn_text,
            btn_url: btn_url,
            btn_style: btn_style,
            btn_treatment: btn_treatment,
            accent_color: accent_color,
            section_id: section.id
          -%}
        {%- if glass -%}</div>{%- endif -%}
      </div>
    </div>

  {%- comment -%} ── SPLIT LAYOUT ── {%- endcomment -%}
  {%- elsif layout == 'split' -%}
    <div class="casa-edit__split-wrap">
      <div class="casa-edit__split-image">
        {%- if section.settings.image != blank -%}
          <picture>
            {%- if section.settings.mobile_image != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="{{ section.settings.mobile_image | image_url: width: 800 }} 800w,
                        {{ section.settings.mobile_image | image_url: width: 600 }} 600w"
                sizes="100vw"
              >
            {%- endif -%}
            <img
              src="{{ section.settings.image | image_url: width: 1200 }}"
              srcset="{{ section.settings.image | image_url: width: 1200 }} 1200w,
                      {{ section.settings.image | image_url: width: 900 }} 900w,
                      {{ section.settings.image | image_url: width: 600 }} 600w"
              sizes="(min-width: 750px) 55vw, 100vw"
              alt="{{ section.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              class="casa-edit__split-img"
            >
          </picture>
        {%- endif -%}
      </div>
      <div class="casa-edit__split-content casa-edit__content-zone" data-ce-animate>
        {%- if glass -%}<div class="casa-edit__glass">{%- endif -%}
          {%- render 'casa-edit-content',
            names_arr: names_arr,
            heading: heading,
            heading_size: heading_size,
            body_text: body_text,
            divider: divider,
            btn_text: btn_text,
            btn_url: btn_url,
            btn_style: btn_style,
            btn_treatment: btn_treatment,
            accent_color: accent_color,
            section_id: section.id
          -%}

          {%- comment -%}
            Structural callouts (A/B/C list). Rendered after body_text in
            split layout only. Each block is a `callout` type with marker,
            optional title, optional body. Section renders nothing if no
            callout blocks present (back-compat).
          {%- endcomment -%}
          {%- assign callout_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'callout' -%}{%- assign callout_count = callout_count | plus: 1 -%}{%- endif -%}
          {%- endfor -%}
          {%- if callout_count > 0 -%}
            <div class="casa-edit__callouts">
              {%- for block in section.blocks -%}
                {%- if block.type == 'callout' -%}
                  <div class="casa-edit__callout" {{ block.shopify_attributes }}>
                    <span class="casa-edit__callout-marker">{{ block.settings.marker }}</span>
                    <p class="casa-edit__callout-text">
                      {%- if block.settings.title != blank -%}<strong>{{ block.settings.title }}</strong> {% endif -%}
                      {{ block.settings.body }}
                    </p>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- if glass -%}</div>{%- endif -%}
      </div>
    </div>

  {%- comment -%} ── STACKED LAYOUT ── {%- endcomment -%}
  {%- elsif layout == 'stacked' -%}
    <div class="casa-edit__stacked-wrap">
      <div class="casa-edit__stacked-image">
        {%- if section.settings.image != blank -%}
          <picture>
            {%- if section.settings.mobile_image != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="{{ section.settings.mobile_image | image_url: width: 900 }} 900w,
                        {{ section.settings.mobile_image | image_url: width: 600 }} 600w"
                sizes="100vw"
              >
            {%- endif -%}
            <img
              src="{{ section.settings.image | image_url: width: 1920 }}"
              srcset="{{ section.settings.image | image_url: width: 1920 }} 1920w,
                      {{ section.settings.image | image_url: width: 1400 }} 1400w,
                      {{ section.settings.image | image_url: width: 1000 }} 1000w"
              sizes="100vw"
              alt="{{ section.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              class="casa-edit__stacked-img"
            >
          </picture>
        {%- endif -%}
      </div>
      <div class="casa-edit__stacked-content casa-edit__content-zone" data-ce-animate>
        {%- if glass -%}<div class="casa-edit__glass">{%- endif -%}
          {%- render 'casa-edit-content',
            names_arr: names_arr,
            heading: heading,
            heading_size: heading_size,
            body_text: body_text,
            divider: divider,
            btn_text: btn_text,
            btn_url: btn_url,
            btn_style: btn_style,
            btn_treatment: btn_treatment,
            accent_color: accent_color,
            section_id: section.id
          -%}
        {%- if glass -%}</div>{%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

{%- comment -%} ════════════════════  STYLES  ════════════════════ {%- endcomment -%}
<style>
  /* ── Base ── */
  .casa-edit {
    position: relative;
    width: 100%;
    max-width: 100vw;
    color: var(--ce-text);
    background: var(--ce-bg);
    /* overflow: clip (not hidden) — clip clips overflow visually without
       creating a scroll container, so position: sticky on descendants
       (image col on split layout) can stick to the page viewport instead
       of being trapped inside this section. clip is fully supported on
       all browsers we care about (Chrome 90+, Firefox 102+, Safari 16+). */
    overflow: clip;
    box-sizing: border-box;
  }

  .casa-edit *,
  .casa-edit *::before,
  .casa-edit *::after {
    box-sizing: border-box;
  }

  /* ── Content zone shared ── */
  .casa-edit__content-zone {
    text-align: var(--ce-align);
    max-width: min(var(--ce-max-w), calc(100vw - 40px));
    box-sizing: border-box;
    word-wrap: break-word;
    overflow-wrap: break-word;
    opacity: 0;
    transform: translateY(32px);
    transition: opacity .9s cubic-bezier(.22,1,.36,1), transform .9s cubic-bezier(.22,1,.36,1);
  }
  .casa-edit__content-zone.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .casa-edit__content-zone[style*="--ce-align: center"],
  .casa-edit .casa-edit__content-zone {
    margin-left: auto;
    margin-right: auto;
  }
  .casa-edit--overlay .casa-edit__content-zone,
  .casa-edit--stacked .casa-edit__content-zone {
    margin-inline: auto;
  }

  /* align helper */
  .casa-edit[style*="--ce-align: left"] .casa-edit__content-zone {
    margin-left: 0;
    margin-right: auto;
  }
  .casa-edit[style*="--ce-align: right"] .casa-edit__content-zone {
    margin-left: auto;
    margin-right: 0;
  }

  /* ── Glassmorphic card ── */
  .casa-edit__glass {
    background: rgba(10, 10, 10, .35);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 16px;
    padding: 48px 40px;
  }

  /* ══════════════════════════════════════
     OVERLAY LAYOUT
     ══════════════════════════════════════ */
  .casa-edit__overlay-wrap {
    position: relative;
    min-height: var(--ce-min-h);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--ce-pad-top) 24px var(--ce-pad-bottom);
  }
  .casa-edit__picture {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .casa-edit__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .casa-edit__overlay-dim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0,0,0, var(--ce-overlay));
    pointer-events: none;
  }
  .casa-edit__overlay-content {
    position: relative;
    z-index: 2;
  }

  /* ══════════════════════════════════════
     SPLIT LAYOUT
     ══════════════════════════════════════ */
  .casa-edit__split-wrap {
    display: grid;
    grid-template-columns: var(--ce-image-col, 55%) calc(100% - var(--ce-image-col, 55%));
    min-height: var(--ce-min-h);
    gap: 0;
    align-items: center;
  }
  .casa-edit--img-right .casa-edit__split-wrap {
    grid-template-columns: calc(100% - var(--ce-image-col, 55%)) var(--ce-image-col, 55%);
  }
  .casa-edit--img-right .casa-edit__split-image {
    order: 2;
  }
  .casa-edit--img-right .casa-edit__split-content {
    order: 1;
  }
  .casa-edit__split-image {
    position: relative;
    overflow: hidden;
    height: 100%;
  }
  .casa-edit__split-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .casa-edit__split-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--ce-pad-top) 48px var(--ce-pad-bottom);
    background: var(--ce-bg);
  }
  /* Desktop ≥990px — image becomes sticky so it follows the viewport as
     the user scrolls a tall callout column. Prevents the "single image
     at top, empty block underneath" failure mode on smaller laptops
     when the content side is much taller than the image side. */
  @media (min-width: 990px) {
    .casa-edit__split-image {
      position: sticky;
      top: calc(var(--header-height, 80px) + 16px);
      align-self: start;
      aspect-ratio: 4 / 5;
      max-height: calc(100vh - var(--header-height, 80px) - 48px);
      height: auto;
    }
  }
  /* Ultrawide cap — at viewports >1500px, full-bleed editorial spreads
     stretch unnaturally and the gap between image and text column grows.
     Cap the split-layout wrap at 1500px centered. Section bg still
     extends edge-to-edge; only the layout content is constrained. */
  @media (min-width: 1500px) {
    .casa-edit__split-wrap,
    .casa-edit--img-right .casa-edit__split-wrap {
      max-width: 1500px;
      margin-inline: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .casa-edit__split-image { position: static; }
  }

  /* ══════════════════════════════════════
     STACKED LAYOUT
     ══════════════════════════════════════ */
  .casa-edit__stacked-wrap {}
  .casa-edit__stacked-image {
    position: relative;
    width: 100%;
    max-height: 520px;
    overflow: hidden;
  }
  .casa-edit__stacked-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    max-height: 520px;
  }
  .casa-edit__stacked-content {
    padding: var(--ce-pad-top) 24px var(--ce-pad-bottom);
    background: var(--ce-bg);
  }

  /* ══════════════════════════════════════
     NAMES ROW
     ══════════════════════════════════════ */
  .casa-edit__names {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-bottom: 20px;
  }
  .casa-edit[style*="--ce-align: center"] .casa-edit__names { justify-content: center; }
  .casa-edit[style*="--ce-align: right"] .casa-edit__names { justify-content: flex-end; }
  .casa-edit__name {
    font-size: var(--ce-names-fs);
    letter-spacing: var(--ce-names-ls);
    text-transform: uppercase;
    color: var(--ce-names-color);
    font-weight: 400;
    line-height: 1.4;
    white-space: nowrap;
  }
  .casa-edit__name-sep {
    color: var(--ce-names-color);
    opacity: .35;
    font-size: var(--ce-names-fs);
    user-select: none;
  }

  /* ══════════════════════════════════════
     STRUCTURAL CALLOUTS (A/B/C list)
     ══════════════════════════════════════ */
  .casa-edit__callouts {
    margin-top: clamp(20px, 2.5vw, 32px);
    display: grid;
    gap: 0;
    /* Brand discipline: structural lists always left-aligned. The
       A/B/C markers form a scannable vertical column — centering
       breaks the index-style read. */
    text-align: left;
  }
  .casa-edit__callout {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 14px;
    align-items: baseline;
    padding: 14px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .casa-edit__callout:first-child {
    border-top: none;
    padding-top: 4px;
  }
  .casa-edit__callout-marker {
    font: 500 11px/1 'JetBrains Mono', 'IBM Plex Mono', monospace;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    background: linear-gradient(135deg, #B0C3FA 0%, #5E0A02 60%, #F2FFA0 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .casa-edit__callout-text {
    font-size: 14px;
    line-height: 1.55;
    color: var(--ce-body, rgba(255, 255, 255, 0.78));
    margin: 0;
  }
  .casa-edit__callout-text strong {
    font-weight: 600;
    color: var(--ce-heading, #FAFAF7);
  }
  @media (max-width: 749px) {
    .casa-edit__callout {
      grid-template-columns: 22px 1fr;
      gap: 10px;
      padding: 10px 0;
    }
    .casa-edit__callout-marker { font-size: 10px; }
    .casa-edit__callout-text { font-size: 13px; }
  }

  /* ══════════════════════════════════════
     DIVIDER
     ══════════════════════════════════════ */
  .casa-edit__divider {
    width: 80px;
    height: 1px;
    margin: 16px 0 20px;
    border: none;
    background: linear-gradient(90deg, transparent, var(--ce-accent), transparent);
  }
  .casa-edit[style*="--ce-align: center"] .casa-edit__divider { margin-inline: auto; }
  .casa-edit[style*="--ce-align: right"] .casa-edit__divider { margin-left: auto; margin-right: 0; }

  /* ══════════════════════════════════════
     HEADING
     ══════════════════════════════════════ */
  .casa-edit__heading {
    /* Heading scale comes from Theme Settings -> Typography via the
       ces_heading_level dropdown; legacy .casa-edit__heading--{size} modifier
       classes below preserve old behavior as fallbacks. */
    font-size: var(--ce-heading-fs, inherit);
    font-weight: var(--ce-heading-fw, 300);
    line-height: var(--ce-heading-lh, 1.05);
    letter-spacing: var(--ce-heading-ls, .06em);
    text-transform: var(--ce-heading-case, uppercase);
    color: var(--ce-heading);
    margin: 0 0 24px;
    word-wrap: break-word;
    overflow-wrap: break-word;
    max-width: 100%;
    /* Even out multi-line wraps so we don't strand the <em> keyword
       on its own short line. Safari 17.4+ / Chromium 114+ — degrades
       gracefully on older browsers. */
    text-wrap: balance;
  }
  /* Brand italic-gradient accent — wrap one keyword in <em> in the heading. */
  .casa-edit__heading em {
    font-style: italic;
    background: linear-gradient(90deg, #B0C3FA 0%, #5E0A02 50%, #F2FFA0 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  /* Legacy size modifiers - only applied if merchant hasn't picked a
     heading scale yet (the var fallback above wins when set). Once Pass 2
     removes the heading_size field these classes can be deleted. */
  .casa-edit__heading--small  { font-size: var(--ce-heading-fs, clamp(1.5rem, 3vw, 2.25rem)); }
  .casa-edit__heading--medium { font-size: var(--ce-heading-fs, clamp(2rem, 4.5vw, 3.25rem)); }
  .casa-edit__heading--large  { font-size: var(--ce-heading-fs, clamp(2.5rem, 5.5vw, 4.5rem)); }
  .casa-edit__heading--extra-large { font-size: var(--ce-heading-fs, clamp(3rem, 7vw, 6rem)); }
  .casa-edit__heading--custom { font-size: var(--ce-heading-fs, {{ custom_heading_desktop }}px); }

  /* ══════════════════════════════════════
     BODY TEXT
     ══════════════════════════════════════ */
  .casa-edit__body {
    color: var(--ce-body);
    font-size: 16px;
    line-height: 1.7;
    font-weight: 400;
    /* Brand discipline: multi-line prose always left-aligned even when
       the section sets center alignment for the heading/eyebrow. Readers
       form a vertical anchor against the left edge — centered ragged
       paragraphs force re-scanning every line. */
    text-align: left;
  }
  .casa-edit__body p {
    margin: 0 0 16px;
  }
  .casa-edit__body p:last-child {
    margin-bottom: 0;
  }

  /* ══════════════════════════════════════
     CTA BUTTON
     ══════════════════════════════════════ */
  .casa-edit__btn-wrap {
    margin-top: 32px;
  }
  /* Brand class .btn .btn-{{treatment}} provides display, padding,
     gap, font, radius, transition, text-transform, letter-spacing,
     hover, line-height. casa-edit__btn class kept as a hook for
     section-specific overrides (intentionally minimal).
     Legacy --gradient/--solid/--outline modifier rules below kept so
     templates still using deprecated button_style keep rendering until
     merchant picks a new treatment. */
  .casa-edit__btn--gradient {
    background: linear-gradient(135deg, var(--ce-accent), #e0b98a);
    color: var(--casa-ink);
    border: none;
  }
  .casa-edit__btn--gradient:hover {
    filter: brightness(1.12);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(200,149,108,.3);
  }
  .casa-edit__btn--solid {
    background: var(--ce-accent);
    color: var(--casa-ink);
    border: none;
  }
  .casa-edit__btn--solid:hover {
    filter: brightness(1.1);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(200,149,108,.25);
  }
  .casa-edit__btn--outline {
    background: transparent;
    color: var(--ce-text);
    border: 1px solid rgba(255,255,255,.2);
  }
  .casa-edit__btn--outline:hover {
    border-color: var(--ce-accent);
    color: var(--ce-accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(200,149,108,.15);
  }

  /* ── Arrow icon in button ── */
  .casa-edit__btn-arrow {
    width: 14px;
    height: 14px;
    transition: transform .3s ease;
  }
  .casa-edit__btn:hover .casa-edit__btn-arrow {
    transform: translateX(3px);
  }

  /* ══════════════════════════════════════
     WARM GLOW — ambient light effect
     ══════════════════════════════════════ */
  .casa-edit--overlay .casa-edit__overlay-wrap::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 45%;
    background: radial-gradient(ellipse at center bottom, rgba(200,149,108,.08) 0%, transparent 70%);
    pointer-events: none;
    z-index: 1;
  }

  /* ══════════════════════════════════════
     RESPONSIVE
     ══════════════════════════════════════ */
  /* Tablet stack — at <= 989px, split layout becomes single column
     so the image gets the full viewport width instead of a cramped
     side column. Image always sits above text once stacked, even
     when image_position is "right". */
  @media (max-width: 989px) {
    .casa-edit__split-wrap,
    .casa-edit--img-right .casa-edit__split-wrap {
      grid-template-columns: 1fr;
    }
    .casa-edit--img-right .casa-edit__split-image { order: 1; }
    .casa-edit--img-right .casa-edit__split-content { order: 2; }
    .casa-edit__split-image {
      max-height: 520px;
    }
    .casa-edit__split-content {
      padding: 48px 32px 56px;
    }
  }
  @media (max-width: 749px) {
    .casa-edit__split-wrap {
      grid-template-columns: 1fr !important;
      direction: ltr !important;
    }
    .casa-edit__split-image {
      max-height: 380px;
    }
    .casa-edit__split-content {
      padding: 40px 16px 48px;
    }
    .casa-edit__overlay-wrap {
      min-height: 420px;
      padding: 48px 16px;
    }
    .casa-edit__glass {
      padding: 28px 16px;
      border-radius: 12px;
      max-width: calc(100vw - 32px);
    }
    /* Mobile font-size driven by Horizon heading tokens (auto-swap)
       when ces_heading_level is set. Legacy values kept as fallbacks. */
    .casa-edit__heading--small { font-size: var(--ce-heading-fs, clamp(1.25rem, 6vw, 2rem)); letter-spacing: 0.03em; }
    .casa-edit__heading--medium { font-size: var(--ce-heading-fs, clamp(1.5rem, 7vw, 2.5rem)); letter-spacing: 0.03em; }
    .casa-edit__heading--large { font-size: var(--ce-heading-fs, clamp(1.75rem, 8vw, 3rem)); letter-spacing: 0.03em; }
    .casa-edit__heading--extra-large { font-size: var(--ce-heading-fs, clamp(2rem, 9vw, 3.5rem)); letter-spacing: 0.03em; }
    .casa-edit__heading--custom { font-size: var(--ce-heading-fs, {{ custom_heading_mobile }}px); letter-spacing: 0.03em; }
    .casa-edit__stacked-content {
      padding: 40px 16px 48px;
    }
    .casa-edit__names {
      gap: 4px 10px;
    }
    .casa-edit__name {
      white-space: normal;
      font-size: clamp(10px, 2.5vw, 13px);
    }
    .casa-edit__content-zone {
      max-width: calc(100vw - 32px);
    }
  }
</style>

{%- comment -%} ════════════════════  SCRIPT  ════════════════════ {%- endcomment -%}
<script>
  (function () {
    var zones = document.querySelectorAll('#casa-edit-{{ section.id }} [data-ce-animate]');
    if (!zones.length) return;

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.15 });
      zones.forEach(function (z) { io.observe(z); });
    } else {
      zones.forEach(function (z) { z.classList.add('is-visible'); });
    }
  })();
</script>

