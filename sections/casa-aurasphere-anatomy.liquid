{%- comment -%}
  casa-aurasphere-anatomy.liquid
  Used by: product.aurasphere-smart-wall-lamp.json
  50/50 editorial split: off-state photo LEFT, numbered callout list RIGHT.
  Beat: "It disappears when you want it to."
  Mobile: stacks photo-first, photo height capped so the list isn't pushed
  far below the fold.
  Blocks: callout (title, body)
{%- endcomment -%}

{%- liquid
  assign cap = section.settings.container_max | default: 1440
  assign py = section.settings.padding_y | default: 88
  assign py_m = section.settings.padding_y_mobile | default: 56
-%}

<section
  id="aurasphere-anatomy-{{ section.id }}"
  class="cdl-aurasphere-anatomy"
  data-section-id="{{ section.id }}"
  style="
    --cdl-cap: {{ cap }}px;
    --cdl-py: {{ py }}px;
    --cdl-py-m: {{ py_m }}px;
  "
>
  <div class="cdl-as-anatomy__cap">
    <div class="cdl-as-anatomy__grid">

      {%- if section.settings.image != blank -%}
        <div class="cdl-as-anatomy__photo">
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="
              {{ section.settings.image | image_url: width: 600 }} 600w,
              {{ section.settings.image | image_url: width: 900 }} 900w,
              {{ section.settings.image | image_url: width: 1200 }} 1200w
            "
            sizes="(min-width: 900px) 48vw, 100vw"
            alt="{{ section.settings.image_alt | default: 'AuraSphere powered off — a matte black disc on the wall' | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
            decoding="async"
          >
        </div>
      {%- elsif section.settings.image_url != blank -%}
        <div class="cdl-as-anatomy__photo">
          <img
            src="{{ section.settings.image_url }}"
            alt="{{ section.settings.image_alt | default: 'AuraSphere on the wall' | escape }}"
            width="1200"
            height="1200"
            loading="lazy"
            decoding="async"
          >
        </div>
      {%- else -%}
        <div class="cdl-as-anatomy__photo cdl-as-anatomy__photo--empty">
          <div class="cdl-as-anatomy__disc"></div>
          <span class="cdl-mono cdl-as-anatomy__photo-empty-label">[ Off-state photo · matte disc on wall ]</span>
        </div>
      {%- endif -%}

      <div class="cdl-as-anatomy__meta">
        <div class="cdl-mono">{{ section.settings.kicker | default: '03 · ANATOMY' }}</div>
        <h2 class="cdl-h2">{{ section.settings.heading | default: 'It <em>disappears</em> when you want it to.' }}</h2>
        {%- if section.settings.lede != blank -%}
          <p class="cdl-lede">{{ section.settings.lede }}</p>
        {%- endif -%}

        <ul class="cdl-as-anatomy__list">
          {%- assign idx = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'callout' -%}
              {%- assign idx = idx | plus: 1 -%}
              {%- assign callout_icon = block.settings.icon | default: 'none' -%}
              <li class="cdl-as-anatomy__item" {{ block.shopify_attributes }}>
                <span class="cdl-as-anatomy__ico" aria-hidden="true">
                  {%- case callout_icon -%}
                    {%- when 'ring' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5" stroke-dasharray="1.6 1.4" opacity=".6"/></svg>
                    {%- when 'body' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><path d="M 6.5 8 Q 11 5 17.5 8" stroke-width="1" opacity=".55"/><path d="M 6.5 12 Q 11 9 17.5 12" stroke-width="1" opacity=".35"/></svg>
                    {%- when 'mount' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M 4 10 L 20 10 L 18.5 15 L 5.5 15 Z"/><circle cx="12" cy="12.5" r="1.3" fill="currentColor"/><line x1="9.5" y1="18" x2="14.5" y2="18"/></svg>
                    {%- when 'power' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M 9 3 L 9 7 M 15 3 L 15 7"/><rect x="7" y="7" width="10" height="6" rx="1.5"/><path d="M 12 13 L 12 16 Q 12 19 9 19 L 5 19"/></svg>
                    {%- when 'remote' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><rect x="7" y="2.5" width="10" height="19" rx="2"/><line x1="10" y1="6" x2="14" y2="6"/><circle cx="12" cy="10.5" r="1.2" fill="currentColor"/><line x1="10" y1="15" x2="14" y2="15"/><line x1="10" y1="17.5" x2="14" y2="17.5"/></svg>
                    {%- else -%}
                      <span class="cdl-as-anatomy__n">{{ idx | prepend: '00' | slice: -2, 2 }}</span>
                  {%- endcase -%}
                </span>
                <div>
                  <p class="cdl-as-anatomy__title">{{ block.settings.title | default: 'Detail' }}</p>
                  <p class="cdl-as-anatomy__desc">{{ block.settings.body }}</p>
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if section.settings.cta_text != blank -%}
          <a class="cdl-as-anatomy__cta" href="{{ section.settings.cta_url | default: '#' }}">
            {{ section.settings.cta_text }}
            <span aria-hidden="true">→</span>
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% stylesheet %}
.cdl-aurasphere-anatomy {
  background: #0a0a0e;
  color: rgba(255,255,255,0.9);
  padding: 40px 24px;
  font-family: var(--font-body--family);
  position: relative;
  overflow: hidden;
}
.cdl-as-anatomy__cap {
  max-width: var(--cdl-cap, 1440px);
  margin: 0 auto;
}
.cdl-as-anatomy__grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 20px;
  align-items: start;
}
.cdl-as-anatomy__photo {
  position: relative;
  aspect-ratio: 1 / 1;
  max-height: 240px;
  border-radius: 8px;
  overflow: hidden;
  background: radial-gradient(circle at 50% 48%, rgba(255,255,255,0.04), transparent 65%), rgba(255,255,255,0.025);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 12px;
}
.cdl-as-anatomy__photo img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  display: block;
  padding: 8%;
}
.cdl-as-anatomy__photo--empty::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 48% 44%, rgba(255,255,255,0.04), transparent 65%);
}
.cdl-as-anatomy__disc {
  width: 38%;
  aspect-ratio: 1 / 1;
  border-radius: 50%;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  position: relative;
  z-index: 1;
}
.cdl-as-anatomy__photo-empty-label {
  position: relative;
  z-index: 1;
  font-family: 'JetBrains Mono', ui-monospace, monospace;
  font-size: 9px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.22);
  text-align: center;
}
.cdl-as-anatomy__meta {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.cdl-as-anatomy__meta .cdl-mono {
  font-family: 'JetBrains Mono', ui-monospace, monospace;
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.35);
}
.cdl-as-anatomy__meta .cdl-h2 {
  font-family: var(--font-body--family);
  font-weight: 500;
  font-size: clamp(28px, 4vw, 44px);
  letter-spacing: -0.02em;
  line-height: 1.08;
  margin: 0;
  color: #fff;
  text-wrap: balance;
}
.cdl-as-anatomy__meta .cdl-h2 em {
  font-style: italic;
  font-weight: 800;
  background: linear-gradient(90deg, #B0C3FA, #5E0A02, #F2FFA0);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}
.cdl-as-anatomy__meta .cdl-lede {
  font-size: 15px;
  font-weight: 300;
  line-height: 1.55;
  color: rgba(255,255,255,0.62);
  max-width: 56ch;
  margin: 0;
}
.cdl-as-anatomy__list {
  list-style: none;
  padding: 0;
  margin: 4px 0 0;
}
.cdl-as-anatomy__item {
  display: grid;
  grid-template-columns: 32px minmax(0, 1fr);
  gap: 14px;
  align-items: start;
  padding: 12px 0;
  border-top: 1px solid rgba(255,255,255,0.08);
}
.cdl-as-anatomy__item:last-child {
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
.cdl-as-anatomy__ico {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  color: rgba(255,255,255,0.78);
  padding-top: 1px;
}
.cdl-as-anatomy__ico svg { width: 24px; height: 24px; display: block; }
.cdl-as-anatomy__n {
  font-family: 'JetBrains Mono', ui-monospace, monospace;
  font-size: 10px;
  letter-spacing: 0.12em;
  color: rgba(255,255,255,0.3);
  padding-top: 1px;
}
.cdl-as-anatomy__title {
  font-size: 13px;
  font-weight: 500;
  color: rgba(255,255,255,0.92);
  margin: 0 0 2px;
}
.cdl-as-anatomy__desc {
  font-size: 12px;
  font-weight: 300;
  color: rgba(255,255,255,0.55);
  line-height: 1.45;
  margin: 0;
}
.cdl-as-anatomy__cta {
  font-family: var(--font-body--family);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.4);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
  transition: color .15s;
  align-self: flex-start;
}
.cdl-as-anatomy__cta:hover,
.cdl-as-anatomy__cta:focus-visible { color: rgba(255,255,255,0.85); outline: none; }

@media (min-width: 900px) {
  .cdl-aurasphere-anatomy { padding: var(--cdl-py, 88px) 32px; }
  .cdl-as-anatomy__grid {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 5vw, 80px);
  }
  .cdl-as-anatomy__photo {
    aspect-ratio: 1 / 1;
    max-height: 560px;
  }
  .cdl-as-anatomy__meta { gap: 20px; }
  .cdl-as-anatomy__item { padding: 18px 0; gap: 14px; }
  .cdl-as-anatomy__title { font-size: 15px; }
  .cdl-as-anatomy__desc { font-size: 14px; }
}

@media (prefers-reduced-motion: reduce) {
  .cdl-as-anatomy__cta { transition: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "AuraSphere · Anatomy",
  "tag": "section",
  "class": "casa-aurasphere-anatomy-wrapper",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "03 · ANATOMY" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "It <em>disappears</em> when you want it to." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "When off, AuraSphere presents as a clean 20-inch matte disc on your wall. No exposed hardware. No visible cord path. Just a circle that happens to glow." },
    { "type": "header", "content": "Photo" },
    { "type": "image_picker", "id": "image", "label": "Off-state photo", "info": "Sphere powered off, on the wall." },
    { "type": "text", "id": "image_url", "label": "Image URL fallback", "info": "Used when no Shopify image is selected" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "AuraSphere powered off — a matte black disc on the wall" },
    { "type": "header", "content": "CTA (optional)" },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Shop the full collection" },
    { "type": "url", "id": "cta_url", "label": "CTA link" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "container_max", "label": "Container max width", "min": 1100, "max": 1600, "step": 20, "default": 1440, "unit": "px" },
    { "type": "range", "id": "padding_y", "label": "Vertical padding (desktop)", "min": 32, "max": 160, "step": 8, "default": 88, "unit": "px" },
    { "type": "range", "id": "padding_y_mobile", "label": "Vertical padding (mobile)", "min": 24, "max": 96, "step": 4, "default": 56, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "callout",
      "name": "Callout",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "none",
          "options": [
            { "value": "none",   "label": "Number only (no icon)" },
            { "value": "ring",   "label": "Ring / LED halo" },
            { "value": "body",   "label": "Body / material" },
            { "value": "mount",  "label": "Mount / bracket" },
            { "value": "power",  "label": "Power / plug" },
            { "value": "remote", "label": "Remote / app" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Detail" },
        { "type": "textarea", "id": "body", "label": "Body (one short line)", "default": "Short single-line description." }
      ]
    }
  ],
  "presets": [
    {
      "name": "AuraSphere · Anatomy",
      "blocks": [
        { "type": "callout", "settings": { "title": "Rim LED array",       "body": "Individually-addressable LEDs behind a diffused lens. Smooth halo, no hot spots." } },
        { "type": "callout", "settings": { "title": "Matte aluminum body", "body": "Fingerprint-resistant finish, heat-neutral in normal use. The matte face vanishes when the light is off." } },
        { "type": "callout", "settings": { "title": "Cleat mount system",  "body": "Single center screw, two anchor points. Level-adjusting. No visible bracket." } },
        { "type": "callout", "settings": { "title": "DC power",            "body": "Standard DC adapter and cord — runs on any household outlet, 100-240V worldwide." } },
        { "type": "callout", "settings": { "title": "Remote + app",        "body": "Same IR remote and companion smart app that ship with our Infinity Mirrors. Pair once over WiFi, or skip the app and use the remote." } },
        { "type": "callout", "settings": { "title": "Floats off the wall", "body": "Sits roughly 1.5 inches proud of the wall — a deliberate shadow line so the sphere reads as floating, not flush." } }
      ]
    }
  ]
}
{% endschema %}
