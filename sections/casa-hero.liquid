{% stylesheet %}
/* ══════════════════════════════════════════════════════════════════════════
   CASA HERO - PREMIUM EDITION
   Full-featured hero section with animations, themes, and conversion elements
   ══════════════════════════════════════════════════════════════════════════ */

/* ── CSS Custom Properties ── */
.casa-hero {
  --hero-height: 90vh;
  --hero-color-1: #B0C3FA;
  --hero-color-2: #5E0A02;
  --hero-color-3: #F2FFA0;
  --hero-overlay-opacity: 0.7;
  --hero-text-align: left;
}

/* ── Base Container ── */
.casa-hero {
  position: relative;
  height: var(--hero-height);
  min-height: 600px;
  max-height: 1200px;
  overflow: hidden;
  max-width: 100vw;
  display: flex;
  align-items: center;
  background: var(--hero-bg-color, var(--casa-ink));
  padding-top: var(--hero-padding-top, 0);
  padding-bottom: var(--hero-padding-bottom, 0);
}

/* ── Background Layer ── */
.casa-hero__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.casa-hero__bg-image,
.casa-hero__video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Lazy video: starts HIDDEN and is revealed only once it is actually
   playing (JS adds .casa-video-visible on the 'playing' event). The
   .casa-hero__bg-image poster underneath shows until then. This is what
   kills the iOS Low Power Mode play-button FLASH: a hidden video element has no
   rendered control layer, so iOS never paints the centre play button while
   autoplay is blocked — the poster is simply all the user ever sees.
   visibility (not opacity) is deliberate — it's a discrete swap, so it
   cannot reintroduce the opacity-fade text recomposite flicker we removed. */
.casa-hero__bg .casa-hero__video,
.casa-hero__bg .casa-hero__bg-image {
  position: absolute;
  inset: 0;
}
.casa-hero__bg .casa-hero__video {
  z-index: 1;
  pointer-events: none;
  visibility: hidden;
}
.casa-hero__bg .casa-hero__video.casa-video-visible {
  visibility: visible;
}

/* Decorative hero videos (both the full-bleed background video and the
   in-card visual video — same decorative, no-controls contract) autoplay
   muted+inline and are NOT user-controlled. iOS/iPadOS Safari paints a
   native centre play button (the "start-playback-button") whenever autoplay
   is blocked — Low Power Mode, reduced-data, or a rejected programmatic
   play(). Suppress every WebKit media-control pseudo-element so the poster
   image is the clean fallback and no stray play/pause button ever appears.

   CRITICAL: each pseudo-element gets its OWN rule. A comma-grouped selector
   list is invalidated *in its entirety* by any one selector the engine
   doesn't recognise (CSS Selectors spec). `-overlay-play-button` is a
   Chromium pseudo-element that iOS Safari does NOT know — grouping it with
   the iOS-only `-start-playback-button` made iOS drop the WHOLE rule, so the
   button was never hidden on real iPhones (while Chromium, which knows both,
   kept the rule and looked fine in testing). Splitting per pseudo-element
   means an unknown selector only drops its own rule, never the others. */
.casa-hero__video::-webkit-media-controls,
.casa-hero__visual-media video::-webkit-media-controls {
  display: none !important;
  -webkit-appearance: none;
  appearance: none;
  opacity: 0 !important;
}
.casa-hero__video::-webkit-media-controls-enclosure,
.casa-hero__visual-media video::-webkit-media-controls-enclosure {
  display: none !important;
}
.casa-hero__video::-webkit-media-controls-panel,
.casa-hero__visual-media video::-webkit-media-controls-panel {
  display: none !important;
}
.casa-hero__video::-webkit-media-controls-play-button,
.casa-hero__visual-media video::-webkit-media-controls-play-button {
  display: none !important;
}
/* The iOS centre play button — the one in the screenshot. Standalone so it
   is never poisoned by a sibling selector iOS rejects. */
.casa-hero__video::-webkit-media-controls-start-playback-button,
.casa-hero__visual-media video::-webkit-media-controls-start-playback-button {
  display: none !important;
  -webkit-appearance: none;
  appearance: none;
}
/* Chromium/Android overlay button — isolated so it can't take iOS down. */
.casa-hero__video::-webkit-media-controls-overlay-play-button,
.casa-hero__visual-media video::-webkit-media-controls-overlay-play-button {
  display: none !important;
}

/* iOS: skip video fade to prevent text flicker during recomposite */
@media (max-width: 749px) {
  .casa-hero__bg .casa-hero__video {
    transition: none;
  }
}

.casa-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  background: linear-gradient(
    135deg,
    rgba(10, 10, 15, var(--hero-overlay-opacity)) 0%,
    rgba(26, 26, 46, calc(var(--hero-overlay-opacity) * 0.9)) 50%,
    rgba(22, 33, 62, calc(var(--hero-overlay-opacity) * 0.8)) 100%
  );
}

/* ══════════════════════════════════════════════════════════════════════════
   ANIMATION STYLES
   ══════════════════════════════════════════════════════════════════════════ */

.casa-hero__animations {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
}

/* ── Particles ── */
.casa-hero__particle {
  position: absolute;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--hero-color-1);
  opacity: 0.6;
  bottom: -10px;
  animation: hero-particle 10s linear infinite;
}

.casa-hero__particle:nth-child(1) { left: 5%; animation-delay: 0s; }
.casa-hero__particle:nth-child(2) { left: 12%; animation-delay: 0.8s; background: var(--hero-color-2); }
.casa-hero__particle:nth-child(3) { left: 20%; animation-delay: 1.6s; background: var(--hero-color-3); }
.casa-hero__particle:nth-child(4) { left: 28%; animation-delay: 2.4s; }
.casa-hero__particle:nth-child(5) { left: 36%; animation-delay: 3.2s; background: var(--hero-color-2); }
.casa-hero__particle:nth-child(6) { left: 44%; animation-delay: 4s; background: var(--hero-color-3); }
.casa-hero__particle:nth-child(7) { left: 52%; animation-delay: 4.8s; }
.casa-hero__particle:nth-child(8) { left: 60%; animation-delay: 5.6s; background: var(--hero-color-2); }
.casa-hero__particle:nth-child(9) { left: 68%; animation-delay: 6.4s; background: var(--hero-color-3); }
.casa-hero__particle:nth-child(10) { left: 76%; animation-delay: 7.2s; }
.casa-hero__particle:nth-child(11) { left: 84%; animation-delay: 8s; background: var(--hero-color-2); }
.casa-hero__particle:nth-child(12) { left: 92%; animation-delay: 8.8s; background: var(--hero-color-3); }
.casa-hero__particle:nth-child(13) { left: 8%; animation-delay: 1.2s; width: 6px; height: 6px; }
.casa-hero__particle:nth-child(14) { left: 48%; animation-delay: 3.8s; width: 6px; height: 6px; background: var(--hero-color-2); }
.casa-hero__particle:nth-child(15) { left: 88%; animation-delay: 6.2s; width: 6px; height: 6px; background: var(--hero-color-3); }

@keyframes hero-particle {
  0% { transform: translateY(0) translateX(0) scale(1); opacity: 0; }
  5% { opacity: 0.8; }
  50% { opacity: 0.6; }
  95% { opacity: 0.4; }
  100% { transform: translateY(-100vh) translateX(30px) scale(0.5); opacity: 0; }
}

/* ── Aurora ── */
.casa-hero__aurora {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.casa-hero__aurora-layer {
  position: absolute;
  width: 200%;
  height: 200%;
  top: -50%;
  left: -50%;
  background: conic-gradient(
    from 0deg at 50% 50%,
    transparent 0deg,
    var(--hero-color-1) 60deg,
    transparent 120deg,
    var(--hero-color-2) 180deg,
    transparent 240deg,
    var(--hero-color-3) 300deg,
    transparent 360deg
  );
  opacity: 0.15;
  animation: aurora-rotate 20s linear infinite;
  filter: blur(80px);
}

.casa-hero__aurora-layer:nth-child(2) {
  animation-delay: -6s;
  animation-duration: 25s;
  opacity: 0.1;
}

.casa-hero__aurora-layer:nth-child(3) {
  animation-delay: -12s;
  animation-duration: 30s;
  opacity: 0.12;
}

@keyframes aurora-rotate {
  to { transform: rotate(360deg); }
}

/* ── Orbs ── */
.casa-hero__orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(60px);
  animation: orb-float 8s ease-in-out infinite;
}

.casa-hero__orb--1 {
  width: 400px;
  height: 400px;
  background: var(--hero-color-1);
  opacity: 0.3;
  top: 10%;
  left: 10%;
}

.casa-hero__orb--2 {
  width: 300px;
  height: 300px;
  background: var(--hero-color-2);
  opacity: 0.25;
  top: 40%;
  right: 15%;
  animation-delay: -2s;
}

.casa-hero__orb--3 {
  width: 350px;
  height: 350px;
  background: var(--hero-color-3);
  opacity: 0.2;
  bottom: 10%;
  left: 30%;
  animation-delay: -4s;
}

@keyframes orb-float {
  0%, 100% { transform: translate(0, 0) scale(1); }
  25% { transform: translate(30px, -20px) scale(1.05); }
  50% { transform: translate(-20px, 30px) scale(0.95); }
  75% { transform: translate(20px, 20px) scale(1.02); }
}

/* ── Gradient Flow ──
   Compositor-only transform on an oversized pseudo (the
   casa-announcement shimmer pattern) — background-position on the old
   inset:0 element repainted the whole hero every frame. Geometry is
   equivalent: 400%×400% pseudo at top:-150% ≡ background-size:400% 400%
   at position-y 50%; translateX(-75%) ≡ background-position-x 100%. */
.casa-hero__gradient-flow {
  position: absolute;
  inset: 0;
  opacity: 0.15;
  overflow: hidden;
}
.casa-hero__gradient-flow::before {
  content: '';
  position: absolute;
  top: -150%;
  left: 0;
  width: 400%;
  height: 400%;
  background: linear-gradient(
    45deg,
    var(--hero-color-1),
    var(--hero-color-2),
    var(--hero-color-3),
    var(--hero-color-1)
  );
  will-change: transform;
  /* perf-justified: compositor-only transform, viewport-gated via
     data-casa-anim-gate on the section root */
  animation: gradient-flow 15s ease infinite;
}

@keyframes gradient-flow {
  0% { transform: translateX(0); }
  50% { transform: translateX(-75%); }
  100% { transform: translateX(0); }
}

@media (prefers-reduced-motion: reduce) {
  .casa-hero__gradient-flow::before { animation: none; }
}

/* ── Starfield ── */
.casa-hero__star {
  position: absolute;
  width: 2px;
  height: 2px;
  background: var(--casa-paper);
  border-radius: 50%;
  animation: star-twinkle 3s ease-in-out infinite;
}

.casa-hero__star:nth-child(odd) { animation-delay: -1.5s; }
.casa-hero__star:nth-child(3n) { width: 3px; height: 3px; }
.casa-hero__star:nth-child(5n) { animation-duration: 4s; }
.casa-hero__star:nth-child(7n) { animation-duration: 2.5s; }

/* Position stars randomly using nth-child */
.casa-hero__star:nth-child(1) { top: 10%; left: 5%; }
.casa-hero__star:nth-child(2) { top: 5%; left: 15%; }
.casa-hero__star:nth-child(3) { top: 15%; left: 25%; }
.casa-hero__star:nth-child(4) { top: 8%; left: 35%; }
.casa-hero__star:nth-child(5) { top: 20%; left: 45%; }
.casa-hero__star:nth-child(6) { top: 3%; left: 55%; }
.casa-hero__star:nth-child(7) { top: 12%; left: 65%; }
.casa-hero__star:nth-child(8) { top: 18%; left: 75%; }
.casa-hero__star:nth-child(9) { top: 7%; left: 85%; }
.casa-hero__star:nth-child(10) { top: 22%; left: 95%; }
.casa-hero__star:nth-child(11) { top: 30%; left: 8%; }
.casa-hero__star:nth-child(12) { top: 35%; left: 18%; }
.casa-hero__star:nth-child(13) { top: 28%; left: 28%; }
.casa-hero__star:nth-child(14) { top: 40%; left: 38%; }
.casa-hero__star:nth-child(15) { top: 32%; left: 48%; }
.casa-hero__star:nth-child(16) { top: 38%; left: 58%; }
.casa-hero__star:nth-child(17) { top: 25%; left: 68%; }
.casa-hero__star:nth-child(18) { top: 42%; left: 78%; }
.casa-hero__star:nth-child(19) { top: 33%; left: 88%; }
.casa-hero__star:nth-child(20) { top: 45%; left: 92%; }
.casa-hero__star:nth-child(21) { top: 50%; left: 3%; }
.casa-hero__star:nth-child(22) { top: 55%; left: 12%; }
.casa-hero__star:nth-child(23) { top: 48%; left: 22%; }
.casa-hero__star:nth-child(24) { top: 60%; left: 32%; }
.casa-hero__star:nth-child(25) { top: 52%; left: 42%; }
.casa-hero__star:nth-child(26) { top: 58%; left: 52%; }
.casa-hero__star:nth-child(27) { top: 65%; left: 62%; }
.casa-hero__star:nth-child(28) { top: 53%; left: 72%; }
.casa-hero__star:nth-child(29) { top: 62%; left: 82%; }
.casa-hero__star:nth-child(30) { top: 68%; left: 90%; }
.casa-hero__star:nth-child(31) { top: 70%; left: 6%; }
.casa-hero__star:nth-child(32) { top: 75%; left: 16%; }
.casa-hero__star:nth-child(33) { top: 72%; left: 26%; }
.casa-hero__star:nth-child(34) { top: 78%; left: 36%; }
.casa-hero__star:nth-child(35) { top: 82%; left: 46%; }
.casa-hero__star:nth-child(36) { top: 76%; left: 56%; }
.casa-hero__star:nth-child(37) { top: 80%; left: 66%; }
.casa-hero__star:nth-child(38) { top: 85%; left: 76%; }
.casa-hero__star:nth-child(39) { top: 88%; left: 86%; }
.casa-hero__star:nth-child(40) { top: 90%; left: 94%; }
.casa-hero__star:nth-child(n+41) { top: 92%; left: calc((40 - var(--n, 41)) * 2%); }

@keyframes star-twinkle {
  0%, 100% { opacity: 0.3; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.2); }
}

/* ── Waves ── */
.casa-hero__waves {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200px;
  overflow: hidden;
}

.casa-hero__wave {
  position: absolute;
  bottom: 0;
  left: -50%;
  width: 200%;
  height: 100%;
  background: linear-gradient(to top, var(--hero-color-1), transparent);
  opacity: 0.1;
  border-radius: 100% 100% 0 0;
  animation: wave-motion 8s ease-in-out infinite;
}

.casa-hero__wave:nth-child(2) {
  animation-delay: -2s;
  opacity: 0.08;
  background: linear-gradient(to top, var(--hero-color-2), transparent);
}

.casa-hero__wave:nth-child(3) {
  animation-delay: -4s;
  opacity: 0.06;
  background: linear-gradient(to top, var(--hero-color-3), transparent);
}

@keyframes wave-motion {
  0%, 100% { transform: translateX(0) translateY(0); }
  50% { transform: translateX(2%) translateY(-10px); }
}

/* ══════════════════════════════════════════════════════════════════════════
   PROMO BANNER
   ══════════════════════════════════════════════════════════════════════════ */

.casa-hero__promo {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding: 10px 20px;
  overflow: hidden;
  /* Static fill only — the moving gradient is the ::before below
     (compositor transform; background-position on the bar itself
     repainted the strip every frame). Same 300% sizing as before so
     the reduced-motion fallback is pixel-identical to the old bar. */
  background: linear-gradient(
    90deg,
    var(--hero-color-1),
    var(--hero-color-2),
    var(--hero-color-3),
    var(--hero-color-2),
    var(--hero-color-1)
  );
  background-size: 300% 100%;
}
.casa-hero__promo::before {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 300%;
  background: linear-gradient(
    90deg,
    var(--hero-color-1),
    var(--hero-color-2),
    var(--hero-color-3),
    var(--hero-color-2),
    var(--hero-color-1)
  );
  will-change: transform;
  /* 2s (was 4s on background-position): the transform cycle covers half
     the travel per loop, so halving the duration keeps the drift speed.
     perf-justified: compositor-only transform, viewport-gated via
     data-casa-anim-gate on the section root */
  animation: promo-shimmer 2s linear infinite;
}
.casa-hero__promo > * {
  position: relative;
  z-index: 1;
}

.casa-hero__promo-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: var(--hero-promo-text, #fff);
  font-size: 14px;
  font-weight: 500;
}

.casa-hero__promo-inner svg {
  width: 16px;
  height: 16px;
  stroke: #fff;
}

.casa-hero__promo-code {
  background: rgba(255, 255, 255, 0.2);
  padding: 4px 12px;
  border-radius: 4px;
  font-weight: 700;
  font-family: inherit;
}

@keyframes promo-shimmer {
  0% { transform: translateX(0); }
  100% { transform: translateX(-66.667%); }
}

@media (prefers-reduced-motion: reduce) {
  .casa-hero__promo::before { animation: none; }
}

/* Solid promo strip. The promo_bg_color setting has always been emitted as
   --hero-promo-bg but nothing consumed it — the strip painted the hero
   COLOR-THEME gradient (with the live custom theme's white/black/black that
   renders broken). When the merchant sets the color, the section adds
   --solid: the strip takes the setting and drops the animated gradient
   layer. With the setting blank the legacy gradient path is untouched. */
.casa-hero__promo--solid {
  background: var(--hero-promo-bg, #0A0A0F);
}
.casa-hero__promo--solid::before {
  content: none;
}

.casa-hero__countdown {
  /* Follow the merchant's promo_text_color; the opacity blend over the
     opaque strip matches the old rgba(255,255,255,0.72) on Ink exactly. */
  color: var(--hero-promo-text, #fff);
  opacity: 0.72;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

/* The strip is one flex line, budgeted against the overflow matrix
   (280 / 320 / 375) plus the mainstream-phone band the review flagged:
   ≤519px: drop the countdown — text + countdown need ~460px for a single
   line, so 380–519px viewports would force a two-line strip that can
   overlap the hero content's top padding. One clean line beats a timer.
   ≤339px: drop the icon and step the type down so the text alone fits the
   Galaxy Fold's 240px content box (280px viewport minus strip padding).
   overflow:hidden is not a fix — clipped copy still renders broken. */
@media (max-width: 519px) {
  .casa-hero__countdown { display: none; }
}
@media (max-width: 339px) {
  .casa-hero__promo-inner { font-size: 12.5px; }
  .casa-hero__promo-inner > svg { display: none; }
}

/* ══════════════════════════════════════════════════════════════════════════
   CONTENT CONTAINER
   ══════════════════════════════════════════════════════════════════════════ */

.casa-hero__container {
  position: relative;
  z-index: 5;
  width: 100%;
  max-width: min(1600px, 100vw);
  margin: 0 auto;
  padding: 0 80px;
  box-sizing: border-box;
  /* overflow: visible so the levitating mirror's blurred glow halo
     (`.casa-hero__glow-frame` is `inset: -30px` past the wrapper) is
     not clipped against the container's top edge when `hero-float`
     lifts the wrapper -15px, which otherwise exposes a visible hard
     horizontal "blurred bar" at the top of the mirror. The section
     itself still has `overflow: hidden` (~85px vertical headroom on
     desktop), so the halo is contained at the section boundary
     without any horizontal scroll regression. */
  overflow: visible;
}

.casa-hero__content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

/* ── Layout Variants ── */
.casa-hero--split-reverse .casa-hero__content {
  direction: rtl;
}

.casa-hero--split-reverse .casa-hero__content > * {
  direction: ltr;
}

.casa-hero--centered .casa-hero__content {
  grid-template-columns: 1fr;
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
}

.casa-hero--centered .casa-hero__text {
  align-items: center;
}

.casa-hero--full-visual .casa-hero__content {
  grid-template-columns: 1fr;
  max-width: 800px;
}

/* ══════════════════════════════════════════════════════════════════════════
   TEXT CONTENT
   ══════════════════════════════════════════════════════════════════════════ */

.casa-hero__text {
  display: flex;
  flex-direction: column;
  align-items: var(--hero-flex-align, flex-start);
  text-align: var(--hero-text-align);
  /* Entrance animation shortened 2026-05-11 from 1s to 250ms after iOS
     recording showed the entire hero text column (tag, subtitle, CTAs)
     was invisible for ~3s on slow iOS connections. The 1s fade-in
     compounded with CSS load latency to produce a multi-second blank
     hero. 250ms still reads as a soft entrance, but doesn't extend the
     "blank" window noticeably on slow networks. */
  animation: hero-fadeInUp 250ms ease-out both;
}

/* prefers-reduced-motion: skip the fade so a dropped first frame can't
   strand the text column at opacity:0 on iOS Safari. */
@media (prefers-reduced-motion: reduce) {
  .casa-hero__text {
    animation: none;
  }
}

/* ── Inline product image (mobile only) ── */
.casa-hero__inline-image {
  display: none;
}

@media (max-width: 749px) {
  .casa-hero__inline-image {
    display: block;
    width: var(--hero-inline-img-width, 80%);
    margin: 12px 0;
    border-radius: var(--hero-inline-img-radius, 12px);
    overflow: hidden;
  }
  .casa-hero__inline-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    border-radius: var(--hero-inline-img-radius, 12px);
  }
}

/* Glassmorphic content background — see the inline style block below, controlled by Liquid */

@keyframes hero-fadeInUp {
  from { transform: translateY(40px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

/* ── Badges ── */
.casa-hero__badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 20px;
}

.casa-hero__badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border-radius: 100px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* Badge color overrides from settings */
.casa-hero__badge[style] {
  /* Inline styles from settings take priority */
}

.casa-hero__badge svg {
  width: 12px;
  height: 12px;
}

.casa-hero__badge--new {
  background: linear-gradient(135deg, var(--hero-color-1), var(--hero-color-2));
  color: #fff;
}

.casa-hero__badge--sale {
  background: linear-gradient(135deg, #ef4444, #f97316);
  color: #fff;
}

.casa-hero__badge--limited {
  background: linear-gradient(135deg, #f59e0b, #eab308);
  color: #000;
}

.casa-hero__badge--tag {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: var(--hero-color-1);
}

.casa-hero__badge--tag svg {
  fill: currentColor;
  stroke: none;
}

/* ── Title ── */
/*
  FOUT no-show fix (DECISIVE).
  ─────────────────────────────────────────────────────────────────
  The merchant reported repeated complaints that "Light" enlarges
  visibly when the page loads. Investigation via Playwright + the
  PerformanceObserver layout-shift API identified the actual swap:
    Phase 1 (FOUT): browser renders the H1 with -apple-system
                    (the third entry in the cascade), width = 333px
    Phase 2 (Inter loads, ~3.6s): swap to Inter, width = 361px
    Net shift: +27px / +7.6% — clearly visible enlargement
  We tried multiple metric-matched fallback strategies ('Inter
  Fallback' via local Arial with size-adjust 113%) but the browser
  skips that face during FOUT and goes straight to -apple-system,
  whose metrics don't match Inter. document.fonts.check('Inter
  Fallback') returns false during FOUT.

  Decisive fix: hide the title until document.fonts.ready resolves.
  The hero JS at the bottom of this section adds a `.fonts-ready`
  class to the body once Inter has actually loaded; until then the
  title is opacity:0. With our preload + fetchpriority="high" hints
  in fonts.liquid, Inter typically arrives in <100ms so the
  invisible window is barely perceptible. A no-JS fallback keeps
  the title visible after a short delay so the page never silently
  hides text. Keeps the metric-matched 'Inter Fallback' as a
  backup for the rare case where JS is disabled AND fonts arrive
  slowly.
*/
/*
   2026-05-12 — REMOVED the `html:not(.fonts-ready) .casa-hero__title
   { opacity: 0 }` rule and its associated 500ms CSS-animation
   backstop.

   Why: the rule was solving the wrong problem. It hid the title
   to avoid FOUT (font-swap visual shift) when Inter loads, relying
   on JS to add `.fonts-ready` once `document.fonts.check('700 16px
   Inter')` returns true, with a 500ms CSS animation backstop as a
   safety net.

   On real iOS Safari devices (the user's actual environment), one
   of those three things isn't firing reliably:
     - The JS fonts.check() can return false negatives during
       initial render due to font registration timing
     - The 500ms CSS animation backstop has been observed to NOT
       fire on some iOS Safari versions (the recorded 10s-blank
       hero is the evidence)
     - The JS setTimeout(ready, 500) backstop also relies on a
       running JavaScript engine that can be stalled by main-
       thread work during the same time window

   Result: the user saw the hero title invisible for 10+ seconds.

   The CORRECT fix is to never hide the title in the first place.
   We already declare an `Inter-Fallback` @font-face in fonts.liquid
   that's metric-matched (Arial @ ~113% size-adjust to match Inter's
   x-height + width). When Inter swaps in, the visual shift is
   minimal — far less perceptible than 10s of blank space.

   Trade-off: brief FOUT on first paint vs. potential blank hero on
   font-load failure. Showing the text always — even with the
   fallback font — is strictly better UX.

   The JS that adds `.fonts-ready` is left in place (it's harmless
   and other components may consume it) but the title's opacity no
   longer depends on it.
*/
.casa-hero__title {
  /* No opacity:0 default. Title is visible from first paint with
     the metric-matched Inter-Fallback font. Inter swaps in
     seamlessly via `font-display: optional` in fonts.liquid. */
  opacity: 1;
}
.casa-hero__title {
  /* Title must NEVER wrap to two lines per design — see
     .casa-hero__title-line below for the nowrap guarantee. The
     font-size therefore needs to scale down enough to always fit
     "Live in your own" inside the right-column width of the
     split layout, which at the narrowest desktop+ viewport is
     about 365px. Clamp upper bound stays at 56px (the merchant's
     desktop H1 size) so wide screens are unchanged; the 4.4vw
     middle term scales down through tablet and narrow-laptop
     widths so the text always fits one line. The merchant's
     --hero-title-fs token is intentionally NOT consumed here:
     it can resolve to a value that's too big for narrow viewports
     and break the no-wrap promise. */
  font-size: clamp(28px, 4vw, 56px);
  /* Metrics-matched fallback — see @font-face for 'Inter Fallback'
     in snippets/fonts.liquid. We CANNOT use var(--font-heading--family)
     here because Shopify expands it to "Inter, -apple-system,
     BlinkMacSystemFont, ..., sans-serif" — the system fallbacks are
     baked INSIDE the variable. Adding 'Inter Fallback' after the
     variable puts it after sans-serif, where it never gets used.
     Hardcoding 'Inter', 'Inter Fallback' as the first two stack
     entries puts the metric-matched fallback exactly where we need
     it: between the real font and the system fallbacks. When Inter
     hasn't loaded yet, the browser uses 'Inter Fallback' (Arial
     resized to match Inter's glyph metrics) so the visual size on
     first paint equals the visual size after Inter swaps in — no
     enlargement is visible. Inherited by .casa-hero__title-gradient
     ("Light") which is the word that was visibly resizing in the
     screen recording. */
  font-family: var(--font-heading--family);
  /* Brand book §Typography hero spec (docs/brand-book-v1.html:1102):
     "Hero: 96 / 700-800, letter-spacing -0.025em, line-height 0.95."
     Brand-locked — overrides Horizon's H1 token because the hero is
     the loud moment per the quiet-chrome principle.
     Locked typography rule: italic = hero accent ONLY (the gradient
     span below). Title proper stays upright; the brand book's
     "italic accent register" alternate is documented but not used
     in this theme — see the locked decisions memory. */
  font-weight: 700;
  line-height: 0.95;
  letter-spacing: -0.025em;
  text-transform: var(--hero-title-case, none);
  color: var(--hero-title-color, #fff);
  /* Tighter to lead into the accent — the two lines should read as
     one typographic gesture, not stacked sentences. */
  margin: 0 0 8px 0;
}

.casa-hero__title-line {
  display: block;
  /* Hard requirement: "Live in your own" never wraps to two lines
     at any viewport. Combined with the title's clamp() font-size
     this guarantees a single-line title from 320px up to any width. */
  white-space: nowrap;
}

.casa-hero__title-gradient {
  display: block;
  width: fit-content;
  /* Accent word is italic, so it needs the italic-tuned metrics-matched
     fallback ('Inter Fallback Italic' @ size-adjust 113%). The H1's
     stack uses 'Inter Fallback' (upright @ 107%) which would over-widen
     the italic accent on first paint. The -italic twin token carries
     that fallback — defined in snippets/theme-styles-variables.liquid,
     calibrated in snippets/fonts.liquid. */
  font-family: var(--font-heading-italic--family);
  /* Accent word is intentionally scaled larger than the title proper
     for display-sized punch. clamp() ranges scale ~1.4x the default
     title clamp(36px, 6vw, 80px) at every breakpoint. Tightened
     line-height + letter-spacing pull the heavier glyphs together so
     it reads as a single typographic gesture. Merchant-supplied
     --hero-accent-* vars (set when accent_heading_level != 'inherit')
     still win when present. */
  font-size: var(--hero-accent-fs, clamp(52px, 9vw, 120px));
  /* Brand book §Typography hero accent: 800 weight + italic.
     Italic is reserved for hero accent word ONLY (see brand book
     "what to avoid" line: italic in body / on buttons is a no).
     The shimmer gradient is applied via the .text-grad-shimmer
     utility class added by the section's Liquid template — do NOT
     re-declare the gradient here.
     ─────────────────────────────────────────────────────────────
     FOUT FIX (was: font-weight: 800): Shopify's font_face filter
     renders @font-face only for the weights it generates from the
     merchant's font_picker — for inter_n7 those are 400 and 700
     (regular / bold), with italic and bold-italic variants. There
     is NO 800-weight @font-face declared, so a CSS request for
     `font-weight: 800` resolves to the nearest available variant
     (700 italic) and the browser layers SYNTHETIC bolding on top.
     Synthetic bolding renders differently in the system-fallback
     phase vs the loaded-Inter phase, producing a visible thickness
     swap on the word "Light" between ~16ms and ~80ms after load.
     Asking for 700 directly (which IS a real preloaded @font-face,
     see snippets/fonts.liquid + theme-styles-variables.liquid line
     ~100) eliminates the synthesis-mismatch entirely. The visual
     loss of the extra 100 weight units in Inter Italic is barely
     perceptible behind the shimmer gradient. */
  font-weight: 700;
  font-style: italic;
  /* Disable synthetic font weight/style. The fallback should render
     in its closest-available variant; we don't want the browser
     fabricating a different glyph thickness, which is what created
     the FOUT-style visual swap on first paint. */
  font-synthesis-weight: none;
  line-height: var(--hero-accent-lh, 1);
  letter-spacing: var(--hero-accent-ls, -0.04em);
  text-transform: var(--hero-accent-case, inherit);
  /* Tighter coupling with the title — both run at line-height 0.95
     so a fixed em margin reads as the same gap on every viewport. */
  margin-top: 0.06em;
  padding-bottom: 0.12em;
  /* width:fit-content makes a block element shrink to its content,
     which means parent text-align no longer positions it. Drive
     auto-margins from --hero-text-align (set via the inline style block at
     section top from the text_alignment setting). */
  margin-inline-start: var(--hero-gradient-mstart, 0);
  margin-inline-end:   var(--hero-gradient-mend, 0);
}

/* Brand-book gradient backgrounds.
   IMPORTANT: background-image must come BEFORE background-clip / color, and
   the `background` shorthand cannot be used here — the shorthand resets all
   longhand background-* properties including background-clip, which would
   undo the text-clipping. Use background-image to set just the image layer.
   Pattern adapted from sections/casa-testimonials.liquid (.casa-test__accent--shimmer). */
.casa-hero__title-gradient--shimmer {
  /* Solid fallback first — if iOS misses the first paint of the gradient
     image, the word stays readable instead of going invisible. */
  color: var(--hero-accent-word-1, #fff);
  -webkit-text-fill-color: var(--hero-accent-word-1, #fff);
  background-image: var(--grad-shimmer);
  background-size: 200% 100%;
  animation: casa-text-shimmer 6s linear infinite;
  /* Force its own compositor layer so the gradient paint can't race the
     transparent text fill on iOS Safari. */
  transform: translateZ(0);
}
@supports ((-webkit-background-clip: text) or (background-clip: text)) {
  .casa-hero__title-gradient--shimmer {
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
}
.casa-hero__title-gradient--text {
  color: var(--hero-accent-word-1, #fff);
  -webkit-text-fill-color: var(--hero-accent-word-1, #fff);
  background-image: var(--grad-text);
  transform: translateZ(0);
}
@supports ((-webkit-background-clip: text) or (background-clip: text)) {
  .casa-hero__title-gradient--text {
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
}

/* Hide spans with literally no children. */
.casa-hero__title-gradient:empty {
  display: none;
}

/* Custom gradient (legacy: merchant-picked colors).
   Only applied when Accent word style = "custom" — the brand-book
   .text-grad-shimmer / .text-grad-text classes handle the other two
   options via assets/casa-buttons.css. */
.casa-hero__title-gradient--custom {
  background: linear-gradient(
    90deg,
    var(--hero-accent-word-1, var(--hero-color-1)),
    var(--hero-accent-word-2, var(--hero-color-2)),
    var(--hero-accent-word-2, var(--hero-color-3))
  );
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ── Subtitle ── */
.casa-hero__subtitle {
  font-size: clamp(16px, 1.5vw, 22px);
  color: var(--hero-subtitle-color, rgba(255, 255, 255, 0.65));
  line-height: 1.7;
  margin: 0 0 32px 0;
  max-width: 550px;
}

/* ── Features List ── */
.casa-hero__features {
  list-style: none;
  padding: 0;
  margin: 0 0 32px 0;
  display: flex;
  flex-wrap: wrap;
  gap: 16px 32px;
}

.casa-hero__features li {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--hero-stats-color, rgba(255, 255, 255, 0.8));
  font-size: 14px;
}

.casa-hero__features svg {
  color: var(--hero-color-1);
  stroke: currentColor;
}

/* ── Price ── */
.casa-hero__price-wrapper {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-bottom: 32px;
}

.casa-hero__compare-price {
  font-size: 24px;
  color: rgba(255, 255, 255, 0.4);
  text-decoration: line-through;
}

.casa-hero__price {
  font-size: 48px;
  font-weight: 600;
  color: #fff;
}

.casa-hero__price-suffix {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.5);
}

/* ── Buttons ── */
.casa-hero__buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 32px;
  /* Follow the section's text_alignment setting: 'left' → flex-start,
     'center' → center, 'right' → flex-end. Without this, buttons stayed
     left-aligned even when text was centered. */
  justify-content: var(--hero-flex-align, flex-start);
}

.casa-hero__btn {
  /* Hero-specific overrides on top of the brand .btn baseline (assets/casa-buttons.css).
     KEEPING: gap (brand uses 8px, hero wants a touch more breathing room around the icon),
              min-width (visual pairing — both CTAs the same width). */
  gap: 10px;
  /* Uniform minimum width so buttons stay visually paired at every viewport.
     220px wasn't enough — "Shop Infinity Mirrors" + chevron icon naturally
     sizes to ~270-280px, so the shorter "See bestsellers" still looked
     visibly narrower. 280px covers both labels with their icons. */
  /* min() so the 280px pairing holds on real screens but collapses to the
     container on very narrow ones. A bare 280px is wider than a folded
     Galaxy Fold's 269px content box, which pushed both CTAs ~6px past the
     right edge — .casa-hero's overflow: hidden masked the page h-scroll, so
     it read as clean while still rendering clipped. */
  min-width: min(280px, 100%);
}

.casa-hero__btn svg {
  width: 18px;
  height: 18px;
}

.casa-hero__btn--primary {
  /* background + color now inherited from .btn-featured (var(--grad-primary), white).
     Hero adds an always-on resting glow that the brand class only applies on :hover. */
  box-shadow: 0 4px 20px rgba(176, 195, 250, 0.3);
}

.casa-hero__btn--primary:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 40px rgba(176, 195, 250, 0.5);
}

.casa-hero__btn--primary[data-pulse] {
  animation: btn-pulse 2s ease-in-out infinite;
}

@keyframes btn-pulse {
  0%, 100% { box-shadow: 0 4px 20px rgba(176, 195, 250, 0.3); }
  50% { box-shadow: 0 8px 40px rgba(176, 195, 250, 0.6); }
}

.casa-hero__btn--secondary {
  /* Hero secondary overrides .btn-secondary-on-dark with a frosted-glass treatment
     (vs. the brand book's plain outline). Color comes from .btn-secondary-on-dark
     (var(--t-on-dark) = #fff), so we don't restate it here. */
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  will-change: backdrop-filter; /* GPU layer: avoid per-frame re-blur over the animated hero (perf, 2026-05-17 flicker-fix pattern) */
}

.casa-hero__btn--secondary:hover {
  background: rgba(255, 255, 255, 0.15);
  border-color: rgba(255, 255, 255, 0.25);
}

.casa-hero__btn--tertiary {
  /* .btn-tertiary defaults to color: var(--bg-dark) — invisible on dark hero surface.
     Override to the hero accent color (white-ish via --hero-color-1 or theme override). */
  background: transparent;
  color: var(--hero-color-1);
  padding: 12px 0;
}

.casa-hero__btn--tertiary:hover {
  gap: 14px;
}

/* Button sizes */
.casa-hero__btn--small { padding: 10px 20px; font-size: 13px; }
.casa-hero__btn--medium { padding: 16px 32px; font-size: 15px; }
.casa-hero__btn--large { padding: 20px 40px; font-size: 17px; }

/* ── Social Proof ── */
.casa-hero__social-proof {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 24px;
}

.casa-hero__rating {
  display: flex;
  align-items: center;
  gap: 12px;
}

.casa-hero__stars {
  display: flex;
  gap: 2px;
}

.casa-hero__stars svg {
  width: 16px;
  height: 16px;
  fill: #fbbf24;
  stroke: none;
}

.casa-hero__rating-text {
  color: rgba(255, 255, 255, 0.9);
  font-size: 14px;
  font-weight: 500;
}

.casa-hero__rating-count {
  color: rgba(255, 255, 255, 0.5);
}

.casa-hero__proof-text {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.6);
  margin: 0;
}

.casa-hero__avatars {
  display: flex;
  align-items: center;
  gap: 12px;
}

.casa-hero__avatar-stack {
  display: flex;
}

.casa-hero__avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--hero-color-1), var(--hero-color-2));
  border: 2px solid var(--casa-ink);
  margin-left: -10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 600;
  color: #fff;
}

.casa-hero__avatar:first-child {
  margin-left: 0;
}

.casa-hero__avatars > span {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.6);
}

/* ── Trust Row ── */
.casa-hero__trust-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 24px;
  padding-top: 24px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

/* Default (≥901px = desktop / large tablet): show the trust-row variant
   that's nested inside .casa-hero__text (column-1 of the split layout)
   and hide the mobile-only duplicate that lives as a sibling of
   .casa-hero__visual. The reverse rule lives inside the @media
   (max-width: 900px) block below. */
.casa-hero__trust-row--mobile-only { display: none; }
.casa-hero__trust-row--desktop-only { display: flex; }

.casa-hero__trust-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: rgba(255, 255, 255, 0.7);
}

.casa-hero__trust-item svg {
  width: 18px;
  height: 18px;
  stroke: var(--hero-color-1);
}

/* ══════════════════════════════════════════════════════════════════════════
   VISUAL COLUMN
   ══════════════════════════════════════════════════════════════════════════ */

.casa-hero__visual {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: hero-scaleIn 1s ease-out 0.3s both;
}

@keyframes hero-scaleIn {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.casa-hero__visual-wrapper {
  position: relative;
  width: 100%;
  max-width: 550px;
  aspect-ratio: 1;
  animation: hero-float 6s ease-in-out infinite;
}

/* ── Glow Frame ── */
.casa-hero__glow-frame {
  position: absolute;
  inset: -30px;
  pointer-events: none;
}

.casa-hero__glow-frame {
  inset: calc(var(--hero-glow-size, 30px) * -1);
}
.casa-hero__glow-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  /* Static gradient angle + rotate the ELEMENT, instead of animating the angle
     through @property. This ring is what painted an opaque square behind the
     transparent mirror cutout in shipping Safari (confirmed 8adf8a0e). It is
     currently switched off via show_glow_frame, so this rewrite is defensive:
     if the merchant ever re-enables it, it no longer ships the exact recipe
     that failed. The ring is an empty div, so rotating the element is visually
     identical to rotating the gradient. Centring is by inset: 0, never by
     transform, so the reduced-motion block's transform: none can't shift it.
     NOTE: unverified in real Safari — the blur + border-radius pair is still
     present, and only the @property animation was removed. Re-enable behind a
     real-Safari check, not on the strength of this comment. */
  background: conic-gradient(
    from 0deg,
    var(--hero-color-1),
    var(--hero-color-2),
    var(--hero-color-3),
    var(--hero-color-1)
  );
  filter: blur(calc(20px + var(--hero-glow-size, 30px)));
  opacity: var(--hero-glow-intensity, 0.5);
  /* perf-justified: compositor-only transform, viewport-gated via
     data-casa-anim-gate on the section root */
  animation: casa-hero-ring-spin 8s linear infinite;
}

@keyframes casa-hero-ring-spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

.casa-hero__glow-ring:nth-child(2) {
  filter: blur(80px);
  opacity: 0.3;
  animation-direction: reverse;
  animation-duration: 12s;
}

/* @property --hero-angle and @keyframes glow-rotate lived here. Both are gone:
   animating a conic gradient's angle through a registered custom property is
   the recipe that made shipping Safari paint an opaque square behind the
   transparent mirror cutout, and every consumer has been migrated off it (the
   glow ring rotates the element; the fallback-mirror rings are static). Noted
   here so the pattern isn't reintroduced by someone finding the keyframe name
   in git history and assuming it was safe. */

/* ── Floor Glow ──
   Soft light pool beneath the floating mirror. Deliberately a radial-gradient
   with NO filter: blur() — the softness comes from the colour stops. The old
   .casa-hero__glow-frame paired blur() + border-radius:50% + an
   @property-animated conic gradient, and shipping Safari rasterized that as an
   opaque light square behind the transparent mirror cutout (350f59e8 chased the
   wrong element; 8adf8a0e confirmed the glow frame was the source). Nothing
   here builds a filter layer, so that failure mode cannot recur.
   The animation touches transform + opacity only — PERF checkpoint 9. */
.casa-hero__floor-glow {
  position: absolute;
  /* Centred by left+width arithmetic (20% + 60% + 20%), NOT by
     translateX(-50%). The reduced-motion / <=749px block below sets
     transform: none !important on this class, so any centring that relies on
     transform is silently stripped on every phone -- which pushed this element
     100px right and 17px past a 364px viewport. Keep centring transform-free;
     transform here is reserved for the scale animation, which is safe to kill. */
  left: 20%;
  /* Negative so the pool clears the mirror's base. The image is a circle
     inscribed in a square box, so anything sitting inside the box is occluded
     by the opaque disc: at 9% up, the circle is still 326px wide against this
     element's 306px and hides the gradient's bright core entirely. Pulling the
     ellipse's centre just below the box bottom puts roughly half the pool in
     clear space, which is what reads as light cast downward. There is ~100px
     of hero below the visual column, so this cannot collide with content. */
  bottom: -7%;
  width: 60%;
  aspect-ratio: 5 / 1;
  /* Fallback first for engines without color-mix(); the token version wins
     wherever it is supported so the merchant's hero colour drives the pool. */
  background: radial-gradient(
    ellipse at center,
    rgba(255, 255, 255, 0.30) 0%,
    rgba(255, 255, 255, 0.10) 40%,
    rgba(255, 255, 255, 0) 72%
  );
  background: radial-gradient(
    ellipse at center,
    color-mix(in srgb, var(--hero-color-1) 30%, transparent) 0%,
    color-mix(in srgb, var(--hero-color-1) 10%, transparent) 40%,
    transparent 72%
  );
  opacity: var(--hero-floor-glow-opacity, 0.55);
  pointer-events: none;
  z-index: 1;
  /* perf-justified: compositor-only transform + opacity, viewport-gated via
     data-casa-anim-gate on the section root */
  animation: hero-floor-glow 6s ease-in-out infinite;
}

/* Synced to hero-float's 6s cycle: the mirror peaks at 50%, so the pool
   tightens and dims at 50% — reads as the object lifting off the surface. */
@keyframes hero-floor-glow {
  0%, 100% {
    transform: scale(1);
    opacity: var(--hero-floor-glow-opacity, 0.55);
  }
  50% {
    transform: scale(0.9);
    opacity: calc(var(--hero-floor-glow-opacity, 0.55) * 0.7);
  }
}

/* ── Visual Media ── */
.casa-hero__visual-media {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 24px;
  overflow: hidden;
  z-index: 2;
}

/* Image variant (e.g. the transparent circular infinity-mirror WebP): drop
   the rounded-rect clip. A transparent cutout needs no clip, and on the
   animated hero shipping Safari paints an OPAQUE backing box behind an
   overflow:hidden + border-radius element once the wrapper's float
   animation promotes it to a compositing layer — that surfaced as a dark
   SQUARE behind the transparent mirror. Chromium + Playwright-WebKit never
   render it (GPU-compositing-dependent, real-Safari only). Removing the
   clip deletes the only box Safari can paint the square on; verified
   render-identical in WebKit/Chromium. The --video variant keeps its
   rounding (rectangular media that genuinely needs the clip). */
.casa-hero__visual-media:not(.casa-hero__visual-media--video) {
  border-radius: 0;
  overflow: visible;
}

.casa-hero__visual-media img,
.casa-hero__visual-media video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Visual-card lazy video: poster image sits behind; the video stays HIDDEN
   until it is actually playing (same Low Power Mode no-flash contract as the
   background video above). .casa-hero__visual-poster shows until then. */
.casa-hero__visual-media--video {
  position: relative;
}
.casa-hero__visual-media--video .casa-hero__visual-poster,
.casa-hero__visual-media--video video {
  position: absolute;
  inset: 0;
}
.casa-hero__visual-media--video video {
  z-index: 1;
  visibility: hidden;
}
.casa-hero__visual-media--video video.casa-video-visible {
  visibility: visible;
}

/* Product image inherits float animation from wrapper */
.casa-hero__product-image {
  /* Animation moved to .casa-hero__visual-wrapper to prevent clipping */
}

@keyframes hero-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15px); }
}

/* ── Infinity Mirror (fallback) ── */
.casa-hero__mirror {
  position: relative;
  width: 100%;
  height: 100%;
  animation: hero-float 8s ease-in-out infinite;
  z-index: 2;
}

.octagon { clip-path: polygon(30% 0%, 70% 0%, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0% 70%, 0% 30%); }
.hexagon { clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%); }
.circle { clip-path: circle(50%); }

.casa-hero__mirror-frame {
  width: 100%;
  height: 100%;
  background: linear-gradient(145deg, #1a1a1a 0%, #2a2a2a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 50px 100px -20px rgba(0, 0, 0, 0.5);
}

.casa-hero__mirror-glow {
  width: 94%;
  height: 94%;
  /* Static angle, no animation. This ring carries concentric CHILD elements
     whose shape follows the mirror_shape setting (octagon, hexagon, …), so the
     glow ring's trick of rotating the element is not available here — it would
     visibly spin the nested polygons. Dropping the rotation is the safe move:
     the @property-animated conic gradient is the Safari square recipe, and this
     is the no-image fallback that renders only when no hero image is set. A
     still iridescent ring reads fine; a square behind the mirror does not. */
  background: conic-gradient(
    from 0deg,
    var(--hero-color-1),
    var(--hero-color-2),
    var(--hero-color-3),
    var(--hero-color-1)
  );
  display: flex;
  align-items: center;
  justify-content: center;
}

.casa-hero__mirror-inner {
  width: 92%;
  height: 92%;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
}

.casa-hero__mirror-depth {
  width: 85%;
  height: 85%;
  /* Static angle, no animation — same reasoning as .casa-hero__mirror-glow
     above: nested shape-following children rule out rotating the element, and
     the @property-animated gradient is the Safari square recipe. */
  background: conic-gradient(
    from 0deg,
    rgba(176, 195, 250, 0.5),
    rgba(94, 10, 2, 0.5),
    rgba(242, 255, 160, 0.5),
    rgba(176, 195, 250, 0.5)
  );
  display: flex;
  align-items: center;
  justify-content: center;
}

.casa-hero__mirror-center {
  width: 80%;
  height: 80%;
  background: rgba(0, 0, 0, 0.9);
}

/* ── Floating Badges ── */
/* Default (desktop): wrapper is structurally invisible so each badge's
   absolute positioning resolves against .casa-hero__visual-inner just
   like before the wrapper was added. The wrapper only "exists" at the
   mobile breakpoint where it becomes a flex-wrap row. */
.casa-hero__float-badges {
  display: contents;
}

.casa-hero__float-badge {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  background: rgba(10, 10, 15, 0.8);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  will-change: transform, backdrop-filter; /* animates (badge-float) AND frosted — hint both so the blur isn't re-composited every frame (perf, 2026-05-17 flicker-fix pattern) */
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  font-size: 12px;
  font-weight: 600;
  color: #fff;
  z-index: 10;
  animation: badge-float 4s ease-in-out infinite;
}

.casa-hero__float-badge svg {
  width: 16px;
  height: 16px;
  stroke: var(--hero-color-1);
}

.casa-hero__float-badge--1 {
  top: 10%;
  right: -10%;
}

.casa-hero__float-badge--2 {
  bottom: 25%;
  left: -15%;
  animation-delay: -1s;
}

.casa-hero__float-badge--3 {
  bottom: 5%;
  right: 5%;
  animation-delay: -2s;
}

@keyframes badge-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

/* ══════════════════════════════════════════════════════════════════════════
   SCROLL INDICATOR
   ══════════════════════════════════════════════════════════════════════════ */

.casa-hero__scroll-indicator {
  position: absolute;
  bottom: 40px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  z-index: 10;
  animation: scroll-fade 2s ease-in-out infinite;
}

.casa-hero__scroll-mouse {
  width: 24px;
  height: 40px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-radius: 12px;
  display: flex;
  justify-content: center;
  padding-top: 8px;
}

.casa-hero__scroll-wheel {
  width: 4px;
  height: 8px;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 2px;
  animation: scroll-wheel 1.5s ease-in-out infinite;
}

.casa-hero__scroll-indicator span {
  font-size: 11px;
  color: rgba(255, 255, 255, 0.4);
  text-transform: uppercase;
  letter-spacing: 1px;
}

@keyframes scroll-fade {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

@keyframes scroll-wheel {
  0% { transform: translateY(0); opacity: 1; }
  100% { transform: translateY(12px); opacity: 0; }
}

/* ══════════════════════════════════════════════════════════════════════════
   REDUCED MOTION + MOBILE — kill entrance & ambient animations
   ══════════════════════════════════════════════════════════════════════════ */

@media (prefers-reduced-motion: reduce),
       (max-width: 749px) {
  .casa-hero__particle,
  .casa-hero__aurora-layer,
  .casa-hero__orb,
  .casa-hero__gradient-flow,
  .casa-hero__star,
  .casa-hero__wave,
  .casa-hero__promo,
  .casa-hero__glow-ring,
  .casa-hero__floor-glow,
  .casa-hero__product-image,
  .casa-hero__mirror,
  .casa-hero__mirror-glow,
  .casa-hero__mirror-depth,
  .casa-hero__float-badge,
  .casa-hero__scroll-indicator,
  .casa-hero__scroll-wheel,
  .casa-hero__text,
  .casa-hero__visual,
  .casa-hero__visual-wrapper,
  .casa-hero__btn--primary[data-pulse] {
    animation: none !important;
    transform: none !important;
  }
  /* transform: none above kills STATE transforms, not just motion. The
     scroll indicator's horizontal centring IS a transform — left: 50% +
     translateX(-50%) — so without this re-assert it parks its left edge
     at the viewport midline (shifted right by half its width) for every
     reduce-motion visitor AND on every phone ≤749px (this block doubles
     as the mobile animation kill). Latent while show_scroll_indicator
     is off on the homepage; fires the moment the merchant re-enables it.
     Same class as the collection filter-drawer bug (b1d076b1). The
     scroll-fade / scroll-wheel ambient animations stay killed — only
     the static centring comes back. */
  .casa-hero .casa-hero__scroll-indicator {
    transform: translateX(-50%) !important;
  }
}

/* Hide decorative particle/aurora/star layers entirely on mobile — lighter paint */
@media (max-width: 749px) {
  .casa-hero__animations,
  .casa-hero__particle,
  .casa-hero__star,
  .casa-hero__wave,
  .casa-hero__aurora,
  .casa-hero__aurora-layer {
    display: none !important;
  }
}

/* ══════════════════════════════════════════════════════════════════════════
   RESPONSIVE
   ══════════════════════════════════════════════════════════════════════════ */

@media (max-width: 1200px) {
  .casa-hero__container {
    padding: 0 40px;
  }

  .casa-hero__content {
    gap: 60px;
  }

  .casa-hero__visual-wrapper {
    max-width: 450px;
  }

  .casa-hero__float-badge--1 { right: -5%; }
  .casa-hero__float-badge--2 { left: -5%; }
}

@media (max-width: 900px) {
  .casa-hero {
    height: auto !important;
    min-height: auto !important;
    max-height: none !important;
    overflow-x: hidden;
    padding-top: var(--hero-mobile-padding-top, 80px);
    padding-bottom: var(--hero-mobile-padding-bottom, 60px);
  }

  .casa-hero__promo {
    /* Keep absolute positioning — overlaps the padding-top area */
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: 8px 16px;
    box-sizing: border-box;
  }

  .casa-hero__promo-inner {
    font-size: 11px;
    flex-wrap: wrap;
    gap: 6px;
  }

  .casa-hero__container {
    padding: 0 20px;
    box-sizing: border-box;
  }

  .casa-hero__content {
    display: flex !important;
    flex-direction: column !important;
    gap: 32px;
    text-align: center;
  }

  .casa-hero__text {
    width: 100% !important;
    max-width: 100% !important;
    align-items: center !important;
    text-align: center !important;
    order: 1;
  }

  .casa-hero__visual {
    width: 100% !important;
    display: flex;
    align-items: center;
    justify-content: center;
    order: 2;
    overflow: visible;
  }

  .casa-hero__visual-wrapper {
    /* Tablet / phone visual container. The badges float AROUND the
       mirror (same as desktop), so we need:
         - position: relative (positioning context for absolute badges)
         - room around the mirror for the badge pills to live in
         - the wrapper to NATURALLY size to the mirror (no aspect-ratio
           override) so the mirror image renders at its true 1:1 ratio
           without getting elongated to fill a forced-square box

       Earlier iterations used `aspect-ratio: 1` + a max-width buffer +
       `top: 50%; transform: translateY(-50%)` on the mirror to center
       it. That trick made the wrapper square (350×350) and the mirror
       inside it (250×auto). When the mirror image was even slightly
       portrait-aspect, the height grew past the wrapper's 350px and
       got visually clipped — the merchant saw an elongated/cropped
       mirror.

       New approach: padding INSIDE the wrapper creates the buffer for
       badges to live in, and the wrapper's height grows naturally
       with the mirror. Badges absolute-positioned at top: 0 / right: 0
       etc sit inside the padding ring, OUTSIDE the mirror's edge.

       SYMMETRIC TRIANGLE ARRANGEMENT (per merchant's "evenly spaced
       and not touching the mirror" request):
         TC (Music Reactive)  — top-center, ABOVE mirror's top edge
         BL (16M+ Colors)     — bottom-left, BELOW mirror's bottom
         BR (App Control)     — bottom-right, BELOW mirror's bottom
       All three badges live in empty wrapper space OUTSIDE the
       circle entirely. The mirror is centered with vertical padding
       above (for TC) and below (for BL/BR). Perfect symmetry across
       the vertical axis.

       Padding 30px vertical / 50px horizontal:
         - 30px top  → TC badge fits above mirror with clearance
         - 30px bottom → BL/BR fit below mirror with clearance
         - 50px each side → wrapper wide enough that BL/BR don't
           collide at the bottom (mirror is 250px wide, wrapper
           becomes 350px → BL and BR pills (~110px each) have a
           130px gap between them)

       At ≤900px breakpoint: wrapper 250+100=350 wide × 250+60=310
       tall — fits any tablet portrait viewport (≥768px). */
    max-width: calc(var(--hero-mobile-visual-size, 250px) + 100px);
    width: 100%;
    margin: 0 auto;
    padding: 30px 50px;
    box-sizing: border-box;
    /* Drop any earlier display:flex/aspect-ratio iterations. */
    display: block;
    aspect-ratio: auto;
  }
  /* Mirror media fills the wrapper's content box (the area inside
     padding). At 350px wrapper - 100px horizontal padding = 250px
     content area, which exactly matches mobile_visual_size. */
  .casa-hero__visual-wrapper .casa-hero__visual-media,
  .casa-hero__visual-wrapper .casa-hero__mirror {
    max-width: var(--hero-mobile-visual-size, 250px);
    width: 100%;
    margin: 0 auto;
    /* No vertical-centering hacks — wrapper is content-sized now. */
    position: static;
    top: auto;
    transform: none;
  }

  /* Trust-row breakpoint toggle:
     - .casa-hero__trust-row--desktop-only lives inside .casa-hero__text
       and renders BEFORE the visual on mobile (wrong place per merchant)
     - .casa-hero__trust-row--mobile-only is a sibling of .casa-hero__visual
       and renders AFTER the visual (correct mobile order)
     Show the mobile variant ≤900px, hide the desktop variant.
     CRITICAL: order: 3 — without an explicit order it inherits the
     default order: 0 in the .casa-hero__content flex-column. Since
     .casa-hero__text already has order: 1 and .casa-hero__visual
     order: 2 (set elsewhere), order: 0 lands the trust row ABOVE
     both — exactly the bug the merchant reported in the screenshot
     where the trust row was rendering at the top of the hero. */
  .casa-hero__trust-row--desktop-only { display: none !important; }
  .casa-hero__trust-row--mobile-only {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 16px;
    order: 3;
  }

  .casa-hero--mobile-visual-first .casa-hero__text { order: 2 !important; }
  .casa-hero--mobile-visual-first .casa-hero__visual { order: 1 !important; }
  .casa-hero--mobile-no-visual .casa-hero__visual { display: none !important; }

  .casa-hero__badges { justify-content: center; flex-wrap: wrap; }
  .casa-hero__subtitle { max-width: 100%; }
  .casa-hero__features { justify-content: center; flex-wrap: wrap; }
  .casa-hero__buttons { justify-content: center; flex-wrap: wrap; width: 100%; }
  .casa-hero__social-proof { align-items: center; }
  .casa-hero__trust-row { justify-content: center; flex-wrap: wrap; }

  /* Floating badges on mobile: KEEP the desktop floating-around-the-
     mirror visual language. The merchant explicitly asked for the
     badges to surround the mirror like they do on desktop, NOT to
     stack as a row below.

     Strategy:
       - .casa-hero__float-badges wrapper stays `display: contents`
         (inherited from the base rule) so each badge positions
         absolutely against .casa-hero__visual-wrapper (which is
         position: relative).
       - Badges keep their desktop absolute positioning, just with
         tighter offsets so they stay on-screen on a 414px phone
         with a 250px mirror.
       - Pill size shrunk for mobile (padding 5/9, font 10).
       - Animation kept (subtle floating effect — same as desktop).
  */
  .casa-hero__float-badge {
    /* Override the prior position:static iteration by REASSERTING
       absolute positioning + the smaller mobile pill size. */
    position: absolute;
    display: flex;
    padding: 5px 9px;
    font-size: 10px;
    gap: 5px;
    border-radius: 9px;
    /* Tighter against the mirror so the badges read as decorative
       pills attached to it rather than floating off-screen. */
    white-space: nowrap;
  }
  .casa-hero__float-badge svg {
    width: 12px;
    height: 12px;
  }

  /* Mobile badge positions — SYMMETRIC TRIANGLE (TC + BL + BR).

     Apex at top (Music Reactive centered above mirror), base at
     bottom (16M+ Colors + App Control flanking the mirror's bottom
     symmetrically across the vertical axis). All three badges live
     in empty WRAPPER space OUTSIDE the mirror's circle — the
     wrapper has 30px vertical padding above and below the mirror
     (room for top + bottom badges) and 50px horizontal padding
     (room for BL/BR to live in the bottom corners).

     None of the three badges overlap the mirror because:
       - TC sits in the 30px space ABOVE the mirror's top edge
       - BL and BR sit in the 30px space BELOW the mirror's bottom
       - All three positions are in geometric whitespace, not on
         the circle's curve at all

     CRITICAL: Reset ALL four position properties on each badge
     before applying the new ones. Desktop rules set:
       --1: top + right     (rest are auto)
       --2: bottom + left   (rest are auto)
       --3: bottom + right  (rest are auto)
     If un-cleared, desktop values leak through and the badge
     stretches between its set top + leaked bottom. */
  .casa-hero__float-badge--1 {
    /* Music Reactive — TOP CENTER, above the mirror.

       Centering via the "absolute + symmetric left/right 0 +
       margin: 0 auto + width: max-content" pattern. This is more
       robust than left: 50% + translateX(-50%) because:
         - No transform math = no rounding errors at fractional px
         - No risk of `transform: none` from elsewhere overriding
         - Works identically across all rendering engines
       The badge shrinks to its content (max-content) and the
       margin-auto then centers that block within the bounded
       inset area (left:0 to right:0 = full wrapper width). */
    top: 0;
    left: 0;
    right: 0;
    bottom: auto;
    margin: 0 auto;
    width: max-content;
    transform: none;
  }
  .casa-hero__float-badge--2 {
    /* 16M+ Colors — BOTTOM LEFT, pulled inward 6% from the
       wrapper's left edge so the bottom of the triangle is
       tighter than the absolute corners. Forms a clearer
       apex-up triangle shape with --1 (TC) and --3 (BR). */
    bottom: 0;
    left: 6%;
    top: auto;
    right: auto;
    transform: none;
  }
  .casa-hero__float-badge--3 {
    /* App Control — BOTTOM RIGHT, mirrors --2 across the
       vertical axis (same 6% offset, just from the right edge).
       Triangle base = wrapper_width - 12% ≈ 88% of wrapper. */
    bottom: 0;
    right: 6%;
    top: auto;
    left: auto;
    transform: none;
  }

  .casa-hero__waves { display: none; }
}

@media (max-width: 600px) {
  /* COMPACT MOBILE: target is fitting the entire hero (badge → title
     → gradient → subtitle → buttons → mirror with floating badges →
     trust row) within a single iPhone viewport (~750px visible) so
     no scroll is needed. Achieved by tightening padding, gap, and
     subordinate element sizes. */
  .casa-hero {
    padding-top: 28px !important;
    padding-bottom: 20px !important;
  }

  .casa-hero__container { padding: 0 16px; }
  .casa-hero__content { gap: 14px !important; }

  .casa-hero__title {
    /* Mobile cap. The Horizon H1 token can be very large (display
       sizing for desktop), which makes "Live in your own" wrap to
       2-3 lines on phones. Clamp keeps the line on one row at every
       phone width down to 320px while staying display-sized.
       History:
         clamp(22px, 7vw, 42px)  — original, felt timid
         clamp(28px, 9vw, 56px)  — too dominant under the new 72-120
                                   "Light" accent on phones (37px at
                                   iPhone 14 vs ~76px Light = only
                                   2× ratio, weak hierarchy)
         clamp(22px, 6.5vw, 42px) — current, ~27px at iPhone 14 vs
                                   76px Light = ~2.8× ratio, clean
       Below 600px the title sits visually quieter so the gradient
       accent below carries the full display weight. */
    font-size: clamp(22px, 6.5vw, 42px);
    word-break: normal;
  }
  .casa-hero__title-line {
    /* Belt-and-suspenders: never let "Live in your own" wrap on
       mobile. With the clamp above the line is short enough to fit
       even on the narrowest phones; nowrap is insurance. */
    white-space: nowrap;
  }
  .casa-hero__title-gradient {
    /* Accent is the hero gesture on mobile — still ~2× the title
       size for hierarchy. Compacted from 56-110 → 44-84 so the
       gradient + the rest of the hero fit in one phone viewport
       without scrolling (the merchant explicitly asked for this).

       padding-bottom restored to 0.18em: with line-height 0.92 the
       line box is tight, and the italic 'g' in "Light" has a
       descender that extends ~25% below the baseline. The earlier
       padding-bottom: 0 was clipping the descender (the bottom of
       the 'g' was getting cut off in the merchant's screenshot).
       0.18em leaves room for the descender while still being
       tighter than the desktop 0.12em padding which was tuned
       against a 120px font + line-height 1 (more room either way). */
    font-size: clamp(44px, 14vw, 84px);
    line-height: 0.92;
    margin-top: 0;
    padding-bottom: 0.18em;
  }

  .casa-hero__subtitle {
    /* Tightened from clamp(15,4vw,17) to 14-15 for the one-frame-fit
       goal — the subtitle is supporting copy under the gradient, not
       a hero-weight element. Margin trimmed too. */
    font-size: clamp(14px, 3.6vw, 15px) !important;
    margin: 0 !important;
  }

  .casa-hero__btn,
  .casa-hero__btn--small,
  .casa-hero__btn--medium,
  .casa-hero__btn--large {
    /* Reduced vertical padding 14→11 so the two stacked buttons take
       ~88px instead of ~112px — saves 24px of vertical space for the
       one-frame-fit goal. Font-size stays 14 (touch-target friendly). */
    width: 100%;
    justify-content: center;
    padding: 11px 18px;
    font-size: 14px;
  }

  /* Tighter spacing between the buttons themselves (parent flex gap). */
  .casa-hero__buttons {
    gap: 8px !important;
  }

  .casa-hero__features {
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .casa-hero__visual-wrapper {
    /* Phone viewport (≤600px): tighter than the ≤900px block. The
       wrapper content-sizes to the mirror image so it isn't clipped,
       and the horizontal padding leaves room for the 3 floating
       badges (16M+ Colors / Music Reactive / App Control) to sit
       outside the mirror's edge.

       Mirror size overridden to 175px (was 200) to keep the whole
       hero (badge → title → gradient → subtitle → buttons → mirror+
       badges → trust row) inside a single iPhone viewport with no
       scroll. Horizontal padding bumped 45→55 to match the BL/BR
       breathing room (the BL badge needs the same space the BR
       badge gets so they read as a balanced pair). */
    --hero-mobile-visual-size: 175px;
    max-width: calc(var(--hero-mobile-visual-size) + 100px);
    width: 100%;
    padding: 30px 50px;
    box-sizing: border-box;
    aspect-ratio: auto;
  }
  .casa-hero__visual-wrapper .casa-hero__visual-media,
  .casa-hero__visual-wrapper .casa-hero__mirror {
    max-width: var(--hero-mobile-visual-size, 175px);
  }
  /* Tighter trust-row spacing on small phones so it doesn't push the
     viewport too far. */
  .casa-hero__trust-row--mobile-only {
    margin-top: 16px;
    gap: 16px;
    padding-top: 16px;
  }
}
