{%- comment -%}
  Seoul Glow Lab Hero Section - Premium Edition
  Full-bleed hero with video/image support, multiple animation presets,
  customizable colors, badges, promos, and conversion-focused design
{%- endcomment -%}

{%- liquid
  assign hero_height = section.settings.hero_height | default: '90vh'
  assign layout = section.settings.layout | default: 'split'
  assign animation_style = section.settings.animation_style | default: 'particles'
  assign color_theme = section.settings.color_theme | default: 'purple-glow'

  # Padding settings
  assign padding_top = section.settings.padding_top | default: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0
  assign mobile_padding_top = section.settings.mobile_padding_top | default: 100
  assign mobile_padding_bottom = section.settings.mobile_padding_bottom | default: 80

  # Mobile settings
  assign mobile_height = section.settings.mobile_height | default: 'auto'
  assign mobile_order = section.settings.mobile_order | default: 'text-first'
  assign mobile_hide_visual = section.settings.mobile_hide_visual
  assign mobile_visual_size = section.settings.mobile_visual_size | default: 280

  # Color theme presets
  case color_theme
    when 'purple-glow'
      assign color_1 = section.settings.custom_color_1 | default: '#B0C3FA'
      assign color_2 = section.settings.custom_color_2 | default: '#5E0A02'
      assign color_3 = section.settings.custom_color_3 | default: '#F2FFA0'
    when 'sunset-gold'
      assign color_1 = '#f59e0b'
      assign color_2 = '#ef4444'
      assign color_3 = '#fbbf24'
    when 'ocean-teal'
      assign color_1 = '#F2FFA0'
      assign color_2 = '#F2FFA0'
      assign color_3 = '#F2FFA0'
    when 'midnight-rose'
      assign color_1 = '#5E0A02'
      assign color_2 = '#be185d'
      assign color_3 = '#5E0A02'
    when 'emerald-glow'
      assign color_1 = '#10b981'
      assign color_2 = '#059669'
      assign color_3 = '#34d399'
    when 'custom'
      assign color_1 = section.settings.custom_color_1 | default: '#B0C3FA'
      assign color_2 = section.settings.custom_color_2 | default: '#5E0A02'
      assign color_3 = section.settings.custom_color_3 | default: '#F2FFA0'
  endcase

  assign overlay_opacity = section.settings.overlay_opacity | default: 70
  assign text_alignment = section.settings.text_alignment | default: 'left'

  # Typography color overrides
  assign title_color = section.settings.title_color
  assign accent_word_color_1 = section.settings.accent_word_color_1
  assign accent_word_color_2 = section.settings.accent_word_color_2
  assign subtitle_color = section.settings.subtitle_color
  assign badge_bg_color = section.settings.badge_bg_color
  assign badge_text_color = section.settings.badge_text_color
  assign stats_color = section.settings.stats_color
  assign promo_bg_color = section.settings.promo_bg_color
  assign promo_text_color = section.settings.promo_text_color
  assign hero_bg_color = section.settings.hero_bg_color
-%}

<section
  class="casa-hero casa-hero--{{ layout }} casa-hero--{{ animation_style }} casa-hero--mobile-{{ mobile_order }}{% if mobile_hide_visual %} casa-hero--mobile-no-visual{% endif %}"
  id="casa-hero-{{ section.id }}"
  data-casa-anim-gate
  style="
    --hero-height: {{ hero_height }};
    --hero-color-1: {{ color_1 }};
    --hero-color-2: {{ color_2 }};
    --hero-color-3: {{ color_3 }};
    --hero-overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }};
    --hero-text-align: {{ text_alignment }};
    --hero-flex-align: {% if text_alignment == "center" %}center{% elsif text_alignment == "right" %}flex-end{% else %}flex-start{% endif %};
    --hero-gradient-mstart: {% if text_alignment == "center" or text_alignment == "right" %}auto{% else %}0{% endif %};
    --hero-gradient-mend:   {% if text_alignment == "center" %}auto{% else %}0{% endif %};
    --hero-padding-top: {{ padding_top }}px;
    --hero-padding-bottom: {{ padding_bottom }}px;
    --hero-mobile-height: {{ mobile_height }};
    --hero-mobile-padding-top: {{ mobile_padding_top }}px;
    --hero-mobile-padding-bottom: {{ mobile_padding_bottom }}px;
    --hero-mobile-visual-size: {{ mobile_visual_size }}px;
    {%- comment -%}
      Heading scale routing: merchant picks an H1-H6 level via the
      "Title heading scale" / "Accent heading scale" selects. We
      translate the choice into the matching --font-hN--* tokens
      (Horizon emits these from Theme Settings → Typography).
    {%- endcomment -%}
    {%- assign _title_h = section.settings.title_heading_level | default: 'h1' -%}
    --hero-title-fs:   var(--font-{{ _title_h }}--size);
    --hero-title-fw:   var(--font-{{ _title_h }}--weight);
    --hero-title-lh:   var(--font-{{ _title_h }}--line-height);
    --hero-title-ls:   var(--font-{{ _title_h }}--letter-spacing);
    --hero-title-case: var(--font-{{ _title_h }}--case);
    {%- assign _accent_h = section.settings.accent_heading_level | default: 'inherit' -%}
    {%- if _accent_h != 'inherit' -%}
    --hero-accent-fs:   var(--font-{{ _accent_h }}--size);
    --hero-accent-fw:   var(--font-{{ _accent_h }}--weight);
    --hero-accent-lh:   var(--font-{{ _accent_h }}--line-height);
    --hero-accent-ls:   var(--font-{{ _accent_h }}--letter-spacing);
    --hero-accent-case: var(--font-{{ _accent_h }}--case);
    {%- endif -%}
    {%- if title_color != blank %}--hero-title-color: {{ title_color }};{% endif -%}
    {%- if accent_word_color_1 != blank %}--hero-accent-word-1: {{ accent_word_color_1 }};{% endif -%}
    {%- if accent_word_color_2 != blank %}--hero-accent-word-2: {{ accent_word_color_2 }};{% endif -%}
    {%- if subtitle_color != blank %}--hero-subtitle-color: {{ subtitle_color }};{% endif -%}
    {%- if badge_bg_color != blank %}--hero-badge-bg: {{ badge_bg_color }};{% endif -%}
    {%- if badge_text_color != blank %}--hero-badge-text: {{ badge_text_color }};{% endif -%}
    {%- if stats_color != blank %}--hero-stats-color: {{ stats_color }};{% endif -%}
    {%- if promo_bg_color != blank %}--hero-promo-bg: {{ promo_bg_color }};{% endif -%}
    {%- if promo_text_color != blank %}--hero-promo-text: {{ promo_text_color }};{% endif -%}
    {%- if hero_bg_color != blank %}--hero-bg-color: {{ hero_bg_color }};{% endif -%}
    --hero-glow-intensity: {{ section.settings.glow_intensity | default: 50 | divided_by: 100.0 }};
    --hero-glow-size: {{ section.settings.glow_size | default: 30 }}px;
    --hero-floor-glow-opacity: {{ section.settings.floor_glow_intensity | default: 55 | divided_by: 100.0 }};
    --hero-glass-opacity: {{ section.settings.glass_opacity | default: 30 | divided_by: 100.0 }};
    --hero-glass-blur: {{ section.settings.glass_blur | default: 16 }}px;
    --hero-glass-radius: {{ section.settings.glass_radius | default: 16 }}px;
    --hero-glass-padding: {{ section.settings.glass_padding | default: 28 }}px;
    --hero-inline-img-width: {{ section.settings.inline_image_max_width | default: 80 }}%;
    --hero-inline-img-radius: {{ section.settings.inline_image_radius | default: 12 }}px;
  "
>
  {%- comment -%} Glassmorphic content background — inline style so Liquid conditionals work {%- endcomment -%}
  <style>
    {%- if section.settings.glass_bg_desktop -%}
    @media (min-width: 750px) {
      #casa-hero-{{ section.id }} .casa-hero__text {
        background: rgba(0, 0, 0, var(--hero-glass-opacity, 0.3));
        backdrop-filter: blur(var(--hero-glass-blur, 16px));
        -webkit-backdrop-filter: blur(var(--hero-glass-blur, 16px));
        will-change: backdrop-filter; /* GPU layer: avoid per-frame re-blur over the animated hero (perf, 2026-05-17 flicker-fix pattern) */
        border-radius: var(--hero-glass-radius, 16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: var(--hero-glass-padding, 28px);
        {%- if section.settings.glass_width == 'fit' %}
        width: fit-content;
        max-width: 100%;
        {%- else %}
        width: 100%;
        {%- endif %}
      }
    }
    {%- endif -%}
    {%- if section.settings.glass_bg_mobile -%}
    @media (max-width: 749px) {
      #casa-hero-{{ section.id }} .casa-hero__text {
        background: rgba(0, 0, 0, var(--hero-glass-opacity, 0.3));
        border-radius: var(--hero-glass-radius, 16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: var(--hero-glass-padding, 28px);
        {%- if section.settings.glass_width == 'fit' %}
        width: fit-content;
        max-width: calc(100vw - 32px);
        {%- else %}
        width: 100%;
        {%- endif %}
      }
    }
    {%- endif -%}
  </style>

  {%- comment -%} ═══ Background Media — image loads first, video fades in when ready ═══ {%- endcomment -%}
  <div class="casa-hero__bg">
    {%- if section.settings.background_image != blank -%}
      {%- comment -%}
        Force WebP for the hero background regardless of merchant upload
        format. PNG photographic content is ~5-10x larger than WebP at
        equivalent quality; this conversion runs at the CDN edge so the
        merchant doesn't need to re-upload to fix legacy PNG hero assets.
        Shopify image_url filter accepts `format:` since 2021.
      {%- endcomment -%}
      <img
        class="casa-hero__bg-image"
        src="{{ section.settings.background_image | image_url: width: 1600, format: 'webp' }}"
        srcset="
          {{ section.settings.background_image | image_url: width: 640, format: 'webp' }} 640w,
          {{ section.settings.background_image | image_url: width: 1200, format: 'webp' }} 1200w,
          {{ section.settings.background_image | image_url: width: 1600, format: 'webp' }} 1600w,
          {{ section.settings.background_image | image_url: width: 2560, format: 'webp' }} 2560w
        "
        sizes="100vw"
        width="{{ section.settings.background_image.width | default: 1600 }}"
        height="{{ section.settings.background_image.height | default: 900 }}"
        alt="{{ section.settings.background_image.alt | default: 'Hero background' | escape }}"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      >
    {%- endif -%}
    {%- liquid
      assign bg_video_url = ''
      assign bg_video_small_url = ''
      assign bg_video_hls_url = ''
      if section.settings.background_video_file != blank
        assign bg_video_url = section.settings.background_video_file.sources[1].url | default: section.settings.background_video_file.sources[0].url
        # Phone-rendition pick. The Liquid video drop can expose FEWER renditions
        # than exist on the CDN: this hero's drop shows only m3u8/1080 + mp4/1080
        # while the Admin API lists 480/720/1080 MP4s (verified 2026-08-25). So:
        # smallest visible MP4 → data-src-small (engages when the drop has a real
        # ladder, e.g. after a re-upload), and the HLS manifest → data-src-hls so
        # native-HLS phones (iOS) stream adaptively instead of the 4.3MB 1080p —
        # that file was the homepage's entire mobile-lab LCP tail.
        assign bg_small_h = 0
        for bg_src in section.settings.background_video_file.sources
          if bg_src.format == 'mp4'
            if bg_small_h == 0 or bg_src.height < bg_small_h
              assign bg_small_h = bg_src.height
              assign bg_video_small_url = bg_src.url
            endif
          elsif bg_src.format == 'm3u8'
            assign bg_video_hls_url = bg_src.url
          endif
        endfor
      elsif section.settings.background_video != blank
        assign bg_video_url = section.settings.background_video
      endif
    -%}
    {%- if bg_video_url != blank -%}
      {%- comment -%} No `autoplay` attribute: hero playback is JS-driven (the
        play/pause IIFE below owns it). A present `autoplay` keeps the browser's
        own autoplay controller live in parallel and fights our off-screen
        pause() — that was the caeb065 flash. Keep loop/muted/playsinline. {%- endcomment -%}
      <video
        class="casa-hero__video"
        muted
        loop
        playsinline
        preload="metadata"
        data-casa-lazy-video
        {% if section.settings.background_image != blank %}poster="{{ section.settings.background_image | image_url: width: 1200, format: 'webp' }}"{% endif %}
        aria-hidden="true"
      >
        <source data-src="{{ bg_video_url }}"{% if bg_video_small_url != blank and bg_video_small_url != bg_video_url %} data-src-small="{{ bg_video_small_url }}"{% endif %}{% if bg_video_hls_url != blank %} data-src-hls="{{ bg_video_hls_url }}"{% endif %} type="video/mp4">
      </video>
    {%- endif -%}
    <div class="casa-hero__overlay"></div>
  </div>

  {%- comment -%} ═══ Animation Layer ═══ {%- endcomment -%}
  {%- if animation_style != 'none' -%}
    <div class="casa-hero__animations" aria-hidden="true">
      {%- case animation_style -%}
        {%- when 'particles' -%}
          {%- for i in (1..15) -%}
            <div class="casa-hero__particle"></div>
          {%- endfor -%}
        {%- when 'aurora' -%}
          <div class="casa-hero__aurora">
            <div class="casa-hero__aurora-layer"></div>
            <div class="casa-hero__aurora-layer"></div>
            <div class="casa-hero__aurora-layer"></div>
          </div>
        {%- when 'orbs' -%}
          <div class="casa-hero__orb casa-hero__orb--1"></div>
          <div class="casa-hero__orb casa-hero__orb--2"></div>
          <div class="casa-hero__orb casa-hero__orb--3"></div>
        {%- when 'gradient-flow' -%}
          <div class="casa-hero__gradient-flow"></div>
        {%- when 'starfield' -%}
          {%- for i in (1..50) -%}
            <div class="casa-hero__star"></div>
          {%- endfor -%}
        {%- when 'waves' -%}
          <div class="casa-hero__waves">
            <div class="casa-hero__wave"></div>
            <div class="casa-hero__wave"></div>
            <div class="casa-hero__wave"></div>
          </div>
      {%- endcase -%}
    </div>
  {%- endif -%}

  {%- comment -%} ═══ Promo Banner ═══ {%- endcomment -%}
  {%- if section.settings.show_promo_banner and section.settings.promo_text != blank -%}
    <div class="casa-hero__promo{% if section.settings.promo_bg_color != blank %} casa-hero__promo--solid{% endif %}">
      <div class="casa-hero__promo-inner">
        {%- if section.settings.promo_icon != 'none' -%}
          {%- render 'casa-icon', icon: section.settings.promo_icon, size: 16 -%}
        {%- endif -%}
        <span>{{ section.settings.promo_text }}</span>
        {%- if section.settings.promo_code != blank -%}
          <code class="casa-hero__promo-code">{{ section.settings.promo_code }}</code>
        {%- endif -%}
        {%- if section.settings.promo_countdown != blank -%}
          {%- comment -%}
            The schema documents promo_countdown as "YYYY-MM-DD HH:MM". The
            date filter parses that in the STORE's timezone and %s emits a
            UTC epoch, so every visitor counts down to the same absolute
            deadline. An unparseable value passes through as-is and the JS
            consumer bails on the NaN.
          {%- endcomment -%}
          <span class="casa-hero__countdown" data-countdown="{{ section.settings.promo_countdown | escape }}" data-countdown-ts="{{ section.settings.promo_countdown | date: '%s' | escape }}"></span>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ═══ Main Content ═══ {%- endcomment -%}
  <div class="casa-hero__container">
    <div class="casa-hero__content">
      {%- comment -%} Text Column {%- endcomment -%}
      <div class="casa-hero__text">
        {%- comment -%} Badges Row {%- endcomment -%}
        <div class="casa-hero__badges">
          {%- if section.settings.badge_new -%}
            <span class="casa-hero__badge casa-hero__badge--new" style="{% if badge_bg_color != blank %}background: {{ badge_bg_color }};{% endif %}{% if badge_text_color != blank %}color: {{ badge_text_color }};{% endif %}">
              {%- render 'casa-icon', icon: 'sparkles', size: 12 -%}
              New
            </span>
          {%- endif -%}
          {%- if section.settings.badge_sale and section.settings.badge_sale_text != blank -%}
            <span class="casa-hero__badge casa-hero__badge--sale" style="{% if badge_bg_color != blank %}background: {{ badge_bg_color }};{% endif %}{% if badge_text_color != blank %}color: {{ badge_text_color }};{% endif %}">
              {%- render 'casa-icon', icon: 'tag', size: 12 -%}
              {{ section.settings.badge_sale_text }}
            </span>
          {%- endif -%}
          {%- if section.settings.badge_limited -%}
            <span class="casa-hero__badge casa-hero__badge--limited" style="{% if badge_bg_color != blank %}background: {{ badge_bg_color }};{% endif %}{% if badge_text_color != blank %}color: {{ badge_text_color }};{% endif %}">
              {%- render 'casa-icon', icon: 'zap', size: 12 -%}
              Limited Edition
            </span>
          {%- endif -%}
          {%- if section.settings.tag_text != blank -%}
            <span class="casa-hero__badge casa-hero__badge--tag" style="{% if badge_bg_color != blank %}background: {{ badge_bg_color }};{% endif %}{% if badge_text_color != blank %}color: {{ badge_text_color }};{% endif %}">
              {%- if section.settings.tag_icon != 'none' -%}
                {%- render 'casa-icon', icon: section.settings.tag_icon, size: 14 -%}
              {%- endif -%}
              {{ section.settings.tag_text }}
            </span>
          {%- endif -%}
        </div>

        {%- comment -%} Title {%- endcomment -%}
        {%- if section.settings.title_line_1 != blank or section.settings.title_gradient != blank or section.settings.title_line_2 != blank -%}
          <h1 class="casa-hero__title">
            {%- if section.settings.title_line_1 != blank -%}
              <span class="casa-hero__title-line">{{ section.settings.title_line_1 }}</span>
            {%- endif -%}
            {%- comment -%}
              Strip regular whitespace, NBSP (U+00A0), zero-width space (U+200B),
              and HTML entities that render as invisible characters. If anything
              is left, render the gradient span; otherwise skip entirely.
            {%- endcomment -%}
            {%- assign accent_word = section.settings.title_gradient | strip | replace: ' ', '' | replace: '​', '' | replace: '&nbsp;', '' | replace: '&#160;', '' | replace: '&#8203;', '' -%}
            {%- if accent_word != blank -%}
              {%- assign accent_style = section.settings.title_gradient_style | default: 'shimmer' -%}
              <span class="casa-hero__title-gradient casa-hero__title-gradient--{{ accent_style }}{% if accent_style == 'shimmer' %} text-grad-shimmer{% elsif accent_style == 'text' %} text-grad-text{% endif %}">{{ section.settings.title_gradient | strip }}</span>
            {%- endif -%}
            {%- if section.settings.title_line_2 != blank -%}
              <span class="casa-hero__title-line">{{ section.settings.title_line_2 }}</span>
            {%- endif -%}
          </h1>
        {%- endif -%}

        {%- comment -%} Subtitle {%- endcomment -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="casa-hero__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        {%- comment -%} Features List {%- endcomment -%}
        {%- if section.settings.show_features -%}
          <ul class="casa-hero__features">
            {%- if section.settings.feature_1 != blank -%}
              <li>
                {%- render 'casa-icon', icon: 'check', size: 16 -%}
                {{ section.settings.feature_1 }}
              </li>
            {%- endif -%}
            {%- if section.settings.feature_2 != blank -%}
              <li>
                {%- render 'casa-icon', icon: 'check', size: 16 -%}
                {{ section.settings.feature_2 }}
              </li>
            {%- endif -%}
            {%- if section.settings.feature_3 != blank -%}
              <li>
                {%- render 'casa-icon', icon: 'check', size: 16 -%}
                {{ section.settings.feature_3 }}
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- comment -%} Price Display {%- endcomment -%}
        {%- if section.settings.show_price and section.settings.price != blank -%}
          <div class="casa-hero__price-wrapper">
            {%- if section.settings.compare_price != blank -%}
              <span class="casa-hero__compare-price">{{ section.settings.compare_price }}</span>
            {%- endif -%}
            <span class="casa-hero__price">{{ section.settings.price }}</span>
            {%- if section.settings.price_suffix != blank -%}
              <span class="casa-hero__price-suffix">{{ section.settings.price_suffix }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} Buttons {%- endcomment -%}
        <div class="casa-hero__buttons">
          {%- if section.settings.button_primary_text != blank -%}
            {%- assign btn_p_icon_pos = section.settings.button_primary_icon_position | default: 'right' -%}
            <a
              href="{{ section.settings.button_primary_link }}"
              class="btn btn-featured casa-hero__btn casa-hero__btn--primary casa-hero__btn--{{ section.settings.button_primary_size | default: 'medium' }}"
              {%- if section.settings.button_primary_style == 'pulse' %} data-pulse{%- endif -%}
            >
              {%- if section.settings.button_primary_icon != 'none' and btn_p_icon_pos == 'left' -%}
                {%- render 'casa-icon', icon: section.settings.button_primary_icon, size: 18, class: 'arrow' -%}
              {%- endif -%}
              {{ section.settings.button_primary_text }}
              {%- if section.settings.button_primary_icon != 'none' and btn_p_icon_pos == 'right' -%}
                {%- render 'casa-icon', icon: section.settings.button_primary_icon, size: 18, class: 'arrow' -%}
              {%- endif -%}
            </a>
          {%- endif -%}
          {%- if section.settings.button_secondary_text != blank -%}
            {%- assign btn_s_icon_pos = section.settings.button_secondary_icon_position | default: 'right' -%}
            <a href="{{ section.settings.button_secondary_link }}" class="btn btn-secondary-on-dark casa-hero__btn casa-hero__btn--secondary casa-hero__btn--{{ section.settings.button_secondary_size | default: "medium" }}">
              {%- if section.settings.button_secondary_icon != 'none' and btn_s_icon_pos == 'left' -%}
                {%- render 'casa-icon', icon: section.settings.button_secondary_icon, size: 18, class: 'arrow' -%}
              {%- endif -%}
              {{ section.settings.button_secondary_text }}
              {%- if section.settings.button_secondary_icon != 'none' and btn_s_icon_pos == 'right' -%}
                {%- render 'casa-icon', icon: section.settings.button_secondary_icon, size: 18, class: 'arrow' -%}
              {%- endif -%}
            </a>
          {%- endif -%}
          {%- if section.settings.button_tertiary_text != blank -%}
            <a href="{{ section.settings.button_tertiary_link }}" class="btn btn-tertiary casa-hero__btn casa-hero__btn--tertiary">
              {{ section.settings.button_tertiary_text }}
            </a>
          {%- endif -%}
        </div>

        {%- comment -%} Inline product image (mobile) — shows under buttons {%- endcomment -%}
        {%- if section.settings.show_inline_image_mobile and section.settings.visual_image != blank -%}
          <div class="casa-hero__inline-image">
            <img
              src="{{ section.settings.visual_image | image_url: width: 600 }}"
              srcset="
                {{ section.settings.visual_image | image_url: width: 300 }} 300w,
                {{ section.settings.visual_image | image_url: width: 600 }} 600w
              "
              sizes="(max-width: 749px) calc(100vw - 32px), 400px"
              width="{{ section.settings.visual_image.width | default: 600 }}"
              height="{{ section.settings.visual_image.height | default: 600 }}"
              alt="{{ section.settings.visual_image.alt | default: section.settings.title_gradient | escape }}"
              loading="eager"
              class="casa-hero__inline-img"
            >
          </div>
        {%- endif -%}

        {%- comment -%} Social Proof {%- endcomment -%}
        {%- if section.settings.show_social_proof -%}
          <div class="casa-hero__social-proof">
            {%- if section.settings.show_rating -%}
              <div class="casa-hero__rating">
                <div class="casa-hero__stars">
                  {%- for i in (1..5) -%}
                    {%- render 'casa-icon', icon: 'star', size: 16 -%}
                  {%- endfor -%}
                </div>
                <span class="casa-hero__rating-text">
                  {{ section.settings.rating_score | default: '4.9' }}
                  {%- if section.settings.rating_count != blank -%}
                    <span class="casa-hero__rating-count">({{ section.settings.rating_count }} reviews)</span>
                  {%- endif -%}
                </span>
              </div>
            {%- endif -%}
            {%- if section.settings.social_proof_text != blank -%}
              <p class="casa-hero__proof-text">{{ section.settings.social_proof_text }}</p>
            {%- endif -%}
            {%- if section.settings.show_avatars -%}
              <div class="casa-hero__avatars">
                <div class="casa-hero__avatar-stack">
                  {%- for i in (1..5) -%}
                    <div class="casa-hero__avatar">{{ i }}</div>
                  {%- endfor -%}
                </div>
                {%- if section.settings.customer_count != blank -%}<span>+{{ section.settings.customer_count }} happy customers</span>{%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%}
          Trust Badges (DESKTOP variant).
          Lives inside .casa-hero__text so on desktop it sits at the
          bottom of the text column (below the buttons). The same row
          is duplicated below as a sibling of .casa-hero__visual so on
          MOBILE it can render after the visual instead of before.
          CSS at the bottom of this file toggles which one is visible
          per breakpoint via .casa-hero__trust-row--desktop-only and
          --mobile-only modifier classes.
        {%- endcomment -%}
        {%- liquid
          # Icon fallbacks pre-assigned: Shopify's render tag does not support
          # filters on arguments (they are silently dropped), so `icon: x |
          # default: 'truck'` never actually defaulted. Assigning first makes
          # the fallback real. Shared by the desktop trust row, the float
          # badges, and the mobile trust row below.
          assign _trust_1_icon = section.settings.trust_1_icon | default: 'truck'
          assign _trust_2_icon = section.settings.trust_2_icon | default: 'shield-check'
          assign _trust_3_icon = section.settings.trust_3_icon | default: 'refresh'
          assign _visual_badge_1_icon = section.settings.visual_badge_1_icon | default: 'zap'
          assign _visual_badge_2_icon = section.settings.visual_badge_2_icon | default: 'palette'
          assign _visual_badge_3_icon = section.settings.visual_badge_3_icon | default: 'smartphone'
        -%}
        {%- if section.settings.show_trust_row -%}
          <div class="casa-hero__trust-row casa-hero__trust-row--desktop-only">
            {%- if section.settings.trust_1_text != blank -%}
              <div class="casa-hero__trust-item">
                {%- render 'casa-icon', icon: _trust_1_icon, size: 18 -%}
                <span>{{ section.settings.trust_1_text }}</span>
              </div>
            {%- endif -%}
            {%- if section.settings.trust_2_text != blank -%}
              <div class="casa-hero__trust-item">
                {%- render 'casa-icon', icon: _trust_2_icon, size: 18 -%}
                <span>{{ section.settings.trust_2_text }}</span>
              </div>
            {%- endif -%}
            {%- if section.settings.trust_3_text != blank -%}
              <div class="casa-hero__trust-item">
                {%- render 'casa-icon', icon: _trust_3_icon, size: 18 -%}
                <span>{{ section.settings.trust_3_text }}</span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Visual Column {%- endcomment -%}
      {%- if layout == 'split' or layout == 'split-reverse' -%}
        <div class="casa-hero__visual">
          {%- comment -%}
            Soft light pool under the floating mirror. Sibling of (not inside)
            .casa-hero__visual-wrapper so it stays put while the mirror floats.
            Radial-gradient only — no filter: blur(), no @property-animated
            gradient. That pairing is exactly what made .casa-hero__glow-frame
            paint an opaque square behind the transparent mirror cutout in
            shipping Safari; softness here comes from the colour stops, so
            there is no filter layer for WebKit to rasterize wrong.
          {%- endcomment -%}
          {%- if section.settings.show_floor_glow -%}
            <div class="casa-hero__floor-glow" aria-hidden="true"></div>
          {%- endif -%}
          <div class="casa-hero__visual-wrapper">
            {%- comment -%} Animated Glow Frame {%- endcomment -%}
            {%- if section.settings.show_glow_frame -%}
              <div class="casa-hero__glow-frame">
                <div class="casa-hero__glow-ring"></div>
                <div class="casa-hero__glow-ring"></div>
              </div>
            {%- endif -%}

            {%- comment -%} Product/Feature Image or Video — image shows first, video lazy-loads & fades in {%- endcomment -%}
            {%- liquid
              assign vis_video_url = ''
              assign vis_video_small_url = ''
              assign vis_video_hls_url = ''
              if section.settings.visual_video_file != blank
                assign vis_video_url = section.settings.visual_video_file.sources[1].url | default: section.settings.visual_video_file.sources[0].url
                # Same phone-rendition rule as the bg video above.
                assign vis_small_h = 0
                for vis_src in section.settings.visual_video_file.sources
                  if vis_src.format == 'mp4'
                    if vis_small_h == 0 or vis_src.height < vis_small_h
                      assign vis_small_h = vis_src.height
                      assign vis_video_small_url = vis_src.url
                    endif
                  elsif vis_src.format == 'm3u8'
                    assign vis_video_hls_url = vis_src.url
                  endif
                endfor
              elsif section.settings.visual_video != blank
                assign vis_video_url = section.settings.visual_video
              endif
            -%}
            {%- if vis_video_url != blank -%}
              <div class="casa-hero__visual-media casa-hero__visual-media--video">
                {%- if section.settings.visual_image != blank -%}
                  <img
                    class="casa-hero__visual-poster"
                    src="{{ section.settings.visual_image | image_url: width: 800 }}"
                    srcset="
                      {{ section.settings.visual_image | image_url: width: 400 }} 400w,
                      {{ section.settings.visual_image | image_url: width: 600 }} 600w,
                      {{ section.settings.visual_image | image_url: width: 800 }} 800w
                    "
                    sizes="(max-width: 900px) 300px, 500px"
                    width="{{ section.settings.visual_image.width | default: 800 }}"
                    height="{{ section.settings.visual_image.height | default: 800 }}"
                    alt="{{ section.settings.visual_image.alt | default: section.settings.title_gradient | escape }}"
                    loading="eager"
                    decoding="async"
                  >
                {%- endif -%}
                {%- comment -%} No `autoplay` — JS-driven, same as the bg video above. {%- endcomment -%}
                <video
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  data-casa-lazy-video
                  {% if section.settings.visual_image != blank %}poster="{{ section.settings.visual_image | image_url: width: 600 }}"{% endif %}
                  aria-hidden="true"
                >
                  <source data-src="{{ vis_video_url }}"{% if vis_video_small_url != blank and vis_video_small_url != vis_video_url %} data-src-small="{{ vis_video_small_url }}"{% endif %}{% if vis_video_hls_url != blank %} data-src-hls="{{ vis_video_hls_url }}"{% endif %} type="video/mp4">
                </video>
              </div>
            {%- elsif section.settings.visual_image != blank -%}
              <div class="casa-hero__visual-media">
                <img
                  src="{{ section.settings.visual_image | image_url: width: 800 }}"
                  srcset="
                    {{ section.settings.visual_image | image_url: width: 400 }} 400w,
                    {{ section.settings.visual_image | image_url: width: 600 }} 600w,
                    {{ section.settings.visual_image | image_url: width: 800 }} 800w
                  "
                  sizes="(max-width: 900px) 300px, 500px"
                  width="{{ section.settings.visual_image.width | default: 800 }}"
                  height="{{ section.settings.visual_image.height | default: 800 }}"
                  alt="{{ section.settings.visual_image.alt | default: section.settings.title_gradient | escape }}"
                  loading="eager"
                  class="casa-hero__product-image"
                >
              </div>
            {%- else -%}
              {%- comment -%} Animated Infinity Mirror Fallback {%- endcomment -%}
              <div class="casa-hero__mirror {{ section.settings.mirror_shape | default: 'octagon' }}">
                <div class="casa-hero__mirror-frame {{ section.settings.mirror_shape | default: 'octagon' }}">
                  <div class="casa-hero__mirror-glow {{ section.settings.mirror_shape | default: 'octagon' }}">
                    <div class="casa-hero__mirror-inner {{ section.settings.mirror_shape | default: 'octagon' }}">
                      <div class="casa-hero__mirror-depth {{ section.settings.mirror_shape | default: 'octagon' }}">
                        <div class="casa-hero__mirror-center {{ section.settings.mirror_shape | default: 'octagon' }}"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {%- endif -%}

            {%- comment -%}
              Floating Badges on Visual.
              Wrapped in .casa-hero__float-badges so we can flip the
              layout from "badges absolute-positioned around the
              mirror" (desktop) to "badges as inline pills below the
              mirror" (mobile) without losing the desktop floating
              effect. Wrapper is `display: contents` on desktop so
              it's structurally invisible — each badge keeps its
              existing top/left positioning relative to the original
              .casa-hero__visual-inner ancestor. On mobile (max-width
              900px) the wrapper becomes a centered flex-wrap row so
              the badges (16M+ Colors / Music Reactive / App Control,
              etc) are visible without overflowing the narrow visual
              column. See CSS rules near the bottom of this file.
            {%- endcomment -%}
            {%- if section.settings.visual_badge_1 != blank or section.settings.visual_badge_2 != blank or section.settings.visual_badge_3 != blank -%}
              <div class="casa-hero__float-badges">
                {%- if section.settings.visual_badge_1 != blank -%}
                  <div class="casa-hero__float-badge casa-hero__float-badge--1">
                    {%- render 'casa-icon', icon: _visual_badge_1_icon, size: 16 -%}
                    {{ section.settings.visual_badge_1 }}
                  </div>
                {%- endif -%}
                {%- if section.settings.visual_badge_2 != blank -%}
                  <div class="casa-hero__float-badge casa-hero__float-badge--2">
                    {%- render 'casa-icon', icon: _visual_badge_2_icon, size: 16 -%}
                    {{ section.settings.visual_badge_2 }}
                  </div>
                {%- endif -%}
                {%- if section.settings.visual_badge_3 != blank -%}
                  <div class="casa-hero__float-badge casa-hero__float-badge--3">
                    {%- render 'casa-icon', icon: _visual_badge_3_icon, size: 16 -%}
                    {{ section.settings.visual_badge_3 }}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%}
        Trust Badges (MOBILE variant).
        Sibling of .casa-hero__visual so on mobile (where .casa-hero__content
        is flex-column) the trust row renders AFTER the mirror image instead
        of before it. The desktop variant inside .casa-hero__text remains
        the source-of-truth for desktop layout. CSS toggles visibility:
        --desktop-only is hidden ≤900px, --mobile-only is hidden >900px.
      {%- endcomment -%}
      {%- if section.settings.show_trust_row -%}
        <div class="casa-hero__trust-row casa-hero__trust-row--mobile-only">
          {%- if section.settings.trust_1_text != blank -%}
            <div class="casa-hero__trust-item">
              {%- render 'casa-icon', icon: _trust_1_icon, size: 18 -%}
              <span>{{ section.settings.trust_1_text }}</span>
            </div>
          {%- endif -%}
          {%- if section.settings.trust_2_text != blank -%}
            <div class="casa-hero__trust-item">
              {%- render 'casa-icon', icon: _trust_2_icon, size: 18 -%}
              <span>{{ section.settings.trust_2_text }}</span>
            </div>
          {%- endif -%}
          {%- if section.settings.trust_3_text != blank -%}
            <div class="casa-hero__trust-item">
              {%- render 'casa-icon', icon: _trust_3_icon, size: 18 -%}
              <span>{{ section.settings.trust_3_text }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Scroll Indicator {%- endcomment -%}
  {%- if section.settings.show_scroll_indicator -%}
    <div class="casa-hero__scroll-indicator">
      <div class="casa-hero__scroll-mouse">
        <div class="casa-hero__scroll-wheel"></div>
      </div>
      <span>{{ 'content.scroll_to_explore' | t | default: 'Scroll to explore' }}</span>
    </div>
  {%- endif -%}
</section>

<script>
  // FOUT-no-show: add .fonts-ready class once Inter is actually loaded so
  // the hero title (which is hidden via opacity:0 in CSS until then) can
  // fade in at its final size. See the .casa-hero__title CSS comment
  // explaining why this is needed (the metric-matched fallback was being
  // skipped by the cascade in favour of -apple-system, causing a 7%
  // size enlargement when Inter swapped in).
  (function() {
    var ready = function() {
      // Use rAF so the class addition + fade-in are batched into one paint
      // — avoids any frame where the title is in a transitional state.
      requestAnimationFrame(function() {
        document.documentElement.classList.add('fonts-ready');
      });
    };

    // Check ONLY the two fonts the title depends on, not every @font-face.
    // 2026-05-11 fix after iOS recording showed title invisible for ~10s:
    // `document.fonts.ready` waits for ALL fonts including body, subheading,
    // accent which the title doesn't need. On iOS Safari, low-priority or
    // unicode-range fonts can take many seconds to settle, blocking the
    // title reveal even though Inter bold + bold-italic loaded fast.
    //
    // document.fonts.check() returns true once the specific font is loaded,
    // so we can fire `ready` as soon as the two title-relevant variants
    // are available — independent of slow body/subheading/accent fonts.
    function titleFontsLoaded() {
      if (!document.fonts || !document.fonts.check) return false;
      try {
        // Match the @font-face declarations the title uses (700 weight, with
        // and without italic). If `check` is available the heading bold
        // and heading bold-italic queries return true when those specific
        // variants have loaded.
        return document.fonts.check('700 16px "Inter Casa"') &&
               document.fonts.check('italic 700 16px "Inter Casa"');
      } catch (e) {
        return false;
      }
    }

    if (titleFontsLoaded()) {
      ready();
    } else if (document.fonts && document.fonts.ready) {
      // Poll briefly — `document.fonts.ready` waits for all fonts so it's
      // too slow; instead check our two specific fonts every 50ms.
      var pollStart = Date.now();
      var poll = setInterval(function() {
        if (titleFontsLoaded()) {
          clearInterval(poll);
          ready();
        } else if (Date.now() - pollStart > 500) {
          // Match CSS animation backstop — never poll past the 500ms cap.
          clearInterval(poll);
          ready();
        }
      }, 50);
    } else {
      // No Font Loading API support — fall back to immediate reveal.
      ready();
    }
    // Hard backstop: matches the CSS animation backstop (500ms). If the
    // poll above didn't fire (e.g., browser quirk), force visibility here.
    setTimeout(ready, 500);
  })();
</script>
<script>
  (function() {
    // This script tag renders inside its own section; capture that root SYNCHRONOUSLY
    // (document.currentScript is only valid during synchronous execution) so each
    // hero IIFE wires ONLY its own section at load instead of rescanning the whole
    // document — and so two hero instances on one page don't each wire the other.
    var OWN_SECTION = (document.currentScript && document.currentScript.closest)
      ? document.currentScript.closest('.shopify-section')
      : null;

    // Lazy-load hero videos: start loading when idle (background) or when in view (visual).
    // Respects Save-Data & prefers-reduced-motion — skips video entirely if either is set.
    var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var saveData = (navigator.connection && navigator.connection.saveData) === true;
    var slowNet = navigator.connection && /2g|slow-2g/.test(navigator.connection.effectiveType || '');

    // Save-Data / reduced-motion / 2g: never play video. Drop matching
    // videos so the poster image stays. Computed once and applied both on
    // initial load AND on every theme-editor section re-render (process()).
    var mediaOptOut = reducedMotion || saveData || slowNet;
    function dropVideos(root) {
      (root || document).querySelectorAll('video[data-casa-lazy-video]').forEach(function(v) { v.remove(); });
    }

    function startVideo(video) {
      if (video.dataset.casaVideoStarted) return;
      video.dataset.casaVideoStarted = '1';
      // iOS Safari ignores the muted/playsinline HTML *attributes* when a
      // video's src is assigned in JS and play() is called programmatically:
      // it treats the video as audible + fullscreen-intent, REJECTS the
      // autoplay, and paints its native centre play button (which our
      // pointer-events:none video can't even dismiss). Setting the
      // PROPERTIES explicitly is what makes muted inline autoplay eligible.
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      video.setAttribute('muted', '');
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');
      var source = video.querySelector('source[data-src]');
      var videoUrl = source ? source.dataset.src : '';
      // Phone viewports take a lighter stream. Preference order: a real small
      // MP4 rendition (data-src-small — only present when the Liquid drop
      // exposes one), else the HLS manifest (data-src-hls) on browsers with
      // native HLS (iOS Safari) — adaptive variants beat forcing the 1080p.
      // Decided once at arm time on purpose: a later rotate/resize must never
      // swap src on a playing video (that re-runs the load algorithm and
      // blanks the frame).
      if (source && window.matchMedia && window.matchMedia('(max-width: 749px)').matches) {
        if (source.dataset.srcSmall) {
          videoUrl = source.dataset.srcSmall;
        } else if (source.dataset.srcHls && video.canPlayType('application/vnd.apple.mpegurl')) {
          videoUrl = source.dataset.srcHls;
        }
      }
      if (videoUrl) {
        video.src = videoUrl;
        // Force the media-element load algorithm to re-run with the new src.
        // The element parsed with preload="metadata" + a srcless <source>, and
        // iOS WebKit does NOT reliably re-select a source from a bare `.src`
        // write — without load() the loadeddata/canplay events may never fire
        // and we'd fall through to the 2s timeout (a ~2s poster-only window).
        video.load();
      }
      // Just play — no opacity toggling, no class swaps.
      // Video element is always visible; before src loads it shows
      // poster or is transparent. Frames appear naturally.
      //
      // Low Power Mode is the case the CSS pseudo-element suppression can't
      // win: iOS refuses muted inline autoplay at the OS level (play()
      // rejects with NotAllowedError) and paints its native centre play
      // button over the poster. Because the video is pointer-events:none
      // that button is non-dismissible — it just sits there greyed out. The
      // only cross-version-reliable fix is to drop the video on a CONFIRMED
      // refusal, exactly as we already do for reduced-motion / save-data:
      // the .casa-hero__bg-image poster (or the in-card visual poster) stays
      // and iOS has nothing left to draw a button on.
      var played = false;
      // Reveal the video ONLY once it is genuinely playing. Until then it is
      // visibility:hidden (CSS), so iOS has no control layer to paint a play
      // button on — the poster shows and there is no Low Power Mode flash.
      // The first video frame equals the poster, so the swap is seamless.
      function reveal() {
        played = true;
        video.classList.add('casa-video-visible');
      }
      video.addEventListener('playing', reveal, { once: true });
      // Backstop: 'playing' can be missed on some iOS builds; timeupdate fires
      // as soon as the clock advances, i.e. it is definitely rendering frames.
      video.addEventListener('timeupdate', reveal, { once: true });

      function dropToPoster() {
        // Only when autoplay truly never started. The poster underneath is
        // the same asset, so removing the absolutely-positioned video causes
        // no layout shift and no visual jump. __casaSuspended guards the case
        // where the observer intentionally paused this off-screen before it
        // ever played: it sits paused at frame 0, which must NOT read as an LPM
        // refusal, or we'd delete a healthy hero on scroll.
        if (played || !video.isConnected || video.__casaSuspended) return;
        video.remove();
      }

      function tryPlay(isFinal) {
        // Honor the observer's should-play signal: never start (or restart) a
        // video the observer has suspended off-screen. startVideo and the
        // observer share __casaShouldPlay as the single source of truth — without
        // this gate an event-driven retry (or the 2s backstop) could re-play a
        // just-suspended bg video off-screen, the exact thing this change
        // prevents. Undefined = allowed (first paint, before the observer speaks).
        if (video.__casaShouldPlay === false) return;
        // Re-assert muted/inline at play time. Some iOS builds drop the
        // muted state across load() and then reject the autoplay as
        // "audible", which is what surfaces the native centre play button.
        video.muted = true;
        video.playsInline = true;
        var p = video.play();
        if (p && p.then) {
          p.then(function () {
            // Suspended while play() was resolving → pause straight back.
            if (video.__casaShouldPlay === false) { video.pause(); return; }
            reveal();
          }, function () {
            // Earlier rejections are routine (no data yet) — the event-driven
            // retries below recover on a normal device. Act ONLY on the final
            // attempt: a rejection there is a real refusal (Low Power Mode).
            // A still-pending promise (slow-network buffering) is not a
            // rejection, so nothing is removed and the video plays later.
            if (isFinal) dropToPoster();
          });
        }
      }
      // Fire on the earliest event that lets play() succeed, plus an
      // immediate attempt and a hard 2s backstop. tryPlay is idempotent.
      video.addEventListener('loadedmetadata', function () { tryPlay(false); }, { once: true });
      video.addEventListener('loadeddata', function () { tryPlay(false); }, { once: true });
      video.addEventListener('canplay', function () { tryPlay(false); }, { once: true });
      tryPlay(false);
      setTimeout(function () { tryPlay(true); }, 2000);

      // Second Low Power Mode signature: some iOS builds neither play nor
      // reject — play() stays *pending* forever, so the rejection path above
      // never fires, yet the native play button is still painted. Catch it by
      // state: if the element has buffered enough to play (readyState >=
      // HAVE_FUTURE_DATA = 3) but is still paused at frame 0 and never fired
      // 'playing', autoplay was refused, not merely slow. The readyState gate
      // is what keeps this safe — a genuinely buffering video on a slow (but
      // not 2g) connection has readyState < 3, so it is left alone to play
      // when its data arrives.
      setTimeout(function () {
        if (played || !video.isConnected || video.__casaSuspended) return;
        if (video.paused && video.currentTime === 0 && video.readyState >= 3) {
          dropToPoster();
        }
      }, 2600);
    }

    // ── Play/pause ownership (JS is the SOLE controller) ───────────────────
    // The hero <video>s keep `loop muted playsinline` but NOT `autoplay`:
    // playback is 100% JS-driven (startVideo → src + load() + play()), so the
    // attribute did nothing at parse (lazy data-src) yet kept the browser's own
    // autoplay controller live in PARALLEL with our JS — which is what made the
    // earlier off-screen pause() bounce/flash (caeb065, reverted 7f3a454). With
    // `autoplay` gone, pause() is sticky. Same proven pattern already shipped in
    // casa-split-feature / casa-styled-spaces-home / casa-brand-story (native
    // `loop` kept — only `autoplay` fought the JS owner, so no JS re-loop needed).

    function motionAllowed() {
      return !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
    }

    // Resume = play when (back) in view. In-card videos get their first start
    // here; the BG video's first start is owned by the idle-kick below, so we
    // only RESUME it here, never start it early.
    function resumeVideo(video) {
      if (!video.isConnected) return;   // dropped to poster on a confirmed LPM refusal
      if (!motionAllowed()) return;     // reduced-motion enabled mid-session → stay paused
      video.__casaShouldPlay = true;
      video.__casaSuspended = false;
      if (!video.dataset.casaVideoStarted) {
        // The idle-kick owns the bg first start (LCP timing) — the initial
        // geometry pass reaches here ~16ms after init, LONG before the kick,
        // so an unconditional start would put the multi-MB fetch back on the
        // LCP critical path. Only start the bg here AFTER the kick has run
        // and skipped (user had scrolled past; __casaShouldPlay was false):
        // that is the scroll-back case where nothing else will start it.
        // startVideo is idempotent and its tryPlay honors __casaShouldPlay.
        if (!video.closest('.casa-hero__bg') || video.__casaKickDone) startVideo(video);
        return;
      }
      if (video.paused) {
        video.muted = true;             // some iOS builds drop muted across pause/resume
        video.playsInline = true;
        var p = video.play();
        if (p && p.then) p.then(function () {
          // Scrolled back out while play() was resolving → honor the latest state.
          if (!video.__casaShouldPlay && !video.paused) video.pause();
        }, function () {});             // AbortError when a pending play() is interrupted by pause() — expected
      }
    }

    // Suspend = pause when scrolled out so it stops decoding off-screen.
    function suspendVideo(video) {
      video.__casaShouldPlay = false;
      video.__casaSuspended = true;     // marks this pause intentional so drop-to-poster won't fire
      if (video.isConnected && video.dataset.casaVideoStarted && !video.paused) video.pause();
    }

    // One IntersectionObserver + one reduced-motion listener PER SECTION, tracked
    // in a WeakMap so shopify:section:unload can disconnect them. A persistent
    // (never-unobserve) observer would otherwise leak across theme-editor renders.
    // The registry is SHARED on window.casa across every hero IIFE on the page:
    // each script tag is emitted per section instance, so they must all consult one
    // registry — otherwise initSection's teardown can't see (and disconnect) a
    // sibling instance's observer for the same section, which would double-observe
    // and leak when a merchant places two hero sections on one page.
    window.casa = window.casa || {};
    var sectionMedia = (typeof WeakMap !== 'undefined')
      ? (window.casa.heroObservers || (window.casa.heroObservers = new WeakMap()))
      : null;

    // ── Overlay gate ──────────────────────────────────────────────────────────
    // The hero owns its own playback (see the ownership note above), so the
    // shared casa-offscreen-pause gate can't pause it for us. Consult the SAME
    // predicate here — the single source of truth exposed on window.casa — and
    // subscribe each section's scheduleEval to overlay open/close in initSection
    // (opening an overlay fires no scroll/resize/IO edge, so nothing else would
    // re-gate the hero). The delegating shim tolerates the deferred utility not
    // having evaluated yet: it returns false, so the hero simply plays as before
    // until the utility loads — never a wedged-paused state.
    function overlayOpen() {
      return !!(window.casa && window.casa.overlayOpen && window.casa.overlayOpen());
    }

    function teardownSection(sectionEl) {
      if (!sectionMedia) return;
      var rec = sectionMedia.get(sectionEl);
      if (!rec) return;
      if (rec.observer) rec.observer.disconnect();
      if (rec.mql && rec.mqlHandler && rec.mql.removeEventListener) {
        rec.mql.removeEventListener('change', rec.mqlHandler);
      }
      if (rec.scheduleEval) {
        window.removeEventListener('scroll', rec.scheduleEval);
        window.removeEventListener('resize', rec.scheduleEval);
        document.removeEventListener('visibilitychange', rec.scheduleEval);
      }
      if (rec.overlayUnsub) { try { rec.overlayUnsub(); } catch (e) {} } // shared overlay-gate subscription
      sectionMedia.delete(sectionEl);
    }

    function initSection(sectionEl) {
      teardownSection(sectionEl); // re-render: never stack observers on the same section
      var videos = sectionEl.querySelectorAll('video[data-casa-lazy-video]');
      if (!videos.length) return;

      // BG video: kick off the first start ASAP but off the critical path (keeps
      // the first frame ready for LCP). Resume/pause afterwards is the observer's.
      Array.prototype.forEach.call(videos, function (video) {
        if (!video.closest('.casa-hero__bg')) return;
        video.__casaShouldPlay = true; // a loop wrap before the first observe isn't swallowed
        // Skip the load entirely if the user already scrolled past before the
        // kick fired — startVideo would fetch megabytes for a video gated from
        // playing off-screen. __casaKickDone tells resumeVideo the kick has had
        // its chance, so scroll-back may start the bg video itself.
        var kick = function () {
          video.__casaKickDone = true;
          if (video.isConnected && video.__casaShouldPlay !== false) startVideo(video);
        };
        if ('requestIdleCallback' in window) requestIdleCallback(kick, { timeout: 1500 });
        else setTimeout(kick, 300);
      });

      var observer = null;
      if ('IntersectionObserver' in window) {
        // rootMargin 0 so the observer fires at the ACTUAL viewport edge. A
        // positive margin (the old 200px, carried over from lazy-loading) keeps
        // a scrolled-past video "intersecting" — and therefore PLAYING/decoding —
        // for an extra 200px past the viewport. On a phone that reads as "the
        // hero keeps playing after you scroll past it." Decide play/pause from
        // the element's real getBoundingClientRect, NOT solely entry.isIntersecting:
        // iOS re-fires this observer on every URL-bar collapse/expand and can
        // report a stale isIntersecting=true for an element that is actually
        // off-screen (memory reference_ios_urlbar_resizes_viewport_breaks_observers
        // — gate on geometry). The rect is the source of truth.
        observer = new IntersectionObserver(function (entries) {
          var vh = window.innerHeight || document.documentElement.clientHeight;
          // An IO edge can land while an overlay is open (iOS URL-bar reflow);
          // gate it too so a stray tick can't resume the hero behind the panel.
          var overlaid = overlayOpen();
          entries.forEach(function (entry) {
            var v = entry.target;
            var r = v.getBoundingClientRect();
            // Hysteresis: suspend only when fully past the edge, resume only
            // once ≥32px is visible. A single boundary makes a slow drag at the
            // hero's bottom edge toggle pause/play every frame — each Safari
            // resume can paint a stale frame (micro-flash). Between the bands,
            // keep the current state.
            if (overlaid || r.width === 0 || r.bottom <= 0 || r.top >= vh) suspendVideo(v);
            else if (r.bottom > 32 && r.top < vh - 32) resumeVideo(v);
          });
        }, { rootMargin: '0px' });
        Array.prototype.forEach.call(videos, function (v) { observer.observe(v); });
      } else {
        // No IntersectionObserver: eager-start the in-card videos (bg already kicked).
        Array.prototype.forEach.call(videos, function (v) { if (!v.closest('.casa-hero__bg')) startVideo(v); });
      }

      // Backstop for iOS — the load-bearing pause path. Safari does NOT reliably
      // deliver IntersectionObserver exit callbacks during momentum scroll or
      // URL-bar collapse, so the observer alone can leave a video PLAYING after it
      // scrolls off-screen (reported on a real iPhone; emulators don't repro it).
      // A rAF-throttled scroll/resize check re-evaluates geometry directly so a
      // scrolled-past video always pauses, and visibilitychange pauses everything
      // when the tab/app is backgrounded. The observer above is now an
      // optimisation layered on top, not the sole driver.
      var rafPending = false;
      function evaluateGeometry() {
        rafPending = false;
        // Tab hidden OR a page-covering overlay open ⇒ suspend regardless of
        // geometry (this is the path the body-class observer drives on open,
        // and that re-runs on close to resume an in-view hero).
        var blocked = document.hidden || overlayOpen();
        var vh = window.innerHeight || document.documentElement.clientHeight;
        Array.prototype.forEach.call(videos, function (v) {
          if (!v.isConnected) return;
          var r = v.getBoundingClientRect();
          // Same hysteresis bands as the observer callback (see comment there).
          if (blocked || r.width === 0 || r.bottom <= 0 || r.top >= vh) suspendVideo(v);
          else if (r.bottom > 32 && r.top < vh - 32) resumeVideo(v);
        });
      }
      function scheduleEval() {
        if (rafPending) return;
        rafPending = true;
        if (window.requestAnimationFrame) window.requestAnimationFrame(evaluateGeometry);
        else setTimeout(evaluateGeometry, 100);
      }
      window.addEventListener('scroll', scheduleEval, { passive: true });
      window.addEventListener('resize', scheduleEval, { passive: true });
      document.addEventListener('visibilitychange', scheduleEval);
      // Overlay open/close → re-gate this hero via the shared subscription (the
      // hero inits on window 'load', so the deferred utility is always present;
      // guard defensively regardless). Unsubscribed in teardownSection.
      var overlayUnsub = (window.casa && window.casa.onOverlayToggle)
        ? window.casa.onOverlayToggle(scheduleEval) : null;
      scheduleEval(); // set initial state without waiting for the first scroll

      // Dynamic reduced-motion: if the user turns Reduce Motion on mid-session,
      // pause every video now; resumeVideo re-checks motionAllowed so it stays paused.
      var mql = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
      var mqlHandler = null;
      if (mql && mql.addEventListener) {
        mqlHandler = function (e) {
          if (!e.matches) return;
          Array.prototype.forEach.call(videos, function (v) {
            v.__casaShouldPlay = false;
            if (v.isConnected && !v.paused) v.pause();
          });
        };
        mql.addEventListener('change', mqlHandler);
      }

      if (sectionMedia) sectionMedia.set(sectionEl, { observer: observer, mql: mql, mqlHandler: mqlHandler, scheduleEval: scheduleEval, overlayUnsub: overlayUnsub });
    }

    // Entry point: opt-out → drop videos; otherwise wire up each hero section.
    function process(root) {
      root = root || document;
      if (mediaOptOut) { dropVideos(root); return; }
      var videos = root.querySelectorAll ? root.querySelectorAll('video[data-casa-lazy-video]') : [];
      if (!videos.length) return;
      var sections = [];
      Array.prototype.forEach.call(videos, function (v) {
        var sec = v.closest('.shopify-section') || root;
        if (sections.indexOf(sec) === -1) sections.push(sec);
      });
      sections.forEach(initSection);
    }

    if (document.readyState === 'complete') process(OWN_SECTION || document);
    else window.addEventListener('load', function () { process(OWN_SECTION || document); });

    // Theme editor re-renders a section's markup wholesale when the merchant edits
    // it: re-wire on load, and DISCONNECT the observer + reduced-motion listener on
    // unload so they don't leak across mount/unmount. Bind once, namespaced.
    window.casa = window.casa || {};
    if (!window.casa.heroVideoBound) {
      window.casa.heroVideoBound = true;
      document.addEventListener('shopify:section:load', function (e) {
        if (e.target && e.target.querySelector && e.target.querySelector('video[data-casa-lazy-video]')) {
          process(e.target);
        }
      });
      document.addEventListener('shopify:section:unload', function (e) {
        if (e.target) teardownSection(e.target);
      });
    }
  })();
</script>

<script>
  // Promo-strip countdown fill. The data-countdown span shipped with no
  // consumer (rendered empty); this is the consumer. Liquid pre-converts
  // the merchant's "YYYY-MM-DD HH:MM" to a store-timezone UTC epoch in
  // data-countdown-ts, so JS only formats remaining time — no per-visitor
  // timezone drift. When the deadline passes the whole strip hides, so
  // the offer copy can't outlive the discount.
  (function() {
    function initCountdowns(root) {
      var els = (root || document).querySelectorAll('.casa-hero__promo [data-countdown-ts]');
      Array.prototype.forEach.call(els, function(el) {
        if (el.dataset.casaCdInit) return;
        el.dataset.casaCdInit = '1';
        // The date filter passes unparseable input through VERBATIM, so a
        // digit-leading typo ("2026-9-31 23:59") would parseInt to a tiny
        // epoch and hide the strip. Only a pure epoch string may proceed.
        if (!/^\d+$/.test(el.dataset.countdownTs || '')) return;
        var ts = parseInt(el.dataset.countdownTs, 10) * 1000;
        var strip = el.closest('.casa-hero__promo');
        var timer;
        function pad(n) { return n < 10 ? '0' + n : '' + n; }
        function render() {
          // Editor churn guard: the theme editor re-renders sections; a
          // detached span means this instance is gone — stop its timer.
          if (!el.isConnected) { if (timer) clearInterval(timer); return; }
          var ms = ts - Date.now();
          if (ms <= 0) {
            if (strip) strip.style.display = 'none';
            if (timer) clearInterval(timer);
            return;
          }
          var m = Math.floor(ms / 60000);
          var d = Math.floor(m / 1440);
          var h = Math.floor((m % 1440) / 60);
          var mm = m % 60;
          el.textContent = d > 0
            ? '· Ends in ' + d + 'd ' + pad(h) + 'h'
            : (h > 0 ? '· Ends in ' + h + 'h ' + pad(mm) + 'm' : '· Ends in ' + mm + 'm');
        }
        render();
        if (ts - Date.now() > 0) timer = setInterval(render, 30000);
      });
    }
    initCountdowns(document);
    window.casa = window.casa || {};
    if (!window.casa.heroCountdownBound) {
      window.casa.heroCountdownBound = true;
      document.addEventListener('shopify:section:load', function(e) {
        if (e.target) initCountdowns(e.target);
      });
    }
  })();
</script>

