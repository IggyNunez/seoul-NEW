{%- comment -%}
  Seoul Glow Lab - PDP Showcase / Use-Case Cards
  3-column lifestyle cards showing product use cases and room scenes
{%- endcomment -%}

{%- comment -%} Auto-hide when no blocks have content {%- endcomment -%}
{%- assign _has_content = false -%}
{%- for block in section.blocks -%}
  {%- if block.settings.title != blank or block.settings.image != blank -%}
    {%- assign _has_content = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if _has_content == false and section.settings.auto_hide and request.design_mode == false -%}
  <style>#shopify-section-{{ section.id }} { display: none !important; }</style>
{%- endif -%}

{%- liquid
  assign bg_color = section.settings.bg_color | default: '#0A0A0F'
  assign text_color = section.settings.text_color | default: '#FAFAF7'
  assign accent_color = section.settings.accent_color | default: '#B0C3FA'
  assign muted_color = section.settings.muted_color | default: 'rgba(255,255,255,0.55)'
  assign section_title = section.settings.section_title
  assign section_subtitle = section.settings.section_subtitle
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_mobile_top = section.settings.padding_mobile_top | default: 48
  assign padding_mobile_bottom = section.settings.padding_mobile_bottom | default: 48
  assign image_ratio = section.settings.image_ratio | default: '3-4'
-%}

<section
  class="casa-pdp-show"
  id="casa-pdp-show-{{ section.id }}"
  style="
    --cps-bg: {{ bg_color }};
    --cps-text: {{ text_color }};
    --cps-accent: {{ accent_color }};
    --cps-muted: {{ muted_color }};
    --cps-pt: {{ padding_top }}px;
    --cps-pb: {{ padding_bottom }}px;
    --cps-pt-m: {{ padding_mobile_top }}px;
    --cps-pb-m: {{ padding_mobile_bottom }}px;
  "
>
  <div class="casa-pdp-show__wrap">

    {%- if section_title != blank or section_subtitle != blank -%}
      <div class="casa-pdp-show__header">
        {%- if section_title != blank -%}
          <h2 class="casa-pdp-show__heading">{{ section_title }}</h2>
        {%- endif -%}
        {%- if section_subtitle != blank -%}
          <p class="casa-pdp-show__subheading">{{ section_subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="casa-pdp-show__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'showcase_card' -%}
          {%- liquid
            assign card_icon = block.settings.icon | default: 'star'
            assign card_title = block.settings.title
            assign card_desc = block.settings.description
            assign card_image = block.settings.image
            assign card_link = block.settings.link_url
          -%}

          {%- if card_link != blank -%}
            <a href="{{ card_link }}" class="casa-pdp-show__card casa-pdp-show__card--linked" {{ block.shopify_attributes }}>
          {%- else -%}
            <div class="casa-pdp-show__card" {{ block.shopify_attributes }}>
          {%- endif -%}

            {%- comment -%} Card text content {%- endcomment -%}
            <div class="casa-pdp-show__card-body">
              <div class="casa-pdp-show__card-top">
                <span class="casa-pdp-show__icon" aria-hidden="true">
                  {%- case card_icon -%}
                    {%- when 'mirror' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a8 8 0 0 0-8 8v4a8 8 0 0 0 16 0v-4a8 8 0 0 0-8-8z"/><path d="M9 22h6"/><path d="M12 18v4"/></svg>
                    {%- when 'lightbulb' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z"/></svg>
                    {%- when 'gamepad' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="12" x2="10" y2="12"/><line x1="8" y1="10" x2="8" y2="14"/><line x1="15" y1="13" x2="15.01" y2="13"/><line x1="18" y1="11" x2="18.01" y2="11"/><path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59l-.78 7.8A2 2 0 0 0 3.91 18.5h1.26a2 2 0 0 0 1.65-.87L8.5 15h7l1.68 2.63a2 2 0 0 0 1.65.87h1.26a2 2 0 0 0 1.99-2.11l-.78-7.8A4 4 0 0 0 17.32 5z"/></svg>
                    {%- when 'home' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    {%- when 'bed' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v-2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2"/></svg>
                    {%- when 'sofa' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v3"/><path d="M2 11v5a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v2H6v-2a2 2 0 0 0-4 0z"/><path d="M4 18v2"/><path d="M20 18v2"/></svg>
                    {%- when 'palette' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r="0.5" fill="currentColor"/><circle cx="17.5" cy="10.5" r="0.5" fill="currentColor"/><circle cx="8.5" cy="7.5" r="0.5" fill="currentColor"/><circle cx="6.5" cy="12.5" r="0.5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>
                    {%- when 'zap' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    {%- when 'wifi' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
                    {%- when 'bluetooth' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6.5 6.5 17.5 17.5 12 23 12 1 17.5 6.5 6.5 17.5"/></svg>
                    {%- when 'smartphone' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                    {%- when 'sun' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                    {%- when 'moon' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                    {%- when 'layers' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                    {%- when 'link' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                    {%- when 'eye' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    {%- when 'heart' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                    {%- when 'star' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    {%- when 'sparkles' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.912 5.813a2 2 0 0 0 1.275 1.275L21 12l-5.813 1.912a2 2 0 0 0-1.275 1.275L12 21l-1.912-5.813a2 2 0 0 0-1.275-1.275L3 12l5.813-1.912a2 2 0 0 0 1.275-1.275L12 3z"/><path d="M5 3v4"/><path d="M3 5h4"/><path d="M19 17v4"/><path d="M17 19h4"/></svg>
                    {%- when 'grid' -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                    {%- else -%}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  {%- endcase -%}
                </span>
                {%- if card_title != blank -%}
                  <h3 class="casa-pdp-show__card-title">{{ card_title }}</h3>
                {%- endif -%}
              </div>

              {%- if card_desc != blank -%}
                <p class="casa-pdp-show__card-desc">{{ card_desc }}</p>
              {%- endif -%}
            </div>

            {%- comment -%} Card image {%- endcomment -%}
            {%- if card_image != blank -%}
              <div class="casa-pdp-show__card-media casa-pdp-show__card-media--{{ image_ratio }}">
                <img
                  src="{{ card_image | image_url: width: 800 }}"
                  srcset="
                    {{ card_image | image_url: width: 400 }} 400w,
                    {{ card_image | image_url: width: 600 }} 600w,
                    {{ card_image | image_url: width: 800 }} 800w,
                    {{ card_image | image_url: width: 1000 }} 1000w
                  "
                  sizes="(max-width: 749px) 90vw, (max-width: 1023px) 44vw, 30vw"
                  alt="{{ card_image.alt | escape | default: card_title | escape }}"
                  loading="lazy"
                  width="{{ card_image.width }}"
                  height="{{ card_image.height }}"
                  class="casa-pdp-show__img"
                >
              </div>
            {%- else -%}
              <div class="casa-pdp-show__card-media casa-pdp-show__card-media--{{ image_ratio }} casa-pdp-show__card-media--placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'casa-pdp-show__placeholder-svg' }}
              </div>
            {%- endif -%}

          {%- if card_link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% stylesheet %}
  /* ============================
     Casa PDP Showcase
     ============================ */
  .casa-pdp-show {
    background: var(--cps-bg, var(--casa-ink));
    color: var(--cps-text, #fff);
    padding: var(--cps-pt) 0 var(--cps-pb);
    overflow: hidden;
  }

  .casa-pdp-show__wrap {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* --- Header --- */
  .casa-pdp-show__header {
    text-align: center;
    margin-bottom: 48px;
  }

  .casa-pdp-show__heading {
    font-size: var(--casa-pdp-h2-size, clamp(1.5rem, 2.5vw, 2.25rem));
    font-weight: var(--casa-pdp-h2-weight, 600);
    letter-spacing: var(--casa-pdp-h2-tracking, -0.02em);
    line-height: var(--casa-pdp-h2-line, 1.2);
    margin: 0 0 12px;
    color: var(--cps-text);
  }

  .casa-pdp-show__subheading {
    font-size: clamp(0.875rem, 1.2vw, 1.05rem);
    color: var(--cps-muted);
    margin: 0 auto;
    max-width: 560px;
    line-height: 1.6;
  }

  /* --- Grid --- */
  .casa-pdp-show__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  /* --- Card --- */
  .casa-pdp-show__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .casa-pdp-show__card--linked {
    cursor: pointer;
  }

  .casa-pdp-show__card--linked:hover {
    transform: translateY(-4px);
  }

  .casa-pdp-show__card--linked:hover .casa-pdp-show__img {
    transform: scale(1.04);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.45);
  }

  /* --- Card body --- */
  .casa-pdp-show__card-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0 2px;
  }

  .casa-pdp-show__card-top {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* --- Icon --- */
  .casa-pdp-show__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    color: var(--cps-accent);
  }

  .casa-pdp-show__icon svg {
    width: 24px;
    height: 24px;
    display: block;
  }

  /* --- Title --- */
  .casa-pdp-show__card-title {
    font-size: var(--font-h4--size, 18px);
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    letter-spacing: -0.01em;
    color: var(--cps-text);
  }

  /* --- Description --- */
  .casa-pdp-show__card-desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--cps-muted);
    margin: 0;
    padding: 0 2px;
  }

  /* --- Image --- */
  .casa-pdp-show__card-media {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
  }

  .casa-pdp-show__card-media--3-4 { aspect-ratio: 3 / 4; }
  .casa-pdp-show__card-media--4-3 { aspect-ratio: 4 / 3; }
  .casa-pdp-show__card-media--16-9 { aspect-ratio: 16 / 9; }
  .casa-pdp-show__card-media--1-1 { aspect-ratio: 1 / 1; }

  .casa-pdp-show__img {
    /* height: auto + aspect-ratio: inherit instead of height: 100% — the
       media wrapper's height comes from its own aspect-ratio (four
       merchant-selectable variants), and Safari 26 can fail to resolve a
       %-height against that (the /cart flat-thumbnail class; immune
       pattern from .cart-items__media-image in snippets/cart-products.liquid). */
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: inherit;
    object-fit: cover;
    border-radius: 10px;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.5s ease;
  }

  /* Non-linked cards: hover zoom on image only */
  .casa-pdp-show__card:not(.casa-pdp-show__card--linked):hover .casa-pdp-show__img {
    transform: scale(1.03);
  }

  .casa-pdp-show__card-media--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.06);
  }

  .casa-pdp-show__placeholder-svg {
    width: 60%;
    height: auto;
    opacity: 0.25;
  }

  /* ============================
     Tablet: 2 columns
     ============================ */
  @media (max-width: 1023px) {
    .casa-pdp-show__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
    .casa-pdp-show__header {
      margin-bottom: 36px;
    }
  }

  /* ============================
     Mobile: 1 column
     ============================ */
  @media (max-width: 749px) {
    .casa-pdp-show {
      padding: var(--cps-pt-m) 0 var(--cps-pb-m);
    }
    .casa-pdp-show__wrap {
      padding: 0 16px;
    }
    .casa-pdp-show__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .casa-pdp-show__header {
      margin-bottom: 28px;
    }
    .casa-pdp-show__card-title {
      font-size: var(--font-h5--size, 16px);
    }
    .casa-pdp-show__card-desc {
      font-size: 13px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Showcase Cards",
  "tag": "section",
  "class": "casa-pdp-show-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_hide",
      "label": "Auto-hide when empty",
      "info": "Hides this section when no blocks have a title or image",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "section_title",
      "label": "Section title (use <em>word</em> for italic gradient accent)",
      "default": "Perfect For Every Room"
    },
    {
      "type": "textarea",
      "id": "section_subtitle",
      "label": "Section subtitle",
      "default": "Discover how our mirrors transform any space"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0A0A0F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FAFAF7"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (icons)",
      "default": "#B0C3FA"
    },
    {
      "type": "text",
      "id": "muted_color",
      "label": "Muted text color (rgba ok)",
      "default": "rgba(255,255,255,0.55)"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "3-4", "label": "3:4 (portrait)" },
        { "value": "4-3", "label": "4:3 (landscape)" },
        { "value": "16-9", "label": "16:9 (wide)" },
        { "value": "1-1", "label": "1:1 (square)" }
      ],
      "default": "3-4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 150,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 150,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "showcase_card",
      "name": "Showcase Card",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "mirror", "label": "Mirror" },
