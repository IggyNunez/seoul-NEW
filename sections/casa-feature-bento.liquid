        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Feature Title",
          "info": "Inline rich text. Wrap one keyword in <em>…</em> to apply the brand gradient accent."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "info": "For single-variant cards, use this for the spec/detail line (e.g. dimensions) and turn ON 'Show variant price' below. Currency tokens still auto-replace for bundle / included-list cards: __PRICE__ -> current variant price, __COMPARE_PRICE__ -> compare-at price, __COMPARE_STRIKE__ -> <s>compare price</s>, __SAVINGS__ -> compare minus current. Never hardcode currency."
        },
        {
          "type": "checkbox",
          "id": "show_variant_price",
          "label": "Show variant price under the title",
          "default": false,
          "info": "Renders the CTA variant's price on its own line below the name — now-price in mono, plus a struck was-price when the variant has a compare-at. Use for single-variant cards. Leave OFF for bundle / included-list cards that carry the price inside the description."
        },
        {
          "type": "text",
          "id": "compare_variant_ids",
          "label": "Compare-price: sum of variant IDs (optional)",
          "info": "Comma-separated numeric variant IDs. Their prices are summed for __COMPARE_STRIKE__. Use for bundle cards comparing to 'buying separately'. If blank, the variant's own compare_at_price is used."
        },
        {
          "type": "text",
          "id": "bundle_variant_ids",
          "label": "Bundle add-to-cart: multi-variant IDs (optional)",
          "info": "Comma-separated numeric variant IDs. When set, clicking the CTA adds ALL of them to the cart in one request (separate line items). Price tokens __PRICE__ / __COMPARE_PRICE__ / __COMPARE_STRIKE__ / __SAVINGS__ sum the variant prices. __BUNDLE_COUNT__ resolves to how many variants are in the bundle. Falls back to /cart/<id>:1,<id>:1 URL nav if JS is off. Use for Pair / Trio / Set arrangements."
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position",
          "options": [
