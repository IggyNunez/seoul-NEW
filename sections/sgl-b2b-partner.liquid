{%- comment -%}
  SGL B2B / Partner invitation band for the homepage.
  A quiet "industry door" placed low on the page, after the consumer-facing
  and community content. Links to the dedicated Partner With Us page.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign bg = s.bg_color | default: '#F8EBDA'
  assign text_color = s.text_color | default: '#5E0A02'
  assign accent = s.accent_color | default: '#B0C3FA'
  assign btn_bg = s.button_bg | default: '#5E0A02'
  assign btn_text = s.button_text | default: '#F8EBDA'
-%}

<div
  class="sgl-b2b"
  style="
    --sgl-b2b-bg: {{ bg }};
    --sgl-b2b-text: {{ text_color }};
    --sgl-b2b-accent: {{ accent }};
    --sgl-b2b-btn-bg: {{ btn_bg }};
    --sgl-b2b-btn-text: {{ btn_text }};
    --sgl-b2b-pad-top: {{ s.padding_top | default: 72 }}px;
    --sgl-b2b-pad-bot: {{ s.padding_bottom | default: 72 }}px;
  "
>
  <div class="sgl-b2b__inner">
    {%- if s.eyebrow != blank -%}
      <p class="sgl-b2b__eyebrow">{{ s.eyebrow }}</p>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h2 class="sgl-b2b__heading">{{ s.heading }}</h2>
    {%- endif -%}
    {%- if s.body != blank -%}
      <div class="sgl-b2b__body">{{ s.body }}</div>
    {%- endif -%}
    {%- if s.button_label != blank -%}
      <a class="sgl-b2b__cta" href="{{ s.button_link | default: '/pages/partner' }}">
        {{ s.button_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .sgl-b2b {
    width: 100%;
    background: var(--sgl-b2b-bg, #F8EBDA);
    color: var(--sgl-b2b-text, #5E0A02);
    padding-block: var(--sgl-b2b-pad-top, 72px) var(--sgl-b2b-pad-bot, 72px);
    border-top: 1px solid color-mix(in srgb, var(--sgl-b2b-accent, #B0C3FA) 55%, transparent);
  }
  .sgl-b2b__inner {
    max-width: 760px;
    margin-inline: auto;
    padding-inline: var(--page-margin, 1.5rem);
    text-align: center;
  }
  .sgl-b2b__eyebrow {
    font-family: var(--font-primary--family, 'Roboto Condensed', sans-serif);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--sgl-b2b-accent, #B0C3FA);
    margin: 0 0 0.9rem;
  }
  .sgl-b2b__heading {
    font-family: var(--font-primary--family, 'Roboto Condensed', sans-serif);
    font-weight: 700;
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    line-height: 1.12;
    margin: 0 0 1.1rem;
  }
  .sgl-b2b__body {
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.9;
  }
  .sgl-b2b__body p { margin: 0 0 0.9rem; }
  .sgl-b2b__body p:last-child { margin-bottom: 0; }
  .sgl-b2b__cta {
    display: inline-block;
    margin-top: 1.8rem;
    padding: 0.85rem 2rem;
    background: var(--sgl-b2b-btn-bg, #5E0A02);
    color: var(--sgl-b2b-btn-text, #F8EBDA);
    font-family: var(--font-primary--family, 'Roboto Condensed', sans-serif);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.85rem;
    text-decoration: none;
    border-radius: 999px;
    transition: transform 0.16s ease, opacity 0.16s ease;
  }
  .sgl-b2b__cta:hover { transform: translateY(-2px); opacity: 0.92; }
  @media (max-width: 749px) {
    .sgl-b2b { padding-block: 52px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SGL B2B / Partner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For brands + retailers" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Good Korean beauty deserves the right introduction." },
    {
      "type": "richtext",
      "id": "body",
      "label": "Copy",
      "default": "<p>Seoul Glow Lab works with select Korean beauty brands and U.S. retail partners to help thoughtfully chosen products reach the right audience.</p><p>Our relationships are built differently. We discover brands through our work in Korea, learn directly from the people behind the formulas, and bring that knowledge into the U.S. market through retail, education, and strategic partnerships.</p><p>If you're an indie Korean beauty brand looking for the right U.S. partners, or a retailer looking to discover what's next in Korean skincare, we'd like to hear from you.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Partner with SGL" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F8EBDA" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#5E0A02" },
    { "type": "color", "id": "accent_color", "label": "Eyebrow / accent", "default": "#B0C3FA" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#5E0A02" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#F8EBDA" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [{ "name": "SGL B2B / Partner" }]
}
{% endschema %}
