{% liquid
  assign craft_image = section.settings.craft_image
  assign tunnel_image = section.settings.tunnel_image
  assign optical_video = section.settings.optics_video
  assign product_videos = product.media | where: 'media_type', 'video'
  assign guarantee_url = pages['faq'].url
  assign shipping_url = shop.shipping_policy.url

  if craft_image == blank
    assign craft_image = images['Scene_01_Qview_L_light-off-mirror.webp']
  endif

  if tunnel_image == blank
    assign tunnel_image = images['Casa_Di_Lumo_-_Infinity_OctaMirror-12.jpg']
  endif

  if optical_video == blank
    assign optical_video = product_videos | first
  endif

  if guarantee_url == blank
    assign guarantee_url = '/pages/faq'
  endif

  if shipping_url == blank
    assign shipping_url = '/policies/shipping-policy'
  endif

%}

<div class="casa-v6-proof">
  <div class="casa-v6-proof__inner">
    <casa-optics-v6 data-build="20260921-stable-optics-2">
    <section id="casa-v6-optics" class="casa-v6-optics" aria-labelledby="casa-v6-optics-title-{{ section.id }}">
      <header class="casa-v6-optics__intro">
        <span>{{ section.settings.optics_eyebrow }}</span>
        <h2 id="casa-v6-optics-title-{{ section.id }}">{{ section.settings.optics_heading }}</h2>
      </header>

      <figure class="casa-v6-optics__film" style="--optics-film-ratio: {{ optical_video.aspect_ratio | default: tunnel_image.aspect_ratio | default: 1 }};">
        {% if optical_video != blank %}
          {% liquid
            assign optics_mp4 = optical_video.sources | where: 'format', 'mp4' | sort: 'height'
            assign optics_mobile = optics_mp4 | first
            assign optics_desktop = optics_mp4 | last
            for source in optics_mp4
              if source.height >= 720
                assign optics_desktop = source
                break
              endif
            endfor
            assign optics_mobile_url = optics_mobile.url
            assign optics_desktop_url = optics_desktop.url
            comment
              Liquid exposes only the original MP4 for this legacy media item.
              These smaller renditions are verified in its public product JSON.
              Restrict the override to that media ID so future selections stay dynamic.
            endcomment
            if optical_video.id == 33560009932954
              assign optics_mobile_url = 'https://cdn.shopify.com/videos/c/vp/85534bd822ad46409138cb421f6df8a2/85534bd822ad46409138cb421f6df8a2.SD-480p-1.5Mbps-37798981.mp4'
              assign optics_desktop_url = 'https://cdn.shopify.com/videos/c/vp/85534bd822ad46409138cb421f6df8a2/85534bd822ad46409138cb421f6df8a2.HD-720p-4.5Mbps-37798981.mp4'
            endif
          %}
          <video class="casa-v6-optics__video" controls loop muted playsinline preload="metadata" width="{{ optical_video.preview_image.width }}" height="{{ optical_video.preview_image.height }}" poster="{{ optical_video.preview_image | image_url: width: 1080 }}" aria-label="{{ section.settings.tunnel_caption | escape }}">
            {% if optics_mobile_url != blank %}<source src="{{ optics_mobile_url }}" type="{{ optics_mobile.mime_type }}" media="(max-width: 699px)">{% endif %}
            {% if optics_desktop_url != blank %}<source src="{{ optics_desktop_url }}" type="{{ optics_desktop.mime_type }}">{% endif %}
            {{ optical_video.preview_image | image_url: width: 1080 | image_tag: loading: 'lazy', alt: section.settings.tunnel_alt }}
          </video>
        {% elsif tunnel_image != blank %}
          {{ tunnel_image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 1440px) 736px, (min-width: 900px) 52vw, calc(100vw - 64px)', loading: 'lazy', decoding: 'async', alt: section.settings.tunnel_alt }}
        {% endif %}
        <figcaption>
          <span>{% if optical_video != blank %}{{ section.settings.tunnel_caption }}{% else %}{{ section.settings.optics_proofline }}{% endif %}</span>
          {% if optical_video != blank %}
            <button type="button" class="casa-v6-optics__playback" data-optics-playback data-play-label="{{ 'accessibility.play_video' | t | escape }}" data-pause-label="{{ 'accessibility.pause_video' | t | escape }}" hidden>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path class="casa-v6-optics__play-icon" d="m6 3 11 7-11 7Z"/><path class="casa-v6-optics__pause-icon" d="M5 3h3v14H5zM12 3h3v14h-3z"/></svg>
              <span data-optics-playback-label>{{ 'accessibility.play_video' | t }}</span>
            </button>
          {% endif %}
        </figcaption>
      </figure>

      <div class="casa-v6-optics__story">
        <p class="casa-v6-optics__lead">{{ section.settings.optics_caption }}</p>
        <p class="casa-v6-optics__explanation">{{ section.settings.optics_lede }}</p>
        <p class="casa-v6-optics__proofline">{{ section.settings.optics_proofline }}</p>

        <div class="casa-v6-optics__mechanism">
          <div class="casa-v6-optics__mechanism-body">
            <figure class="casa-v6-optics__profile">
              {% if craft_image != blank %}
                {{ craft_image | image_url: width: 480 | image_tag: widths: '240, 360, 480', sizes: '132px', loading: 'lazy', decoding: 'async', alt: section.settings.craft_alt }}
              {% endif %}
              <figcaption>
                <span>{{ section.settings.optics_frame_label }}</span>
                <strong>{{ section.settings.depth_label }}</strong>
                <small>{{ section.settings.optics_depth_metric }}</small>
              </figcaption>
            </figure>
          </div>
        </div>
      </div>

    </section>
    </casa-optics-v6>

    {% render 'casa-octamirror-layers-v6', instance_id: section.id %}

    <div id="casa-v6-assurance" data-build="20260921-v6-assurance-v7-1">
      {% render 'casa-octa-assurance-v7', blocks: section.blocks, instance_id: section.id %}
    </div>
    {% render 'casa-octa-spaces-v6', goldberg_story: true %}
  </div>
</div>

{% stylesheet %}
  .casa-v6-proof .os-dialog img {
    max-height: min(78dvh, calc(95dvh - 99px));
  }

  .casa-v6-proof {
    --proof-ink: #0a0a0f;
    --proof-muted: #686873;
    --proof-paper: #fafaf7;
    --proof-rule: #e4e2dc;
    --proof-purple: #9333ea;
    --proof-pink: #ec4899;
    --proof-cyan: #06b6d4;
    color: var(--proof-ink);
    background: #fff;
  }

  .casa-v6-proof__inner {
    width: min(100% - 32px, 1440px);
    margin-inline: auto;
  }

  .casa-v6-proof__inner {
    padding-block: clamp(70px, 10vw, 130px);
  }

  .casa-v6-quality {
    display: grid;
    grid-area: quality;
    align-self: start;
    gap: 18px;
    min-width: 0;
    padding-top: 22px;
    border-top: 1px solid rgb(255 255 255 / 0.18);
    color: var(--proof-paper);
    font-family: var(--font-body--family);
  }

  .casa-v6-quality__detail {
    display: grid;
    gap: 6px;
  }

  .casa-v6-quality__detail h3 {
    margin: 0;
    font-size: var(--casa-text-h4);
    font-weight: var(--casa-font-semibold);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .casa-v6-quality__detail p {
    margin: 0;
    color: rgb(255 255 255 / 0.72);
    font-size: max(16px, var(--casa-text-body));
    line-height: 1.5;
  }

  .casa-v6-quality__cta {
    width: fit-content;
    max-width: 100%;
    min-height: 44px;
    white-space: normal;
    text-align: center;
  }

  .casa-v6-quality__cta:focus-visible {
    outline: 3px solid var(--optics-accent);
    outline-offset: 4px;
  }

  casa-optics-v6 { display: block; }

  .casa-v6-optics {
    --optics-accent: color-mix(in srgb, var(--casa-purple, #B0C3FA) 62%, white);
    display: grid;
    grid-template-areas: 'intro' 'film' 'story' 'layers';
    gap: 26px;
    padding: 30px 20px 22px;
    border-radius: 12px;
    color: var(--proof-paper);
    background: var(--proof-ink);
    font-family: var(--font-body--family);
    scroll-margin-top: 48px;
  }

  .casa-v6-optics__intro {
    grid-area: intro;
    min-width: 0;
  }

  .casa-v6-optics__intro > span {
    display: block;
    margin-bottom: 12px;
    color: var(--optics-accent);
    font-size: 10px;
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .casa-v6-optics__intro h2 {
    max-width: none;
    margin: 0;
    color: inherit;
    font-family: var(--font-heading--family);
    font-size: clamp(38px, 8vw, 58px);
    font-weight: var(--font-heading--weight);
    line-height: 1.04;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .casa-v6-optics__intro h2 em {
    display: block;
    color: var(--optics-accent);
    font-style: italic;
  }

  .casa-v6-optics__film {
    grid-area: film;
    align-self: start;
    min-width: 0;
    margin: 0;
  }

  .casa-v6-optics__film > video,
  .casa-v6-optics__film > img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--optics-film-ratio, 1);
    border-radius: 6px;
  }

  .casa-v6-optics__film > figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 52px;
    padding-top: 8px;
    color: rgb(255 255 255 / 0.65);
    font-size: 12px;
    line-height: 1.4;
  }

  .casa-v6-optics__film > figcaption > span {
    max-width: 25ch;
  }

  .casa-v6-optics__playback {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 44px;
    min-height: 44px;
    padding: 0 4px;
    border: 0;
    border-radius: 0;
    color: var(--proof-paper);
    background: transparent;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .casa-v6-optics__playback[hidden],
  .casa-v6-optics__pause-icon,
  .casa-v6-optics__playback[data-playing='true'] .casa-v6-optics__play-icon {
    display: none;
  }

  .casa-v6-optics__playback[data-playing='true'] .casa-v6-optics__pause-icon {
    display: block;
  }

  .casa-v6-optics__playback svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  .casa-v6-optics__playback:hover,
  .casa-v6-optics__mechanism summary:hover {
    color: var(--optics-accent);
  }

  .casa-v6-optics__playback:focus-visible,
  .casa-v6-optics__mechanism summary:focus-visible {
    outline: 2px solid var(--optics-accent);
    outline-offset: 4px;
  }

  .casa-v6-optics__story {
    grid-area: story;
    min-width: 0;
  }

  .casa-v6-optics__lead {
    max-width: 26ch;
    margin: 0;
    color: var(--proof-paper);
    font-size: clamp(21px, 2vw, 26px);
    font-weight: 550;
    line-height: 1.25;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  .casa-v6-optics__explanation {
    max-width: 40ch;
    margin: 14px 0 0;
    color: rgb(255 255 255 / 0.72);
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.6;
  }

  .casa-v6-optics__proofline {
    margin: 20px 0 0;
    color: var(--optics-accent);
    font-size: 12px;
    line-height: 1.5;
  }

  .casa-v6-optics__mechanism {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid rgb(255 255 255 / 0.18);
  }

  .casa-v6-optics__mechanism summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 54px;
    padding: 12px 0;
    color: var(--proof-paper);
    cursor: pointer;
    font-size: 14px;
    line-height: 1.4;
    list-style: none;
  }

  .casa-v6-optics__mechanism summary::-webkit-details-marker { display: none; }
  .casa-v6-optics__mechanism summary > span { color: var(--optics-accent); font-size: 22px; }
  .casa-v6-optics__mechanism[open] summary > span { transform: rotate(45deg); }

  .casa-v6-optics__mechanism-body > p {
    margin: 4px 0 22px;
    color: rgb(255 255 255 / 0.72);
    font-size: 14px;
    line-height: 1.6;
  }

  .casa-v6-optics__profile {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 0 0 10px;
  }

  .casa-v6-optics__profile img {
    display: block;
    width: 36%;
    max-width: 132px;
    height: auto;
    border-radius: 4px;
  }

  .casa-v6-optics__profile figcaption {
    display: grid;
    gap: 7px;
    min-width: 0;
  }

  .casa-v6-optics__profile figcaption > span {
    color: rgb(255 255 255 / 0.6);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .casa-v6-optics__profile strong {
    color: var(--proof-paper);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
  }

  .casa-v6-optics__profile small {
    color: rgb(255 255 255 / 0.65);
    font-size: 12px;
    line-height: 1.5;
  }

  .casa-v6-assurance__head > span {
    display: block;
    margin-bottom: 12px;
    color: var(--proof-purple);
    font: 500 11px/1.4 var(--font-mono--family, 'JetBrains Mono', ui-monospace, monospace);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (min-width: 600px) {
    .casa-v6-optics {
      gap: 32px;
      padding: 40px;
    }

    .casa-v6-optics__intro h2 { max-width: none; }

    .casa-v6-optics__film > figcaption > span { max-width: none; }
  }

  @media (min-width: 900px) {
    .casa-v6-optics {
      grid-template-columns: minmax(0, min(54vw, 62svh)) minmax(0, 1fr);
      grid-template-areas: 'film intro' 'film story' 'layers layers';
      grid-template-rows: auto 1fr auto;
      column-gap: clamp(36px, 5vw, 72px);
      row-gap: 28px;
      padding: clamp(36px, 4vw, 56px);
      max-width: 1280px;
      margin-inline: auto;
    }

    .casa-v6-optics__intro { align-self: end; }

    .casa-v6-optics__intro h2 {
      max-width: 12ch;
      font-size: clamp(42px, 4.6vw, 64px);
    }

    .casa-v6-optics__story { align-self: start; }
  }

  .casa-v6-assurance {
    --proof-muted: #54545c;
    display: grid;
    grid-template-columns: minmax(250px, 0.58fr) minmax(0, 1.42fr);
    gap: clamp(34px, 5vw, 76px);
    align-items: start;
    margin-top: clamp(56px, 8vw, 96px);
    padding: clamp(28px, 4vw, 56px);
    border: 1px solid var(--proof-rule);
    border-radius: 24px;
    background: var(--proof-paper);
    font-family: var(--font-body--family, 'Inter', sans-serif);
  }

  casa-assurance-v6 { display: block; }

  .casa-v6-assurance__head h2 {
    max-width: 16ch;
    margin: 0;
    color: var(--proof-ink);
    font-family: var(--font-heading--family, 'Inter', sans-serif);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .casa-v6-assurance__head h2 em {
    color: var(--proof-purple);
    font-style: normal;
  }

  .casa-v6-assurance__head > p {
    max-width: 36ch;
    margin: 16px 0 0;
    color: var(--proof-muted);
    font-size: 16px;
    line-height: 1.55;
  }

  .casa-v6-assurance__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid var(--proof-rule);
    border-radius: 18px;
    background: #fff;
  }

  .casa-v6-assurance__item {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
    padding: clamp(24px, 2.4vw, 34px);
  }

  .casa-v6-assurance__item::before {
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, var(--proof-purple), var(--proof-pink), var(--proof-cyan));
    content: '';
  }

  .casa-v6-assurance__item + .casa-v6-assurance__item {
    border-left: 1px solid var(--proof-rule);
  }

  .casa-v6-assurance__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 20px;
    border: 1px solid rgba(176, 195, 250, 0.15);
    border-radius: 16px;
    color: var(--proof-purple);
    background: linear-gradient(145deg, rgba(176, 195, 250, 0.1), rgba(94, 10, 2, 0.055));
  }

  .casa-v6-assurance__icon svg {
    width: 30px;
    height: 30px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .casa-v6-assurance__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .casa-v6-assurance__value {
    display: block;
    color: var(--proof-purple);
    margin-bottom: 10px;
    font: 500 11px/1.4 var(--font-mono--family, 'JetBrains Mono', ui-monospace, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .casa-v6-assurance__content h3 {
    margin: 0;
    color: var(--proof-ink);
    font-family: var(--font-heading--family, 'Inter', sans-serif);
    font-size: clamp(18px, 1.5vw, 22px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .casa-v6-assurance__content p {
    margin: 11px 0 0;
    color: var(--proof-muted);
    font-size: 16px;
    line-height: 1.55;
  }

  .casa-v6-assurance__action,
  .casa-v6-assurance__policy {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    min-height: 44px;
    margin-top: auto;
    padding-block: 16px 4px;
    color: var(--proof-ink);
    font: 500 14px/1.5 var(--font-body--family, 'Inter', sans-serif);
    letter-spacing: 0;
    text-decoration: underline;
    text-decoration-color: var(--proof-purple);
    text-underline-offset: 4px;
    text-transform: none;
    cursor: pointer;
  }

  .casa-v6-assurance__action > span[aria-hidden],
  .casa-v6-assurance__policy > span[aria-hidden] {
    color: var(--proof-purple);
    font-size: 16px;
  }

  .casa-v6-assurance__details {
    width: 100%;
    margin-top: auto;
  }

  .casa-v6-assurance__details > summary {
    list-style: none;
  }

  .casa-v6-assurance__details > summary::-webkit-details-marker { display: none; }

  .casa-v6-assurance__details[open] .casa-v6-assurance__plus { transform: rotate(45deg); }

  .casa-v6-assurance__details[open] > summary { margin-bottom: 10px; }

  .casa-v6-assurance__answer {
    padding-top: 4px;
    border-top: 1px solid var(--proof-rule);
  }

  .casa-v6-assurance__answer p {
    font-size: 14px;
    line-height: 1.55;
  }

  .casa-v6-assurance__answer p + p { margin-top: 10px; }

  .casa-v6-assurance__policy {
    padding-top: 12px;
    margin-top: 0;
  }

  .casa-v6-assurance :is(a, summary, button, input, textarea):focus-visible {
    outline: 2px solid var(--proof-purple);
    outline-offset: 4px;
  }

  .casa-v6-assurance__contact {
    grid-column: 1 / -1;
    min-width: 0;
    padding-top: 28px;
    border-top: 1px solid var(--proof-rule);
    scroll-margin-top: 130px;
  }

  .casa-v6-assurance__contact[hidden],
  .casa-v6-assurance__close[hidden] { display: none; }

  .casa-v6-assurance__contact-head {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 16px;
    margin-bottom: 24px;
  }

  .casa-v6-assurance__contact-head h3 {
    margin: 0;
    color: var(--proof-ink);
    font: 600 22px/1.2 var(--font-heading--family, 'Inter', sans-serif);
    letter-spacing: -0.01em;
    scroll-margin-top: 130px;
  }

  .casa-v6-assurance__contact-head p {
    margin: 10px 0 0;
    color: var(--proof-muted);
    font-size: 16px;
    line-height: 1.55;
  }

  .casa-v6-assurance__close {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px;
    border: 0;
    background: transparent;
    color: var(--proof-ink);
    font: 500 14px/1.5 var(--font-body--family, 'Inter', sans-serif);
    cursor: pointer;
  }

  .casa-v6-assurance__close span { font-size: 24px; }

  .casa-v6-assurance__form { max-width: 760px; }

  .casa-v6-assurance__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .casa-v6-assurance__field { min-width: 0; }
  .casa-v6-assurance__field--message { grid-column: 1 / -1; }

  .casa-v6-assurance__field label {
    display: block;
    margin-bottom: 8px;
    color: var(--proof-ink);
    font-size: 14px;
    font-weight: 500;
  }

  .casa-v6-assurance__field :is(input, textarea) {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 48px;
    padding: 12px;
    border: 1px solid #c7c7c0;
    border-radius: 10px;
    background: #fff;
    color: var(--proof-ink);
    font: 400 16px/1.5 var(--font-body--family, 'Inter', sans-serif);
  }

  .casa-v6-assurance__field textarea { resize: vertical; }

  .casa-v6-assurance__submit {
    min-height: 48px;
    margin-top: 20px;
    padding: 16px 24px;
    border: 0;
    border-radius: 12px;
    background: var(--proof-ink);
    color: #fff;
    font: 600 14px/1.2 var(--font-body--family, 'Inter', sans-serif);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .casa-v6-assurance__form-status {
    margin: 0 0 20px;
    padding: 16px;
    border: 1px solid var(--proof-purple);
    border-radius: 10px;
    color: var(--proof-ink);
    font-size: 16px;
    line-height: 1.55;
  }

  @media (max-width: 1199px) {
    .casa-v6-assurance { grid-template-columns: minmax(0, 1fr); }

    .casa-v6-assurance__head h2 {
      max-width: 16ch;
    }

  }

  @media (max-width: 749px) {
    .casa-v6-assurance__grid {
      grid-template-columns: minmax(0, 1fr);
    }


    .casa-v6-assurance {
      padding: 24px 12px;
      border-radius: 18px;
    }

    .casa-v6-assurance__item {
      grid-template-columns: 40px minmax(0, 1fr);
      grid-template-rows: auto;
      gap: 12px;
      padding: 24px 16px;
    }

    .casa-v6-assurance__icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      margin: 0;
    }

    .casa-v6-assurance__icon svg {
      width: 24px;
      height: 24px;
    }

    .casa-v6-assurance__item + .casa-v6-assurance__item {
      border-top: 1px solid var(--proof-rule);
      border-left: 0;
    }

    .casa-v6-assurance__item + .casa-v6-assurance__item::before {
      display: block;
    }

    .casa-v6-assurance__item::before {
      inset: 0 auto 0 0;
      width: 3px;
      height: auto;
      background: linear-gradient(180deg, var(--proof-purple), var(--proof-pink), var(--proof-cyan));
    }

    .casa-v6-assurance__action {
      margin-top: 0;
      padding-top: 16px;
    }

    .casa-v6-assurance__fields { grid-template-columns: minmax(0, 1fr); }

  }

  @media (max-width: 600px) {
    .casa-v6-proof__inner {
      width: min(100% - 24px, 1440px);
    }
  }

{% endstylesheet %}

{% javascript %}
  class CasaAssuranceV6 extends HTMLElement {
    connectedCallback() {
      this.abort?.abort();
      this.abort = new AbortController();
      const options = { signal: this.abort.signal };
      this.panel = this.querySelector('[data-assurance-panel]');
      this.triggers = Array.from(this.querySelectorAll('[data-assurance-trigger]'));
      this.form = this.panel?.querySelector('form');
      if (!this.panel || !this.form || !this.triggers.length) return;

      const result = this.panel.querySelector('[data-assurance-result]');
      const returnedToPanel = [this.panel.id, this.form.id].some(id => location.hash === `#${id}`);
      this.setOpen(Boolean(result || returnedToPanel));
      this.querySelector('[data-assurance-close]').hidden = false;
      this.triggers.forEach(trigger => trigger.addEventListener('click', event => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        this.setOpen(true);
        this.syncContext();
        this.panel.querySelector('h3').focus();
      }, options));
      this.querySelector('[data-assurance-close]').addEventListener('click', () => this.closePanel(), options);
      this.panel.addEventListener('keydown', event => {
        if (event.key === 'Escape') {
          event.preventDefault();
          this.closePanel();
        }
      }, options);
      window.addEventListener('hashchange', () => {
        if (location.hash === `#${this.panel.id}`) this.setOpen(true);
      }, options);
      document.addEventListener('variant:update', event => {
        if (String(event.detail?.data?.productId) === this.dataset.productId && event.detail?.resource?.id) {
          this.syncContext(event.detail.resource.id);
        }
      }, options);
      this.form.addEventListener('submit', () => this.syncContext(), { ...options, capture: true });
      this.syncContext();
      if (result) result.focus();
    }

    setOpen(open) {
      this.panel.hidden = !open;
      this.triggers.forEach(trigger => trigger.setAttribute('aria-expanded', String(open)));
    }

    closePanel() {
      this.setOpen(false);
      this.triggers[0].focus();
    }

    syncContext(variantId) {
      const variantInput = this.form.querySelector('[data-assurance-variant]');
      const returnUrl = new URL(location.href);
      const variant = variantId || returnUrl.searchParams.get('variant') || variantInput.value;
      if (variant) returnUrl.searchParams.set('variant', variant);
      returnUrl.searchParams.delete('contact_posted');
      returnUrl.hash = this.panel.id;
      this.form.elements.namedItem('return_to').value = returnUrl.pathname + returnUrl.search + returnUrl.hash;
      variantInput.value = variant;
      const productUrl = new URL(returnUrl.pathname, returnUrl.origin);
      if (variant) productUrl.searchParams.set('variant', variant);
      this.form.querySelector('[data-assurance-product-url]').value = productUrl.href;
    }

    disconnectedCallback() { this.abort?.abort(); }
  }

  if (!customElements.get('casa-assurance-v6')) customElements.define('casa-assurance-v6', CasaAssuranceV6);

  class CasaOpticsV6 extends HTMLElement {
    connectedCallback() {
      this.video = this.querySelector('video');
      this.button = this.querySelector('[data-optics-playback]');
      if (!this.video || !this.button) return;
      this.abort = new AbortController();
      const options = { signal: this.abort.signal };
      this.motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      this.visible = false;
      this.userChoice = null;
      this.playPending = false;
      this.video.controls = false;
      this.video.muted = true;
      this.video.playsInline = true;
      this.button.hidden = false;

      this.button.addEventListener('click', () => {
        this.userChoice = this.video.paused;
        if (!this.observer) this.visible = true;
        this.applyPlayback();
      }, options);
      ['play', 'pause', 'error', 'ended'].forEach((name) => this.video.addEventListener(name, () => this.syncControl(), options));
      document.addEventListener('visibilitychange', () => this.applyPlayback(), options);
      this.motion.addEventListener('change', () => {
        this.userChoice = null;
        this.applyPlayback();
      }, options);
      if ('IntersectionObserver' in window) {
        this.observer = new IntersectionObserver((entries) => {
          const entry = entries[0];
          if (entry.intersectionRatio >= 0.25) this.visible = true;
          else if (!entry.isIntersecting) this.visible = false;
          this.applyPlayback();
        }, { threshold: [0, 0.25] });
        this.observer.observe(this.video);
      }
      const subscribeToOverlays = () => {
        this.unsubscribeOverlay?.();
        this.unsubscribeOverlay = window.casa?.onOverlayToggle?.(() => this.applyPlayback());
      };
      subscribeToOverlays();
      document.addEventListener('DOMContentLoaded', subscribeToOverlays, { ...options, once: true });
      this.syncControl();
    }

    applyPlayback() {
      const permitted = this.userChoice === true || (this.userChoice !== false && !this.motion.matches);
      if (this.visible && !document.hidden && !window.casa?.overlayOpen?.() && permitted) {
        if (!this.video.paused || this.playPending) return;
        this.playPending = true;
        this.video.play().catch(() => this.syncControl()).finally(() => { this.playPending = false; });
      } else if (!this.video.paused) {
        this.video.pause();
      }
    }

    syncControl() {
      const playing = !this.video.paused;
      const label = playing ? this.button.dataset.pauseLabel : this.button.dataset.playLabel;
      this.button.dataset.playing = String(playing);
      this.button.setAttribute('aria-label', label);
      this.button.querySelector('[data-optics-playback-label]').textContent = label;
    }

    disconnectedCallback() {
      this.abort?.abort();
      this.observer?.disconnect();
      this.unsubscribeOverlay?.();
      this.video?.pause();
    }
  }

  if (!customElements.get('casa-optics-v6')) customElements.define('casa-optics-v6', CasaOpticsV6);
{% endjavascript %}

