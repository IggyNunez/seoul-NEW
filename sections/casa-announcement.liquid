        { "value": "shimmer-tri",  "label": "Shimmer (purple → pink → cyan)" },
        { "value": "purple-pink",  "label": "Purple ↔ pink wave" },
        { "value": "sunset",       "label": "Sunset (gold → pink → purple)" },
        { "value": "aurora",       "label": "Aurora (cyan → green → purple)" },
        { "value": "midnight",     "label": "Midnight (deep navy gradient)" },
        { "value": "gold",         "label": "Gold shimmer" },
        { "value": "purple-solid", "label": "Solid purple" },
        { "value": "pink-solid",   "label": "Solid pink" },
        { "value": "cyan-solid",   "label": "Solid cyan" },
        { "value": "ink",          "label": "Solid ink (dark)" },
        { "value": "paper",        "label": "Solid paper (light)" }
      ],
      "default": "shimmer-tri",
      "info": "Used when 'Brand preset' is selected as background source."
    },
    {
      "type": "color",
      "id": "solid_color",
      "label": "Solid color",
      "default": "#B0C3FA",
      "info": "Used when 'Solid color' is selected."
    },
    {
      "type": "color",
      "id": "gradient_color_1",
      "label": "Custom gradient — color 1",
      "default": "#B0C3FA"
    },
    {
      "type": "color",
      "id": "gradient_color_2",
      "label": "Custom gradient — color 2",
      "default": "#5E0A02"
    },
    {
      "type": "color",
      "id": "gradient_color_3",
      "label": "Custom gradient — color 3",
      "default": "#F2FFA0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FAFAF7"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Gradient animation speed",
