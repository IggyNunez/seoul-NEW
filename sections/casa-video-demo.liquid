{% stylesheet %}
/* ══════════════════════════════════════════════════════════════════════════
   CASA VIDEO TESTIMONIALS SECTION
   Horizontal scroll row of portrait video cards + sticky modal
   ══════════════════════════════════════════════════════════════════════════ */

.casa-vtm-section {
  background: var(--cvts-bg, var(--casa-ink));
  color: var(--cvts-text, #ffffff);
  padding: var(--cvts-padding-top) 0 var(--cvts-padding-bottom);
  position: relative;
  overflow: hidden;
}

/* Purple seam bloom — mirrors the footer's top bloom so the color
   at the touching line is identical on both sides. Same 800x400
   centered ellipse, same 12% peak, same 70% falloff as
   .casa-footer::before. */
.casa-vtm-section::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  /* Decorative radial glow — capped at 800px but shrinks to parent
     width on mobile so it never overflows the viewport. */
  width: min(800px, 100%);
  height: 400px;
  background: radial-gradient(ellipse, rgba(176, 195, 250, 0.12) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

/* ── Container ── */
.casa-vtm-section__container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
  position: relative;
  z-index: 1;
}
.casa-vtm-section__container--full {
  max-width: none;
  padding: 0 40px;
}

/* Ultrawide guardrail: the "full" layout stops tracking the viewport past
   1920px so the video rail centers instead of stretching edge-to-edge on
   2560/3440px monitors. The default (page) layout is already capped above. */
@media screen and (min-width: 1920px) {
  .casa-vtm-section__container--full {
    max-width: var(--casa-content-max-w, 1920px);
  }
}

/* ── Header ── */
.casa-vtm-section__header {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 48px;
}

.casa-vtm-section__tag {
  display: inline-block;
  font-size: 12px;
  font-weight: 600;
  color: var(--vtm-accent, #B0C3FA);
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 16px;
}

.casa-vtm-section__title {
  /* Heading scale comes from Theme Settings -> Typography via the
     cvts_heading_level dropdown; fallback uses the brand-locked
     casa-pdp-h2-* tokens so this section's H2 matches every other
     PDP section heading (2026-05-15 cross-section unify). */
  font-size:      var(--cvts-title-fs, var(--casa-pdp-h2-size, clamp(36px, 4.5vw, 56px)));
  font-weight:    var(--cvts-title-fw, var(--casa-pdp-h2-weight, 600));
  line-height:    var(--cvts-title-lh, var(--casa-pdp-h2-line, 1.05));
  letter-spacing: var(--cvts-title-ls, var(--casa-pdp-h2-tracking, -0.02em));
  text-transform: var(--cvts-title-case, none);
  color: var(--cvts-text, #ffffff);
  margin: 0 0 16px 0;
}

/* Italic accent inside title — LARGER (1.15em) per merchant. Italic
   600 weight + brand gradient. line-height: 1 keeps the title row from
   inflating with the bigger em. Matches the sibling section H2 em rule
   (casa-products-grid / casa-brand-story / casa-categories). */
.casa-vtm-section__title em {
  font-size: 1.15em;
  font-style: italic;
  font-weight: 600;
  line-height: 1;
  background-image: var(--grad-text, linear-gradient(90deg, #B0C3FA, #5E0A02, #F2FFA0));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}

/* Accent: optional independent heading scale via cvts_accent_heading_level
   ('inherit' default leaves all properties alone so the title's scale wins). */
.casa-vtm-section__accent {
  font-size: var(--cvts-accent-fs, inherit);
  font-weight: var(--cvts-accent-fw, inherit);
  line-height: var(--cvts-accent-lh, inherit);
  letter-spacing: var(--cvts-accent-ls, inherit);
  text-transform: var(--cvts-accent-case, inherit);
}

/* Accent word styles */
.casa-vtm-section__accent--gradient {
  /* background-image (longhand) keeps background-clip:text working
     -- see casa-brand-tokens Bug 1. */
  background-image: linear-gradient(135deg, var(--cvts-accent-1, #B0C3FA), var(--cvts-accent-2, #5E0A02));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.casa-vtm-section__accent--solid {
  color: var(--cvts-accent-1, #B0C3FA);
}
.casa-vtm-section__accent--underline {
  text-decoration: underline;
  text-decoration-color: var(--cvts-accent-1, #B0C3FA);
  text-underline-offset: 6px;
  text-decoration-thickness: 3px;
}
.casa-vtm-section__accent--glow {
  color: var(--cvts-accent-1, #B0C3FA);
  text-shadow: 0 0 20px var(--cvts-accent-1, #B0C3FA), 0 0 40px rgba(176, 195, 250, 0.3);
}
/* .casa-vtm-section__accent--shimmer: visual handled by .text-grad-shimmer
   brand utility class (assets/casa-buttons.css) — uses --grad-shimmer
   5-stop loop (purple→pink→cyan→pink→purple) per brand book.
   The local @keyframes vtm-shimmer (3-stop ping-pong) is no longer
   used and has been removed. Brand class also provides
   prefers-reduced-motion override. */

.casa-vtm-section__subtitle {
  font-size: 16px;
  color: rgba(255, 255, 255, 0.6);
  margin: 0 auto;
  max-width: 600px;
  line-height: 1.6;
}

/* ══════════════════════════════════════════════════════════════════════════
   VIDEO CARDS ROW
   ══════════════════════════════════════════════════════════════════════════ */

.casa-vtm-section__carousel {
  position: relative;
}

.casa-vtm-section__row {
  display: flex;
  /* Fallback for older browsers — slight start clip when overflowing */
  justify-content: center;
  /* Modern: 'safe center' falls back to start when content overflows,
     preventing the first card from being cut off at scrollLeft=0. */
  justify-content: safe center;
  gap: 16px;
  overflow-x: auto;
  overflow-y: hidden;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 4px;
  scrollbar-width: none;
}
.casa-vtm-section__row::-webkit-scrollbar {
  display: none;
}

/* ── Carousel arrows ── */
.casa-vtm-section__arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 3;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: none;
  background: rgba(255,255,255,0.12);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: var(--casa-text-on-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.2s ease, opacity 0.2s ease;
}
.casa-vtm-section__arrow:hover {
  background: rgba(255,255,255,0.25);
}
.casa-vtm-section__arrow--prev {
  left: -8px;
}
.casa-vtm-section__arrow--next {
  right: -8px;
}

/* Full-width mode — arrows further out */
.casa-vtm-section__container--full .casa-vtm-section__arrow--prev {
  left: 4px;
}
.casa-vtm-section__container--full .casa-vtm-section__arrow--next {
  right: 4px;
}

/* ── Card ── */
.casa-vtm-section__card {
  position: relative;
  flex-shrink: 0;
  width: var(--cvts-card-width, 220px);
  aspect-ratio: 9 / 16;
  border-radius: 14px;
  overflow: hidden;
  cursor: pointer;
  border: none;
  padding: 0;
  background: #1a1a2e;
  scroll-snap-align: start;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.casa-vtm-section__card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 32px rgba(0,0,0,0.3);
}

/* ── Thumbnail ── */
.casa-vtm-section__thumb {
  /* height: auto + aspect-ratio instead of height: 100% — the card's
     height comes from its own aspect-ratio, and Safari 26 can fail to
     resolve a %-height against that (the /cart flat-thumbnail class;
     immune pattern from .cart-items__media-image in snippets/cart-products.liquid). */
  width: 100%;
  height: auto;
  aspect-ratio: 9 / 16;
  object-fit: cover;
  display: block;
}
.casa-vtm-section__thumb--placeholder {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
}

/* ── Play button ── */
.casa-vtm-section__play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(255,255,255,0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--casa-ink);
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  transition: transform 0.2s ease, background 0.2s ease;
  pointer-events: none;
}
.casa-vtm-section__play svg {
  margin-left: 2px; /* optical center for play triangle */
}
.casa-vtm-section__card:hover .casa-vtm-section__play {
  transform: translate(-50%, -50%) scale(1.1);
  background: var(--casa-paper);
}

/* ── Author name ── */
.casa-vtm-section__name {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 28px 10px 10px;
  background: linear-gradient(transparent, rgba(0,0,0,0.65));
  color: var(--casa-text-on-ink);
  font-size: 12px;
  font-weight: 600;
  text-align: left;
  pointer-events: none;
  line-height: 1.3;
}
.casa-vtm-section__caption {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 4px 10px 8px;
  color: rgba(255,255,255,0.7);
  font-size: 10px;
  font-weight: 400;
  text-align: left;
  pointer-events: none;
  line-height: 1.3;
}
.casa-vtm-section__card:has(.casa-vtm-section__caption) .casa-vtm-section__name {
  padding-bottom: 22px;
}
.casa-vtm-section__title-link {
  text-decoration: none;
  color: inherit;
}
.casa-vtm-section__title-link:hover .casa-vtm-section__title {
  opacity: 0.8;
}
.casa-vtm-section__tag--link {
  text-decoration: none;
  transition: opacity 0.2s;
}
.casa-vtm-section__tag--link:hover {
  opacity: 0.7;
}

/* ── Product badge on card ── */
.casa-vtm-section__product-badge {
  position: absolute;
  top: 8px;
  left: 8px;
  right: 8px;
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: var(--casa-text-on-ink);
  font-size: 9px;
  font-weight: 600;
  padding: 3px 6px;
  border-radius: 6px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  pointer-events: none;
  line-height: 1.3;
  opacity: 0;
  transition: opacity 0.2s ease;
}
.casa-vtm-section__card:hover .casa-vtm-section__product-badge {
  opacity: 1;
}

/* ══════════════════════════════════════════════════════════════════════════
   MODAL
   ══════════════════════════════════════════════════════════════════════════ */

.casa-vtm-section__modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
.casa-vtm-section__modal--open {
  opacity: 1;
  pointer-events: auto;
}

/* ── Backdrop ── */
.casa-vtm-section__backdrop {
  position: absolute;
  inset: 0;
  /* No backdrop-filter: this is a full-viewport surface with a VIDEO
     playing above it — the exact stack that dropped the quick-view
     overlay layer for whole frames at 240Hz (535db60f: full-viewport
     blur + an animating layer above it). The player card is opaque, so
     nothing rides on the frost; a deeper dim carries the separation. */
  background: rgba(0, 0, 0, 0.72);
}

/* ── Player card ── */
.casa-vtm-section__player {
  position: relative;
  width: 90vw;
  max-width: 400px;
  aspect-ratio: 9 / 16;
  border-radius: 20px;
  overflow: hidden;
  background: var(--casa-ink);
  box-shadow: 0 24px 64px rgba(0,0,0,0.4);
  z-index: 1;
  transform: scale(0.92);
  transition: transform 0.3s ease;
}
.casa-vtm-section__modal--open .casa-vtm-section__player {
  transform: scale(1);
}

/* ── Video element ── */
.casa-vtm-section__video-wrap {
  width: 100%;
  height: 100%;
}
.casa-vtm-section__video {
  width: 100%;
  height: 100%;
  border: none;
  object-fit: cover;
  display: block;
}

/* ── Close button ── */
.casa-vtm-section__close {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 2;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: none;
  background: rgba(255,255,255,0.15);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: var(--casa-text-on-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.2s ease;
}

/* Modal nav arrows */
.casa-vtm-section__modal-prev,
.casa-vtm-section__modal-next {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 3;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: none;
  background: rgba(255,255,255,0.12);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: var(--casa-text-on-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease;
}
.casa-vtm-section__modal-prev { left: 12px; }
.casa-vtm-section__modal-next { right: 12px; }
.casa-vtm-section__modal-prev:hover,
.casa-vtm-section__modal-next:hover {
  background: rgba(255,255,255,0.25);
}
.casa-vtm-section__modal-prev:disabled,
.casa-vtm-section__modal-next:disabled {
  opacity: 0.3;
  cursor: default;
}
@media (max-width: 749px) {
  .casa-vtm-section__modal-prev,
  .casa-vtm-section__modal-next {
    width: 36px;
    height: 36px;
  }
  .casa-vtm-section__modal-prev { left: 8px; }
  .casa-vtm-section__modal-next { right: 8px; }
}

/* Instagram-Story tap zones.
   Cover the left/right halves of the player (with a 64px bottom inset
   to leave the product-link bar tappable, and starting 48px from the
   top to leave the close button untouched). Sit at z-index 1 — BELOW
   close (2), mute (2), product bar (2), and chevron buttons (3), so
   those targeted controls keep winning their hit areas while the rest
   of the half becomes a generous tap target.

   Transparent, no hover, no focus ring (their action is mirrored on
   the visible chevron buttons that DO show focus). On iOS Safari we
   suppress the dark tap-highlight overlay so taps don't flash a gray
   rectangle. */
.casa-vtm-section__tap-zone {
  position: absolute;
  top: 48px;
  bottom: 64px;
  width: 50%;
  z-index: 1;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  user-select: none;
  /* Defensive: keep iOS from emitting synthetic mouse events twice. */
  touch-action: manipulation;
}
.casa-vtm-section__tap-zone--prev { left: 0; }
.casa-vtm-section__tap-zone--next { right: 0; }
/* tabindex=-1 on the button means these can't be keyboard-focused, so
   no `:focus` override is needed — the default browser outline would
   only ever show on a programmatic .focus() call we never make. */
.casa-vtm-section__close:hover {
  background: rgba(255,255,255,0.3);
}

/* ── Mute button ── */
.casa-vtm-section__mute {
  position: absolute;
  bottom: 12px;
  right: 12px;
  z-index: 4;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: none;
  background: rgba(255,255,255,0.15);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: var(--casa-text-on-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.2s ease;
}
.casa-vtm-section__mute:hover {
  background: rgba(255,255,255,0.3);
}

/* ── Product link in modal ── */
.casa-vtm-section__modal-product {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 56px 12px 16px; /* right padding clears the mute button */
  background: linear-gradient(transparent, rgba(0,0,0,0.7));
  color: var(--casa-text-on-ink);
  text-decoration: none;
  font-size: 13px;
  transition: opacity 0.2s ease;
}
.casa-vtm-section__modal-product:hover {
  opacity: 0.85;
}
.casa-vtm-section__modal-product-title {
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
}
.casa-vtm-section__modal-product-cta {
  font-weight: 500;
  flex-shrink: 0;
  margin-left: 12px;
  text-decoration: underline;
  text-underline-offset: 2px;
}

/* ══════════════════════════════════════════════════════════════════════════
   RESPONSIVE
   ══════════════════════════════════════════════════════════════════════════ */

@media (max-width: 768px) {
  .casa-vtm-section {
    padding: var(--cvts-padding-mobile-top) 0 var(--cvts-padding-mobile-bottom);
  }

  .casa-vtm-section__container,
  .casa-vtm-section__container--full {
    padding: 0 16px;
  }

  .casa-vtm-section__header {
    margin-bottom: 32px;
  }

  .casa-vtm-section__tag {
    font-size: 11px;
    margin-bottom: 12px;
  }

  /* Mobile cap. Without this, the title inherits Horizon's H1 token
     (~56px on this site), which makes "Instagram @CasaDiLumo"
     (~21 chars) overflow both edges on phones — was being cut off
     left and right at smaller screen widths. Clamp keeps a strong
     display feel while ensuring the longest word ("@CasaDiLumo",
     11 chars) always fits at every phone width down to 320px.
     The accent inherits the same size so the gradient word matches
     the rest of the title. text-wrap: balance from casa-base.css
     handles where the line break lands. */
  .casa-vtm-section__title {
    font-size: clamp(28px, 7.5vw, 48px);
  }
  .casa-vtm-section__accent,
  .casa-vtm-section__title em {
    /* Same overflow guard as the span accent: "@CasaDiLumo" at 1.15em
       re-breaks the 320px fit the clamp above was sized for. */
    font-size: inherit;
  }

  .casa-vtm-section__subtitle {
    font-size: 14px;
  }

  .casa-vtm-section__row {
    gap: 12px;
  }

  .casa-vtm-section__card {
    width: 140px;
    border-radius: 12px;
  }

  /* Hide carousel arrows on tablet and below — use swipe */
  .casa-vtm-section__arrow {
    display: none !important;
  }

  .casa-vtm-section__play {
    width: 38px;
    height: 38px;
  }
  .casa-vtm-section__play svg {
    width: 16px;
    height: 16px;
  }

  .casa-vtm-section__player {
    width: 92vw;
    max-width: 360px;
    border-radius: 16px;
  }
}

@media (max-width: 480px) {
  .casa-vtm-section__card {
    width: 125px;
    border-radius: 10px;
  }

  .casa-vtm-section__name {
    font-size: 10px;
    padding: 20px 8px 8px;
  }

  .casa-vtm-section__player {
    width: 95vw;
    border-radius: 14px;
  }
}
{% endstylesheet %}
