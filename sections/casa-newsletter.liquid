{%- comment -%}
  Seoul Glow Lab Newsletter Section
  Gradient background with email signup form
{%- endcomment -%}

{%- liquid
  assign _cn_grad_start = section.settings.gradient_start | default: '#B0C3FA'
  assign _cn_grad_end = section.settings.gradient_end | default: '#5E0A02'
  assign _cn_text = section.settings.text_color | default: '#FAFAF7'
  assign _cn_btn_bg = section.settings.btn_bg | default: '#FAFAF7'
  assign _cn_btn_text = section.settings.btn_text | default: '#B0C3FA'
-%}
{%- comment -%}
  Heading-scale dropdown: merchant picks H1-H6 from Theme Settings -> Typography.
{%- endcomment -%}
{%- assign _cn_title_h = section.settings.cn_heading_level | default: 'h1' -%}
<section
  class="casa-newsletter"
  style="
    --cn-padding-top: {{ section.settings.padding_top | default: 80 }}px;
    --cn-padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --cn-gradient-start: {{ _cn_grad_start }};
    --cn-gradient-end: {{ _cn_grad_end }};
    --cn-text: {{ _cn_text }};
    --cn-btn-bg: {{ _cn_btn_bg }};
    --cn-btn-text: {{ _cn_btn_text }};
    --cn-title-fs:   var(--font-{{ _cn_title_h }}--size);
    --cn-title-fw:   var(--font-{{ _cn_title_h }}--weight);
    --cn-title-lh:   var(--font-{{ _cn_title_h }}--line-height);
    --cn-title-ls:   var(--font-{{ _cn_title_h }}--letter-spacing);
    --cn-title-case: var(--font-{{ _cn_title_h }}--case);
  "
>
  <div class="casa-newsletter__content">
    {%- if section.settings.title != blank -%}
      <h2 class="casa-newsletter__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="casa-newsletter__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'casa-newsletter__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="casa-newsletter__success">Thanks for subscribing! Check your inbox for your 10% off code.</p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          type="email"
          name="contact[email]"
          class="casa-newsletter__input"
          placeholder="{{ section.settings.placeholder | default: 'Enter your email address' }}"
          required
          autocomplete="email"
        >
        <button type="submit" class="btn btn-primary-on-dark">
          {{ section.settings.button_text | default: 'SUBSCRIBE' }}
        </button>
        {%- if form.errors -%}
          <p class="casa-newsletter__error">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}

    {%- if section.settings.disclaimer != blank -%}
      <p class="casa-newsletter__disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          <div {{ block.shopify_attributes }}>
            {%- render block -%}
          </div>
        {%- when 'custom-liquid' -%}
          <div {{ block.shopify_attributes }}>
            {{ block.settings.custom_liquid }}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Casa Newsletter",
  "tag": "section",
  "class": "casa-newsletter-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title (use <em>word</em> for italic gradient accent)",
      "default": "Join the <em>Casa Family.</em>"
    },
    {
      "type": "select",
      "id": "cn_heading_level",
      "label": "Title heading scale",
      "info": "Pulls size, weight, line-height, letter-spacing, and case from Theme Settings → Typography.",
      "options": [
        { "value": "h1", "label": "Heading 1" },
        { "value": "h2", "label": "Heading 2" },
        { "value": "h3", "label": "Heading 3" },
        { "value": "h4", "label": "Heading 4" },
        { "value": "h5", "label": "Heading 5" },
        { "value": "h6", "label": "Heading 6" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Get 10% off your first order + exclusive access to new releases"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SUBSCRIBE"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "No spam, unsubscribe anytime."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "gradient_start",
      "label": "Gradient start",
      "default": "#B0C3FA"
    },
    {
      "type": "color",
      "id": "gradient_end",
      "label": "Gradient end",
      "default": "#5E0A02"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FAFAF7"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button background",
      "default": "#FAFAF7"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button text",
      "default": "#B0C3FA"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 20,
      "max": 200,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 20,
      "max": 200,
      "step": 10,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Casa Newsletter"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  /* Override base theme input background for dark newsletter */
  .casa-newsletter__input,
  .casa-newsletter__input:hover,
  .casa-newsletter__input:focus {
    background-color: transparent !important;
    color: var(--cn-text, #ffffff);
  }
  .casa-newsletter__input:focus {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--cn-text, #ffffff) 30%, transparent);
  }
  .casa-newsletter__input:-webkit-autofill,
  .casa-newsletter__input:-webkit-autofill:hover,
  .casa-newsletter__input:-webkit-autofill:focus,
  .casa-newsletter__input:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 1000px #0f0f18 inset !important;
    -webkit-text-fill-color: var(--cn-text, #ffffff) !important;
    transition: background-color 5000s ease-in-out 0s;
    caret-color: var(--cn-text, #ffffff);
  }

.casa-newsletter {
  --cn-padding-top: 80px;
  --cn-padding-bottom: 80px;

  /* Brand v1 — surfaces are Paper or Ink only. Gradient was previously
     the entire surface (purple→pink wash); brand decision is to keep
     that gradient as a small accent on heading <em> instead. The legacy
     gradient_start/gradient_end schema settings remain to preserve any
     stored merchant values, but they no longer affect the surface.
     Adopt --cn-bg with an Ink default; merchant can still override. */
  background: var(--cn-bg, var(--casa-ink));
  text-align: center;
  padding: var(--cn-padding-top) 80px var(--cn-padding-bottom);
  position: relative;
  overflow: hidden;
}

/* Purple seam blooms — mirror the testimonials::after above and the
   footer::before below so the color at both touching lines is
   identical on each side. Same shape/opacity/falloff as the footer's
   existing top glow (800x400 centered ellipse, rgba(176, 195, 250,0.12)
   peak, transparent at 70% radius). */
.casa-newsletter::before,
.casa-newsletter::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 800px;
  height: 400px;
  background: radial-gradient(ellipse, rgba(176, 195, 250, 0.12) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

.casa-newsletter::before { top: 0; }
.casa-newsletter::after  { bottom: 0; }

.casa-newsletter__content {
  max-width: 600px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

.casa-newsletter__title {
  /* Heading scale comes from Theme Settings -> Typography via the
     cn_heading_level dropdown; legacy font-h2 token preserved as fallback. */
  font-size: var(--cn-title-fs, var(--font-h2--size, 42px));
  font-weight: var(--cn-title-fw, 300);
  line-height: var(--cn-title-lh, normal);
  letter-spacing: var(--cn-title-ls, normal);
  text-transform: var(--cn-title-case, none);
  color: var(--cn-text, #ffffff);
  margin: 0 0 16px 0;
}

.casa-newsletter__subtitle {
  font-size: 16px;
  color: color-mix(in srgb, var(--cn-text, #ffffff) 80%, transparent);
  margin: 0 0 32px 0;
}

.casa-newsletter__form {
  display: flex;
  gap: 16px;
  max-width: 500px;
  margin: 0 auto;
}

.casa-newsletter__input {
  flex: 1;
  padding: 14px 20px;
  border: 1px solid color-mix(in srgb, var(--cn-text, #ffffff) 40%, transparent);
  border-radius: 8px;
  font-size: 14px;
  font-family: inherit;
  outline: none;
  background: transparent;
  color: var(--cn-text, #ffffff);
}

.casa-newsletter__input::placeholder {
  color: color-mix(in srgb, var(--cn-text, #ffffff) 60%, transparent);
}

.casa-newsletter__input:focus {
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--cn-text, #ffffff) 30%, transparent);
}


/* .casa-newsletter__btn rules removed 2026-05-09 — submit button now
   uses the brand .btn .btn-primary-on-dark classes from
   assets/casa-buttons.css. The legacy cn_btn_bg / cn_btn_text schema
   settings remain (orphaned data) and can be removed in a follow-up. */

.casa-newsletter__success {
  font-size: 16px;
  color: var(--cn-text, #ffffff);
  font-weight: 500;
  margin: 0;
  padding: 14px 24px;
  background: color-mix(in srgb, var(--cn-text, #ffffff) 15%, transparent);
  border-radius: 8px;
}

.casa-newsletter__error {
  font-size: 13px;
  color: #fecaca;
  margin: 12px 0 0 0;
  text-align: center;
}

.casa-newsletter__disclaimer {
  font-size: 13px;
  color: color-mix(in srgb, var(--cn-text, #ffffff) 70%, transparent);
  margin: 16px 0 0 0;
}

@media (max-width: 600px) {
  .casa-newsletter {
    padding: 60px 20px;
  }

  /* Title font-size handled by Horizon heading tokens. */

  .casa-newsletter__subtitle {
    font-size: 16px;
    margin-bottom: 32px;
  }

  /* Keep form inline on mobile to match Figma */
  .casa-newsletter__form {
    flex-direction: row;
    gap: 10px;
  }

  .casa-newsletter__input {
    flex: 1;
    min-width: 0;
    padding: 12px 16px;
    font-size: 13px;
  }

  .casa-newsletter__btn {
    padding: 12px 20px;
    font-size: 13px;
    white-space: nowrap;
  }
}
{% endstylesheet %}
