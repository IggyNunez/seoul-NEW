{% endschema %}

{% stylesheet %}
/* ══════════════════════════════════════════════════════════════════════════
   CDL STYLED SPACES — Bento gallery grid
   Featured card (2col × 2row) + smaller 4:3 cards
   ══════════════════════════════════════════════════════════════════════════ */

.cdl-spaces {
  /* Brand v1 surface lock fallbacks: Paper bg + Ink text. */
  background: var(--cdls-bg, var(--bg-paper, var(--casa-paper)));
  color: var(--cdls-text, var(--bg-dark, var(--casa-ink)));
  padding: var(--cdls-pt, 100px) 0 var(--cdls-pb, 100px);
}

/* ── Container ── */
.cdl-spaces__container {
  max-width: var(--cdl-spaces-max-w, 100%);
  margin: 0 auto;
  padding: 0 var(--cdl-spaces-px, 24px);
}

/* Ultrawide guardrail: full-width layouts stop tracking the viewport past
   1920px — the featured video/poster hit 3381×1902px (taller than the
   screen itself) at 3440px without this. min() lets narrower presets
   keep winning. Mirrors the same cap in casa-styled-spaces-home.liquid. */
@media (min-width: 1920px) {
  .cdl-spaces__container {
    max-width: min(var(--cdl-spaces-max-w, 100%), var(--casa-content-max-w, 1920px));
  }
}

/* ── Header ── */
.cdl-spaces__header {
  text-align: center;
  margin-bottom: 56px;
}

.cdl-spaces__tag {
  display: inline-block;
  font-size: var(--cdls-tag-size, 12px);
  font-weight: 600;
  color: var(--cdls-tag, #B0C3FA);
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 16px;
}

.cdl-spaces__heading {
  /* Brand book v1 §03 locked H2 spec — Inter 500 / -0.015em / 1.10 LH.
     white-space: nowrap forces single-line per merchant request. */
  font-family: var(--casa-pdp-h2-family, 'Inter', sans-serif);
  font-size: clamp(22px, 4vw, 40px);
  font-weight: 500;
  line-height: 1.10;
  letter-spacing: -0.015em;
  text-transform: none;
  color: var(--cdls-text, var(--casa-ink));
  margin: 0 0 16px 0;
  white-space: nowrap;
}

/* Italic accent inside heading — LARGER (1.15em) than surrounding text
   per merchant. Italic + brand gradient. line-height: 1 prevents the
   bigger em from inflating the heading's line-height. */
.cdl-spaces__heading em {
  font-size: 1.15em;
  font-style: italic;
  font-weight: 600;
  line-height: 1;
  background-image: var(--grad-text, linear-gradient(90deg, #B0C3FA, #5E0A02, #F2FFA0));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}

.cdl-spaces__subtitle {
  font-size: var(--cdls-subtitle-size, 16px);
  color: var(--cdls-subtitle, #6b7280);
  max-width: 520px;
  margin: 0 auto;
  line-height: 1.6;
}

/* ══════════════════════════════════════════════════════════════════════════
   BENTO GRID
   Desktop: 3 columns — featured spans 2 col + 2 row (LEFT side)
   ══════════════════════════════════════════════════════════════════════════ */

.cdl-spaces__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  grid-template-rows: auto auto;
  gap: 24px;
}

/* When exactly 4 review tiles exist, the default 3-col bento (featured
   2×2 + 2 stacked right) leaves the 4th card orphaned full-row below
   with empty space to its right. Switch to a clean 2×2 grid for that
   case so all 4 reviews sit as equal social-proof tiles. */
.cdl-spaces__grid:has(> .cdl-spaces__card:nth-child(4):last-child) {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-template-rows: auto;
}
.cdl-spaces__grid:has(> .cdl-spaces__card:nth-child(4):last-child) > .cdl-spaces__card--featured {
  grid-column: span 1;
  grid-row: span 1;
  aspect-ratio: 4 / 3;
}

/* Single-card variant — featured tile alone should fill the row at a real
   aspect ratio instead of collapsing to a 1/3 strip (the default rules size
   the featured card to span 2 of 3 cols + 2 rows, but with no siblings the
   second column-track + second row have no content to anchor against). */
.cdl-spaces__grid:has(> .cdl-spaces__card:nth-child(1):last-child) {
  grid-template-columns: 1fr;
  grid-template-rows: auto;
}
.cdl-spaces__grid:has(> .cdl-spaces__card:nth-child(1):last-child) > .cdl-spaces__card--featured {
  grid-column: 1 / -1;
  grid-row: auto;
  aspect-ratio: 16 / 9;
}

/* ── Card base ── */
.cdl-spaces__card {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  cursor: pointer;
  text-decoration: none;
  color: #fff;
  display: block;
  aspect-ratio: 4 / 3;
  transition: transform 0.35s ease;
}

.cdl-spaces__card:hover {
  transform: scale(1.02);
}

/* No-content cards: no overlay, no hover box */
.cdl-spaces__card--no-content {
  cursor: default;
}
.cdl-spaces__card--no-content:hover {
  transform: scale(1.01);
}

/* ── Featured card: spans 2 col + 2 row ── */
.cdl-spaces__card--featured {
  grid-column: span 2;
  grid-row: span 2;
  aspect-ratio: auto;
}

/* ── Image ── */
.cdl-spaces__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.cdl-spaces__card:hover .cdl-spaces__img {
  transform: scale(1.06);
}

/* Ken Burns removed 2026-05-12 — an infinite transform animation
   on the featured card kept the GPU busy every frame even when
   the section was off-screen, and contributed to choppy scroll
   on mobile. The hover transform: scale(1.06) below still gives
   tactile feedback on interaction; no continuous motion needed. */

/* ── Video background ── */
.cdl-spaces__video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
  transition: transform 0.5s ease;
}

/* Belt-and-suspenders: if a device blocks muted autoplay (Low Power Mode,
   reduced-data) the video stays paused and iOS would paint its native centre
   play button on this decorative media. Suppress the WebKit media-control
   pseudo-elements so the poster image is the clean fallback, never a stray
   button. ONE RULE PER PSEUDO-ELEMENT — a comma-grouped list is dropped in
   its entirety by any selector the engine doesn't recognise, and
   `-overlay-play-button` (Chromium-only) would otherwise poison the iOS-only
   `-start-playback-button` rule. */
.cdl-spaces__video::-webkit-media-controls {
  display: none !important;
  -webkit-appearance: none;
  appearance: none;
}
.cdl-spaces__video::-webkit-media-controls-enclosure { display: none !important; }
.cdl-spaces__video::-webkit-media-controls-panel { display: none !important; }
.cdl-spaces__video::-webkit-media-controls-play-button { display: none !important; }
.cdl-spaces__video::-webkit-media-controls-start-playback-button {
  display: none !important;
  -webkit-appearance: none;
  appearance: none;
}
.cdl-spaces__video::-webkit-media-controls-overlay-play-button { display: none !important; }

.cdl-spaces__card:hover .cdl-spaces__video {
  transform: scale(1.06);
}

/* When a video is present, hide the poster image once video loads */
.cdl-spaces__img--poster {
  z-index: 0;
}

.cdl-spaces__card--has-video .cdl-spaces__img--poster {
  opacity: 1;
  transition: opacity 0.6s ease;
}

/* ── Overlay gradient ── */
.cdl-spaces__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, transparent 60%);
  pointer-events: none;
}

/* ── Card content (bottom-left) ── */
.cdl-spaces__card-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
  padding: 24px;
}

/* ── Review meta: stars + VERIFIED PURCHASE eyebrow ── */
.cdl-spaces__review-meta {
  display: flex;
  align-items: center;
  gap: 10px;
}
.cdl-spaces__stars {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  color: #F5C518;
  filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.5));
}
.cdl-spaces__stars svg { display: block; }
.cdl-spaces__verified {
  font-family: 'JetBrains Mono', 'SF Mono', Menlo, monospace;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.14em;
  color: rgba(255, 255, 255, 0.85);
  text-transform: uppercase;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  will-change: backdrop-filter; /* GPU layer: avoid per-frame re-blur (perf, 2026-05-17 flicker-fix pattern) */
  padding: 4px 8px;
  border-radius: 4px;
  border: 1px solid rgba(255, 255, 255, 0.12);
}

/* ── Label — BRAND-INK PILL ──
   Brand-Ink gradient tint matches the drawer / megamenu system
   visually, but uses a much lighter blur kernel than the drawer
   itself (blur 8 vs blur 72) — six labels on screen simultaneously
   makes wide-blur backdrop-filter a serious GPU cost during
   scroll. Hairline brand-gradient accent at the top of the pill
   does the "brand moment" lifting that blur otherwise would. */
.cdl-spaces__label {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 0;
  /* Brand-Ink gradient — same color hits the eye as the drawer */
  background: linear-gradient(180deg, rgba(20, 20, 28, 0.78) 0%, rgba(10, 10, 15, 0.84) 100%);
  /* Light blur only — was blur(20) + saturate(160%) which is ~3×
     the GPU cost of this and accounted for the visible scroll
     judder. */
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  will-change: backdrop-filter; /* GPU layer: avoid per-frame re-blur (perf, 2026-05-17 flicker-fix pattern) */
  padding: 12px 20px;
  border-radius: 12px;
  color: var(--cdls-card-text, var(--casa-paper));
  font-size: var(--cdls-card-title-size, 16px);
  font-weight: 500;
  letter-spacing: -0.01em;
  /* Only transition the cheap properties — no shadow/transform
     transitions on every label so paint stays light. */
  transition: background 0.3s ease;
  white-space: nowrap;
  border: 1px solid rgba(255, 255, 255, 0.06);
  overflow: hidden;
}
/* Brand-gradient hairline at the top edge of the pill — at rest
   it's faint (0.25), on hover the full purple → pink → cyan rises
   to 1.0 so the pill feels "lit." */
.cdl-spaces__label::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, #B0C3FA, #5E0A02, #F2FFA0);
  opacity: 0.25;
  transition: opacity 0.3s ease;
  pointer-events: none;
}
.cdl-spaces__label-text { display: inline-block; }
.cdl-spaces__label-arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 0;
  margin-left: 0;
  opacity: 0;
  overflow: hidden;
  transform: translateX(-4px);
  /* perf-justified: width/margin transition fires only on :hover of
     a single card, bounded layout cost; transform alternative would
     leave the resting pill 24px wider with an invisible chevron in
     its layout slot, which we don't want visually. */
  transition: width 0.3s ease, margin-left 0.3s ease, opacity 0.3s ease, transform 0.3s ease;
  color: inherit;
}

.cdl-spaces__card:hover .cdl-spaces__label {
  /* Hover state stays in the brand-Ink family — a touch lighter
     with a slight purple bias. Background shift only; no shadow
     or transform on the label itself (the .cdl-spaces__card
     hover already scales the image, which gives the tactile
     feedback). Keeps hover paint cost minimal. */
  background: linear-gradient(180deg, rgba(28, 24, 42, 0.82) 0%, rgba(20, 14, 32, 0.86) 100%);
}
.cdl-spaces__card:hover .cdl-spaces__label::before {
  opacity: 1;
}
.cdl-spaces__card:hover .cdl-spaces__label-arrow {
  width: 14px;
  margin-left: 10px;
  opacity: 1;
  transform: translateX(0);
}

@media (prefers-reduced-motion: reduce) {
  .cdl-spaces__label,
  .cdl-spaces__label-arrow {
    transition: none;
  }
}

/* Touch devices have no :hover state, so the chevron slide-in
   would never fire and the affordance ("this card is tappable")
   would be invisible. On touch, show a small static chevron at
   rest so users know the card drills in. */
@media (hover: none) {
  .cdl-spaces__label-arrow {
    width: 12px;
    margin-left: 8px;
    opacity: 0.7;
    transform: translateX(0);
  }
  .cdl-spaces__card:active .cdl-spaces__label-arrow {
    opacity: 1;
  }
}

/* ── Caption (shown on featured or hover) ──
   Lives next to the label pill. The label is the loud chrome (Brand-Ink
   pill, full opacity); the caption is the quiet chrome — half the
   darkness and blur of the label so it reads as secondary, but still
   has enough plate to clear 4.5:1 contrast against any image. */
.cdl-spaces__caption {
  font-size: var(--cdls-card-subtitle-size, 13px);
  color: var(--cdls-card-subtitle, rgba(255, 255, 255, 0.96));
  font-weight: 500;
  letter-spacing: -0.005em;
  /* Quieter than .cdl-spaces__label — 0.55 alpha + blur(6) vs the
     label's ~0.8 alpha + blur(8). Matches the label's Ink family
     without competing with it. */
  background: rgba(10, 10, 15, 0.55);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  will-change: backdrop-filter; /* GPU layer: avoid per-frame re-blur (perf, 2026-05-17 flicker-fix pattern) */
  padding: 6px 10px;
  border-radius: 8px;
  /* Belt-and-suspenders for browsers without backdrop-filter — the
     plate alone is enough, but a tight shadow keeps glyphs crisp on
     extreme HDR backdrops too. */
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.cdl-spaces__card:hover .cdl-spaces__caption {
  opacity: 1;
  transform: translateY(0);
}

.cdl-spaces__card--featured .cdl-spaces__caption {
  opacity: 1;
  transform: none;
}

/* Touch devices have no :hover state, so the caption would never appear.
   Show it at rest on touch — same treatment as .cdl-spaces__label-arrow
   above (the existing chevron-on-touch override). */
@media (hover: none) {
  .cdl-spaces__caption {
    opacity: 1;
    transform: none;
  }
}

/* ── Fallback gradient backgrounds ── */
.cdl-spaces__card:nth-child(1) { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); }
.cdl-spaces__card:nth-child(2) { background: linear-gradient(135deg, #2d132c 0%, #801336 50%, #c72c41 100%); }
.cdl-spaces__card:nth-child(3) { background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 50%, #3d3d3d 100%); }
.cdl-spaces__card:nth-child(4) { background: linear-gradient(135deg, #0d7377 0%, #14a3a8 50%, #32e0c4 100%); }
.cdl-spaces__card:nth-child(5) { background: linear-gradient(135deg, #4a1942 0%, #6b2d5c 50%, #893168 100%); }
.cdl-spaces__card:nth-child(6) { background: linear-gradient(135deg, #1e3c72 0%, #2a5298 50%, #3a7bd5 100%); }

/* ══════════════════════════════════════════════════════════════════════════
   RESPONSIVE — Tablet
   ══════════════════════════════════════════════════════════════════════════ */

@media (max-width: 1024px) {
  .cdl-spaces__container {
    padding: 0 24px;
  }

  .cdl-spaces__grid {
    gap: 16px;
  }

  .cdl-spaces__label {
    font-size: 14px;
    padding: 10px 18px;
  }

  .cdl-spaces__card-content {
    padding: 20px;
  }
}

/* ══════════════════════════════════════════════════════════════════════════
   RESPONSIVE — Mobile
   ══════════════════════════════════════════════════════════════════════════ */

@media (max-width: 768px) {
  .cdl-spaces {
    padding: var(--cdls-mpt, 60px) 0 var(--cdls-mpb, 60px);
  }

  .cdl-spaces__container {
    padding: 0 16px;
  }

  .cdl-spaces__header {
    margin-bottom: 32px;
  }

  /* Mobile: scaled down so "In their rooms." + "Step into the studio."
     both stay on one line. white-space: nowrap inherited from base. */
  .cdl-spaces__heading {
    font-size: clamp(14px, 4.5vw, 22px);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .cdl-spaces__heading em {
    font-size: 1.15em;
  }

  .cdl-spaces__tag {
    font-size: var(--cdls-tag-size, 11px);
    margin-bottom: 12px;
  }

  .cdl-spaces__subtitle {
    font-size: var(--casa-subtitle-size, 14px);
  }

  /* Mobile grid: featured full-width 16:9, rest 2-col squares */
  .cdl-spaces__grid {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto;
    gap: 8px;
  }

  .cdl-spaces__card {
    border-radius: 12px;
    aspect-ratio: 1 / 1;
  }

  .cdl-spaces__card--featured {
    grid-column: 1 / -1;
    grid-row: auto;
    aspect-ratio: 16 / 9;
  }

  .cdl-spaces__card-content {
    padding: 12px;
  }

  /* On mobile: move chips to TOP of photo instead of bottom + flip the
     overlay gradient to top-down. Most Casa product photos shoot the
     product in the lower half of the frame (cube on console, mushroom
     on nightstand), so bottom-anchored chips covered the product.
     Top-anchored chips keep the product zone fully visible. */
  .cdl-spaces__card-content {
    top: 0;
    bottom: auto;
    align-items: flex-start;
  }
  .cdl-spaces__overlay {
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.45) 0%, transparent 35%);
  }

  .cdl-spaces__label {
    /* Hard cap at 13px on mobile via min() — beats any merchant
       value above 13. clamp lower bound at 11px protects against
       hostile settings. Below 768px the merchant variable can
       still SHRINK the text (down to 11px) but never grow it past
       13px. This was the bug: the schema default of 18px got
       baked into settings_data.json so even a fresh install came
       in oversized. */
    font-size: clamp(11px, min(var(--cdls-card-title-size-m, 13px), 13px), 13px);
    font-weight: 500;
    padding: 6px 12px;
    border-radius: 6px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    will-change: backdrop-filter; /* GPU layer: avoid per-frame re-blur (perf, 2026-05-17 flicker-fix pattern) */
  }
  .cdl-spaces__caption {
    /* Same cap pattern for subtitle */
    font-size: clamp(10px, min(var(--cdls-card-subtitle-size-m, 12px), 12px), 12px);
  }
  /* Mobile chevron a touch smaller to match the smaller pill */
  .cdl-spaces__card:hover .cdl-spaces__label-arrow,
  .cdl-spaces__card:active .cdl-spaces__label-arrow {
    width: 12px;
    margin-left: 8px;
  }

  .cdl-spaces__caption {
    font-size: var(--cdls-card-subtitle-size-m, 14px);
  }

  /* When last card should span full-width (odd count) */
  .cdl-spaces__grid--last-wide > .cdl-spaces__card:last-child:not(.cdl-spaces__card--featured) {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }
}

@media (max-width: 480px) {
  .cdl-spaces__card-content {
    padding: 10px;
  }

  .cdl-spaces__label {
    padding: 5px 10px;
  }
}
{% endstylesheet %}
