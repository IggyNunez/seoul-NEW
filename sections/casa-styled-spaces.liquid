  ],
  "presets": [
    {
      "name": "Casa Styled Spaces",
      "blocks": [
        { "type": "space", "settings": { "title": "Gaming Setup", "caption": "Immersive RGB ambiance" } },
        { "type": "space", "settings": { "title": "Living Room", "caption": "Elegant centerpiece" } },
        { "type": "space", "settings": { "title": "Home Office", "caption": "Focus & style" } },
        { "type": "space", "settings": { "title": "Bedroom", "caption": "Ambient relaxation" } },
        { "type": "space", "settings": { "title": "Entertainment Room", "caption": "Ultimate vibes" } },
        { "type": "space", "settings": { "title": "Studio Apartment", "caption": "Space-saving glow" } }
