{%- comment -%}
  Seoul Glow Lab - Styled Spaces Gallery
  Bento grid: first card featured (spans 2 col + 2 row), remaining 4/3 aspect cards
  Conversion section — shows product in real room settings
{%- endcomment -%}

{%- comment -%} Auto-hide when no spaces have images {%- endcomment -%}
{%- assign _has_content = false -%}
{%- for block in section.blocks -%}
  {%- if block.settings.image != blank or block.settings.title != blank -%}
    {%- assign _has_content = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if _has_content == false and request.design_mode == false -%}
  <style>#shopify-section-{{ section.id }} { display: none !important; }</style>
{%- endif -%}

{%- liquid
  assign s = section.settings
  assign tag_text  = s.tag_text
  assign heading   = s.heading
  assign subtitle  = s.subtitle

  assign bg_color   = s.bg_color | default: '#FAFAF7'
  assign text_color = s.text_color | default: '#0A0A0F'
  assign tag_color  = s.tag_color | default: '#B0C3FA'
  assign subtitle_color = s.subtitle_color | default: '#6b7280'

  assign mobile_last_card = s.mobile_last_card | default: 'auto'

  assign padding_top          = s.padding_top | default: 100
  assign padding_bottom       = s.padding_bottom | default: 100
  assign padding_mobile_top   = s.padding_mobile_top | default: 60
  assign padding_mobile_bottom = s.padding_mobile_bottom | default: 60
-%}

<section
  class="cdl-spaces"
  id="cdl-spaces-{{ section.id }}"
  style="
    --cdls-bg: {{ bg_color }};
    --cdls-text: {{ text_color }};
    --cdls-pt: {{ padding_top }}px;
    --cdls-pb: {{ padding_bottom }}px;
    --cdls-tag: {{ tag_color }};
    --cdls-subtitle: {{ subtitle_color }};
    --cdls-mpt: {{ padding_mobile_top }}px;
    --cdls-mpb: {{ padding_mobile_bottom }}px;
    --cdls-tag-size: {{ section.settings.tag_size | default: 12 }}px;
    --cdls-subtitle-size: {{ section.settings.subtitle_size | default: 16 }}px;
    --cdls-card-title-size: {{ section.settings.card_title_size | default: 16 }}px;
    {%- comment -%}
      Mobile default lowered from 18px → 13px on 2026-05-12. The
      old default was larger than desktop (18 vs 16), which made
      the pill dominate narrow 2-up cards on mobile and pushed long
      titles like "Studio Apartment" toward overflow. 13px scales
      proportionally to the smaller cards.
    {%- endcomment -%}
    --cdls-card-title-size-m: {{ section.settings.card_title_size_mobile | default: 13 }}px;
    --cdls-card-subtitle-size: {{ section.settings.card_subtitle_size | default: 13 }}px;
    --cdls-card-subtitle-size-m: {{ section.settings.card_subtitle_size_mobile | default: 12 }}px;
    --cdls-card-text: {{ section.settings.card_text_color | default: '#FAFAF7' }};
    {%- if section.settings.card_subtitle_color != blank %}--cdls-card-subtitle: {{ section.settings.card_subtitle_color }};{% endif -%}
    {%- comment -%}
      Heading typography is brand-locked to the --casa-pdp-h2-* tokens
      defined in assets/casa-base.css. The legacy cdls_heading_level
      dropdown emitted theme-typography vars which diverged per-theme
      and broke heading parity with adjacent PDP sections (casa-stats-grid,
      casa-sizing). Per memory `brand_typography_locked_2026-05-04.md`.
      Merchants who genuinely need a different size override via theme CSS.
    {%- endcomment -%}
    --cdl-spaces-max-w: {% case section.settings.section_width %}{% when 'full' %}100%{% when 'wide' %}1600px{% when 'narrow' %}1200px{% else %}1400px{% endcase %};
    --cdl-spaces-px: {% if section.settings.section_width == 'full' %}24px{% else %}40px{% endif %};
  "
>
  <div class="cdl-spaces__container">
    {%- comment -%} Header {%- endcomment -%}
    <div class="cdl-spaces__header">
      {%- if tag_text != blank -%}
        <span class="cdl-spaces__tag">{{ tag_text }}</span>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="cdl-spaces__heading">{{ heading }}</h2>
      {%- endif -%}
      {%- if subtitle != blank -%}
        <p class="cdl-spaces__subtitle">{{ subtitle }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} Bento Grid {%- endcomment -%}
    {%- liquid
      assign non_featured_count = 0
      for block in section.blocks
        unless forloop.first
          if block.type == 'space'
            assign non_featured_count = non_featured_count | plus: 1
          endif
        endunless
      endfor
      assign is_odd = non_featured_count | modulo: 2
      assign show_last_wide = false
      if mobile_last_card == 'wide'
        assign show_last_wide = true
      elsif mobile_last_card == 'auto' and is_odd == 1
        assign show_last_wide = true
      endif
    -%}
    <div class="cdl-spaces__grid{% if show_last_wide %} cdl-spaces__grid--last-wide{% endif %}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'space' -%}
            {%- liquid
              assign has_hosted_video = false
              assign has_ext_video = false
              if block.settings.video != blank
                assign has_hosted_video = true
              endif
              if block.settings.video_url != blank
                assign has_ext_video = true
              endif
            -%}
            {%- assign _has_link = false -%}
            {%- if block.settings.link != blank -%}{%- assign _has_link = true -%}{%- endif -%}
            {%- assign _has_content = false -%}
            {%- if block.settings.title != blank or block.settings.caption != blank -%}{%- assign _has_content = true -%}{%- endif -%}
            {%- capture _card_class -%}cdl-spaces__card{% if forloop.first %} cdl-spaces__card--featured{% endif %}{% if has_hosted_video or has_ext_video %} cdl-spaces__card--has-video{% endif %}{% unless _has_content %} cdl-spaces__card--no-content{% endunless %}{%- endcapture -%}
            {%- if _has_link -%}
              <a href="{{ block.settings.link }}" class="{{ _card_class }}" {{ block.shopify_attributes }}>
            {%- else -%}
              <div class="{{ _card_class }}" {{ block.shopify_attributes }}>
            {%- endif -%}
              {%- comment -%}
                Video background (Shopify-hosted takes priority).
                Lazy-loaded: no src on the element initially — only data-src.
                JS swaps data-src → src + calls .load() + .play() when the
                section approaches the viewport (rootMargin: 200px). Cuts
                ~6.3 MB of HLS chunks from cold homepage loads for users
                who bounce before reaching this section.
                Poster attribute dropped: sibling .cdl-spaces__img--poster
                already covers the video at higher z-index, so the video's
                own poster= would have been a duplicate fetch.
              {%- endcomment -%}
              {%- comment -%}
                Per-block focal point — applied to both image and
                video via inline `object-position`. Lets the
                merchant keep the product in the visible band of a
                cover-cropped card (e.g. Floor Lamps card was cropping
                out the actual lamp; setting focal_y=80% pulls the
                bottom of the image into view).
              {%- endcomment -%}
              {%- assign _fx = block.settings.focal_x | default: 50 -%}
              {%- assign _fy = block.settings.focal_y | default: 50 -%}
              {%- assign _focal_style = 'object-position: ' | append: _fx | append: '% ' | append: _fy | append: '%;' -%}

              {%- if has_hosted_video -%}
                <video
                  class="cdl-spaces__video"
                  data-casa-pause
                  loop
                  muted
                  playsinline
                  preload="none"
                  style="{{ _focal_style }}"
                >
                  {%- comment -%} MP4 only — never the .m3u8: Safari would pick
                    the HLS stream and pay its adaptive-decode pipeline for a
                    looping bg video (the homepage scroll jitter). Same fix as
                    casa-video-demo.liquid. {%- endcomment -%}
                  {%- for source in block.settings.video.sources -%}
                    {%- if source.mime_type == 'video/mp4' -%}
                      <source data-src="{{ source.url }}" type="video/mp4">
                    {%- endif -%}
                  {%- endfor -%}
                </video>
              {%- elsif has_ext_video -%}
                <video
                  class="cdl-spaces__video"
                  data-casa-pause
                  data-src="{{ block.settings.video_url | escape }}"
                  loop
                  muted
                  playsinline
                  preload="none"
                  style="{{ _focal_style }}"
                ></video>
              {%- endif -%}

              {%- comment -%} Image background (fallback when no video, or poster for video) {%- endcomment -%}
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 1400 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 600 }} 600w,
                    {{ block.settings.image | image_url: width: 900 }} 900w,
                    {{ block.settings.image | image_url: width: 1400 }} 1400w
                  "
                  sizes="{% if forloop.first %}(max-width: 768px) 100vw, 66vw{% else %}(max-width: 768px) 50vw, 33vw{% endif %}"
                  alt="{{ block.settings.title | escape }}"
                  class="cdl-spaces__img{% if has_hosted_video or has_ext_video %} cdl-spaces__img--poster{% endif %}"
                  loading="lazy"
                  width="700"
                  height="525"
                  style="{{ _focal_style }}"
                >
              {%- endif -%}
              {%- if _has_content -%}
                <div class="cdl-spaces__overlay"></div>
                <div class="cdl-spaces__card-content">
                  {%- comment -%}
                    Review-chrome row: 5-star rating + VERIFIED PURCHASE
                    eyebrow tag. Intentional on PDP instances of this
                    section (where each tile caption IS a real customer
                    quote tied to a specific product). Hidden on the
                    homepage — the homepage tiles use category-name
                    captions (e.g. "Home Decor"), not testimonials, so
                    the chrome reads as fabricated social proof and
                    violates Casa's no-fabricated-claims rule.
                  {%- endcomment -%}
                  {%- if template.name != 'index' -%}
                  <div class="cdl-spaces__review-meta" aria-hidden="true">
                    <span class="cdl-spaces__stars">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    </span>
                    <span class="cdl-spaces__verified">VERIFIED PURCHASE</span>
                  </div>
                  {%- endif -%}
                  {%- if block.settings.caption != blank -%}
                    <span class="cdl-spaces__caption">{{ block.settings.caption }}</span>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <span class="cdl-spaces__label">
                      <span class="cdl-spaces__label-text">{{ block.settings.title }}</span>
                      <span class="cdl-spaces__label-arrow" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
                      </span>
                    </span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- if _has_link -%}</a>{%- else -%}</div>{%- endif -%}
          {%- when '@app' -%}
            <div {{ block.shopify_attributes }}>
              {%- render block -%}
            </div>
          {%- when 'custom-liquid' -%}
            <div {{ block.shopify_attributes }}>
              {{ block.settings.custom_liquid }}
            </div>
        {%- endcase -%}
      {%- endfor -%}

      {%- comment -%} Fallback if no blocks {%- endcomment -%}
      {%- if section.blocks.size == 0 -%}
        <div class="cdl-spaces__card cdl-spaces__card--featured">
          <div class="cdl-spaces__overlay"></div>
          <div class="cdl-spaces__card-content">
            <span class="cdl-spaces__label">Gaming Setup</span>
          </div>
        </div>
        <div class="cdl-spaces__card">
          <div class="cdl-spaces__overlay"></div>
          <div class="cdl-spaces__card-content">
            <span class="cdl-spaces__label">Living Room</span>
          </div>
        </div>
        <div class="cdl-spaces__card">
          <div class="cdl-spaces__overlay"></div>
          <div class="cdl-spaces__card-content">
            <span class="cdl-spaces__label">Home Office</span>
          </div>
        </div>
        <div class="cdl-spaces__card">
          <div class="cdl-spaces__overlay"></div>
          <div class="cdl-spaces__card-content">
            <span class="cdl-spaces__label">Bedroom</span>
          </div>
        </div>
        <div class="cdl-spaces__card">
          <div class="cdl-spaces__overlay"></div>
          <div class="cdl-spaces__card-content">
            <span class="cdl-spaces__label">Entertainment Room</span>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
(function() {
  var root = document.getElementById('cdl-spaces-{{ section.id }}');
  if (!root) return;

  /* Save-Data / slow-network / reduced-motion: drop videos entirely.
     The static poster image stays as the fallback — same visual content,
     no degradation. Matches the casa-hero / casa-split-feature pattern. */
  var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var saveData = (navigator.connection && navigator.connection.saveData) === true;
  var slowNet = navigator.connection && /2g|slow-2g/.test(navigator.connection.effectiveType || '');
  if (reducedMotion || saveData || slowNet) {
    root.querySelectorAll('.cdl-spaces__video').forEach(function(v) { v.remove(); });
    return;
  }

  /* Fade out poster image once video starts playing */
  root.querySelectorAll('.cdl-spaces__card--has-video').forEach(function(card) {
    var video = card.querySelector('.cdl-spaces__video');
    var poster = card.querySelector('.cdl-spaces__img--poster');
    if (!video || !poster) return;
    video.addEventListener('playing', function() {
      poster.style.opacity = '0';
    }, { once: true });
  });

  /* Lazy-load: copy data-src → src on first intersection. Cuts ~6.3 MB
     of HLS chunks from cold homepage loads for users who bounce before
     reaching this section. rootMargin 200px gives the video a head start
     before it enters the viewport so playback feels immediate. */
  /* PLAYBACK OWNER: assets/casa-offscreen-pause.js (data-casa-pause on the
     <video>) — plays in view / pauses off-screen from real geometry. This
     script only LAZY-LOADS the bytes: copy data-src → src 200px before the
     section enters view so the buffer gets a head start. The old inline owner
     here had an unguarded deferred retry ('canplay' → play(), {once:true})
     that restarted the video AFTER the off-screen pause when buffering
     finished late — the "keeps playing after you scroll past it" bug. */
  function loadVideo(video) {
    if (video.dataset.casaSpacesLoaded) return;
    video.dataset.casaSpacesLoaded = '1';
    video.muted = true;
    video.defaultMuted = true;
    video.playsInline = true;
    video.setAttribute('muted', '');
    video.setAttribute('playsinline', '');
    video.setAttribute('webkit-playsinline', '');
    if (video.dataset.src && !video.src) {
      video.src = video.dataset.src;
    }
    video.querySelectorAll('source[data-src]').forEach(function(source) {
      if (!source.src) source.src = source.dataset.src;
    });
    /* preload=none would defer the fetch until play(); with the src now
       assigned, auto lets the browser buffer ahead — the point of the
       200px head start. */
    video.preload = 'auto';
    video.load();
    /* The global owner's initial pass ran while this video had no src (its
       play() no-opped); re-gate now that it is loadable. */
    if (window.casa && window.casa.offscreenPauseRefresh) window.casa.offscreenPauseRefresh();
  }

  var observer = null;
  if ('IntersectionObserver' in window) {
    observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          loadVideo(entry.target);
          observer.unobserve(entry.target); /* load once; playback is the global owner's job */
        }
      });
    }, { rootMargin: '200px' });
    root.querySelectorAll('.cdl-spaces__video').forEach(function(v) {
      observer.observe(v);
    });
  } else {
    /* No IntersectionObserver support — fall back to eager load so the
       section still works on ancient browsers. */
    root.querySelectorAll('.cdl-spaces__video').forEach(function(v) {
      loadVideo(v);
    });
  }

  /* Theme-editor cleanup: when the merchant removes/replaces this section
     in the editor, disconnect the observer so it stops referencing
     orphaned video nodes. Production traffic never hits this path. */
  document.addEventListener('shopify:section:unload', function(e) {
    if (e.target && e.target.id === 'shopify-section-{{ section.id }}' && observer) {
      observer.disconnect();
    }
  });
})();
</script>

{% schema %}
{
  "name": "Casa Styled Spaces",
  "tag": "section",
  "class": "cdl-spaces-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "tag_text",
      "label": "Tag",
      "default": "Styled Spaces"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Title",
      "info": "Wrap a phrase in <em>...</em> for the brand italic-gradient accent (e.g. \"In <em>their rooms.</em>\").",
      "default": "In <em>their rooms.</em>"
    },
    {
      "type": "select",
      "id": "cdls_heading_level",
      "label": "Title heading scale",
      "info": "Pulls size, weight, line-height, letter-spacing, and case from Theme Settings → Typography.",
      "options": [
        { "value": "h1", "label": "Heading 1" },
        { "value": "h2", "label": "Heading 2" },
        { "value": "h3", "label": "Heading 3" },
        { "value": "h4", "label": "Heading 4" },
        { "value": "h5", "label": "Heading 5" },
        { "value": "h6", "label": "Heading 6" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle / Description",
      "info": "Supports rich text, lists, links, and dynamic content",
      "default": "<p>See how designers and customers style their Seoul Glow Lab pieces</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FAFAF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0A0A0F"
    },
    {
      "type": "color",
      "id": "tag_color",
      "label": "Tag/accent color",
      "default": "#B0C3FA"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#525252"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "tag_size",
      "label": "Tag font size",
      "min": 8,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle font size (desktop)",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Card title size (desktop)",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_title_size_mobile",
      "label": "Card title size (mobile)",
      "min": 11,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "card_subtitle_size",
      "label": "Card subtitle size (desktop)",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "card_subtitle_size_mobile",
      "label": "Card subtitle size (mobile)",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text color",
      "default": "#FAFAF7"
    },
    {
      "type": "color",
      "id": "card_subtitle_color",
      "label": "Card subtitle color"
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_last_card",
      "label": "Last card on mobile (odd count)",
      "info": "When you have an odd number of non-featured cards, the last one sits alone. Choose how it displays.",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Auto (full-width if odd)" },
        { "value": "wide", "label": "Always full-width" },
        { "value": "square", "label": "Keep square" }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "wide", "label": "Wide (1600px)" },
        { "value": "contained", "label": "Contained (1400px)" },
        { "value": "narrow", "label": "Narrow (1200px)" }
      ],
      "default": "full"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 150,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 150,
      "step": 10,
      "default": 60,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid"
        }
      ]
    },
    {
      "type": "space",
      "name": "Space",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Living Room"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "info": "Optional short description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Used as background or as poster frame when a video is set"
        },
        {
          "type": "range",
          "id": "focal_x",
          "label": "Image focal point — horizontal",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50,
          "info": "Shift the crop horizontally so the product stays in view. 0 = align left edge, 50 = center, 100 = align right edge."
        },
        {
          "type": "range",
          "id": "focal_y",
          "label": "Image focal point — vertical",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50,
          "info": "Shift the crop vertically so the product stays in view. 0 = align top edge, 50 = center, 100 = align bottom edge."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Background video (Shopify-hosted)",
          "info": "Upload to Files, loops silently as card background"
        },
