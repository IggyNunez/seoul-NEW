        },
        {
          "type": "color",
          "id": "color_hex",
          "label": "Swatch dot color",
          "default": "#F2FFA0"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Spectrum strip",
      "category": "Seoul Glow Lab",
      "blocks": [
        { "type": "angle", "settings": { "angle_label": "0°",   "color_label": "Cyan",   "color_hex": "#06B6D4" } },
        { "type": "angle", "settings": { "angle_label": "90°",  "color_label": "Pink",   "color_hex": "#EC4899" } },
        { "type": "angle", "settings": { "angle_label": "180°", "color_label": "Amber",  "color_hex": "#F59E0B" } },
        { "type": "angle", "settings": { "angle_label": "270°", "color_label": "Purple", "color_hex": "#9333EA" } }
      ]
    }
  ]
}
