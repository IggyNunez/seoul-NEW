{%- comment -%}
  Casa gradient divider — small accent bar separating sections.
  Matches the inline dividers used in casa-products-grid and
  casa-editorial-story headers, exposed as a standalone section
  so it can sit between any two sections (e.g. 404 message +
  bestsellers grid).
{%- endcomment -%}

<div
  class="casa-divider-section casa-divider-section--align-{{ section.settings.alignment }}"
  style="
    --casa-divider-color-1: {{ section.settings.color_primary }};
    --casa-divider-color-2: {{ section.settings.color_secondary }};
    --casa-divider-width: {{ section.settings.bar_width }}px;
    --casa-divider-height: {{ section.settings.bar_height }}px;
    --casa-divider-padding-top: {{ section.settings.padding_top }}px;
    --casa-divider-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="casa-divider-section__bar" aria-hidden="true"></div>
</div>

{% stylesheet %}
.casa-divider-section {
  display: flex;
  align-items: center;
  padding-top: var(--casa-divider-padding-top, 24px);
  padding-bottom: var(--casa-divider-padding-bottom, 24px);
  background: transparent;
}
.casa-divider-section--align-center { justify-content: center; }
.casa-divider-section--align-left   { justify-content: flex-start; padding-left: 24px; }
.casa-divider-section--align-right  { justify-content: flex-end; padding-right: 24px; }

.casa-divider-section__bar {
  width: var(--casa-divider-width, 80px);
  height: var(--casa-divider-height, 3px);
  background: linear-gradient(
    90deg,
    var(--casa-divider-color-1, #B0C3FA),
    var(--casa-divider-color-2, #5E0A02)
  );
  border-radius: 2px;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Casa Divider",
  "tag": "section",
  "class": "casa-divider-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Gradient"
    },
    {
      "type": "color",
      "id": "color_primary",
      "label": "Gradient color (left)",
      "default": "#B0C3FA"
    },
    {
      "type": "color",
      "id": "color_secondary",
      "label": "Gradient color (right)",
      "default": "#5E0A02"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "bar_width",
      "label": "Width",
      "min": 40,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Thickness",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Casa Divider",
      "category": "Layout"
    }
  ]
}
{% endschema %}
