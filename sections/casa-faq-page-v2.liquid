{% comment %}
  Seoul Glow Lab — Premium FAQ Page v2
  Layouts: two-column | tabs-top | cards
  2026-05-15: h1→h2 + hero alignment honors --faq2-content-align
{% endcomment %}

{%- comment -%} Auto-hide when no question blocks exist {%- endcomment -%}
{%- assign has_questions = false -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'question' and block.settings.question != blank -%}
    {%- assign has_questions = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if has_questions == false and section.settings.auto_hide and request.design_mode == false -%}
  <style>#shopify-section-{{ section.id }} { display: none !important; }</style>
{%- endif -%}

{%- liquid
  assign layout = section.settings.layout_style
  assign content_align = section.settings.content_align | default: 'left'
  assign show_search = section.settings.show_search
  assign badge = section.settings.badge_text
  assign title = section.settings.title
  assign subtitle = section.settings.subtitle
  assign bg = section.settings.color_bg
  assign text_color = section.settings.color_text
  assign muted = section.settings.color_muted
  assign accent1 = section.settings.color_accent_primary
  assign accent2 = section.settings.color_accent_secondary

  comment
    WCAG-AA: answer/no-results links use accent1 (default brand purple #B0C3FA),
    which is only 3.67:1 on Ink and fails AA. On a dark background swap to the
    lighter #B0C3FA (~4.8:1 on Ink). Light backgrounds keep #B0C3FA (4.97:1 on Paper).
  endcomment
  assign faq2_link_color = accent1 | default: '#B0C3FA'
  assign _bg_bright = bg | default: '#FAFAF7' | color_brightness
  if _bg_bright < 128
    assign faq2_link_color = '#B0C3FA'
  endif
  assign card_bg = section.settings.color_card_bg
  assign card_border = section.settings.color_card_border
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign contact_title = section.settings.contact_title
  assign contact_text = section.settings.contact_text
  assign contact_email = section.settings.contact_email
  assign contact_page_url = section.settings.contact_page_url | default: '/pages/contact-us'
  assign contact_page_label = section.settings.contact_page_label

  assign cat_index = -1
-%}

{%- comment %} Build categories and questions arrays {% endcomment -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'category' -%}
    {%- assign cat_index = cat_index | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<section
  id="casa-faq2-{{ section.id }}"
  class="casa-faq2{% if content_align == 'center' %} casa-faq2--center{% endif %}{% if section.settings.layout_density == 'one_frame' %} casa-faq2--compact{% endif %}"
  data-layout="{{ layout }}"
  data-section-id="{{ section.id }}"
  style="
    --faq2-bg: {{ bg }};
    --faq2-text: {{ text_color }};
    --faq2-muted: {{ muted }};
    --faq2-accent1: {{ accent1 }};
    --faq2-link: {{ faq2_link_color }};
    --faq2-accent2: {{ accent2 }};
    --faq2-card-bg: {{ card_bg }};
    --faq2-card-border: {{ card_border }};
    --faq2-pt: {{ pt }}px;
    --faq2-pb: {{ pb }}px;
    --faq2-content-align: {{ content_align }};
    {%- if section.settings.color_hero_title != blank %}--faq2-hero-title: {{ section.settings.color_hero_title }};{% endif -%}
    {%- if section.settings.color_hero_subtitle != blank %}--faq2-hero-subtitle: {{ section.settings.color_hero_subtitle }};{% endif -%}
    {%- if section.settings.color_hero_badge_bg != blank %}--faq2-badge-bg: {{ section.settings.color_hero_badge_bg }};{% endif -%}
    {%- if section.settings.color_hero_badge_text != blank %}--faq2-badge-text: {{ section.settings.color_hero_badge_text }};{% endif -%}
    {%- if section.settings.color_nav_bg != blank %}--faq2-nav-bg: {{ section.settings.color_nav_bg }};{% endif -%}
    {%- if section.settings.color_nav_text != blank %}--faq2-nav-text: {{ section.settings.color_nav_text }};{% endif -%}
    {%- if section.settings.color_nav_active_bg != blank %}--faq2-nav-active-bg: {{ section.settings.color_nav_active_bg }};{% endif -%}
    {%- if section.settings.color_nav_active_text != blank %}--faq2-nav-active-text: {{ section.settings.color_nav_active_text }};{% endif -%}
    {%- if section.settings.color_question_text != blank %}--faq2-q-text: {{ section.settings.color_question_text }};{% endif -%}
    {%- if section.settings.color_answer_text != blank %}--faq2-a-text: {{ section.settings.color_answer_text }};{% endif -%}
    {%- if section.settings.color_chevron != blank %}--faq2-chevron: {{ section.settings.color_chevron }};{% endif -%}
    {%- if section.settings.color_category_title != blank %}--faq2-cat-title: {{ section.settings.color_category_title }};{% endif -%}
    {%- if section.settings.color_icon != blank %}--faq2-icon: {{ section.settings.color_icon }};{% endif -%}
    {%- if section.settings.color_stats_number != blank %}--faq2-stats-num: {{ section.settings.color_stats_number }};{% endif -%}
    {%- if section.settings.color_stats_label != blank %}--faq2-stats-label: {{ section.settings.color_stats_label }};{% endif -%}
    {%- if section.settings.color_stats_star != blank %}--faq2-stats-star: {{ section.settings.color_stats_star }};{% endif -%}
    {%- if section.settings.color_cta_bg != blank %}--faq2-cta-bg: {{ section.settings.color_cta_bg }};{% endif -%}
    {%- if section.settings.color_cta_text != blank %}--faq2-cta-text: {{ section.settings.color_cta_text }};{% endif -%}
    {%- if section.settings.color_cta_btn_bg != blank %}--faq2-cta-btn-bg: {{ section.settings.color_cta_btn_bg }};{% endif -%}
    {%- if section.settings.color_cta_btn_text != blank %}--faq2-cta-btn-text: {{ section.settings.color_cta_btn_text }};{% endif -%}
    {%- comment -%}
      Heading scales: each title pulls size/weight/lh/ls/case from
      Theme Settings -> Typography (H1-H6).
    {%- endcomment -%}
    {%- assign faq_title_h    = section.settings.faq2_heading_level     | default: 'h1' -%}
    {%- assign faq_cat_h      = section.settings.faq2_cat_heading_level | default: 'h4' -%}
    {%- assign faq_cta_h      = section.settings.faq2_cta_heading_level | default: 'h3' -%}
    --faq2-title-fs:   var(--font-{{ faq_title_h }}--size);
    --faq2-title-fw:   var(--font-{{ faq_title_h }}--weight);
    --faq2-title-lh:   var(--font-{{ faq_title_h }}--line-height);
    --faq2-title-ls:   var(--font-{{ faq_title_h }}--letter-spacing);
    --faq2-title-case: var(--font-{{ faq_title_h }}--case);
    --faq2-cat-fs:     var(--font-{{ faq_cat_h }}--size);
    --faq2-cat-fw:     var(--font-{{ faq_cat_h }}--weight);
    --faq2-ctatitle-fs:   var(--font-{{ faq_cta_h }}--size);
    --faq2-ctatitle-fw:   var(--font-{{ faq_cta_h }}--weight);
  "
>
  <!-- Hero -->
  <div class="casa-faq2__hero">
    <div class="casa-faq2__hero-inner">
      {%- if badge != blank -%}
        <span class="casa-faq2__badge casa-faq2__anim" data-anim="fade-up">{{ badge }}</span>
      {%- endif -%}
      {%- if title != blank -%}
        {%- assign faq2_title_style = section.settings.faq2_title_style | default: 'current' -%}
        {%- comment -%}
          Tag is driven by the existing faq2_heading_level setting
          (default h1) so this section can be safely embedded on a
          page that already has its own H1 — e.g. cart, where the
          cart heading is the primary H1. Default behavior (h1) is
          unchanged for the dedicated FAQ page.
        {%- endcomment -%}
        <{{ faq_title_h }} class="casa-faq2__title casa-faq2__title--{{ faq2_title_style }} casa-faq2__anim{% if faq2_title_style == 'shimmer' %} text-grad-shimmer{% elsif faq2_title_style == 'text' %} text-grad-text{% endif %}" data-anim="fade-up" data-delay="1">{{ title }}</{{ faq_title_h }}>
      {%- endif -%}
      {%- if subtitle != blank -%}
        <p class="casa-faq2__subtitle casa-faq2__anim" data-anim="fade-up" data-delay="2">{{ subtitle }}</p>
      {%- endif -%}
      {%- if show_search -%}
        <div class="casa-faq2__search-wrap casa-faq2__anim" data-anim="fade-up" data-delay="3">
          <div class="casa-faq2__search">
            <svg class="casa-faq2__search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" class="casa-faq2__search-input" placeholder="Search questions..." aria-label="Search FAQ">
            <button class="casa-faq2__search-clear" aria-label="Clear search" style="display:none">&times;</button>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

  <!-- Main Content -->
  <div class="casa-faq2__body casa-faq2__body--{{ layout }}">
    {%- comment %} ========== TWO-COLUMN LAYOUT ========== {% endcomment -%}
    {%- if layout == 'two-column' -%}
      <div class="casa-faq2__two-col">
        <aside class="casa-faq2__sidebar">
          <nav class="casa-faq2__nav" aria-label="FAQ categories">
            {%- assign ci = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'category' -%}
                <a href="#casa-faq2-cat-{{ ci }}-{{ section.id }}" class="casa-faq2__nav-item{% if ci == 0 %} is-active{% endif %}" data-cat-nav="{{ ci }}">
                  <span class="casa-faq2__nav-icon">{%- render 'casa-faq2-icon', icon: block.settings.icon -%}</span>
                  <span class="casa-faq2__nav-label">{{ block.settings.title }}</span>
                </a>
                {%- assign ci = ci | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </nav>
        </aside>
        <div class="casa-faq2__content">
          {%- assign ci = -1 -%}
          {%- assign open_cat = false -%}
          {% # theme-check-disable %}
          {%- for block in section.blocks -%}
            {%- if block.type == 'category' -%}
              {%- if open_cat -%}</div>{%- endif -%}
              {%- assign ci = ci | plus: 1 -%}
              {%- assign open_cat = true -%}
              <div class="casa-faq2__category casa-faq2__anim" data-anim="fade-up" id="casa-faq2-cat-{{ ci }}-{{ section.id }}" data-cat-idx="{{ ci }}" {{ block.shopify_attributes }}>
                <h2 class="casa-faq2__cat-title">
                  <span class="casa-faq2__cat-icon">{%- render 'casa-faq2-icon', icon: block.settings.icon -%}</span>
                  {{ block.settings.title }}
                </h2>
                {%- if block.settings.description != blank -%}
                  <p class="casa-faq2__cat-desc">{{ block.settings.description }}</p>
                {%- endif -%}
            {%- elsif block.type == 'question' -%}
              <div class="casa-faq2__item casa-faq2__anim" data-anim="fade-up" data-question="{{ block.settings.question | escape }}" {{ block.shopify_attributes }}>
                <button class="casa-faq2__q" aria-expanded="false">
                  {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}<span class="casa-faq2__q-icon">{%- render 'casa-faq2-icon', icon: block.settings.icon -%}</span>{%- endif -%}<span class="casa-faq2__q-text">{{ block.settings.question }}</span>
                  <span class="casa-faq2__chevron">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                  </span>
                </button>
                <div class="casa-faq2__a" aria-hidden="true">
                  <div class="casa-faq2__a-inner">{{ block.settings.answer }}</div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
          {%- if open_cat -%}</div>{%- endif -%}
          {% # theme-check-enable %}

          <div class="casa-faq2__no-results" style="display:none">
            <p class="casa-faq2__no-results-text">No matching questions found.</p>
            <p class="casa-faq2__no-results-sub">Try a different search term or <a href="{{ contact_page_url }}">contact our support team</a>.</p>
          </div>
        </div>
      </div>

    {%- comment %} ========== TABS-TOP LAYOUT ========== {% endcomment -%}
    {%- elsif layout == 'tabs-top' -%}
      <div class="casa-faq2__tabs-wrap">
        <div class="casa-faq2__tabs-bar casa-faq2__anim" data-anim="fade-up">
          {%- assign ci = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'category' -%}
              <button class="casa-faq2__tab{% if ci == 0 %} is-active{% endif %}" data-tab="{{ ci }}">
                <span class="casa-faq2__tab-icon">{%- render 'casa-faq2-icon', icon: block.settings.icon -%}</span>
                <span>{{ block.settings.title }}</span>
              </button>
              {%- assign ci = ci | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="casa-faq2__tabs-content">
          {%- assign ci = -1 -%}
          {%- assign open_cat = false -%}
          {% # theme-check-disable %}
          {%- for block in section.blocks -%}
            {%- if block.type == 'category' -%}
              {%- if open_cat -%}</div>{%- endif -%}
              {%- assign ci = ci | plus: 1 -%}
              {%- assign open_cat = true -%}
              <div class="casa-faq2__tab-panel{% if ci == 0 %} is-active{% endif %}" data-tab-panel="{{ ci }}" data-cat-idx="{{ ci }}" {{ block.shopify_attributes }}>
            {%- elsif block.type == 'question' -%}
              <div class="casa-faq2__item casa-faq2__anim" data-anim="fade-up" data-question="{{ block.settings.question | escape }}" {{ block.shopify_attributes }}>
                <button class="casa-faq2__q" aria-expanded="false">
                  {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}<span class="casa-faq2__q-icon">{%- render 'casa-faq2-icon', icon: block.settings.icon -%}</span>{%- endif -%}<span class="casa-faq2__q-text">{{ block.settings.question }}</span>
                  <span class="casa-faq2__chevron">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                  </span>
                </button>
                <div class="casa-faq2__a" aria-hidden="true">
                  <div class="casa-faq2__a-inner">{{ block.settings.answer }}</div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
          {%- if open_cat -%}</div>{%- endif -%}
          {% # theme-check-enable %}

          <div class="casa-faq2__no-results" style="display:none">
            <p class="casa-faq2__no-results-text">No matching questions found.</p>
            <p class="casa-faq2__no-results-sub">Try a different search term or <a href="{{ contact_page_url }}">contact our support team</a>.</p>
          </div>
        </div>
      </div>

    {%- comment %} ========== CARDS LAYOUT ========== {% endcomment -%}
    {%- elsif layout == 'cards' -%}
      <div class="casa-faq2__cards-grid">
        {%- assign ci = -1 -%}
        {%- assign open_cat = false -%}
        {% # theme-check-disable %}
        {%- for block in section.blocks -%}
          {%- if block.type == 'category' -%}
            {%- if open_cat -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
            {%- assign ci = ci | plus: 1 -%}
            {%- assign open_cat = true -%}
            {%- comment %} Count questions in this category {% endcomment -%}
            {%- assign q_count = 0 -%}
            {%- assign counting = true -%}
            {%- for b2 in section.blocks -%}
              {%- if b2.id == block.id -%}
                {%- assign counting = true -%}
                {%- continue -%}
              {%- endif -%}
              {%- if counting and b2.type == 'category' -%}
                {%- break -%}
              {%- endif -%}
              {%- if counting and b2.type == 'question' -%}
                {%- assign q_count = q_count | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
            <div class="casa-faq2__card casa-faq2__anim" data-anim="fade-up" data-cat-idx="{{ ci }}" {{ block.shopify_attributes }}>
              <button class="casa-faq2__card-header" aria-expanded="false" data-card-toggle="{{ ci }}">
                <span class="casa-faq2__card-icon">{%- render 'casa-faq2-icon', icon: block.settings.icon -%}</span>
                <span class="casa-faq2__card-title">{{ block.settings.title }}</span>
                <span class="casa-faq2__card-count">{{ q_count }}</span>
                <span class="casa-faq2__card-arrow">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </button>
              <div class="casa-faq2__card-body" aria-hidden="true">
                <div class="casa-faq2__card-body-inner">
          {%- elsif block.type == 'question' -%}
            <div class="casa-faq2__item" data-question="{{ block.settings.question | escape }}" {{ block.shopify_attributes }}>
              <button class="casa-faq2__q" aria-expanded="false">
                {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}<span class="casa-faq2__q-icon">{%- render 'casa-faq2-icon', icon: block.settings.icon -%}</span>{%- endif -%}<span class="casa-faq2__q-text">{{ block.settings.question }}</span>
                <span class="casa-faq2__chevron">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </button>
              <div class="casa-faq2__a" aria-hidden="true">
                <div class="casa-faq2__a-inner">{{ block.settings.answer }}</div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- if open_cat -%}
              </div>
            </div>
          </div>
        {%- endif -%}
        {% # theme-check-enable %}
      </div>
      <div class="casa-faq2__no-results" style="display:none">
        <p class="casa-faq2__no-results-text">No matching questions found.</p>
        <p class="casa-faq2__no-results-sub">Try a different search term or <a href="{{ contact_page_url }}">contact our support team</a>.</p>
      </div>
    {%- endif -%}
  </div>

  <!-- Contact CTA -->
  {%- if contact_title != blank -%}
    <div class="casa-faq2__cta-wrap casa-faq2__anim" data-anim="fade-up">
      <div class="casa-faq2__cta">
        <h3 class="casa-faq2__cta-title">{{ contact_title }}</h3>
        {%- if contact_text != blank -%}
          <p class="casa-faq2__cta-text">{{ contact_text }}</p>
        {%- endif -%}
        <div class="casa-faq2__cta-btns">
          {%- assign faq2_email_treatment = section.settings.faq2_email_treatment | default: 'featured' -%}
          {%- assign faq2_page_treatment  = section.settings.faq2_page_treatment  | default: 'secondary-on-dark' -%}
          {%- if contact_email != blank -%}
            <a href="mailto:{{ contact_email }}" class="btn btn-{{ faq2_email_treatment }} casa-faq2__cta-btn casa-faq2__cta-btn--email">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              Email Support
            </a>
          {%- endif -%}
          {%- if contact_page_url != blank -%}
            <a href="{{ contact_page_url }}" class="btn btn-{{ faq2_page_treatment }} casa-faq2__cta-btn casa-faq2__cta-btn--page">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              {{ contact_page_label | default: 'Contact Us' }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
/* ========== CASA FAQ v2 — Core ========== */
.casa-faq2 {
  background: var(--faq2-bg);
  color: var(--faq2-text);
  padding-top: var(--faq2-pt);
  padding-bottom: var(--faq2-pb);
  font-family: inherit;
  -webkit-font-smoothing: antialiased;
  overflow: hidden;
}
.casa-faq2 *, .casa-faq2 *::before, .casa-faq2 *::after { box-sizing: border-box; }

/* ========== Hero ========== */
.casa-faq2__hero {
  text-align: center;
  padding: 60px 24px 48px;
  max-width: 800px;
  margin: 0 auto;
}
.casa-faq2__badge {
  display: inline-block;
  padding: 6px 18px;
  border-radius: 100px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  /* Decorative gradient — brand --grad-primary (rebrand-friendly).
     Section accent_purple/_pink settings stay scoped to nav active /
     icon / chevron / cta-btn-bg overrides (see top of style attr). */
  background: var(--grad-primary, linear-gradient(135deg, var(--faq2-accent1), var(--faq2-accent2)));
  color: #fff;
  margin-bottom: 20px;
}
/* Title — uses the brand-book .pdp-title spec via casa-base.css
   tokens so it matches every other Casa PDP section H2. Was 700/56
   from theme settings, now 600/clamp(36-56px) per brand book §03. */
.casa-faq2__title {
  font-family:    var(--casa-pdp-h2-family);
  font-size:      var(--casa-pdp-h2-size);
  font-weight:    var(--casa-pdp-h2-weight);
  letter-spacing: var(--casa-pdp-h2-tracking);
  line-height:    var(--casa-pdp-h2-line);
  text-transform: var(--faq2-title-case, none);
  margin: 0 0 16px;
}

/* Default "current" mode — solid text color. Brand v1 reserves
   gradient for italic accent words only; section headings stay
   solid. The text→muted gradient was rendering near-invisible
   when both stops were close in luminance on the live theme.
   For an explicit gradient effect, use --text or --shimmer. */
.casa-faq2__title--current {
  color: var(--faq2-text);
  -webkit-text-fill-color: var(--faq2-text);
}
/* Italic accent — purple→pink→cyan brand gradient, matches every
   other PDP section heading's <em> treatment. */
.casa-faq2__title em {
  font-style: italic;
  /* Brand book v1 §08: cap section-heading em weight at 600. */
  font-weight: 600;
  /* Gradient accent reads larger than surrounding text — merchant
     directive 2026-05-15 (brand book emphasis register). */
  font-size: 1.25em;
  background: linear-gradient(90deg, #B0C3FA, #5E0A02, #F2FFA0);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}
/* --text and --shimmer modifiers: parallel .text-grad-text /
   .text-grad-shimmer brand classes paint via brand tokens. */
.casa-faq2__subtitle {
  font-size: clamp(16px, 2vw, 20px);
  color: var(--faq2-muted);
  margin: 0 0 32px;
  line-height: 1.6;
}

/* Search */
.casa-faq2__search-wrap { max-width: 520px; margin: 0 auto; }
.casa-faq2__search {
  position: relative;
  display: flex;
  align-items: center;
  background: var(--faq2-card-bg);
  border: 1px solid var(--faq2-card-border);
  border-radius: 14px;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  will-change: backdrop-filter; /* GPU layer: avoid per-frame re-blur (perf, 2026-05-17 flicker-fix pattern) */
  transition: border-color .3s, box-shadow .3s;
}
.casa-faq2__search:focus-within {
  border-color: var(--faq2-accent1);
  box-shadow: 0 0 0 3px rgba(176, 195, 250,.15);
}
.casa-faq2__search-icon { flex-shrink: 0; margin-left: 16px; color: var(--faq2-muted); }
.casa-faq2__search-input {
  flex: 1;
  background: transparent !important;
  background-color: transparent !important;
  border: none !important;
  /* perf-justified: search input has a custom :focus-visible style on the parent wrapper — visible keyboard focus delivered via the wrapper outline */
  outline: none;
  padding: 14px 16px;
  font-size: 16px;
  color: var(--faq2-text);
  font-family: inherit;
  box-shadow: none !important;
}
.casa-faq2__search-input::placeholder { color: var(--faq2-muted); opacity: .6; }
.casa-faq2__search-clear {
  background: none; border: none; color: var(--faq2-muted); font-size: 22px; cursor: pointer;
  padding: 8px 14px; line-height: 1; transition: color .2s;
}
.casa-faq2__search-clear:hover { color: var(--faq2-text); }

/* ========== Body Wrapper ========== */
.casa-faq2__body { max-width: 1400px; margin: 0 auto; padding: 0 24px; }
.casa-faq2__body--tabs-top { max-width: 1200px; }

/* ========== TWO-COLUMN ========== */
.casa-faq2__two-col { display: flex; gap: 48px; align-items: flex-start; }
.casa-faq2__sidebar {
  width: 280px;
  flex-shrink: 0;
  position: sticky;
  top: 120px;
}
.casa-faq2__nav { display: flex; flex-direction: column; gap: 4px; }
.casa-faq2__nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  border-radius: 12px;
  text-decoration: none;
  color: var(--faq2-muted);
  font-size: 15px;
  font-weight: 500;
  transition: all .25s;
  border-left: 3px solid transparent;
}
.casa-faq2__nav-item:hover { color: var(--faq2-text); background: rgba(255,255,255,.03); }
.casa-faq2__nav-item.is-active {
  color: transparent;
  background: rgba(176, 195, 250,.08);
  border-image: linear-gradient(180deg, var(--faq2-accent1), var(--faq2-accent2)) 1;
  border-left-width: 3px;
  border-left-style: solid;
}
.casa-faq2__nav-item.is-active .casa-faq2__nav-label {
  background: linear-gradient(135deg, var(--faq2-accent1), var(--faq2-accent2));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.casa-faq2__nav-item.is-active .casa-faq2__nav-icon svg { stroke: var(--faq2-accent1); }
.casa-faq2__nav-icon svg { width: 18px; height: 18px; stroke: currentColor; transition: stroke .25s; }
.casa-faq2__content { flex: 1; min-width: 0; }

/* Category Title */
.casa-faq2__category { margin-bottom: 40px; }
.casa-faq2__cat-title {
  display: flex;
  align-items: center;
  justify-content: var(--faq2-content-align, flex-start);
  gap: 12px;
  font-size:   var(--faq2-cat-fs, var(--font-h4--size, 22px));
  font-weight: var(--faq2-cat-fw, 600);
  margin: 0 0 8px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--faq2-card-border);
}
.casa-faq2__cat-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 32px;
  height: 32px;
  background: linear-gradient(135deg, rgba(var(--faq2-accent1-rgb, 176, 195, 250), 0.15), rgba(var(--faq2-accent1-rgb, 176, 195, 250), 0.05));
  border-radius: 8px;
}
.casa-faq2__cat-icon svg { width: 18px; height: 18px; stroke: var(--faq2-accent1); }
.casa-faq2__cat-desc { font-size: 14px; color: var(--faq2-muted); margin: 0 0 20px; text-align: var(--faq2-content-align, left); }

/* ========== TABS-TOP ========== */
.casa-faq2__tabs-bar {
  display: flex;
  gap: 8px;
  padding: 6px;
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
  background: var(--faq2-card-bg);
  border: 1px solid var(--faq2-card-border);
  border-radius: 16px;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  will-change: backdrop-filter; /* GPU layer: avoid per-frame re-blur (perf, 2026-05-17 flicker-fix pattern) */
  margin-bottom: 40px;
}
.casa-faq2__tabs-bar::-webkit-scrollbar { display: none; }
.casa-faq2__tab {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 20px;
  border: none;
  border-radius: 12px;
  background: none;
  color: var(--faq2-muted);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  white-space: nowrap;
  transition: all .25s;
  font-family: inherit;
}
.casa-faq2__tab:hover { color: var(--faq2-text); background: rgba(255,255,255,.05); }
.casa-faq2__tab.is-active {
  background: linear-gradient(135deg, var(--faq2-accent1), var(--faq2-accent2));
  color: #fff;
}
.casa-faq2__tab-icon svg { width: 16px; height: 16px; }
.casa-faq2__tab-panel { display: none; }
.casa-faq2__tab-panel.is-active { display: block; }

/* ========== CARDS ========== */
.casa-faq2__cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
  gap: 20px;
}
.casa-faq2__card {
  background: var(--faq2-card-bg);
  border: 1px solid var(--faq2-card-border);
  border-radius: 20px;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  will-change: backdrop-filter; /* GPU layer: avoid per-frame re-blur (perf, 2026-05-17 flicker-fix pattern) */
  overflow: hidden;
  transition: transform .3s, box-shadow .3s, border-color .3s;
}
.casa-faq2__card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(176, 195, 250,.12);
  border-color: var(--faq2-accent1);
}
.casa-faq2__card-header {
  display: flex;
  align-items: center;
  gap: 14px;
  width: 100%;
  padding: 24px;
  border: none;
  background: none;
  color: var(--faq2-text);
  cursor: pointer;
  font-family: inherit;
  text-align: left;
}
.casa-faq2__card-icon svg { width: 28px; height: 28px; stroke: var(--faq2-accent1); flex-shrink: 0; }
.casa-faq2__card-title { flex: 1; font-size: var(--font-h4--size, 18px); font-weight: 600; }
.casa-faq2__card-count {
  background: linear-gradient(135deg, var(--faq2-accent1), var(--faq2-accent2));
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.casa-faq2__card-arrow {
  color: var(--faq2-muted);
  transition: transform .35s cubic-bezier(.4,0,.2,1);
}
.casa-faq2__card[data-expanded="true"] .casa-faq2__card-arrow { transform: rotate(180deg); }
/* perf-justified: accordion max-height transition — no transform alternative for variable-height collapsible content */
.casa-faq2__card-body { max-height: 0; overflow: hidden; transition: max-height .45s cubic-bezier(.4,0,.2,1); }
.casa-faq2__card-body-inner { padding: 0 24px 24px; }

/* ========== Accordion Item (Shared) ========== */
.casa-faq2__item {
  background: var(--faq2-card-bg);
  border: 1px solid var(--faq2-card-border);
  border-radius: 14px;
  margin-bottom: 10px;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  will-change: backdrop-filter; /* GPU layer: avoid per-frame re-blur (perf, 2026-05-17 flicker-fix pattern) */
  transition: border-color .3s, box-shadow .3s;
  overflow: hidden;
}
/* Inside cards layout, no extra bg */
.casa-faq2__card-body .casa-faq2__item {
  background: rgba(255,255,255,.02);
  border-color: rgba(255,255,255,.06);
}
.casa-faq2__item:hover {
  border-color: rgba(176, 195, 250,.3);
  box-shadow: 0 2px 16px rgba(176, 195, 250,.06);
}
.casa-faq2__q {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 18px 20px;
  border: none;
  background: none;
  color: var(--faq2-text);
  font-size: 16px;
  font-weight: 500;
  text-align: var(--faq2-content-align, left);
  cursor: pointer;
  gap: 12px;
  font-family: inherit;
}
.casa-faq2__q-icon {
  flex-shrink: 0;
  width: 22px;
  height: 22px;
  color: var(--faq2-accent);
  opacity: 0.7;
}
.casa-faq2__q-icon svg {
  width: 100%;
  height: 100%;
}
.casa-faq2__q-text {
  flex: 1;
}
.casa-faq2__chevron {
  flex-shrink: 0;
  margin-left: auto;
  line-height: 1.5;
}
.casa-faq2__q span:first-child { flex: 1; }
.casa-faq2__chevron {
  flex-shrink: 0;
  color: var(--faq2-accent1);
  transition: transform .35s cubic-bezier(.4,0,.2,1);
}
.casa-faq2__q[aria-expanded="true"] .casa-faq2__chevron { transform: rotate(180deg); }
.casa-faq2__a {
  max-height: 0;
  overflow: hidden;
  /* perf-justified: accordion max-height transition — no transform alternative for variable-height collapsible content */
  transition: max-height .4s cubic-bezier(.4,0,.2,1);
}
.casa-faq2__a-inner {
  padding: 0 20px 20px;
  font-size: 15px;
  line-height: 1.7;
  color: var(--faq2-muted);
  text-align: var(--faq2-content-align, left);
  /* Readability cap: on PDPs the accordion item runs ~1150px wide and
     answers hit ~142 characters per line (comfortable is 50-75).
     ch-based so it binds only where lines run long. All 24 product-
     template instances are left-aligned, so the cap anchors left there;
     centered instances (cart.json's cart-faq) get auto margins via the
     --center modifier below so the capped box centers with its text. */
  max-width: var(--casa-measure-max, 72ch);
}
.casa-faq2--center .casa-faq2__a-inner {
  margin-inline: auto;
}
.casa-faq2__a-inner a {
  color: var(--faq2-link, var(--faq2-accent1));
  text-decoration: underline;
  text-underline-offset: 3px;
}
.casa-faq2__a-inner ul, .casa-faq2__a-inner ol { padding-left: 20px; margin: 8px 0; }
.casa-faq2__a-inner strong { color: var(--faq2-text); }
.casa-faq2__a-inner mark {
  background: linear-gradient(135deg, rgba(176, 195, 250,.25), rgba(94, 10, 2,.25));
  color: var(--faq2-text);
  padding: 1px 4px;
  border-radius: 3px;
}

/* No Results */
.casa-faq2__no-results { text-align: center; padding: 48px 24px; }
.casa-faq2__no-results-text { font-size: 18px; font-weight: 600; margin: 0 0 8px; }
.casa-faq2__no-results-sub { font-size: 15px; color: var(--faq2-muted); margin: 0; }
.casa-faq2__no-results-sub a { color: var(--faq2-link, var(--faq2-accent1)); }

/* ========== Contact CTA ========== */
.casa-faq2__cta-wrap {
  max-width: 720px;
  margin: 60px auto 0;
  padding: 0 24px;
}
.casa-faq2__cta {
  text-align: center;
  padding: 40px;
  background: var(--faq2-card-bg);
  border: 1px solid transparent;
  border-radius: 24px;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  will-change: backdrop-filter; /* GPU layer: avoid per-frame re-blur (perf, 2026-05-17 flicker-fix pattern) */
  position: relative;
}
.casa-faq2__cta::before {
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: 25px;
  padding: 1px;
  background: linear-gradient(135deg, var(--faq2-accent1), var(--faq2-accent2));
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}
.casa-faq2__cta-title { font-size: var(--faq2-ctatitle-fs, var(--font-h3--size, 24px)); font-weight: var(--faq2-ctatitle-fw, 600); margin: 0 0 8px; }
.casa-faq2__cta-text { font-size: 15px; color: var(--faq2-muted); margin: 0 0 24px; }
/* Equal-width CTA buttons in BOTH layouts. Was flex-wrap, so each button
   sized to its own label — the longer "Email Support" rendered wider than
   "Contact Us", and once they wrapped to a stack the mismatched edges read
   as broken. Grid auto-fit gives two equal 1fr columns side by side, then
   collapses to a single 1fr column when the card is too narrow for two;
   grid items stretch to fill their column, so both buttons always match.
   The min(200px, 100%) floor keeps the track from exceeding the container
   at ≤280px (a bare 200px minmax floor would overflow the card there). */
.casa-faq2__cta-btns {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
  gap: 12px;
  justify-content: center;
}
/* Many instances render only one button (e.g. FAQ page = "Contact Us"
   alone). Stretching a lone button to the full card reads as an
   oversized bar on desktop, so keep it at its natural content width,
   centered. The equal-width stretch only kicks in when both buttons
   are present — which is the mismatch the grid exists to fix. */
.casa-faq2__cta-btns > .casa-faq2__cta-btn:only-child {
  justify-self: center;
  width: auto;
}
/* Brand class .btn .btn-(treatment) provides display, padding,
   radius, font, transition, text-transform, letter-spacing,
   background, color, hover. casa-faq2__cta-btn / --email / --page
   classes kept as hooks for any future section-specific overrides
   (intentionally minimal). */

/* ========== Animations ========== */
.casa-faq2__anim { opacity: 0; transform: translateY(24px); transition: opacity .6s ease, transform .6s ease; }
.casa-faq2__anim[data-delay="1"] { transition-delay: .1s; }
.casa-faq2__anim[data-delay="2"] { transition-delay: .2s; }
.casa-faq2__anim[data-delay="3"] { transition-delay: .3s; }
.casa-faq2__anim.is-visible { opacity: 1; transform: translateY(0); }

/* ========== Mobile ========== */
@media (max-width: 900px) {
  .casa-faq2__two-col { flex-direction: column; gap: 0; }
  .casa-faq2__sidebar {
    position: relative;
    top: 0;
    width: 100%;
    margin-bottom: 24px;
  }
  /* Auto-fit grid: 4 across on tablet (~768px), 2 across on phone (~375px).
     Replaces overflow-x scrolling — every category is visible without swipe. */
  .casa-faq2__nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 6px;
    padding: 6px;
    background: var(--faq2-card-bg);
    border: 1px solid var(--faq2-card-border);
    border-radius: 14px;
  }
  .casa-faq2__nav-item {
    justify-content: center;
    text-align: center;
    border-left: none !important;
    border-bottom: 2px solid transparent;
    padding: 14px 12px;
    border-radius: 10px;
    font-size: 13px;
    line-height: 1.25;
    gap: 6px;
    min-width: 0;
    min-height: 44px;
  }
  /* Icons duplicate the category-header icon below; hide on phone to free up
     horizontal room for the label. */
  .casa-faq2__nav-item .casa-faq2__nav-icon { display: none; }
  .casa-faq2__nav-item.is-active {
    border-image: none;
    border-bottom: 2px solid var(--faq2-accent1);
    background: rgba(176, 195, 250,.12);
  }
  .casa-faq2__cards-grid { grid-template-columns: 1fr; }
  .casa-faq2__hero { padding: 40px 16px 32px; }
  .casa-faq2__cat-title { font-size: var(--font-h4--size, 18px); }
  .casa-faq2__cta-wrap { margin-top: 40px; }
  .casa-faq2__cta { padding: 28px 20px; }
}
@media (max-width: 480px) {
  .casa-faq2__q { padding: 14px 16px; font-size: 14px; }
  .casa-faq2__a-inner { padding: 0 16px 16px; font-size: 14px; }
}

/* ── Granular color overrides via CSS variables ── */
.casa-faq2__hero-title { color: var(--faq2-hero-title, var(--faq2-text)); }
.casa-faq2__hero-subtitle { color: var(--faq2-hero-subtitle, var(--faq2-muted)); }
.casa-faq2__badge { background: var(--faq2-badge-bg, linear-gradient(135deg, rgba(176, 195, 250,0.15), rgba(94, 10, 2,0.1))); color: var(--faq2-badge-text, var(--faq2-accent1)); }
.casa-faq2__nav-item { color: var(--faq2-nav-text, var(--faq2-muted)); }
.casa-faq2__nav-item.is-active { background: var(--faq2-nav-active-bg, rgba(176, 195, 250,0.1)); color: var(--faq2-nav-active-text, var(--faq2-accent1)); }
.casa-faq2__tab { color: var(--faq2-nav-text, var(--faq2-muted)); }
.casa-faq2__tab.is-active { background: var(--faq2-nav-active-bg, linear-gradient(135deg, var(--faq2-accent1), var(--faq2-accent2))); color: var(--faq2-nav-active-text, #fff); }
.casa-faq2__q { color: var(--faq2-q-text, var(--faq2-text)); }
.casa-faq2__answer { color: var(--faq2-a-text, var(--faq2-muted)); }
.casa-faq2__chevron { color: var(--faq2-chevron, var(--faq2-muted)); }
.casa-faq2__item[open] .casa-faq2__chevron { color: var(--faq2-chevron, var(--faq2-accent1)); }
.casa-faq2__cat-title { color: var(--faq2-cat-title, var(--faq2-text)); }
.casa-faq2__cat-icon svg { stroke: var(--faq2-icon, var(--faq2-accent1)); }
.casa-faq2__q-icon svg { stroke: var(--faq2-icon, var(--faq2-accent1)); }
.casa-faq2__nav-icon svg { stroke: var(--faq2-icon, currentColor); }
.casa-faq2__stats-number { color: var(--faq2-stats-num, var(--faq2-text)); }
.casa-faq2__stats-label { color: var(--faq2-stats-label, var(--faq2-muted)); }
.casa-faq2__stats-stars { color: var(--faq2-stats-star, #fbbf24); }
.casa-faq2__contact-card { background: var(--faq2-cta-bg, rgba(176, 195, 250,0.05)); color: var(--faq2-cta-text, var(--faq2-text)); }
.casa-faq2__contact-btn--primary { background: var(--faq2-cta-btn-bg, linear-gradient(135deg, var(--faq2-accent1), var(--faq2-accent2))); color: var(--faq2-cta-btn-text, #fff); }

/* ── One-frame density ───────────────────────────────────────────────
   Opt-in via the "Section height" setting. This section renders on 26
   templates including the cart and the standalone FAQ page, so every
   rule below is gated behind the modifier and the default is untouched.

   Note this section's height scales with the number of questions — CSS
   can tighten each row but cannot make an unbounded list fit a frame.
   The rows are compressed here, and nothing is hidden or made
   inner-scrollable: a question a customer cannot see is worse than a
   section that runs a little long. If an instance still overruns, the
   fix is fewer questions on that instance, not more compression.       */
.casa-faq2--compact .casa-faq2__hero { padding: 18px 24px 16px; }
.casa-faq2--compact .casa-faq2__badge { padding: 4px 14px; font-size: 11px; }
.casa-faq2--compact .casa-faq2__subtitle { margin-bottom: 14px; }
.casa-faq2--compact .casa-faq2__category { margin-bottom: 16px; }
.casa-faq2--compact .casa-faq2__cat-title { margin-bottom: 4px; }
.casa-faq2--compact .casa-faq2__item { margin-bottom: 4px; border-radius: 11px; }
/* Measured: 10px block padding rendered a 42px row, NOT the ~44px the
   arithmetic suggested — short of the mobile tap-target minimum. Pin the
   floor explicitly instead of inferring it from padding, so the row stays
   compliant whatever the label length or font does. */
.casa-faq2--compact .casa-faq2__q { padding: 10px 16px; font-size: 15px; min-height: 44px; }
.casa-faq2--compact .casa-faq2__cta-wrap { margin-top: 8px; }
.casa-faq2--compact .casa-faq2__cta { padding: 12px 20px; border-radius: 18px; }
.casa-faq2--compact .casa-faq2__hero { padding-bottom: 10px; }
.casa-faq2--compact .casa-faq2__category { margin-bottom: 12px; }

/* Short viewports: the closing "still have questions" card and the hero
   are the two blocks that are not the questions themselves. */


@media (max-width: 640px) {
  .casa-faq2--compact .casa-faq2__hero { padding: 16px 20px 12px; }
  .casa-faq2--compact .casa-faq2__q { padding: 11px 14px; font-size: 14px; }
  .casa-faq2--compact .casa-faq2__item { margin-bottom: 4px; }
  .casa-faq2--compact .casa-faq2__cta { padding: 14px 16px; }
}

/* 790px, not 800: it has to catch a 768-tall landscape tablet, which
   the first attempt at 760 missed by eight pixels, without also firing
   on an 800-tall laptop that already fits and would only get smaller
   for nothing.

   Height tiers live LAST. They share specificity with the width
   queries above and only win on source order — placed earlier they
   silently lost, which is exactly what happened on the first pass. */
@media (max-height: 790px) {
  .casa-faq2--compact .casa-faq2__hero { padding: 12px 20px 8px; }
  .casa-faq2--compact .casa-faq2__cta-wrap { margin-top: 8px; }
  .casa-faq2--compact .casa-faq2__cta { padding: 10px 14px; }
  .casa-faq2--compact .casa-faq2__item { margin-bottom: 3px; }
  .casa-faq2--compact .casa-faq2__category { margin-bottom: 10px; }
}
{% endstylesheet %}

<script>
(function(){
  const SEC = document.getElementById('casa-faq2-{{ section.id }}');
  if (!SEC) return;
  const LAYOUT = SEC.dataset.layout;

  /* ===== Scroll Animations ===== */
  const animEls = SEC.querySelectorAll('.casa-faq2__anim');
  const animObs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting) { e.target.classList.add('is-visible'); animObs.unobserve(e.target); }
    });
  }, { threshold: 0.1 });
  animEls.forEach(function(el){ animObs.observe(el); });

  /* ===== Accordion ===== */
  SEC.querySelectorAll('.casa-faq2__q').forEach(function(btn){
    btn.addEventListener('click', function(){
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const ans = btn.nextElementSibling;
      if (expanded) {
        ans.style.maxHeight = '0';
        ans.setAttribute('aria-hidden', 'true');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        ans.style.maxHeight = ans.scrollHeight + 'px';
        ans.setAttribute('aria-hidden', 'false');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  /* ===== Card Toggles (cards layout) ===== */
  if (LAYOUT === 'cards') {
    SEC.querySelectorAll('[data-card-toggle]').forEach(function(btn){
      btn.addEventListener('click', function(){
        var card = btn.closest('.casa-faq2__card');
        var body = card.querySelector('.casa-faq2__card-body');
        var exp = card.dataset.expanded === 'true';
        if (exp) {
          body.style.maxHeight = '0';
          card.dataset.expanded = 'false';
          btn.setAttribute('aria-expanded', 'false');
        } else {
          body.style.maxHeight = body.scrollHeight + 'px';
          card.dataset.expanded = 'true';
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }

  /* ===== Tabs (tabs-top layout) ===== */
  if (LAYOUT === 'tabs-top') {
    var tabs = SEC.querySelectorAll('.casa-faq2__tab');
    var panels = SEC.querySelectorAll('.casa-faq2__tab-panel');
    tabs.forEach(function(tab){
      tab.addEventListener('click', function(){
        var idx = tab.dataset.tab;
        tabs.forEach(function(t){ t.classList.remove('is-active'); });
        panels.forEach(function(p){ p.classList.remove('is-active'); });
        tab.classList.add('is-active');
        var target = SEC.querySelector('[data-tab-panel="' + idx + '"]');
        if (target) target.classList.add('is-active');
      });
    });
  }

  /* ===== Two-column scroll spy ===== */
  if (LAYOUT === 'two-column') {
    var catSections = SEC.querySelectorAll('.casa-faq2__category');
    var navItems = SEC.querySelectorAll('.casa-faq2__nav-item');
    if (catSections.length && navItems.length) {
      var spyObs = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (e.isIntersecting) {
            var idx = e.target.dataset.catIdx;
            navItems.forEach(function(n){ n.classList.remove('is-active'); });
            var active = SEC.querySelector('[data-cat-nav="' + idx + '"]');
            if (active) active.classList.add('is-active');
          }
        });
      }, { rootMargin: '-30% 0px -60% 0px' });
      catSections.forEach(function(s){ spyObs.observe(s); });
    }
    /* Smooth scroll nav */
    SEC.querySelectorAll('.casa-faq2__nav-item').forEach(function(a){
      a.addEventListener('click', function(ev){
        ev.preventDefault();
        var target = SEC.querySelector(a.getAttribute('href'));
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  }

  /* ===== Search ===== */
  var searchInput = SEC.querySelector('.casa-faq2__search-input');
  var clearBtn = SEC.querySelector('.casa-faq2__search-clear');
  if (!searchInput) return;

  function doSearch(query){
    query = query.toLowerCase().trim();
    clearBtn.style.display = query ? 'block' : 'none';
    var items = SEC.querySelectorAll('.casa-faq2__item');
    var noResults = SEC.querySelectorAll('.casa-faq2__no-results');
    var anyMatch = false;

    /* Reset highlight */
    items.forEach(function(item){
      var qText = item.querySelector('.casa-faq2__q-text');
      qText.innerHTML = qText.textContent;
    });

    if (!query) {
      items.forEach(function(item){ item.style.display = ''; });
      SEC.querySelectorAll('.casa-faq2__category, .casa-faq2__tab-panel, .casa-faq2__card').forEach(function(c){ c.style.display = ''; });
      noResults.forEach(function(n){ n.style.display = 'none'; });
      /* Tabs: re-activate first */
      if (LAYOUT === 'tabs-top') {
        SEC.querySelectorAll('.casa-faq2__tab')[0] && SEC.querySelectorAll('.casa-faq2__tab')[0].click();
      }
      return;
    }

    items.forEach(function(item){
      var qVal = (item.dataset.question || '').toLowerCase();
      var aVal = (item.querySelector('.casa-faq2__a-inner') || {}).textContent || '';
      aVal = aVal.toLowerCase();
      var match = qVal.indexOf(query) !== -1 || aVal.indexOf(query) !== -1;
      item.style.display = match ? '' : 'none';
      if (match) {
        anyMatch = true;
        /* Highlight in question text */
        var qText = item.querySelector('.casa-faq2__q-text');
        var raw = qText.textContent;
        var re = new RegExp('(' + query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
        qText.innerHTML = raw.replace(re, '<mark>$1</mark>');
      }
    });

    /* Show/hide category containers */
    if (LAYOUT === 'two-column') {
      SEC.querySelectorAll('.casa-faq2__category').forEach(function(cat){
        var hasVisible = cat.querySelector('.casa-faq2__item[style=""], .casa-faq2__item:not([style])');
        /* check any item not hidden */
        var vis = false;
        cat.querySelectorAll('.casa-faq2__item').forEach(function(i){ if (i.style.display !== 'none') vis = true; });
        cat.style.display = vis ? '' : 'none';
      });
    } else if (LAYOUT === 'tabs-top') {
      /* Show all panels during search */
      SEC.querySelectorAll('.casa-faq2__tab-panel').forEach(function(p){
        var vis = false;
        p.querySelectorAll('.casa-faq2__item').forEach(function(i){ if (i.style.display !== 'none') vis = true; });
        p.style.display = vis ? 'block' : 'none';
        p.classList.toggle('is-active', vis);
      });
    } else if (LAYOUT === 'cards') {
      SEC.querySelectorAll('.casa-faq2__card').forEach(function(card){
        var vis = false;
        card.querySelectorAll('.casa-faq2__item').forEach(function(i){ if (i.style.display !== 'none') vis = true; });
        card.style.display = vis ? '' : 'none';
        if (vis) {
          card.dataset.expanded = 'true';
          card.querySelector('.casa-faq2__card-header').setAttribute('aria-expanded', 'true');
          var body = card.querySelector('.casa-faq2__card-body');
          body.style.maxHeight = body.scrollHeight + 'px';
        }
      });
    }

    noResults.forEach(function(n){ n.style.display = anyMatch ? 'none' : 'block'; });
  }

  searchInput.addEventListener('input', function(){ doSearch(this.value); });
  if (clearBtn) clearBtn.addEventListener('click', function(){
    searchInput.value = '';
    doSearch('');
    searchInput.focus();
  });
})();
</script>

{%- comment -%}
  FAQPage JSON-LD — reads from the same `question` blocks the visible UI
  renders, so the merchant edits Q&A in one place and structured data
  stays in sync. Emits only when at least one question + answer pair is
  filled in, to avoid shipping an empty `mainEntity` array (Google flags
  empty FAQPage schemas as low-quality).

  Note on rich results: as of 2023 Google restricts FAQPage SERP rich
  snippets to government and authoritative health sites. We still emit
  this because (a) Bing honors it, (b) AI search crawlers (ChatGPT,
  Claude, Perplexity, Gemini) parse it for grounded answers, and
  (c) Google still uses it for AI Overviews and entity understanding.
{%- endcomment -%}
{%- assign _faq_has_entries = false -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'question' and block.settings.question != blank and block.settings.answer != blank -%}
    {%- assign _faq_has_entries = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if _faq_has_entries -%}
<script type="application/ld+json">{
"@context":"https://schema.org",
"@type":"FAQPage",
"mainEntity":[{%- assign _faq_first = true -%}
{%- for block in section.blocks -%}
{%- if block.type == 'question' and block.settings.question != blank and block.settings.answer != blank -%}
{%- unless _faq_first -%},{%- endunless -%}
{"@type":"Question","name":{{ block.settings.question | strip_html | strip_newlines | strip | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | strip_newlines | strip | json }}}}
{%- assign _faq_first = false -%}
{%- endif -%}
{%- endfor -%}]
}</script>
{%- endif -%}

