{%- comment -%}
  Seoul Glow Lab — Policy Page Section
  Renders refund / privacy / terms / shipping / subscription policies
  on an editorial Ink surface with Casa typography. The policy body
  comes from Shopify Admin → Settings → Policies as pre-formatted
  HTML; we wrap it in a brand-styled prose container.

  Block-free section (single instance). Uses Liquid `policy` object
  which is available on /policies/* URLs.
{%- endcomment -%}

{%- liquid
  assign bg          = section.settings.bg_color    | default: '#0A0A0F'
  assign text        = section.settings.text_color  | default: '#FAFAF7'
  assign muted       = section.settings.muted_color | default: '#A3A3A3'
  assign rule        = section.settings.rule_color  | default: '#1F1F24'
  assign accent1     = section.settings.accent_primary   | default: '#B0C3FA'
  assign accent2     = section.settings.accent_secondary | default: '#5E0A02'
  assign accent3     = section.settings.accent_tertiary  | default: '#F2FFA0'
  assign max_w       = section.settings.prose_max_width  | default: 760
  assign kicker_txt  = section.settings.kicker_text | default: 'LEGAL'
-%}

<section
  class="casa-policy"
  style="
    --pol-bg: {{ bg }};
    --pol-text: {{ text }};
    --pol-muted: {{ muted }};
    --pol-rule: {{ rule }};
    --pol-a1: {{ accent1 }};
    --pol-a2: {{ accent2 }};
    --pol-a3: {{ accent3 }};
    --pol-grad-text: linear-gradient(90deg, {{ accent1 }} 0%, {{ accent2 }} 50%, {{ accent3 }} 100%);
    --pol-prose-mw: {{ max_w }}px;
  "
>
  <div class="casa-policy__hero">
    <div class="casa-policy__hero-inner">
      <span class="casa-policy__kicker">{{ kicker_txt }} · SEOUL GLOW LAB</span>
      <h1 class="casa-policy__title">{{ policy.title }}</h1>
      {%- if section.settings.show_updated and shop.policies_updated_at != blank -%}
        <span class="casa-policy__updated">
          Last updated {{ shop.policies_updated_at | date: '%B %-d, %Y' }}
        </span>
      {%- endif -%}
    </div>
  </div>

  <div class="casa-policy__body">
    <div class="casa-policy__body-inner">
      {%- if section.settings.show_toc -%}
        <aside class="casa-policy__toc" aria-label="On this page">
          <span class="casa-policy__toc-label">ON THIS PAGE</span>
          <nav class="casa-policy__toc-nav" data-casa-policy-toc>
            <!-- Filled by JS from h2/h3 inside the prose -->
          </nav>
        </aside>
      {%- endif -%}

      <article class="casa-policy__prose" data-casa-policy-prose>
        {{ policy.body }}
      </article>
    </div>
  </div>

  {%- if section.settings.show_other_policies -%}
    <div class="casa-policy__other">
      <div class="casa-policy__other-inner">
        <span class="casa-policy__kicker">OTHER POLICIES</span>
        <ul class="casa-policy__other-list">
          {%- if shop.refund_policy and shop.refund_policy.id != policy.id -%}
            <li><a class="casa-policy__other-link" href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></li>
          {%- endif -%}
          {%- if shop.privacy_policy and shop.privacy_policy.id != policy.id -%}
            <li><a class="casa-policy__other-link" href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a></li>
          {%- endif -%}
          {%- if shop.shipping_policy and shop.shipping_policy.id != policy.id -%}
            <li><a class="casa-policy__other-link" href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></li>
          {%- endif -%}
          {%- if shop.terms_of_service and shop.terms_of_service.id != policy.id -%}
            <li><a class="casa-policy__other-link" href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a></li>
          {%- endif -%}
          {%- if shop.subscription_policy and shop.subscription_policy.id != policy.id -%}
            <li><a class="casa-policy__other-link" href="{{ shop.subscription_policy.url }}">{{ shop.subscription_policy.title }}</a></li>
          {%- endif -%}
        </ul>
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .casa-policy {
    --_bg: var(--pol-bg, var(--casa-ink, #0A0A0F));
    --_text: var(--pol-text, var(--casa-paper, #FAFAF7));
    --_muted: var(--pol-muted, #A3A3A3);
    --_rule: var(--pol-rule, #1F1F24);
    --_a1: var(--pol-a1, #B0C3FA);
    --_a2: var(--pol-a2, #5E0A02);
    --_a3: var(--pol-a3, #F2FFA0);
    --_grad-text: var(--pol-grad-text, linear-gradient(90deg, #B0C3FA, #5E0A02, #F2FFA0));
    --_prose-mw: var(--pol-prose-mw, 760px);

    background: var(--_bg);
    color: var(--_text);
    font-family: var(--font-body--family, 'Inter', -apple-system, BlinkMacSystemFont, sans-serif);
    min-height: 60vh;
  }
  .casa-policy *,
  .casa-policy *::before,
  .casa-policy *::after { box-sizing: border-box; }

  /* ═══════════════ HERO ═══════════════ */
  .casa-policy__hero {
    padding: 5rem 1.5rem 3rem;
    border-bottom: 1px solid var(--_rule);
  }
  @media (min-width: 900px) {
    .casa-policy__hero { padding: 7rem 2.5rem 4rem; }
  }
  .casa-policy__hero-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .casa-policy__kicker {
    display: inline-block;
    font-family: var(--font-mono--family, 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--_muted);
    margin-bottom: 1.25rem;
  }
  .casa-policy__title {
    font-family: var(--font-heading--family, var(--font-body--family, 'Inter', sans-serif));
    font-size: clamp(36px, 5.5vw, 64px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--_text);
    margin: 0 0 1.25rem;
    text-wrap: balance;
  }
  .casa-policy__title em {
    font-style: italic;
    font-weight: 800;
    background-image: var(--_grad-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }
  .casa-policy__updated {
    display: block;
    font-family: var(--font-mono--family, 'JetBrains Mono', monospace);
    font-size: 12px;
    color: var(--_muted);
    letter-spacing: 0.05em;
  }

  /* ═══════════════ BODY ═══════════════ */
  .casa-policy__body {
    padding: 3rem 1.5rem 5rem;
  }
  @media (min-width: 900px) {
    .casa-policy__body { padding: 4rem 2.5rem 7rem; }
  }
  .casa-policy__body-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .casa-policy__body-inner {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 5rem;
    }
  }

  /* ── TOC sidebar ── */
  .casa-policy__toc {
    align-self: start;
    position: relative;
  }
  @media (min-width: 1024px) {
    .casa-policy__toc {
      position: sticky;
      /* Clear the sticky site header (incl. announcement bar) so the
         "ON THIS PAGE" label isn't cut off. Tracks the live header height
         like the anchor offset; falls back to the 80px default. */
      top: calc(var(--casa-chrome-top, var(--header-group-height, var(--header-height, 80px))) + 1.5rem);
    }
  }
  .casa-policy__toc-label {
    display: block;
    font-family: var(--font-mono--family, 'JetBrains Mono', monospace);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--_muted);
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--_rule);
  }
  .casa-policy__toc-nav {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .casa-policy__toc-nav a {
    color: var(--_muted);
    font-size: 13px;
    line-height: 1.5;
    text-decoration: none;
    transition: color 0.2s ease;
    padding-left: 0;
    border-left: 2px solid transparent;
    padding: 0.25rem 0 0.25rem 0.75rem;
    margin-left: -0.75rem;
  }
  .casa-policy__toc-nav a:hover,
  .casa-policy__toc-nav a:focus-visible {
    color: var(--_text);
  }
  .casa-policy__toc-nav a.is-active {
    color: var(--_text);
    border-left-color: var(--_a1);
  }
  .casa-policy__toc-nav .casa-policy__toc--h3 {
    padding-left: 1.75rem;
    font-size: 12px;
    margin-left: -0.75rem;
  }

  /* Hide empty TOC (no headings found) */
  .casa-policy__toc-nav:empty,
  .casa-policy__toc:has(.casa-policy__toc-nav:empty) {
    display: none;
  }

  /* ── Prose ── */
  .casa-policy__prose {
    max-width: var(--_prose-mw);
    color: var(--_text);
    font-size: 16px;
    line-height: 1.75;
  }
  @media (min-width: 750px) {
    .casa-policy__prose { font-size: 17px; }
  }
  .casa-policy__prose > * + * { margin-top: 1.25rem; }
  .casa-policy__prose h1 {
    font-family: var(--font-heading--family, var(--font-body--family, 'Inter', sans-serif));
    font-size: clamp(26px, 3vw, 32px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--_text);
    margin: 3rem 0 1.5rem;  }
  .casa-policy__prose h2 {
    font-family: var(--font-heading--family, var(--font-body--family, 'Inter', sans-serif));
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--_text);
    margin: 2.75rem 0 1.25rem;  }
  .casa-policy__prose h3,
  .casa-policy__prose h4,
  .casa-policy__prose h5 {
    font-family: var(--font-heading--family, var(--font-body--family, 'Inter', sans-serif));
    font-size: clamp(16px, 1.5vw, 18px);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--_text);
    text-transform: none;
    margin: 2.25rem 0 0.75rem;  }
  .casa-policy__prose h5 strong {
    font-family: var(--font-mono--family, 'JetBrains Mono', monospace);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--_muted);
  }
  .casa-policy__prose p {
    margin: 0 0 1.25rem;
    color: var(--_text);
  }
  .casa-policy__prose strong,
  .casa-policy__prose b {
    font-weight: 600;
    color: var(--_text);
  }
  .casa-policy__prose em,
  .casa-policy__prose i {
    font-style: italic;
  }
  .casa-policy__prose a {
    color: var(--_text);
    text-decoration: underline;
    text-decoration-color: var(--_a1);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.2s ease, text-decoration-thickness 0.2s ease;
  }
  .casa-policy__prose a:hover,
  .casa-policy__prose a:focus-visible {
    text-decoration-color: var(--_a2);
    text-decoration-thickness: 2px;
  }
  .casa-policy__prose ul,
  .casa-policy__prose ol {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
  }
  .casa-policy__prose li {
    margin: 0 0 0.625rem;
    color: var(--_text);
  }
  .casa-policy__prose li::marker {
    color: var(--_muted);
  }
  .casa-policy__prose blockquote {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border-left: 2px solid var(--_a1);
    background: rgba(255, 255, 255, 0.02);
    color: var(--_text);
    font-style: italic;
  }
  .casa-policy__prose code {
    font-family: var(--font-mono--family, 'JetBrains Mono', monospace);
    font-size: 0.9em;
    background: rgba(255, 255, 255, 0.06);
    padding: 0.125rem 0.4rem;
    border-radius: 3px;
  }
  .casa-policy__prose pre {
    font-family: var(--font-mono--family, 'JetBrains Mono', monospace);
    background: rgba(255, 255, 255, 0.04);
    padding: 1.25rem;
    border-radius: 6px;
    overflow-x: auto;
    border: 1px solid var(--_rule);
    margin: 1.5rem 0;
  }
  .casa-policy__prose hr {
    border: 0;
    border-top: 1px solid var(--_rule);
    margin: 2.5rem 0;
  }
  .casa-policy__prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 14px;
  }
  .casa-policy__prose th,
  .casa-policy__prose td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--_rule);
    text-align: left;
  }
  .casa-policy__prose th {
    font-weight: 600;
    color: var(--_text);
    background: rgba(255, 255, 255, 0.02);
  }
  .casa-policy__prose img {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    margin: 1.5rem 0;
  }

  /* ═══════════════ OTHER POLICIES ═══════════════ */
  .casa-policy__other {
    border-top: 1px solid var(--_rule);
    padding: 3rem 1.5rem;
  }
  @media (min-width: 900px) {
    .casa-policy__other { padding: 4rem 2.5rem; }
  }
  .casa-policy__other-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .casa-policy__other-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  @media (min-width: 750px) {
    .casa-policy__other-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem 2rem;
    }
  }
  .casa-policy__other-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--_text);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    padding: 0.5rem 0;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .casa-policy__other-link::after {
    content: '→';
    font-size: 14px;
    opacity: 0.6;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .casa-policy__other-link:hover,
  .casa-policy__other-link:focus-visible {
    color: var(--_text);
    border-bottom-color: var(--_a1);
  }
  .casa-policy__other-link:hover::after {
    transform: translateX(3px);
    opacity: 1;
  }

  /* ═══════════════ MOBILE ═══════════════ */
  @media (max-width: 1023px) {
    .casa-policy__toc {
      padding: 1rem 1.25rem;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--_rule);
      border-radius: 4px;
    }
  }
{% endstylesheet %}

<script>
  (function(){
    // Build TOC from h2 / h3 inside the prose
    const prose = document.querySelector('.casa-policy [data-casa-policy-prose]');
    const tocNav = document.querySelector('.casa-policy [data-casa-policy-toc]');
    if (!prose || !tocNav) return;

    const headings = prose.querySelectorAll('h2, h3');
    if (!headings.length) {
      // No TOC-worthy headings — hide the TOC sidebar entirely.
      const tocAside = tocNav.closest('.casa-policy__toc');
      if (tocAside) tocAside.style.display = 'none';
      return;
    }

    const slugify = function(s){
      return (s || '').toString().toLowerCase()
        .replace(/[^\w\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '')
        .slice(0, 60) || ('section-' + Math.random().toString(36).slice(2,7));
    };

    const usedIds = new Set();
    const items = [];
    headings.forEach(function(h){
      let id = h.id || slugify(h.textContent);
      let attempt = id, n = 1;
      while (usedIds.has(attempt)) { attempt = id + '-' + (++n); }
      h.id = attempt;
      usedIds.add(attempt);
      items.push({ id: attempt, text: h.textContent.trim(), level: h.tagName.toLowerCase() });
    });

    const frag = document.createDocumentFragment();
    items.forEach(function(it){
      const a = document.createElement('a');
      a.href = '#' + it.id;
      a.textContent = it.text;
      if (it.level === 'h3') a.classList.add('casa-policy__toc--h3');
      frag.appendChild(a);
    });
    tocNav.appendChild(frag);

    // Highlight current section while scrolling
    if ('IntersectionObserver' in window) {
      const linkMap = {};
      tocNav.querySelectorAll('a').forEach(function(a){ linkMap[a.getAttribute('href').slice(1)] = a; });
      const io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (e.isIntersecting) {
            tocNav.querySelectorAll('a.is-active').forEach(function(a){ a.classList.remove('is-active'); });
            const a = linkMap[e.target.id];
            if (a) a.classList.add('is-active');
          }
        });
      }, { rootMargin: '-20% 0px -60% 0px', threshold: 0 });
      headings.forEach(function(h){ io.observe(h); });
    }
  })();
</script>

{% schema %}
{
  "name": "Policy Page",
  "tag": "section",
  "class": "casa-policy-section",
  "settings": [
    { "type": "header", "content": "Surface" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0A0A0F" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#FAFAF7" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "info": "Kickers, table of contents, dates", "default": "#A3A3A3" },
    { "type": "color", "id": "rule_color", "label": "Divider line", "default": "#1F1F24" },
    { "type": "header", "content": "Accent gradient" },
    { "type": "color", "id": "accent_primary", "label": "Accent 1", "default": "#B0C3FA" },
    { "type": "color", "id": "accent_secondary", "label": "Accent 2", "default": "#5E0A02" },
    { "type": "color", "id": "accent_tertiary", "label": "Accent 3", "default": "#F2FFA0" },
    { "type": "header", "content": "Layout" },
    { "type": "text", "id": "kicker_text", "label": "Mono kicker label", "info": "Shows above the policy title — e.g. LEGAL, INFORMATION", "default": "LEGAL" },
    { "type": "range", "id": "prose_max_width", "label": "Prose column width", "min": 600, "max": 960, "step": 20, "unit": "px", "default": 760 },
    { "type": "checkbox", "id": "show_toc", "label": "Show table of contents", "info": "Auto-built from H2/H3 headings on desktop. Hidden if the policy has no headings.", "default": true },
    { "type": "checkbox", "id": "show_other_policies", "label": "Show \"Other policies\" links at bottom", "default": true },
    { "type": "checkbox", "id": "show_updated", "label": "Show last-updated date under the title", "default": true }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Policy Page"
    }
  ]
}
{% endschema %}
