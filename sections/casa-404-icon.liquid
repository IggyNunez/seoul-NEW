{%- comment -%}
  Casa 404 icon — inline SVG of a lightbulb with a broken filament
  and small smoke wisps rising from the top. Lives in Liquid (not in
  a richtext field) because Shopify's richtext type strips <svg>.
  Used at the top of the 404 page to anchor the "bulb burned out"
  headline. Configurable color, size, and padding.
{%- endcomment -%}

<div
  class="casa-404-icon casa-404-icon--align-{{ section.settings.alignment }}"
  style="
    --casa-404-icon-color: {{ section.settings.icon_color }};
    --casa-404-icon-size: {{ section.settings.icon_size }}px;
    --casa-404-icon-padding-top: {{ section.settings.padding_top }}px;
    --casa-404-icon-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <svg
    class="casa-404-icon__svg"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 56 72"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    {%- comment -%} smoke wisps rising from the top {%- endcomment -%}
    <path d="M24 8 q-2 -3, 0 -6" stroke-width="1.5" opacity="0.55"/>
    <path d="M32 6 q2 -2, 1 -4" stroke-width="1.5" opacity="0.4"/>
    {%- comment -%} bulb glass {%- endcomment -%}
    <path d="M28 14 c-8 0 -14 6 -14 14 c0 5 3 9 7 12 v4 h14 v-4 c4 -3 7 -7 7 -12 c0 -8 -6 -14 -14 -14z"/>
    {%- comment -%} screw base threads {%- endcomment -%}
    <line x1="20" y1="48" x2="36" y2="48"/>
    <line x1="22" y1="52" x2="34" y2="52"/>
    <line x1="24" y1="56" x2="32" y2="56"/>
    {%- comment -%} broken filament — left half {%- endcomment -%}
    <path d="M21 32 l3 -3 l2 4"/>
    {%- comment -%} broken filament — right half (with gap in the middle = "burned out") {%- endcomment -%}
    <path d="M30 33 l2 -4 l3 3"/>
  </svg>
</div>

{% stylesheet %}
.casa-404-icon {
  display: flex;
  align-items: center;
  padding-top: var(--casa-404-icon-padding-top, 60px);
  padding-bottom: var(--casa-404-icon-padding-bottom, 8px);
  background: transparent;
}
.casa-404-icon--align-center { justify-content: center; }
.casa-404-icon--align-left   { justify-content: flex-start; padding-left: 24px; }
.casa-404-icon--align-right  { justify-content: flex-end; padding-right: 24px; }

.casa-404-icon__svg {
  color: var(--casa-404-icon-color, #B0C3FA);
  width: var(--casa-404-icon-size, 80px);
  height: auto;
  display: block;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Casa 404 Icon",
  "tag": "section",
  "class": "casa-404-icon-wrapper",
  "settings": [
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#B0C3FA"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 40,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Casa 404 Icon",
      "category": "Layout"
    }
  ]
}
{% endschema %}
