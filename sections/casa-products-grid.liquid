{% stylesheet %}
/* ==========================================================================
   BASE STYLES
   ========================================================================== */

.casa-products-grid {
  position: relative;
  padding: var(--pg-padding-top, var(--casa-section-pt, 80px)) 80px var(--pg-padding-bottom, var(--casa-section-pb, 80px));
  overflow: hidden;
  width: 100%;
  max-width: 100vw;
  box-sizing: border-box;
}

.casa-products-grid__container {
  max-width: var(--pg-max-w, 1400px);
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

/* Ultrawide guardrail: carousel slides are ¼ of this container, so a
   full-width container means 799px product cards at 3440px. Capping past
   1920px holds cards at their ≤1920 size (~420px). min() lets the narrower
   contained/wide/narrow presets keep winning; only "full" is affected. */
@media screen and (min-width: 1920px) {
  .casa-products-grid__container {
    max-width: min(var(--pg-max-w, 1400px), var(--casa-content-max-w, 1920px));
  }
}

/* ==========================================================================
   BACKGROUNDS
   ========================================================================== */

/* Brand v1 surface lock: brand book mandates Paper or Ink, no others.
   "Light" and "subtle" both resolve to Paper so the merchant's existing
   choice keeps working but lands on a brand-legal value. See
   docs/brand-book-v1.html §Surfaces. */
.casa-products-grid--bg-light {
  background: var(--bg-paper, var(--casa-paper));
}

.casa-products-grid--bg-subtle {
  background: var(--bg-paper, var(--casa-paper));
}

.casa-products-grid--bg-dark {
  background: var(--bg-dark, var(--casa-ink));
}

.casa-products-grid--bg-gradient-dark {
  background: linear-gradient(180deg, #0a0a0f 0%, #12121a 50%, #0a0a0f 100%);
}

/* Ambient glow — soft halo. Fixed size by design (decorative ornament
   behind the grid, not a content surface). Overflow handled by parent
   overflow: hidden on the section.
   Pre-blurred radial-gradient instead of filter: blur(120px): the two
   120px kernels were the largest blur rasters in the theme (~500×500
   each) and re-rastered on scroll-into-view — same raster-budget class
   as the 2026-07-15 fast-scroll white-outs. The gradient paints in one
   cheap pass with an equivalent soft falloff (box enlarged to cover the
   spread the blur used to add). */
.casa-products-grid__ambient-glow {
  position: absolute;
  width: min(760px, 90vw);
  height: min(760px, 90vw);
  aspect-ratio: 1;
  border-radius: 50%;
  opacity: 0.3;
  pointer-events: none;
}

.casa-products-grid__ambient-glow--left {
  top: 20%;
  left: -10%;
  background: radial-gradient(circle closest-side,
    var(--pg-accent-primary) 0%,
    color-mix(in srgb, var(--pg-accent-primary) 78%, transparent) 24%,
    color-mix(in srgb, var(--pg-accent-primary) 42%, transparent) 48%,
    color-mix(in srgb, var(--pg-accent-primary) 16%, transparent) 70%,
    transparent 92%);
}

.casa-products-grid__ambient-glow--right {
  bottom: 20%;
  right: -10%;
  background: radial-gradient(circle closest-side,
    var(--pg-accent-secondary) 0%,
    color-mix(in srgb, var(--pg-accent-secondary) 78%, transparent) 24%,
    color-mix(in srgb, var(--pg-accent-secondary) 42%, transparent) 48%,
    color-mix(in srgb, var(--pg-accent-secondary) 16%, transparent) 70%,
    transparent 92%);
}

/* ==========================================================================
   HEADER
   ========================================================================== */

.casa-products-grid__header {
  margin-bottom: 60px;
}

.casa-products-grid__header--left {
  text-align: left;
}

.casa-products-grid__header--center {
  text-align: center;
}

.casa-products-grid__header--right {
  text-align: right;
}

/* Eyebrow / kicker — brand "spec register": JetBrains Mono UPPERCASE,
   0.08–0.12em tracking. Distinguishes from the voice register (Inter
   sentence case) so the heading composition reads as label → voice →
   support, not three lines of similar text. See locked typography
   memory: "Mono labels stay distinct: UPPERCASE JetBrains Mono". */
.casa-products-grid__tag {
  display: inline-block;
  font-family: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
  font-size: 12px;
  font-weight: 600;
  color: var(--pg-tag-color);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  margin-bottom: 16px;
}

.casa-products-grid__title {
  /* Brand book v1 §03 locked H2 spec — Inter 500 / -0.015em / 1.10 LH.
     white-space: nowrap forces single-line per merchant. Lower clamp
     min (22 vs brand 28) ensures the longer titles fit on phones once
     the em accent (1.15× size) is included. */
  font-size: clamp(22px, 4vw, 40px);
  font-weight: 500;
  line-height: 1.10;
  letter-spacing: -0.015em;
  text-transform: none;
  margin: 0 0 16px 0;
  color: var(--pg-text-primary);
  white-space: nowrap;
}

/* Italic-gradient <em> accent — LARGER (1.15em) per merchant. Italic
   600 weight + brand gradient. line-height: 1 keeps the title row from
   inflating with the bigger em. */
.casa-products-grid__title em {
  font-size: 1.15em;
  font-style: italic;
  font-weight: 600;
  line-height: 1;
  background-image: var(--grad-text, linear-gradient(90deg, #B0C3FA, #5E0A02, #F2FFA0));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}

/* Section divider hidden by default — brand "quiet chrome" reserves
   gradient + purple for hero accent / stats / links / focus rings.
   A decorative rule between title and subtitle adds chrome the brand
   book doesn't sanction. Typography hierarchy carries the heading on
   its own. The element stays in the markup so the merchant's existing
   "Show divider" toggle keeps doing nothing harmful. */
.casa-products-grid__divider {
  display: none;
}

.casa-products-grid__header--center .casa-products-grid__divider {
  margin-left: auto;
  margin-right: auto;
}

.casa-products-grid__header--right .casa-products-grid__divider {
  margin-left: auto;
}

.casa-products-grid__subtitle {
  /* Brand subtitle: muted ink on Paper. Uses --t-on-light-muted token
     so it lands on the brand-canonical secondary color instead of
     a one-off Tailwind gray that the merchant theme settings happen
     to emit. Sized up slightly (17→18) so it has presence under
     the H1 instead of disappearing as fine print. */
  font-size: var(--casa-subtitle-size, 18px);
  color: var(--pg-text-secondary, var(--t-on-light-muted, #54545C));
  max-width: 540px;
  margin: 0;
  line-height: 1.55;
}

.casa-products-grid__header--center .casa-products-grid__subtitle {
  margin-left: auto;
  margin-right: auto;
}

.casa-products-grid__header--right .casa-products-grid__subtitle {
  margin-left: auto;
}

/* ==========================================================================
   GRID LAYOUTS
   ========================================================================== */

.casa-products-grid__grid {
  display: grid;
  grid-template-columns: repeat(var(--pg-columns), minmax(0, 1fr));
  gap: var(--pg-gap);
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.casa-products-grid__track-wrapper {
  position: relative;
  isolation: isolate;
}

.casa-products-grid__overlay-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 20;
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  border: 1px solid rgba(0, 0, 0, 0.08);
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  will-change: backdrop-filter; /* GPU layer: avoid per-frame re-blur (perf, matches 2026-05-17 flicker-fix sweep) */
  color: var(--casa-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: opacity 0.2s ease, transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
}
.casa-products-grid--bg-dark .casa-products-grid__overlay-arrow,
.casa-products-grid--bg-gradient-dark .casa-products-grid__overlay-arrow {
  background: rgba(10, 10, 15, 0.78);
  border-color: rgba(255, 255, 255, 0.18);
  color: #fff;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
}
.casa-products-grid__overlay-arrow:hover:not(:disabled) {
  background: var(--casa-paper);
  color: var(--casa-ink);
  transform: translateY(-50%) scale(1.05);
  box-shadow:
    0 6px 20px rgba(0, 0, 0, 0.15),
    0 0 0 4px rgba(176, 195, 250, 0.18),
    0 0 22px rgba(94, 10, 2, 0.35);
}
.casa-products-grid__overlay-arrow:disabled {
  opacity: 0.35;
  cursor: default;
}
.casa-products-grid__overlay-arrow.is-hidden {
  opacity: 0;
  pointer-events: none;
}
.casa-products-grid__overlay-arrow--prev { left: -8px; }
.casa-products-grid__overlay-arrow--next { right: -8px; }

@media (min-width: 901px) {
  .casa-products-grid__track-wrapper--mobile-only .casa-products-grid__overlay-arrow {
    display: none;
  }
}

@media (max-width: 900px) {
  .casa-products-grid__overlay-arrow {
    width: 40px;
    height: 40px;
  }
  .casa-products-grid__overlay-arrow--prev { left: 4px; }
  .casa-products-grid__overlay-arrow--next { right: 4px; }
}

/* Featured layout - first item larger */
.casa-products-grid--featured .casa-products-grid__grid {
  grid-template-columns: repeat(var(--pg-columns), minmax(0, 1fr));
}

.casa-products-grid--featured .casa-products-grid__item:first-child {
  grid-column: span 2;
  grid-row: span 2;
}

/* Carousel layout */
.casa-products-grid--carousel .casa-products-grid__grid {
  display: flex;
  gap: var(--pg-gap);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  padding-bottom: 20px;
}

.casa-products-grid--carousel .casa-products-grid__grid::-webkit-scrollbar {
  display: none;
}

.casa-products-grid--carousel .casa-products-grid__item {
  flex: 0 0 calc((100% - var(--pg-gap) * 3) / 4);
  scroll-snap-align: start;
}

/* ==========================================================================
   ITEMS & ANIMATIONS
   ========================================================================== */

.casa-products-grid__item {
  /* Flex column so the casa-product-card child can stretch via
     height:100% to fill the grid track height. Without display:flex
     here, the item is block-level and the card content-sizes — cards
     with real swatches end up taller than cards with reserve, leaving
     a visible card-frame gap on the shorter ones. */
  display: flex;
  flex-direction: column;
  align-self: stretch;
  /* min-width:0 caps the slide at its flex-basis. Without it the slide
     keeps min-width:auto (= its content min-content), and SHIPPING Safari
     leaks the overflow-clipped variant-swatch row's FULL width up the
     flex chain (slide → card → __info), so the card with the most
     variants (e.g. Bubble Girls) grows wider than its 25%/33% track —
     and aspect-ratio:1 on __image turns that extra width into extra
     height, making one card's image visibly larger. Chromium and
     Playwright-WebKit clamp to the basis and never show it; only real
     Safari does. Same guard already used on __swatches one level deeper. */
  min-width: 0;
  opacity: 0;
  transform: translateY(30px);
  transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1),
              transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  transition-delay: var(--item-delay, 0ms);
}

.casa-products-grid__item--visible {
  opacity: 1;
  transform: translateY(0);
}

/* Animation variants */
.casa-products-grid[data-animation="fade-in"] .casa-products-grid__item {
  transform: none;
}

.casa-products-grid[data-animation="scale-up"] .casa-products-grid__item {
  transform: scale(0.9);
}

.casa-products-grid[data-animation="scale-up"] .casa-products-grid__item--visible {
  transform: scale(1);
}

.casa-products-grid[data-animation="slide-in"] .casa-products-grid__item {
  transform: translateX(-30px);
}

.casa-products-grid[data-animation="slide-in"] .casa-products-grid__item--visible {
  transform: translateX(0);
}

.casa-products-grid[data-animation="none"] .casa-products-grid__item {
  opacity: 1;
  transform: none;
}

/* ==========================================================================
   FOOTER / VIEW ALL
   ========================================================================== */

.casa-products-grid__footer {
  text-align: center;
  margin-top: 48px;
}

/* View-all uses the Casa global utility button system —
   adaptive neutral pill (black on light sections, white on dark
   sections). Single source of truth: --casa-btn-utility-* vars
   in theme-styles-variables.liquid */
.casa-products-grid__view-all {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: var(--casa-btn-utility-padding-y) var(--casa-btn-utility-padding-x);
  background: var(--casa-btn-utility-bg);
  color: var(--casa-btn-utility-color);
  border: none;
  border-radius: var(--casa-btn-utility-radius);
  font-family: var(--casa-btn-utility-font-family);
  font-size: var(--casa-btn-utility-font-size);
  font-weight: var(--casa-btn-utility-font-weight);
  text-transform: var(--casa-btn-utility-transform);
  letter-spacing: var(--casa-btn-utility-tracking);
  text-decoration: none;
  transition: background 0.25s ease, transform 0.25s ease;
}

.casa-products-grid__view-all:hover {
  background: var(--casa-btn-utility-hover-bg);
  transform: translateY(-1px);
}

.casa-products-grid__view-all svg {
  transition: transform 0.3s ease;
}

.casa-products-grid__view-all:hover svg {
  transform: translateX(4px);
}

/* ==========================================================================
   PLACEHOLDERS
   ========================================================================== */

.casa-products-grid__placeholder {
  background: var(--casa-paper);
  border-radius: 20px;
  overflow: hidden;
}

.casa-products-grid--bg-dark .casa-products-grid__placeholder,
.casa-products-grid--bg-gradient-dark .casa-products-grid__placeholder {
  background: rgba(255, 255, 255, 0.05);
}

.casa-products-grid__placeholder-image {
  aspect-ratio: 1;
  background: linear-gradient(135deg, #f5f5f7, #e5e5ea);
  display: flex;
  align-items: center;
  justify-content: center;
}

.casa-products-grid--bg-dark .casa-products-grid__placeholder-image,
.casa-products-grid--bg-gradient-dark .casa-products-grid__placeholder-image {
  background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.05));
}

.casa-products-grid__placeholder-shape {
  width: 50%;
  height: 50%;
  background: linear-gradient(135deg, var(--pg-accent-primary), var(--pg-accent-secondary));
  clip-path: polygon(30% 0%, 70% 0%, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0% 70%, 0% 30%);
  opacity: 0.5;
  /* perf-justified: placeholder shimmer only renders when a product
     card has no image — empty-state loading affordance. animates
     opacity/transform (compositor-only). Not on critical path. */
  animation: pgPlaceholderPulse 2s ease-in-out infinite;
}

@keyframes pgPlaceholderPulse {
  0%, 100% { opacity: 0.3; transform: scale(0.95); }
  50% { opacity: 0.6; transform: scale(1); }
}

.casa-products-grid__placeholder-info {
  padding: 24px;
}

.casa-products-grid__placeholder-title {
  height: 20px;
  background: #e5e5e5;
  border-radius: 4px;
  margin-bottom: 12px;
}

.casa-products-grid--bg-dark .casa-products-grid__placeholder-title,
.casa-products-grid--bg-gradient-dark .casa-products-grid__placeholder-title {
  background: rgba(255, 255, 255, 0.1);
}

.casa-products-grid__placeholder-price {
  height: 16px;
  width: 60%;
  background: #e5e5e5;
  border-radius: 4px;
}

.casa-products-grid--bg-dark .casa-products-grid__placeholder-price,
.casa-products-grid--bg-gradient-dark .casa-products-grid__placeholder-price {
  background: rgba(255, 255, 255, 0.1);
}

/* ==========================================================================
   RESPONSIVE
   ========================================================================== */

@media (max-width: 1200px) {
  .casa-products-grid {
    padding: var(--pg-padding-top, var(--casa-section-pt, 60px)) 40px var(--pg-padding-bottom, var(--casa-section-pb, 60px));
  }

  .casa-products-grid__grid {
    --pg-columns: 3;
  }

  .casa-products-grid--carousel .casa-products-grid__item {
    flex: 0 0 calc((100% - var(--pg-gap) * 2) / 3);
  }
}

@media (max-width: 900px) {
  .casa-products-grid__grid {
    --pg-columns: var(--pg-columns-mobile, 2);
    gap: 24px;
  }

  /* Disable entrance animations on mobile — instant reveal */
  .casa-products-grid__item {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
    animation: none !important;
  }

  /* Mobile: tighter clamp so the longest title on this section
     ("Five shapes. One transformation.") fits on one line at 320px.
     white-space: nowrap inherited from base. */
  .casa-products-grid__title {
    font-size: clamp(14px, 4.5vw, 22px);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .casa-products-grid__title em {
    font-size: 1.15em;
  }
  .casa-products-grid__subtitle {
    font-size: var(--casa-subtitle-size, 16px);
  }

  .casa-products-grid__header {
    margin-bottom: 40px;
  }

  .casa-products-grid--featured .casa-products-grid__item:first-child {
    grid-column: span 2;
    grid-row: span 1;
  }

  .casa-products-grid--carousel .casa-products-grid__item {
    flex: 0 0 calc((100% - var(--pg-gap)) / 2);
  }

  .casa-products-grid__ambient-glow {
    /* Scaled with the base rule's 500→760 change: the old 300px box got
       its visible spread from filter: blur(120px) (the override never
       touched filter); the gradient's falloff ends inside the box, so
       the box itself must carry the old footprint. */
    width: min(456px, 90vw);
    height: min(456px, 90vw);
  }
}

@media (max-width: 600px) {
  .casa-products-grid {
    padding: var(--pg-padding-mobile-top, var(--casa-section-pt-m, 40px)) 20px var(--pg-padding-mobile-bottom, var(--casa-section-pb-m, 40px));
  }

  .casa-products-grid__grid {
    gap: 16px;
  }

  /* Title font-size handled by Horizon heading tokens. */

  .casa-products-grid--featured .casa-products-grid__item:first-child {
    grid-column: span 1;
  }

  /* ~1.8 cards visible — partial 2nd card peeks to signal "scroll for more".
     Mirrors casa-recently-viewed.liquid:1244 peek pattern. Replaces a
     fixed 280px width that, on a 375px viewport with 20px side-padding,
     left only ~55px for the next card to peek (looked like 1 card). */
  .casa-products-grid--carousel .casa-products-grid__item {
    flex: 0 0 calc(55% - 6px);
    min-width: calc(55% - 6px);
  }

  .casa-products-grid__view-all {
    padding: 14px 24px;
    font-size: 13px;
  }

  .casa-products-grid__footer {
    margin-top: 32px;
  }
}

/* ==========================================================================
   REDUCED MOTION
   ========================================================================== */

@media (prefers-reduced-motion: reduce) {
  .casa-products-grid__item {
    opacity: 1;
    transform: none;
    transition: none;
  }

  .casa-products-grid__view-all {
    transition: none;
  }

  .casa-products-grid__placeholder-shape {
    animation: none;
  }
}
{% endstylesheet %}
