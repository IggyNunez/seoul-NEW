{%- comment -%}
  Seoul Glow Lab Products Grid Section
  Premium product grid with animations, multiple layouts, CRO features, and full customization
{%- endcomment -%}

{%- liquid
  # Layout settings
  assign layout = section.settings.layout | default: 'grid'
  assign columns = section.settings.columns | default: 4
  assign mobile_columns = section.settings.mobile_columns | default: 2
  # Card img `sizes`, computed from the configured column counts so the
  # srcset pick matches the real slot width (the 901-1200px band is
  # hardcoded 3-col in the CSS below; ≤900px reads mobile_columns).
  # Carousel item widths are hardcoded viewport fractions (1/4 → 1/3 →
  # 1/2 → 55%) that match the snippet's own default sizes, so carousel
  # passes nil and lets the snippet default apply. mobile_columns is a
  # select string — plus: 0 coerces for math.
  assign _pg_cols_n = columns | plus: 0
  assign _pg_mobile_n = mobile_columns | plus: 0
  assign _pg_share_d = 100 | divided_by: _pg_cols_n
  assign _pg_share_m = 100 | divided_by: _pg_mobile_n
  assign card_sizes = nil
  assign featured_first_sizes = nil
  unless layout == 'carousel'
    assign card_sizes = '(min-width: 1201px) ' | append: _pg_share_d | append: 'vw, (min-width: 901px) 33vw, ' | append: _pg_share_m | append: 'vw'
  endunless
  if layout == 'featured'
    # Featured first card: span 2 columns >900px (66vw in the 3-col
    # band), still span 2 of the mobile columns at 601-900px, span 1
    # below 600px (see the featured :first-child rules in the CSS).
    assign _pg_share_d2 = _pg_share_d | times: 2 | at_most: 100
    assign featured_first_sizes = '(min-width: 1201px) ' | append: _pg_share_d2 | append: 'vw, (min-width: 901px) 66vw, (min-width: 601px) 100vw, ' | append: _pg_share_m | append: 'vw'
  endif
  assign gap = section.settings.gap | default: 32
  assign product_limit = section.settings.product_limit | default: 4

  # Style settings
  assign bg_style = section.settings.background_style | default: 'light'
  assign accent_primary = section.settings.accent_primary | default: '#B0C3FA'
  assign accent_secondary = section.settings.accent_secondary | default: '#5E0A02'
  assign card_style = section.settings.card_style | default: 'default'

  # Animation settings
  assign animation = section.settings.animation | default: 'fade-up'
  assign stagger_delay = section.settings.stagger_delay | default: 100

  # Padding
  assign padding_top = section.settings.padding_top | default: 120
  assign padding_bottom = section.settings.padding_bottom | default: 120
  assign padding_mobile_top = section.settings.padding_mobile_top | default: 60
  assign padding_mobile_bottom = section.settings.padding_mobile_bottom | default: 60

  # Header settings
  assign header_alignment = section.settings.header_alignment | default: 'center'
  assign title_size = section.settings.title_size | default: 'large'
  assign show_divider = section.settings.show_divider

  # Card settings — single override gate for display + CRO flags.
  # Only assign these section-level values when the override is ON.
  # Otherwise leave them as nil so casa-product-card falls back to
  # its theme-setting defaults (settings.card_*).
  assign override_card_features = section.settings.override_card_features
  if override_card_features
    # Display
    assign show_badge = section.settings.show_badge
    assign show_sale_badge = section.settings.show_sale_badge
    assign show_rating = section.settings.show_rating
    assign show_price = section.settings.show_price
    # CRO
    assign show_quick_add = section.settings.show_quick_add
    assign show_variant_swatches = section.settings.show_variant_swatches
    assign show_wishlist = section.settings.show_wishlist
    assign show_stock_urgency = section.settings.show_stock_urgency
    assign stock_threshold = section.settings.stock_threshold | default: 5
    assign show_installment = section.settings.show_installment
    assign installment_count = section.settings.installment_count | default: 4
    assign show_quick_view = section.settings.show_quick_view
    assign show_hover_video = section.settings.show_hover_video
    assign show_savings_highlight = section.settings.show_savings_highlight
    assign show_social_proof = section.settings.show_social_proof
  endif

  # Text colors based on background
  if bg_style == 'dark' or bg_style == 'gradient-dark'
    assign text_primary = '#ffffff'
    assign text_secondary = 'rgba(255, 255, 255, 0.7)'
    assign tag_color = accent_primary
  else
    assign text_primary = 'var(--casa-ink)'
    assign text_secondary = '#6b7280'
    assign tag_color = accent_primary
  endif

  # Title sizes
  case title_size
    when 'small'
      assign title_font_size = '32px'
      assign title_font_size_mobile = '24px'
    when 'medium'
      assign title_font_size = '40px'
      assign title_font_size_mobile = '28px'
    when 'large'
      assign title_font_size = '48px'
      assign title_font_size_mobile = '32px'
    when 'xlarge'
      assign title_font_size = '56px'
      assign title_font_size_mobile = '36px'
  endcase

  # Get collection
  assign collection = collections[section.settings.collection]
-%}

<section
  id="casa-pg-{{ section.id }}"
  class="casa-products-grid casa-products-grid--{{ layout }} casa-products-grid--bg-{{ bg_style }} casa-products-grid--cards-{{ card_style }}"
  style="
    {%- if section.settings.override_spacing -%}
      --pg-padding-top: {{ padding_top }}px;
      --pg-padding-bottom: {{ padding_bottom }}px;
      --pg-padding-mobile-top: {{ padding_mobile_top }}px;
      --pg-padding-mobile-bottom: {{ padding_mobile_bottom }}px;
    {%- endif -%}
    --pg-columns: {{ columns }};
    --pg-columns-mobile: {{ mobile_columns }};
    --pg-gap: {{ gap }}px;
    --pg-accent-primary: {{ accent_primary }};
    --pg-accent-secondary: {{ accent_secondary }};
    --pg-text-primary: {{ text_primary }};
    --pg-text-secondary: {{ text_secondary }};
    --pg-tag-color: {{ tag_color }};
    {%- comment -%}
      Heading-scale dropdown: merchant picks H1-H6 from Theme Settings -> Typography.
    {%- endcomment -%}
    {%- assign _pg_title_h = section.settings.pg_heading_level | default: 'h1' -%}
    --pg-title-fs:   var(--font-{{ _pg_title_h }}--size);
    --pg-title-fw:   var(--font-{{ _pg_title_h }}--weight);
    --pg-title-lh:   var(--font-{{ _pg_title_h }}--line-height);
    --pg-title-ls:   var(--font-{{ _pg_title_h }}--letter-spacing);
    --pg-title-case: var(--font-{{ _pg_title_h }}--case);
    --pg-max-w: {% case section.settings.section_width %}{% when 'full' %}100%{% when 'wide' %}1600px{% when 'narrow' %}1200px{% else %}1400px{% endcase %};
  "
  data-animation="{{ animation }}"
>
  {%- comment -%} Ambient glow effects for dark backgrounds {%- endcomment -%}
  {%- if bg_style == 'dark' or bg_style == 'gradient-dark' -%}
    <div class="casa-products-grid__ambient-glow casa-products-grid__ambient-glow--left"></div>
    <div class="casa-products-grid__ambient-glow casa-products-grid__ambient-glow--right"></div>
  {%- endif -%}

  <div class="casa-products-grid__container">
    {%- comment -%} Header {%- endcomment -%}
    <div class="casa-products-grid__header casa-products-grid__header--{{ header_alignment }}">
      {%- if section.settings.tag != blank -%}
        <span class="casa-products-grid__tag">{{ section.settings.tag }}</span>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="casa-products-grid__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if show_divider -%}
        <div class="casa-products-grid__divider"></div>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="casa-products-grid__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} Products Grid {%- endcomment -%}
    {%- assign pg_is_carousel = false -%}
    {%- if layout == 'carousel' or section.settings.carousel_on_mobile -%}
      {%- assign pg_is_carousel = true -%}
    {%- endif -%}
    <div class="casa-products-grid__track-wrapper{% if pg_is_carousel %} casa-products-grid__track-wrapper--carousel{% endif %}{% if section.settings.carousel_on_mobile and layout != 'carousel' %} casa-products-grid__track-wrapper--mobile-only{% endif %}">
      {%- if pg_is_carousel -%}
        <button type="button" class="casa-products-grid__overlay-arrow casa-products-grid__overlay-arrow--prev" data-pg-prev aria-label="Scroll left" disabled>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" class="casa-products-grid__overlay-arrow casa-products-grid__overlay-arrow--next" data-pg-next aria-label="Scroll right">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      {%- endif -%}
    <div class="casa-products-grid__grid" role="list">
      {%- comment -%}
        On product pages, exclude the current product from the recs
        grid so a PDP doesn't recommend itself. Capture the handle
        before the loop (the loop var shadows the global `product`).
      {%- endcomment -%}
      {%- assign _pg_current_handle = '' -%}
      {%- if template contains 'product' and product != blank -%}
        {%- assign _pg_current_handle = product.handle -%}
      {%- endif -%}

      {%- if collection != blank and collection.products.size > 0 -%}
        {%- assign _pg_rendered = 0 -%}
        {%- assign _pg_rendered_idx = 0 -%}
        {%- for product in collection.products -%}
          {%- if _pg_rendered >= product_limit -%}{%- break -%}{%- endif -%}
          {%- if product.handle == _pg_current_handle -%}{%- continue -%}{%- endif -%}
          {%- comment -%}
            Stagger capped at index 4 so the 8th product card doesn't
            wait 800ms (8 × 100ms default) after intersection to fade
            in. Cap keeps the visual rhythm of the first ~5 cards
            without punishing late cards on fast scrolls.
          {%- endcomment -%}
          {%- assign _stagger_i = _pg_rendered_idx | at_most: 4 -%}
          <div
            class="casa-products-grid__item"
            style="--item-delay: {{ _stagger_i | times: stagger_delay }}ms;"
            role="listitem"
          >
            {%- liquid
              assign _card_sizes = card_sizes
              if layout == 'featured' and _pg_rendered_idx == 0
                assign _card_sizes = featured_first_sizes
              endif
            -%}
            {%- render 'casa-product-card',
              product: product,
              variant: card_style,
              index: _pg_rendered_idx,
              sizes: _card_sizes,
              show_badge: show_badge,
              show_sale_badge: show_sale_badge,
              show_rating: show_rating,
              show_price: show_price,
              show_quick_add: show_quick_add,
              show_variant_swatches: show_variant_swatches,
              show_wishlist: show_wishlist,
              show_stock_urgency: show_stock_urgency,
              stock_threshold: stock_threshold,
              show_installment: show_installment,
              installment_count: installment_count,
              show_quick_view: show_quick_view,
              show_hover_video: show_hover_video,
              show_savings_highlight: show_savings_highlight,
              show_social_proof: show_social_proof
            -%}
          </div>
          {%- assign _pg_rendered = _pg_rendered | plus: 1 -%}
          {%- assign _pg_rendered_idx = _pg_rendered_idx | plus: 1 -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Placeholder cards when no collection selected {%- endcomment -%}
        {%- for i in (1..product_limit) -%}
          {%- assign _stagger_i = forloop.index0 | at_most: 4 -%}
          <div class="casa-products-grid__item casa-products-grid__placeholder" style="--item-delay: {{ _stagger_i | times: stagger_delay }}ms;">
            <div class="casa-products-grid__placeholder-image">
              <div class="casa-products-grid__placeholder-shape"></div>
            </div>
            <div class="casa-products-grid__placeholder-info">
              <div class="casa-products-grid__placeholder-title"></div>
              <div class="casa-products-grid__placeholder-price"></div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    </div>{%- comment -%} /track-wrapper {%- endcomment -%}

    {%- comment -%} View All Button {%- endcomment -%}
    {%- if section.settings.view_all_text != blank and collection != blank -%}
      <div class="casa-products-grid__footer">
        <a href="{{ collection.url }}" class="casa-products-grid__view-all">
          <span>{{ section.settings.view_all_text }}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function() {
    function initProductsGrid() {
      var section = document.getElementById('casa-pg-{{ section.id }}');
      if (!section || section.dataset.initialized) return;
      section.dataset.initialized = 'true';

      var animation = section.dataset.animation;
      var items = section.querySelectorAll('.casa-products-grid__item');
      var isMobile = window.matchMedia('(max-width: 900px)').matches;

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || isMobile) {
        items.forEach(function(item) {
          item.classList.add('casa-products-grid__item--visible');
          item.style.animation = 'none';
        });
      } else if (animation && animation !== 'none') {
        /* rootMargin '400px' pre-loads the animation 400px BEFORE the
           item enters the viewport so the 600ms transition + stagger
           have time to complete before the user sees the card. Prior
           value was '-50px' which delayed trigger 50px PAST viewport
           edge — guaranteed blank cards on fast scroll, especially for
           the 4 product grids on the homepage. */
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('casa-products-grid__item--visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0, rootMargin: '0px 0px 400px 0px' });
        items.forEach(function(item) { observer.observe(item); });
        /* Safety net: if the observer hasn't fired within 1500ms of
           init (fast scroller, observer missed first callback, off-
           screen tab), force every card visible. Better to skip the
           entrance animation than to leave cards invisible. */
        setTimeout(function() {
          items.forEach(function(item) {
            if (!item.classList.contains('casa-products-grid__item--visible')) {
              item.classList.add('casa-products-grid__item--visible');
            }
          });
        }, 1500);
      } else {
        items.forEach(function(item) { item.classList.add('casa-products-grid__item--visible'); });
      }

      /* Overlay arrows for carousel layout */
      var grid = section.querySelector('.casa-products-grid__grid');
      var prevOverlay = section.querySelector('[data-pg-prev]');
      var nextOverlay = section.querySelector('[data-pg-next]');
      if (grid && (prevOverlay || nextOverlay)) {
        function pgUpdateArrows() {
          var sl = grid.scrollLeft;
          var maxScroll = grid.scrollWidth - grid.clientWidth;
          var atStart = sl <= 2;
          var atEnd = sl >= maxScroll - 2;
          var noOverflow = maxScroll <= 2;
          if (prevOverlay) {
            prevOverlay.disabled = atStart;
            prevOverlay.classList.toggle('is-hidden', noOverflow);
          }
          if (nextOverlay) {
            nextOverlay.disabled = atEnd;
            nextOverlay.classList.toggle('is-hidden', noOverflow);
          }
        }
        function pgScrollByDir(dir) {
          var firstItem = grid.querySelector('.casa-products-grid__item');
          if (!firstItem) return;
          var gap = parseInt(getComputedStyle(grid).gap || 16);
          var amount = (firstItem.offsetWidth + gap) * dir;
          grid.scrollBy({ left: amount, behavior: 'smooth' });
        }
        if (prevOverlay) prevOverlay.addEventListener('click', function(){ pgScrollByDir(-1); });
        if (nextOverlay) nextOverlay.addEventListener('click', function(){ pgScrollByDir(1); });
        grid.addEventListener('scroll', pgUpdateArrows, { passive: true });
        setTimeout(pgUpdateArrows, 100);
        window.addEventListener('resize', pgUpdateArrows, { passive: true });
      }
    }

    // Run now if DOM is ready, otherwise wait
    if (document.readyState !== 'loading') {
      initProductsGrid();
    } else {
      document.addEventListener('DOMContentLoaded', initProductsGrid);
    }

    // Re-init on Shopify section events (customizer add/reorder/select)
    document.addEventListener('shopify:section:load', function(e) {
      if (e.target.querySelector('#casa-pg-{{ section.id }}')) initProductsGrid();
    });
  })();
</script>

{% schema %}
{
  "name": "Casa Products Grid",
  "tag": "section",
  "class": "casa-products-grid-section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "Bestsellers"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "info": "Wrap a phrase in <em>...</em> for the brand italic-gradient accent (e.g. \"The room-changers. <em>Loved most.</em>\").",
      "default": "The room-changers. <em>Loved most.</em>"
    },
    {
      "type": "select",
      "id": "pg_heading_level",
      "label": "Title heading scale",
      "info": "Pulls size, weight, line-height, letter-spacing, and case from Theme Settings → Typography.",
      "options": [
        { "value": "h1", "label": "Heading 1" },
        { "value": "h2", "label": "Heading 2" },
        { "value": "h3", "label": "Heading 3" },
        { "value": "h4", "label": "Heading 4" },
        { "value": "h5", "label": "Heading 5" },
        { "value": "h6", "label": "Heading 6" }
      ],
      "default": "h1"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The pieces our customers can't stop talking about."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "info": "Deprecated — use Title heading scale instead. This field doesn't affect rendering.",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "xlarge", "label": "Extra Large" }
      ],
      "default": "large",
      "visible_if": "{{ false }}"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show gradient divider",
      "default": false
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all link text",
      "default": "Shop All"
    },
    {
      "type": "header",
      "content": "Card settings"
    },
    {
      "type": "paragraph",
      "content": "All card display + features (badges, ratings, price, Quick Add, Wishlist, Quick View, etc.) follow Theme Settings → Casa Product Cards by default. Toggle the checkbox below to override them just for this section."
    },
    {
      "type": "checkbox",
      "id": "override_card_features",
      "label": "Override theme card settings",
      "info": "When OFF, this section uses the global Theme Settings. When ON, the toggles below take effect.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show product badges",
      "default": true,
      "visible_if": "{{ section.settings.override_card_features }}"
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Show sale % badge",
      "info": "Auto-calculated discount percentage. Disable to hide sale badges while keeping custom badges.",
      "default": true,
      "visible_if": "{{ section.settings.override_card_features }}"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star ratings",
      "default": true,
      "visible_if": "{{ section.settings.override_card_features }}"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show prices",
      "default": true,
      "visible_if": "{{ section.settings.override_card_features }}"
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Quick Add button",
      "info": "Add to cart without leaving the page",
      "default": false,
      "visible_if": "{{ section.settings.override_card_features }}"
    },
    {
      "type": "checkbox",
      "id": "show_variant_swatches",
      "label": "Color swatches",
      "info": "Show color options on the product card",
      "default": false,
      "visible_if": "{{ section.settings.override_card_features }}"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Wishlist heart icon",
      "info": "Allow customers to save products",
      "default": false,
      "visible_if": "{{ section.settings.override_card_features }}"
    },
    {
      "type": "checkbox",
      "id": "show_quick_view",
      "label": "Quick View button",
      "info": "Preview product without leaving page",
      "default": false,
      "visible_if": "{{ section.settings.override_card_features }}"
    },
    {
      "type": "checkbox",
      "id": "show_stock_urgency",
      "label": "Low stock urgency badge",
      "info": "Show 'Only X left!' for low stock items",
      "default": false,
      "visible_if": "{{ section.settings.override_card_features }}"
    },
    {
      "type": "range",
      "id": "stock_threshold",
      "label": "Low stock threshold",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 5,
      "info": "Show urgency badge when stock is at or below this number",
      "visible_if": "{{ section.settings.override_card_features and section.settings.show_stock_urgency }}"
    },
    {
      "type": "checkbox",
      "id": "show_installment",
      "label": "Installment pricing",
      "info": "Locked OFF on every product card per merchant rule 2026-05-16 (BNPL only on PDP + cart). Setting kept for schema/template compatibility, hidden from editor.",
      "default": false,
      "visible_if": "{{ false }}"
    },
    {
      "type": "range",
      "id": "installment_count",
      "label": "Number of installments",
      "info": "Locked OFF — see show_installment above.",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "visible_if": "{{ false }}"
    },
    {
      "type": "checkbox",
      "id": "show_savings_highlight",
      "label": "Enhanced savings display",
      "info": "Show 'Save €X' badge for sale items",
      "default": false,
      "visible_if": "{{ section.settings.override_card_features }}"
    },
    {
      "type": "checkbox",
      "id": "show_social_proof",
      "label": "Social proof badges",
      "info": "Show 'Bestseller' or 'X sold this week'",
      "default": false,
      "visible_if": "{{ section.settings.override_card_features }}"
    },
    {
      "type": "checkbox",
      "id": "show_hover_video",
      "label": "Hover video",
      "info": "Play product video on card hover (if available)",
      "default": false,
      "visible_if": "{{ section.settings.override_card_features }}"
    },
    {
