{%- comment -%}
  Casa Quickview Price Data — Section-Rendering-API fragment.

  Fetched by snippets/casa-quickview-modal.liquid via:
    /products/{handle}?section_id=casa-qv-price-data

  Emits a JSON map of variant_id -> presentment-currency formatted
  price strings. The `money` / `money_with_currency` filters run
  server-side in the buyer's ACTIVE Market context, so EUR / VND /
  etc. come out correct — unlike /products/{handle}.js, which only
  ever returns the shop's BASE currency (that hard-coded a leading
  "$" and the wrong amount in the quickview modal).

  Currency-code visibility mirrors the PDP price block
  (snippets/price.liquid) via settings.currency_code_enabled_product_pages,
  so the quickview matches whatever the real product page shows.

  Fields per variant:
    price       — PDP-formatted current price (code shown iff PDP shows it)
    price_plain — compact `money` current price (no code; for the ATC button)
    compare_at  — PDP-formatted compare-at price (only when on sale)
    compare_plain — compact `money` compare-at (no code; only when on sale)
    save        — compact `money` savings amount (only when on sale)

  Consumers: snippets/casa-quickview-modal.liquid (uses price/compare_at/
  save/price_plain) and assets/casa-sticky-cart.js (uses price_plain/
  compare_plain to match its own `| money` buy-box format on variant change).
{%- endcomment -%}
{%- liquid
  assign use_code = settings.currency_code_enabled_product_pages
  # card_price / card_compare: the "from" variant's price + compare-at,
  # formatted for the cart's Recently-Viewed teaser (snippets/cart-products.liquid)
  # so it shows the live current-Market price instead of a stale localStorage
  # cents value. Uses selected_or_first_available_variant (matches the product
  # card) so the price and its strikethrough pair correctly. The was-price
  # drops the currency code per the card convention
  # (brand_card_was_price_drops_currency_code). card_compare is "" when not on sale.
  # strip_html on EVERY money output: the shop's money_format wraps the
  # amount in <span class="money">…</span> on the primary (USD) Market, and
  # these strings are set into the DOM via textContent (which would show the
  # tags literally). Foreign Markets emit plain strings, so strip_html is a
  # no-op there. Keeps the JSON a clean, plain price string for all consumers.
  assign card_variant = product.selected_or_first_available_variant
  if settings.currency_code_enabled_product_cards
    assign card_price = card_variant.price | money_with_currency | strip_html
  else
    assign card_price = card_variant.price | money | strip_html
  endif
  assign card_compare = ''
  if card_variant.compare_at_price > card_variant.price
    assign card_compare = card_variant.compare_at_price | money | strip_html
  endif
-%}
<script type="application/json" data-casa-qv-price-data>
{
  "currency": {{ cart.currency.iso_code | json }},
  "card_price": {{ card_price | json }},
  "card_compare": {{ card_compare | json }},
  "variants": {
    {%- for variant in product.variants -%}
      {%- if use_code -%}
        {%- assign _price = variant.price | money_with_currency | strip_html -%}
        {%- assign _compare = variant.compare_at_price | money_with_currency | strip_html -%}
      {%- else -%}
        {%- assign _price = variant.price | money | strip_html -%}
        {%- assign _compare = variant.compare_at_price | money | strip_html -%}
      {%- endif -%}
      {%- assign _price_plain = variant.price | money | strip_html -%}
      {%- assign _compare_plain = variant.compare_at_price | money | strip_html -%}
      "{{ variant.id }}": {
        "price": {{ _price | json }},
        "price_plain": {{ _price_plain | json }}
        {%- if variant.compare_at_price > variant.price -%}
          {%- assign _save_raw = variant.compare_at_price | minus: variant.price -%}
          {%- assign _save = _save_raw | money | strip_html -%}
          , "compare_at": {{ _compare | json }}
          , "compare_plain": {{ _compare_plain | json }}
          , "save": {{ _save | json }}
        {%- endif -%}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
}
</script>

{% schema %}
{
  "name": "Casa QV Price Data",
  "tag": "section",
  "settings": []
}
{% endschema %}
