{%- comment -%}
  Casa Quick-view Modal (v1)
  Bound once via `if (!window.__casaQuickViewBound)`.
  Fires when something dispatches `quickview:open` with { productUrl }.

  Renders a lightweight dialog with:
  - Product image (swaps on variant change)
  - Title, price (live), compare-at, description snippet
  - Variant option pickers (pill buttons per option group)
  - Dynamic ATC button that reports Sold out / Unavailable when no matching variant
  - View Full Details link

  After ATC success, dispatches `cart:update` matching the theme's
  CartAddEvent shape so cart-items-component re-renders and
  cart-drawer-component auto-opens.

  Render this once per page — safe to call multiple times, the listener
  is guarded against double-bind.
{%- endcomment -%}

{% stylesheet %}
  /* ── Overlay & shell ────────────────────────────────────────── */
  .casa-qv-overlay {
    position: fixed; inset: 0; z-index: 9999;
    /* No backdrop-filter here: this scrim is the largest possible blur
       surface (full viewport), it fades in via an opacity animation, and
       a spinner animates above it while the modal loads/adds — at 240Hz
       that stack dropped the whole overlay layer for single frames
       (frame-verified 2026-07-15, Genix PDP recording). The dim carries
       the visual; alpha raised 0.55 → 0.68 to compensate for the lost
       frost. Same class as the mega-menu 48px fix (83acb79c). */
    background: rgba(8, 8, 16, 0.68);
    display: flex; align-items: center; justify-content: center;
    padding: 24px;
    animation: casa-qv-fade 0.2s ease both;
  }
  @keyframes casa-qv-fade { from { opacity: 0; } to { opacity: 1; } }

  .casa-qv-modal {
    background: var(--casa-paper);
    border-radius: 20px;
    max-width: 1040px;
    width: 100%;
    max-height: 92vh;
    position: relative;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    animation: casa-qv-rise 0.3s cubic-bezier(0.2, 0.9, 0.3, 1) both;
  }
  @keyframes casa-qv-rise { from { transform: translateY(16px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

  .casa-qv-close {
    position: absolute; top: 16px; right: 16px; z-index: 5;
    width: 36px; height: 36px; border-radius: 50%; border: none;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    color: var(--casa-ink); font-size: 20px; line-height: 1;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    transition: background 0.15s, transform 0.15s;
  }
  .casa-qv-close:hover { background: var(--casa-paper); transform: scale(1.05); }

  .casa-qv-loading {
    display: flex; align-items: center; justify-content: center;
    padding: 80px; color: #999;
  }
  .casa-qv-loading svg { animation: casa-qv-spin 1s linear infinite; }
  @keyframes casa-qv-spin { to { transform: rotate(360deg); } }

  /* ── Body grid: gallery left, info right ─────────────────────── */
  .casa-qv-body {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    max-height: 92vh;
  }

  /* ── Gallery (left) ──────────────────────────────────────────── */
  .casa-qv-gallery {
    position: relative;
    background: linear-gradient(135deg, #f6f5f8 0%, #efedf2 100%);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .casa-qv-image {
    position: relative;
    flex: 1;
    overflow: hidden;
    min-height: 0;
  }
  .casa-qv-slides {
    display: flex; height: 100%;
    overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }
  .casa-qv-slides::-webkit-scrollbar { display: none; }
  .casa-qv-slide {
    flex: 0 0 100%; scroll-snap-align: start;
    aspect-ratio: 1;
    display: flex; align-items: center; justify-content: center;
    padding: 32px;
  }
  .casa-qv-slide img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }

  .casa-qv-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 38px; height: 38px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    color: var(--casa-ink);
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    padding: 0;
    transition: opacity 0.2s, transform 0.15s, background 0.15s;
  }
  .casa-qv-arrow:hover { background: var(--casa-paper); transform: translateY(-50%) scale(1.06); }
  .casa-qv-arrow.is-hidden { opacity: 0; pointer-events: none; }
  .casa-qv-arrow--prev { left: 12px; }
  .casa-qv-arrow--next { right: 12px; }

  /* Thumbnail rail (replaces dots on desktop, falls back to dots on mobile) */
  .casa-qv-thumbs {
    display: flex; gap: 8px;
    padding: 12px 16px 16px;
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .casa-qv-thumb {
    flex: 0 0 56px; height: 56px;
    border-radius: 8px; border: 2px solid transparent;
    overflow: hidden; padding: 0; cursor: pointer;
    background: var(--casa-paper);
    transition: border-color 0.15s, transform 0.15s;
  }
  .casa-qv-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .casa-qv-thumb:hover { transform: translateY(-2px); }
  .casa-qv-thumb.is-active { border-color: var(--casa-ink); }

  /* Legacy dots — kept for mobile fallback */
  .casa-qv-dots {
    display: none;
    justify-content: center; gap: 6px;
    padding: 12px 0;
  }
  .casa-qv-dot {
    width: 8px; height: 8px; border-radius: 50%; border: none; padding: 0;
    background: #d1d5db; cursor: pointer; transition: background 0.2s, transform 0.15s;
  }
  .casa-qv-dot.is-active { background: var(--casa-ink); transform: scale(1.25); }

  /* ── Info (right) ────────────────────────────────────────────── */
  .casa-qv-info {
    padding: 36px 36px 32px;
    overflow-y: auto;
    display: flex; flex-direction: column;
    max-height: 92vh;
  }
  .casa-qv-vendor {
    font-size: 11px; font-weight: 600; letter-spacing: 0.12em;
    text-transform: uppercase; color: #B0C3FA; margin: 0 0 8px;
  }
  .casa-qv-title {
    font-size: 26px; font-weight: 500; margin: 0 0 6px;
    color: var(--casa-ink); line-height: 1.2; letter-spacing: -0.01em;
  }
  .casa-qv-variant {
    font-size: 13px; color: #6b7280; margin-bottom: 14px; letter-spacing: 0.02em;
  }

  /* Price — mirrors blocks/casa-price.liquid (cpm__) for unified look */
  .casa-qv-info .cpm__price-row {
    display: flex; flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    margin-bottom: 6px;
  }
  .casa-qv-info .cpm__price-current {
    font-size: 30px; font-weight: 600;
    color: var(--cpm-price, var(--casa-ink));
    line-height: 1.1;
  }
  .casa-qv-info .cpm__price-compare {
    text-decoration: line-through;
    color: var(--cpm-compare-price, #6b7280);
    font-weight: 400; font-size: 17px;
  }
  .casa-qv-info .cpm__price-save {
    display: inline-flex; align-items: center;
    padding: 4px 12px;
    background: rgba(176, 195, 250, 0.08);
    color: var(--cpm-accent-1, #B0C3FA);
    border-radius: 100px;
    font-size: 13px; font-weight: 600;
    white-space: nowrap;
  }
  .casa-qv-info .cpm__installments {
    font-size: 13px; color: var(--cpm-text-muted, #6b7280);
    margin: 0 0 18px; line-height: 1.4;
  }

  .casa-qv-divider {
    height: 1px; background: #ececef; margin: 4px 0 18px; border: 0;
  }

  .casa-qv-desc {
    font-size: 14px; color: #4b5563; line-height: 1.6; margin: 0 0 20px;
  }

  .casa-qv-options {
    display: flex; flex-direction: column; gap: 14px; margin: 0 0 20px;
  }
  .casa-qv-opt-group { display: flex; flex-direction: column; gap: 8px; }
  .casa-qv-opt-label {
    font-size: 11px; font-weight: 600; color: #6b7280;
    text-transform: uppercase; letter-spacing: 0.08em;
  }
  .casa-qv-opt-label .casa-qv-opt-current { color: var(--casa-ink); margin-left: 6px; font-weight: 500; text-transform: none; letter-spacing: 0; }
  .casa-qv-opt-pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .casa-qv-opt {
    padding: 9px 16px; min-width: 44px;
    background: var(--casa-paper); border: 1px solid #d1d5db;
    border-radius: 999px;
    font-size: 13px; font-weight: 500;
    color: var(--casa-ink); cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }
  .casa-qv-opt:hover { border-color: var(--casa-ink); }
  .casa-qv-opt.is-selected {
    border-color: var(--casa-ink); background: var(--casa-ink); color: #fff;
  }
  .casa-qv-opt.is-unavailable {
    color: #6b7280; text-decoration: line-through;
    text-decoration-thickness: 1px;
  }
  .casa-qv-opt.is-unavailable.is-selected { text-decoration: none; }

  .casa-qv-actions { display: flex; flex-direction: column; gap: 10px; margin-top: auto; }
  .casa-qv-atc {
    width: 100%; padding: 16px;
    min-height: 52px;
    border: none; border-radius: 999px;
    background: linear-gradient(135deg, #0a0a0a, #2a2a2a);
    color: #fff; font-size: 15px; font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.2s, opacity 0.2s, background 0.2s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    line-height: 1;
    white-space: nowrap;
    position: relative;
    overflow: hidden;
  }
  .casa-qv-atc-label {
    display: inline-block;
    line-height: 1;
  }
  .casa-qv-atc-spinner {
    width: 16px; height: 16px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: var(--casa-paper);
    animation: casa-qv-spin 0.7s linear infinite;
    display: none;
  }
  .casa-qv-atc.is-loading .casa-qv-atc-spinner { display: inline-block; }
  .casa-qv-atc:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.18);
  }
  .casa-qv-atc:disabled {
    opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none;
    background: #6b7280;
  }
  .casa-qv-atc.is-loading {
    opacity: 0.95;
    background: linear-gradient(135deg, #0a0a0a, #2a2a2a);
  }
  .casa-qv-atc.is-success {
    background: linear-gradient(135deg, #16a34a, #22c55e);
    opacity: 1;
  }
  .casa-qv-view {
    display: block; text-align: center; padding: 6px;
    color: #4b5563; font-size: 13px; text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
    align-self: center;
  }
  .casa-qv-view:hover { color: var(--casa-ink); border-bottom-color: var(--casa-ink); }

  /* ── Tablet ──────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .casa-qv-modal { max-width: 720px; }
    .casa-qv-info { padding: 28px 28px 24px; }
    .casa-qv-title { font-size: 22px; }
    .casa-qv-info .cpm__price-current { font-size: 26px; }
  }

  /* ── Mobile — full-height sheet, sticky ATC, scrollable middle ─ */
  @media (max-width: 720px) {
    .casa-qv-overlay { padding: 0; align-items: stretch; }
    .casa-qv-modal {
      max-width: 100%;
      max-height: 100vh;
      max-height: 100dvh; /* dynamic viewport for iOS Safari */
      height: 100vh;
      height: 100dvh;
      border-radius: 0;
      animation: casa-qv-slide-up 0.3s cubic-bezier(0.2, 0.9, 0.3, 1) both;
      display: flex;
      flex-direction: column;
    }
    @keyframes casa-qv-slide-up { from { transform: translateY(100%); } to { transform: translateY(0); } }

    .casa-qv-body {
      display: flex;
      flex-direction: column;
      flex: 1;
      min-height: 0; /* allow children to shrink */
      max-height: none;
    }

    /* Compact gallery — fixed height so the carousel doesn't bounce/jiggle */
    .casa-qv-gallery {
      flex: 0 0 auto;
      height: 42vh;
      height: 42dvh;
      max-height: 42vh;
      max-height: 42dvh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .casa-qv-image {
      aspect-ratio: auto;
      flex: 1;
      min-height: 0;
      max-height: none;
      overflow: hidden;
    }
    .casa-qv-slides {
      height: 100%;
      overscroll-behavior-x: contain; /* don't bubble bounce to page */
    }
    .casa-qv-slide {
      aspect-ratio: auto;          /* override the 1:1 desktop ratio */
      flex: 0 0 100%;
      width: 100%;
      height: 100%;                /* fill the gallery height exactly */
      padding: 8px;
    }
    .casa-qv-slide img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
    }
    .casa-qv-thumbs { display: none; }
    .casa-qv-dots { display: flex; padding: 8px 0 4px; flex: 0 0 auto; }

    /* Scrollable info section so long descriptions/options don't push CTA off-screen */
    .casa-qv-info {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      padding: 18px 20px 16px;
      max-height: none;
      /* Reserve space for the sticky action bar */
      padding-bottom: calc(16px + env(safe-area-inset-bottom));
    }
    .casa-qv-title { font-size: 19px; }
    .casa-qv-info .cpm__price-current { font-size: 22px; }
    .casa-qv-close { top: 10px; right: 10px; width: 32px; height: 32px; }

    /* Pin the actions bar to the bottom of the sheet */
    .casa-qv-actions {
      position: sticky;
      bottom: 0;
      margin-top: 16px;
      margin-left: -20px;
      margin-right: -20px;
      padding: 12px 20px calc(12px + env(safe-area-inset-bottom));
      background: linear-gradient(to top, #fff 80%, rgba(255, 255, 255, 0));
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.05);
      z-index: 2;
    }
    .casa-qv-atc { padding: 14px; font-size: 15px; }
    .casa-qv-view { padding: 4px; font-size: 12px; }
  }

  /* ── Small phones — even tighter gallery to keep info readable ── */
  @media (max-width: 480px) and (max-height: 700px) {
    .casa-qv-gallery {
      height: 36vh;
      height: 36dvh;
      max-height: 36vh;
      max-height: 36dvh;
    }
    .casa-qv-slide { padding: 6px; }
  }
{% endstylesheet %}

<script>
  (function() {
    if (window.__casaQuickViewBound) return;
    window.__casaQuickViewBound = true;

    /* Per-session cache of fetched product JSON */
    var __qvCache = {};
    /* Per-session cache of market-aware price strings (SRA fragment) */
    var __qvPriceCache = {};

    window.addEventListener('quickview:open', async function(e) {
      var productUrl = e.detail && e.detail.productUrl;
      if (!productUrl) return;

      // Remove any existing modal
      var existing = document.querySelector('.casa-qv-overlay');
      if (existing) existing.remove();

      // Build loading overlay
      var overlay = document.createElement('div');
      overlay.className = 'casa-qv-overlay';
      overlay.innerHTML = '<div class="casa-qv-modal"><div class="casa-qv-loading"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg></div></div>';
      document.body.appendChild(overlay);
      document.body.style.overflow = 'hidden';
      // Pause governed videos beneath the scrim while the modal is open —
      // same body-class + cross-check pattern as casa-drawer-active /
      // casa-mega-open in assets/casa-offscreen-pause.js.
      document.body.classList.add('casa-qv-open');
      if (window.casa && window.casa.offscreenPauseRefresh) window.casa.offscreenPauseRefresh();

      overlay.addEventListener('click', function(ev) { if (ev.target === overlay) closeQV(); });
      document.addEventListener('keydown', function qvEsc(ev) { if (ev.key === 'Escape') { closeQV(); document.removeEventListener('keydown', qvEsc); } });

      function closeQV() {
        var o = document.querySelector('.casa-qv-overlay');
        if (o) o.remove();
        document.body.style.overflow = '';
        document.body.classList.remove('casa-qv-open');
        if (window.casa && window.casa.offscreenPauseRefresh) window.casa.offscreenPauseRefresh();
      }

      try {
        var cleanUrl = productUrl.split('?')[0];

        /* Kick off the market-aware price fetch in PARALLEL with the
           product JSON. /products/{handle}.js only returns the shop's
           BASE currency (this is why the modal showed "$" on a EUR
           store), so the presentment-currency prices are read from the
           SRA fragment instead — Liquid's money filters render it in
           the buyer's active Market. Resolves to null on any failure so
           updateUI can fall back to the base-currency formatter. */
        var pricePromise;
        if (__qvPriceCache[cleanUrl]) {
          pricePromise = Promise.resolve(__qvPriceCache[cleanUrl]);
        } else {
          pricePromise = fetch(cleanUrl + '?section_id=casa-qv-price-data')
            .then(function(r) { return r.ok ? r.text() : ''; })
            .then(function(t) {
              var d = new DOMParser().parseFromString(t, 'text/html');
              var s = d.querySelector('[data-casa-qv-price-data]');
              var vmap = s ? (JSON.parse(s.textContent || '{}').variants || {}) : null;
              if (vmap) __qvPriceCache[cleanUrl] = vmap;
              return vmap;
            })
            .catch(function() { return null; });
        }

        var product;
        if (__qvCache[cleanUrl]) {
          product = __qvCache[cleanUrl];
        } else {
          var res = await fetch(cleanUrl + '.js');
          product = await res.json();
          __qvCache[cleanUrl] = product;
        }

        var priceMap = await pricePromise;

        // ─── Resolve initial variant ─────────────────────────────────
        var variantFromUrl = null;
        try {
          var _u = new URL(productUrl, window.location.origin);
          variantFromUrl = _u.searchParams.get('variant');
        } catch (_e) {}

        var initialVariant = null;
        if (variantFromUrl) {
          initialVariant = (product.variants || []).find(function(v) {
            return String(v.id) === String(variantFromUrl);
          });
        }
        if (!initialVariant) {
          initialVariant = (product.variants || []).find(function(v) { return v.available; })
            || (product.variants || [])[0]
            || null;
        }

        var options = product.options || [];
        var hasOnlyDefault = !!product.has_only_default_variant
          || (options.length === 1 && options[0].name === 'Title' && (options[0].values || [])[0] === 'Default Title');

        var selectedOptions = options.map(function(_, i) {
          var k = 'option' + (i + 1);
          return initialVariant ? initialVariant[k] : ((product.variants[0] || {})[k] || '');
        });

        function findVariant(opts) {
          return (product.variants || []).find(function(v) {
            for (var i = 0; i < opts.length; i++) {
              if (v['option' + (i + 1)] !== opts[i]) return false;
            }
            return true;
          }) || null;
        }

        function isOptionValueAvailable(optionIndex, optionValue) {
          return (product.variants || []).some(function(v) {
            if (v['option' + (optionIndex + 1)] !== optionValue) return false;
            if (!v.available) return false;
            for (var i = 0; i < selectedOptions.length; i++) {
              if (i === optionIndex) continue;
              if (selectedOptions[i] && v['option' + (i + 1)] !== selectedOptions[i]) return false;
            }
            return true;
          });
        }

        function escapeAttr(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
        /* Fallback only — used when the SRA price fragment failed to
           load. Base-currency cents; not Market-aware. */
        function formatMoney(cents) { return '$' + (cents / 100).toFixed(2); }

        /* Market-aware, presentment-currency price strings for a variant,
           sourced from the SRA fragment. Falls back to formatMoney (base
           currency) only when the fragment is unavailable. */
        function qvPrices(variant) {
          var id = variant ? String(variant.id) : '';
          if (priceMap && priceMap[id]) return priceMap[id];
          var pc = variant ? variant.price : product.price;
          var cc = variant ? variant.compare_at_price : product.compare_at_price;
          var fb = { price: formatMoney(pc), price_plain: formatMoney(pc) };
          if (cc && cc > pc) { fb.compare_at = formatMoney(cc); fb.save = formatMoney(cc - pc); }
          return fb;
        }

        var modal = overlay.querySelector('.casa-qv-modal');
        modal.innerHTML = ''
          + '<button class="casa-qv-close" aria-label="Close">&times;</button>'
          + '<div class="casa-qv-body">'
          + (function() {
              var imgs = product.images && product.images.length ? product.images : [product.featured_image || ''];
              var slides = imgs.map(function(src, i) {
                var cleanSrc = String(src || '').replace(/\?.*$/, '') + '?width=900';
                var loading = i === 0 ? 'eager' : 'lazy';
                var fetchPriority = i === 0 ? ' fetchpriority="high"' : '';
                return '<div class="casa-qv-slide"><img src="' + escapeAttr(cleanSrc) + '" alt="' + escapeAttr(product.title) + '" loading="' + loading + '"' + fetchPriority + '></div>';
              }).join('');
              var thumbs = imgs.length > 1
                ? '<div class="casa-qv-thumbs">' + imgs.map(function(src, i) {
                    var thumbSrc = String(src || '').replace(/\?.*$/, '') + '?width=120';
                    return '<button type="button" class="casa-qv-thumb' + (i === 0 ? ' is-active' : '') + '" data-qv-thumb="' + i + '" aria-label="View image ' + (i + 1) + '"><img src="' + escapeAttr(thumbSrc) + '" alt=""></button>';
                  }).join('') + '</div>'
                : '';
              var dots = imgs.length > 1
                ? '<div class="casa-qv-dots">' + imgs.map(function(_, i) {
                    return '<button type="button" class="casa-qv-dot' + (i === 0 ? ' is-active' : '') + '" data-qv-dot="' + i + '" aria-label="Go to image ' + (i + 1) + '"></button>';
                  }).join('') + '</div>'
                : '';
              var arrows = imgs.length > 1
                ? '<button type="button" class="casa-qv-arrow casa-qv-arrow--prev is-hidden" data-qv-arrow="prev" aria-label="Previous image"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></button>'
                + '<button type="button" class="casa-qv-arrow casa-qv-arrow--next" data-qv-arrow="next" aria-label="Next image"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></button>'
                : '';
              return '<div class="casa-qv-gallery">'
                + '<div class="casa-qv-image">' + arrows + '<div class="casa-qv-slides" data-qv-slides>' + slides + '</div></div>'
                + dots
                + thumbs
                + '</div>';
            })()
          + '<div class="casa-qv-info">'
          + (product.vendor ? '<p class="casa-qv-vendor">' + escapeAttr(product.vendor) + '</p>' : '')
          + '<h2 class="casa-qv-title">' + escapeAttr(product.title) + '</h2>'
          + '<div class="casa-qv-variant" data-qv-variant-text></div>'
          + '<div class="cpm__price-row">'
          + '<span class="cpm__price-current" data-qv-amount></span>'
          + '<span class="cpm__price-compare" data-qv-compare></span>'
          + '<span class="cpm__price-save" data-qv-save></span>'
          + '</div>'
          + '<p class="cpm__installments" data-qv-installments></p>'
          + '<hr class="casa-qv-divider">'
          + (product.description ? '<p class="casa-qv-desc">' + product.description.replace(/<[^>]*>/g, '').substring(0, 180) + (product.description.length > 180 ? '…' : '') + '</p>' : '')
          + '<div class="casa-qv-options" data-qv-options></div>'
          + '<div class="casa-qv-actions">'
          + '<button class="casa-qv-atc" data-qv-atc><span class="casa-qv-atc-spinner" aria-hidden="true"></span><span class="casa-qv-atc-label" data-qv-atc-label>Add to Cart</span></button>'
          + '<a href="' + escapeAttr(productUrl) + '" class="casa-qv-view">View full details →</a>'
          + '</div>'
          + '</div>'
          + '</div>';

        var slidesContainer = modal.querySelector('[data-qv-slides]');
        var galleryEl = modal.querySelector('.casa-qv-gallery');
        var allDots = modal.querySelectorAll('.casa-qv-dot');
        var allThumbs = modal.querySelectorAll('.casa-qv-thumb');
        var productImages = product.images && product.images.length ? product.images : [product.featured_image || ''];

        /* ── Carousel: scroll ↔ dot/thumb sync ────────────────────── */
        function getActiveSlideIndex() {
          if (!slidesContainer || !slidesContainer.children.length) return 0;
          var scrollLeft = slidesContainer.scrollLeft;
          var slideWidth = slidesContainer.children[0].offsetWidth || 1;
          return Math.round(scrollLeft / slideWidth);
        }

        var prevArrow = modal.querySelector('[data-qv-arrow="prev"]');
        var nextArrow = modal.querySelector('[data-qv-arrow="next"]');
        var totalSlides = slidesContainer ? slidesContainer.children.length : 0;

        function setActiveDot(index) {
          allDots.forEach(function(d, i) { d.classList.toggle('is-active', i === index); });
          allThumbs.forEach(function(t, i) { t.classList.toggle('is-active', i === index); });
        }

        function updateArrows(index) {
          if (!prevArrow || !nextArrow) return;
          prevArrow.classList.toggle('is-hidden', index <= 0);
          nextArrow.classList.toggle('is-hidden', index >= totalSlides - 1);
        }

        function scrollToSlide(index) {
          if (!slidesContainer || !slidesContainer.children[index]) return;
          var slide = slidesContainer.children[index];
          slidesContainer.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
        }

        function goToSlide(index) {
          scrollToSlide(index);
          setActiveDot(index);
          updateArrows(index);
        }

        if (slidesContainer) {
          var scrollTimer;
          slidesContainer.addEventListener('scroll', function() {
            clearTimeout(scrollTimer);
            scrollTimer = setTimeout(function() {
              var idx = getActiveSlideIndex();
              setActiveDot(idx);
              updateArrows(idx);
            }, 60);
          }, { passive: true });
        }

        if (galleryEl) {
          galleryEl.addEventListener('click', function(ev) {
            var dot = ev.target.closest('.casa-qv-dot');
            if (dot) {
              goToSlide(Number(dot.getAttribute('data-qv-dot')));
              return;
            }
            var thumb = ev.target.closest('.casa-qv-thumb');
            if (thumb) {
              goToSlide(Number(thumb.getAttribute('data-qv-thumb')));
              return;
            }
            var arrow = ev.target.closest('.casa-qv-arrow');
            if (arrow) {
              var dir = arrow.getAttribute('data-qv-arrow');
              var cur = getActiveSlideIndex();
              goToSlide(dir === 'prev' ? Math.max(0, cur - 1) : Math.min(totalSlides - 1, cur + 1));
            }
          });
        }

        var variantTextEl = modal.querySelector('[data-qv-variant-text]');
        var compareEl = modal.querySelector('[data-qv-compare]');
        var amountEl = modal.querySelector('[data-qv-amount]');
        var saveEl = modal.querySelector('[data-qv-save]');
        var installmentsEl = modal.querySelector('[data-qv-installments]');
        var optionsEl = modal.querySelector('[data-qv-options]');
        var atcBtn = modal.querySelector('[data-qv-atc]');

        if (!hasOnlyDefault) {
          optionsEl.innerHTML = options.map(function(opt, oi) {
            var pills = (opt.values || []).map(function(val) {
              var isSelected = selectedOptions[oi] === val;
              return '<button type="button" class="casa-qv-opt' + (isSelected ? ' is-selected' : '') + '" data-qv-opt-index="' + oi + '" data-qv-opt-value="' + escapeAttr(val) + '">' + escapeAttr(val) + '</button>';
            }).join('');
            return '<div class="casa-qv-opt-group">'
              + '<div class="casa-qv-opt-label">' + escapeAttr(opt.name) + '</div>'
              + '<div class="casa-qv-opt-pills">' + pills + '</div>'
            + '</div>';
          }).join('');
        }

        function updateOptionAvailability() {
          optionsEl.querySelectorAll('.casa-qv-opt').forEach(function(b) {
            var oi = Number(b.getAttribute('data-qv-opt-index'));
            var val = b.getAttribute('data-qv-opt-value');
            b.classList.toggle('is-unavailable', !isOptionValueAvailable(oi, val));
          });
        }

        function updateUI() {
          var variant = findVariant(selectedOptions);
          atcBtn.dataset.variantId = variant ? variant.id : '';

          var pr = qvPrices(variant);
          amountEl.textContent = pr.price;

          // Compare-at price (presentment currency, only on sale)
          if (pr.compare_at) {
            compareEl.textContent = pr.compare_at;
            compareEl.style.display = '';
          } else {
            compareEl.textContent = '';
            compareEl.style.display = 'none';
          }

          // Save badge
          if (pr.save && saveEl) {
            saveEl.textContent = 'Save ' + pr.save;
            saveEl.style.display = '';
          } else if (saveEl) {
            saveEl.textContent = '';
            saveEl.style.display = 'none';
          }

          // Installments — HARD-LOCKED OFF. Quickview is a card-hover
          // surface, not the PDP buy-box. Per merchant rule 2026-05-16
          // BNPL appears only on the real PDP and above the cart checkout
          // button. Keep the placeholder hidden so the surrounding layout
          // (price row spacing) is unaffected.
          if (installmentsEl) {
            installmentsEl.innerHTML = '';
            installmentsEl.style.display = 'none';
          }

          if (variant && !hasOnlyDefault) {
            variantTextEl.textContent = variant.title;
            variantTextEl.style.display = '';
          } else {
            variantTextEl.textContent = '';
            variantTextEl.style.display = 'none';
          }

          /* ── Scroll carousel to variant image ──────────────── */
          if (variant && variant.featured_image && variant.featured_image.src) {
            var varSrc = variant.featured_image.src.replace(/\?.*$/, '').replace(/^https?:/, '');
            var matchIdx = -1;
            for (var si = 0; si < productImages.length; si++) {
              var piSrc = String(productImages[si]).replace(/\?.*$/, '').replace(/^https?:/, '');
              if (piSrc === varSrc) { matchIdx = si; break; }
            }
            if (matchIdx >= 0) {
              goToSlide(matchIdx);
            }
          }

          var atcLabelEl = atcBtn.querySelector('[data-qv-atc-label]');
          if (!variant) {
            atcBtn.disabled = true;
            if (atcLabelEl) atcLabelEl.textContent = 'Unavailable';
          } else if (!variant.available) {
            atcBtn.disabled = true;
            if (atcLabelEl) atcLabelEl.textContent = 'Sold out';
          } else {
            atcBtn.disabled = false;
            if (atcLabelEl) {
              atcLabelEl.textContent = 'Add to Cart — ' + pr.price_plain;
              // Overflow guard: the current price already shows in the price
              // row above, so if echoing it on the button would clip at this
              // viewport × currency (e.g. an 8-digit VND price at 280px), drop
              // the suffix rather than render a clipped 'ADD TO CA…'. Measured
              // synchronously (one reflow) so there's no visible flash.
              var atcCs = getComputedStyle(atcBtn);
              var atcInnerW = atcBtn.clientWidth - parseFloat(atcCs.paddingLeft) - parseFloat(atcCs.paddingRight);
              if (atcInnerW > 0 && atcLabelEl.getBoundingClientRect().width > atcInnerW + 0.5) {
                atcLabelEl.textContent = 'Add to Cart';
              }
            }
          }

          updateOptionAvailability();
        }

        optionsEl.addEventListener('click', function(ev) {
          var b = ev.target.closest('.casa-qv-opt');
          if (!b) return;
          var oi = Number(b.getAttribute('data-qv-opt-index'));
          var val = b.getAttribute('data-qv-opt-value');
          selectedOptions[oi] = val;
          optionsEl.querySelectorAll('[data-qv-opt-index="' + oi + '"]').forEach(function(sib) {
            sib.classList.toggle('is-selected', sib === b);
          });
          updateUI();
        });

        modal.querySelector('.casa-qv-close').addEventListener('click', closeQV);
        updateUI();

        atcBtn.addEventListener('click', function() {
          var vid = atcBtn.dataset.variantId;
          if (!vid || atcBtn.disabled) return;

          var atcLabelEl = atcBtn.querySelector('[data-qv-atc-label]');
          var origLabel = atcLabelEl ? atcLabelEl.textContent : '';
          if (atcLabelEl) atcLabelEl.textContent = 'Adding';
          atcBtn.classList.add('is-loading');
          atcBtn.classList.remove('is-success');
          atcBtn.disabled = true;

          var sectionIds = Array.prototype.map.call(
            document.querySelectorAll('cart-items-component[data-section-id]'),
            function(el) { return el.getAttribute('data-section-id'); }
          ).filter(Boolean);
          sectionIds = sectionIds.filter(function(id, i) { return sectionIds.indexOf(id) === i; });

          function cartCountFromSections(sections) {
            if (!sections) return null;
            for (var id in sections) {
              if (!Object.prototype.hasOwnProperty.call(sections, id)) continue;
              var doc = new DOMParser().parseFromString(sections[id] || '', 'text/html');
              var count = parseInt((doc.querySelector('[ref="cartItemCount"]') || {}).textContent || '', 10);
              if (!Number.isNaN(count)) return count;
            }
            return null;
          }

          function waitForCartItemsToSettle() {
            return Promise.all(Array.prototype.map.call(document.querySelectorAll('cart-items-component'), function(component) {
              if (component && typeof component.flushPendingCartUpdates === 'function') {
                return component.flushPendingCartUpdates();
              }
            }));
          }

          waitForCartItemsToSettle().then(function() {
            return fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({
                items: [{ id: parseInt(vid, 10), quantity: 1 }],
                sections: sectionIds.join(','),
                sections_url: window.location.pathname
              })
            });
          })
          .then(function(r) { if (!r.ok) throw new Error(); return r.json(); })
          .then(function(data) {
            atcBtn.classList.remove('is-loading');
            atcBtn.classList.add('is-success');
            if (atcLabelEl) atcLabelEl.textContent = 'Added!';

            try {
              document.dispatchEvent(new CustomEvent('cart:update', {
                bubbles: true,
                detail: {
                  resource: data,
                  sourceId: 'casa-quickview',
                  data: {
                    source: 'casa-quickview',
                    itemCount: cartCountFromSections(data.sections),
                    variantId: vid,
                    sections: data.sections || {}
                  }
                }
              }));
            } catch (_e) {}

            setTimeout(function() {
              closeQV();
              var drawer = document.querySelector('cart-drawer-component');
              if (drawer && typeof drawer.open === 'function') {
                drawer.open();
              } else {
                var cb = document.querySelector('.casa-header__cart-btn');
                if (cb) cb.click();
              }
            }, 400);
          })
          .catch(function() {
            atcBtn.classList.remove('is-loading');
            if (atcLabelEl) atcLabelEl.textContent = 'Error';
            setTimeout(function() {
              if (atcLabelEl) atcLabelEl.textContent = origLabel;
              atcBtn.disabled = false;
            }, 1500);
          });
        });
      } catch(err) {
        closeQV();
        window.location.href = productUrl;
      }
    });
  })();
</script>
