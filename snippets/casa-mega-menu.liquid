  /* ═══════════════════════════════════════════════════════
     RESPONSIVE: EXTRA LARGE DESKTOP (1600px+)
     Only show 3 product columns on very wide screens (auto mode)
     ═══════════════════════════════════════════════════════ */

  @media (min-width: 1600px) {
    .casa-mega-inner {
      /* Categories column widened 18% → 20%. On large screens the name
         font grows (clamp/overrides) while the column % was shrinking,
         so titles like "Bubble Girl Lamps" were truncating; give the
         column enough room to show the full title + count. */
      grid-template-columns: minmax(0, 20%) minmax(0, 1fr) minmax(0, 24%);
    }

    /* Auto mode: switch to 3 columns on extra-large screens */
    .casa-mega-products-grid[data-columns="auto"] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* Explicit 2 or 3 columns override auto behavior */
    .casa-mega-products-grid[data-columns="2"] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .casa-mega-products-grid[data-columns="3"] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

