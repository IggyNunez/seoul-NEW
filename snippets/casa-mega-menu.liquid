{%- comment -%}
  Seoul Glow Lab - Desktop Mega Menu (3 Variants + 6 Themes, Fully Customizable)

  VARIANT = content layout (glow/lifestyle/support)
  THEME = visual styling (dark-glow/white/gold/midnight/emerald/rose)

  All text, URLs, video, product limits, and quick links are controlled via
  the Header section schema. Quick links are pre-rendered block HTML.
{%- endcomment -%}

{%- liquid
  comment
    ═══════════════════════════════════════════════════════
    STEP 1: Detect VARIANT (content layout)
    ═══════════════════════════════════════════════════════
  endcomment
  assign menu_variant = 'glow'
  assign _title_handle = link.title | downcase | handle

  case _title_handle
    when 'shop', 'shop-all', 'skincare', 'cleansers', 'serums', 'moisturizers', 'treatments', 'best-sellers', 'essences', 'toners', 'sunscreens', 'masks', 'exfoliators'
      assign menu_variant = 'glow'
    when 'new-arrivals', 'new', 'collections', 'routines', 'sets', 'bundles', 'k-beauty', 'trending'
      assign menu_variant = 'lifestyle'
    when 'about', 'about-us', 'customer-care', 'support', 'help', 'faq', 'contact', 'our-story'
      assign menu_variant = 'support'
  endcase

  assign _collection = collections[link.handle]
  if _collection and _collection.metafields.sgl.menu_style != blank
    assign menu_variant = _collection.metafields.sgl.menu_style
  endif

  comment
    ═══════════════════════════════════════════════════════
    STEP 2: Detect THEME (visual styling)
    Themes: dark-glow (default), white, gold, midnight, emerald, rose
    ═══════════════════════════════════════════════════════
  endcomment
  assign menu_theme = 'white'

  comment
    Check for custom_menu_theme passed from header (block override)
  endcomment
  if custom_menu_theme != blank and custom_menu_theme != nil
    assign menu_theme = custom_menu_theme
  else
    comment
      Auto-detect theme by menu handle
    endcomment
    case _title_handle
      when 'shop', 'shop-all', 'skincare', 'cleansers', 'serums', 'moisturizers'
        assign menu_theme = 'white'
      when 'essences', 'toners', 'exfoliators', 'eye-cream'
        assign menu_theme = 'rose'
      when 'new-arrivals', 'new', 'trending', 'featured'
        assign menu_theme = 'gold'
      when 'treatments', 'masks', 'sunscreens', 'routines', 'sets'
        assign menu_theme = 'dark-glow'
      when 'best-sellers', 'popular', 'top-rated', 'k-beauty'
        assign menu_theme = 'emerald'
      when 'sale', 'deals', 'offers'
        assign menu_theme = 'rose'
      when 'about', 'about-us', 'customer-care', 'support', 'help', 'faq', 'contact', 'our-story'
        assign menu_theme = 'midnight'
    endcase

    comment
      Check collection metafield override
    endcomment
    if _collection and _collection.metafields.sgl.menu_theme != blank
      assign menu_theme = _collection.metafields.sgl.menu_theme
    endif
  endif

  assign has_custom_colors = false
  if custom_accent_primary != blank and custom_accent_primary != nil
    assign has_custom_colors = true
  endif
-%}

{%- comment -%}
  Generate inline style for custom colors if provided.

  BRAND V1 — quiet chrome principle (docs/brand-book-v1.html):
  Chrome stays neutral; products + content carry color. So the
  merchant's per-menu menu_color block is allowed to color CONTENT-
  level tokens (link color, featured label, the small octagon
  spinner inside featured cards), but it does NOT color CHROME-level
  tokens (panel ambient glow, row hover bg, featured card body bg,
  top-bar gradient, card hover border, icon hover bg).

  Chrome tokens are baked at the base .casa-mega-menu rule using
  brand purple/pink — uniform across every menu regardless of variant
  or merchant settings. That kills the "different menu = different
  full-panel color" effect and pulls every megamenu into one quiet,
  brand-aligned chrome.
{%- endcomment -%}
{%- capture custom_color_style -%}
  {%- if has_custom_colors -%}
    --mega-accent-1: {{ custom_accent_primary }};
    --mega-accent-2: {{ custom_accent_secondary | default: custom_accent_primary }};
    --mega-accent-3: {{ custom_accent_tertiary | default: custom_accent_secondary | default: custom_accent_primary }};
    --mega-accent-1-rgb: {{ custom_accent_primary | color_extract: 'red' }}, {{ custom_accent_primary | color_extract: 'green' }}, {{ custom_accent_primary | color_extract: 'blue' }};
    --mega-accent-2-rgb: {{ custom_accent_secondary | default: custom_accent_primary | color_extract: 'red' }}, {{ custom_accent_secondary | default: custom_accent_primary | color_extract: 'green' }}, {{ custom_accent_secondary | default: custom_accent_primary | color_extract: 'blue' }};
    --mega-featured-label-color: {{ custom_accent_secondary | default: custom_accent_primary }};
    --mega-link-color: {{ custom_accent_primary }};
  {%- endif -%}
{%- endcapture -%}

<div class="casa-mega-menu casa-mega-menu--{{ menu_variant }} casa-mega-theme--{{ menu_theme }}"{% if has_custom_colors %} style="{{ custom_color_style | strip_newlines }}"{% endif %}>
  <div class="casa-mega-inner">

    {%- comment -%} ── Left Column: Categories ── {%- endcomment -%}
    <div class="casa-mega-categories">
      <div class="casa-mega-section-title">
        {%- if menu_variant == 'support' -%}{{ categories_title_support | default: 'Help Topics' }}
        {%- elsif menu_variant == 'lifestyle' -%}{{ categories_title_lifestyle | default: 'Collections' }}
        {%- else -%}{{ categories_title_glow | default: 'Categories' }}
        {%- endif -%}
      </div>

      {%- comment -%}
        Option G — brand-voice headline (italic-gradient `<em>` accent).
        Locked typography decision (see memory:
        brand_typography_locked_2026-05-04.md). Headline copy is brand
        voice — varies per menu variant but stays code-locked, not
        merchant-editable, same way the gradient accent rule is locked.
      {%- endcomment -%}
      <h3 class="casa-mega-cat-headline">
        {%- if menu_variant == 'support' -%}How can we <em>help?</em>
        {%- elsif menu_variant == 'lifestyle' -%}Curated <em>rituals.</em>
        {%- else -%}Find your <em>glow.</em>
        {%- endif -%}
      </h3>

      {%- comment -%}
        Prominent "Shop All [Category]" CTA — every collection-backed
        drawer (Shop All → all products, Lighting → all lighting,
        Home Decor → all home decor). Gives each drawer one
        unambiguous, high-visibility path to its own full collection,
        in the slot left by the desktop-hidden hero card. Shown for any
        non-support drawer whose top-level links to a collection;
        support drawers (Help) have no collection so they're excluded.
        `_show_shop_all_cta` + `_link_last_handle` stay in scope for the
        two category loops below, which skip the now-duplicate
        "all-{this collection}" row (e.g. "All Products" in Shop All).
      {%- endcomment -%}
      {%- assign _link_last_handle = link.url | split: '/' | last -%}
      {%- assign _is_shop_all_menu = false -%}
      {%- if _title_handle == 'shop-all' or _title_handle == 'shop' or _title_handle == 'all' or _title_handle == 'all-products' or _link_last_handle == 'all' -%}
        {%- assign _is_shop_all_menu = true -%}
      {%- endif -%}
      {%- assign _show_shop_all_cta = false -%}
      {%- if menu_variant != 'support' and link.url contains '/collections/' -%}
        {%- assign _show_shop_all_cta = true -%}
      {%- endif -%}
      {%- if _show_shop_all_cta -%}
        {%- if _is_shop_all_menu -%}
          {%- assign _shop_all_label = 'Shop All Products' -%}
          {%- assign _shop_all_sub = 'Browse everything' -%}
          {%- assign _shop_all_url = collections.all.url | default: '/collections/all' -%}
        {%- elsif _title_handle == 'home-decor' or _link_last_handle == 'home-accents' or _link_last_handle == 'home-decor' -%}
          {%- comment -%} "Shop All Home Decor" (19 chars) clips the narrow column even at the 1000px floor; "Decor" is the unambiguous short form and fits like the 17-char labels. {%- endcomment -%}
          {%- assign _shop_all_label = 'Shop All Decor' -%}
          {%- assign _shop_all_sub = 'Browse the full range' -%}
          {%- assign _shop_all_url = link.url -%}
        {%- else -%}
          {%- assign _shop_all_label = 'Shop All ' | append: link.title -%}
          {%- assign _shop_all_sub = 'Browse the full range' -%}
          {%- assign _shop_all_url = link.url -%}
        {%- endif -%}
        <a href="{{ _shop_all_url }}" class="casa-mega-shop-all" aria-label="{{ _shop_all_label | escape }}">
          <span class="casa-mega-shop-all__icon" aria-hidden="true">{%- render 'casa-icon', icon: 'grid', size: 16 -%}</span>
          <span class="casa-mega-shop-all__text">
            <span class="casa-mega-shop-all__label">{{ _shop_all_label }}</span>
            <span class="casa-mega-shop-all__sub">{{ _shop_all_sub }}</span>
          </span>
          <span class="casa-mega-shop-all__arrow" aria-hidden="true">{%- render 'casa-icon', icon: 'arrow-right', size: 16 -%}</span>
        </a>
      {%- endif -%}

      {%- comment -%}
        Option G — hero card pre-pass.
        Walk the children once, find the first featured item, and render
        it as a curated visual moment ABOVE the list. Same featured-
        detection rule as Option C (badge metafield = featured/best/
        popular/hot, OR handle = best-sellers / bestsellers). The hero
        is then skipped in the main loop with `continue`. If no child
        is featured, the hero card simply doesn't render and the list
        flows up underneath.
      {%- endcomment -%}
      {%- assign _hero_handle = '' -%}
      {%- assign _hero_link = nil -%}
      {%- assign _hero_collection = nil -%}
      {%- for _scan_link in link.links -%}
        {%- if _hero_handle != '' -%}{%- break -%}{%- endif -%}
        {%- assign _scan_url_parts = _scan_link.url | split: '/' -%}
        {%- assign _scan_handle = _scan_url_parts | last -%}
        {%- assign _scan_collection = collections[_scan_handle] -%}
        {%- assign _scan_badge = '' -%}
        {%- if _scan_collection.metafields.sgl.badge != blank -%}
          {%- assign _scan_badge = _scan_collection.metafields.sgl.badge | downcase -%}
        {%- endif -%}
        {%- if _scan_badge == 'featured' or _scan_badge == 'best' or _scan_badge == 'popular' or _scan_badge == 'hot' -%}
          {%- assign _hero_handle = _scan_handle -%}
          {%- assign _hero_link = _scan_link -%}
          {%- assign _hero_collection = _scan_collection -%}
        {%- elsif _scan_handle == 'best-sellers' or _scan_handle == 'bestsellers' -%}
          {%- assign _hero_handle = _scan_handle -%}
          {%- assign _hero_link = _scan_link -%}
          {%- assign _hero_collection = _scan_collection -%}
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%}
        Hero render — uses _hero_link if a child was flagged featured,
        otherwise falls back to the global Best Sellers collection so
        every Glow / Lifestyle drawer always shows a visual moment per
        the Option G mockup. Suppressed for Support.
      {%- endcomment -%}
      {%- assign _hero_url = '' -%}
      {%- assign _hero_title = '' -%}
      {%- if _hero_link != nil and menu_variant != 'support' -%}
        {%- assign _hero_url = _hero_link.url -%}
        {%- assign _hero_title = _hero_link.title -%}
      {%- elsif menu_variant != 'support' -%}
        {%- assign _global_best = collections['best-sellers'] -%}
        {%- if _global_best != blank -%}
          {%- assign _hero_url = '/collections/best-sellers' -%}
          {%- assign _hero_title = 'Best Sellers' -%}
          {%- assign _hero_collection = _global_best -%}
        {%- endif -%}
      {%- endif -%}

      {%- if _hero_url != '' -%}
        {%- assign _hero_focal_x = _hero_collection.metafields.sgl.focal_x -%}
        {%- assign _hero_focal_y = _hero_collection.metafields.sgl.focal_y -%}
        {%- if _hero_focal_x != blank -%}{%- assign _hero_focal_x_pct = _hero_focal_x | times: 100 -%}{%- else -%}{%- assign _hero_focal_x_pct = 50 -%}{%- endif -%}
        {%- if _hero_focal_y != blank -%}{%- assign _hero_focal_y_pct = _hero_focal_y | times: 100 -%}{%- else -%}{%- assign _hero_focal_y_pct = 50 -%}{%- endif -%}
        <a href="{{ _hero_url }}" class="casa-mega-cat-hero">
          {%- if _hero_collection.image != blank -%}
            <img class="casa-mega-cat-hero-img"
                 src="{{ _hero_collection.image | image_url: width: 600 }}"
                 srcset="{{ _hero_collection.image | image_url: width: 300 }} 300w, {{ _hero_collection.image | image_url: width: 600 }} 600w, {{ _hero_collection.image | image_url: width: 900 }} 900w"
                 sizes="(min-width: 1024px) 280px, 360px"
                 alt="{{ _hero_collection.image.alt | escape | default: _hero_title | escape }}"
                 width="600" height="338"
                 loading="lazy" decoding="async"
                 style="object-position: {{ _hero_focal_x_pct }}% {{ _hero_focal_y_pct }}%">
          {%- endif -%}
          <span class="casa-mega-cat-hero-overlay" aria-hidden="true"></span>
          <span class="casa-mega-cat-hero-content">
            <span class="casa-mega-cat-hero-text">
              <span class="casa-mega-cat-hero-tag">Featured · Most-Loved</span>
              <span class="casa-mega-cat-hero-name">{{ _hero_title }}</span>
            </span>
            <span class="casa-mega-cat-hero-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 6 15 12 9 18"/>
              </svg>
            </span>
          </span>
        </a>
      {%- endif -%}

      <div class="casa-mega-cat-list">
        {%- comment -%}
          Detect whether the merchant has hand-curated section dividers
          (`—` em-dash prefix on a title). If so, render in their order
          via the original single-pass loop. If not — and the menu is
          Glow / Lifestyle, not Support — run the 5-pass auto-group
          renderer below so the live drawer matches the Option G mockup
          ("Shop / Lamps / Walls" sub-headers) without the merchant
          having to add divider items in admin.
        {%- endcomment -%}
        {%- assign _has_manual_sections = false -%}
        {%- for _ck in link.links -%}
          {%- assign _ck_first1 = _ck.title | strip | slice: 0, 1 -%}
          {%- if _ck_first1 == '—' or _ck_first1 == '–' -%}
            {%- assign _has_manual_sections = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if menu_variant == 'support' or _has_manual_sections -%}
        {%- for child_link in link.links -%}
          {%- comment -%} Extract real handle from URL (more reliable than link.handle which derives from title) {%- endcomment -%}
          {%- assign _child_url_parts = child_link.url | split: '/' -%}
          {%- assign _child_url_handle = _child_url_parts | last -%}

          {%- comment -%}
            Option G — skip the hero item in the list. It's already
            rendered as the hero card above. Section headers (`—`
            prefix) are NOT skipped even if they share the hero's
            handle (defensive — section markers don't have URLs that
            collide with collection handles).
          {%- endcomment -%}
          {%- if _hero_handle != '' and _child_url_handle == _hero_handle -%}
            {%- continue -%}
          {%- endif -%}

          {%- comment -%} Drawers with the prominent "Shop All [Category]" button above already cover their own collection — skip the duplicate row (e.g. "All Products" in Shop All). {%- endcomment -%}
          {%- if _show_shop_all_cta and _child_url_handle == _link_last_handle -%}{%- continue -%}{%- endif -%}

          {%- assign child_collection = collections[_child_url_handle] -%}
          {%- assign badge_text = '' -%}
          {%- if child_collection.metafields.sgl.badge != blank -%}
            {%- assign badge_text = child_collection.metafields.sgl.badge -%}
          {%- endif -%}

          {%- comment -%}
            Option C — text-led, sectioned (mockups/megamenu-options.html).
            Section header convention: child link titles starting with
            `—` (em-dash) or `--` are rendered as a section header
            (mono UPPERCASE, top border) instead of a clickable item.
            Lets the merchant group categories from the Shopify menu UI:
              — Shop
              All Products
              Best Sellers
              — Lamps
              Floor Lamps
              ...
          {%- endcomment -%}
          {%- assign _ch_first2 = child_link.title | strip | slice: 0, 2 -%}
          {%- assign _is_section = false -%}
          {%- if _ch_first2 == '——' or _ch_first2 == '--' -%}
            {%- assign _is_section = true -%}
          {%- else -%}
            {%- assign _ch_first1 = child_link.title | strip | slice: 0, 1 -%}
            {%- if _ch_first1 == '—' or _ch_first1 == '–' -%}
              {%- assign _is_section = true -%}
            {%- endif -%}
          {%- endif -%}

          {%- if _is_section -%}
            <div class="casa-mega-cat-section">
              {{ child_link.title | replace: '——', '' | replace: '—', '' | replace: '–', '' | replace: '--', '' | strip }}
            </div>
          {%- else -%}
            {%- comment -%}
              Featured highlight: brand purple→pink left-edge bar — single
              accent moment per drawer. Triggered by casa.badge metafield
              ("featured"/"best"/"popular"/"hot") or by a known featured
              handle.
            {%- endcomment -%}
            {%- assign _is_featured = false -%}
            {%- assign _badge_lc = badge_text | downcase -%}
            {%- if _badge_lc == 'featured' or _badge_lc == 'best' or _badge_lc == 'popular' or _badge_lc == 'hot' -%}
              {%- assign _is_featured = true -%}
            {%- elsif _child_url_handle == 'best-sellers' or _child_url_handle == 'bestsellers' -%}
              {%- assign _is_featured = true -%}
            {%- endif -%}

            <a href="{{ child_link.url }}" class="casa-mega-cat-item{% if _is_featured %} casa-mega-cat-item--featured{% endif %}">
              <span class="casa-mega-cat-name">{{ child_link.title }}</span>
              {%- comment -%}
                Subtitle: only render when we have actual content. The
                chevron already implies "click to learn more"; rendering
                a literal "Learn more" on every row is redundant noise.
              {%- endcomment -%}
              {%- if menu_variant == 'support' -%}
                {%- if child_collection.metafields.sgl.description != blank -%}
                  <span class="casa-mega-cat-count">{{ child_collection.metafields.sgl.description }}</span>
                {%- endif -%}
              {%- elsif child_collection -%}
                {%- assign _child_count = child_collection.all_products_count | default: child_collection.products_count | plus: 0 -%}
                {%- if _child_count > 0 -%}
                  <span class="casa-mega-cat-count">{{ _child_count }} items</span>
                {%- endif -%}
              {%- endif -%}
              <svg class="casa-mega-cat-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </a>
          {%- endif -%}
        {%- endfor -%}

        {%- else -%}
        {%- comment -%}
          ═══════════════════════════════════════════════════════════
          Auto-group renderer (5 sub-passes by detected category type)
          Activates when the merchant has NOT provided manual `—`
          dividers AND the menu variant is Glow / Lifestyle. Sorts
          children into Shop / Lamps / Walls & Surfaces / Home / More
          buckets so the live drawer matches the Option G mockup
          ("Shop / Lamps / Walls" sub-headers) without admin work.
          Each pass renders its section header lazily — only if at
          least one child landed in that bucket.
          ═══════════════════════════════════════════════════════════
        {%- endcomment -%}
        {%- assign _section_labels = 'Shop|Skincare|Makeup|Wellness|More' | split: '|' -%}
        {%- for _section_label in _section_labels -%}
          {%- assign _section_idx = forloop.index -%}
          {%- assign _section_rendered = false -%}

          {%- comment -%}
            Within each section, render in two priority passes:
              priority 1 — "all-*" overview entries (e.g. "All Lighting"
                           in Lamps, "All Products" in Shop). These
                           always come first as the parent entry.
              priority 2 — everything else, in merchant menu order.
          {%- endcomment -%}
          {%- for _priority in (1..2) -%}
          {%- for child_link in link.links -%}
            {%- assign _child_url_parts = child_link.url | split: '/' -%}
            {%- assign _child_url_handle = _child_url_parts | last -%}

            {%- comment -%} Skip the hero (rendered above) and any defensive `—` markers {%- endcomment -%}
            {%- if _hero_handle != '' and _child_url_handle == _hero_handle -%}{%- continue -%}{%- endif -%}
            {%- if _show_shop_all_cta and _child_url_handle == _link_last_handle -%}{%- continue -%}{%- endif -%}
            {%- assign _ch_first1 = child_link.title | strip | slice: 0, 1 -%}
            {%- if _ch_first1 == '—' or _ch_first1 == '–' -%}{%- continue -%}{%- endif -%}

            {%- comment -%}
              Bucket assignment — checks URL handle first, then falls
              back to the link title for cases where the handle is
              obscure (e.g. /collections/whats-new vs /collections/
              new-arrivals). Title check is an EXACT match against
              well-known shop labels so we don't false-positive on a
              category whose name happens to contain "new" or "best".
              Order of elif matters:
                "wall-lamps"    matches Lamps  (lamp before wall)
                "table-lamps"   matches Lamps  (lamp before table)
                "infinity-mirrors" matches Walls & Surfaces
                everything else  → More
            {%- endcomment -%}
            {%- assign _h = _child_url_handle | downcase -%}
            {%- assign _t = child_link.title | downcase | strip -%}
            {%- assign _belongs_to = 5 -%}
            {%- if _h contains 'all-product' or _h == 'all' or _h contains 'best-seller' or _h contains 'bestseller' or _h contains 'arrival' or _h == 'new' or _h contains 'whats-new' or _h contains 'gift' or _h contains 'sale' or _h contains 'perfect' or _t == 'new arrivals' or _t == 'best sellers' or _t == 'all products' or _t == 'sale' or _t == 'whats new' -%}
              {%- assign _belongs_to = 1 -%}
            {%- elsif _h contains 'cleans' or _h contains 'toner' or _h contains 'serum' or _h contains 'essence' or _h contains 'moistur' or _h contains 'sunscreen' or _h contains 'spf' or _h contains 'mask' or _h contains 'eye-cream' or _h contains 'eye-care' or _h contains 'exfoli' or _h contains 'treatment' or _h contains 'ampoule' or _h contains 'skin' or _h contains 'acne' -%}
              {%- assign _belongs_to = 2 -%}
            {%- elsif _h contains 'makeup' or _h contains 'make-up' or _h contains 'cosmetic' or _h contains 'lip' or _h contains 'palette' or _h contains 'shadow' or _h contains 'foundation' or _h contains 'cushion' or _h contains 'blush' or _h contains 'brow' or _h contains 'mascara' or _h contains 'liner' or _h contains 'tint' -%}
              {%- assign _belongs_to = 3 -%}
            {%- elsif _h contains 'wellness' or _h contains 'ritual' or _h contains 'tea' or _h contains 'tool' or _h contains 'gua' or _h contains 'body' or _h contains 'hair' or _h contains 'supplement' -%}
              {%- assign _belongs_to = 4 -%}
            {%- endif -%}
            {%- if _belongs_to != _section_idx -%}{%- continue -%}{%- endif -%}

            {%- comment -%} Priority filter — "all-*" first, everything else second {%- endcomment -%}
            {%- assign _is_all = false -%}
            {%- if _h == 'all' or _h contains 'all-' -%}{%- assign _is_all = true -%}{%- endif -%}
            {%- if _priority == 1 and _is_all == false -%}{%- continue -%}{%- endif -%}
            {%- if _priority == 2 and _is_all == true -%}{%- continue -%}{%- endif -%}

            {%- comment -%} Lazy section header — only render when at least one item lands in this bucket {%- endcomment -%}
            {%- if _section_rendered == false -%}
              <div class="casa-mega-cat-section">{{ _section_label }}</div>
              {%- assign _section_rendered = true -%}
            {%- endif -%}

            {%- comment -%} Featured row indicator — same heuristic as the manual-sections branch {%- endcomment -%}
            {%- assign child_collection = collections[_child_url_handle] -%}
            {%- assign _is_featured = false -%}
            {%- assign _badge_lc = '' -%}
            {%- if child_collection.metafields.sgl.badge != blank -%}
              {%- assign _badge_lc = child_collection.metafields.sgl.badge | downcase -%}
            {%- endif -%}
            {%- if _badge_lc == 'featured' or _badge_lc == 'best' or _badge_lc == 'popular' or _badge_lc == 'hot' -%}
              {%- assign _is_featured = true -%}
            {%- elsif _h == 'best-sellers' or _h == 'bestsellers' -%}
              {%- assign _is_featured = true -%}
            {%- endif -%}

            <a href="{{ child_link.url }}" class="casa-mega-cat-item{% if _is_featured %} casa-mega-cat-item--featured{% endif %}">
              <span class="casa-mega-cat-name">{{ child_link.title }}</span>
              {%- if child_collection -%}
                {%- assign _child_count = child_collection.all_products_count | default: child_collection.products_count | plus: 0 -%}
                {%- if _child_count > 0 -%}
                  <span class="casa-mega-cat-count">{{ _child_count }} items</span>
                {%- endif -%}
              {%- endif -%}
              <svg class="casa-mega-cat-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </a>
          {%- endfor -%}
          {%- endfor -%}
        {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ── Center Column ── {%- endcomment -%}
    <div class="casa-mega-products">
      {%- if menu_variant == 'support' -%}
        {%- comment -%} ── Support: FAQ / Help Cards ── {%- endcomment -%}
        <div class="casa-mega-products-header">
          <span class="casa-mega-section-title" style="margin-bottom:0;">{{ quick_help_title | default: 'Quick Help' }}</span>
        </div>
        <div class="casa-mega-faq-grid">
          {%- for child_link in link.links limit: 4 -%}
            {%- comment -%}
              Resolve real handle from URL (link.handle drifts from
              title in some cases). The icon `case` matches against
              this — previously the case was matching against
              `_child_url_handle` which is only assigned in the
              categories-column loop, so every FAQ card fell through
              to the default `search` icon. Now handles + a couple of
              extra cases (track-order / privacy / terms) so each
              card gets a meaningful icon.
            {%- endcomment -%}
            {%- assign _faq_url_parts = child_link.url | split: '/' -%}
            {%- assign _faq_handle = _faq_url_parts | last -%}
            {%- assign faq_collection = collections[_faq_handle] -%}
            {%- assign faq_page = pages[_faq_handle] -%}
            {%- assign faq_icon = 'search' -%}
            {%- assign _faq_title = child_link.title | downcase | strip -%}

            {%- comment -%}
              Icon resolution: try the URL handle first (exact match
              against known support handles), then fall back to a
              substring check against the link TITLE. The title
              fallback catches cases where the merchant's URL handle
              doesn't match our list (e.g. /pages/track-your-order
              instead of /pages/track-order, or /pages/about-our-store
              instead of /pages/about-us). The title is the merchant-
              facing string, so it's more stable.
            {%- endcomment -%}
            {%- case _faq_handle -%}
              {%- when 'contact', 'contact-us' -%}{%- assign faq_icon = 'headphones' -%}
              {%- when 'shipping', 'shipping-policy' -%}{%- assign faq_icon = 'truck' -%}
              {%- when 'returns', 'refund-policy', 'refunds-returns' -%}{%- assign faq_icon = 'refresh' -%}
              {%- when 'warranty' -%}{%- assign faq_icon = 'shield-check' -%}
              {%- when 'faq' -%}{%- assign faq_icon = 'search' -%}
              {%- when 'our-story', 'about', 'about-us' -%}{%- assign faq_icon = 'users' -%}
              {%- when 'customer-reviews', 'reviews' -%}{%- assign faq_icon = 'star' -%}
              {%- when 'installation', 'apollo-installation' -%}{%- assign faq_icon = 'zap' -%}
              {%- when 'track-order', 'order-status', 'order-tracking', 'track-your-order', 'track' -%}{%- assign faq_icon = 'package' -%}
              {%- when 'privacy-policy', 'privacy' -%}{%- assign faq_icon = 'shield-check' -%}
              {%- when 'terms-of-service', 'terms', 'terms-conditions', 'terms-and-conditions' -%}{%- assign faq_icon = 'document' -%}
            {%- endcase -%}

            {%- comment -%} Title-based fallback when handle didn't match {%- endcomment -%}
            {%- if faq_icon == 'search' -%}
              {%- if _faq_title contains 'track' or _faq_title contains 'order' -%}
                {%- assign faq_icon = 'package' -%}
              {%- elsif _faq_title contains 'contact' -%}
                {%- assign faq_icon = 'headphones' -%}
              {%- elsif _faq_title contains 'ship' -%}
                {%- assign faq_icon = 'truck' -%}
              {%- elsif _faq_title contains 'return' or _faq_title contains 'refund' -%}
                {%- assign faq_icon = 'refresh' -%}
              {%- elsif _faq_title contains 'warranty' -%}
                {%- assign faq_icon = 'shield-check' -%}
              {%- elsif _faq_title contains 'story' or _faq_title contains 'about' -%}
                {%- assign faq_icon = 'users' -%}
              {%- elsif _faq_title contains 'review' -%}
                {%- assign faq_icon = 'star' -%}
              {%- elsif _faq_title contains 'install' -%}
                {%- assign faq_icon = 'zap' -%}
              {%- elsif _faq_title contains 'privacy' -%}
                {%- assign faq_icon = 'shield-check' -%}
              {%- elsif _faq_title contains 'terms' -%}
                {%- assign faq_icon = 'document' -%}
              {%- elsif _faq_title == 'faq' or _faq_title contains 'question' or _faq_title contains 'help' -%}
                {%- assign faq_icon = 'search' -%}
              {%- endif -%}
            {%- endif -%}
            <a href="{{ child_link.url }}" class="casa-mega-faq-card">
              <div class="casa-mega-faq-icon">
                {%- render 'casa-icon', icon: faq_icon, size: 20 -%}
              </div>
              <div class="casa-mega-faq-title">{{ child_link.title }}</div>
              {%- comment -%}
                Description: only render when there's actual content
                (collection.casa.description metafield, or a page's
                custom.page_subtitle). No "Learn more" / "Quick help"
                fallback — the chevron arrow already implies "click
                to learn more" and rendering literal placeholder copy
                on every card was wasteful noise.
              {%- endcomment -%}
              {%- assign _faq_desc = '' -%}
              {%- if faq_collection.metafields.sgl.description != blank -%}
                {%- assign _faq_desc = faq_collection.metafields.sgl.description -%}
              {%- elsif faq_page != blank and faq_page.metafields.custom.page_subtitle != blank -%}
                {%- assign _faq_desc = faq_page.metafields.custom.page_subtitle -%}
              {%- endif -%}
              {%- if _faq_desc != blank -%}
                <div class="casa-mega-faq-desc">{{ _faq_desc }}</div>
              {%- endif -%}
              <span class="casa-mega-faq-arrow">
                {%- render 'casa-icon', icon: 'arrow-right', size: 14 -%}
              </span>
            </a>
          {%- endfor -%}
        </div>

      {%- else -%}
        {%- comment -%} ── Glow & Lifestyle: Products Grid ── {%- endcomment -%}
        {%- comment -%}
          Collection priority:
            1. Custom per-menu override (menu_collection block)
            2. The actual menu link's collection — when the merchant
               links a top-level menu item to a collection (e.g. "Home
               Decor" → /collections/home-decor), pull products from
               THAT collection. This stops Home Decor from showing
               Infinity Mirrors just because the merchant set the
               generic collection_lifestyle to a catch-all.
            3. Variant default (collection_lifestyle / collection_glow
               section settings) for menus whose top-level link isn't
               a collection_link.
        {%- endcomment -%}
        {%- liquid
          assign _active_collection = nil
          if custom_collection != blank
            assign _active_collection = collections[custom_collection]
          elsif link.type == 'collection_link' and link.object != blank
            assign _active_collection = link.object
          endif
          if _active_collection == blank or _active_collection == nil
            if menu_variant == 'lifestyle'
              assign _active_collection = collections[collection_lifestyle]
            else
              assign _active_collection = collections[collection_glow]
            endif
          endif
        -%}
        <div class="casa-mega-products-header">
          <span class="casa-mega-section-title" style="margin-bottom:0;">
            {%- if custom_products_title != blank -%}
              {{ custom_products_title }}
            {%- elsif menu_variant == 'lifestyle' -%}
              {{ products_title_lifestyle | default: 'Curated Picks' }}
            {%- else -%}
              {{ products_title_glow | default: 'Trending Now' }}
            {%- endif -%}
          </span>
          {%- if _active_collection != blank -%}
            <a href="{{ _active_collection.url }}" class="casa-mega-products-link">
              View All {%- render 'casa-icon', icon: 'arrow-right', size: 14 -%}
            </a>
          {%- endif -%}
        </div>
        <div class="casa-mega-products-grid" data-columns="{{ products_per_row | default: 'auto' }}">
          {%- assign mega_collection = _active_collection -%}
          {%- if mega_collection -%}
            {%- assign _product_limit = custom_product_limit | default: nil -%}
            {%- if _product_limit == nil -%}
              {%- if menu_variant == 'lifestyle' -%}{%- assign _product_limit = product_limit_lifestyle | default: 4 -%}
              {%- else -%}{%- assign _product_limit = product_limit_glow | default: 6 -%}{%- endif -%}
            {%- endif -%}
            {%- for product in mega_collection.products limit: _product_limit -%}
              <a href="{{ product.url }}" class="casa-mega-product-card">
                <div class="casa-mega-product-img">
                  {%- if product.featured_image != blank -%}
                    {%- comment -%}
                      sizes: 1:1 grid cell in the desktop-only mega panel —
                      middle column ≈ 52% of the panel (max-width 1400px,
                      growing to 1600px at ≥1920px). Cells ≤ ~280px below
                      1920 (2 or 3 cols), ≤ ~350px on the wider ≥1920 panel
                      with explicit 2 cols. Sizes-less srcset would default
                      the slot to 100vw (Safari 26 intrinsic trap — see
                      snippets/casa-cart-items.liquid).
                    {%- endcomment -%}
                    {{ product.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', class: 'casa-mega-product-photo', sizes: '(min-width: 1920px) 350px, 280px' }}
                  {%- else -%}
                    /* perf-justified: desktop megamenu — only renders on hover, dismissed within seconds */
                    <div class="casa-octagon" style="width:60%;height:60%;background:conic-gradient(from var(--angle),var(--mega-accent-1),var(--mega-accent-2),var(--mega-accent-3),var(--mega-accent-1));animation:casa-rotate 8s linear infinite;"></div>
                  {%- endif -%}

                  {%- if product.tags contains 'bestseller' -%}
                    <span class="casa-mega-product-badge casa-mega-product-badge--bestseller">Bestseller</span>
                  {%- elsif product.tags contains 'new' -%}
                    <span class="casa-mega-product-badge casa-mega-product-badge--new">New</span>
                  {%- elsif product.compare_at_price > product.price -%}
                    {%- assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
                    <span class="casa-mega-product-badge casa-mega-product-badge--sale">-{{ discount }}%</span>
                  {%- endif -%}
                </div>
                <div class="casa-mega-product-name">{{ product.title }}</div>
                <div class="casa-mega-product-price">
                  <span class="casa-mega-product-price-current">{{ product.price | money_with_currency }}</span>
                  {%- if product.compare_at_price > product.price -%}
                    <span class="casa-mega-product-price-original">{{ product.compare_at_price | money_with_currency }}</span>
                  {%- endif -%}
                </div>
              </a>
            {%- endfor -%}
          {%- else -%}
            {%- assign _placeholder_limit = product_limit_glow | default: 6 -%}
            {%- if menu_variant == 'lifestyle' -%}{%- assign _placeholder_limit = product_limit_lifestyle | default: 4 -%}{%- endif -%}
            {%- for i in (1.._placeholder_limit) -%}
              <div class="casa-mega-product-card casa-mega-product-card--placeholder">
                <div class="casa-mega-product-img">
                  /* perf-justified: desktop megamenu — only renders on hover, dismissed within seconds */
                  <div class="casa-octagon" style="width:60%;height:60%;background:conic-gradient(from var(--angle),var(--mega-accent-1),var(--mega-accent-2),var(--mega-accent-3),var(--mega-accent-1));animation:casa-rotate 8s linear infinite;"></div>
                </div>
                <div class="casa-mega-product-name">Product {{ i }}</div>
                <div class="casa-mega-product-price">
                  <span class="casa-mega-product-price-current">{{ 0 | money_with_currency }}</span>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ── Right Column: Featured Area ── {%- endcomment -%}
    <div class="casa-mega-featured">
      {%- if menu_variant == 'support' -%}
        {%- comment -%} ── Support: Contact Us Card ── {%- endcomment -%}
        <div class="casa-mega-featured-card">
          {%- if featured_label_support != blank -%}
            <span class="casa-mega-featured-label">
              {%- render 'casa-icon', icon: 'headphones', size: 14 -%}
              {{ featured_label_support }}
            </span>
          {%- endif -%}
          {%- if support_title != blank -%}
            <h3 class="casa-mega-featured-title">{{ support_title | newline_to_br }}</h3>
          {%- endif -%}
          {%- if support_description != blank -%}
            <p class="casa-mega-featured-desc">{{ support_description | newline_to_br }}</p>
          {%- endif -%}
          <div class="casa-mega-contact-methods">
            {%- if support_email != blank -%}
              <a href="mailto:{{ support_email }}" class="casa-mega-contact-item">
                {%- render 'casa-icon', icon: 'mail', size: 18 -%}
                <span>{{ support_email }}</span>
              </a>
            {%- endif -%}
            {%- if support_phone != blank -%}
              <a href="tel:{{ support_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}" class="casa-mega-contact-item">
                {%- render 'casa-icon', icon: 'smartphone', size: 18 -%}
                <span>{{ support_phone }}</span>
              </a>
            {%- endif -%}
            {%- if support_chat_label != blank -%}
              <a href="{{ support_chat_link | default: '/pages/contact-us' }}" class="casa-mega-contact-item">
                {%- render 'casa-icon', icon: 'message-circle', size: 18 -%}
                <span>{{ support_chat_label }}</span>
              </a>
            {%- endif -%}
          </div>
          {%- if support_btn_text != blank -%}
          <div class="casa-mega-featured-cta">
            <a href="{{ support_btn_link | default: '/pages/contact-us' }}" class="casa-mega-featured-btn casa-mega-featured-btn--primary">
              {{ support_btn_text }} {%- render 'casa-icon', icon: 'arrow-right', size: 16 -%}
            </a>
          </div>
          {%- endif -%}
        </div>

      {%- elsif menu_variant == 'lifestyle' -%}
        {%- comment -%} ── Lifestyle: Style Inspiration Card ── {%- endcomment -%}
        <div class="casa-mega-featured-card">
          {%- if featured_label_lifestyle != blank -%}
            <span class="casa-mega-featured-label">
              {%- render 'casa-icon', icon: 'eye', size: 14 -%}
              {{ featured_label_lifestyle }}
            </span>
          {%- endif -%}
          {%- if lifestyle_title != blank -%}
            <h3 class="casa-mega-featured-title">{{ lifestyle_title | newline_to_br }}</h3>
          {%- endif -%}
          {%- if lifestyle_subtitle != blank -%}
            <p class="casa-mega-featured-desc">{{ lifestyle_subtitle | newline_to_br }}</p>
          {%- endif -%}
          <div class="casa-mega-featured-visual">
            {%- if lifestyle_image -%}
              {%- comment -%}
                sizes: the featured visual fills the mega panel's right
                column — 28% of the ≤1400px panel by default, 38% in the
                support variant; 38vw covers the worst case. Sizes-less
                srcset would default the slot to 100vw (see
                snippets/casa-cart-items.liquid).
              {%- endcomment -%}
              {{ lifestyle_image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 1440px) 500px, 38vw' }}
            {%- elsif lifestyle_video_url != blank -%}
              {%- comment -%}
                Lazy-loaded: mega menu is hidden via opacity:0 +
                visibility:hidden until the user hovers the parent
                nav link. Without lazy-load the browser would fetch
                this video on every page load even though the menu
                is never visible without interaction. Trigger lives
                in the parent casa-header.liquid section JS — first
                pointerover on any nav link swaps data-src → src
                across all .casa-mega-featured-video elements.
              {%- endcomment -%}
              <video class="casa-mega-featured-video" loop muted playsinline preload="none" data-casa-mega-lazy-video>
                <source data-src="{{ lifestyle_video_url | escape }}" type="video/mp4">
              </video>
            {%- else -%}
              <div class="casa-mega-featured-lifestyle-placeholder">
                {%- render 'casa-icon', icon: 'sun', size: 40 -%}
              </div>
            {%- endif -%}
          </div>
          <div class="casa-mega-featured-cta">
            {%- if lifestyle_btn_primary != blank -%}
              <a href="{{ lifestyle_link | default: '/pages/inspiration' }}" class="casa-mega-featured-btn casa-mega-featured-btn--primary">
                {{ lifestyle_btn_primary }} {%- render 'casa-icon', icon: 'arrow-right', size: 16 -%}
              </a>
            {%- endif -%}
            {%- if lifestyle_btn_secondary != blank -%}
              <a href="{{ lifestyle_btn_secondary_link | default: '/collections' }}" class="casa-mega-featured-btn casa-mega-featured-btn--secondary">
                {{ lifestyle_btn_secondary }}
              </a>
            {%- endif -%}
          </div>
        </div>

      {%- else -%}
        {%- comment -%} ── Glow: Featured Collection Promo (default) ── {%- endcomment -%}
        <div class="casa-mega-featured-card">
          {%- if featured_label_glow != blank -%}
            <span class="casa-mega-featured-label">
              {%- render 'casa-icon', icon: 'sparkles', size: 14 -%}
              {{ featured_label_glow }}
            </span>
          {%- endif -%}
          {%- if promo_title != blank -%}
            <h3 class="casa-mega-featured-title">{{ promo_title | newline_to_br }}</h3>
          {%- endif -%}
          {%- if promo_subtitle != blank -%}
            <p class="casa-mega-featured-desc">{{ promo_subtitle | newline_to_br }}</p>
          {%- endif -%}
          <div class="casa-mega-featured-visual">
            {%- if promo_image -%}
              {%- comment -%}
                sizes: same right-column slot as the lifestyle visual above
                (28% default / 38% support of the ≤1400px panel).
              {%- endcomment -%}
              {{ promo_image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 1440px) 500px, 38vw' }}
            {%- elsif video_url != blank -%}
              <video class="casa-mega-featured-video" loop muted playsinline preload="none" data-casa-mega-lazy-video>
                <source data-src="{{ video_url | escape }}" type="video/mp4">
              </video>
            {%- else -%}
              <div class="casa-mega-featured-lifestyle-placeholder">
                {%- render 'casa-icon', icon: 'sparkles', size: 40 -%}
              </div>
            {%- endif -%}
          </div>
          <div class="casa-mega-featured-cta">
            {%- if promo_btn_primary != blank -%}
              <a href="{{ promo_link | default: '/collections/all' }}" class="casa-mega-featured-btn casa-mega-featured-btn--primary">
                {{ promo_btn_primary }} {%- render 'casa-icon', icon: 'arrow-right', size: 16 -%}
              </a>
            {%- endif -%}
            {%- if promo_btn_secondary != blank -%}
              <a href="{{ promo_btn_secondary_link | default: '/collections' }}" class="casa-mega-featured-btn casa-mega-featured-btn--secondary">
                {{ promo_btn_secondary }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ── Bottom: Quick Links (pre-rendered from blocks) ── {%- endcomment -%}
    {%- assign _support_links = support_quick_links_html | strip -%}
    {%- assign _lifestyle_links = lifestyle_quick_links_html | strip -%}
    {%- assign _glow_links = glow_quick_links_html | strip -%}
    {%- if menu_variant == 'support' and _support_links != blank -%}
      <div class="casa-mega-quick">{{ support_quick_links_html }}</div>
    {%- elsif menu_variant == 'lifestyle' and _lifestyle_links != blank -%}
      <div class="casa-mega-quick">{{ lifestyle_quick_links_html }}</div>
    {%- elsif _glow_links != blank -%}
      <div class="casa-mega-quick">{{ glow_quick_links_html }}</div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
  /* ═══════════════════════════════════════════════════════
     VARIANT COLOR SYSTEM
     Colors are inherited from parent .casa-header-section CSS vars
     ═══════════════════════════════════════════════════════ */

  /* ════════════════════════════════════════════════════════════
     BRAND V1 QUIET CHROME — uniform across all variants and
     all merchant menu_color settings. Chrome tokens are forced
     to brand purple/pink/cyan regardless of variant. Per-variant
     identity is preserved ONLY through:
       --mega-accent-1, --mega-accent-2, --mega-accent-3
         (used for icons inside featured cards, octagon spinner)
       --mega-featured-label-color
         (small label color above featured card title)
       --mega-link-color
         (text-link color in featured area)
     ════════════════════════════════════════════════════════════ */

  /* Brand chrome tokens — same on every megamenu.
     Default --casa-section-text is Casa Paper (#FAFAF7) for the
     Portal/Editorial Ink-surface menus. Lifestyle variant overrides
     to Casa Ink for its Daylit Paper surface (see below). */
  .casa-mega-menu {
    --mega-glow-1: rgba(176, 195, 250, 0.06);
    --mega-glow-2: rgba(94, 10, 2, 0.04);
    --mega-cat-hover-bg: linear-gradient(135deg, rgba(176, 195, 250, 0.10), rgba(94, 10, 2, 0.06));
    --mega-cat-icon-bg: linear-gradient(135deg, rgba(176, 195, 250, 0.18), rgba(94, 10, 2, 0.12));
    --mega-cat-icon-hover: linear-gradient(135deg, #B0C3FA, #5E0A02);
    --mega-featured-bg: linear-gradient(135deg, rgba(176, 195, 250, 0.10), rgba(94, 10, 2, 0.06));
    --mega-featured-top-bar: linear-gradient(90deg, #B0C3FA, #5E0A02, #F2FFA0);
    --mega-card-hover-border: rgba(176, 195, 250, 0.28);
    --casa-section-text: var(--casa-text-primary);
  }

  /* ── Glow (default): Purple + Pink ── content-level accents only */
  .casa-mega-menu--glow {
    --mega-accent-1: var(--casa-glow-primary, #B0C3FA);
    --mega-accent-2: var(--casa-glow-secondary, #5E0A02);
    --mega-accent-3: var(--casa-support-primary, #F2FFA0);
    --mega-accent-1-rgb: var(--casa-glow-primary-rgb, 176, 195, 250);
    --mega-accent-2-rgb: var(--casa-glow-secondary-rgb, 94, 10, 2);
    --mega-featured-label-color: var(--casa-glow-secondary, #5E0A02);
    --mega-link-color: var(--casa-glow-primary, #B0C3FA);
  }

  /* ── Lifestyle: Daylit mood = brand Paper surface ──
     Per brand book (docs/brand-book-v1.html), the lifestyle variant
     covers Home Decor / Coffee Tables / Vases / Furniture / Decor —
     sculptural objects best lit by daylight on Paper. Switching the
     panel surface from Ink to Paper for these menus only.

     - --theme-bg: Casa Paper (#FAFAF7) gradient at 0.86/0.90 opacity
       (matches the partial-frost depth of the Ink panels)
     - --theme-text + --theme-text-muted: Casa Ink for body copy
     - --casa-section-text: Casa Ink for section headers (overrides
       the default Paper that suits the Ink surface)
     - --theme-card-bg / --theme-divider: subtle dark on light tones
     - All other tokens (per-variant accents) carry through.

     Selector specificity note: written as `.casa-mega-menu.casa-mega-
     menu--lifestyle` (2-class) instead of just `.casa-mega-menu--
     lifestyle` (1-class) so the lifestyle Paper tokens win over the
     `.casa-mega-theme--white/-gold/-midnight/-emerald/-rose/-dark-glow`
     rules below — those single-class theme modifiers were making the
     Home Decor menu render Ink even when lifestyle was applied. The
     lifestyle variant's surface choice always overrides the theme
     dropdown's surface; theme keeps responsibility for accent colors.

     Opacity 0.82/0.86 matches the stronger frost dialed in for the
     Ink panels (rgba(15,15,24,0.78) → rgba(10,10,15,0.82)) — slightly
     more opaque on the Paper variant since dark text needs more
     surface contrast than white text. */
  .casa-mega-menu.casa-mega-menu--lifestyle {
    --theme-bg: linear-gradient(180deg, rgba(250, 250, 247, 0.82) 0%, rgba(248, 246, 240, 0.86) 100%);
    --theme-border: rgba(0, 0, 0, 0.08);
    --theme-text: var(--casa-ink);
    --theme-text-muted: rgba(10, 10, 15, 0.55);
    --theme-card-bg: rgba(0, 0, 0, 0.02);
    --theme-card-border: rgba(0, 0, 0, 0.06);
    --theme-card-hover-bg: rgba(0, 0, 0, 0.04);
    --theme-divider: rgba(0, 0, 0, 0.08);
    --theme-btn-primary-bg: var(--casa-ink);
    --theme-btn-primary-text: #ffffff;
    --theme-btn-secondary-bg: rgba(0, 0, 0, 0.05);
    --theme-btn-secondary-text: var(--casa-ink);
    --theme-btn-secondary-border: rgba(0, 0, 0, 0.12);
    --theme-scrollbar-track: rgba(0, 0, 0, 0.04);
    --casa-section-text: var(--casa-ink);

    --mega-accent-1: var(--casa-lifestyle-primary, #f59e0b);
    --mega-accent-2: var(--casa-lifestyle-secondary, #d97706);
    --mega-accent-3: #fbbf24;
    --mega-accent-1-rgb: var(--casa-lifestyle-primary-rgb, 245, 158, 11);
    --mega-accent-2-rgb: var(--casa-lifestyle-secondary-rgb, 217, 119, 6);
    --mega-featured-label-color: var(--casa-lifestyle-primary, #f59e0b);
    --mega-link-color: var(--casa-lifestyle-primary, #f59e0b);
  }

  /* ── Support: per-variant identity in tiny accents only ── */
  .casa-mega-menu--support {
    --mega-accent-1: var(--casa-support-primary, #F2FFA0);
    --mega-accent-2: var(--casa-support-secondary, #F2FFA0);
    --mega-accent-3: #67e8f9;
    --mega-accent-1-rgb: var(--casa-support-primary-rgb, 242, 255, 160);
    --mega-accent-2-rgb: var(--casa-support-secondary-rgb, 8, 145, 178);
    --mega-featured-label-color: #ffffff;
    --mega-link-color: var(--casa-support-primary, #F2FFA0);
  }

  /* Support variant: wider card column + taller menu to fit contact info */
  .casa-mega-menu--support {
    max-height: min(820px, var(--mega-avail-h));
    overflow-y: auto;
    scrollbar-width: none;
  }
  .casa-mega-menu--support::-webkit-scrollbar {
    display: none;
  }
  .casa-mega-menu--support .casa-mega-inner {
    grid-template-columns: minmax(0, 18%) minmax(0, 1fr) minmax(0, 38%);
    max-height: none;
    overflow: visible;
  }

  /* Support featured area: allow vertical overflow for tall content, but clip horizontally to keep text inside the card */
  .casa-mega-menu--support .casa-mega-featured {
    overflow-x: hidden;
    overflow-y: visible;
  }
  .casa-mega-menu--support .casa-mega-featured-card {
    overflow: hidden;
  }

  /* Support featured card: white text and icons */
  .casa-mega-menu--support .casa-mega-featured-card .casa-mega-featured-label {
    color: #ffffff;
  }
  .casa-mega-menu--support .casa-mega-featured-card .casa-mega-featured-label svg {
    color: #ffffff;
  }
  .casa-mega-menu--support .casa-mega-contact-item svg {
    color: #ffffff;
  }
  .casa-mega-menu--support .casa-mega-contact-item {
    color: #ffffff;
  }

  /* Support variant ONLY: here the count slot holds a free-text
     `metafields.sgl.description` (see render ~line 434), not a short
     "N items" string. In the narrow 18% support column — whose
     `.casa-mega-inner` is intentionally `overflow: visible` — a long
     description in a `flex-shrink: 0; white-space: nowrap` count would
     bleed past the column edge (measured ~112px over with a realistic
     one-line description). Let the support count shrink and clip so a
     long description can NEVER overflow at any width.

     `max-width: 55%` is deliberate and sets the yield order: the name is
     `flex: 1 1 0%` (basis 0), so WITHOUT the cap a long description
     wins the row and the category label collapses to 0px (verified) —
     backwards for a support link, where the label matters more than its
     subtitle. Capping the description at 55% guarantees the name keeps
     ~45% of the row, so the DESCRIPTION truncates first and the label
     stays visible. The "N items" counts in the glow / lifestyle variants
     keep the default `flex-shrink: 0` (no cap) and are unaffected; short
     descriptions here still display in full (nothing to clip). */
  .casa-mega-menu--support .casa-mega-cat-count {
    flex-shrink: 1;
    min-width: 0;
    max-width: 55%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

