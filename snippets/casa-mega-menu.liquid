      max-width: 2200px;
      max-height: min(1000px, var(--mega-avail-h));
      border-radius: 0 0 32px 32px;
    }

    .casa-mega-inner {
      padding: 64px;
      gap: 44px;
      grid-template-columns: minmax(0, 16%) minmax(0, 1fr) minmax(0, 20%);
      max-height: calc(min(1000px, var(--mega-avail-h)) - 128px);
    }

    .casa-mega-section-title {
      font-size: 13px;
      letter-spacing: 2.5px;
      margin-bottom: 32px;
    }

    .casa-mega-cat-item {
      padding: 20px 24px 20px 0;
      border-radius: 18px;
      gap: 12px;
    }

    .casa-mega-cat-icon {
      width: 58px;
      height: 58px;
      border-radius: 16px;
    }

    .casa-mega-cat-icon svg {
      width: 30px;
      height: 30px;
    }

    .casa-mega-cat-name {
      font-size: 18px;
    }

    .casa-mega-cat-count {
      font-size: 15px;
    }

    .casa-mega-cat-arrow svg {
      width: 24px;
      height: 24px;
    }

    /* 5 columns for products on super ultrawide */
    .casa-mega-products-grid,
    .casa-mega-products-grid[data-columns="auto"] {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 32px;
    }

    .casa-mega-products-grid[data-columns="2"] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .casa-mega-products-grid[data-columns="3"] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .casa-mega-product-card {
      padding: 24px;
      border-radius: 20px;
    }

    .casa-mega-product-img {
      border-radius: 16px;
      margin-bottom: 16px;
    }

    .casa-mega-product-name {
      font-size: 17px;
      margin-bottom: 10px;
    }

    .casa-mega-product-price-current {
      font-size: 18px;
    }

    .casa-mega-product-price-original {
      font-size: 14px;
    }

    .casa-mega-product-badge {
      font-size: 11px;
      padding: 6px 14px;
    }

    .casa-mega-featured-card {
      padding: 40px;
      border-radius: 28px;
    }

    .casa-mega-featured-label {
      font-size: 12px;
      margin-bottom: 24px;
    }

    .casa-mega-featured-title {
      font-size: 32px;
      margin-bottom: 16px;
    }

    .casa-mega-featured-desc {
      font-size: 17px;
      margin-bottom: 28px;
    }

    .casa-mega-featured-visual {
      min-height: 220px;
      border-radius: 20px;
      margin-bottom: 28px;
    }

    .casa-mega-featured-cta {
      gap: 14px;
    }

    .casa-mega-featured-btn {
      padding: 18px 28px;
      font-size: 16px;
      border-radius: 16px;
    }

    .casa-mega-quick {
      padding-top: 32px;
      gap: 18px;
    }

    .casa-mega-quick-link {
      padding: 16px 28px;
      font-size: 16px;
    }

    /* Contact methods */
    .casa-mega-contact-item {
      padding: 20px 24px;
      font-size: 16px;
      border-radius: 16px;
    }

    .casa-mega-contact-item svg {
      width: 24px;
      height: 24px;
    }

    /* FAQ cards */
    .casa-mega-faq-grid {
      gap: 24px;
    }

    .casa-mega-faq-card {
      padding: 28px;
      border-radius: 20px;
    }

    .casa-mega-faq-icon {
      width: 54px;
      height: 54px;
      border-radius: 14px;
    }

    .casa-mega-faq-icon svg {
      width: 26px;
      height: 26px;
    }

    .casa-mega-faq-title {
      font-size: 18px;
    }

    .casa-mega-faq-desc {
      font-size: 15px;
    }

    /* Ambient glow - larger on big screens */
    .casa-mega-menu::before {
      width: 800px;
      height: 500px;
    }

    .casa-mega-menu::after {
      width: 600px;
      height: 400px;
    }
  }
{% endstylesheet %}
