{% doc %}
  Continuous curved composition of seven rendered OctaMirror components, with a manual fallback.
  @param {string} instance_id - Unique section ID for labels and navigation.
  @example
  {% render 'casa-octamirror-layers-v7', instance_id: section.id %}
{% enddoc %}

