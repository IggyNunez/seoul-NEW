{% stylesheet %}
  .casa-octa-build-v7 { display: block; position: relative; min-width: 0; margin-block: clamp(48px, 7vw, 100px); color: #24242a; background: transparent; font-family: var(--font-body--family, 'Inter', sans-serif); }
  .casa-octa-build-v7 [hidden] { display: none !important; }
  .casa-octa-build-v7__endnote { display: none; margin: 12px; font-size: 14px; line-height: 1.5; color: #62596c; }
  .casa-octa-build-v7__track { position: relative; }
  .casa-octa-build-v7__load-status { padding: 12px; font-size: 16px; line-height: 1.5; }
  .casa-octa-build-v7 [data-retry] { display: inline-block; margin-left: 8px; border: 0; background: transparent; color: #563573; text-decoration: underline; }
