{%- comment -%}
  Casa Editorial Story — shared content snippet
  Renders: names row, divider, heading, body text, CTA button
  Used by casa-editorial-story.liquid across all layout modes.
{%- endcomment -%}

{%- comment -%} ── Names Row ── {%- endcomment -%}
{%- if names_arr.size > 0 and names_arr[0] != '' -%}
  <div class="casa-edit__names" aria-label="Featured characters">
    {%- for name in names_arr -%}
      {%- assign clean_name = name | strip -%}
      {%- if clean_name != '' -%}
        {%- if forloop.index > 1 -%}
          <span class="casa-edit__name-sep" aria-hidden="true">&middot;</span>
        {%- endif -%}
        <span class="casa-edit__name">{{ clean_name }}</span>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}

{%- comment -%} ── Divider ── {%- endcomment -%}
{%- if divider -%}
  <hr class="casa-edit__divider" aria-hidden="true">
{%- endif -%}

{%- comment -%}
  ── Heading ──
  No `| escape` filter: the heading source field is `inline_richtext`
  (sections/casa-editorial-story.liquid schema). Shopify pre-sanitizes
  inline_richtext to a safe inline allowlist (<a>, <em>, <strong>, etc.),
  so unescaped output is safe AND lets the brand italic-gradient `<em>`
  accent land per locked decision `brand_typography_locked_2026-05-04.md`.
  Adding `| escape` would render `<em>` as literal text — bug fixed.
{%- endcomment -%}
{%- if heading != blank -%}
  <h2 class="casa-edit__heading casa-edit__heading--{{ heading_size }}">
    {{- heading -}}
  </h2>
{%- endif -%}

{%- comment -%} ── Body Text ── {%- endcomment -%}
{%- if body_text != blank -%}
  <div class="casa-edit__body">
    {{ body_text }}
  </div>
{%- endif -%}

{%- comment -%} ── CTA Button ── {%- endcomment -%}
{%- if btn_text != blank and btn_url != blank -%}
  {%- assign _ces_btn_treatment = btn_treatment | default: 'featured' -%}
  <div class="casa-edit__btn-wrap">
    <a href="{{ btn_url }}" class="btn btn-{{ _ces_btn_treatment }} casa-edit__btn casa-edit__btn--{{ btn_style }}">
      {{ btn_text | escape }}
      <span class="arrow" aria-hidden="true">&rarr;</span>
    </a>
  </div>
{%- endif -%}
