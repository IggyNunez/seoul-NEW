{%- comment -%}
  Casa PDP Day/Night Showcase
  Split section showing product in day mode (mirror) and night mode (portal/LED)

  Source-of-truth resolution (in order):
    1. Product metafield (custom.day_title / day_subtitle / night_title / night_subtitle)
    2. Block setting (per-template fallback)
    3. Blank → text element is skipped, only image renders

  Pre-2026-05-17 defaulted to "Mirror by Day / Portal by Night" — bled onto
  non-mirror products. Defaults removed; metafield read added.
{%- endcomment -%}

{%- liquid
  assign p = product | default: closest.product
  assign day_title    = p.metafields.custom.day_title    | default: block.settings.day_title
  assign day_subtitle = p.metafields.custom.day_subtitle | default: block.settings.day_subtitle
  assign night_title    = p.metafields.custom.night_title    | default: block.settings.night_title
  assign night_subtitle = p.metafields.custom.night_subtitle | default: block.settings.night_subtitle
-%}

<div class="casa-day-night">
  {%- comment -%} Day Side {%- endcomment -%}
  <div class="casa-day-night__panel casa-day-night__panel--day">
    <div class="casa-day-night__content">
      <div class="casa-day-night__image-wrapper casa-day-night__image-wrapper--day">
        {%- if block.settings.day_image != blank -%}
          <img
            src="{{ block.settings.day_image | image_url: width: 400 }}"
            alt="{{ day_title | default: '' | escape }}"
            class="casa-day-night__image"
            loading="lazy"
            width="200"
            height="200"
          >
        {%- else -%}
          <div class="casa-day-night__placeholder casa-day-night__placeholder--day"></div>
        {%- endif -%}
      </div>
      {%- if day_title != blank -%}<h3 class="casa-day-night__title">{{ day_title }}</h3>{%- endif -%}
      {%- if day_subtitle != blank -%}<p class="casa-day-night__subtitle">{{ day_subtitle }}</p>{%- endif -%}
    </div>
  </div>

  {%- comment -%} Night Side {%- endcomment -%}
  <div class="casa-day-night__panel casa-day-night__panel--night">
    <div class="casa-day-night__content">
      <div class="casa-day-night__image-wrapper casa-day-night__image-wrapper--night">
        {%- if block.settings.night_image != blank -%}
          <img
            src="{{ block.settings.night_image | image_url: width: 400 }}"
            alt="{{ night_title | default: '' | escape }}"
            class="casa-day-night__image"
            loading="lazy"
            width="200"
            height="200"
          >
        {%- else -%}
          <div class="casa-day-night__placeholder casa-day-night__placeholder--night"></div>
        {%- endif -%}
      </div>
      {%- if night_title != blank -%}<h3 class="casa-day-night__title">{{ night_title }}</h3>{%- endif -%}
      {%- if night_subtitle != blank -%}<p class="casa-day-night__subtitle">{{ night_subtitle }}</p>{%- endif -%}
    </div>
  </div>
</div>

<style>
.casa-day-night {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 400px;
}

.casa-day-night__panel {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60px 40px;
}

.casa-day-night__panel--day {
  background: var(--casa-border-on-paper);
}

.casa-day-night__panel--night {
  background: var(--casa-ink);
}

.casa-day-night__content {
  text-align: center;
  max-width: 300px;
}

.casa-day-night__image-wrapper {
  width: 160px;
  height: 160px;
  margin: 0 auto 24px;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.casa-day-night__image-wrapper--day {
  background: linear-gradient(145deg, #e6e6e6, #ffffff);
  box-shadow:
    8px 8px 16px rgba(0, 0, 0, 0.1),
    -8px -8px 16px rgba(255, 255, 255, 0.9);
}

.casa-day-night__image-wrapper--night {
  background: var(--casa-ink);
  box-shadow:
    0 0 60px rgba(176, 195, 250, 0.4),
    0 0 100px rgba(176, 195, 250, 0.2),
    inset 0 0 30px rgba(176, 195, 250, 0.3);
}

.casa-day-night__placeholder {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.casa-day-night__placeholder--day {
  background: linear-gradient(145deg, #d1d1d1, #e8e8e8);
}

.casa-day-night__placeholder--night {
  background: var(--casa-ink);
  box-shadow: inset 0 0 40px rgba(176, 195, 250, 0.5);
}

.casa-day-night__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.casa-day-night__title {
  font-size: 24px;
  font-weight: 600;
  margin: 0 0 8px 0;
  line-height: 1.2;
}

.casa-day-night__panel--day .casa-day-night__title {
  color: var(--casa-ink);
}

.casa-day-night__panel--night .casa-day-night__title {
  color: #ffffff;
}

.casa-day-night__subtitle {
  font-size: 14px;
  margin: 0;
  line-height: 1.5;
}

.casa-day-night__panel--day .casa-day-night__subtitle {
  color: rgba(0, 0, 0, 0.6);
}

.casa-day-night__panel--night .casa-day-night__subtitle {
  color: rgba(255, 255, 255, 0.6);
}

@media (max-width: 768px) {
  .casa-day-night {
    grid-template-columns: 1fr;
  }

  .casa-day-night__panel {
    padding: 48px 24px;
    min-height: 280px;
  }

  .casa-day-night__image-wrapper {
    width: 120px;
    height: 120px;
    margin-bottom: 20px;
  }

  .casa-day-night__title {
    font-size: 20px;
  }

  .casa-day-night__subtitle {
    font-size: 13px;
  }
}

@media (max-width: 480px) {
  .casa-day-night__panel {
    padding: 40px 20px;
    min-height: 240px;
  }

  .casa-day-night__image-wrapper {
    width: 100px;
    height: 100px;
  }

  .casa-day-night__title {
    font-size: 18px;
  }
}
</style>
