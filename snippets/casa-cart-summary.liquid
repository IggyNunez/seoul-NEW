{% doc %}
  Casa Cart Summary

  Premium order summary panel with glassmorphism styling.
  Maintains all JS integration points for morphing, discount, and checkout.

  @param {string} [section_id] - Section ID for discount component
{% enddoc %}

<div class="casa-cart-summary">
  {% if cart.attributes._casa_free_gift_choice contains 'price:' %}
    <p role="status">{{ 'content.free_gift_removed' | t }}</p>
  {% endif %}
  {%- comment -%} ═══ Section Tag ═══ {%- endcomment -%}
  <span class="casa-cart-summary__tag">ORDER SUMMARY</span>

  {%- comment -%} ═══ Subtotal & Discounts ═══ {%- endcomment -%}
  <div class="casa-cart-summary__totals">
    <div class="cart__original-total-container">
      {%- if cart.cart_level_discount_applications.size > 0 -%}
        <div class="casa-cart-summary__row">
          <span class="casa-cart-summary__label">Subtotal</span>
          <span class="casa-cart-summary__value">{{ cart.items_subtotal_price | money_with_currency }}</span>
        </div>
        <div class="casa-cart-summary__discounts">
          <ul class="discounts list-unstyled" role="list" aria-label="{{ 'content.discounts' | t }}">
            {%- for discount in cart.cart_level_discount_applications -%}
              <li class="casa-cart-summary__row casa-cart-summary__row--discount">
                <span class="casa-cart-summary__label casa-cart-summary__label--discount">
                  {{- 'icon-discount.svg' | inline_asset_content -}}
                  {{ discount.title | escape }}
                </span>
                <span class="casa-cart-summary__value casa-cart-summary__value--discount">
                  -{{ discount.total_allocated_amount | money_with_currency }}
                </span>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ═══ Cart Note & Discount Code ═══ {%- endcomment -%}
  {% if settings.show_cart_note or settings.show_add_discount_code %}
    <div class="casa-cart-summary__actions">
      {% if settings.show_cart_note %}
        <script type="module" src="{{ 'cart-note.js' | asset_url }}"></script>
        <cart-note style="display: flex;">
          <accordion-custom
            class="cart-note casa-cart-summary__accordion"
            {% if settings.cart_note_open_by_default %}
              open-by-default-on-desktop
              open-by-default-on-mobile
            {% endif %}
          >
            <details
              class="details"
              {% if settings.cart_note_open_by_default %}open{% endif %}
            >
              <summary class="casa-cart-summary__accordion-trigger">
                <span class="casa-cart-summary__accordion-label">
                  {%- render 'casa-icon', icon: 'message-circle', size: 14 -%}
                  Add a note
                </span>
                <span class="casa-cart-summary__accordion-icon">
                  {%- render 'casa-icon', icon: 'plus', size: 14 -%}
                </span>
              </summary>
              <div class="details-content casa-cart-summary__accordion-content">
                <label for="cart-note" class="visually-hidden">{{ 'content.seller_note' | t }}</label>
                <textarea
                  form="cart-form"
                  on:input="/updateCartNote"
                  id="cart-note"
                  class="casa-cart-summary__textarea"
                  name="note"
                  placeholder="Add special instructions..."
                >{{ cart.note }}</textarea>
              </div>
            </details>
          </accordion-custom>
        </cart-note>
      {% endif %}

      {% if settings.show_cart_note and settings.show_add_discount_code %}
        <div class="casa-cart-summary__divider"></div>
      {% endif %}

      {% if settings.show_add_discount_code %}
        {%- liquid
          assign discount_codes = cart.cart_level_discount_applications | where: 'type', 'discount_code' | map: 'title'
          for item in cart.items
            for allocation in item.line_level_discount_allocations
              if allocation.discount_application.type == 'discount_code'
                assign discount_codes = item.line_level_discount_allocations | slice: forloop.index0 | map: 'discount_application' | map: 'title' | concat: discount_codes
              endif
            endfor
          endfor
          assign discount_codes = discount_codes | uniq
          if discount_codes.size == 0
            assign disclosure_expanded = false
          else
            assign disclosure_expanded = true
          endif
        -%}

        <accordion-custom class="cart-discount casa-cart-summary__accordion">
          <details class="details" {% if disclosure_expanded %}open{% endif %}>
            <summary class="casa-cart-summary__accordion-trigger">
              <span class="casa-cart-summary__accordion-label">
                {%- render 'casa-icon', icon: 'tag', size: 14 -%}
                Discount code
              </span>
              <span class="casa-cart-summary__accordion-icon">
                {%- render 'casa-icon', icon: 'plus', size: 14 -%}
              </span>
            </summary>
            <div class="details-content">
              <div id="cart-discount-disclosure">
                <cart-discount-component
                  {% if section_id != blank %}data-section-id="{{ section_id }}"{% endif %}
                >
                  <div class="casa-cart-summary__discount-form-wrap">
                    <form on:submit="/applyDiscount" onsubmit="return false;" class="casa-cart-summary__discount-form">
                      <label for="cart-discount" class="visually-hidden">{{ 'accessibility.discount' | t }}</label>
                      <input
                        id="cart-discount"
                        class="casa-cart-summary__discount-input"
                        type="text"
                        name="discount"
                        size="8"
                        placeholder="{{ 'content.discount_code' | t }}"
                        required
                      >
                      <button type="submit" class="casa-cart-summary__discount-btn">
                        {{ 'actions.apply' | t }}
                      </button>
                    </form>
                  </div>
                  <div class="cart-discount__error hidden" role="alert" ref="cartDiscountError">
                    <span class="svg-wrapper">{{ 'icon-error.svg' | inline_asset_content }}</span>
                    <small class="cart-discount__error-text hidden" ref="cartDiscountErrorDiscountCode">
                      {{ 'content.discount_code_error' | t: code: 'test' }}
                    </small>
                    <small class="cart-discount__error-text hidden" ref="cartDiscountErrorShipping">
                      {{ 'content.shipping_discount_error' | t }}
                    </small>
                  </div>
                  <ul class="casa-cart-summary__discount-codes">
                    {% for discount_code in discount_codes %}
                      {%- comment -%}
                        The `cart-discount__pill` class is REQUIRED, not cosmetic: the stock
                        cart-discount.js queries `.cart-discount__pill` (as an <li> with
                        data-discount-code) in #existingDiscounts(), removeDiscount()'s
                        closest(), and the apply-response parse. Without it, removing a
                        discount is dead and applying a 2nd code drops the 1st. Keep both
                        classes: casa- for styling, cart-discount__pill for the JS contract.
                      {%- endcomment -%}
                      <li class="casa-cart-summary__discount-pill cart-discount__pill" data-discount-code="{{ discount_code }}" aria-label="{{ 'accessibility.discount_applied' | t: code: discount_code }}">
                        <p class="casa-cart-summary__discount-pill-code">{{ discount_code }}</p>
                        <button
                          type="button"
                          on:click="/removeDiscount"
                          class="casa-cart-summary__discount-pill-remove svg-wrapper svg-wrapper--smaller button-unstyled"
                          aria-label="{{ 'actions.remove_discount' | t: code: discount_code }}"
                        >
                          {{ 'icon-filters-close.svg' | inline_asset_content }}
                        </button>
                      </li>
                    {% endfor %}
                  </ul>
                </cart-discount-component>
              </div>
            </div>
          </details>
        </accordion-custom>
      {% endif %}
    </div>
  {% endif %}

  {%- comment -%} ═══ Divider ═══ {%- endcomment -%}
  <div class="casa-cart-summary__divider"></div>

  {%- comment -%} ═══ Subtotal ═══ {%- endcomment -%}
  {%- liquid
    if settings.currency_code_enabled_cart_total
      assign total_price = cart.total_price | money_with_currency
    else
      assign total_price = cart.total_price | money
    endif

    # Compare-at ("was") total — mirrors the per-line strikethrough in
    # casa-cart-items.liquid: each line's "was" is the higher of its
    # compare-at price or its original (pre-line-discount) price. Summed and
    # shown struck through only when it exceeds what the customer actually
    # pays (cart.total_price — after compare-at AND any code / automatic
    # discounts). Covers compare-at sales, discount codes, or both.
    assign was_total = 0
    for item in cart.items
      if item.variant.compare_at_price > item.original_price
        assign line_was = item.variant.compare_at_price | times: item.quantity
      else
        assign line_was = item.original_line_price
      endif
      assign was_total = was_total | plus: line_was
    endfor
    assign has_was_price = false
    if was_total > cart.total_price
      assign has_was_price = true
      if settings.currency_code_enabled_cart_total
        assign was_price = was_total | money_with_currency
      else
        assign was_price = was_total | money
      endif
    endif
  -%}

  <div class="casa-cart-summary__total-wrap{% if settings.show_installments %} casa-cart-summary__total-wrap--installments{% endif %}">
    {%- comment -%} Total block is a vertical stack at every width: the label,
        then the savings badge (right-aligned), then the price — so the badge
        always sits between the "Subtotal" line and the amount. {%- endcomment -%}
    <span class="casa-cart-summary__row casa-cart-summary__row--total" role="status">
      <span class="casa-cart-summary__label casa-cart-summary__label--total">{{ 'content.cart_subtotal' | t }}</span>
      {%- if settings.cart_show_savings and cart.total_discount > 0 -%}
        <div class="casa-cart-summary__savings">
          <span class="casa-cart-summary__savings-chip">
            {%- render 'casa-icon', icon: 'tag', size: 13 -%}
            <span class="casa-cart-summary__savings-amount">You saved {{ cart.total_discount | money_with_currency }}</span>
          </span>
        </div>
      {%- endif -%}
      <span class="casa-cart-summary__total-prices">
        {%- if has_was_price -%}<span class="visually-hidden">{{ 'content.price_sale' | t }}</span>{%- endif -%}
        <text-component
          ref="cartTotal"
          value="{{ total_price | strip_html }}"
          class="casa-cart-summary__value casa-cart-summary__value--total"
          data-cart-subtotal
        >
          {{ total_price }}
        </text-component>
        {%- if has_was_price -%}
          <span class="visually-hidden">{{ 'content.price_regular' | t }}</span>
          <s class="casa-cart-summary__value-compare">{{ was_price }}</s>
        {%- endif -%}
      </span>
    </span>

    {% if settings.show_installments %}
      <span class="casa-cart-summary__installments">
        {% form 'cart', cart %}
          {{ form | payment_terms }}
        {% endform %}
      </span>
    {% endif %}

    {%- unless settings.cart_hide_tax_shipping_note -%}
      <div class="casa-cart-summary__tax-note">
        {% render 'tax-info', has_discounts_enabled: settings.show_add_discount_code %}
      </div>
    {%- endunless -%}
  </div>

  {%- comment -%} Delivery estimate: removed. Only the app's per-product line-item
      "Estimated delivery" date is shown (per-line, on the cart row) — a generic
      today+N-days summary guess conflicted with it. {%- endcomment -%}

  {%- comment -%}
    ═══ Social Proof — aggregate review strip above the CTA ═══
    Only renders when BOTH the Judge.me shop-aggregate metafields
    are populated. No defaults — fabricated review counts are a
    locked-memory ban (feedback_dont_fabricate_facts.md). To enable,
    populate shop.metafields.judgeme.average_rating and
    shop.metafields.judgeme.review_count.
  {%- endcomment -%}
  {%- assign judgeme_avg = shop.metafields.judgeme.average_rating -%}
  {%- assign judgeme_count = shop.metafields.judgeme.review_count -%}
  {%- if judgeme_avg != blank and judgeme_count != blank -%}
    <div class="casa-cart-summary__social">
      <span class="casa-cart-summary__social-stars" aria-hidden="true">
        {%- for n in (1..5) -%}{%- render 'casa-icon', icon: 'star', size: 13 -%}{%- endfor -%}
      </span>
      <span class="casa-cart-summary__social-text">
        <strong>{{ judgeme_avg }}</strong> from <strong>{{ judgeme_count }}</strong> verified reviewers
      </span>
    </div>
  {%- endif -%}

  {%- comment -%} ═══ Checkout Button — uses brand .btn-primary ═══ {%- endcomment -%}
  <div class="casa-cart-summary__ctas">
    <button
      type="submit"
      id="checkout"
      class="btn btn-primary casa-cart-summary__checkout-btn"
      name="checkout"
      {% if cart == empty %}disabled{% endif %}
      form="cart-form"
    >
      <span class="casa-cart-summary__checkout-text">Checkout</span>
    </button>

    {% if additional_checkout_buttons and settings.show_accelerated_checkout_buttons %}
      <div class="additional-checkout-buttons casa-cart-summary__accelerated">
        {{ content_for_additional_checkout_buttons }}
      </div>
    {% endif %}
  </div>

  {%- comment -%}
    Trust messaging lives in the standalone casa-trust-bar section
    below the cart (templates/cart.json) — keeping the in-summary
    repeat would be the same 3 claims thrice within ~1200px of
    scroll. Removed per shopify-best-practices-reviewer 2026-05-15.
    Side cart drawer continues to render its own inline trust line
    where there's no room for a full section.
  {%- endcomment -%}

  {%- comment -%} ═══ Payment Icons ═══ {%- endcomment -%}
  {%- if settings.cart_show_payment_icons -%}
    <div class="casa-cart-summary__payment-icons">
      {%- for type in shop.enabled_payment_types -%}
        {{ type | payment_type_svg_tag: class: 'casa-cart-summary__payment-icon' }}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>


{% stylesheet %}
  /* Keep icon taps targeted at the native discount-removal button. */
  .casa-cart-summary__discount-pill-remove * {
    pointer-events: none;
  }

  .casa-cart-summary {
    position: sticky;
    top: 100px;
    background: var(--cart-summary-bg, var(--casa-border-on-paper));
    border: 1px solid var(--cart-border, rgba(0,0,0,0.06));
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .casa-cart-summary__tag {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cart-text-muted, #6b7280);
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--cart-border, rgba(0,0,0,0.06));
  }

  /* ── Totals ── */
  .casa-cart-summary__totals { margin-bottom: 0; }

  .casa-cart-summary__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
  }
  .casa-cart-summary__label {
    font-size: 14px;
    color: var(--cart-text-muted, #6b7280);
  }
  .casa-cart-summary__value {
    font-size: 14px;
    font-weight: 500;
    color: var(--cart-text, var(--casa-ink));
  }
  .casa-cart-summary__label--discount { display: flex; align-items: center; gap: 6px; color: var(--cart-accent-1, #B0C3FA); }
  .casa-cart-summary__value--discount { color: var(--cart-accent-1, #B0C3FA); }
  .casa-cart-summary__discounts { padding: 0; margin: 0; }
  .casa-cart-summary__discounts ul { padding: 0; margin: 0; list-style: none; }

  /* ── Accordion (note + discount) ── */
  .casa-cart-summary__actions {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 8px 0;
  }
  .casa-cart-summary__accordion { display: flex; width: 100%; }
  .casa-cart-summary__accordion details { width: 100%; border: none; }
  .casa-cart-summary__accordion-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 10px 0;
    cursor: pointer;
    list-style: none;
    font-size: 14px;
    color: var(--cart-text, var(--casa-ink));
  }
  .casa-cart-summary__accordion-trigger::-webkit-details-marker { display: none; }
  .casa-cart-summary__accordion-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
  }
  .casa-cart-summary__accordion-icon svg { transition: transform 0.2s; }
  details[open] .casa-cart-summary__accordion-icon svg { transform: rotate(45deg); }
  .casa-cart-summary__accordion-content { padding-bottom: 8px; }

  .casa-cart-summary__textarea {
    width: 100%;
    min-height: 72px;
    padding: 10px;
    border: 1px solid var(--cart-border, rgba(0,0,0,0.08));
    border-radius: 8px;
    font-size: 13px;
    resize: vertical;
    background: transparent;
    color: var(--cart-text, var(--casa-ink));
    font-family: inherit;
  }

  /* ── Discount form ── */
  .casa-cart-summary__discount-form-wrap { padding: 4px 0 8px; }
  .casa-cart-summary__discount-form {
    display: flex;
    gap: 8px;
  }
  .casa-cart-summary__discount-input {
    flex: 1;
    padding: 8px 12px;
    border: 1px solid var(--cart-border, rgba(0,0,0,0.08));
    border-radius: 8px;
    /* 16px on mobile to suppress iOS auto-zoom on focus
       (Mobile Pre-Flight #5). Desktop stays compact at 13px. */
    font-size: 16px;
    background: transparent;
    color: var(--cart-text, var(--casa-ink));
  }
  @media (min-width: 750px) {
    .casa-cart-summary__discount-input { font-size: 13px; }
  }
  .casa-cart-summary__discount-input:focus-visible {
    outline: 2px solid var(--cart-accent-1, #B0C3FA);
    outline-offset: 2px;
    border-color: transparent;
  }
  .casa-cart-summary__discount-btn {
    padding: 8px 16px;
    border: none;
    border-radius: 8px;
    background: var(--cart-text, var(--casa-ink));
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
  }
  .casa-cart-summary__discount-codes { list-style: none; padding: 0; margin: 4px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .casa-cart-summary__discount-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    /* Brand-token alpha — falls back to a neutral grey-on-paper
       so RGB / sale / cyan products in cart don't fight the pill. */
    background: color-mix(in srgb, var(--cart-accent-1, #B0C3FA) 8%, transparent);
    border-radius: 100px;
    font-size: 12px;
    color: var(--cart-accent-1, #B0C3FA);
  }
  /* The pill also carries the stock `cart-discount__pill` class (required for the
     JS contract: removeDiscount() / #existingDiscounts() selectors). That stock
     class ships global styling — uppercase + input-background — via cart-summary's
     stylesheet block. Re-assert Casa's styling at higher specificity so the merged
     cascade is deterministic instead of source-order dependent. */
  .casa-cart-summary__discount-pill.cart-discount__pill {
    text-transform: none;
    background: color-mix(in srgb, var(--cart-accent-1, #B0C3FA) 8%, transparent);
    border-radius: 100px;
    padding: 4px 10px;
  }

  .casa-cart-summary__discount-pill-code { margin: 0; font-weight: 600; }
  .casa-cart-summary__discount-pill-remove { color: inherit; cursor: pointer; }
  /* base.css disables .svg-wrapper pointers; this wrapper is a real button. */
  .casa-cart-summary__discount-pill-remove.svg-wrapper { pointer-events: auto; }

  /* ── Divider ── */
  .casa-cart-summary__divider {
    height: 1px;
    background: var(--cart-border, rgba(0,0,0,0.06));
    margin: 12px 0;
  }

  /* ── Total ── */
  .casa-cart-summary__total-wrap {
    display: flex;
    flex-direction: column;
    gap: 6px;
    /* 20px to the CHECKOUT button: a deliberate, even separation that reads as
       the "actions" zone without the sparse-void feel of the old 16px against
       the stacked total. */
    margin-bottom: 20px;
  }
  .casa-cart-summary__row--total {
    font-size: 16px;
    /* Vertical stack at EVERY width (not a narrow-only wrap): label on top,
       then the savings badge, then the price — so the badge always sits
       between the "Subtotal" line and the amount. Overrides the base
       .casa-cart-summary__row (row + space-between). 8px gap gives the three
       rows an even rhythm (was 6px, which read as cramped against the 20px
       to the button). */
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
  }
  .casa-cart-summary__label--total {
    font-size: 16px;
    font-weight: 600;
    color: var(--cart-text, var(--casa-ink));
  }
  .casa-cart-summary__value--total {
    font-size: 18px;
    font-weight: 700;
    color: var(--cart-text, var(--casa-ink));
    /* Keep the amount on one line — a long value in a wide currency (AFN/VND)
       wrapped to 2 lines at 280px beside the old, longer "Estimated Total". */
    white-space: nowrap;
  }
  /* Price group: current subtotal (bold) followed by the struck "was" price,
     mirroring the per-line now→was order in casa-cart-items. margin-inline-start
     keeps the group pinned right even when the whole group wraps below the
     "Subtotal" label in a wide currency; the inner flex-wrap lets the struck
     price drop under the current price rather than overflow. */
  .casa-cart-summary__total-prices {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: flex-end;
    gap: 2px 8px;
    min-width: 0;
    margin-inline-start: auto;
  }
  .casa-cart-summary__value-compare {
    font-size: 14px;
    font-weight: 500;
    /* Hard-coded, NOT var(--cart-compare-price-color): that token is fed by
       casa-cart.liquid's section-level compare_price_color, which resolves to
       #9CA3AF (templates/cart.json) = 2.54:1 on the white summary → WCAG AA
       fail. #6b7280 = 4.83:1 and matches the per-line compare in
       casa-cart-items.liquid:524 exactly (same decoupling, same reason). */
    color: #6b7280;
    text-decoration: line-through;
    white-space: nowrap;
  }
  /* Savings badge sits between the "Subtotal" label and the price (middle row
     of the stacked total), right-aligned so its right edge lines up with the
     amount below it. */
  .casa-cart-summary__savings {
    display: flex;
    justify-content: flex-end;
  }
  /* ── Savings chip — brand accent, same recipe as the line-item discount
     chips (10% tint toward white, 30% border, text 90% toward ink), all
     riding --cart-accent-1. The short-lived purple-applied/green-achieved
     split was overruled same-day (merchant 2026-08-25: "colors should be
     consistent") — ONE accent across cart chrome; --cart-savings-color is
     gone (its casa-cart setting was removed with it). No margin-top: the
     parent .casa-cart-summary__total-wrap already owns a 6px flex gap
     (avoids a stacked gap+margin pair). ── */
  .casa-cart-summary__savings-chip {
    display: inline-flex;
    /* Keep the tag icon + "You saved …" on ONE line. flex-wrap:wrap was
       dropping the icon onto its own line above the text at ≤~320px in wide
       currencies (AFN/VND). Pairs with white-space:nowrap on the amount so the
       figure never breaks either. max-width:100% still caps the pill to the
       summary width, so a realistic amount stays on one line without overflow. */
    flex-wrap: nowrap;
    align-items: center;
    gap: 2px 6px;
    width: max-content;
    max-width: 100%;
    padding: 5px 10px;
    border-radius: 8px;
    font-size: 12px;
    line-height: 1.2;
    background: color-mix(in srgb, var(--cart-accent-1, #B0C3FA) 10%, #fff);
    border: 1px solid color-mix(in srgb, var(--cart-accent-1, #B0C3FA) 30%, transparent);
    color: color-mix(in srgb, var(--cart-accent-1, #B0C3FA) 90%, #0a0a0f);
  }
  .casa-cart-summary__savings-amount { font-weight: 600; white-space: nowrap; }
  .casa-cart-summary__installments { font-size: 13px; color: var(--cart-text-muted, #6b7280); }
  .casa-cart-summary__tax-note { font-size: 12px; color: var(--cart-text-muted, #6b7280); line-height: 1.4; }

  /* ── Social proof strip — sits above the checkout CTA ── */
  .casa-cart-summary__social {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 0;
    margin-bottom: 6px;
    font-size: 13px;
    color: var(--cart-text, #0A0A0F);
  }
  .casa-cart-summary__social-stars {
    display: inline-flex;
    align-items: center;
    color: #F59E0B;
    gap: 1px;
  }
  .casa-cart-summary__social-text strong {
    font-weight: 600;
  }

  /* ── Checkout CTA — inherits .btn-primary brand styling.
        Local rules below only set width + behavior the brand button
        component intentionally leaves to the consumer. ── */
  .casa-cart-summary__ctas {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .casa-cart-summary__checkout-btn {
    width: 100%;
    justify-content: center;
  }
  .casa-cart-summary__checkout-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .casa-cart-summary__accelerated { margin-top: 4px; }

  /* ── Payment icons ── */
  .casa-cart-summary__payment-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: center;
    padding-top: 12px;
    margin-top: 12px;
    border-top: 1px solid var(--cart-border, rgba(0,0,0,0.06));
  }
  .casa-cart-summary__payment-icon {
    height: 24px;
    width: auto;
  }

  /* ── Responsive ── */
  @media (max-width: 999px) {
    .casa-cart-summary { position: static; }
  }
{% endstylesheet %}
