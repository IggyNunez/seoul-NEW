{%- comment -%}
  Casa PDP Buy Buttons
  Renders add to cart button, quantity selector, and dynamic checkout

  Parameters:
  - product: The product object
  - block: The block object with settings
  - section: The section object
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign show_quantity = block.settings.show_quantity | default: true
  assign show_dynamic_checkout = block.settings.show_dynamic_checkout | default: true
-%}

<product-form-component
  class="casa-pdp-buy-buttons"
  data-product-id="{{ product.id }}"
  data-section-id="{{ section.id }}"
>
  {%- form 'product', product, id: 'casa-product-form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
    <input type="hidden" name="id" value="{{ current_variant.id }}" ref="variantId">
    <div class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" ref="liveRegion"></div>

    <div class="casa-pdp-buy-buttons__row">
      {%- if show_quantity -%}
        <div class="casa-pdp-buy-buttons__quantity">
          <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
          <div class="casa-pdp-buy-buttons__quantity-wrapper">
            <button
              type="button"
              class="casa-pdp-buy-buttons__qty-btn"
              aria-label="Decrease quantity"
              data-qty-decrease
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
            </button>
            <input
              type="number"
              id="Quantity-{{ section.id }}"
              name="quantity"
              class="casa-pdp-buy-buttons__qty-input"
              value="{{ current_variant.quantity_rule.min | default: 1 }}"
              min="{{ current_variant.quantity_rule.min | default: 1 }}"
              {% if current_variant.quantity_rule.max %}max="{{ current_variant.quantity_rule.max }}"{% endif %}
              step="{{ current_variant.quantity_rule.increment | default: 1 }}"
              ref="quantityInput"
            >
            <button
              type="button"
              class="casa-pdp-buy-buttons__qty-btn"
              aria-label="Increase quantity"
              data-qty-increase
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
            </button>
          </div>
        </div>
      {%- endif -%}

      <button
        type="submit"
        name="add"
        class="casa-pdp-buy-buttons__add-to-cart"
        ref="addToCartButton"
        {% unless current_variant.available %}disabled{% endunless %}
      >
        <span class="casa-pdp-buy-buttons__btn-text">
          {%- if current_variant.available -%}
            {{ 'products.product.add_to_cart' | t }} — {{ current_variant.price | money_with_currency }}
          {%- elsif current_variant == blank -%}
            {{ 'products.product.unavailable' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </span>
        <span class="casa-pdp-buy-buttons__btn-loading">
          <svg class="casa-pdp-buy-buttons__spinner" width="20" height="20" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none" stroke-dasharray="31.42" stroke-dashoffset="10"/>
          </svg>
        </span>
        <span class="casa-pdp-buy-buttons__btn-added">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Added!
        </span>
      </button>
    </div>

    {%- if show_dynamic_checkout -%}
      <div class="casa-pdp-buy-buttons__dynamic">
        {{ form | payment_button }}
      </div>
    {%- endif -%}
  {%- endform -%}
</product-form-component>

<script>
  (function() {
    const form = document.querySelector('.casa-pdp-buy-buttons');
    if (!form) return;

    const quantityInput = form.querySelector('[ref="quantityInput"]');
    const decreaseBtn = form.querySelector('[data-qty-decrease]');
    const increaseBtn = form.querySelector('[data-qty-increase]');
    const addToCartBtn = form.querySelector('[ref="addToCartButton"]');

    // Quantity buttons
    if (quantityInput) {
      const min = parseInt(quantityInput.min) || 1;
      const max = parseInt(quantityInput.max) || 999;
      const step = parseInt(quantityInput.step) || 1;

      decreaseBtn?.addEventListener('click', () => {
        const current = parseInt(quantityInput.value) || min;
        const newVal = Math.max(min, current - step);
        quantityInput.value = newVal;
        quantityInput.dispatchEvent(new Event('change', { bubbles: true }));
      });

      increaseBtn?.addEventListener('click', () => {
        const current = parseInt(quantityInput.value) || min;
        const newVal = Math.min(max, current + step);
        quantityInput.value = newVal;
        quantityInput.dispatchEvent(new Event('change', { bubbles: true }));
      });

      // Dispatch quantity change event
      quantityInput.addEventListener('change', () => {
        document.dispatchEvent(new CustomEvent('quantity:changed', {
          detail: { quantity: parseInt(quantityInput.value) }
        }));
      });
    }

    // Add to cart animation
    const formElement = form.querySelector('form');
    formElement?.addEventListener('submit', (e) => {
      // The form will submit normally, but we add visual feedback
      addToCartBtn.classList.add('loading');

      // Listen for success (simplified - in production use cart events)
      setTimeout(() => {
        addToCartBtn.classList.remove('loading');
        addToCartBtn.classList.add('added');

        setTimeout(() => {
          addToCartBtn.classList.remove('added');
        }, 2000);
      }, 1000);
    });

  })();
</script>

<style>
/* ══════════════════════════════════════════════════════════════════════════
   CASA PDP BUY BUTTONS
   ══════════════════════════════════════════════════════════════════════════ */

.casa-pdp-buy-buttons {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.casa-pdp-buy-buttons__row {
  display: flex;
  gap: 12px;
}

/* ── Quantity ── */
.casa-pdp-buy-buttons__quantity {
  flex-shrink: 0;
}

.casa-pdp-buy-buttons__quantity-wrapper {
  display: flex;
  align-items: center;
  border: 1px solid rgba(0, 0, 0, 0.12);
  border-radius: 12px;
  overflow: hidden;
  height: 56px;
}

.casa-pdp-buy-buttons__qty-btn {
  width: 44px;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--casa-ink);
  transition: background 0.2s ease;
}

.casa-pdp-buy-buttons__qty-btn:hover {
  background: rgba(0, 0, 0, 0.04);
}

.casa-pdp-buy-buttons__qty-input {
  width: 48px;
  height: 100%;
  text-align: center;
  font-size: 16px;
  font-weight: 500;
  border: none;
  background: none;
  -moz-appearance: textfield;
}

.casa-pdp-buy-buttons__qty-input::-webkit-outer-spin-button,
.casa-pdp-buy-buttons__qty-input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

/* ── Add to Cart Button ── */
.casa-pdp-buy-buttons__add-to-cart {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;

  min-height: 56px;
  padding: 16px 32px;

  background: var(--casa-ink);
  color: #ffffff;
  border: none;
  border-radius: 9px;

  font-size: 16px;
  font-weight: 600;
  letter-spacing: -0.1px;
  cursor: pointer;

  transition: background 0.2s ease, transform 0.2s ease;
  /* Brand-book typography */
  text-transform: var(--button-text-case-primary, uppercase);
}

.casa-pdp-buy-buttons__add-to-cart:hover:not(:disabled) {
  background: var(--casa-border-on-ink);
}

.casa-pdp-buy-buttons__add-to-cart:active:not(:disabled) {
  transform: scale(0.98);
}

.casa-pdp-buy-buttons__add-to-cart:disabled {
  background: #e5e5e5;
  color: #999;
  cursor: not-allowed;
}

.casa-pdp-buy-buttons__btn-text {
  display: flex;
  align-items: center;
  gap: 10px;
}

.casa-pdp-buy-buttons__btn-icon {
  display: flex;
}

.casa-pdp-buy-buttons__btn-loading,
.casa-pdp-buy-buttons__btn-added {
  display: none;
  align-items: center;
  gap: 8px;
}

.casa-pdp-buy-buttons__spinner {
  animation: casa-spin 1s linear infinite;
}

@keyframes casa-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Loading state */
.casa-pdp-buy-buttons__add-to-cart.loading .casa-pdp-buy-buttons__btn-text {
  display: none;
}

.casa-pdp-buy-buttons__add-to-cart.loading .casa-pdp-buy-buttons__btn-loading {
  display: flex;
}

/* Added state */
.casa-pdp-buy-buttons__add-to-cart.added .casa-pdp-buy-buttons__btn-text {
  display: none;
}

.casa-pdp-buy-buttons__add-to-cart.added .casa-pdp-buy-buttons__btn-added {
  display: flex;
}

.casa-pdp-buy-buttons__add-to-cart.added {
  background: #16a34a;
}

/* ── Native Shopify Dynamic Checkout (Shop Pay + accelerated wallets) ── */
.casa-pdp-buy-buttons__dynamic {
  margin-top: 8px;
}

/* ── Responsive ── */
@media (max-width: 768px) {
  .casa-pdp-buy-buttons__add-to-cart {
    padding: 14px 24px;
    font-size: 15px;
  }

  .casa-pdp-buy-buttons__quantity-wrapper {
    height: 52px;
  }

  .casa-pdp-buy-buttons__qty-btn {
    width: 40px;
  }

  .casa-pdp-buy-buttons__qty-input {
    width: 44px;
    font-size: 15px;
  }
}

@media (max-width: 480px) {
  .casa-pdp-buy-buttons__row {
    flex-direction: row;
  }

  .casa-pdp-buy-buttons__quantity {
    display: none;
  }

  .casa-pdp-buy-buttons__add-to-cart {
    width: 100%;
    min-height: 42px;
    padding: 12px 20px;
    font-size: 15px;
    border-radius: 6px;
  }

}

@media (max-width: 375px) {
  .casa-pdp-buy-buttons__add-to-cart {
    min-height: 48px;
    padding: 12px 16px;
    font-size: 14px;
    gap: 8px;
  }

  .casa-pdp-buy-buttons__btn-icon svg {
    width: 18px;
    height: 18px;
  }

  .casa-pdp-buy-buttons__quantity-wrapper {
    height: 48px;
  }

  .casa-pdp-buy-buttons__qty-btn {
    width: 38px;
  }

  .casa-pdp-buy-buttons__qty-input {
    width: 40px;
    font-size: 14px;
  }

}
</style>
