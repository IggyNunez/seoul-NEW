{% doc %}
  Casa Cart Progress Bar

  Renders a free shipping progress bar with shimmer animation.
  Reads settings.free_shipping_threshold to determine the threshold.
  Hidden when threshold is 0 or not set.

  @param {number} cart_total - The cart total price in cents
{% enddoc %}

{%- liquid
  assign always_free = settings.cart_always_free_shipping
  assign threshold = settings.free_shipping_threshold | default: 0
  assign threshold_cents = threshold | times: 100
  assign cart_total_cents = cart.total_price
  assign remaining_cents = threshold_cents | minus: cart_total_cents
  assign is_complete = false

  if always_free
    assign is_complete = true
    assign progress_pct = 100
  elsif remaining_cents <= 0
    assign is_complete = true
    assign progress_pct = 100
  else
    assign progress_pct = cart_total_cents | times: 100 | divided_by: threshold_cents
    if progress_pct > 100
      assign progress_pct = 100
    endif
  endif

  assign show_bar = false
  if always_free
    assign show_bar = true
  elsif threshold > 0
    assign show_bar = true
  endif
-%}

{%- if show_bar -%}
  <div class="casa-cart-progress" aria-label="{{ 'content.free_shipping_progress' | t | default: 'Free shipping progress' }}">
    <div class="casa-cart-progress__text">
      {%- if is_complete -%}
        <span class="casa-cart-progress__icon casa-cart-progress__icon--complete">
          {%- render 'casa-icon', icon: 'check', size: 16 -%}
        </span>
        <span class="casa-cart-progress__message casa-cart-progress__message--complete">
          {%- if always_free -%}
            <strong>FREE shipping</strong> on all orders
          {%- else -%}
            You've unlocked <strong>FREE shipping!</strong>
          {%- endif -%}
        </span>
      {%- else -%}
        <span class="casa-cart-progress__icon">
          {%- render 'casa-icon', icon: 'truck', size: 16 -%}
        </span>
        <span class="casa-cart-progress__message">
          You're <strong>{{ remaining_cents | money_with_currency }}</strong> away from <strong>FREE shipping!</strong>
        </span>
      {%- endif -%}
    </div>
    <div class="casa-cart-progress__track">
      <div
        class="casa-cart-progress__fill{% if is_complete %} casa-cart-progress__fill--complete{% endif %}"
        style="width: {{ progress_pct }}%;"
        role="progressbar"
        aria-valuenow="{{ progress_pct }}"
        aria-valuemin="0"
        aria-valuemax="100"
      ></div>
    </div>
  </div>
{%- endif -%}


{% stylesheet %}
  /* Free-shipping progress bar.
     Class names match casa-cart-progress__* in the markup above —
     the CSS used to target a stale .casa-shipping-bar__* root, which
     meant the bar rendered unstyled even when shown. */
  .casa-cart-progress {
    padding: 14px 16px;
    background: var(--cart-bg-secondary, #FFFFFF);
    border: 1px solid var(--cart-border, rgba(0,0,0,0.06));
    border-radius: 10px;
    margin-bottom: 20px;
  }

  .casa-cart-progress__text {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--cart-text, var(--casa-ink, #0A0A0F));
    margin-bottom: 10px;
  }
  .casa-cart-progress__text strong {
    font-weight: 600;
    color: var(--cart-text, var(--casa-ink, #0A0A0F));
  }
  .casa-cart-progress__icon {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    color: var(--cart-text, var(--casa-ink, #0A0A0F));
  }
  .casa-cart-progress__icon--complete {
    /* Brand accent, not green (merchant 2026-08-25: "colors should be
       consistent" — one accent across cart chrome). Rides the same
       merchant-settable token as the discount rows/chips. 5.4:1 on the
       white card — above the 3:1 graphics minimum. */
    color: var(--cart-accent-1, #B0C3FA);
  }
  .casa-cart-progress__message {
    flex: 1;
  }
  .casa-cart-progress__message--complete {
    color: var(--cart-text, var(--casa-ink, #0A0A0F));
  }

  .casa-cart-progress__track {
    width: 100%;
    height: 6px;
    background: var(--cart-border, rgba(0,0,0,0.08));
    border-radius: 100px;
    overflow: hidden;
  }

  .casa-cart-progress__fill {
    height: 100%;
    border-radius: 100px;
    /* Brand 3-stop gradient — matches drawer's signature; the
       static 4px → 6px track height + gradient fill makes the
       "almost there" moment unmistakable. */
    background: linear-gradient(90deg, #B0C3FA, #5E0A02, #F2FFA0);
    transition: width 0.6s ease;
  }

  /* Complete state keeps the SAME brand gradient as the filling state —
     the old flat-green swap at 100% broke the one-accent rule (merchant
     2026-08-25) and made the goal moment change color language mid-bar.
     No override needed; the base .casa-cart-progress__fill gradient
     simply persists at width: 100%. */

  @media (prefers-reduced-motion: reduce) {
    .casa-cart-progress__fill { transition: none; }
  }
{% endstylesheet %}
