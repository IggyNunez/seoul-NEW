{%- doc -%}
  Casa Variant Picker · Icon Library

  Centralized icon glyphs used by the smart-selector variant picker
  (Type E icon pills, mood gradients, install spec, etc.).

  Icons are versioned in code (not merchant-editable) because they're
  design-system primitives — same status as logo SVGs, illustration
  glyphs, or component icons. The merchant editable thing is which
  icon to USE for which variant value (set via the JSON metafield
  custom.variant_picker_config).

  USAGE
    {% render 'casa-variant-icons', name: 'plug', size: 15 %}

  PARAMS
    name (string) — icon handle (one of the case values below)
    size (number, default 15) — pixel width + height

  ADDING A NEW ICON
    1. Add a new {%- when 'new-handle' -%} case below with the SVG path
       content (inner only — no outer <svg> wrapper)
    2. Use viewBox="0 0 24 24" coordinate space for consistency
    3. stroke="currentColor" stroke-width="1.8" keeps the icon
       theme-color-aware and visually consistent with the others

  FALLBACK
    Unknown icon names render a small ink-colored dot — visible
    placeholder so missing icons surface during QA instead of
    silently rendering an empty span.
{%- enddoc -%}

{%- liquid
  assign _icon_size = size | default: 15
  assign _icon_name = name | default: ''
-%}

<svg
  width="{{ _icon_size }}"
  height="{{ _icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case _icon_name -%}
    {%- comment -%} ── Install / power / wire ── {%- endcomment -%}
    {%- when 'plug' -%}
      <path d="M9 6V4M15 6V4"/><rect x="6" y="6" width="12" height="14" rx="2"/><path d="M9 12h6"/>
    {%- when 'cable' -%}
      <path d="M3 20c2-1 2-3 4-3s2 3 4 3 2-3 4-3 2 3 4 3"/><path d="M19 17V8a3 3 0 0 0-3-3"/>
    {%- when 'battery' -%}
      <rect x="2" y="7" width="18" height="10" rx="1.5"/><path d="M22 11 L22 13"/>
    {%- when 'mount' -%}
      <rect x="4" y="4" width="16" height="16" rx="1"/><path d="M9 9h6v6H9z"/>

    {%- comment -%} ── Connectivity ── {%- endcomment -%}
    {%- when 'wifi' -%}
      <path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" x2="12.01" y1="20" y2="20"/>
    {%- when 'bluetooth' -%}
      <polyline points="6.5 6.5 17.5 17.5 12 23 12 1 17.5 6.5 6.5 17.5"/>
    {%- when 'remote' -%}
      <rect x="2" y="7" width="20" height="15" rx="2"/><polyline points="17 2 12 7 7 2"/>

    {%- comment -%} ── Light / temperature ── {%- endcomment -%}
    {%- when 'sun' -%}
      <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
    {%- when 'moon' -%}
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    {%- when 'flame' -%}
      <path d="M12 3 C 14 7, 18 9, 18 14 a6 6 0 0 1 -12 0 c 0 -3 2 -5 3 -7 c 1 2 2 3 3 4 c 0 -3 0 -5 0 -8 Z"/>

    {%- comment -%} ── Dimensions / metric ── {%- endcomment -%}
    {%- when 'ruler' -%}
      <rect x="2" y="9" width="20" height="6" rx="1"/><path d="M6 9v3M10 9v3M14 9v3M18 9v3"/>
    {%- when 'cube' -%}
      {%- comment -%} Isometric cube wireframe — hexagon silhouette + Y inside marking the three visible faces. Used by the size-icon selector for Infinity Cube and similar geometric sized products. {%- endcomment -%}
      <path d="M 12 3 L 21 8 L 21 17 L 12 22 L 3 17 L 3 8 Z"/><path d="M 3 8 L 12 12 L 21 8"/><path d="M 12 12 L 12 22"/>
    {%- when 'pyramid' -%}
      {%- comment -%} Isometric square-pyramid wireframe — front-facing triangular silhouette with depth lines to the back apex/edge. Used by the size-icon selector for Infinity Pyramid. {%- endcomment -%}
      <path d="M 12 3 L 4 19 L 20 19 Z"/><path d="M 12 3 L 12 21"/><path d="M 4 19 L 12 21"/><path d="M 20 19 L 12 21"/>

    {%- comment -%} ── Generic markers ── {%- endcomment -%}
    {%- when 'check' -%}
      <polyline points="20 6 9 17 4 12"/>
    {%- when 'star' -%}
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>

    {%- comment -%} ── Fallback ── visible placeholder so missing icons surface during QA ── {%- endcomment -%}
    {%- else -%}
      <circle cx="12" cy="12" r="3" fill="currentColor" stroke="none"/>
  {%- endcase -%}
</svg>
