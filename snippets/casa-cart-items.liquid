{% doc %}
  Casa Cart Items

  Premium cart item cards with glassmorphism styling.
  Maintains all JS integration points (refs, event bindings, data attributes)
  for compatibility with cart-items-component.

  @param {boolean} [force_empty] - Force render empty cart state
{% enddoc %}

<script src="{{ 'component-cart-items.js' | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'component-cart-quantity-selector.js' | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'volume-pricing-info.js' | asset_url }}" type="module" fetchpriority="low"></script>

<div
  class="casa-cart-items__wrapper"
  {% if settings.product_title_case == 'uppercase' %}
    style="--product-title-case: uppercase;"
  {% endif %}
>
  {% if cart.empty? or force_empty %}
    {%- render 'casa-cart-empty' -%}
  {%- else -%}
    <span class="visually-hidden" ref="cartItemCount" aria-hidden="true">
      {{- cart.item_count -}}
    </span>
    <form action="{{ routes.cart_url }}" class="cart-form" id="cart-form" method="post">
      <div class="casa-cart-items" style="--cart-items-gap: 24px;">
        <table class="casa-cart-items__table" role="table">
          <caption class="visually-hidden" role="caption">
            {{ 'content.cart_total' | t }}
            <span>{{ cart.total_price | money_with_currency }}</span>
          </caption>
          <thead class="visually-hidden" role="rowgroup">
            <tr role="row">
              <th id="casaProductImage" scope="col" role="columnheader">{{ 'content.product_image' | t }}</th>
              <th id="casaProductInfo" scope="col" role="columnheader">{{ 'content.product_information' | t }}</th>
              <th id="casaQuantity" scope="col" role="columnheader">{{ 'content.quantity' | t }}</th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            {%- comment -%} free-gift (casa-free-gift.js): same guard as the drawer — see cart-products.liquid.
                Cart architecture rule: drawer and /cart are separate renderers, edit BOTH. {%- endcomment -%}
            {%- assign casa_fg_cart_has_qualifying = false -%}
            {%- for casa_fg_scan in cart.items -%}
              {%- if casa_fg_scan.variant.metafields.custom.free_gift_enabled.value -%}
                {%- assign casa_fg_cart_has_qualifying = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {% for item in cart.items %}
              {%- liquid
                assign border_opacity = settings.cart_thumbnail_border_opacity | divided_by: 100.0
                assign border_override = '--border-width: VAL1px; --border-style: VAL2; --border-color: rgb(var(--color-border-rgb) / VAL3); --border-radius: VAL4px;' | replace: 'VAL1', settings.cart_thumbnail_border_width | replace: 'VAL2', settings.cart_thumbnail_border | replace: 'VAL3', border_opacity | replace: 'VAL4', settings.cart_thumbnail_border_radius
                if settings.cart_thumbnail_border_radius > 0
                  assign border_override = border_override | append: ' overflow: hidden;'
                endif

              -%}
              {%- comment -%}
                RC-3: stable `id` per line so morph.js keys rows by getNodeKey (element.id)
                instead of positionally (prevents cross-product content-swaps + stripped
                data-removing during a morph). Prefixed `casa-line-` vs `line-` on the drawer
                snippet: the header drawer and this main cart render in the SAME document on
                /cart, so distinct prefixes avoid duplicate ids.
              {%- endcomment -%}
              {%- liquid
                # free-gift line detection + qualifying config for casa-free-gift.js
                assign casa_fg_gift_line = false
                for casa_fg_prop in item.properties
                  if casa_fg_prop.first == '_free_gift'
                    assign casa_fg_gift_line = true
                  endif
                endfor
                assign casa_fg_ref = item.variant.metafields.custom.free_gift_variant.value
                assign casa_fg_locked = false
                if casa_fg_gift_line and item.final_price == 0
                  assign casa_fg_locked = true
                endif
              -%}
              <tr
                id="casa-line-{{ item.key }}"
                role="row"
                class="casa-cart-items__card cart-items__table-row{% if item.parent_relationship.parent != null %} cart-items__nested-line{% endif %}"
                ref="cartItemRows[]"
                data-parent-key="{{ item.parent_relationship.parent.key }}"
                data-key="{{ item.key }}"
                data-product-id="{{ item.product.id }}"
                data-variant-id="{{ item.variant.id }}"
                data-line-item-key="{{ item.key }}"
                {% if casa_fg_gift_line %}data-casa-fg-gift="1"{% endif %}
                {% if item.variant.metafields.custom.free_gift_enabled.value and casa_fg_ref %}data-casa-fg-qualifying="{{ casa_fg_ref.id }}" data-casa-fg-available="{{ casa_fg_ref.available }}"{% endif %}
                {% if casa_fg_gift_line and casa_fg_cart_has_qualifying == false %}hidden style="display: none;"{% else %}style="animation-delay: {{ forloop.index0 | times: 100 }}ms;"{% endif %}
              >
                {%- comment -%} Product Image {%- endcomment -%}
                <td class="casa-cart-items__media" role="cell" headers="casaProductImage">
                  {% if item.image -%}
                    <a href="{{ item.url }}" class="casa-cart-items__media-link" style="--ratio: 1;">
                      {%- comment -%}
                        `sizes` is load-bearing. The srcset uses w-descriptors; without
                        `sizes` the browser assumes the slot is 100vw, which density-corrects
                        the image's INTRINSIC size up to the viewport width (naturalWidth
                        reports ~1500 in a 1500px window). Safari 26 then fails to resolve
                        the img's percentage height against the aspect-ratio link box, falls
                        back to that inflated intrinsic height, and lays the img out
                        ~viewport-tall inside the 100px clip — the visible 100x100 window is
                        the top-centre of the photo, a featureless wall that reads as a solid
                        plum block. Verified by A/B/A bisection in Playwright WebKit 26.5
                        (same engine as Safari 26.5): adding `sizes` collapses the box from
                        100x1500 to 100x100. Chromium resolves the percentage height against
                        the link, so it never showed the bug. Keep `sizes` in sync with the
                        card grid columns below: 100px desktop, 80px at <=749px.

                        `alt` must be passed explicitly: piping through `image_url` hands
                        `image_tag` a plain string, so it can't derive alt from the image
                        object and emits alt="". This <a> wraps only the <img>, so that was a
                        link with no accessible name (WCAG 2.4.4 / 4.1.2, Level A). Do NOT
                        add `| escape` — image_tag already escapes attribute values, and
                        variant titles contain a literal `"`.
                      {%- endcomment -%}
                      {{ item.image | image_url: width: 300 | image_tag: class: 'casa-cart-items__image', alt: item.title, widths: '100, 200, 300', sizes: '(max-width: 749px) 80px, 100px', style: border_override }}
                    </a>
                  {%- endif %}
                </td>

                {%- comment -%} Product Details {%- endcomment -%}
                <td class="casa-cart-items__details" role="cell" headers="casaProductInfo">
                  <a href="{{ item.url }}" class="casa-cart-items__title">
                    {{- item.product.title -}}
                  </a>

                  {%- if item.item_components.size != 0 -%}
                    <ul class="casa-cart-items__bundle list-unstyled">
                      {%- for component in item.item_components -%}
                        <li>
                          {{ component.title }}
                          {%- if component.quantity > 1 %} <span>&times; {{ component.quantity }}</span>{% endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}

                  {%- comment -%} Variant options (Onyx, Large, etc.) {%- endcomment -%}
                  {%- if item.product.has_only_default_variant == false and item.item_components.size == 0 -%}
                    <dl class="casa-cart-items__variants">
                      {%- for option in item.options_with_values -%}
                        <div class="casa-cart-items__variant">
                          <dt class="visually-hidden">{{ option.name }}:</dt>
                          <dd>{{ option.value }}{%- unless forloop.last %},&nbsp;{% endunless -%}</dd>
                        </div>
                      {%- endfor -%}
                    </dl>
                  {%- endif -%}

                  {%- comment -%} Line item properties (Estimated delivery, etc.) {%- endcomment -%}
                  {%- comment -%}
                    Gate on `!= empty`, NOT `.size > 0`: the properties drop returns no
                    usable number for `.size` on this theme, so `> 0` was permanently
                    false and the block never rendered (Prestige uses `!= empty` and DOES
                    render). The inner loop still filters underscore-prefixed + blank props.
                  {%- endcomment -%}
                  {%- comment -%} Only render the wrapper if a NON-EDD visible property exists — the sole
                      Estimated-delivery prop is excluded from the loop below (it renders as its own line),
                      so gating on `!= empty` alone would emit an empty box + its margin above the date. {%- endcomment -%}
                  {%- assign has_visible_prop = false -%}
                  {%- for property in item.properties -%}
                    {%- assign pfc = property.first | slice: 0 -%}
                    {%- if property.last != blank and pfc != '_' and property.first != 'Estimated delivery' -%}{%- assign has_visible_prop = true -%}{%- break -%}{%- endif -%}
                  {%- endfor -%}
                  {%- if has_visible_prop -%}
                    <div class="casa-cart-items__properties cart-items__meta">
                      {%- for property in item.properties -%}
                        {%- assign property_first_char = property.first | slice: 0 -%}
                        {%- comment -%} `Estimated delivery` renders as its own line below, so keep it out of this generic loop (shows once). {%- endcomment -%}
                        {%- if property.last != blank and property_first_char != '_' and property.first != 'Estimated delivery' -%}
                          {%- if property.first == 'Message' and item.product.gift_card? -%}
                            {%- comment -%}
                              Collapse the (up-to-200-char) gift-card note behind a "Message"
                              disclosure, collapsed by default, so it doesn't dominate the cart
                              row. Mirrors the drawer twin in cart-products.liquid. Keep the
                              <details> display:block — flex/grid on it breaks native collapse.
                            {%- endcomment -%}
                            <details class="casa-cart-items__message">
                              <summary class="casa-cart-items__message-summary">
                                <span>{{ property.first }}</span>
                                <span class="casa-cart-items__message-caret" aria-hidden="true">
                                  {{- 'icon-caret.svg' | inline_asset_content -}}
                                </span>
                              </summary>
                              <div class="casa-cart-items__message-text">{{ property.last }}</div>
                            </details>
                          {%- else -%}
                            {%- liquid
                              # Gift-card recipient "Send on" is an ISO date. Show it as a
                              # customer-facing delivery line ("Delivers: Jul 31, 2026") instead
                              # of the raw "Send on: 2026-07-31". Falls back to the raw value if it
                              # ever fails to parse. Mirrors the drawer twin in cart-products.liquid.
                              assign property_label = property.first
                              assign property_is_send_on = false
                              if property.first == 'Send on' and item.product.gift_card?
                                assign property_is_send_on = true
                                assign property_label = 'Delivers'
                                assign property_send_on = property.last | date: '%b %-d, %Y'
                                if property_send_on == blank
                                  assign property_send_on = property.last
                                endif
                              endif
                            -%}
                            <div class="casa-cart-items__property cart-items__property">
                              <dt>{{ property_label }}:</dt>
                              <dd>
                                {%- if property_is_send_on -%}
                                  {{ property_send_on }}
                                {%- elsif property.last contains '/uploads/' -%}
                                  <a href="{{ property.last }}">{{ property.last | split: '/' | last }}</a>
                                {%- else -%}
                                  {{ property.last }}
                                {%- endif -%}
                              </dd>
                            </div>
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  {%- if item.selling_plan_allocation -%}
                    <p class="casa-cart-items__selling-plan">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                  {%- endif -%}

                  {%- comment -%}
                    Estimated delivery, from the real `Estimated delivery` line-item property
                    (casa-edd.js normalises it to one value per variant on add, so the date
                    can't split the variant onto two lines). As a line-item property it also
                    reaches checkout and the order. Rendered here as its own line and excluded
                    from the properties loop above so it shows exactly once. Absent for a
                    variant first added via a bare section CTA (no app-computed date).

                    Gift cards are digital — no physical shipment — so suppress the estimate.
                  {%- endcomment -%}
                  {%- unless item.product.gift_card? -%}
                    {%- assign edd_value = item.properties['Estimated delivery'] -%}
                    {%- if edd_value != blank -%}
                      <div class="casa-cart-items__edd">Estimated delivery: {{ edd_value | escape }}</div>
                    {%- endif -%}
                  {%- endunless -%}

                  {%- comment -%} App injection hook for EDT and similar apps {%- endcomment -%}
                  <div class="casa-cart-items__app-block cart-items__app-block" data-cart-item-key="{{ item.key }}" data-product-id="{{ item.product.id }}" data-variant-id="{{ item.variant.id }}"></div>

                  {%- comment -%} Unit price {%- endcomment -%}
                  <div class="casa-cart-items__pricing">
                    {% if item.original_price != item.final_price %}
                      <span class="visually-hidden">{{ 'content.price_sale' | t }}</span>
                      {%- if casa_fg_locked -%}
                        <span class="casa-cart-items__price casa-cart-items__price--sale">FREE</span>
                      {%- else -%}
                        <span class="casa-cart-items__price casa-cart-items__price--sale">{{ item.final_price | money_with_currency }}</span>
                      {%- endif -%}
                      <span class="visually-hidden">{{ 'content.price_regular' | t }}</span>
                      <s class="casa-cart-items__price--compare">
                        {% if item.variant.compare_at_price > item.original_price %}
                          {{ item.variant.compare_at_price | money_with_currency }}
                        {% else %}
                          {{ item.original_price | money_with_currency }}
                        {% endif %}
                      </s>
                    {% else %}
                      {% if item.variant.compare_at_price > item.original_price %}
                        <span class="visually-hidden">{{ 'content.price_sale' | t }}</span>
                      {% else %}
                        <span class="visually-hidden">{{ 'content.price' | t }}</span>
                      {% endif %}
                      <span class="casa-cart-items__price">{{ item.original_price | money_with_currency }}</span>
                      {% if item.variant.compare_at_price > item.original_price %}
                        <span class="visually-hidden">{{ 'content.price_regular' | t }}</span>
                        <s class="casa-cart-items__price--compare">{{ item.variant.compare_at_price | money_with_currency }}</s>
                      {% endif %}
                    {% endif %}
                  </div>

                  {%- comment -%} Discount label pinned under the price. Gift rows: purpose-built
                      compact badge with fixed copy (see cart-products.liquid for the full
                      reasoning — the generic chip echoes the discount TITLE, which wraps). {%- endcomment -%}
                  {%- if casa_fg_locked -%}
                    <ul class="casa-cart-items__discounts list-unstyled" role="list">
                      <li class="casa-cart-items__discount-chip">
                        {%- render 'casa-icon', icon: 'tag', size: 13 -%}
                        <span>Free gift</span>
                      </li>
                    </ul>
                  {%- elsif item.line_level_discount_allocations.size > 0 -%}
                    <ul class="casa-cart-items__discounts list-unstyled" role="list">
                      {%- for discount in item.line_level_discount_allocations -%}
                        {%- comment -%} amount > 0: BXGY puts a $0 allocation on the BUY line —
                            no chip there (same gate as cart-products.liquid). {%- endcomment -%}
                        {%- if discount.discount_application.title != blank and discount.amount > 0 -%}
                          <li class="casa-cart-items__discount-chip">
                            {%- render 'casa-icon', icon: 'tag', size: 13 -%}
                            <span class="casa-cart-items__discount-code">{{ discount.discount_application.title | escape }}</span>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}

                  {%- comment -%} Low Stock Warning {%- endcomment -%}
                  {%- if settings.cart_show_low_stock -%}
                    {%- liquid
                      assign low_stock_threshold = settings.cart_low_stock_threshold | default: 5
                      assign variant_inventory = item.variant.inventory_quantity
                      assign show_warning = false
                      if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny'
                        if variant_inventory > 0 and variant_inventory <= low_stock_threshold
                          assign show_warning = true
                        endif
                      endif
                    -%}
                    {%- if show_warning -%}
                      <div class="casa-cart-items__low-stock">
                        {%- render 'casa-icon', icon: 'flame', size: 12 -%}
                        <span>Only {{ variant_inventory }} left!</span>
                      </div>
                    {%- endif -%}
                  {%- endif -%}

                </td>

                {%- comment -%} Quantity & Remove {%- endcomment -%}
                <td class="casa-cart-items__quantity" role="cell" headers="casaQuantity">
                  {%- assign can_update_quantity = item.instructions.can_update_quantity | default: true, allow_false: true -%}
                  {%- if casa_fg_locked -%}{%- assign can_update_quantity = false -%}{%- endif -%}
                  <div class="casa-cart-items__quantity-controls">
                    {% render 'volume-pricing-info',
                      variant: item.variant,
                      unique_id: item.index,
                      quantity: item.quantity
                    %}
                    {%- comment -%} A $0 gift line gets NO stepper at all — can_update_quantity: false
                        only renders DISABLED buttons (quantity-selector.liquid), and a disabled
                        stepper on a fixed-qty free item is dead chrome. Qty is pinned to 1 by
                        casa-free-gift.js either way. {%- endcomment -%}
                    {% unless casa_fg_locked %}
                      {% render 'quantity-selector',
                        product: item.product,
                        variant: item.variant,
                        in_cart_quantity: item.quantity,
                        line_index: item.index,
                        line_item_key: item.key,
                        class: 'casa-cart-qty',
                        can_update_quantity: can_update_quantity
                      %}
                    {% endunless %}
                    <button
                      class="casa-cart-items__remove"
                      type="button"
                      aria-label="{{ 'accessibility.remove_item' | t: title: item.title | escape }}"
                      on:click="/onLineItemRemove"
                      {%- assign can_remove = item.instructions.can_remove | default: true, allow_false: true -%}
                      {% if can_remove == false %}hidden{% endif %}
                    >
                      {%- render 'casa-icon', icon: 'trash', size: 16 -%}
                      <span class="visually-hidden">{{ 'accessibility.remove' | t }}</span>
                    </button>
                  </div>
                </td>

                {%- comment -%} Error cell — RC-4: resolved live by class from the keyed row, not an index-named ref {%- endcomment -%}
                <td
                  class="casa-cart-items__error hidden"
                  role="cell"
                  headers="casaQuantity"
                >
                  <div class="cart-item__error" role="alert">
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    <small class="cart-item__error-text"></small>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </form>
  {%- endif -%}
</div>

{% stylesheet %}
  .casa-cart-items__wrapper { width: 100%; }

  .casa-cart-items {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .casa-cart-items__table { width: 100%; border-spacing: 0; }
  .casa-cart-items__table * { margin: 0; }

  /* ── Item card — clean, minimal.
     `minmax(0, 1fr)` on the middle column prevents long product
     titles from blowing past the viewport on mobile. ── */
  .casa-cart-items__card {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr);
    grid-template-areas:
      'media details'
      'media quantity'
      'media error';
    column-gap: 16px;
    row-gap: 4px;
    align-items: start;
    padding: 16px;
    background: var(--cart-bg-secondary, #f9fafb);
    border: 1px solid var(--cart-border, rgba(0,0,0,0.06));
    border-radius: 12px;
  }

  /* No decorative pseudo-elements */
  .casa-cart-items__card::before,
  .casa-cart-items__card::after { display: none; }

  .casa-cart-items__card.removing {
    overflow: hidden;
    animation: removeRow calc(var(--animation-speed, 0.25s) * 2) var(--animation-easing, ease) forwards;
    animation-delay: var(--animation-speed, 0.125s);
  }

  @keyframes removeRow {
    0% { height: var(--row-height); }
    100% { opacity: 0; height: 0; padding: 0; margin: 0; border-color: transparent; }
  }

  /* The JS already skips the .removing class under reduced-motion, but disable the
     animation in CSS too so it can never run for those users (WCAG 2.3.3). */
  @media (prefers-reduced-motion: reduce) {
    .casa-cart-items__card.removing { animation: none; }
  }

  /* ── Image ── */
  .casa-cart-items__media { grid-area: media; padding: 0; }

  .casa-cart-items__media-link {
    display: block;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
  }

  .casa-cart-items__media-link::before { display: none; }

  /* height:auto + aspect-ratio, NOT height:100% — Safari 26 treats the
     link's aspect-ratio-derived height as indefinite for % resolution and
     falls back to the image's intrinsic height (see the comment at the
     <img> markup above). The drawer's .cart-items__media-image already
     uses this pattern, which is why the drawer never broke. */
  .casa-cart-items__image {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 8px;
  }

  /* ── Details ── */
  .casa-cart-items__details {
    grid-area: details;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .casa-cart-items__title {
    font-size: var(--cart-title-size, 15px);
    font-weight: 500;
    color: var(--cart-text, var(--casa-ink));
    text-decoration: none;
    text-transform: var(--product-title-case, none);
    line-height: 1.3;
  }
  .casa-cart-items__title:hover { color: var(--cart-accent-1, #B0C3FA); }

  .casa-cart-items__variants { display: flex; flex-wrap: wrap; gap: 0; margin: 0; }
  .casa-cart-items__variant { display: inline; }
  .casa-cart-items__variant dt,
  .casa-cart-items__variant dd {
    display: inline;
    font-size: 13px;
    color: var(--cart-text-muted, #6b7280);
    margin: 0;
  }

  .casa-cart-items__properties { margin-top: 4px; }
  .casa-cart-items__property {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px 4px;
    margin-top: 4px;
    font-size: 12px;
    color: var(--cart-text-muted, #6b7280);
  }
  .casa-cart-items__property dt,
  .casa-cart-items__property dd { font-size: inherit; color: inherit; margin: 0; display: inline; }
  .casa-cart-items__property dt { font-weight: 500; flex-shrink: 0; overflow-wrap: anywhere; }
  .casa-cart-items__property dd { min-width: 0; overflow-wrap: anywhere; }

  /* Collapsible gift-card message — collapsed by default; keep <details> display:block
     (flex/grid on it breaks the native collapse). Mirrors the drawer twin. */
  .casa-cart-items__message { margin-top: 4px; font-size: 12px; color: var(--cart-text-muted, #6b7280); }
  .casa-cart-items__message-summary {
    display: flex;
    align-items: center;
    gap: 4px;
    width: fit-content;
    padding-block: 3px;
    cursor: pointer;
    list-style: none;
    font-weight: 500;
  }
  .casa-cart-items__message-summary::-webkit-details-marker { display: none; }
  .casa-cart-items__message-summary:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .casa-cart-items__message-caret { display: inline-flex; transition: transform var(--animation-speed, 0.2s) var(--animation-easing, ease); }
  .casa-cart-items__message-caret svg { width: 11px; height: 11px; }
  .casa-cart-items__message[open] .casa-cart-items__message-caret { transform: rotate(180deg); }
  .casa-cart-items__message-text { margin-top: 2px; overflow-wrap: anywhere; white-space: pre-line; }
  @media (prefers-reduced-motion: reduce) { .casa-cart-items__message-caret { transition: none; } }

  .casa-cart-items__selling-plan { font-size: 13px; color: #6b7280; }

  /* Estimated-delivery line (from the `Estimated delivery` line-item property, normalised by casa-edd.js) */
  .casa-cart-items__edd { font-size: 12px; color: var(--cart-text-muted, #6b7280); margin-top: 4px; }
  .casa-cart-items__bundle { padding: 0; margin: 4px 0 0 0; }
  .casa-cart-items__bundle li { font-size: 13px; color: #6b7280; }

  /* ── Discount label — a discount-name badge pinned directly under the price.
     Tint, border, and text all derive from --cart-accent-1 (the merchant's
     `accent_primary` setting, the same token as the summary's discount rows
     and applied-code pill) via color-mix, so one setting recolors the whole
     chip. flex-wrap + max-width:100% keep a long discount name inside the
     card at 280px instead of overflowing. ── */
  .casa-cart-items__discounts { padding: 0; margin: 8px 0 0; display: flex; flex-direction: column; gap: 6px; }
  .casa-cart-items__discounts .casa-cart-items__discount-chip { margin-top: 0; }
  .casa-cart-items__discount-chip {
    display: inline-flex;
    /* Merchant rule: a chip NEVER spans two lines — nowrap + ellipsis backstop
       (see cart-products.liquid). Rides --cart-accent-1 (the merchant-settable
       accent_primary) — the ONE cart accent, same token as the summary's
       discount rows, pill, savings chip, and progress ✓ (merchant
       2026-08-25: "colors should be consistent"; the old --cart-savings-color
       green and its setting were removed). Uppercase per merchant — chip
       voice is spec/tag caps ("FREE GIFT"). Text mixes 10% toward ink: bare
       #B0C3FA measured 4.45:1 on the drawer's warm card (same recipe both
       renderers); mixed = 5.2:1 at 12px/600. */
    flex-wrap: nowrap;
    white-space: nowrap;
    align-items: center;
    gap: 2px 6px;
    min-width: 0;
    max-width: 100%;
    margin-top: 8px;
    padding: 5px 10px;
    border-radius: 8px;
    font-size: 12px;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    background: color-mix(in srgb, var(--cart-accent-1, #B0C3FA) 10%, #fff);
    border: 1px solid color-mix(in srgb, var(--cart-accent-1, #B0C3FA) 30%, transparent);
    color: color-mix(in srgb, var(--cart-accent-1, #B0C3FA) 90%, #0a0a0a);
  }
  .casa-cart-items__discount-code { font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; }

  /* ── Pricing ── */
  .casa-cart-items__pricing {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }
  .casa-cart-items__price {
    font-size: 14px;
    color: var(--cart-price-color, var(--cart-text, var(--casa-ink)));
    font-weight: 500;
  }
  /* Discounted price uses the SAME ink as the regular price above — not a
     pink accent. The old #5E0A02 default failed WCAG AA (3.06:1 on Paper,
     needs 4.5:1) and silently overrode the merchant's own black
     sale_price_color / casa_sale_price_color settings (both #000000). Those
     never reached the cart because sections/casa-cart.liquid reads its
     section-level sale_price_color (schema default #5E0A02), not the global
     setting. The strikethrough compare-at + the discount chip already signal
     the markdown, so the price itself stays quiet-chrome ink. */
  .casa-cart-items__price--sale { color: var(--cart-price-color, var(--cart-text, var(--casa-ink))); }
  .casa-cart-items__price--compare {
    font-size: 13px;
    /* Decoupled from --cart-compare-price-color: fed by the section-level
       compare_price_color (light default), it rendered #9ca3af = 2.54:1 on the
       card, failing WCAG AA. #6b7280 = 4.83:1 and matches the merchant's own
       casa_compare_price_color. Same section-vs-global wiring gap as the sale
       price above — both belong in the casa-cart.liquid follow-up. */
    color: #6b7280;
    text-decoration: line-through;
  }

  .casa-cart-items__low-stock {
    display: flex; align-items: center; gap: 4px;
    font-size: 12px; color: #ef4444; margin-top: 4px;
  }

  /* ── Quantity controls ── */
  .casa-cart-items__quantity {
    grid-area: quantity;
    padding: 0;
  }
  .casa-cart-items__quantity-controls {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }

  .casa-cart-items__remove {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    /* Padding bumped from 6px → 12px to clear the 44×44 minimum
       tap target (Mobile Pre-Flight #4 / WCAG 2.5.8). */
    padding: 12px;
    min-width: 44px;
    min-height: 44px;
    border: none;
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    color: var(--cart-text-muted, #6b7280);
    transition: color 0.15s, background 0.15s;
    font-size: 12px;
    /* iOS: opt trash-spam out of double-tap-to-zoom so rapid taps each fire a click
       immediately. Mirrors the stepper buttons; the remedy for Test F. Real-iPhone
       verification still required — Playwright/desktop don't run the gesture layer. */
    touch-action: manipulation;
  }
  .casa-cart-items__remove:focus-visible {
    outline: 2px solid var(--cart-accent-1, #B0C3FA);
    outline-offset: 2px;
  }
  .casa-cart-items__remove:hover { color: #ef4444; background: rgba(239,68,68,0.06); }

  /* ── Compact stepper — match the drawer (~102px), not the base ~130px.
     base.css:3330 sizes the +/- buttons to var(--minimum-touch-target)
     (44px), giving a ~130px pill that reads oversized in a narrow card
     and is inconsistent with the drawer's compact stepper. Narrow the
     buttons to 32px WIDE while keeping the 44px HEIGHT (tap target still
     clears WCAG 2.5.8's 24px min), and trim the number cell to 36px →
     ~102px total. Scoped through .casa-cart-items__quantity so it beats
     base.css's (0,2,0) specificity. Mirrors the .cart-drawer stepper
     override in sections/casa-header.liquid. The digit stays 16px (iOS
     focus-zoom guard) — only the cell WIDTH changes, never the font. ── */
  .casa-cart-items__quantity .quantity-selector :is(.quantity-minus, .quantity-plus) {
    width: 32px;
    min-width: 32px;
    padding: 0;
  }
  .casa-cart-items__quantity .quantity-selector input[type='number'] {
    max-width: 36px;
    min-width: 32px;
  }

  .casa-cart-items__error { padding: 0; }
  .cart-item__error {
    display: flex; align-items: center; gap: 6px;
    padding: 8px 12px; border-radius: 8px;
    background: rgba(239,68,68,0.06); color: #ef4444;
    font-size: 13px;
  }

  /* Nested line items */
  .cart-items__nested-line {
    border: none;
    background: transparent;
    padding: 8px 16px 8px 32px;
    border-radius: 0;
  }

  /* ── Responsive ── */
  @media (max-width: 749px) {
    .casa-cart-items__card {
      grid-template-columns: 80px minmax(0, 1fr);
      grid-template-areas:
        'media details'
        'media quantity'
        'error error';
      column-gap: 12px;
      padding: 12px;
    }
    .casa-cart-items__title { font-size: 14px; }
  }

  /* ── Galaxy-Fold rescue (≤359px). Even with the compacted stepper
     above (~102px), the quantity row (stepper + 8px gap + 44px Remove
     ≈ 154px) still exceeds the ~132px quantity column at 280px (card
     248 − 24 padding − 80 image − 12 gap). With the default `nowrap`
     the trash icon spilled past the card and was clipped by the
     `.casa-cart` overflow:clip at the 280px viewport edge. Let the row
     wrap so Remove drops below the stepper, fully inside the card.
     `flex-wrap` is self-limiting: it wraps at 280px, but by 320px the
     compacted row already fits on one line, so nothing wraps ≥320px. ── */
  @media (max-width: 359px) {
    .casa-cart-items__quantity-controls {
      flex-wrap: wrap;
      row-gap: 4px;
    }
    .casa-cart-items__line-total { display: none; }
    .casa-cart-items__title { font-size: 14px; }
  }
{% endstylesheet %}
