{%- comment -%}
  Casa PDP Rating
  Displays product rating stars and review count

  Parameters:
  - product: The product object
  - block: The block object with settings
{%- endcomment -%}

{%- liquid
  assign sold_count = block.settings.sold_count | default: ''
  assign _r_review_count = product.metafields.reviews.rating_count | default: 0
  assign _r_variant = product.selected_or_first_available_variant
  assign _r_has_savings = false
  if _r_variant.compare_at_price > _r_variant.price
    assign _r_has_savings = true
    assign _r_savings = _r_variant.compare_at_price | minus: _r_variant.price
  endif
  assign _r_lift_chip = false
  if _r_review_count > 0 and _r_has_savings
    assign _r_lift_chip = true
  endif
-%}

<div class="casa-pdp-rating">
  {%- comment -%} link: true keeps Judge.me's role=button stars (scroll to
    the on-page reviews widget). Card surfaces omit it → presentational
    stars. See snippets/casa-judgeme-rating.liquid. {%- endcomment -%}
  {% render 'casa-judgeme-rating', product: product, link: true %}

  {%- comment -%}
    Lifted Save chip — server-rendered next to the stars when the
    product has reviews AND the current variant has savings. CSS
    keeps it hidden on desktop (chip stays inline with the price
    there); on mobile it replaces the in-price chip (which the
    `.cpm__price-row--reviewed` class hides in casa-price.liquid).
    Single source of truth at first paint, no JS shift required.
    Variant changes sync this chip's text via the casa-price block's
    variant:update handler — find [data-casa-lifted-save] from there.
  {%- endcomment -%}
  {%- if _r_lift_chip -%}
    <span class="casa-pdp-rating__save-sep" aria-hidden="true" data-casa-save-sep></span>
    <span class="cpm__price-save cpm__price-save--lifted" data-casa-lifted-save>Save {% render 'casa-money', amount: _r_savings %}</span>
  {%- endif -%}

  {%- if sold_count != blank -%}
    <span class="casa-pdp-rating__sold-pill">{{ sold_count }} sold</span>
  {%- endif -%}
</div>

<style>
.casa-pdp-rating {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

/* Hide Judge.me badge entirely when product has zero reviews so
   "No reviews" text never shows. Sold-count pill (if present)
   stays visible. */
.casa-pdp-rating .jdgm-widget:has(.jdgm-prev-badge[data-number-of-reviews="0"]) {
  display: none;
}

.casa-pdp-rating__stars {
  display: flex;
  gap: 1px;
}

.casa-pdp-rating__star {
  display: flex;
}

.casa-pdp-rating__star--filled {
  color: #fbbf24;
}

.casa-pdp-rating__count {
  font-size: 14px;
  color: #757575;
  text-decoration: none;
  transition: color 0.2s ease;
}

.casa-pdp-rating__count .casa-pdp-rating__count-num {
  text-decoration: underline;
}

.casa-pdp-rating__count:hover {
  color: var(--cpm-accent-1, #B0C3FA);
}

.casa-pdp-rating__sold-pill {
  display: inline-flex;
  align-items: center;
  padding: 3px 10px;
  background: var(--casa-border-on-paper);
  border-radius: 100px;
  font-size: 12px;
  font-weight: 500;
  color: #555;
}

/* Vertical divider between Judge.me stars and the lifted Save chip.
   1 × 14 px tick, aligned to the centerline of the rating-row. */
.casa-pdp-rating__save-sep {
  display: inline-block;
  width: 1px;
  height: 14px;
  background: rgba(0, 0, 0, 0.18);
  flex: 0 0 1px;
  align-self: center;
}

/* Lifted chip sizing — sits next to the Judge.me stars on mobile only.
   Base colors / radius / font-family come from .cpm__price-save in
   casa-price.liquid (loaded by the sibling Casa Price block on every
   PDP). Override font + padding for the smaller rating-row baseline. */
.cpm__price-save--lifted {
  font-size: 14px;
  font-weight: 600;
  padding: 3px 10px;
  line-height: 1.3;
}
@media (max-width: 480px) {
  .cpm__price-save--lifted {
    font-size: 13px;
    padding: 3px 9px;
  }
}
/* Desktop (≥769) — chip belongs inline with the price, not next to the
   rating. Hide the server-rendered lifted slot + its divider so the
   in-price chip in casa-price.liquid is the only visible one. */
@media (min-width: 769px) {
  .casa-pdp-rating__save-sep,
  .cpm__price-save--lifted {
    display: none !important;
  }
}

@media (max-width: 480px) {
  .casa-pdp-rating {
    gap: 6px;
  }

  .casa-pdp-rating__count {
    font-size: 12px;
  }

  .casa-pdp-rating__sold-pill {
    font-size: 11px;
    padding: 2px 8px;
  }
}

@media (max-width: 375px) {
  .casa-pdp-rating__star svg {
    width: 14px;
    height: 14px;
  }

  .casa-pdp-rating__count {
    font-size: 11px;
  }
}
</style>
