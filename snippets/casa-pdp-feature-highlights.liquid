{%- comment -%}
  Casa PDP Feature Highlights
  2×2 grid with purple checkmarks

  Source-of-truth resolution (in order):
    1. Product metafield (custom.feature_highlight_1..4) — preferred
    2. Block setting (per-template fallback)
    3. Blank → row is skipped

  No hardcoded copy. Pre-2026-05-17 this snippet defaulted to smart-mirror
  copy ("16+ Million RGB Colors", "Mirror by Day, Portal by Night", etc.)
  which bled onto every non-smart product that used the block (e.g. side
  tables, vases). Defaults removed; metafield read added.

  Parameters:
  - block: The block object with settings
  - product (optional): the product object — falls back to `closest.product`
{%- endcomment -%}

{%- liquid
  assign p = product | default: closest.product
  assign highlight_1 = p.metafields.custom.feature_highlight_1 | default: block.settings.highlight_1
  assign highlight_2 = p.metafields.custom.feature_highlight_2 | default: block.settings.highlight_2
  assign highlight_3 = p.metafields.custom.feature_highlight_3 | default: block.settings.highlight_3
  assign highlight_4 = p.metafields.custom.feature_highlight_4 | default: block.settings.highlight_4
-%}

<div class="casa-pdp-highlights">
  {%- if highlight_1 != blank -%}
    <div class="casa-pdp-highlights__item">
      <span class="casa-pdp-highlights__icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </span>
      <span class="casa-pdp-highlights__text">{{ highlight_1 }}</span>
    </div>
  {%- endif -%}

  {%- if highlight_2 != blank -%}
    <div class="casa-pdp-highlights__item">
      <span class="casa-pdp-highlights__icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </span>
      <span class="casa-pdp-highlights__text">{{ highlight_2 }}</span>
    </div>
  {%- endif -%}

  {%- if highlight_3 != blank -%}
    <div class="casa-pdp-highlights__item">
      <span class="casa-pdp-highlights__icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </span>
      <span class="casa-pdp-highlights__text">{{ highlight_3 }}</span>
    </div>
  {%- endif -%}

  {%- if highlight_4 != blank -%}
    <div class="casa-pdp-highlights__item">
      <span class="casa-pdp-highlights__icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </span>
      <span class="casa-pdp-highlights__text">{{ highlight_4 }}</span>
    </div>
  {%- endif -%}
</div>

<style>
.casa-pdp-highlights {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px 16px;
}

.casa-pdp-highlights__item {
  display: flex;
  align-items: center;
  gap: 10px;
}

.casa-pdp-highlights__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  border-radius: 10px;
  background: var(--grad-primary, linear-gradient(135deg, #B0C3FA, #5E0A02));
  color: #fff;
}

.casa-pdp-highlights__icon svg {
  width: 12px;
  height: 12px;
  stroke: #fff;
}

.casa-pdp-highlights__text {
  font-size: 14px;
  color: #757575;
  line-height: 1.5;
}

@media (max-width: 480px) {
  .casa-pdp-highlights {
    gap: 10px 12px;
  }

  .casa-pdp-highlights__text {
    font-size: 13px;
  }
}
</style>
