{%- comment -%}
  casa-sticky-cart.liquid

  Section-agnostic Apple-style sticky add-to-cart bar. Mounted globally
  from layout/theme.liquid for every product page (gated by
  `request.page_type == 'product' and settings.casa_enable_sticky_cart`).

  Works regardless of which product section is in use:
  - sections/casa-product-main.liquid (Casa custom PDP, Calini-only)
  - sections/product-information.liquid (Shopify stock, every other PDP)
  - any future per-archetype PDP section

  The JS observer (assets/casa-sticky-cart.js) walks a priority list of
  buy-button selectors and observes the FIRST match. If none match the
  bar stays hidden (early return, no errors).

  Parameters: none — pulls everything off the global `product` object.
  Settings (config/settings_schema.json):
  - casa_enable_sticky_cart (bool, default true)
  - casa_sticky_hide_when_cart_open (bool, default true)
  - casa_sticky_layout ('compact' | 'detailed', default 'compact')
{%- endcomment -%}

{%- if product == blank -%}{%- comment -%} guard: not on a PDP {%- endcomment -%}{%- else -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign initial_quantity = current_variant.quantity_rule.min | default: 1
  assign hide_when_cart_open = settings.casa_sticky_hide_when_cart_open | default: true
  assign layout = settings.casa_sticky_layout | default: 'compact'
  assign image_to_show = current_variant.featured_image | default: product.featured_image
-%}

<casa-sticky-cart
  class="casa-sticky-cart"
  data-stuck="false"
  data-cart-open="false"
  data-layout="{{ layout }}"
  data-variant-available="{{ current_variant.available }}"
  data-product-id="{{ product.id }}"
  data-current-variant-id="{{ current_variant.id }}"
  data-initial-quantity="{{ initial_quantity }}"
  data-hide-when-cart-open="{{ hide_when_cart_open }}"
  role="region"
  aria-label="{{ 'products.product.sticky_add_to_cart' | t }}"
>
  <div class="casa-sticky-cart__bar">
    {%- if image_to_show -%}
      <div class="casa-sticky-cart__image">
        {%- assign image_alt = image_to_show.alt | default: product.title | escape -%}
        {%- comment -%}
          sizes: the thumb is hidden below 600px and renders 56×56 at ≥600
          (assets/casa-sticky-cart.css). The width/height attrs match that
          slot (they were a stale 40×40 vs the CSS). Sizes-less srcset
          would default the slot to 100vw (over-fetch + Safari 26 intrinsic
          trap — see snippets/casa-cart-items.liquid).
        {%- endcomment -%}
        {{
          image_to_show
          | image_url: width: 80
          | image_tag:
            loading: 'lazy',
            decoding: 'async',
            alt: image_alt,
            class: 'casa-sticky-cart__image-img',
            ref: 'productImage',
            width: 56,
            height: 56,
            sizes: '56px'
        }}
      </div>
    {%- endif -%}

    <div class="casa-sticky-cart__lead">
      <h2 class="casa-sticky-cart__title">
        {{ product.title | escape }}
      </h2>
      <div class="casa-sticky-cart__meta">
        {%- unless product.has_only_default_variant -%}
          <span class="casa-sticky-cart__variant" ref="variantDisplay">
            {{- current_variant.title | escape -}}
          </span>
        {%- endunless -%}
        <span class="casa-sticky-cart__price" ref="priceDisplay">
          {{- current_variant.price | money -}}
        </span>
        {%- comment -%}
          Compare strikethrough renders hidden. casa-sticky-cart.js decides
          whether to reveal it: (1) Shopify.currency.active must be USD or
          CAD — wider currencies (JPY/KRW/IDR/VND) force the row to wrap;
          (2) showing it must not grow the bar height (long variant names
          + sale + button can wrap on small phones even in USD). Re-runs
          on variant change and resize.
        {%- endcomment -%}
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <s class="casa-sticky-cart__compare" ref="compareDisplay" data-has-compare="true" hidden>
            {{- current_variant.compare_at_price | money -}}
          </s>
        {%- else -%}
          <s class="casa-sticky-cart__compare" ref="compareDisplay" hidden></s>
        {%- endif -%}
      </div>
    </div>

    <button
      type="button"
      class="casa-sticky-cart__button btn btn-primary-on-dark"
      ref="addToCartButton"
      {% unless current_variant.available %}disabled{% endunless %}
    >
      <span class="casa-sticky-cart__button-text" ref="buttonText">
        {%- if current_variant.available -%}
          <span>{{ 'products.product.add_to_cart' | t }}</span>
        {%- elsif current_variant == blank -%}
          {{ 'products.product.unavailable' | t }}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </span>
      <span class="casa-sticky-cart__button-added" ref="addedState" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>{{ 'actions.added' | t }}</span>
      </span>
    </button>
  </div>
</casa-sticky-cart>

{%- endif -%}
