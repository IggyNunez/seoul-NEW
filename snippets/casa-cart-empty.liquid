{% doc %}
  Casa Cart Empty State

  Renders the empty-cart hero (eyebrow + italic-gradient H1 + CTA),
  followed by a 4-up carousel of best-sellers (so users who hit
  the page from the header icon and forgot a product are caught),
  followed by a quiet trust strip.
{% enddoc %}

<div class="casa-cart-empty">
  <div class="casa-cart-empty__content">
    <span class="casa-cart-empty__tag">YOUR CART</span>
    <h1 class="casa-cart-empty__title">Your <em>cart's</em> empty.</h1>
    <p class="casa-cart-empty__subtitle">
      Discover our collections and find your next skincare ritual.
    </p>
    <a
      class="casa-cart-empty__cta btn btn-primary"
      href="{{ settings.empty_cart_button_link | default: routes.all_products_collection_url }}"
    >
      START SHOPPING
    </a>

    {%- if shop.customer_accounts_enabled and customer == null -%}
      <p class="casa-cart-empty__login">
        {{ 'actions.log_in_html' | t: link: routes.account_login_url }}
      </p>
    {%- endif -%}
  </div>

  {%- comment -%} ── Best-sellers recs (capture the forgot-a-product visitor) ── {%- endcomment -%}
  {%- if settings.cart_upsell_collection != blank -%}
    {%- assign empty_recs = collections[settings.cart_upsell_collection] -%}
    {%- if empty_recs != blank and empty_recs.products.size > 0 -%}
      <div class="casa-cart-empty__recs">
        <div class="casa-cart-empty__recs-header">
          <span class="casa-cart-empty__recs-tag">START WITH</span>
          <h2 class="casa-cart-empty__recs-title">Loved by <em>everyone.</em></h2>
        </div>
        <div class="casa-cart-empty__recs-track">
          {%- assign rec_limit = 4 -%}
          {%- assign shown = 0 -%}
          {%- for product in empty_recs.products -%}
            {%- if shown >= rec_limit -%}{%- break -%}{%- endif -%}
            <div class="casa-cart-empty__recs-card">
              {%- render 'casa-product-card',
                product: product,
                index: shown,
                show_quick_add: true,
                show_variant_swatches: false,
                show_wishlist: false,
                show_stock_urgency: false,
                show_installment: false,
                show_quick_view: false,
                show_hover_video: false,
                card_variant: 'minimal'
              -%}
            </div>
            {%- assign shown = shown | plus: 1 -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} ── Quiet trust strip ── {%- endcomment -%}
  {%- if settings.cart_show_trust_badges -%}
    <p class="casa-cart-empty__trust">
      {%- assign tb1 = settings.cart_trust_badge_1 | default: 'Free shipping' -%}
      {%- assign tb2 = settings.cart_trust_badge_2 | default: '30-day returns' -%}
      {%- assign tb3 = settings.cart_trust_badge_3 | default: '2-year warranty' -%}
      {{ tb1 }} · {{ tb2 }} · {{ tb3 }}
    </p>
  {%- endif -%}
</div>


{% stylesheet %}
  .casa-cart-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 60px 20px 80px;
    gap: 64px;
  }

  .casa-cart-empty__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 540px;
  }

  .casa-cart-empty__tag {
    font-family: var(--font-body--family, 'Inter', system-ui, sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cart-text-muted, #525252);
  }

  .casa-cart-empty__title {
    font-family: var(--casa-pdp-h2-family, 'Inter', system-ui, sans-serif);
    font-size: var(--casa-pdp-h2-size, clamp(36px, 4.5vw, 56px));
    font-weight: var(--casa-pdp-h2-weight, 600);
    letter-spacing: var(--casa-pdp-h2-tracking, -0.02em);
    line-height: var(--casa-pdp-h2-line, 1.05);
    color: var(--cart-text, #0A0A0F);
    margin: 0;
    text-wrap: balance;
  }
  .casa-cart-empty__title em {
    font-style: italic;
    background: var(--grad-text, linear-gradient(90deg, #B0C3FA, #5E0A02, #F2FFA0));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .casa-cart-empty__subtitle {
    font-size: 15px;
    color: var(--cart-text-muted, #525252);
    margin: 4px 0 12px;
    line-height: 1.5;
  }

  /* CTA inherits .btn-primary brand styling — width hint only. */
  .casa-cart-empty__cta {
    min-width: 220px;
    justify-content: center;
  }

  .casa-cart-empty__login {
    font-size: 13px;
    color: var(--cart-text-muted, #525252);
    margin: 8px 0 0;
  }

  /* ── Recs row ── */
  .casa-cart-empty__recs {
    width: 100%;
    max-width: var(--page-width, 1200px);
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .casa-cart-empty__recs-header {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .casa-cart-empty__recs-tag {
    font-family: var(--font-body--family, 'Inter', system-ui, sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cart-text-muted, #525252);
  }

  .casa-cart-empty__recs-title {
    font-family: var(--casa-pdp-h2-family, 'Inter', system-ui, sans-serif);
    font-size: clamp(24px, 3vw, 32px);
    font-weight: var(--casa-pdp-h2-weight, 600);
    letter-spacing: var(--casa-pdp-h2-tracking, -0.02em);
    line-height: 1.15;
    color: var(--cart-text, #0A0A0F);
    margin: 0;
  }
  .casa-cart-empty__recs-title em {
    font-style: italic;
    background: var(--grad-text, linear-gradient(90deg, #B0C3FA, #5E0A02, #F2FFA0));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .casa-cart-empty__recs-track {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  @media (max-width: 999px) {
    .casa-cart-empty__recs-track {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ── Trust strip ── */
  .casa-cart-empty__trust {
    font-size: 12px;
    color: var(--cart-text-muted, #525252);
    margin: 0;
    letter-spacing: 0.02em;
  }
{% endstylesheet %}
