{%- comment -%}
  Breadcrumbs Snippet
  Simple breadcrumb navigation: Home > Collection > Product
{%- endcomment -%}

<nav class="casa-breadcrumbs" aria-label="Breadcrumb">
  <ol class="casa-breadcrumbs__list">
    <li class="casa-breadcrumbs__item">
      <a href="/" class="casa-breadcrumbs__link">Home</a>
    </li>
    {%- capture casa_bc_handle -%}{%- render 'casa-breadcrumb-collection' -%}{%- endcapture -%}
    {%- assign casa_bc_handle = casa_bc_handle | strip -%}
    {%- if casa_bc_handle != '' -%}
      {%- assign casa_bc_col = collections[casa_bc_handle] -%}
      {%- if casa_bc_col != blank and casa_bc_col.title != blank -%}
        <li class="casa-breadcrumbs__item">
          <span class="casa-breadcrumbs__separator" aria-hidden="true">/</span>
          <a href="{{ casa_bc_col.url }}" class="casa-breadcrumbs__link">{{ casa_bc_col.title }}</a>
        </li>
      {%- endif -%}
    {%- endif -%}
    <li class="casa-breadcrumbs__item casa-breadcrumbs__item--current" aria-current="page">
      <span class="casa-breadcrumbs__separator" aria-hidden="true">/</span>
      <span class="casa-breadcrumbs__current">{{ product.title }}</span>
    </li>
  </ol>
</nav>

<style>
.casa-breadcrumbs {
  overflow: hidden;
}
.casa-breadcrumbs__list {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: clamp(2px, 0.5vw, 4px);
  list-style: none;
  margin: 0;
  padding: 0;
  font-size: clamp(10px, 1vw + 6px, 14px);
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.casa-breadcrumbs__list::-webkit-scrollbar { display: none; }

.casa-breadcrumbs__item {
  display: flex;
  align-items: center;
  gap: clamp(2px, 0.5vw, 4px);
  white-space: nowrap;
  flex-shrink: 0;
}

.casa-breadcrumbs__item--current {
  flex-shrink: 1;
  min-width: 0;
}

.casa-breadcrumbs__separator {
  color: rgba(0, 0, 0, 0.3);
  flex-shrink: 0;
}

.casa-breadcrumbs__link {
  color: rgba(0, 0, 0, 0.5);
  text-decoration: none;
  transition: color 0.2s ease;
}

.casa-breadcrumbs__link:hover {
  color: var(--cpm-accent-1, #B0C3FA);
}

.casa-breadcrumbs__current {
  color: rgba(0, 0, 0, 0.7);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
</style>
