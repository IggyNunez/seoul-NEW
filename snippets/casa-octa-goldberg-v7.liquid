{% doc %}
  Goldberg's professional studio photograph paired with his mirror detail.
{% enddoc %}
<div id="casa-v7-goldberg" class="os-goldberg" data-build="20260915-goldberg-pair-1">
  <p class="os-eyebrow os-joe-label">{{ 'casa_octa_spaces.joe_label' | t }}</p>
  <div class="os-goldberg__grid">
    <figure class="os-goldberg__detail">
      <a class="os-photo os-goldberg__closeup" href="{{ 'octa-joe-detail-original-v7.jpg' | asset_url }}" data-os-photo aria-label="{{ 'casa_octa_spaces.joe_detail_enlarge' | t }}">
        <img src="{{ 'octa-joe-detail-original-v7.jpg' | asset_url }}" width="3024" height="4032" loading="lazy" decoding="async" alt="{{ 'casa_octa_spaces.joe_detail_alt' | t }}">
        <span aria-hidden="true">↗</span>
      </a>
      <figcaption>{{ 'casa_octa_spaces.geometry' | t }}</figcaption>
    </figure>
    <div class="os-goldberg__quote">
      <blockquote>{{ 'casa_octa_spaces.quote' | t }}</blockquote>
      <p class="os-goldberg__credit">{{ 'casa_octa_spaces.credit' | t }}</p>
      <p>{{ 'casa_octa_spaces.joe_body' | t }}</p>
      <a class="os-goldberg__wide" href="{{ 'octa-joe-arrangement-v1.jpg' | asset_url }}" data-os-photo data-os-alt="{{ 'casa_octa_spaces.joe_alt' | t | escape }}">{{ 'casa_octa_spaces.joe_view_studio' | t }} <span aria-hidden="true">↗</span></a>
    </div>
    <figure class="os-goldberg__lifestyle">
      <a class="os-photo" href="{{ 'octa-joe-professional-v7.jpg' | asset_url }}" data-os-photo aria-label="{{ 'casa_octa_spaces.joe_lifestyle_enlarge' | t }}">
        <img src="{{ 'octa-joe-professional-v7.jpg' | asset_url }}" width="854" height="1280" loading="lazy" decoding="async" alt="{{ 'casa_octa_spaces.joe_lifestyle_alt' | t }}">
        <span aria-hidden="true">↗</span>
      </a>
      <figcaption>{{ 'casa_octa_spaces.joe_studio_caption' | t }}</figcaption>
    </figure>
  </div>
</div>

{% stylesheet %}
  .os-goldberg { scroll-margin-top: 100px; }
  .os-goldberg__grid {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1fr);
    grid-template-areas: "lifestyle detail" "lifestyle quote";
    grid-template-rows: auto 1fr;
    gap: 24px 28px;
    max-width: 1120px;
    margin-inline: auto;
  }
  .os-goldberg figure { min-width: 0; margin: 0; }
  .os-goldberg__detail { grid-area: detail; }
  .os-goldberg__lifestyle { grid-area: lifestyle; }
  .os-goldberg__lifestyle .os-photo { aspect-ratio: 854 / 1280; }
  .os-goldberg__lifestyle img { object-fit: contain; }
  .os-goldberg .os-goldberg__closeup { aspect-ratio: 4 / 3; }
  .os-goldberg .os-goldberg__closeup img {
    position: absolute;
    width: 250%;
    max-width: none;
    height: auto;
    left: -72%;
    top: 0;
  }
  .os-goldberg__quote { grid-area: quote; min-width: 0; align-self: center; padding: 0 12px 8px; }
  .os .os-goldberg blockquote { font-size: clamp(26px, 2.8vw, 38px); line-height: 1.2; margin: 0 0 16px; }
  .os .os-goldberg__credit { font-size: 14px; }
  .os .os-goldberg__wide { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; margin-top: 4px; color: #7029a9; font-size: 15px; font-weight: 600; text-underline-offset: 4px; }
  @media (max-width: 700px) {
    .os-goldberg__grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: "detail" "quote" "lifestyle"; grid-template-rows: auto; gap: 22px; }
    .os-goldberg__quote { padding: 0; }
    .os .os-goldberg blockquote { font-size: 28px; }
  }
{% endstylesheet %}
