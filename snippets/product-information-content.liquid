{% doc %}
  Product Information Content

  Renders the product information layout with media gallery and product details.
  Used by both product-information and featured-product-information sections.

  @param {number} product_media_size - Number of media items in the product
  @param {string} section_id - Unique section ID
  @param {object} settings - Section settings object
  @param {string} media_gallery - Captured HTML for the product media gallery block
  @param {string} product_details - Captured HTML for the product details block
  @param {string} additional_blocks - Captured HTML for additional section blocks

  @example
  {% capture media_gallery %}
    {% content_for 'block', type: '_product-media-gallery', id: 'media-gallery', closest.product: product %}
  {% endcapture %}

  {% capture product_details %}
    {% content_for 'block', type: '_product-details', id: 'product-details', closest.product: product %}
  {% endcapture %}

  {% capture additional_blocks %}
    {% content_for 'blocks' %}
  {% endcapture %}

  {% render 'product-information-content',
    product_media_size: product.media.size,
    section_id: section.id,
    settings: section.settings,
    media_gallery: media_gallery,
    product_details: product_details,
    additional_blocks: additional_blocks
  %}
{% enddoc %}

{% liquid
  # Determine render order based on media position
  if settings.desktop_media_position == 'left'
    assign render_order = 'media,product-details'
  else
    assign render_order = 'product-details,media'
  endif

  # Check if product has media
  assign product_has_media = true
  if product_media_size == 0
    assign product_has_media = false
  endif

  # Build product grid class
  assign product_grid_class = 'product-information__grid'

  if product_has_media == false
    assign product_grid_class = product_grid_class | append: ' product-information--media-none'
  elsif settings.desktop_media_position == 'right'
    assign product_grid_class = product_grid_class | append: ' product-information--media-right'
  else
    assign product_grid_class = product_grid_class | append: ' product-information--media-left'
  endif

  if settings.equal_columns
    assign product_grid_class = product_grid_class | append: ' product-information__grid--half'

    if settings.limit_details_width
      assign product_grid_class = product_grid_class | append: ' product-information__grid--limit-details'
    endif
  endif

  # Determine content width
  case settings.content_width
    when 'content-center-aligned'
      assign content_width = 'page-width'
    when 'content-full-width'
      assign content_width = 'full-width'
  endcase
%}

<div class="section-background color-{{ settings.color_scheme }}"></div>
<div
  class="product-information section section--{{ content_width }} spacing-style color-{{ settings.color_scheme }} relative"
  style="{% render 'spacing-style', settings: settings %} --gap: {{ settings.gap }}px;"
  data-testid="product-information"
>
  {% if settings.desktop_media_position == 'left' and product_has_media and request.page_type == 'product' %}
    {% assign product_href = '#ProductInformation-' | append: section_id %}
    {% render 'skip-to-content-link', href: product_href, text: 'accessibility.skip_to_product_info' %}
  {% endif %}
  <div
    class="{{ product_grid_class }}"
    style="--media-width-pct: {{ settings.media_width_pct | default: 60 }}%;"
    data-product-grid-content
  >
    {% assign render_order_array = render_order | split: ',' %}
    {% capture media %}
      <div
        class="product-information__media"
        data-testid="product-information-media"
      >
        {{ media_gallery }}
      </div>
    {% endcapture %}

    {% for block in render_order_array %}
      {% if block == 'media' and product_has_media %}
        {{ media }}
      {% elsif block == 'product-details' %}
        {{ product_details }}
      {% endif %}
    {% endfor %}
  </div>

  {{ additional_blocks }}
</div>

{% stylesheet %}
  .product-information {
    gap: var(--gap) 0;
  }

  /* Base grid layout */
  .product-information__grid {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;

    /* Height budget for the gallery: the first viewport minus the header
       group, the thumbnail strip and a little breathing room. Declared
       UNCONDITIONALLY because both layout modes have to spend it —
       two-column caps the gallery TRACK with it, stacked caps the media
       column's width with it. It lived inside the two-column query until
       2026-08-25 and that was a bug: stacked mode had no cap at all, so a
       near-square viewport (750x800) rendered a 750px image in an 800px
       window and pushed the thumbnails out of the fold. Read
       --header-group-height from the token casa-header.liquid publishes —
       the measured value moves between 89 and 100. */
    /* Floor is 160px, not the 340px inherited from the old constrain
       system. That floor existed to stop a short DESKTOP window shrinking
       the media to nothing — it traded the fold rule away for a usable
       image. Two columns serve that case now (a short window gives the
       buy box the width instead), so the floor's only remaining effect was
       to overrun the fold on a landscape phone: at 844x390 the budget is
       189px and a 340px floor overrode it, pushing image and thumbs out of
       view. 160px keeps it from collapsing without ever beating the
       viewport. */
    --casa-gallery-cap: max(
      160px,
      calc(
        100svh - var(--header-group-height, var(--header-height, 100px)) - var(--casa-thumb-strip, 88px) - 24px
      )
    );
  }

  /* Default column positions */
  .product-details {
    order: 1;
  }

  .product-information__media {
    order: 0;
    width: 0;
    min-width: 100%;
  }

  .product-information__media .product-media-gallery__placeholder-image {
    width: 100%;
    height: 100%;
  }

  /* Casa 2026-08-25: stack on PORTRAIT, go side-by-side on LANDSCAPE.
     Width alone was the wrong signal. The gallery image is square, so a
     full-width stacked gallery is as tall as the viewport is wide — fine
     on a tall screen, ruinous on a short one. What decides it is whether
     there is spare HEIGHT, i.e. the aspect ratio:
       768x1024  iPad portrait   -> stacked, 768px image, fits in 1024
       1024x1366 iPad portrait   -> stacked, 1024px image
       1194x834  iPad landscape  -> two columns
       844x390   phone landscape -> stacked (fails the 600px height floor)
     A width-only boundary gave portrait tablets a ~340px image with 600px
     of height going unused. History: this rule stacked below 1024, then
     below 1200 (2026-07-19) — both were width-only and both mis-served
     portrait tablets. The July note blamed a "480px details column that
     clips sibling/style card rows"; that turned out to be a working
     carousel peeking (slideshow-slides, scrollWidth 1626 vs client 438),
     not clipping. Design + measurements:
     docs/superpowers/specs/2026-08-24-pdp-gallery-layout-design.md
     The two conditions below are complements; they overlap only at
     exactly 1:1, where the later two-column block wins and re-resets
     everything this one sets. */
  /* The min-height: 600px term was removed 2026-08-25. It kept landscape
     phones stacked, which is backwards: on a short window the gallery is
     height-bound and small either way, so stacking strands a 189px image
     in 328px of white each side, while two columns spend that width on the
     buy box. Same principle as the rest of this design — leftover width
     belongs to the buy box, never to margin. Verified at 844x390.
     2026-08-25, second pass: the width floor moved 750 -> 640 for exactly
     the reason the height floor was removed. At 667x375 (a small phone in
     landscape) the 750 floor forced stacking, and the height budget then
     capped the image to 176px, leaving it marooned in 37% gutters on every
     one of the 33 templates — the same defect, arriving through the other
     door. 640 lets a landscape phone use two columns, where the width
     becomes buy box instead of margin. The details track's 400px floor is
     what stops it going lower: 667 - 400 - gap - padding leaves ~179px of
     gallery, which is the practical limit. */
  @media screen and (max-width: 639px), screen and (max-aspect-ratio: 1/1) {
    .product-information__media {
      grid-column: 1 / -1;

      /* Spend the same height budget here. Without this the image is
         width-driven and a square photo is as tall as the column is wide,
         which overruns the fold on any near-square viewport. Centred, so
         the remainder reads as page gutter rather than a slab on one side
         — and it only appears in the narrow band where the viewport is
         close to square (80px per side at 750x800). The wide-stacked case
         that made this look bad is gone: anything landscape and >=750x600
         is two columns now. */
      /* The base rule sets `width: 0; min-width: 100%` so the column does
         not contribute to intrinsic sizing. min-width BEATS max-width in
         the CSS box model, so the cap below is inert until both are undone
         — shipped that way once and the column stayed full width with the
         cap computing correctly but never binding. */
      width: 100%;
      min-width: 0;
      max-width: var(--casa-gallery-cap);
      margin-inline: auto;
    }

    .product-details {
      grid-column: 1 / -1;
      min-width: 0;
      max-width: 100%;
      overflow: hidden;
    }
  }

  /* Side-by-side. Complement of the stacked query above. */
  @media screen and (min-width: 640px) and (min-aspect-ratio: 1/1) {
    /* The stacked block may still match at exactly 1:1 — undo it here so
       the two rules can never half-apply. `overflow: hidden` in particular
       must not survive onto desktop: it would clip the sibling carousel's
       peek and any sticky child in the details column. */
    .product-information__media {
      grid-column: auto;
    }

    .product-details {
      grid-column: auto;
      overflow: visible;
      max-width: none;
      min-width: 0;
    }

    .product-information__grid {
      grid-column: 2;
    }

    /* Position when there is no media */
    .product-information__grid.product-information--media-none {
      .product-details {
        width: var(--narrow-content-width);
        margin: 0 auto;
      }
    }

    /* Position when there is media */
    .product-information__grid:not(.product-information--media-none) {
      /* Casa: allow both grid tracks to shrink below their content's
         intrinsic width. Without minmax(0, ...), CSS Grid lets a track
         expand past its declared size whenever its content (variant
         cards, ATC + Shop Pay buttons, etc.) has a min-content width
         larger than the track. That was forcing the details column to
         push wider than viewport at narrow widths and the right edge
         of the browser would cover the ATC button. */
      .product-details {
        min-width: 0;
      }

      /* Media on the left side.
         --pdp-sidebar-width is a PDP-only token (~480px). Don't reuse
         --sidebar-width here — that's a global cart-drawer / nav-drawer
         width and changing it has site-wide side effects. */
      &.product-information--media-left {
        grid-template-columns: minmax(0, 1fr) minmax(0, min(50vw, var(--pdp-sidebar-width, var(--sidebar-width))));

        .product-information__media {
          padding-right: calc(var(--gap, 0) / 2);
        }

        .product-details {
          padding-left: calc(var(--gap, 0) / 2);
        }

        &:has(.media-gallery--extend) {
          grid-column: 1 / 3;
        }
      }

      /* Media on the right side */
      &.product-information--media-right {
        grid-template-columns: minmax(0, min(50vw, var(--pdp-sidebar-width, var(--sidebar-width)))) minmax(0, 1fr);

        .product-information__media {
          padding-left: calc(var(--gap, 0) / 2);
          order: 1;
        }

        .product-details {
          padding-right: calc(var(--gap, 0) / 2);
          order: 0;
        }

        &:has(.media-gallery--extend) {
          grid-column: 2 / -1;
        }
      }

      /* Equal width columns */
      &.product-information__grid--half,
      &.product-information__grid--half:has(.media-gallery--extend) {
        grid-column: 1 / -1;
        grid-template-columns:
          var(--full-page-grid-margin) calc(var(--full-page-grid-central-column-width) / 2) calc(
            var(--full-page-grid-central-column-width) / 2
          )
          var(--full-page-grid-margin);

        &.product-information--media-left {
          .product-information__media {
            grid-column: 2 / 3;

            &:has(.media-gallery--extend) {
              grid-column: 1 / 3;
            }
          }

          .product-details {
            grid-column: 3 / 4;
          }
        }

        &.product-information--media-right {
          .product-information__media {
            grid-column: 3 / 4;

            &:has(.media-gallery--extend) {
              grid-column: 3 / -1;
            }
          }

          .product-details {
            grid-column: 2 / 3;
          }
        }
      }
    }

    /* Handle full width section */
    .section--full-width {
      .product-information__grid:not(.product-information--media-none) {
        &.product-information--media-left,
        &.product-information--media-right {
          grid-column: 1 / -1;
        }

        &.product-information--media-left .product-details {
          padding-inline-end: var(--padding-lg);
        }

        &.product-information--media-right .product-details {
          padding-inline-start: var(--padding-lg);
        }

        &.product-information__grid--half.product-information--media-left {
          .product-information__media {
            grid-column: 1 / 3;
          }

          .product-details {
            grid-column: 3 / -1;
          }
        }

        &.product-information__grid--half.product-information--media-right {
          .product-information__media {
            grid-column: 3 / -1;
          }

          .product-details {
            grid-column: 1 / 3;
          }
        }
      }
    }
  }

  /* Wider sidebar for large screens — merchant-controllable ratio.
     --media-width-pct is the gallery's share; details takes the rest.
     Tracks wrapped in minmax(0, ...) so neither column expands past
     the viewport when the merchant picks an aggressive ratio (e.g.,
     80% gallery / 20% details would otherwise let the details column's
     intrinsic min-content push the grid wider than viewport at narrow
     desktop widths). */
  @media screen and (min-width: 640px) and (min-aspect-ratio: 1/1) {
    /* Casa 2026-08-25: the merchant ratio is now a CEILING, not a fixed
       share — min()'d against the height budget so the gallery column can
       never be taller than the first viewport. The details track carries a
       400px floor: the spec strip (.casa-ss__strip) needs 353px plus
       padding, and below that it cuts a pill mid-word. */
    .product-information__grid:not(
        .product-information__grid--half,
        .product-information--media-none
      ).product-information--media-left {
      grid-template-columns: minmax(0, min(var(--media-width-pct, 60%), var(--casa-gallery-cap))) minmax(400px, 1fr);
    }

    .product-information__grid:not(
        .product-information__grid--half,
        .product-information--media-none
      ).product-information--media-right {
      grid-template-columns: minmax(400px, 1fr) minmax(0, min(var(--media-width-pct, 60%), var(--casa-gallery-cap)));
    }
  }

  /* Ultrawide guardrail: past 1920px a full-width PDP grid stops tracking
     the viewport and centers at the global content cap. The gallery column
     is a percentage of this grid, so without the cap its aspect-ratio'd
     media grows taller than the (fixed-height) screen and pushes the
     thumbnails below the fold on 2560/3440px monitors. No effect ≤1920px. */
  @media screen and (min-width: 1920px) {
    .product-information.section--full-width .product-information__grid {
      width: 100%;
      max-width: var(--casa-content-max-w, 1920px);
      margin-inline: auto;
    }
  }

  .product-information__grid--limit-details .product-details > .group-block {
    max-width: var(--pdp-sidebar-width, var(--sidebar-width));
  }

  /* If the header is sticky, make product details content stick underneath the header */
  body:has(#header-group #header-component[data-sticky-state='active']) .product-details.sticky-content--desktop {
    --sticky-header-offset: var(--header-height);
  }
{% endstylesheet %}
