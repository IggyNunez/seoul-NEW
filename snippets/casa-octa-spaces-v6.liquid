{% doc %}
  OctaMirror room inspiration and Joe's customer installation.
  @param {boolean} [goldberg_story] - Use the V7 professional-photo and close-up pairing.
  @param {boolean} [compact_details] - Show one close-up and the wide arrangement; default retains the V6 detail set.
  @param {string} [living_image_asset] - Optional living-room asset override.
  @param {number} [living_image_width] - Intrinsic width of the living-room override; also preserves its native ratio.
  @param {number} [living_image_height] - Intrinsic height of the living-room override.
  @param {string} [living_image_alt_key] - Translation key describing the replacement image.
  @param {string} [gaming_image_asset] - Optional gaming-office asset override.
  @param {number} [gaming_image_width] - Intrinsic width of the gaming override; also preserves its native ratio.
  @param {number} [gaming_image_height] - Intrinsic height of the gaming override.
  @param {string} [gaming_image_alt_key] - Translation key describing the replacement gaming image.
{% enddoc %}
{% liquid
  assign gaming_photo_asset = gaming_image_asset | default: 'octa-home-gaming-v1.jpg'
  assign gaming_alt_key = gaming_image_alt_key | default: 'casa_octa_spaces.gaming_alt'
  assign living_photo_asset = living_image_asset | default: 'octa-home-living-v1.jpg'
  assign living_alt_key = living_image_alt_key | default: 'casa_octa_spaces.living_alt'
%}
<section id="casa-v6-spaces" class="os" data-build="{% if gaming_photo_asset == 'octa-home-gaming-studio-v7.jpg' %}20260915-gaming-studio-1{% elsif living_photo_asset == 'octa-home-living-listening-v7.jpg' %}20260914-finished-listening-room-1{% elsif gaming_image_asset != blank %}20260913-photo-based-rooms-1{% elsif living_image_asset != blank %}20260913-front-living-1{% elsif compact_details %}20260913-distinct-details-1{% else %}20260910-home-showcase-1{% endif %}" aria-labelledby="os-title">
<header><p class="os-eyebrow">{{ 'casa_octa_spaces.eyebrow' | t }}</p><h2 id="os-title">{{ 'casa_octa_spaces.heading_html' | t }}</h2><p>{{ 'casa_octa_spaces.intro' | t }}</p></header><div class="os-homes"><article><a class="os-photo "{% if living_image_width != blank and living_image_height != blank %} style="aspect-ratio: {{ living_image_width }} / {{ living_image_height }};"{% endif %} href="{{ living_photo_asset | asset_url }}" data-os-photo aria-label="{{ 'casa_octa_spaces.enlarge' | t }}"><img class="" src="{{ living_photo_asset | asset_url }}" width="{{ living_image_width | default: 1120 }}" height="{{ living_image_height | default: 1400 }}" loading="lazy" decoding="async" alt="{{ living_alt_key | t }}"><span aria-hidden="true">↗</span></a><p class="os-eyebrow">{{ 'casa_octa_spaces.living' | t }}</p><h3>{{ 'casa_octa_spaces.living_heading' | t }}</h3><p>{{ 'casa_octa_spaces.living_body' | t }}</p></article><article><a class="os-photo "{% if gaming_image_width != blank and gaming_image_height != blank %} style="aspect-ratio: {{ gaming_image_width }} / {{ gaming_image_height }};"{% endif %} href="{{ gaming_photo_asset | asset_url }}" data-os-photo aria-label="{{ 'casa_octa_spaces.enlarge' | t }}"><img class="" src="{{ gaming_photo_asset | asset_url }}" width="{{ gaming_image_width | default: 1120 }}" height="{{ gaming_image_height | default: 1400 }}" loading="lazy" decoding="async" alt="{{ gaming_alt_key | t }}"><span aria-hidden="true">↗</span></a><p class="os-eyebrow">{{ 'casa_octa_spaces.gaming' | t }}</p><h3>{{ 'casa_octa_spaces.gaming_heading' | t }}</h3><p>{{ 'casa_octa_spaces.gaming_body' | t }}</p></article></div><p class="os-disclosure">{{ 'casa_octa_spaces.styled' | t }}</p>{% if goldberg_story %}{% render 'casa-octa-goldberg-v7' %}{% else %}<p class="os-eyebrow os-joe-label">{{ 'casa_octa_spaces.joe_label' | t }}</p><div class="os-joe"><a class="os-photo os-room" href="{{ 'octa-joe-room-v1.jpg' | asset_url }}" data-os-photo aria-label="{{ 'casa_octa_spaces.enlarge' | t }}"><img class="" src="{{ 'octa-joe-room-v1.jpg' | asset_url }}" width="1400" height="1867" loading="lazy" decoding="async" alt="{{ 'casa_octa_spaces.joe_alt' | t }}"><span aria-hidden="true">↗</span></a><div class="os-quote"><blockquote>{{ 'casa_octa_spaces.quote' | t }}</blockquote><p>{{ 'casa_octa_spaces.credit' | t }}</p><p>{{ 'casa_octa_spaces.joe_body' | t }}</p></div></div><div class="os-details">{% unless compact_details %}<figure><a class="os-photo os-crop" href="{{ 'octa-joe-room-v1.jpg' | asset_url }}" data-os-photo aria-label="{{ 'casa_octa_spaces.enlarge' | t }}"><img class="" src="{{ 'octa-joe-room-v1.jpg' | asset_url }}" width="1400" height="1867" loading="lazy" decoding="async" alt="{{ 'casa_octa_spaces.joe_alt' | t }}"><span aria-hidden="true">↗</span></a><figcaption>{{ 'casa_octa_spaces.depth' | t }}</figcaption></figure>{% endunless %}<figure><a class="os-photo os-crop" href="{{ 'octa-joe-detail-v1.jpg' | asset_url }}" data-os-photo aria-label="{{ 'casa_octa_spaces.enlarge' | t }}"><img class="" src="{{ 'octa-joe-detail-v1.jpg' | asset_url }}" width="1400" height="1867" loading="lazy" decoding="async" alt="{{ 'casa_octa_spaces.joe_alt' | t }}"><span aria-hidden="true">↗</span></a><figcaption>{{ 'casa_octa_spaces.geometry' | t }}</figcaption></figure><figure><a class="os-photo os-wide" href="{{ 'octa-joe-arrangement-v1.jpg' | asset_url }}" data-os-photo aria-label="{{ 'casa_octa_spaces.enlarge' | t }}"><img class="" src="{{ 'octa-joe-arrangement-v1.jpg' | asset_url }}" width="1400" height="1867" loading="lazy" decoding="async" alt="{{ 'casa_octa_spaces.joe_alt' | t }}"><span aria-hidden="true">↗</span></a><figcaption>{{ 'casa_octa_spaces.arrangement' | t }}</figcaption></figure></div>{% endif %}<p class="os-disclosure">{{ 'casa_octa_spaces.custom' | t }}</p><dialog class="os-dialog" aria-label="{{ 'casa_octa_spaces.enlarge' | t }}"><button type="button" class="os-close">{{ 'casa_octa_spaces.close' | t }} ×</button><img alt="" width="1120" height="1400"></dialog></section>
{{ 'casa-octa-spaces-v6.css' | asset_url | stylesheet_tag }}
<script src="{{ 'casa-octa-spaces-v6.js' | asset_url }}" defer></script>
