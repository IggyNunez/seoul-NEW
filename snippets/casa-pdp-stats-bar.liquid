{%- comment -%}
  Casa PDP Stats Bar
  Displays up to 3 stat cards. Values resolved by the caller (block) from
  product metafields → block settings → blank. This snippet only renders;
  it does not pull defaults.

  Parameters (preferred):
    - stat_1_value, stat_1_label
    - stat_2_value, stat_2_label
    - stat_3_value, stat_3_label
  Back-compat: if those params aren't passed, falls through to block.settings.
{%- endcomment -%}

{%- liquid
  assign s1v = stat_1_value | default: block.settings.stat_1_value
  assign s1l = stat_1_label | default: block.settings.stat_1_label
  assign s2v = stat_2_value | default: block.settings.stat_2_value
  assign s2l = stat_2_label | default: block.settings.stat_2_label
  assign s3v = stat_3_value | default: block.settings.stat_3_value
  assign s3l = stat_3_label | default: block.settings.stat_3_label
-%}

<div class="casa-stats-bar">
  <div class="casa-stats-bar__grid">
    {%- if s1v != blank -%}
      <div class="casa-stats-bar__card">
        <span class="casa-stats-bar__value">{{ s1v }}</span>
        {%- if s1l != blank -%}<span class="casa-stats-bar__label">{{ s1l }}</span>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if s2v != blank -%}
      <div class="casa-stats-bar__card">
        <span class="casa-stats-bar__value casa-stats-bar__value--pink">{{ s2v }}</span>
        {%- if s2l != blank -%}<span class="casa-stats-bar__label">{{ s2l }}</span>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if s3v != blank -%}
      <div class="casa-stats-bar__card">
        <span class="casa-stats-bar__value casa-stats-bar__value--cyan">{{ s3v }}</span>
        {%- if s3l != blank -%}<span class="casa-stats-bar__label">{{ s3l }}</span>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
.casa-stats-bar {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
}

.casa-stats-bar__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border: 1px solid #e5e5e5;
  border-radius: 12px;
  overflow: hidden;
  min-width: 0;
}

.casa-stats-bar__card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 18px 12px;
  background: #f9f9f9;
  text-align: center;
  min-width: 0;
  overflow: hidden;
}

.casa-stats-bar__card:not(:last-child) {
  border-right: 1px solid #e5e5e5;
}

.casa-stats-bar__value {
  font-size: 28px;
  font-weight: 700;
  line-height: 1.1;
  background: linear-gradient(135deg, var(--cpm-accent-1, #B0C3FA), var(--cpm-accent-2, #5E0A02));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.casa-stats-bar__value--pink {
  background: linear-gradient(135deg, var(--cpm-accent-2, #5E0A02), #f97316);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.casa-stats-bar__value--cyan {
  background: linear-gradient(135deg, #F2FFA0, #3b82f6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.casa-stats-bar__label {
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: #757575;
  margin-top: 4px;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@media (max-width: 480px) {
  .casa-stats-bar__card {
    padding: 14px 6px;
  }

  .casa-stats-bar__value {
    font-size: 20px;
  }

  .casa-stats-bar__label {
    font-size: 9px;
  }
}

@media (max-width: 375px) {
  .casa-stats-bar__value {
    font-size: 16px;
  }

  .casa-stats-bar__label {
    font-size: 8px;
  }
}
</style>
