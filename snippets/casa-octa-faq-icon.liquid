{% doc %}
  Render a decorative OctaMirror FAQ line icon.
  @param {string} name - mirror, setup, support, ownership or popular
{% enddoc %}
<svg class="casa-octa-faq-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {% case name %}
    {% when 'mirror' %}
      <path d="m8 2.5 8 0 5.5 5.5v8L16 21.5H8L2.5 16V8Z"/>
      <path d="M9.5 6h5l3.5 3.5v5L14.5 18h-5L6 14.5v-5Z"/>
      <path d="M11 9.5h2l1.5 1.5v2L13 14.5h-2L9.5 13v-2Z"/>
    {% when 'setup' %}
      <path d="M3 3v18M7 6h10M9 6v3M15 6v3"/>
      <path d="m10 10 5 0 3 3v5l-3 3h-5l-3-3v-5Z"/>
      <path d="M12.5 10V7.5"/>
    {% when 'support' %}
      <path d="M14 12.5H8l-4 3v-4.2A4 4 0 0 1 2.5 8V7A4.5 4.5 0 0 1 7 2.5h5A4.5 4.5 0 0 1 16.5 7v1A4.5 4.5 0 0 1 14 12.5Z"/>
      <path d="M9 16.5a4.5 4.5 0 0 0 3 1h4l4 3v-4a4 4 0 0 0 1.5-3v-1a4.5 4.5 0 0 0-2-3.7"/>
    {% when 'ownership' %}
      <rect x="3" y="5" width="18" height="15" rx="1.5"/>
      <path d="M3 9h18M7 9v11M17 9v11M3 16h4M17 16h4M9 5V3h6v2"/>
    {% when 'popular' %}
      <path d="m12 2.5 2.4 7.1 7.1 2.4-7.1 2.4-2.4 7.1-2.4-7.1L2.5 12l7.1-2.4Z"/>
  {% endcase %}
</svg>
